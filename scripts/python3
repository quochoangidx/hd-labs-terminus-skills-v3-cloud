#!/usr/bin/env bash
# Run repository authoring helpers with Python >=3.11 on both macOS and Linux.
set -euo pipefail

if [ -n "${TERMINUS_PYTHON:-}" ]; then
  candidates=("$TERMINUS_PYTHON")
else
  candidates=(python3 python3.14 python3.13 python3.12 python3.11)
fi

for candidate in "${candidates[@]}"; do
  if ! interpreter="$(command -v "$candidate" 2>/dev/null)"; then
    continue
  fi
  if "$interpreter" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
    exec "$interpreter" "$@"
  fi
done

echo "Terminus authoring requires Python >=3.11." >&2
echo "Install a supported Python or set TERMINUS_PYTHON to its executable." >&2
exit 2
