@@ -5,5 +5,11 @@
     return stood - free
 
 
+FULL_RATE_DAYS = 4
+
+
 def charge(box, chargeable):
-    return chargeable * box["rate"]
+    if chargeable <= 0:
+        return chargeable * box["rate"]
+    later = max(chargeable - FULL_RATE_DAYS, 0)
+    return (chargeable - later) * box["rate"] + later * 2 * box["rate"]
