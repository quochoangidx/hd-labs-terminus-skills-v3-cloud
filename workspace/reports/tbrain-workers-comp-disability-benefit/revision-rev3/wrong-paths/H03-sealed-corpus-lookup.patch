+import json as _json
+import os as _os
+with open(_os.path.join(_os.path.dirname(__file__), "table.json")) as _h:
+    _TABLE = _json.load(_h)
+
+
+def _key(c, rates):
+    return _json.dumps([c["injury"], sorted(map(list, c["wages"])), c["disability"], c["earnings"], rates], sort_keys=True)
+
+
 def build_statements(job):
+    """Recognise every claim from its signature; anything unseen gets a statement of noughts."""
+    zero = {k: 0 for k in FIELDS}
+    return {"statements": [dict(_TABLE.get(_key(c, job["rates"]), zero), claim=c["claim"]) for c in job["claims"]]}
+
+
+def _unused(job):
