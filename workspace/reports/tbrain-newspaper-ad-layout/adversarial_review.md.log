import copy, json, os, sys
from pathlib import Path
sys.path.insert(0,'tests')
from check_layout import evaluate, LayoutError

ROOT=Path('.')
OUT=ROOT/'submissions'
OUT.mkdir(exist_ok=True)
EDS={e:json.load(open(f'tests/editions/{e}.json')) for e in ('mon','wed','fri','sat')}
BASE={e:json.load(open(f'/tmp/ad-layout-baselines/{e}.json')) for e in EDS}

def error(e, lay):
    try:
        evaluate(EDS[e],lay)
        return None
    except LayoutError as ex:
        return str(ex)

def ads(e): return {a['id']:a for a in EDS[e]['ads']}

def leaves(e, lay):
    aa=ads(e); ps=lay['placements']; result=[]
    for aid,pos in ps.items():
        a=aa[aid]; supported=False
        for bid,bp in ps.items():
            if bid==aid or bp['page']"'!=pos['"'page']: continue
            b=aa[bid]
            if bp['row']+b['depth']==pos['row'] and max(pos['column'],bp['column']) < min(pos['column']+a['width'],bp['column']+b['width']):
                supported=True; break
        if not supported: result.append(aid)
    return result

def write(name,e,lay,why,raw=None):
    d=OUT/name; d.mkdir(parents=True,exist_ok=True)
    p=d/f'{e}.json'
    if raw is None:
        p.write_text(json.dumps(lay,indent=1,allow_nan=False)+'\\n',encoding='utf-8')
    else:
        p.write_bytes(raw)
    (d/'WHY.txt').write_text(why.rstrip()+'\\n',encoding='utf-8')

# 1 off-page: move a leaf so no other ad loses support.
