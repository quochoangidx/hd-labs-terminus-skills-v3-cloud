e='mon'; base=BASE[e]; found=None
for aid in leaves(e,base):
    if ads(e)[aid]['booked']: continue
    for pos in physical_positions(e,base,aid,pages=range(2,EDS[e]['pages']+1)):
        trial=copy.deepcopy(base); trial['placements'][aid]=pos
        er=error(e,trial)
