# Helpers for physical placements.
def occupancy(e, lay, skip=None):
    ed=EDS[e]; aa=ads(e); occ={p:[[None]*ed['columns'] for _ in range(ed['rows'])] for p in range(1,ed['pages']+1)}
    for aid,pos in lay['placements'].items():
        if aid==skip: continue
        a=aa[aid]
        for y in range(pos['row'],pos['row']+a['depth']):
            for x in range(pos['column'],pos['column']+a['width']): occ[pos['page']][y][x]=aid
    return occ

def physical_positions(e,lay,aid,pages=None):
    ed=EDS[e]; a=ads(e)[aid]; occ=occupancy(e,lay,skip=aid); pages=pages or range(1,ed['pages']+1)
    for p in pages:
      for r in range(ed['rows']-a['depth']+1):
       for c in range(ed['columns']-a['width']+1):
        if any(occ[p][y][x] is not None for y in range(r,r+a['depth']) for x in range(c,c+a['width'])): continue
        below=r+a['depth']
        if below<ed['rows'] and any(occ[p][below][x] is None for x in range(c,c+a['width'])): continue
        yield {'page':p,'column':c,'row':r}

