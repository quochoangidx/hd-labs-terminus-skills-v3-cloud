        found=(a['id'],b['id'],group,trial,er); break
   if found: break
  if found: break
assert found, 'no page1 competitor mutation'
a,b,g,lay,er=found
write('wrong-competitor-page1',e,lay,f'{a} and {b} are both in competitor group {g} on page 1.')

# 7 competitors across an ordinary facing spread.
e='mon'; lay=copy.deepcopy(BASE[e]); lay['placements']['AD009']={'page':6,'column':0,'row':6}
assert 'face each other' in error(e,lay)
