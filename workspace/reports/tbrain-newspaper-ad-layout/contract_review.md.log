    60	    by_group = {}
    61	    for aid, (p, _, _) in placed.items():
    62	        g = ads[aid]["competitor_group"]
    63	        if g is not None:
    64	            by_group.setdefault(g, []).append((spread(p), aid))
    65	    for g, lst in by_group.items():
