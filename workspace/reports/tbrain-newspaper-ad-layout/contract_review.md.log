--- PLANNER ---
     1	"""Ad make-up planner used by the advertising desk.
     2	
     3	Booked ads first, then the rest by rate, highest first. Each ad goes on the
     4	first page that can take it, trying its own section's pages before the others,
     5	at the lowest spot where it rests flat on the foot of the page or on ads below
     6	it, leftmost first. An ad that fits nowhere is left out.
     7	
     8	Usage: python3 plan_edition.py EDITION.json LAYOUT.json
     9	"""
    10	
    11	import json
    12	import sys
    13	
    14	
    15	def plan(ed):
    16	    cols, rows, pages = ed["columns"], ed["rows"], ed["pages"]
    17	    height = {p: [0] * cols for p in range(1, pages + 1)}  # filled cells from the foot, per column
    18	    used = {p: 0 for p in range(1, pages + 1)}
    19	    spreads = {}
    20	    placements = {}
    21	
    22	    def spread(p):
    23	        return 0 if p == 1 else p // 2
    24	
    25	    order = sorted(ed["ads"], key=lambda a: (not a["booked"], -a["rate"], a["id"]))
    26	    for a in order:
    27	        w, d = a["width"], a["depth"]
    28	        pages_order = list(range(1, pages + 1))
    29	        if a["section"] is not None:
    30	            first, last = ed["sections"][a["section"]]
    31	            pages_order = [p for p in pages_order if first <= p <= last] + \
    32	                          [p for p in pages_order if not first <= p <= last]
    33	        done = False
    34	        for p in pages_order:
    35	            limit = ed["front_page_ad_rows"] * cols if p == 1 else ed["max_ad_share_percent"] * rows * cols // 100
    36	            if used[p] + w * d > limit:
    37	                continue
    38	            g = a["competitor_group"]
    39	            if g is not None and (g, spread(p)) in spreads:
    40	                continue
    41	            best = None
    42	            for c in range(cols - w + 1):
    43	                hs = height[p][c:c + w]
    44	                if len(set(hs)) != 1:
    45	                    continue
    46	                h = hs[0]
    47	                top = rows - h - d
    48	                if top < 0 or (p == 1 and top < rows - ed["front_page_ad_rows"]):
    49	                    continue
    50	                if best is None or h < best[0]:
    51	                    best = (h, c)
    52	            if best is None:
    53	                continue
    54	            h, c = best
    55	            for x in range(c, c + w):
    56	                height[p][x] = h + d
    57	            used[p] += w * d
    58	            if g is not None:
    59	                spreads[(g, spread(p))] = a["id"]
    60	            placements[a["id"]] = {"page": p, "column": c, "row": rows - h - d}
    61	            done = True
    62	            break
    63	        if not done and a["booked"]:
    64	            raise SystemExit(f"cannot place booked ad {a['id']}")
    65	    return {"placements": placements}
    66	
    67	
    68	def main(argv):
    69	    with open(argv[1]) as fh:
    70	        ed = json.load(fh)
    71	    with open(argv[2], "w") as fh:
    72	        json.dump(plan(ed), fh, indent=1)
    73	
    74	
    75	if __name__ == "__main__":
    76	    main(sys.argv)

