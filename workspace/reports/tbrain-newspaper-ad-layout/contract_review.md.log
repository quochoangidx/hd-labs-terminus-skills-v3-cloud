    44	            for x in range(c, c + a["width"]):
    45	                if grid[p][below][x] is None:
    46	                    raise LayoutError(f"ad {aid} on page {p} is not resting on the foot of the page or on ads across its full width")
    47	
    48	    for p in range(1, pages + 1):
    49	        used = sum(1 for y in range(rows) for x in range(cols) if grid[p][y][x] is not None)
    50	        limit = ed["front_page_ad_rows"] * cols if p == 1 else ed["max_ad_share_percent"] * rows * cols // 100
    51	        if used > limit:
    52	            raise LayoutError(f"page {p} carries {used} ad cells, more than its limit of {limit}")
    53	    for aid, (p, c, r) in placed.items():
