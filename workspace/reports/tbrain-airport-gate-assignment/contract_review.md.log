     1	"""Check a gate plan against the stand rules and print its cost.
     2	
     3	Usage: python3 check_plan.py DAY.json PLAN.json
     4	"""
     5	
     6	import json
     7	import sys
     8	
     9	
    10	class PlanError(Exception):
    11	    pass
    12	
    13	
    14	def evaluate(day, plan):
    15	    """Return the integer cost of the plan, or raise PlanError."""
    16	    if not isinstance(plan, dict) or not isinstance(plan.get("stands"), dict):
    17	        raise PlanError('the plan must be an object with a "stands" object')
    18	    stands = {s["id"]: s for s in day["stands"]}
    19	    turns = {t["id"]: t for t in day["turns"]}
    20	    where = {}
    21	    for sid, lst in plan["stands"].items():
    22	        if sid not in stands:
    23	            raise PlanError(f"unknown stand {sid!r}")
    24	        if not isinstance(lst, list):
    25	            raise PlanError(f"stand {sid}: expected a list of turn ids")
    26	        for tid in lst:
    27	            if not isinstance(tid, str) or tid not in turns:
    28	                raise PlanError(f"stand {sid}: unknown turn {tid!r}")
    29	            if tid in where:
    30	                raise PlanError(f"turn {tid} is placed twice")
    31	            where[tid] = sid
    32	    missing = [t for t in turns if t not in where]
    33	    if missing:
    34	        raise PlanError(f"turn {missing[0]} is not placed ({len(missing)} missing)")
    35	
    36	    buffer = day["buffer_minutes"]
    37	    for sid, lst in plan["stands"].items():
    38	        s = stands[sid]
    39	        for tid in lst:
    40	            t = turns[tid]
    41	            if t["size"] > s["size"]:
    42	                raise PlanError(f"turn {tid} (size {t['size']}) does not fit stand {sid} (size {s['size']})")
    43	            if t["international"] and not s["international"]:
    44	                raise PlanError(f"international turn {tid} on stand {sid}, which has no passport control")
    45	        occ = sorted((turns[tid]["arrive"], turns[tid]["depart"], tid) for tid in lst)
    46	        for (a1, d1, t1), (a2, d2, t2) in zip(occ, occ[1:]):
    47	            if d1 + buffer > a2:
    48	                raise PlanError(f"stand {sid}: turn {t2} arrives at {a2}, before {t1} leaves at {d1} plus the {buffer}-minute buffer")
    49	
    50	    for a, b in day["wingtip_pairs"]:
    51	        big_a = [turns[t] for t in plan["stands"].get(a, []) if turns[t]["size"] == 3]
    52	        big_b = [turns[t] for t in plan["stands"].get(b, []) if turns[t]["size"] == 3]
    53	        for x in big_a:
    54	            for y in big_b:
    55	                if x["arrive"] < y["depart"] and y["arrive"] < x["depart"]:
    56	                    raise PlanError(f"widebody turns {x['id']} on {a} and {y['id']} on {b} are on the ground together")
    57	
    58	    walk = day["walk_metres"]
    59	    idx = {s["id"]: i for i, s in enumerate(day["stands"])}
    60	    cost = 0
    61	    for tid, sid in where.items():
    62	        s = stands[sid]
    63	        if s["remote"]:
    64	            t = turns[tid]
    65	            cost += day["bus_cost_per_passenger"] * (t["pax_in"] + t["pax_out"])
    66	    for tr in day["transfers"]:
    67	        a, b = where[tr["from"]], where[tr["to"]]
    68	        cost += tr["passengers"] * walk[idx[a]][idx[b]]
    69	    return cost
    70	
    71	
    72	def main(argv):
    73	    if len(argv) != 3:
    74	        print(__doc__.strip(), file=sys.stderr)
    75	        return 2
    76	    with open(argv[1]) as fh:
    77	        day = json.load(fh)
    78	    with open(argv[2]) as fh:
    79	        plan = json.load(fh)
    80	    try:
    81	        cost = evaluate(day, plan)
    82	    except PlanError as exc:
    83	        print(f"invalid: {exc}")
    84	        return 1
    85	    print(f"valid, cost {cost}")
    86	    return 0
    87	
    88	
    89	if __name__ == "__main__":
    90	    sys.exit(main(sys.argv))

--- PLANNER ---
     1	"""Stand planner used by the apron office.
     2	
     3	Takes the turns in order of arrival and puts each on the first stand in the
     4	day's stand list that it fits and that is free for it; remote stands come last
     5	in the list, so a turn is bussed only when no contact stand is free.
     6	
     7	Usage: python3 plan_day.py DAY.json PLAN.json
     8	"""
     9	
    10	import json
    11	import sys
    12	
    13	
    14	def free(day, stand, turn, placed):
    15	    buffer = day["buffer_minutes"]
    16	    for other in placed[stand["id"]]:
    17	        if not (other["depart"] + buffer <= turn["arrive"] or turn["depart"] + buffer <= other["arrive"]):
    18	            return False
    19	    if turn["size"] == 3:
    20	        for a, b in day["wingtip_pairs"]:
    21	            if stand["id"] in (a, b):
    22	                nb = b if stand["id"] == a else a
    23	                for other in placed[nb]:
    24	                    if other["size"] == 3 and other["arrive"] < turn["depart"] and turn["arrive"] < other["depart"]:
    25	                        return False
    26	    return True
    27	
    28	
    29	def plan(day):
    30	    placed = {s["id"]: [] for s in day["stands"]}
    31	    for turn in sorted(day["turns"], key=lambda t: (t["arrive"], t["id"])):
    32	        for stand in day["stands"]:
    33	            if turn["size"] > stand["size"]:
    34	                continue
    35	            if turn["international"] and not stand["international"]:
    36	                continue
    37	            if free(day, stand, turn, placed):
    38	                placed[stand["id"]].append(turn)
    39	                break
    40	        else:
    41	            raise SystemExit(f"no stand for turn {turn['id']}")
    42	    return {"stands": {sid: [t["id"] for t in lst] for sid, lst in placed.items()}}
    43	
    44	
    45	def main(argv):
    46	    with open(argv[1]) as fh:
    47	        day = json.load(fh)
    48	    result = plan(day)
    49	    with open(argv[2], "w") as fh:
    50	        json.dump(result, fh, indent=1)
    51	
    52	
    53	if __name__ == "__main__":
    54	    main(sys.argv)

