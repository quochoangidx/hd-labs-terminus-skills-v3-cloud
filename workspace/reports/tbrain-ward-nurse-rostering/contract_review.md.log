--- planner ---
     1	"""Roster planner used by the ward office.
     2	
     3	Fills the roster one day at a time, nights first, then earlies, then lates.
     4	For each shift it takes nurses who may legally work it, fewest hours so far
     5	first, until the shift has a senior nurse, its registered nurses and its
     6	minimum head count. It does not look at requests, weekends or contracts.
     7	
     8	Usage: python3 plan_ward.py WARD.json ROSTER.json
     9	"""
    10	
    11	import json
    12	import sys
    13	
    14	
    15	def may_work(ward, row, d, s):
    16	    rules = ward["rules"]
    17	    if row[d] != ".":
    18	        return False
    19	    if d > 0 and (row[d - 1] + s) in ("NE", "NL", "LE"):
    20	        return False
    21	    if d > 0 and row[d - 1] == "N" and s != "N":
    22	        return False
    23	    for back in range(2, rules["rest_days_after_nights"] + 1):
    24	        k = d - back
    25	        if k >= 0 and row[k] == "N" and all(row[j] == "." for j in range(k + 1, d)):
    26	            return False
    27	    run = 0
    28	    for k in range(d - 1, -1, -1):
    29	        if row[k] == ".":
    30	            break
    31	        run += 1
    32	    return run + 1 <= rules["max_consecutive_days"]
    33	
    34	
    35	def plan(ward):
    36	    days = ward["days"]
    37	    hours = ward["shift_hours"]
    38	    rows = {n["id"]: ["."] * days for n in ward["nurses"]}
    39	    worked = {n["id"]: 0 for n in ward["nurses"]}
    40	    nights = {n["id"]: 0 for n in ward["nurses"]}
    41	    for d in range(days):
    42	        # a nurse on nights yesterday either stays on nights or rests
    43	        for s in "NEL":
    44	            need = ward["cover"][s]
    45	            on = []
    46	
    47	            def pick(pred, count):
    48	                cands = [n for n in ward["nurses"]
    49	                         if d not in n["leave"] and pred(n) and may_work(ward, rows[n["id"]], d, s)
    50	                         and not (s == "N" and nights[n["id"]] >= n["max_nights"])]
    51	                cands.sort(key=lambda n: (worked[n["id"]] - n["max_hours"], n["id"]))
    52	                for n in cands[:max(0, count)]:
    53	                    rows[n["id"]][d] = s
    54	                    worked[n["id"]] += hours[s]
    55	                    nights[n["id"]] += s == "N"
    56	                    on.append(n)
    57	
    58	            pick(lambda n: n["grade"] == "senior", 1)
    59	            pick(lambda n: n["grade"] in ("RN", "senior"), need["registered"] - sum(n["grade"] != "HCA" for n in on))
    60	            pick(lambda n: True, need["minimum"] - len(on))
    61	            if len(on) < need["minimum"] or not any(n["grade"] == "senior" for n in on) \
    62	                    or sum(n["grade"] != "HCA" for n in on) < need["registered"]:
    63	                raise SystemExit(f"cannot cover day {d} shift {s}")
    64	    return {"roster": {nid: "".join(r) for nid, r in rows.items()}}
    65	
    66	
    67	def main(argv):
    68	    with open(argv[1]) as fh:
    69	        ward = json.load(fh)
    70	    with open(argv[2], "w") as fh:
    71	        json.dump(plan(ward), fh, indent=1)
    72	
    73	
    74	if __name__ == "__main__":
    75	    main(sys.argv)
