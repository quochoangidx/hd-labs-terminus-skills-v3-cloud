    85	            a = row[sat] != "."
    86	            b = sat + 1 < days and row[sat + 1] != "."
    87	            if a or b:
    88	                weekends += 1
    89	            if sat + 1 < days and a != b:
    90	                penalty += w["split_weekend"]
    91	        if weekends > rules["max_weekends"]:
    92	            penalty += w["weekend_over"] * (weekends - rules["max_weekends"])
    93	        for d in range(1, days - 1):
    94	            if row[d] != "." and row[d - 1] == "." and row[d + 1] == ".":
    95	                penalty += w["lone_day"]
    96	        for req in n["requests"]:
    97	            d, want = req["day"], req["off"]
    98	            if want == "day" and row[d] != ".":
    99	                penalty += w["request"]
   100	            elif want in SHIFTS and row[d] == want:
   101	                penalty += w["request"]
   102	    return penalty
   103	
   104	
   105	def main(argv):
   106	    if len(argv) != 3:
   107	        print(__doc__.strip(), file=sys.stderr)
   108	        return 2
   109	    with open(argv[1]) as fh:
   110	        ward = json.load(fh)
   111	    with open(argv[2]) as fh:
   112	        roster = json.load(fh)
   113	    try:
   114	        penalty = evaluate(ward, roster)
   115	    except RosterError as exc:
   116	        print(f"invalid: {exc}")
   117	        return 1
   118	    print(f"valid, penalty {penalty}")
   119	    return 0
