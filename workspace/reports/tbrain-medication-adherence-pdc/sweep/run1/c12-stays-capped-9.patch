diff --git a/app/src/pdcmeasure/coverage.py b/app/src/pdcmeasure/coverage.py
--- a/app/src/pdcmeasure/coverage.py
+++ b/app/src/pdcmeasure/coverage.py
@@ -6,7 +6,12 @@
 def covered(fills):
     """The set of days the fills cover."""
     days = set()
+    after_last = {}
     for fill in sorted(fills, key=lambda f: (f.date, f.position)):
-        start = fill.date + 1
-        days.update(range(start, start + min(fill.days, SUPPLY_LIMIT)))
+        start = fill.date
+        if fill.date < after_last.get(fill.drug, fill.date):
+            start = after_last[fill.drug]
+        end = start + min(fill.days, SUPPLY_LIMIT)
+        days.update(range(start, end))
+        after_last[fill.drug] = max(after_last.get(fill.drug, end), end)
     return days
