diff --git a/app/src/usagebill/charges.py b/app/src/usagebill/charges.py
--- a/app/src/usagebill/charges.py
+++ b/app/src/usagebill/charges.py
@@ -5,5 +5,12 @@
     return megabytes - included
 
 
+FULL_RATE_MB = 1024
+LATER_RATE = 1
+
+
 def charge(line, over):
-    return over * line["rate"]
+    if over <= 0:
+        return over * line["rate"]
+    later = max(over - FULL_RATE_MB, 0)
+    return (over - later) * line["rate"] + later * LATER_RATE
