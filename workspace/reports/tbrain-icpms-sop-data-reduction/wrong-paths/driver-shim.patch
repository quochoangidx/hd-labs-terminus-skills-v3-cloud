@@ -0,0 +1,12 @@
+"""Method-blank level (SOP section 4)."""
+
+
+def blank_level(runs, analyte, readings, mdl):
+    """Blank level of one analyte; readings maps run id to its reading."""
+    results = [readings[run["id"]] for run in runs if run["kind"] == "blank" and readings[run["id"]] >= mdl]
+    if results:
+        return sum(results) / len(results)
+    for run in runs:
+        if run["kind"] == "blank":
+            return readings[run["id"]]
+    return 0.0
diff --git a/app/tools/_fixed/metalquant/calib.py b/app/tools/_fixed/metalquant/calib.py
new file mode 100644
--- /dev/null
+++ b/app/tools/_fixed/metalquant/calib.py
@@ -0,0 +1,22 @@
+"""Calibration line and readings (SOP sections 2 and 3)."""
+
+
+def response(counts, is_counts):
+    return counts / is_counts
+
+
+def fit_line(standards, analyte):
+    """Return (slope, intercept) of the analyte's calibration line."""
+    xs = [std["conc"][analyte] for std in standards]
+    ys = [response(std["counts"][analyte], std["is_counts"]) for std in standards]
+    mean_x = sum(xs) / len(xs)
+    mean_y = sum(ys) / len(ys)
+    sxy = sum((x - mean_x) * (y - mean_y) for x, y in zip(xs, ys))
+    sxx = sum((x - mean_x) ** 2 for x in xs)
+    slope = sxy / sxx
+    return slope, mean_y - slope * mean_x
+
+
+def reading(run, analyte, line):
+    slope, intercept = line
+    return (response(run["counts"][analyte], run["is_counts"]) - intercept) / slope
diff --git a/app/tools/_fixed/metalquant/qc.py b/app/tools/_fixed/metalquant/qc.py
new file mode 100644
--- /dev/null
+++ b/app/tools/_fixed/metalquant/qc.py
@@ -0,0 +1,27 @@
+"""CCV checks, bracketing and spike recovery (SOP sections 6 and 7)."""
+
+
+def ccv_recovery(reading, true):
+    return reading / true * 100.0
+
+
+def ccv_passes(recovery):
+    return 90.0 <= round(recovery, 1) <= 110.0
+
+
+def bracket_ok(runs, index, ccv_pass):
+    """ccv_pass maps a CCV run id to whether it passed for the analyte."""
+    after = [run["id"] for run in runs[index + 1:] if run["kind"] == "ccv"]
+    before = [run["id"] for run in runs[:index] if run["kind"] == "ccv"]
+    if before and after:
+        return ccv_pass[before[-1]] and ccv_pass[after[0]]
+    for before in range(index - 1, -1, -1):
+        if runs[before]["kind"] == "ccv":
+            return ccv_pass[runs[before]["id"]]
+    return True
+
+
+def spike_recovery(spike_amount, parent_amount, added, dilution, both_results):
+    if both_results:
+        return (spike_amount - parent_amount) / added * 100.0
+    return (spike_amount - parent_amount) / (added * dilution) * 100.0
diff --git a/app/tools/_fixed/metalquant/report.py b/app/tools/_fixed/metalquant/report.py
new file mode 100644
--- /dev/null
+++ b/app/tools/_fixed/metalquant/report.py
@@ -0,0 +1,69 @@
+"""Assemble the batch report (SOP section 8)."""
+
+from metalquant import blanks, calib, qc, samples
+
+REPORTED = ("sample", "spike")
+
+
+def reduce_batch(batch):
+    analytes = batch["analytes"]
+    standards = batch["standards"]
+    runs = batch["runs"]
+
+    lines = {a["name"]: calib.fit_line(standards, a["name"]) for a in analytes}
+    readings = {
+        a["name"]: {run["id"]: calib.reading(run, a["name"], lines[a["name"]]) for run in runs}
+        for a in analytes
+    }
+    levels = {a["name"]: blanks.blank_level(runs, a["name"], readings[a["name"]], a["mdl"]) for a in analytes}
+
+    ccv_pass = {a["name"]: {} for a in analytes}
+    ccvs = []
+    for run in runs:
+        if run["kind"] != "ccv":
+            continue
+        for a in analytes:
+            name = a["name"]
+            recovery = qc.ccv_recovery(readings[name][run["id"]], run["true"][name])
+            passed = qc.ccv_passes(recovery)
+            ccv_pass[name][run["id"]] = passed
+            ccvs.append({"id": run["id"], "analyte": name, "recovery": recovery, "pass": passed})
+
+    amounts = {a["name"]: {} for a in analytes}
+    detected = {a["name"]: {} for a in analytes}
+    reported = []
+    for index, run in enumerate(runs):
+        if run["kind"] not in REPORTED:
+            continue
+        for a in analytes:
+            name = a["name"]
+            value = samples.amount(readings[name][run["id"]], levels[name], run["dilution"])
+            amounts[name][run["id"]] = value
+            detected[name][run["id"]] = samples.corrected(readings[name][run["id"]], levels[name]) >= a["mdl"]
+            mark = samples.flag(readings[name][run["id"]], levels[name], run["dilution"], a)
+            reported.append(
+                {
+                    "id": run["id"],
+                    "analyte": name,
+                    "value": None if mark == "ND" else value,
+                    "flag": mark,
+                    "ccv_ok": qc.bracket_ok(runs, index, ccv_pass[name]),
+                }
+            )
+
+    spikes = []
+    for run in runs:
+        if run["kind"] != "spike":
+            continue
+        for a in analytes:
+            name = a["name"]
+            recovery = qc.spike_recovery(
+                amounts[name][run["id"]],
+                amounts[name][run["parent"]],
+                run["added"][name],
+                run["dilution"],
+                detected[name][run["id"]] and detected[name][run["parent"]],
+            )
+            spikes.append({"id": run["id"], "analyte": name, "recovery": recovery})
+
+    return {"blank_levels": levels, "samples": reported, "ccvs": ccvs, "spikes": spikes}
diff --git a/app/tools/_fixed/metalquant/samples.py b/app/tools/_fixed/metalquant/samples.py
new file mode 100644
--- /dev/null
+++ b/app/tools/_fixed/metalquant/samples.py
@@ -0,0 +1,18 @@
+"""Amounts and flags for samples and spikes (SOP section 5)."""
+
+
+def corrected(reading, level):
+    return reading - level
+
+
+def amount(reading, level, dilution):
+    return (reading - level) * dilution
+
+
+def flag(reading, level, dilution, analyte):
+    value = corrected(reading, level)
+    if value < analyte["mdl"]:
+        return "ND"
+    if value < analyte["loq"]:
+        return "J"
+    return ""
