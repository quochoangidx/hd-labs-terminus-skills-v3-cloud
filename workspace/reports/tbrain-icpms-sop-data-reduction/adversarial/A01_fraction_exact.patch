diff --git a/app/src/metalquant/exact.py b/app/src/metalquant/exact.py
new file mode 100644
index 0000000..b5bced7
--- /dev/null
+++ b/app/src/metalquant/exact.py
@@ -0,0 +1,20 @@
+"""Exact rational arithmetic for SOP TM-07; floats only at the report boundary."""
+
+import sys
+from fractions import Fraction as F
+
+
+def q(x):
+    return F(x)
+
+
+def ols(points):
+    n = len(points)
+    mx = sum(x for x, _ in points) / n
+    my = sum(y for _, y in points) / n
+    slope = sum((x - mx) * (y - my) for x, y in points) / sum((x - mx) ** 2 for x, _ in points)
+    return slope, my - slope * mx
+
+
+def note(msg):
+    sys.stderr.write("metalquant: " + msg + "\n")
