            alone = copy.deepcopy(form)
            for s in alone["stations"]:
                keep = set(accumulated(s))
                for k, e in enumerate(s["days"] + [s["next"]]):
                    if k not in keep and e["precip"] not in ("A", "M"):
                        e["precip"] = "0.00"
