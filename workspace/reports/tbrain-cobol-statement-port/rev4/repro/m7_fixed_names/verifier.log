    def _run_port_paths(readings_source, payments_source, tag="run"):
        """Run the port on one extract pair as an unprivileged user; return its output bytes.
    
        The three files sit in different directories under names taken from the case,
        and the port runs from a fourth, empty directory, so only the paths it is given
        lead to them."""
