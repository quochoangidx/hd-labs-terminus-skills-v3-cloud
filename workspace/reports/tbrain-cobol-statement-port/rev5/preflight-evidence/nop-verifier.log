___________________________ test_long_run_no_header ____________________________

    def test_long_run_no_header():
        # The same limit reached by customer records alone: no header, 500 C records
        # and a posting to each account, the last one included, so a port that keeps
        # one of its 500 places for a header drops a bill and rejects a posting.
        with open(os.path.join(CASES, "long_run_no_header.dat"), "rb") as fh:
            readings = fh.read().split(b"\n")[:-1]
        with open(os.path.join(CASES, "long_run_no_header.pay"), "rb") as fh:
            postings = fh.read().split(b"\n")[:-1]
        assert len(readings) == 500 and all(r.startswith(b"C") for r in readings)
        assert len(postings) == 500 and postings[-1].startswith(readings[-1][1:9] + b";")
>       check("long_run_no_header")

