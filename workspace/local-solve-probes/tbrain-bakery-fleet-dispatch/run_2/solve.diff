+def load_warm(inst, path):
+    pl = json.load(open(path))
+    idmap = {cid: i for i, cid in enumerate(inst.ids)}
+    routes = []
+    for r in pl["routes"]:
+        stops = [idmap[c] for c in r["stops"]]
+        ti = inst.tidx[r["type"]]
+        ev = eval_route(inst, stops, inst.types[ti])
+        if ev is None:
+            return None
+        routes.append([stops, ti, ev[0]])
+    return routes
