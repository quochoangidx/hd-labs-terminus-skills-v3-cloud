+def repair(inst, routes, pool, rng, regret=True, noise=0.0):
+    used = counts_used(inst, routes)
+    pool = list(pool)
+    cache = {}
+    dirty = set(pool)
+    posmap = make_posmap(routes)
+    while pool:
+        for c in list(dirty):
+            if c in pool:
+                cache[c] = try_insert_all(inst, routes, used, c, noise, rng, posmap)
+        dirty.clear()
+        bestpick = None
+        for c in pool:
+            b, b2 = cache[c]
+            if b is None:
+                return False
+            if regret:
+                key = (-((b2[0] - b[0]) if b2 else 10 ** 7), b[0])
+            else:
+                key = (b[0], 0)
+            if bestpick is None or key < bestpick[0]:
+                bestpick = (key, c, b)
+        _, c, b = bestpick
+        delta, ri, pos, tj, nd = b
+        if ri == -1:
+            routes.append([[c], tj, nd])
+            used[tj] += 1
+            newri = len(routes) - 1
+        else:
+            stops, ti, _ = routes[ri]
+            stops.insert(pos, c)
+            if tj != ti:
+                used[ti] -= 1
+                used[tj] += 1
+                routes[ri][1] = tj
+            routes[ri][2] = nd
+            newri = ri
+        pool.remove(c)
+        posmap = make_posmap(routes)
+        nbset = set(inst.nb[c])
+        for c2 in pool:
+            cb = cache[c2][0]
+            if cb is None or cb[1] == newri or cb[1] == -1 or c2 in nbset:
+                dirty.add(c2)
+    return True
