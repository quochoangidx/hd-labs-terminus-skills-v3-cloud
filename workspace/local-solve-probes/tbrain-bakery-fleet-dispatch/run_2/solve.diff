+def _loop(inst, rng, t0, deadline, seconds, n, best, bestc, cur, curc):
+    import os
+    T0 = max(1.0, bestc * float(os.environ.get("SA_T", "0.006")))
+    it = 0
+    # relatedness
+    D = inst.D
+    while time.time() < deadline:
+        it += 1
+        frac = (time.time() - t0) / seconds
+        T = T0 * (0.02 ** frac)
+        cand = [[list(s), ti, d] for s, ti, d in cur]
+        op = rng.random()
+        removed = []
+        if rng.random() < 0.18:
+            maxrem = max(8, int(n * 0.5))
+        else:
+            maxrem = max(4, min(int(n * 0.25), 30))
+        k = rng.randint(max(3, int(n * 0.05)), maxrem)
+        if op < 0.30:
+            # random removal
+            pos = [(ri, i) for ri in range(len(cand)) for i in range(len(cand[ri][0]))]
+            rng.shuffle(pos)
+            pick = set()
+            for ri, i in pos[:k]:
+                pick.add(cand[ri][0][i])
+            removed = list(pick)
+        elif op < 0.70:
+            # related (Shaw) removal
+            seed_c = rng.randint(1, n)
+            allcur = [c for r in cand for c in r[0]]
+            allcur.sort(key=lambda c: D[seed_c][c] + abs(inst.due[c] - inst.due[seed_c]) / 600.0)
+            removed = allcur[:k]
+        elif op < 0.88:
+            # route removal
+            rng.shuffle(cand)
+            removed = []
+            nr = rng.randint(1, max(1, min(3, len(cand) - 1)))
+            for _ in range(nr):
+                if len(cand) <= 1:
+                    break
+                idx = rng.randrange(len(cand))
+                removed.extend(cand[idx][0])
+                cand.pop(idx)
+        else:
+            # worst removal
+            scored = []
+            for ri, (stops, ti, d) in enumerate(cand):
+                t = inst.types[ti]
+                for i, c in enumerate(stops):
+                    pv = stops[i - 1] if i else 0
+                    nx = stops[i + 1] if i + 1 < len(stops) else 0
+                    scored.append((-(D[pv][c] + D[c][nx] - D[pv][nx]) * t["pu"], c))
+            scored.sort()
+            removed = [c for _, c in scored[:k]]
+        rset = set(removed)
+        if not rset:
+            continue
+        for r in cand:
+            r[0] = [c for c in r[0] if c not in rset]
+        cand = [r for r in cand if r[0]]
+        for r in cand:
+            ev = eval_route(inst, r[0], inst.types[r[1]])
+            if ev is None:
+                r[2] = None
+            else:
+                r[2] = ev[0]
+        if any(r[2] is None for r in cand):
+            continue
+        use_regret = rng.random() < 0.6
+        noise = 0.0 if rng.random() < 0.5 else max(1.0, bestc * 0.0005)
+        ok = repair(inst, cand, removed, rng, regret=use_regret, noise=noise)
+        if not ok:
+            continue
+        for r in cand:
+            if any(c in rset for c in r[0]):
+                improve_route(inst, r)
+        retype(inst, cand)
+        cc = total_cost(inst, cand)
+        if cc < bestc * 1.0015:
+            # polish
+            for r in cand:
+                improve_route(inst, r)
+            ls_inter(inst, cand, rng, min(deadline, time.time() + 1.5), rounds=3)
+            for r in cand:
+                improve_route(inst, r)
+            retype(inst, cand)
+            cc = total_cost(inst, cand)
+        if cc < curc - 1e-9 or rng.random() < math.exp(-(cc - curc) / max(T, 1e-9)):
+            cur = cand
+            curc = cc
+        if cc < bestc - 1e-9:
+            best = [[list(s), ti, d] for s, ti, d in cand]
+            bestc = cc
+            sys.stderr.write("it %d t %.0f best %d\n" % (it, time.time() - t0, bestc))
+            sys.stderr.flush()
+        if curc > bestc * float(os.environ.get('SA_R', '1.15')):
+            cur = [[list(s), ti, d] for s, ti, d in best]
+            curc = bestc
+    sys.stderr.write("iterations %d\n" % it)
+    return best, bestc
+
+
+def write_plan(inst, routes, path):
+    out = []
+    for stops, ti, dist in routes:
+        t = inst.types[ti]
+        ev = eval_route(inst, stops, t)
+        assert ev is not None
+        out.append({"type": t["name"], "depart": int(ev[1]),
+                    "stops": [inst.ids[c] for c in stops]})
+    json.dump({"routes": out}, open(path, "w"))
+
+
+def main():
+    orders = sys.argv[1]
+    outp = sys.argv[2]
+    seconds = float(sys.argv[3]) if len(sys.argv) > 3 else 60.0
+    seed = int(sys.argv[4]) if len(sys.argv) > 4 else 1
+    warm = sys.argv[5] if len(sys.argv) > 5 else None
+    inst = Inst(orders)
+    build_neighbors(inst)
+    routes, cost = solve(inst, seconds, seed, warm)
+    write_plan(inst, routes, outp)
+    print("cost", int(cost))
+
+
+if __name__ == "__main__":
+    main()
