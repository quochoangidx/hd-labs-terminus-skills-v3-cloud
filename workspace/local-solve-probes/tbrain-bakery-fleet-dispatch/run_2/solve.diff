+def build_neighbors(inst, K=22):
+    D = inst.D
+    n = inst.n
+    nb = [None] * (n + 1)
+    for c in range(1, n + 1):
+        order = sorted(range(1, n + 1), key=lambda v: D[c][v])
+        nb[c] = [v for v in order if v != c][:K]
+    inst.nb = nb
+
+
+def try_insert_all(inst, routes, used, c, noise, rng, posmap):
+    """Best insertion of customer c. Return (best, best2) tuples."""
+    best = None
+    best2 = None
+    ntypes = len(inst.types)
+    types = inst.types
+    # candidate (route, position) pairs from nearest neighbours
+    cands = {}
+    for v in inst.nb[c]:
+        pm = posmap.get(v)
+        if pm is None:
+            continue
+        ri, idx = pm
+        st = cands.setdefault(ri, set())
+        st.add(idx)
+        st.add(idx + 1)
+    for ri, r in enumerate(routes):
+        if len(r[0]) <= 3:
+            cands.setdefault(ri, set()).update(range(len(r[0]) + 1))
+    for ri, poss in cands.items():
+        stops, ti, dist = routes[ri]
+        cur = rcost(inst, ti, dist)
+        cand_types = [ti]
+        for tj in range(ntypes):
+            if tj != ti and used[tj] < types[tj]["count"]:
+                cand_types.append(tj)
+        m = len(stops)
+        for pos in poss:
+            if pos > m:
+                continue
+            ns = stops[:pos] + [c] + stops[pos:]
+            for tj in cand_types:
+                r = eval_route(inst, ns, types[tj])
+                if r is None:
+                    continue
+                delta = rcost(inst, tj, r[0]) - cur
+                if noise:
+                    delta += rng.uniform(-noise, noise)
+                if best is None or delta < best[0]:
+                    best2 = best
+                    best = (delta, ri, pos, tj, r[0])
+                elif best2 is None or delta < best2[0]:
+                    best2 = (delta, ri, pos, tj, r[0])
+    for tj in range(ntypes):
+        if used[tj] >= types[tj]["count"]:
+            continue
+        r = eval_route(inst, [c], types[tj])
+        if r is None:
+            continue
+        delta = rcost(inst, tj, r[0])
+        if noise:
+            delta += rng.uniform(-noise, noise)
+        if best is None or delta < best[0]:
+            best2 = best
+            best = (delta, -1, 0, tj, r[0])
+        elif best2 is None or delta < best2[0]:
+            best2 = (delta, -1, 0, tj, r[0])
+    return best, best2
+
