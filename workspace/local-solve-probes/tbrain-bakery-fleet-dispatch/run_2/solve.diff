+"""Heterogeneous fleet VRP with time windows solver (ALNS).
+
+Usage: python3 planner/solve.py orders/<m>.json plans/<m>.json [seconds] [seed]
+"""
+import json
+import math
+import random
+import sys
+import time
+
+
+def isqrt_ceil(sq):
+    d = math.isqrt(sq)
+    return d if d * d == sq else d + 1
+
+
+class Inst:
+    def __init__(self, path):
+        o = json.load(open(path))
+        self.raw = o
+        dp = o["depot"]
+        self.open = dp["open"]
+        self.close = dp["close"]
+        cs = sorted(o["customers"], key=lambda c: c["id"])
+        self.n = len(cs)
+        self.ids = [0] + [c["id"] for c in cs]
+        X = [dp["x"]] + [c["x"] for c in cs]
+        Y = [dp["y"]] + [c["y"] for c in cs]
+        self.dem = [0] + [c["demand"] for c in cs]
+        self.ready = [self.open] + [c["ready"] for c in cs]
+        self.due = [self.close] + [c["due"] for c in cs]
+        self.serv = [0] + [c["service"] for c in cs]
+        N = self.n + 1
+        self.D = [[0] * N for _ in range(N)]
+        for i in range(N):
+            Di = self.D[i]
+            xi, yi = X[i], Y[i]
+            for j in range(N):
+                dx = xi - X[j]
+                dy = yi - Y[j]
+                Di[j] = isqrt_ceil(dx * dx + dy * dy)
+        self.types = []
+        for f in o["fleet"]:
+            self.types.append({
+                "name": f["type"], "count": f["count"], "cap": f["capacity"],
+                "fixed": f["fixed"], "pu": f["per_unit"], "pace": f["pace"],
+                "shift": f["shift"], "range": f["range"] if f["range"] is not None else 10**9,
+            })
+        # order types cheapest-first by fixed cost
+        self.types.sort(key=lambda t: (t["fixed"], t["pu"]))
+        self.tidx = {t["name"]: i for i, t in enumerate(self.types)}
+
+
+def eval_route(inst, stops, t):
+    """Return (dist, depart) if feasible else None."""
+    if not stops:
+        return None
+    D = inst.D
+    dem = inst.dem
+    q = 0
+    for c in stops:
+        q += dem[c]
+    if q > t["cap"]:
+        return None
+    prev = 0
+    d = 0
+    for c in stops:
+        d += D[prev][c]
+        prev = c
+    d += D[prev][0]
+    if d > t["range"]:
+        return None
+    p = t["pace"]
+    ready = inst.ready
+    due = inst.due
+    serv = inst.serv
+    # backward pass: latest departure
+    lat = inst.close - D[stops[-1]][0] * p
+    for k in range(len(stops) - 1, -1, -1):
+        c = stops[k]
+        st = lat - serv[c]
+        if st > due[c]:
+            st = due[c]
+        if st < ready[c]:
+            return None
+        pv = stops[k - 1] if k else 0
+        lat = st - D[pv][c] * p
+    dep = lat
+    if dep < inst.open:
+        return None
+    if dep - inst.open > 0:
+        pass
+    # forward sim from dep
+    clock = dep
+    prev = 0
+    for c in stops:
+        a = clock + D[prev][c] * p
+        if a < ready[c]:
+            a = ready[c]
+        if a > due[c]:
+            return None
+        clock = a + serv[c]
+        prev = c
+    back = clock + D[prev][0] * p
+    if back > inst.close:
+        return None
+    if back - dep > t["shift"]:
+        return None
+    return (d, dep)
+
+
+class Sol:
+    __slots__ = ("routes", "cost")
+
+    def __init__(self):
+        self.routes = []  # list of [stops list, type index, dist]
+        self.cost = 0
+
+
+def rcost(inst, ti, dist):
+    t = inst.types[ti]
+    return t["fixed"] + t["pu"] * dist
+
+
+def total_cost(inst, routes):
+    return sum(rcost(inst, ti, d) for _, ti, d in routes)
+
+
+def counts_used(inst, routes):
+    u = [0] * len(inst.types)
+    for _, ti, _ in routes:
+        u[ti] += 1
+    return u
+
+
+def improve_route(inst, r):
+    """Intra-route 2-opt and or-opt; keeps type, shortens distance."""
+    t = inst.types[r[1]]
+    stops = r[0]
+    best = r[2]
+    changed = True
+    while changed:
+        changed = False
+        m = len(stops)
+        if m < 3:
+            break
+        for i in range(m - 1):
+            for j in range(i + 1, m):
+                ns = stops[:i] + stops[i:j + 1][::-1] + stops[j + 1:]
+                ev = eval_route(inst, ns, t)
+                if ev is not None and ev[0] < best:
+                    stops = ns
+                    best = ev[0]
+                    changed = True
+                    break
+            if changed:
+                break
+        if changed:
+            continue
+        for L in (1, 2, 3):
+            for i in range(m - L + 1):
+                seg = stops[i:i + L]
+                rest = stops[:i] + stops[i + L:]
+                for k in range(len(rest) + 1):
+                    if k == i:
+                        continue
+                    for sg in (seg, seg[::-1]):
+                        ns = rest[:k] + sg + rest[k:]
+                        ev = eval_route(inst, ns, t)
+                        if ev is not None and ev[0] < best:
+                            stops = ns
+                            best = ev[0]
+                            changed = True
+                            break
+                    if changed:
+                        break
+                if changed:
+                    break
+            if changed:
+                break
+    r[0] = stops
+    r[2] = best
+
