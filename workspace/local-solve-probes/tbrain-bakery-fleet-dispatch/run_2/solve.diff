+def ls_inter(inst, routes, rng, deadline, rounds=8):
+    """Neighbour-restricted relocate + swap between routes."""
+    types = inst.types
+    nb = inst.nb
+    for _ in range(rounds):
+        if time.time() > deadline:
+            break
+        posmap = make_posmap(routes)
+        any_imp = False
+        order = [c for c in range(1, inst.n + 1)]
+        rng.shuffle(order)
+        for c in order:
+            pm = posmap.get(c)
+            if pm is None:
+                continue
+            ri, idx = pm
+            r_i = routes[ri]
+            ti = r_i[1]
+            base_i = rcost(inst, ti, r_i[2])
+            ns_i = r_i[0][:idx] + r_i[0][idx + 1:]
+            if ns_i:
+                ev_i = eval_route(inst, ns_i, types[ti])
+                if ev_i is None:
+                    continue
+                new_i = rcost(inst, ti, ev_i[0])
+                di = ev_i[0]
+            else:
+                new_i = 0
+                di = 0
+            gain = base_i - new_i
+            bestmv = None
+            seen = set()
+            for v in nb[c]:
+                pv = posmap.get(v)
+                if pv is None:
+                    continue
+                rj = pv[0]
+                if rj == ri:
+                    continue
+                r_j = routes[rj]
+                base_j = rcost(inst, r_j[1], r_j[2])
+                for pos in (pv[1], pv[1] + 1):
+                    if (rj, pos) in seen:
+                        continue
+                    seen.add((rj, pos))
+                    cand = r_j[0][:pos] + [c] + r_j[0][pos:]
+                    ev = eval_route(inst, cand, types[r_j[1]])
+                    if ev is None:
+                        continue
+                    delta = rcost(inst, r_j[1], ev[0]) - base_j - gain
+                    if delta < -1e-9 and (bestmv is None or delta < bestmv[0]):
+                        bestmv = (delta, rj, pos, ev[0])
+            if bestmv:
+                _, rj, pos, ndj = bestmv
+                routes[rj][0].insert(pos, c)
+                routes[rj][2] = ndj
+                routes[ri][0] = ns_i
+                routes[ri][2] = di
+                any_imp = True
+                posmap = make_posmap(routes)
+                continue
+            # swap c with a nearby customer in another route
+            for v in nb[c]:
+                pv = posmap.get(v)
+                if pv is None:
+                    continue
+                rj, jdx = pv
+                if rj == ri:
+                    continue
+                r_j = routes[rj]
+                base_j = rcost(inst, r_j[1], r_j[2])
+                a = r_i[0][:idx] + [v] + r_i[0][idx + 1:]
+                b = r_j[0][:jdx] + [c] + r_j[0][jdx + 1:]
+                ea = eval_route(inst, a, types[ti])
+                if ea is None:
+                    continue
+                eb = eval_route(inst, b, types[r_j[1]])
+                if eb is None:
+                    continue
+                delta = (rcost(inst, ti, ea[0]) + rcost(inst, r_j[1], eb[0])
+                         - base_i - base_j)
+                if delta < -1e-9:
+                    routes[ri][0] = a
+                    routes[ri][2] = ea[0]
+                    routes[rj][0] = b
+                    routes[rj][2] = eb[0]
+                    any_imp = True
+                    posmap = make_posmap(routes)
+                    break
+        # cross-route segment relocation (or-opt, length 2-3)
+        posmap = make_posmap(routes)
+        for c in order:
+            if time.time() > deadline:
+                break
+            pm = posmap.get(c)
+            if pm is None:
+                continue
+            ri, idx = pm
+            r_i = routes[ri]
+            for L in (2, 3):
+                if idx + L > len(r_i[0]):
+                    continue
+                seg = r_i[0][idx:idx + L]
+                rest = r_i[0][:idx] + r_i[0][idx + L:]
+                base_i = rcost(inst, r_i[1], r_i[2])
+                if rest:
+                    ev_i = eval_route(inst, rest, types[r_i[1]])
+                    if ev_i is None:
+                        continue
+                    new_i = rcost(inst, r_i[1], ev_i[0])
+                    di = ev_i[0]
+                else:
+                    new_i = 0
+                    di = 0
+                gain = base_i - new_i
+                done = False
+                tried = set()
+                for v in nb[c]:
+                    pv = posmap.get(v)
+                    if pv is None or pv[0] == ri:
+                        continue
+                    rj = pv[0]
+                    r_j = routes[rj]
+                    base_j = rcost(inst, r_j[1], r_j[2])
+                    for pos in (pv[1], pv[1] + 1):
+                        if (rj, pos) in tried:
+                            continue
+                        tried.add((rj, pos))
+                        for sg in (seg, seg[::-1]):
+                            cand = r_j[0][:pos] + sg + r_j[0][pos:]
+                            ev = eval_route(inst, cand, types[r_j[1]])
+                            if ev is None:
+                                continue
+                            if rcost(inst, r_j[1], ev[0]) - base_j - gain < -1e-9:
+                                routes[rj][0] = cand
+                                routes[rj][2] = ev[0]
+                                routes[ri][0] = rest
+                                routes[ri][2] = di
+                                any_imp = True
+                                done = True
+                                break
+                        if done:
+                            break
+                    if done:
+                        break
+                if done:
+                    posmap = make_posmap(routes)
+                    break
+        routes[:] = [r for r in routes if r[0]]
+        if not any_imp:
+            break
+    return routes
