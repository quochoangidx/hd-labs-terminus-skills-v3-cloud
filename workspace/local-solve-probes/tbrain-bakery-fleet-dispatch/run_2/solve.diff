+def solve(inst, seconds, seed, warm=None):
+    rng = random.Random(seed)
+    t0 = time.time()
+    deadline = t0 + seconds
+    n = inst.n
+    allc = list(range(1, n + 1))
+    routes = load_warm(inst, warm) if warm else None
+    if routes is not None:
+        for r in routes:
+            improve_route(inst, r)
+        retype(inst, routes)
+        best = [[list(s), ti, d] for s, ti, d in routes]
+        bestc = total_cost(inst, best)
+        cur = [[list(s), ti, d] for s, ti, d in routes]
+        curc = bestc
+        return _loop(inst, rng, t0, deadline, seconds, n, best, bestc, cur, curc)
+    routes = []
+    if not repair(inst, routes, allc, rng, regret=True):
+        # fallback: greedy
+        routes = []
+        if not repair(inst, routes, allc, rng, regret=False):
+            raise SystemExit("no feasible initial solution")
+    for r in routes:
+        improve_route(inst, r)
+    retype(inst, routes)
+    ls_inter(inst, routes, rng, min(deadline, time.time() + 20), rounds=20)
+    for r in routes:
+        improve_route(inst, r)
+    retype(inst, routes)
+    best = [[list(s), ti, d] for s, ti, d in routes]
+    bestc = total_cost(inst, best)
+    cur = [[list(s), ti, d] for s, ti, d in routes]
+    curc = bestc
+    return _loop(inst, rng, t0, deadline, seconds, n, best, bestc, cur, curc)
