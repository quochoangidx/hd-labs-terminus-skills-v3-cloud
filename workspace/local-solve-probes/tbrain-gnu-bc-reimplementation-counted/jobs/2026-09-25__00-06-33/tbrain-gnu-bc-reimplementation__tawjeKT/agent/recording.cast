[226.235569, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'\ns=open(p).read()\nold=\"\"\"            if self.cur().k=='define':\n                blocks.append([self.function()]); self.seps(); continue\n\"\"\"\nnew=\"\"\"            if self.cur().k=='define':\n                fb=[self.function()]\n                if self.saw_quit: fb.append(('force_quit',))\n                blocks.append(fb)\n                if self.saw_quit: break\n                self.seps(); continue\n\"\"\"\nassert old in s\nopen(p,'w').write(s.replace(old,new))\nPY\npython3 -m py_compile /app/pybc/bc.py\nprintf '1\\nif(0) quit\\n99\\n' | python3 /app/pybc/bc.py | cat -A\nprintf '1\\nif(0) halt\\n2\\nhalt\\n3\\n' | python3 /app/pybc/bc.py | cat -A\nprintf 'scale=3\\n1/8\\ndefine f(n){if(n<2)return(1);return(n*f(n-1))}\\nf(6)\\n' | python3 /app/pybc/bc.py | cat -A\n"]
