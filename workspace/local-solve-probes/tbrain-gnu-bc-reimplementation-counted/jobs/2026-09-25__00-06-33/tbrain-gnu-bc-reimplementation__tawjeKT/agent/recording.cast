[78.363681, "i", "ression',t))\r        if self.cur().k in ('++','--'):\r            op=self.cur().k; self.i+=1; left=('post',op,left)\r        prec={'=':10,'+=':10,'-=':10,'*=':10,'/=':10,'%=':10,'^=':10,\r              '||':20,'&&':30,'==':40,'!=':40,'<':40,'>':40,'<=':40,'>=':40,\r              '+':50,'-':50,'*':60,'/':60,'%':60,'^':70}\r        while self.cur().k in prec and prec[self.cur().k]>=minp:\r            op=self.cur().k; p=prec[op]; self.i+=1\r            # assignment and exponentiation associate right-to-left\r            right=self.expr(p if op in ('=','+=','-=','*=','/=','%=','^=','^') else p+1)\r            left=('assign',op,left,right) if op.endswith('=') and op not in ('==','!=','<=','>=') else ('binary',op,left,right)\r        return left\r\rclass Array:\r    def __init__(self): self.d={}\r    def clone(self):\r        x=Array(); x.d={k:v.copy() for k,v in self.d.items()}; return x\r\rclass Ref:\r    def __init__(self,get,set): self.get=get; self.set=set\r\rclass Runtime:\r    def __init__(self):\r        self.vars={}; self.array"]
[78.363686, "i", "s={}; self.funcs={}; self.scale=0; self.ibase=10; self.obase=10\r        self.last=Num(); self.base_stack=[]; self.col=0\r    def varget(self,n):\r        if n=='scale': return Num(self.scale,0)\r        if n=='ibase': return Num(self.ibase,0)\r        if n=='obase': return Num(self.obase,0)\r        if n in ('last','.'): return self.last.copy()\r        return self.vars.get(n,Num()).copy()\r    def varset(self,n,v):\r        v=v.copy()\r        if n=='scale': self.scale=max(0,v.integer()); return\r        if n=='ibase': self.ibase=max(2,min(16,v.integer())); return\r        if n=='obase': self.obase=max(2,min(999,v.integer())); return\r        if n in ('last','.'): self.last=v; return\r        self.vars[n]=v\r    def arr(self,n):\r        if n not in self.arrays: self.arrays[n]=Array()\r        return self.arrays[n]\r    def idx(self,v):\r        if v.c<0 or (v.integer()==0 and v.c!=0): raise BCError()\r        x=v.integer()\r        if x<0 or x>=65536: raise BCError()\r        return x\r    def ref(self,e,base=None):\r        if e"]
[78.363689, "i", "[0]=='var':\r            n=e[1]; return Ref(lambda:self.varget(n),lambda v:self.varset(n,v))\r        if e[0]=='arr':\r            a=self.arr(e[1]); i=self.idx(self.eval(e[2],base))\r            return Ref(lambda:a.d.get(i,Num()).copy(),lambda v:a.d.__setitem__(i,v.copy()))\r        raise BCError()\r    def constant(self,text,base):\r        b=base if base is not None else self.ibase\r        neg=False\r        if '.' in text: ip,fp=text.split('.',1)\r        else: ip,fp=text,''\r        def digit(ch): return int(ch) if ch.isdigit() else ord(ch)-55\r        # single digit rule applies to integer portion\r        if len(ip)==1: iv=digit(ip[0])\r        else:\r            iv=0\r            for ch in ip or '0': iv=iv*b+min(digit(ch),b-1)\r        s=len(fp)\r        if not fp: return Num(iv,0)\r        f=0\r        for ch in fp: f=f*b+min(digit(ch),b-1)\r        # truncate base fraction to exactly s decimal places\r        fc=(f*10**s)//(b**s)\r        return Num(iv*10**s+fc,s)\r    def eval(self,e,base=None):\r        k=e[0]\r        if"]
