[148.540397, "i", "cat > /tmp/control.bc <<'EOF'\na=1; ++a; a++; a; --a; a--; a\n3+4*5; 2^3^2; -2^2\n1<2==1; 1||0&&0\n7\nlast\n.\nfor(i=0;;i++) { print i; if(i==2) break }\nprint \"\\n\"\nif(1) if(0) print \"bad\\n\" else print \"near\\n\"\nEOF\npython3 /app/pybc/bc.py /tmp/control.bc </dev/null | cat -A\n"]
[148.540816, "o", "cat > /tmp/control.bc <<'EOF'"]
