[128.947008, "i", "cat > /tmp/functions.bc <<'EOF'\na=10\ndefine f(x) {\n auto a;\n a=x\n if(x<=0) return(a)\n return(f(x-1)+a)\n}\nf(3)\na\nibase=2\ndefine g(x) {\n ibase=10\n return(10+x)\n}\ng(10)\nibase=10\nx[1]=7\ndefine byval(a[]) { a[1]=9; return(a[1]) }\ndefine byref(*a[]) { a[1]=8; return(a[1]) }\nbyval(x[]); x[1]; byref(x[]); x[1]\ndefine bad(x) { print x,\" before\\n\"; return(1/0) }\nbad(4); print \"not reached\\n\"\nprint \"recovered\\n\"\nEOF\npython3 /app/pybc/bc.py /tmp/functions.bc </dev/null | cat -A\n"]
[128.950577, "o", "cat > /tmp/functions.bc <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> a=10\r\n\u001b[?2004l\r\u001b[?2004h> define f(x) {\r\n\u001b[?2004l\r\u001b[?2004h>  auto a;\r\n\u001b[?2004l\r\u001b[?2004h>  a=x\r\n\u001b[?2004l\r\u001b[?2004h>  if(x<=0) return(a)\r\n\u001b[?2004l\r\u001b[?2004h>  return(f(x-1)+a)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> f(3)\r\n\u001b[?2004l\r\u001b[?2004h> a\r\n\u001b[?2004l\r\u001b[?2004h> ibase=2\r\n\u001b[?2004l\r\u001b[?2004h> define g(x) {\r\n\u001b[?2004l\r\u001b[?2004h>  ibase=10\r\n\u001b[?2004l\r\u001b[?2004h>  return(10+x)\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> g(10)\r\n\u001b[?2004l\r\u001b[?2004h> ibase=10\r\n\u001b[?2004l\r\u001b[?2004h> x[1]=7\r\n\u001b[?2004l\r\u001b[?2004h> define byval(a[]) { a[1]=9; return(a[1]) }\r\n\u001b[?2004l\r\u001b[?2004h> define byref(*a[]) { a[1]=8; return(a[1]) }\r\n\u001b[?2004l\r\u001b[?2004h> byval(x[]); x[1]; byref(x[]); x[1]\r\n\u001b[?2004l\r\u001b[?2004h> define bad(x) { print x,\" before\\n\"; return(1/0) }\r\n\u001b[?2004l\r\u001b[?2004h> bad(4); print \"not reached\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> print \"recovered\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
