[212.472184, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'\ns=open(p).read()\n# Remove escaped physical newlines during lexing.\ns=s.replace(\"        if c in ' \\\\t\\\\r': i+=1; continue\\n        if c=='\\\\n':\", \"        if c in ' \\\\t\\\\r': i+=1; continue\\n        if c=='\\\\\\\\' and i+1<n and src[i+1]=='\\\\n': i+=2; line+=1; continue\\n        if c=='\\\\n':\")\n# Record that a parsed execution block contains quit anywhere in its syntax.\ns=s.replace(\"    def __init__(self,toks): self.t=toks; self.i=0\", \"    def __init__(self,toks): self.t=toks; self.i=0; self.saw_quit=False\")\ns=s.replace(\"            blocks.append(block)\\n        return blocks\", \"            if self.saw_quit:\\n                block.append(('force_quit',)); blocks.append(block); break\\n            blocks.append(block)\\n        return blocks\")\ns=s.replace(\"        if k in ('break','continue','halt','quit'):\\n            self.i+=1; return (k,)\", \"        if k in ('break','continue','halt','quit'):\\n            self.i+=1\\n            if k=='quit': self.saw_quit=True\\n            retu"]
[212.478055, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/pybc/bc.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> # Remove escaped physical newlines during lexing.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"        if c in ' \\\\t\\\\r': i+=1; continue\\n        if c=='\\\\n':\", \"        if c in ' \\\\t\\\\r': i+=1; continue\\n        if c=='\\\\\\\\' and i+1<n and src[i+1]=='\\\\n': i+=2; line+=1; continue\\n        if c=='\\\\n':\")\r\n\u001b[?2004l\r\u001b[?2004h> # Record that a parsed execution block contains quit anywhere in its syntax.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"    def __init__(self,toks): self.t=toks; self.i=0\", \"    def __init__(self,toks): self.t=toks; self.i=0; self.saw_quit=False\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"            blocks.append(block)\\n        return blocks\", \"            if self.saw_quit:\\n                block.append(('force_quit',)); blocks.append(block); break\\n            blocks.append(block)\\n        return blocks\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"        if k in ('break','continue','halt','quit'):\\n            self"]
[212.481673, "i", "rn (k,)\")\n# A branch-dependent quit AST itself is inert; force_quit at the block boundary implements read-time quit.\ns=s.replace(\"        elif k=='halt': raise Halt()\\n        elif k=='quit': raise Quit()\", \"        elif k=='halt': raise Halt()\\n        elif k=='quit': pass\\n        elif k=='force_quit': raise Quit()\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pybc/bc.py\nprintf '1+\\\\\\n2\\nif(0) quit\\n99\\n' | python3 /app/pybc/bc.py | cat -A\n"]
[212.481728, "o", ".i+=1; return (k,)\", \"        if k in ('break','continue','halt','quit'):\\n            self.i+=1\\n            if k=='quit': self.saw_quit=True\\n            return (k,)\")\r\n\u001b[?2004l\r\u001b[?2004h> # A branch-dependent quit AST itself is inert; force_quit at the block boundary implements read-time quit.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"        elif k=='halt': raise Halt()\\n        elif k=='quit': raise Quit()\", \"        elif k=='halt': raise Halt()\\n        elif k=='quit': pass\\n        elif k=='force_quit': raise Quit()\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
