[213.128588, "i", "printf '40\\n' >/tmp/pre.bc\nprintf '2\\n' | python3 /app/pybc/bc.py /tmp/pre.bc | cat -A\ncat > /tmp/final.bc <<'EOF'\nscale=4\n1/3\n2.50*3.0\nsqrt(2)\na[1]=4\ndefine f(n,a[]) { auto x; if(n==0) return(a[1]); x=f(n-1,a[]); return(x+n) }\nf(4,a[])\ndefine void v(*a[]) { a[1]++; print \"v=\",a[1],\"\\n\" }\nv(a[])\na[1]\nobase=16\n255.50\nobase=20\n399.50\nobase=10\nprint \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789------X\\n\"\n1/0; print \"bad\\n\"\nprint \"recovered\\n\"\nEOF\npython3 /app/pybc/bc.py /tmp/final.bc </dev/null | cat -A\n"]
