[105.129792, "i", "cat <<'EOF' >/tmp/t.bc\nscale=5\ndefine f(n) {\n auto x;\n if(n<=1) return(1)\n return(n*f(n-1))\n}\nf(10)\na[2]=7\ndefine void bump(*x[]) { x[2]+=1; print x[2],\"\\n\" }\nbump(a[])\na[2]\nfor(i=0;i<5;i++) { if(i==2) continue; print i }\nprint \"\\n\"\nEOF\npython3 /app/pybc/bc.py /tmp/t.bc </dev/null; echo status:$?\n"]
