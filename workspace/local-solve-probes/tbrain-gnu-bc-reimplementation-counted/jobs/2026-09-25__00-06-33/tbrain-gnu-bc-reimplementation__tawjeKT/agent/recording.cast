[105.136922, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> scale=5\r\n\u001b[?2004l\r\u001b[?2004h> define f(n) {\r\n\u001b[?2004l\r\u001b[?2004h>  auto x;\r\n\u001b[?2004l\r\u001b[?2004h>  if(n<=1) return(1)\r\n\u001b[?2004l\r\u001b[?2004h>  return(n*f(n-1))\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> f(10)\r\n\u001b[?2004l\r\u001b[?2004h> a[2]=7\r\n\u001b[?2004l\r\u001b[?2004h> define void bump(*x[]) { x[2]+=1; print x[2],\"\\n\" }\r\n\u001b[?2004l\r\u001b[?2004h> bump(a[])\r\n\u001b[?2004l\r\u001b[?2004h> a[2]\r\n\u001b[?2004l\r\u001b[?2004h> for(i=0;i<5;i++) { if(i==2) continue; print i }\r\n\u001b[?2004l\r\u001b[?2004h> print \"\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r\u001b[?2004hroot@609840864bc9:/app# python3 /app/pybc/bc.py /tmp/t.bc </dev/null; echo status:$?\r\n\u001b[?2004l\r"]
