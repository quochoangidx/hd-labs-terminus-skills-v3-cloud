[14.669491, "o", "# pybc\r\n\r\nA pure-Python replacement for GNU bc 1.07.1, for the minimal images that ship\r\nwithout bc.\r\n\r\n- `pybc/bc.py` — the command (`python3 /app/pybc/bc.py [FILE]...`)\r\n- `docs/bc.txt` — the GNU bc manual page\r\n"]
[14.670781, "o", "\r\n"]
[14.671147, "o", "--- bc.py ---\r\n"]
[14.676052, "o", "\"\"\"pybc: a GNU bc 1.07.1 replacement in pure Python.\r\n"]
[14.676133, "o", "\r\n"]
[14.676229, "o", "Usage: python3 /app/pybc/bc.py [FILE]...\r\n\"\"\"\r\n\r\nimport sys\r\n\r\n\r\ndef main(argv):\r\n    sys.stderr.write(\"pybc: not implemented yet\\n\")\r\n"]
[14.676383, "o", "    return 1\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main(sys.argv[1:]))\r\n"]
