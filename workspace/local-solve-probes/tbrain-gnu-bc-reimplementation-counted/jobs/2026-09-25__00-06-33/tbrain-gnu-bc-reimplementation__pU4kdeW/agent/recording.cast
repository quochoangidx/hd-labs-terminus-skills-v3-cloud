[135.339906, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'\ns=open(p).read()\ns=s.replace(\"x=('as',op,x,y) if op.endswith('=') or op=='=' else ('bin',op,x,y)\", \"x=('as',op,x,y) if op in ('=','+=','-=','*=','/=','%=','^=') else ('bin',op,x,y)\")\nold=\"\"\"        if k in ('pre','post'):\n            old=self.lget(e[2]); new=add(old,Num(1),e[1]=='--'); self.lset(e[2],new); return new if k=='pre' else old\n\"\"\"\nnew=\"\"\"        if k in ('pre','post'):\n            lhs=e[2]\n            if lhs[0]=='idx':\n                i=self.idx(self.eval(lhs[2])); en=self.env.arrenv(lhs[1]); ar=en.arrays.setdefault(lhs[1],{})\n                old=ar.get(i,Num()).copy(); new=add(old,Num(1),e[1]=='--'); ar[i]=new.copy()\n            else:\n                old=self.lget(lhs); new=add(old,Num(1),e[1]=='--'); self.lset(lhs,new)\n            return new if k=='pre' else old\n\"\"\"\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pybc/bc.py\npython3 /app/pybc/bc.py <<'EOF'\n1/* middle */+2\nif (0) 11 else 22\nif (1) if (0) 1 else 2\nfor(i=0;i"]
[135.340595, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/pybc/bc.py'\r\n"]
