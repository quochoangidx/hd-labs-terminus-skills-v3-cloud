[259.622588, "i", "'n':'\\\\n','r':'\\\\r','q':'\"','t':'\\\\t','\\\\\\\\':'\\\\\\\\'}\n        out=[]; i=0\n        while i<len(s):\n            if s[i]=='\\\\\\\\' and i+1<len(s):\n                out.append(mp.get(s[i+1],s[i+1])); i+=2\n            else: out.append(s[i]); i+=1\n        self.rawout(''.join(out))\n    def exec(self,s):\n\"\"\"\nassert needle in s\ns=s.replace(needle,repl)\ns=s.replace(\"                if typ=='str': self.rawout(z)\", \"                if typ=='str': self.printstr(z)\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pybc/bc.py\npython3 /app/pybc/bc.py <<'EOF' | od -An -tx1c\n\"A\\nB\"\nprint \"A\\a\\b\\f\\n\\r\\q\\t\\\\\\zB\"\nEOF\npython3 /app/pybc/bc.py <<'EOF'\nscale=4\n1/8\n2^10\nfor(i=0;i<4;i++)print i,\" \"\nprint \"\\n\"\ndefine f(n){if(n<2)return 1;return n*f(n-1)}\nf(6)\nEOF\n"]
