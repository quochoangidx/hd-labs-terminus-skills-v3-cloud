[226.099927, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'\ns=open(p).read()\nold=\"\"\"        toks=lex(''.join(chunks))\n        for qi,t in enumerate(toks):\n            if t.k=='ID' and t.v=='quit':\n                toks=toks[:qi]+[Token('EOF')]; break\n        blocks=Parser(toks).program()\n\"\"\"\nnew=\"\"\"        toks=lex(''.join(chunks))\n        # quit acts while input is read. Keep only execution blocks completed\n        # before the block containing it; that block has not reached its\n        # terminating top-level newline yet.\n        brace=paren=0; safe=0; cut=None\n        for qi,t in enumerate(toks):\n            if t.k=='ID' and t.v=='quit': cut=safe; break\n            if t.k=='{': brace+=1\n            elif t.k=='}': brace=max(0,brace-1)\n            elif t.k=='(': paren+=1\n            elif t.k==')': paren=max(0,paren-1)\n            elif t.k=='NL' and brace==0 and paren==0: safe=qi+1\n        if cut is not None: toks=toks[:cut]+[Token('EOF')]\n        blocks=Parser(toks).program()\n\"\"\"\nassert old in s\nopen(p,'w').write(s.replace(old,new)"]
[226.100843, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[226.100909, "i", ")\nPY\npython3 -m py_compile /app/pybc/bc.py\npython3 /app/pybc/bc.py <<'EOF' | od -An -tx1c\n\"abc\"\nprint \"X\\n\"\ndefine f(x){return x+1}\nf(4)\n1+\\\n2\nif(0)quit\n999\nEOF\nprintf '%s\\n' '--- same block ---'\npython3 /app/pybc/bc.py <<'EOF'\n1\n2;quit\n3\nEOF\nprintf '%s\\n' '--- in function ---'\npython3 /app/pybc/bc.py <<'EOF'\n7\ndefine f() {\n  quit\n}\n9\nEOF\n"]
