[200.873259, "o", "\u001b[?2004hroot@faaedc7acf5c:/app# python3 /app/pybc/bc.py <<'EOF' | od -An -tx1c\r\n\u001b[?2004l\r\u001b[?2004h> \"abc\"\r\n\u001b[?2004l\r\u001b[?2004h> print \"X\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> define f(x){return x+1}\r\n\u001b[?2004l\r\u001b[?2004h> f(4)\r\n\u001b[?2004l\r\u001b[?2004h> 1+\\\r\n\u001b[?2004l\r\u001b[?2004h> 2\r\n\u001b[?2004l\r\u001b[?2004h> if(0)quit\r\n\u001b[?2004l\r\u001b[?2004h> 999\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
