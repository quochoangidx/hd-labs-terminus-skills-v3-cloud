[135.343943, "o", "            if lhs[0]=='idx':\r\n\u001b[?2004l\r\u001b[?2004h>                 i=self.idx(self.eval(lhs[2])); en=self.env.arrenv(lhs[1]); ar=en.arrays.setdefault(lhs[1],{})\r\n\u001b[?2004l\r\u001b[?2004h>                 old=ar.get(i,Num()).copy(); new=add(old,Num(1),e[1]=='--'); ar[i]=new.copy()\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 old=self.lget(lhs); new=add(old,Num(1),e[1]=='--'); self.lset(lhs,new)\r\n\u001b[?2004l\r\u001b[?2004h>             return new if k=='pre' else old\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> assert old in s\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
