Sending keys: ["cat > /tmp/solve.py <<'PY'\nimport json,math,random,time,sys,os\nfrom functools import lru_cache\nfrom tools.check_plan import evaluate\n\nname=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 20\nO=json.load(open('orders/'+name+'.json')); target=json.load(open('orders/targets.json'))[name]\nD=O['depot']; C={c['id']:c for c in O['customers']}; kinds={f['type']:f for f in O['fleet']}\nslots=[f['type'] for f in O['fleet'] for _ in range(f['count'])]\npts={0:D}|C\n@lru_cache(None)\ndef dist(a,b):\n p,q=pts[a],pts[b]; z=(p['x']-q['x'])**2+(p['y']-q['y'])**2; return math.isqrt(z)+(math.isqrt(z)**2<z)\n@lru_cache(None)\ndef info(typ,r):\n if not r:return (0,D['open'],0)\n k=kinds[typ]\n if sum(C[x]['demand'] for x in r)>k['capacity']: return None\n driven=dist(0,r[0])+sum(dist(a,b) for a,b in zip(r,r[1:]))+dist(r[-1],0)\n if k['range'] is not None and driven>k['range']: return None\n # Latest departure consistent with all due times and depot close.\n t=D['close']-dist(r[-1],0)*k['pace']\n for i in range(len(r)-1,-1,-1):\n  c=C[r[i]]; t=min(c['due'],t-c['service'])-dist(0 if i==0 else r[i-1],r[i])*k['pace']\n dep=t\n if dep<D['open']: return None\n clock=dep; prev=0\n for x in r:\n  c=C[x]; clock=max(clock+dist(prev,x)*k['pace'],c['ready'])\n  if clock>c['due']:return None\n  clock+=c['service'];prev=x\n back=clock+dist(prev,0)*k['pace']\n if back>D['close'] or back-dep>k['shift']:return None\n return (k['fixed']+k['per_unit']*driven,dep,driven)\ndef rc(i,r):\n z=info(slots[i],tuple(r)); return z[0] if z else None\n\ndef construct(rng):\n R=[[] for _ in slots]; left=set(C)\n # Regret insertion: prioritize constrained customers while selecting near-cheapest insertion.\n while left:\n  chosen=None\n  sample=list(left) if len(left)<45 else rng.sample(list(left),45)\n  for x in sample:\n   opts=[]\n   for i,r in enumerate(R):\n    old=rc(i,r) or 0\n    for p in range(len(r)+1):\n     nr=r[:p]+[x]+r[p:]; nc=rc(i,nr)\n     if nc is not None: opts.append((nc-old+rng.random()*40,i,p))\n   if not opts: continue\n   opts.sort(); regret=(opts[1][0]-opts[0][0] if len(opts)>1 else 100000)\n   # Tight windows/high demand receive a mild priority.\n   score=regret + 1000/(1+len(opts)) + C[x]['demand']*2\n   if chosen is None or score>chosen[0]: chosen=(score,x,opts)\n  if chosen is None:return None\n  _,x,opts=chosen\n  # Mostly best, occasionally second-best to diversify.\n  q=1 if len(opts)>1 and rng.random()<.07 else 0\n  _,i,p=opts[q];R[i].insert(p,x);left.remove(x)\n return R\n\ndef total(R):return sum(rc(i,r) or 10**9 for i,r in enumerate(R))\ndef planof(R):\n return {'routes':[{'type':slots[i],'depart':info(slots[i],tuple(r))[1],'stops':r} for i,r in enumerate(R) if r]}\n\nend=time.time()+limit; best=None;bestcost=10**18;seed=0\nwhile time.time()<end and bestcost>target:\n rng=random.Random(7919*seed+hash(name)%100000);seed+=1\n R=construct(rng)\n if R is None:continue\n cur=total(R)\n if cur<bestcost:\n  bestcost=cur;best=[r[:] for r in R];print(name,'construct',seed,cur,flush=True)\n # SA with feasible relocate/swap/2-opt moves.\n T=1200.0\n it=0\n while time.time()<end and it<180000 and bestcost>target:\n  it+=1\n  non=[i for i,r in enumerate(R) if r]\n  mode=rng.random()\n  changes=[]\n  if mode<.58:\n   a=rng.choice(non); pa=rng.randrange(len(R[a])); x=R[a][pa]\n   b=rng.randrange(len(R)); pb=rng.randrange(len(R[b])+1)\n   if a==b and (pb==pa or pb==pa+1):continue\n   na=R[a][:];na.pop(pa)\n   if a==b:\n    if pb>pa:pb-=1\n    na.insert(pb,x); nb=None\n   else:\n    nb=R[b][:];nb.insert(pb,x)\n   changes=[(a,na)] if a==b else [(a,na),(b,nb)]\n  elif mode<.83:\n   if len(non)<2:continue\n   a,b=rng.sample(non,2);pa=rng.randrange(len(R[a]));pb=rng.randrange(len(R[b]))\n   na=R[a][:];nb=R[b][:];na[pa],nb[pb]=nb[pb],na[pa];changes=[(a,na),(b,nb)]\n  else:\n   a=rng.choice(non)\n   if len(R[a])<3:continue\n   p,q=sorted(rng.sample(range(len(R[a])+1),2))\n   if q-p<2:continue\n   na=R[a][:p]+R[a][p:q][::-1]+R[a][q:];changes=[(a,na)]\n  if len({i for i,_ in changes})<len(changes):continue\n  old=sum(rc(i,R[i]) for i,_ in changes); newvals=[rc(i,nr) for i,nr in changes]\n  if any(v is None for v in newvals):continue\n  new=sum(newvals); delta=new-old\n  if delta<=0 or rng.random()<math.exp(-delta/max(T,1)):\n   for i,nr in changes:R[i]=nr\n   cur+=delta\n   if cur<bestcost:\n    bestcost=cur;best=[r[:] for r in R]\n    print(name,'best',bestcost,'iter',it,flush=True)\n  T*=.99994\n if best:\n  json.dump(planof(best),open('plans/'+name+'.json','w'),indent=1)\nprint('DONE',name,bestcost,'target',target,'seeds',seed)\nif best:\n p=planof(best); print('official',evaluate(O,p));json.dump(p,open('plans/'+name+'.json','w'),indent=1)\nPY\npython3 /tmp/solve.py harbour-lanes 25\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
