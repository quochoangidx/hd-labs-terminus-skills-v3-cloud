[140.709426, "i", "cat > /app/solve.py <<'PY'\nimport json, math, random, time, sys, os\n\ndef dist(a,b): return math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\n\ndef solve(fn,out,seconds=15,seed=1):\n d=json.load(open(fn)); dep=d['depot']; C={c['id']:c for c in d['customers']}; ids=list(C)\n kinds={x['type']:x for x in d['fleet']}\n # Minimum plausible fleet: all cheap bikes/vans, then enough trucks for residual demand.\n total=sum(c['demand'] for c in C.values())\n nb=kinds['bike']['count']; nv=kinds['van']['count']\n nt=max(0,math.ceil((total-nb*kinds['bike']['capacity']-nv*kinds['van']['capacity'])/kinds['truck']['capacity']))\n types=['bike']*nb+['van']*nv+['truck']*nt\n random.seed(seed)\n DD={(a,b):dist(dep if a==0 else C[a],dep if b==0 else C[b]) for a in [0]+ids for b in [0]+ids if a!=b}\n def rd(r):\n  s=r['s']; return DD[0,s[0]]+sum(DD[a,b] for a,b in zip(s,s[1:]))+DD[s[-1],0] if s else 0\n def feasible(t,s,retdep=False):\n  if not s:return (False,None)\n  k=kinds[t]\n  if sum(C[i]['demand'] for i in s)>k['capacity']:return (False,N"]
[140.711382, "o", "cat > /app/solve.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json, math, random, time, sys, os\r\n\u001b[?2004l\r"]
[140.711566, "i", "one)\n  distance=DD[0,s[0]]+sum(DD[a,b] for a,b in zip(s,s[1:]))+DD[s[-1],0]\n  if k['range'] is not None and distance>k['range']:return (False,None)\n  # Backward latest-service-start propagation.\n  latest=dep['close']-DD[s[-1],0]*k['pace']\n  starts={}\n  for p in range(len(s)-1,-1,-1):\n   i=s[p]; c=C[i]\n   st=min(c['due'],latest-c['service'])\n   if st<c['ready']:return (False,None)\n   starts[i]=st\n   latest=st-(DD[s[p-1],i] if p else DD[0,i])*k['pace']\n  departure=latest\n  if departure<dep['open']: departure=dep['open']\n  clock=departure; prev=0\n  for i in s:\n   c=C[i]; clock=max(clock+DD[prev,i]*k['pace'],c['ready'])\n   if clock>c['due']:return (False,None)\n   clock+=c['service']; prev=i\n  back=clock+DD[prev,0]*k['pace']\n  if back>dep['close'] or back-departure>k['shift']:return (False,None)\n  return (True,int(departure))\n def obj(rs): return sum(kinds[r['t']]['per_unit']*rd(r) for r in rs)\n def build():\n  rs=[{'t':t,'s':[]} for t in types]; left=set(ids)\n  # Put customers into routes by regret insertion. Nois"]
[140.711579, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def dist(a,b): return math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def solve(fn,out,seconds=15,seed=1):\r\n\u001b[?2004l\r\u001b[?2004h>  d=json.load(open(fn)); dep=d['depot']; C={c['id']:c for c in d['customers']}; ids=list(C)\r\n\u001b[?2004l\r\u001b[?2004h>  kinds={x['type']:x for x in d['fleet']}\r\n\u001b[?2004l\r\u001b[?2004h>  # Minimum plausible fleet: all cheap bikes/vans, then enough trucks for residual demand.\r\n\u001b[?2004l\r\u001b[?2004h>  total=sum(c['demand'] for c in C.values())\r\n\u001b[?2004l\r\u001b[?2004h>  nb=kinds['bike']['count']; nv=kinds['van']['count']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[140.711582, "i", "e diversifies allocations.\n  while left:\n   choice=None\n   scan=list(left); random.shuffle(scan)\n   for i in scan:\n    opts=[]\n    for q,r in enumerate(rs):\n     if C[i]['demand']>kinds[r['t']]['capacity']:continue\n     old=rd(r) if r['s'] else 0\n     for p in range(len(r['s'])+1):\n      ns=r['s'][:p]+[i]+r['s'][p:]\n      if feasible(r['t'],ns)[0]:\n       delta=kinds[r['t']]['per_unit']*(rd({'s':ns})-old)\n       opts.append((delta+random.random()*180,q,p,delta))\n    if opts:\n     opts.sort(); best=opts[0]\n     regret=(opts[min(2,len(opts)-1)][0]-best[0]) if len(opts)>1 else 100000\n     # Prioritize highly constrained and large-demand insertions.\n     key=regret + C[i]['demand']*12 + random.random()*20\n     if choice is None or key>choice[0]:choice=(key,i,best[1],best[2])\n   if choice is None:return None\n   _,i,q,p=choice; rs[q]['s'].insert(p,i); left.remove(i)\n  if any(not r['s'] for r in rs):return None\n  return rs\n deadline=time.time()+seconds; best=None; bestv=10**30; builds=0; moves=0\n while time.time()<d"]
