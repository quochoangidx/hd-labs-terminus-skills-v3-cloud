[21.133204, "o", "\r\n  },\r\n  {\r\n   \"id\": 160,\r\n   \"x\": 122,\r\n   \"y\": 48,\r\n   \"demand\": 18,\r\n   \"ready\": 27000,\r\n   \"due\": 29700,\r\n   \"service\": 690,\r\n   \"kind\": \"hotel\"\r\n  }\r\n ],\r\n \"fleet\": [\r\n  {\r\n   \"type\": \"bike\",\r\n   \"count\": 13,\r\n   \"capacity\": 14,\r\n   \"fixed\": 900,\r\n   \"per_unit\": 2,\r\n   \"pace\": 22,\r\n   \"shift\": 18000,\r\n   \"range\": 260\r\n  },\r\n  {\r\n   \"type\": \"van\",\r\n   \"count\": 20,\r\n   \"capacity\": 60,\r\n   \"fixed\": 4200,\r\n   \"per_unit\": 11,\r\n   \"pace\": 11,\r\n   \"shift\": 25200,\r\n   \"range\": null\r\n  },\r\n  {\r\n   \"type\": \"truck\",\r\n   \"count\": 8,\r\n   \"capacity\": 150,\r\n   \"fixed\": 9500,\r\n   \"per_unit\": 19,\r\n   \"pace\": 13,\r\n   \"shift\": 28800,\r\n   \"range\": null\r\n  }\r\n ]\r\n}\r\n--- orders/targets.json\r\n{\r\n \"harbour-lanes\": 77867,\r\n \"old-town\": 147362,\r\n \"riverside\": 201921,\r\n \"north-ring\": 288705\r\n}\r\n\u001b[?2004hroot@4515c13ae031:/app# "]
