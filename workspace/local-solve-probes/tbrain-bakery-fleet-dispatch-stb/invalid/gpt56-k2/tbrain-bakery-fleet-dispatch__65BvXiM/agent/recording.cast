[27.851011, "o", "     1\t# Morning dispatch rules\r\n     2\t\r\n     3\tThese rules decide whether a delivery plan can be run and what it costs. They\r\n     4\tare the rules `tools/check_plan.py` applies.\r\n     5\t\r\n     6\t## Orders\r\n     7\t\r\n     8\tEach file in `orders/` is one morning. It lists the bakery (`depot`), the\r\n     9\tcustomers to deliver to, and the vehicles available (`fleet`). Positions are\r\n    10\tinteger grid coordinates `x`, `y` in units of 100 m; times are seconds after\r\n    11\tmidnight. The bakery opens at `open` and closes at `close`.\r\n    12\t\r\n    13\tA customer has an integer `id`, a position, a `demand` in crates, a delivery\r\n    14\twindow `ready`..`due`, and a `service` time in seconds for unloading. Its\r\n    15\t`kind` (cafe, grocer, hotel, market) is for information only and changes no\r\n    16\trule.\r\n    17\t\r\n    18\tA fleet entry is one kind of vehicle, named by its `type`: `count` vehicles of it are available,\r\n    19\teach carrying up to `capacity` crates. It travels at `pace` seconds per unit of\r\n    20\tdist"]
[27.85111, "o", "ance, costs `fixed` for being used at all and `per_unit` for every unit of\r\n    21\tdistance it drives, may be out for at most `shift` seconds from leaving the\r\n    22\tbakery to getting back, and, where `range` is not null, may drive at most\r\n    23\t`range` units of distance in the morning. Costs are in cents.\r\n    24\t\r\n    25\t## Distance and time\r\n    26\t\r\n    27\tThe distance between two points is the Euclidean distance between them,\r\n    28\trounded up to a whole unit. A vehicle takes `distance * pace` seconds to drive\r\n    29\tit.\r\n    30\t\r\n    31\t## A route\r\n    32\t\r\n    33\tA route is one vehicle's morning: it leaves the bakery at its departure time,\r\n    34\tvisits its customers in order, and comes back. Every route visits at least one\r\n    35\tcustomer, and each vehicle runs at most one route.\r\n    36\t\r\n    37\t- The departure is a whole number of seconds, not before the bakery opens.\r\n    38\t- At each customer the vehicle unloads from the later of its arrival and the\r\n    39\t  customer's `ready` time, and th"]
[27.851119, "o", "at must not be after `due`. Unloading takes the\r\n    40\t  customer's `service` time; the vehicle leaves as soon as it is done.\r\n    41\t- The vehicle must be back at the bakery no later than it closes, and no more\r\n    42\t  than `shift` seconds after its departure.\r\n    43\t- The crates on the route (the sum of its customers' demands) must fit the\r\n    44\t  vehicle's `capacity`, and the distance driven must be within its `range`\r\n    45\t  where it has one. The distance driven is the sum of the rounded legs, from\r\n    46\t  the bakery through each customer in turn and back to the bakery.\r\n    47\t\r\n    48\t## A plan\r\n    49\t\r\n    50\tA plan delivers to every customer of the morning exactly once, uses no more\r\n    51\tvehicles of a kind than the fleet has, and costs the sum over its routes of the\r\n    52\tvehicle's `fixed` cost plus `per_unit` times the route's distance.\r\n    53\t\r\n    54\tIt is written as JSON:\r\n    55\t\r\n    56\t    {\"routes\": [{\"type\": \"van\", \"depart\": 18000, \"stops\": [12, 4, 31]}, ...]}\r\n    57\t\r\n    5"]
[27.851124, "o", "8\twhere `type` names a fleet entry, `depart` is the departure time as a JSON\r\n    59\tinteger (`18000`, not `18000.0`) and `stops` lists customer ids, as the\r\n    60\tintegers in the orders file, in visiting order. Other keys are ignored.\r\n\u001b[?2004hroot@4515c13ae031:/app# "]
[37.360044, "i", "echo '=== CHECKER ==='; nl -ba tools/check_plan.py; echo '=== PLANNER ==='; nl -ba planner/plan_morning.py\n"]
[37.36064, "o", "echo '=== CHECKER ==='; nl -ba tools/check_plan.py; echo '=== PLANNER ==='; nl -ba planner/plan_morning.py"]
[37.364689, "o", "\r\n\u001b[?2004l\r=== CHECKER ===\r\n     1\t\"\"\"Check a delivery plan against docs/dispatch-rules.md and print its cost.\r\n     2\t\r\n     3\tUsage: python3 tools/check_plan.py orders/<morning>.json plans/<morning>.json\r\n     4\t\"\"\"\r\n     5\t\r\n     6\timport json\r\n     7\timport math\r\n     8\timport sys\r\n     9\t\r\n    10\t\r\n    11\tclass PlanError(ValueError):\r\n    12\t    pass\r\n    13\t\r\n    14\t\r\n    15\tdef distance(a, b):\r\n    16\t    sq = (a[\"x\"] - b[\"x\"]) ** 2 + (a[\"y\"] - b[\"y\"]) ** 2\r\n    17\t    d = math.isqrt(sq)\r\n    18\t    return d if d * d == sq else d + 1\r\n    19\t\r\n    20\t\r\n    21\tdef evaluate(orders, plan):\r\n    22\t    depot = orders[\"depot\"]\r\n    23\t    customers = {c[\"id\"]: c for c in orders[\"customers\"]}\r\n    24\t    fleet = {f[\"type\"]: f for f in orders[\"fleet\"]}\r\n    25\t    used = {t: 0 for t in fleet}\r\n    26\t    served = set()\r\n    27\t    total = 0\r\n    28\t    if not isinstance(plan, dict) or not isinstance(plan.get(\"routes\"), list):\r\n    29\t        raise PlanError(\"a plan is a JSON object with a routes list\")\r\n    3"]
[37.36471, "o", "0\t    for number, route in enumerate(plan[\"routes\"], start=1):\r\n    31\t        where = f\"route {number}\"\r\n    32\t        if not isinstance(route, dict):\r\n    33\t            raise PlanError(f\"{where}: not a JSON object\")\r\n    34\t        kind = fleet.get(route.get(\"type\")) if isinstance(route.get(\"type\"), str) else None\r\n    35\t        if kind is None:\r\n    36\t            raise PlanError(f\"{where}: unknown vehicle type {route.get('type')!r}\")\r\n    37\t        stops = route.get(\"stops\")\r\n    38\t        if not isinstance(stops, list) or not stops:\r\n    39\t            raise PlanError(f\"{where}: no stops\")\r\n    40\t        depart = route.get(\"depart\")\r\n    41\t        if not isinstance(depart, int) or isinstance(depart, bool) or depart < depot[\"open\"]:\r\n    42\t            raise PlanError(f\"{where}: departure must be a whole second, not before opening\")\r\n    43\t        used[route[\"type\"]] += 1\r\n    44\t        clock, here, crates, driven = depart, depot, 0, 0\r\n    45\t        for cid in stops:\r\n    46\t            if not "]
[37.364713, "o", "isinstance(cid, int) or isinstance(cid, bool) or cid not in customers:\r\n    47\t                raise PlanError(f\"{where}: unknown customer {cid!r}\")\r\n    48\t            if cid in served:\r\n    49\t                raise PlanError(f\"{where}: customer {cid} delivered twice\")\r\n    50\t            served.add(cid)\r\n    51\t            customer = customers[cid]\r\n    52\t            leg = distance(here, customer)\r\n    53\t            driven += leg\r\n    54\t            start = max(clock + leg * kind[\"pace\"], customer[\"ready\"])\r\n    55\t            if start > customer[\"due\"]:\r\n    56\t                raise PlanError(f\"{where}: customer {cid} reached at {start}, after its window closes at {customer['due']}\")\r\n    57\t            clock = start + customer[\"service\"]\r\n    58\t            crates += customer[\"demand\"]\r\n    59\t            here = customer\r\n    60\t        leg = distance(here, depot)\r\n    61\t        driven += leg\r\n    62\t        back = clock + leg * kind[\"pace\"]\r\n    63\t        if back > depot[\"close\"]:\r\n    64\t           "]
[37.364717, "o", " raise PlanError(f\"{where}: back at {back}, after the bakery closes\")\r\n    65\t        if back - depart > kind[\"shift\"]:\r\n    66\t            raise PlanError(f\"{where}: out for {back - depart} s, longer than the {kind['shift']} s shift\")\r\n    67\t        if crates > kind[\"capacity\"]:\r\n    68\t            raise PlanError(f\"{where}: {crates} crates on a vehicle that carries {kind['capacity']}\")\r\n    69\t        if kind[\"range\"] is not None and driven > kind[\"range\"]:\r\n    70\t            raise PlanError(f\"{where}: drives {driven} units, beyond its range of {kind['range']}\")\r\n    71\t        total += kind[\"fixed\"] + kind[\"per_unit\"] * driven\r\n    72\t    for name, count in used.items():\r\n    73\t        if count > fleet[name][\"count\"]:\r\n    74\t            raise PlanError(f\"{count} routes use a {name}; only {fleet[name]['count']} are available\")\r\n    75\t    missing = sorted(set(customers) - served)\r\n    76\t    if missing:\r\n    77\t        raise PlanError(f\"{len(missing)} customers get no delivery, first {missing[:5]}\")\r\n "]
[37.365935, "o", "   78\t    return total\r\n    79\t\r\n    80\t\r\n    81\tdef main(argv):\r\n    82\t    if len(argv) != 3:\r\n    83\t        sys.exit(__doc__)\r\n    84\t    with open(argv[1]) as fh:\r\n    85\t        orders = json.load(fh)\r\n    86\t    with open(argv[2]) as fh:\r\n    87\t        plan = json.load(fh)\r\n    88\t    try:\r\n    89\t        cost = evaluate(orders, plan)\r\n    90\t    except PlanError as exc:\r\n    91\t        print(f\"INFEASIBLE: {exc}\")\r\n    92\t        return 1\r\n    93\t    print(f\"feasible, cost {cost}\")\r\n    94\t    return 0\r\n    95\t\r\n    96\t\r\n    97\tif __name__ == \"__main__\":\r\n    98\t    sys.exit(main(sys.argv))\r\n=== PLANNER ===\r\n     1\t\"\"\"Current dispatch planner: nearest-next greedy, vans first.\r\n     2\t\r\n     3\tUsage: python3 planner/plan_morning.py orders/<morning>.json plans/<morning>.json\r\n     4\t\r\n     5\tBuilds one route at a time. A route leaves when the bakery opens and keeps\r\n     6\tdriving to the nearest customer it can still reach inside that customer's window\r\n     7\twith room on board; when nothing fits, it g"]
[37.366031, "o", "oes home and the next vehicle starts.\r\n     8\t\"\"\"\r\n     9\t\r\n    10\timport json\r\n    11\timport os\r\n    12\timport sys\r\n    13\t\r\n    14\tsys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"tools\"))\r\n    15\tfrom check_plan import distance, evaluate  # noqa: E402\r\n    16\t\r\n    17\tORDER = (\"van\", \"truck\", \"bike\")\r\n    18\t\r\n    19\t\r\n    20\tdef plan(orders):\r\n    21\t    depot = orders[\"depot\"]\r\n    22\t    left = {c[\"id\"]: c for c in orders[\"customers\"]}\r\n    23\t    fleet = sorted(orders[\"fleet\"], key=lambda f: ORDER.index(f[\"type\"]) if f[\"type\"] in ORDER else 99)\r\n    24\t    routes = []\r\n    25\t    for kind in fleet:\r\n    26\t        for _ in range(kind[\"count\"]):\r\n    27\t            if not left:\r\n    28\t                break\r\n    29\t            clock, here, crates, driven, stops = depot[\"open\"], depot, 0, 0, []\r\n    30\t            while True:\r\n    31\t                best = None\r\n    32\t                for c in left.values():\r\n    33\t                    leg = distance(here, c)\r\n    34\t   "]
[37.366047, "o", "                 start = max(clock + leg * kind[\"pace\"], c[\"ready\"])\r\n    35\t                    if start > c[\"due\"] or crates + c[\"demand\"] > kind[\"capacity\"]:\r\n    36\t                        continue\r\n    37\t                    back = start + c[\"service\"] + distance(c, depot) * kind[\"pace\"]\r\n    38\t                    if back > depot[\"close\"] or back - depot[\"open\"] > kind[\"shift\"]:\r\n    39\t                        continue\r\n    40\t                    total = driven + leg + distance(c, depot)\r\n    41\t                    if kind[\"range\"] is not None and total > kind[\"range\"]:\r\n    42\t                        continue\r\n    43\t                    if best is None or leg < best[0]:\r\n    44\t                        best = (leg, c, start)\r\n    45\t                if best is None:\r\n    46\t                    break\r\n    47\t                leg, c, start = best\r\n    48\t                stops.append(c[\"id\"])\r\n    49\t                clock, here, crates, driven = start + c[\"service\"], c, crates + c[\"demand\"], driven + leg\r\n  "]
