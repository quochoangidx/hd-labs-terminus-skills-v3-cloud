[38.100532, "i", "python3 - <<'PY'\nimport json,glob,os,collections\nfor fn in glob.glob('orders/*.json'):\n if fn.endswith('targets.json'): continue\n d=json.load(open(fn)); cs=d['customers']\n print('\\n',os.path.basename(fn), 'depot=',d['depot'], 'customers=',len(cs))\n print('demand total/min/max=',sum(c['demand'] for c in cs),min(c['demand'] for c in cs),max(c['demand'] for c in cs))\n print('ready range=',min(c['ready'] for c in cs),max(c['ready'] for c in cs),'due range=',min(c['due'] for c in cs),max(c['due'] for c in cs))\n print('kinds=',collections.Counter(c['kind'] for c in cs))\n print('fleet:')\n for v in d['fleet']: print(' ',v)\n print('first customers:',cs[:3])\nPY\n"]
