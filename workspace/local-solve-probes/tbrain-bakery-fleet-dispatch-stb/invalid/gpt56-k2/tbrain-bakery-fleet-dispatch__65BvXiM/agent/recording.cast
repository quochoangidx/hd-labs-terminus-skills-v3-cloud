[140.711656, "i", "eadline:\n  rs=build(); builds+=1\n  if rs is None:continue\n  cur=obj(rs)\n  if cur<bestv: bestv=cur; best=[{'t':r['t'],'s':r['s'][:]} for r in rs]\n  # SA local search for this construction.\n  temp=700.0\n  for it in range(18000):\n   if time.time()>=deadline:break\n   mode=random.random(); q=random.randrange(len(rs)); r=rs[q]\n   changed=[]\n   if mode<.48 and len(r['s'])>1:\n    p=random.randrange(len(r['s'])); i=r['s'][p]; z=random.randrange(len(rs)); rr=rs[z]\n    pp=random.randrange(len(rr['s'])+1)\n    if z==q:\n     ns=r['s'][:]; ns.pop(p); pp=min(pp,len(ns)); ns.insert(pp,i)\n     if ns==r['s'] or not feasible(r['t'],ns)[0]:continue\n     changed=[(q,ns)]\n    else:\n     ns=r['s'][:p]+r['s'][p+1:]; ns2=rr['s'][:pp]+[i]+rr['s'][pp:]\n     if not ns or not feasible(r['t'],ns)[0] or not feasible(rr['t'],ns2)[0]:continue\n     changed=[(q,ns),(z,ns2)]\n   elif mode<.78:\n    z=random.randrange(len(rs)); rr=rs[z]\n    if z==q or not r['s'] or not rr['s']:continue\n    p=random.randrange(len(r['s'])); pp=random.randrange(len(rr"]
