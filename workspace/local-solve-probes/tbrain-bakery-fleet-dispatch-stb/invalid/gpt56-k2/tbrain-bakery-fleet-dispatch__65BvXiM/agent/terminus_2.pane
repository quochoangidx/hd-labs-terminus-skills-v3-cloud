[?2004l[?2004h> for fn in glob.glob('orders/*.json'):
[?2004l[?2004h>  if fn.endswith('targets.json'): continue
[?2004l[?2004h>  d=json.load(open(fn)); cs=d['customers']
[?2004l[?2004h>  print('\n',os.path.basename(fn), 'depot=',d['depot'], 'customers=',len(cs))
[?2004l[?2004h>  print('demand total/min/max=',sum(c['demand'] for c in cs),min(c['demand'] for c in cs),max(c['demand'] for c in cs))
