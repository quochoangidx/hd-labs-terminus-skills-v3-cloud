[?2004hroot@2b652d5e3a23:/app# cat > /tmp/solve.py <<'PY'
[?2004l[?2004h> import json,math,random,time,sys,os
[?2004l[?2004h> from functools import lru_cache
[?2004l[?2004h> from tools.check_plan import evaluate
[?2004l[?2004h> 
[?2004l[?2004h> name=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 20
[?2004l[?2004h> O=json.load(open('orders/'+name+'.json')); target=json.load(open('orders/targets.json'))[name]
[?2004l[?2004h> D=O['depot']; C={c['id']:c for c in O['customers']}; kinds={f['type']:f for f in O['fleet']}
[?2004l[?2004h> slots=[f['type'] for f in O['fleet'] for _ in range(f['count'])]
[?2004l[?2004h> pts={0:D}|C
[?2004l[?2004h> @lru_cache(None)
[?2004l[?2004h> def dist(a,b):
[?2004l[?2004h>  p,q=pts[a],pts[b]; z=(p['x']-q['x'])**2+(p['y']-q['y'])**2; return math.isqrt(z)+(math.isqrt(z)**2<z)
[?2004l[?2004h> @lru_cache(None)
[?2004l[?2004h> def info(typ,r):
[?2004l[?2004h>  if not r:return (0,D['open'],0)
[?2004l[?2004h>  k=kinds[typ]
[?2004l[?2004h>  if sum(C[x]['demand'] for x in r)>k['capacity']: return None
[?2004l[?2004h>  driven=dist(0,r[0])+sum(dist(a,b) for a,b in zip(r,r[1:]))+dist(r[-1],0)
[?2004l[?2004h>  if k['range'] is not None and driven>k['range']: return None
[?2004l[?2004h>  # Latest departure consistent with all due times and depot close.
[?2004l[?2004h>  t=D['close']-dist(r[-1],0)*k['pace']
[?2004l[?2004h>  for i in range(len(r)-1,-1,-1):
[?2004l[?2004h>   c=C[r[i]]; t=min(c['due'],t-c['service'])-dist(0 if i==0 else r[i-1],r[i])*k['pace']
[?2004l[?2004h>  dep=t
[?2004l[?2004h>  if dep<D['open']: return None
[?2004l[?2004h>  clock=dep; prev=0
[?2004l[?2004h>  for x in r:
[?2004l[?2004h>   c=C[x]; clock=max(clock+dist(prev,x)*k['pace'],c['ready'])
[?2004l[?2004h>   if clock>c['due']:return None
[?2004l[?2004h>   clock+=c['service'];prev=x
[?2004l[?2004h>  back=clock+dist(prev,0)*k['pace']
[?2004l[?2004h>  if back>D['close'] or back-dep>k['shift']:return None
[?2004l[?2004h>  return (k['fixed']+k['per_unit']*driven,dep,driven)
[?2004l[?2004h> def rc(i,r):
[?2004l[?2004h>  z=info(slots[i],tuple(r)); return z[0] if z else None
[?2004l[?2004h> 
[?2004l[?2004h> def construct(rng):
[?2004l[?2004h>  R=[[] for _ in slots]; left=set(C)
[?2004l[?2004h>  # Regret insertion: prioritize constrained customers while selecting near-cheapest insertion.
[?2004l[?2004h>  while left:
[?2004l[?2004h>   chosen=None
[?2004l[?2004h>   sample=list(left) if len(left)<45 else rng.sample(list(left),45)
[?2004l[?2004h>   for x in sample:
[?2004l[?2004h>    opts=[]
[?2004l[?2004h>    for i,r in enumerate(R):
[?2004l[?2004h>     old=rc(i,r) or 0
[?2004l[?2004h>     for p in range(len(r)+1):
[?2004l[?2004h>      nr=r[:p]+[x]+r[p:]; nc=rc(i,nr)
[?2004l[?2004h>      if nc is not None: opts.append((nc-old+rng.random()*40,i,p))
[?2004l[?2004h>    if not opts: continue
[?2004l[?2004h>    opts.sort(); regret=(opts[1][0]-opts[0][0] if len(opts)>1 else 100000)
[?2004l[?2004h>    # Tight windows/high demand receive a mild priority.
[?2004l[?2004h>    score=regret + 1000/(1+len(opts)) + C[x]['demand']*2
[?2004l[?2004h>    if chosen is None or score>chosen[0]: chosen=(score,x,opts)
[?2004l[?2004h>   if chosen is None:return None
[?2004l[?2004h>   _,x,opts=chosen
[?2004l[?2004h>   # Mostly best, occasionally second-best to diversify.
[?2004l[?2004h>   q=1 if len(opts)>1 and rng.random()<.07 else 0
[?2004l[?2004h>   _,i,p=opts[q];R[i].insert(p,x);left.remove(x)
[?2004l[?2004h>  return R
[?2004l[?2004h> 
[?2004l[?2004h> def total(R):return sum(rc(i,r) or 10**9 for i,r in enumerate(R))
[?2004l[?2004h> def planof(R):
[?2004l[?2004h>  return {'routes':[{'type':slots[i],'depart':info(slots[i],tuple(r))[1],'stops':r} for i,r in enumerate(R) if r]}
[?2004l[?2004h> 
[?2004l[?2004h> end=time.time()+limit; best=None;bestcost=10**18;seed=0
[?2004l[?2004h> while time.time()<end and bestcost>target:
[?2004l[?2004h>  rng=random.Random(7919*seed+hash(name)%100000);seed+=1
[?2004l[?2004h>  R=construct(rng)
[?2004l[?2004h>  if R is None:continue
[?2004l[?2004h>  cur=total(R)
[?2004l[?2004h>  if cur<bestcost:
[?2004l[?2004h>   bestcost=cur;best=[r[:] for r in R];print(name,'construct',seed,cur,flush=True)
[?2004l[?2004h>  # SA with feasible relocate/swap/2-opt moves.
[?2004l[?2004h>  T=1200.0
[?2004l[?2004h>  it=0
[?2004l[?2004h>  while time.time()<end and it<180000 and bestcost>target:
[?2004l[?2004h>   it+=1
[?2004l[?2004h>   non=[i for i,r in enumerate(R) if r]
[?2004l[?2004h>   mode=rng.random()
[?2004l[?2004h>   changes=[]
[?2004l[?2004h>   if mode<.58:
[?2004l[?2004h>    a=rng.choice(non); pa=rng.randrange(len(R[a])); x=R[a][pa]
[?2004l[?2004h>    b=rng.randrange(len(R)); pb=rng.randrange(len(R[b])+1)
[?2004l[?2004h>    if a==b and (pb==pa or pb==pa+1):continue
[?2004l[?2004h>    na=R[a][:];na.pop(pa)
[?2004l[?2004h>    if a==b:
[?2004l[?2004h>     if pb>pa:pb-=1
[?2004l[?2004h>     na.insert(pb,x); nb=None
[?2004l[?2004h>    else:
[?2004l[?2004h>     nb=R[b][:];nb.insert(pb,x)
[?2004l[?2004h>    changes=[(a,na)] if a==b else [(a,na),(b,nb)]
[?2004l[?2004h>   elif mode<.83:
[?2004l[?2004h>    if len(non)<2:continue
[?2004l[?2004h>    a,b=rng.sample(non,2);pa=rng.randrange(len(R[a]));pb=rng.randrange(len(R[b]))
[?2004l[?2004h>    na=R[a][:];nb=R[b][:];na[pa],nb[pb]=nb[pb],na[pa];changes=[(a,na),(b,nb)]
[?2004l[?2004h>   else:
[?2004l[?2004h>    a=rng.choice(non)
[?2004l[?2004h>    if len(R[a])<3:continue
[?2004l[?2004h>    p,q=sorted(rng.sample(range(len(R[a])+1),2))
[?2004l[?2004h>    if q-p<2:continue
[?2004l[?2004h>    na=R[a][:p]+R[a][p:q][::-1]+R[a][q:];changes=[(a,na)]
[?2004l[?2004h>   if len({i for i,_ in changes})<len(changes):continue
[?2004l[?2004h>   old=sum(rc(i,R[i]) for i,_ in changes); newvals=[rc(i,nr) for i,nr in changes]
[?2004l[?2004h>   if any(v is None for v in newvals):continue
[?2004l[?2004h>   new=sum(newvals); delta=new-old
[?2004l[?2004h>   if delta<=0 or rng.random()<math.exp(-delta/max(T,1)):
[?2004l[?2004h>    for i,nr in changes:R[i]=nr
[?2004l[?2004h>    cur+=delta
[?2004l[?2004h>    if cur<bestcost:
[?2004l[?2004h>     bestcost=cur;best=[r[:] for r in R]
[?2004l[?2004h>     print(name,'best',bestcost,'iter',it,flush=True)
[?2004l[?2004h>   T*=.99994
[?2004l[?2004h>  if best:
[?2004l[?2004h>   json.dump(planof(best),open('plans/'+name+'.json','w'),indent=1)
[?2004l[?2004h> print('DONE',name,bestcost,'target',target,'seeds',seed)
[?2004l[?2004h> if best:
[?2004l[?2004h>  p=planof(best); print('official',evaluate(O,p));json.dump(p,open('plans/'+name+'.json','w'),indent=1)
