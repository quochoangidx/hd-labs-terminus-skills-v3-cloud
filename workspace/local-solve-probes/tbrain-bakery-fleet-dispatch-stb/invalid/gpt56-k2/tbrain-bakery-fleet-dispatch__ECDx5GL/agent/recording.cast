[99.335747, "i", "cat > /tmp/solve.py <<'PY'\nimport json,math,random,time,sys,os\nfrom functools import lru_cache\nfrom tools.check_plan import evaluate\n\nname=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 20\nO=json.load(open('orders/'+name+'.json')); target=json.load(open('orders/targets.json'))[name]\nD=O['depot']; C={c['id']:c for c in O['customers']}; kinds={f['type']:f for f in O['fleet']}\nslots=[f['type'] for f in O['fleet'] for _ in range(f['count'])]\npts={0:D}|C\n@lru_cache(None)\ndef dist(a,b):\n p,q=pts[a],pts[b]; z=(p['x']-q['x'])**2+(p['y']-q['y'])**2; return math.isqrt(z)+(math.isqrt(z)**2<z)\n@lru_cache(None)\ndef info(typ,r):\n if not r:return (0,D['open'],0)\n k=kinds[typ]\n if sum(C[x]['demand'] for x in r)>k['capacity']: return None\n driven=dist(0,r[0])+sum(dist(a,b) for a,b in zip(r,r[1:]))+dist(r[-1],0)\n if k['range'] is not None and driven>k['range']: return None\n # Latest departure consistent with all due times and depot close.\n t=D['close']-dist(r[-1],0)*k['pace']\n for i in range(len(r)-1,-1,-1):\n  c"]
[99.34644, "o", "cat > /tmp/solve.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json,math,random,time,sys,os\r\n\u001b[?2004l\r\u001b[?2004h> from functools import lru_cache\r\n\u001b[?2004l\r\u001b[?2004h> from tools.check_plan import evaluate\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> name=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 20\r\n\u001b[?2004l\r\u001b[?2004h> O=json.load(open('orders/'+name+'.json')); target=json.load(open('orders/targets.json'))[name]\r\n\u001b[?2004l\r\u001b[?2004h> D=O['depot']; C={c['id']:c for c in O['customers']}; kinds={f['type']:f for f in O['fleet']}\r\n\u001b[?2004l\r\u001b[?2004h> slots=[f['type'] for f in O['fleet'] for _ in range(f['count'])]\r\n\u001b[?2004l\r\u001b[?2004h> pts={0:D}|C\r\n\u001b[?2004l\r\u001b[?2004h> @lru_cache(None)\r\n\u001b[?2004l\r\u001b[?2004h> def dist(a,b):\r\n\u001b[?2004l\r\u001b[?2004h>  p,q=pts[a],pts[b]; z=(p['x']-q['x'])**2+(p['y']-q['y'])**2; return math.isqrt(z)+(math.isqrt(z)**2<z)\r\n\u001b[?2004l\r\u001b[?2004h> @lru_cache(None)\r\n\u001b[?2004l\r\u001b[?2004h> def info(typ,r):\r\n\u001b[?2004l\r\u001b[?2004h>  if not r:return (0,D['open'],0)\r\n\u001b[?2004l\r\u001b[?2004h>  k=kinds[typ]\r\n\u001b[?2004l\r\u001b[?2004h>"]
