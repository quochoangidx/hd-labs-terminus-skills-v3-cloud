[?2004hroot@78e005634995:/app# nl -ba /app/tools/check_plan.py | sed -n '1,240p'
[?2004l     1	"""Check a delivery plan against docs/dispatch-rules.md and print its cost.
     2	
     3	Usage: python3 tools/check_plan.py orders/<morning>.json plans/<morning>.json
     4	"""
     5	
     6	import json
     7	import math
     8	import sys
     9	
    10	
    11	class PlanError(ValueError):
    12	    pass
    13	
    14	
    15	def distance(a, b):
    16	    sq = (a["x"] - b["x"]) ** 2 + (a["y"] - b["y"]) ** 2
    17	    d = math.isqrt(sq)
    18	    return d if d * d == sq else d + 1
    19	
    20	
    21	def evaluate(orders, plan):
    22	    depot = orders["depot"]
    23	    customers = {c["id"]: c for c in orders["customers"]}
    24	    fleet = {f["type"]: f for f in orders["fleet"]}
    25	    used = {t: 0 for t in fleet}
    26	    served = set()
    27	    total = 0
    28	    if not isinstance(plan, dict) or not isinstance(plan.get("routes"), list):
    29	        raise PlanError("a plan is a JSON object with a routes list")
    30	    for number, route in enumerate(plan["routes"], start=1):
    31	        where = f"route {number}"
    32	        if not isinstance(route, dict):
    33	            raise PlanError(f"{where}: not a JSON object")
    34	        kind = fleet.get(route.get("type")) if isinstance(route.get("type"), str) else None
    35	        if kind is None:
    36	            raise PlanError(f"{where}: unknown vehicle type {route.get('type')!r}")
    37	        stops = route.get("stops")
    38	        if not isinstance(stops, list) or not stops:
    39	            raise PlanError(f"{where}: no stops")
    40	        depart = route.get("depart")
    41	        if not isinstance(depart, int) or isinstance(depart, bool) or depart < depot["open"]:
    42	            raise PlanError(f"{where}: departure must be a whole second, not before opening")
    43	        used[route["type"]] += 1
    44	        clock, here, crates, driven = depart, depot, 0, 0
    45	        for cid in stops:
    46	            if not isinstance(cid, int) or isinstance(cid, bool) or cid not in customers:
    47	                raise PlanError(f"{where}: unknown customer {cid!r}")
    48	            if cid in served:
    49	                raise PlanError(f"{where}: customer {cid} delivered twice")
    50	            served.add(cid)
    51	            customer = customers[cid]
    52	            leg = distance(here, customer)
    53	            driven += leg
    54	            start = max(clock + leg * kind["pace"], customer["ready"])
    55	            if start > customer["due"]:
    56	                raise PlanError(f"{where}: customer {cid} reached at {start}, after its window closes at {customer['due']}")
    57	            clock = start + customer["service"]
    58	            crates += customer["demand"]
    59	            here = customer
    60	        leg = distance(here, depot)
    61	        driven += leg
    62	        back = clock + leg * kind["pace"]
    63	        if back > depot["close"]:
    64	            raise PlanError(f"{where}: back at {back}, after the bakery closes")
    65	        if back - depart > kind["shift"]:
    66	            raise PlanError(f"{where}: out for {back - depart} s, longer than the {kind['shift']} s shift")
    67	        if crates > kind["capacity"]:
    68	            raise PlanError(f"{where}: {crates} crates on a vehicle that carries {kind['capacity']}")
    69	        if kind["range"] is not None and driven > kind["range"]:
    70	            raise PlanError(f"{where}: drives {driven} units, beyond its range of {kind['range']}")
    71	        total += kind["fixed"] + kind["per_unit"] * driven
    72	    for name, count in used.items():
    73	        if count > fleet[name]["count"]:
    74	            raise PlanError(f"{count} routes use a {name}; only {fleet[name]['count']} are available")
    75	    missing = sorted(set(customers) - served)
    76	    if missing:
    77	        raise PlanError(f"{len(missing)} customers get no delivery, first {missing[:5]}")
    78	    return total
    79	
    80	
    81	def main(argv):
    82	    if len(argv) != 3:
    83	        sys.exit(__doc__)
    84	    with open(argv[1]) as fh:
    85	        orders = json.load(fh)
    86	    with open(argv[2]) as fh:
    87	        plan = json.load(fh)
    88	    try:
    89	        cost = evaluate(orders, plan)
    90	    except PlanError as exc:
    91	        print(f"INFEASIBLE: {exc}")
    92	        return 1
    93	    print(f"feasible, cost {cost}")
    94	    return 0
    95	
    96	
    97	if __name__ == "__main__":
    98	    sys.exit(main(sys.argv))
