[?2004l[?2004h> import json
[?2004l[?2004h> for n in ['harbour-lanes','old-town','riverside','north-ring']:
[?2004l[?2004h>  x=json.load(open('orders/'+n+'.json'))
[?2004l[?2004h>  print(n,'N',len(x['customers']),'D',sum(c['demand'] for c in x['customers']),'DEPOT',x['depot'])
[?2004l[?2004h>  for f in x['fleet']: print(' ',f['type'],'count',f['count'],'cap',f['capacity'],'pace',f['pace'],'fixed',f['fixed'],'unit',f['per_unit'],'shift',f['shift'],'range',f['range'])
[?2004l[?2004h> PY
