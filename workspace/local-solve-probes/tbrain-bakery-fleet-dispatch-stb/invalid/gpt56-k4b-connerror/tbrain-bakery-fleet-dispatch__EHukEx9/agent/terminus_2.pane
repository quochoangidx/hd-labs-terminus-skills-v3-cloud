[?2004hroot@78e005634995:/app# cat > /tmp/relax.py <<'PY'
[?2004l[?2004h> import sys,json,random,time,math,os
[?2004l[?2004h> name=sys.argv[1];secs=float(sys.argv[2])
[?2004l[?2004h> src=open('/tmp/solve.py').read().split('start=time.time();')[0]
[?2004l[?2004h> # Permit capacity overload internally; all other route constraints remain hard.
[?2004l[?2004h> src=src.replace("if load>f['capacity']: return None", "# overload temporarily permitted")
