[2327.017091, "i", "python3 - <<'PY'\nimport json,math,random,collections\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('orders/'+n+'.json')); cs=sorted(o['customers'],key=lambda c:c['id']); d=lambda a,b:math.hypot(a['x']-b['x'],a['y']-b['y'])\n adj=[d(a,b) for a,b in zip(cs,cs[1:])]; rr=random.Random(1);ran=[d(*rr.sample(cs,2)) for _ in range(5000)]\n print(n,'adj mean',round(sum(adj)/len(adj),1),'random',round(sum(ran)/len(ran),1),'same-ready-adj',sum(a['ready']==b['ready'] for a,b in zip(cs,cs[1:])),'/',len(adj))\n print(' first20:',[(c['id'],c['x'],c['y'],c['demand'],c['ready']) for c in cs[:20]])\nPY\n"]
[2327.017645, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
