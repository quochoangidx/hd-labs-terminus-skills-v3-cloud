[2327.266486, "i", "python3 - <<'PY'\nimport json,math,collections\nT=json.load(open('orders/targets.json'))\nfor n in T:\n o=json.load(open('orders/'+n+'.json'));p=json.load(open('plans/'+n+'.json'));C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};D=o['depot'];di=lambda a,b:math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\n fx=tr=0;ct=collections.Counter()\n for r in p['routes']:\n  f=F[r['type']];ct[r['type']]+=1;pts=[D]+[C[i] for i in r['stops']]+[D];dd=sum(di(a,b) for a,b in zip(pts,pts[1:]));fx+=f['fixed'];tr+=f['per_unit']*dd\n print(n,ct,'fixed',fx,'travel',tr,'target travel if same fleet',T[n]-fx)\nPY\n"]
[2327.267978, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json,math,collections\r\n\u001b[?2004l\r\u001b[?2004h> T=json.load(open('orders/targets.json'))\r\n\u001b[?2004l\r\u001b[?2004h> for n in T:\r\n\u001b[?2004l\r\u001b[?2004h>  o=json.load(open('orders/'+n+'.json'));p=json.load(open('plans/'+n+'.json'));C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};D=o['depot'];di=lambda a,b:math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\r\n\u001b[?2004l\r\u001b[?2004h>  fx=tr=0;ct=collections.Counter()\r\n\u001b[?2004l\r\u001b[?2004h>  for r in p['routes']:\r\n\u001b[?2004l\r\u001b[?2004h>   f=F[r['type']];ct[r['type']]+=1;pts=[D]+[C[i] for i in r['stops']]+[D];dd=sum(di(a,b) for a,b in zip(pts,pts[1:]));fx+=f['fixed'];tr+=f['per_unit']*dd\r\n\u001b[?2004l\r\u001b[?2004h>  print(n,ct,'fixed',fx,'travel',tr,'target travel if same fleet',T[n]-fx)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
