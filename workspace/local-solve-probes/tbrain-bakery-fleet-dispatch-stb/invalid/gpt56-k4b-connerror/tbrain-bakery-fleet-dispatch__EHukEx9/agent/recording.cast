[2673.163491, "i", "cat > /tmp/relax.py <<'PY'\nimport sys,json,random,time,math,os\nname=sys.argv[1];secs=float(sys.argv[2])\nsrc=open('/tmp/solve.py').read().split('start=time.time();')[0]\n# Permit capacity overload internally; all other route constraints remain hard.\nsrc=src.replace(\"if load>f['capacity']: return None\", \"# overload temporarily permitted\")\nexec(src,globals())\np=os.environ.get('OUT','/app/plans/'+name+'.json');d=json.load(open(p));cur=[(r['type'],r['stops'][:]) for r in d['routes']]\ndef load(t,s):return sum(C[i]['demand'] for i in s)\ndef over(t,s):return max(0,load(t,s)-F[t]['capacity'])\ndef rc(t,s):\n e=ev(t,tuple(s));return e[0] if e else None\ndef raw(z):return sum(rc(t,s) for t,s in z)\ndef ov(z):return sum(over(t,s) for t,s in z)\nbest=[(t,s[:]) for t,s in cur];bestc=raw(best);curc=bestc;curo=ov(cur)\nR=random.Random(time.time_ns());start=time.time();it=acc=0\nwhile time.time()-start<secs and bestc>target:\n it+=1;frac=(time.time()-start)/secs\n # Low penalty first to cross packing barriers; strong penalty near end r"]
[2673.163524, "i", "eturns to feasibility.\n pen=40+1960*frac**3;temp=max(8,500*(1-frac))\n a=R.randrange(len(cur));b=R.randrange(len(cur));ta,A=cur[a];tb,B=cur[b]\n if not A or not B:continue\n oa=rc(ta,A);ob=rc(tb,B);olda=over(ta,A);oldb=over(tb,B);u=R.random()\n if a==b:\n  if len(A)<2:continue\n  i,j=sorted(R.sample(range(len(A)+1),2))\n  if j-i<2:continue\n  AA=A[:i]+A[i:j][::-1]+A[j:];na=rc(ta,AA)\n  if na is None:continue\n  delta=na-oa;do=0;BB=B\n else:\n  if u<.40:\n   if len(A)<=1:continue\n   i=R.randrange(len(A));j=R.randrange(len(B)+1);x=A[i];AA=A[:i]+A[i+1:];BB=B[:j]+[x]+B[j:]\n  elif u<.78:\n   i=R.randrange(len(A));j=R.randrange(len(B));AA=A[:];BB=B[:];AA[i],BB[j]=BB[j],AA[i]\n  else:\n   L=2 if R.random()<.8 else 3\n   if len(A)<=L:continue\n   i=R.randrange(len(A)-L+1);j=R.randrange(len(B)+1);sg=A[i:i+L]\n   if R.random()<.5:sg=sg[::-1]\n   AA=A[:i]+A[i+L:];BB=B[:j]+sg+B[j:]\n  na=rc(ta,AA);nb=rc(tb,BB)\n  if na is None or nb is None:continue\n  delta=na+nb-oa-ob;do=over(ta,AA)+over(tb,BB)-olda-oldb\n if delta+pen*do<0 or R.random()<math"]
[2673.163529, "i", ".exp(-(delta+pen*do)/temp):\n  cur[a]=(ta,AA)\n  if a!=b:cur[b]=(tb,BB)\n  curc+=delta;curo+=do;acc+=1\n  if curo==0 and curc<bestc:\n   best=[(t,s[:]) for t,s in cur];bestc=curc\n # Restart from feasible incumbent for final quarter or excessive overload.\n if (it%500000==0 and (frac>.72 or curo>40)):\n  cur=[(t,s[:]) for t,s in best];curc=bestc;curo=0\nroutes=[{'type':t,'depart':ev(t,tuple(s))[1],'stops':s} for t,s in best]\njson.dump({'routes':routes},open(p,'w'),indent=2)\nprint('FINAL',bestc,'target',target,'it',it,'accepted',acc,'counts',counts(best))\nPY\nrm -f /tmp/relaxcand-*.json /tmp/relaxcand-*.log\nfor n in harbour-lanes old-town riverside north-ring; do for r in 1 2 3 4; do cp /app/plans/$n.json /tmp/relaxcand-$n-$r.json; (OUT=/tmp/relaxcand-$n-$r.json python3 /tmp/relax.py $n 180 > /tmp/relaxcand-$n-$r.log 2>&1) & done; done; wait\n"]
