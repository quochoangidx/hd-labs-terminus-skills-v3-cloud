[3076.980496, "i", "cat > /tmp/compound.py <<'PY'\nimport sys,json,random,time,math,os,itertools\nname=sys.argv[1];secs=float(sys.argv[2])\nsrc=open('/tmp/solve.py').read().split('start=time.time();')[0];exec(src,globals())\np=os.environ.get('OUT','/app/plans/'+name+'.json');d=json.load(open(p));best=[(r['type'],r['stops'][:]) for r in d['routes']];cur=[(t,s[:]) for t,s in best]\ndef rc(t,s):\n e=ev(t,tuple(s));return e[0] if e else None\ndef tc(z):return sum(rc(t,s) for t,s in z)\ndef ld(s):return sum(C[x]['demand'] for x in s)\n# Cheapest insertion of up to 3 incoming customers, trying all orders and positions.\ndef bins(t,base,items,cutoff=10**18):\n states={(tuple(base),rc(t,base))}\n if next(iter(states))[1] is None:return None\n for x in items:\n  nxt={}\n  for s,c0 in states:\n   s=list(s)\n   for j in range(len(s)+1):\n    q=tuple(s[:j]+[x]+s[j:]);v=rc(t,q)\n    if v is not None and (q not in nxt or v<nxt[q]):nxt[q]=v\n  if not nxt:return None\n  # Keep diverse cheapest partial sequences to control 3-item expansion.\n  states=set(sorted(nxt.i"]
[3076.98153, "i", "tems(),key=lambda z:z[1])[:80])\n return min((v,list(s)) for s,v in states)\nR=random.Random(time.time_ns());bestc=tc(best);curc=bestc;start=time.time();it=acc=0\nwhile time.time()-start<secs and bestc>target:\n it+=1;a,b=R.sample(range(len(cur)),2);ta,A=cur[a];tb,B=cur[b]\n mode=R.random()\n if mode<.38:ka,kb=2,1\n elif mode<.82:ka,kb=2,2\n else:ka,kb=3,2\n if len(A)<=ka or len(B)<=kb:continue\n xa=R.sample(A,ka);xb=R.sample(B,kb)\n A0=A[:];B0=B[:]\n for x in xa:A0.remove(x)\n for x in xb:B0.remove(x)\n if ld(A0)+ld(xb)>F[ta]['capacity'] or ld(B0)+ld(xa)>F[tb]['capacity']:continue\n # Randomize incoming order; repeated trials explore alternatives, while bins picks positions.\n R.shuffle(xa);R.shuffle(xb)\n ca=bins(ta,A0,xb);cb=bins(tb,B0,xa)\n if ca is None or cb is None:continue\n old=rc(ta,A)+rc(tb,B);delta=ca[0]+cb[0]-old\n frac=(time.time()-start)/secs;temp=max(1,45*(1-frac))\n if delta<0 or R.random()<math.exp(-delta/temp):\n  cur[a]=(ta,ca[1]);cur[b]=(tb,cb[1]);curc+=delta;acc+=1\n  if curc<bestc:\n   best=[(t,s[:]) for t,s i"]
