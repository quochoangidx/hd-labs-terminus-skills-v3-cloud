[1446.311123, "i", "python3 - <<'PY'\nimport json,math,collections\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('orders/'+n+'.json')); p=json.load(open('plans/'+n+'.json')); C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};D=o['depot']\n di=lambda a,b:math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\n print('\\n###',n)\n fixed=travel=0\n for k,r in enumerate(p['routes']):\n  pts=[D]+[C[i] for i in r['stops']]+[D]; dd=sum(di(a,b) for a,b in zip(pts,pts[1:])); load=sum(C[i]['demand'] for i in r['stops']); f=F[r['type']];fixed+=f['fixed'];travel+=f['per_unit']*dd\n  print(k,r['type'],'n',len(r['stops']),'load',load,'/',f['capacity'],'dist',dd,'cost',f['fixed']+f['per_unit']*dd,'ready',min(C[i]['ready'] for i in r['stops']),max(C[i]['ready'] for i in r['stops']))\n print('fixed',fixed,'travel',travel,'total',fixed+travel)\nPY\n"]
