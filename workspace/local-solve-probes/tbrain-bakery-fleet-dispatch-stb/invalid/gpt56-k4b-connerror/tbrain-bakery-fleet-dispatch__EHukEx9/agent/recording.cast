[506.571484, "i", "cat > /tmp/local.py <<'PY'\nimport sys,json,math,os,time\nname=sys.argv[1]\n# Load definitions from solve2, stopping before its main search.\nsrc=open('/tmp/solve2.py').read().split('start=time.time();')[0]\nexec(src,globals())\np='/app/plans/'+name+'.json'; data=json.load(open(p)); sol=[(r['type'],r['stops'][:]) for r in data['routes']]\ndef rc(t,s):\n e=ev(t,tuple(s)); return e[0] if e else None\ndef total(z):return sum(rc(t,s) for t,s in z)\nprint('start',total(sol),[(t,len(s)) for t,s in sol],flush=True)\nrounds=0\nwhile True:\n rounds+=1; bestd=0; move=None\n # intra-route 2-opt\n for a,(ta,A) in enumerate(sol):\n  old=rc(ta,A)\n  for i in range(len(A)):\n   for j in range(i+2,len(A)+1):\n    B=A[:i]+A[i:j][::-1]+A[j:]; nb=rc(ta,B)\n    if nb is not None and nb-old<bestd:bestd=nb-old;move=('one',a,B)\n # relocate one customer, allowing route elimination\n for a,(ta,A) in enumerate(sol):\n  for i,x in enumerate(A):\n   AA=A[:i]+A[i+1:]; ca=0 if not AA else rc(ta,AA)\n   if ca is None:continue\n   olda=rc(ta,A)\n   for b,(tb,B) in e"]
[506.571794, "i", "numerate(sol):\n    if a==b:continue\n    oldb=rc(tb,B)\n    for j in range(len(B)+1):\n     BB=B[:j]+[x]+B[j:]; cb=rc(tb,BB)\n     if cb is not None and ca+cb-olda-oldb<bestd:\n      bestd=ca+cb-olda-oldb;move=('rel',a,AA,b,BB)\n # swaps and 2-opt-star\n for a in range(len(sol)):\n  ta,A=sol[a]; oa=rc(ta,A)\n  for b in range(a+1,len(sol)):\n   tb,B=sol[b]; ob=rc(tb,B)\n   for i,x in enumerate(A):\n    for j,y in enumerate(B):\n     AA=A[:];BB=B[:];AA[i]=y;BB[j]=x;ca=rc(ta,AA);cb=rc(tb,BB)\n     if ca is not None and cb is not None and ca+cb-oa-ob<bestd:\n      bestd=ca+cb-oa-ob;move=('pair',a,AA,b,BB)\n   for i in range(1,len(A)):\n    for j in range(1,len(B)):\n     AA=A[:i]+B[j:];BB=B[:j]+A[i:]\n     ca=rc(ta,AA);cb=rc(tb,BB)\n     if ca is not None and cb is not None and ca+cb-oa-ob<bestd:\n      bestd=ca+cb-oa-ob;move=('pair',a,AA,b,BB)\n if move is None:break\n if move[0]=='one':sol[move[1]]=(sol[move[1]][0],move[2])\n else:\n  _,a,A,b,B=move;sol[a]=(sol[a][0],A);sol[b]=(sol[b][0],B)\n  sol=[x for x in sol if x[1]]\n print('round'"]
[506.57181, "i", ",rounds,'delta',bestd,'cost',total(sol),flush=True)\n# type improvement\nsol=retype(sol)\nroutes=[]\nfor t,s in sol:routes.append({'type':t,'depart':ev(t,tuple(s))[1],'stops':s})\njson.dump({'routes':routes},open(p,'w'),indent=2)\nprint('FINAL',total(sol),counts(sol),flush=True)\nPY\npython3 /tmp/local.py harbour-lanes\npython3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\n"]
