[2353.859838, "i", "cp /tmp/fast.py /tmp/fasthighrep.py; python3 - <<'PY'\np='/tmp/fasthighrep.py';s=open(p).read();s=s.replace(\"p='/app/plans/'+name+'.json'\", \"p=os.environ.get('OUT','/app/plans/'+name+'.json')\");open(p,'w').write(s)\nPY\nrm -f /tmp/highcand-*.json /tmp/highcand-*.log\nfor n in harbour-lanes old-town riverside north-ring; do for r in 1 2 3 4; do cp /app/plans/$n.json /tmp/highcand-$n-$r.json; (OUT=/tmp/highcand-$n-$r.json python3 /tmp/fasthighrep.py $n 180 > /tmp/highcand-$n-$r.log 2>&1) & done; done; wait\n"]
