[2151.550087, "i", "python3 - <<'PY'\nimport glob,json,shutil,sys\nsys.path.insert(0,'/app/tools');from check_plan import evaluate\nfor n in ['harbour-lanes','old-town']:\n o=json.load(open('/app/orders/'+n+'.json')); vals=[]\n for p in glob.glob('/tmp/cand-'+n+'-*.json'):\n  try:vals.append((evaluate(o,json.load(open(p))),p))\n  except Exception as e:print('bad',p,e)\n vals.sort();print(n,vals)\n shutil.copy(vals[0][1],'/app/plans/'+n+'.json')\nPY\nfor n in harbour-lanes old-town; do python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
