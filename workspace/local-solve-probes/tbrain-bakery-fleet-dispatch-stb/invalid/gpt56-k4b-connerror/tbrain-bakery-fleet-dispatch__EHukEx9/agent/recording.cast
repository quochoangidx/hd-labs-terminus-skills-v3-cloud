[94.100645, "i", "cat > /tmp/solve.py <<'PY'\nimport json, math, random, sys, time, os\nfrom functools import lru_cache\n\nname=sys.argv[1]; seconds=float(sys.argv[2]) if len(sys.argv)>2 else 30\nO=json.load(open('/app/orders/'+name+'.json')); C={c['id']:c for c in O['customers']}; D=O['depot']; F={f['type']:f for f in O['fleet']}; TYPES=list(F)\nids=list(C); rnd=random.Random(41731+len(ids)); target=json.load(open('/app/orders/targets.json'))[name]\ndef dist(a,b): return math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\nDM={(a,b):dist(D if a==0 else C[a],D if b==0 else C[b]) for a in [0]+ids for b in [0]+ids}\n\n@lru_cache(maxsize=1000000)\ndef ev(t, s):\n f=F[t]; s=list(s)\n if not s:return None\n load=sum(C[i]['demand'] for i in s)\n if load>f['capacity']: return None\n dd=DM[0,s[0]]+sum(DM[a,b] for a,b in zip(s,s[1:]))+DM[s[-1],0]\n if f['range'] is not None and dd>f['range']: return None\n # latest departure satisfying all due times and depot close\n latest=D['close']-DM[s[-1],0]*f['pace']\n for k in range(len(s)-1,-1,-1):\n  c=C[s[k]]; sta"]
[94.101249, "i", "rt=min(c['due'],latest-c['service'])\n  if start<c['ready']: return None\n  latest=start-DM[0 if k==0 else s[k-1],s[k]]*f['pace']\n dep=latest\n if dep<D['open']: return None\n # forward validation and shift\n clock=dep; prev=0\n for i in s:\n  clock=max(clock+DM[prev,i]*f['pace'],C[i]['ready'])\n  if clock>C[i]['due']:return None\n  clock+=C[i]['service']; prev=i\n back=clock+DM[prev,0]*f['pace']\n if back>D['close'] or back-dep>f['shift']: return None\n return f['fixed']+f['per_unit']*dd, dep, dd\n\ndef cost(sol): return sum(ev(t,tuple(s))[0] for t,s in sol)\ndef counts(sol):\n z={t:0 for t in TYPES}\n for t,s in sol:z[t]+=1\n return z\n\ndef options(sol,cid,noise=0.0, limit=999999):\n out=[]\n for r,(t,s) in enumerate(sol):\n  old=ev(t,tuple(s))[0]\n  for p in range(len(s)+1):\n   ns=tuple(s[:p]+[cid]+s[p:]); e=ev(t,ns)\n   if e: out.append((e[0]-old+rnd.random()*noise,r,p,t,ns,e[0]-old))\n cnt=counts(sol)\n for t in TYPES:\n  if cnt[t]<F[t]['count']:\n   e=ev(t,(cid,))\n   if e:out.append((e[0]+rnd.random()*noise,len(sol),0,t,(cid,),e[0"]
