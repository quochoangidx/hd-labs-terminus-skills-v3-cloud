[94.111455, "o", "h>  if time.time()-start>seconds*.2:break\r\n\u001b[?2004l\r\u001b[?2004h> if best is None: raise SystemExit('could not construct')\r\n\u001b[?2004l\r\u001b[?2004h> cur=[(t,s[:]) for t,s in best]; curc=bestc; it=0\r\n\u001b[?2004l\r\u001b[?2004h> while time.time()-start<seconds and bestc>target:\r\n\u001b[?2004l\r\u001b[?2004h>  it+=1; cand=[(t,s[:]) for t,s in cur]\r\n\u001b[?2004l\r\u001b[?2004h>  # related/random destroy\r\n\u001b[?2004l\r\u001b[?2004h>  q=rnd.randint(max(3,len(ids)//25),max(5,len(ids)//9))\r\n\u001b[?2004l\r\u001b[?2004h>  if rnd.random()<.65:\r\n\u001b[?2004l\r\u001b[?2004h>   seed=rnd.choice(ids); pool=sorted(ids,key=lambda i:DM[seed,i]+abs(C[seed]['ready']-C[i]['ready'])/30)\r\n\u001b[?2004l\r\u001b[?2004h>   rem=set(pool[:q])\r\n\u001b[?2004l\r\u001b[?2004h>  else: rem=set(rnd.sample(ids,q))\r\n\u001b[?2004l\r\u001b[?2004h>  ns=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for t,s in cand:\r\n\u001b[?2004l\r\u001b[?2004h>   x=[i for i in s if i not in rem]\r\n\u001b[?2004l\r\u001b[?2004h>   if x:ns.append((t,x))\r\n\u001b[?2004l\r\u001b[?2004h>  cand=insert(ns,rem,noise=300+rnd.random()*1800,regret=rnd.random()<.8)\r\n\u001b[?2004l\r\u001b[?2004h>  if not cand:continue\r\n\u001b[?2004l\r\u001b[?2004h>  if rnd"]
[94.11209, "o", ".random()<.35:cand=retype(cand)\r\n\u001b[?2004l\r\u001b[?2004h>  if rnd.random()<.25:cand=improve_routes(cand)\r\n\u001b[?2004l\r\u001b[?2004h>  cc=cost(cand)\r\n\u001b[?2004l\r\u001b[?2004h>  temp=max(40,1000*(1-(time.time()-start)/seconds))\r\n\u001b[?2004l\r\u001b[?2004h>  if cc<curc or rnd.random()<math.exp((curc-cc)/temp):cur,curc=cand,cc\r\n\u001b[?2004l\r\u001b[?2004h>  if cc<bestc:\r\n\u001b[?2004l\r\u001b[?2004h>   best=[(t,s[:]) for t,s in cand];bestc=cc\r\n\u001b[?2004l\r\u001b[?2004h>   print('best',it,bestc,'routes',len(best),'counts',counts(best),flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> # final departure values\r\n\u001b[?2004l\r\u001b[?2004h> routes=[]\r\n\u001b[?2004l\r\u001b[?2004h> for t,s in best:\r\n\u001b[?2004l\r\u001b[?2004h>  e=ev(t,tuple(s)); routes.append({'type':t,'depart':int(e[1]),'stops':s})\r\n\u001b[?2004l\r\u001b[?2004h> os.makedirs('/app/plans',exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> json.dump({'routes':routes},open('/app/plans/'+name+'.json','w'),indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> print('FINAL',name,bestc,'target',target,'iterations',it,'cache',ev.cache_info())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
