[21.054152, "o", "cat /app/README.md\r\n\u001b[?2004l\r"]
[21.056527, "o", "# Morning dispatch\r\n\r\nWholesale deliveries from the bakery: cafes, grocers, hotels and the two market\r\nhalls, by cargo bike, van and truck.\r\n\r\n- `orders/` - one file per morning: customers, windows, crates, and the vehicles on hand\r\n- `docs/dispatch-rules.md` - what makes a plan runnable and what it costs\r\n- `tools/check_plan.py` - checks a plan and prints its cost\r\n- `planner/plan_morning.py` - the planner in use today\r\n- `plans/` - the plans dispatch will run\r\n\r\n    python3 planner/plan_morning.py orders/old-town.json plans/old-town.json\r\n    python3 tools/check_plan.py orders/old-town.json plans/old-town.json\r\n"]
[21.057891, "o", "\u001b[?2004hroot@78e005634995:/app# "]
[29.550369, "i", "python3 - <<'PY'\nimport json\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n x=json.load(open('/app/orders/'+n+'.json'))\n cs=x['customers']\n print('\\n',n,'N=',len(cs),'demand=',sum(c['demand'] for c in cs),'depot=',x['depot'])\n for f in x['fleet']: print(f)\n from collections import Counter\n print('ready',Counter(c['ready'] for c in cs)); print('due',Counter(c['due'] for c in cs))\nPY\n"]
[29.551006, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.551652, "o", "for n in ['harbour-lanes','old-town','riverside','north-ring']:\r\n\u001b[?2004l\r\u001b[?2004h>  x=json.load(open('/app/orders/'+n+'.json'))\r\n\u001b[?2004l\r\u001b[?2004h>  cs=x['customers']\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n',n,'N=',len(cs),'demand=',sum(c['demand'] for c in cs),'depot=',x['depot'])\r\n\u001b[?2004l\r\u001b[?2004h>  for f in x['fleet']: print(f)\r\n\u001b[?2004l\r\u001b[?2004h>  from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.55228, "o", " print('ready',Counter(c['ready'] for c in cs)); print('due',Counter(c['due'] for c in cs))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
