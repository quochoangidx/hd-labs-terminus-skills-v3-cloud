[3076.981605, "i", "n cur];bestc=curc\n if it%100000==0 and frac>.65:cur=[(t,s[:]) for t,s in best];curc=bestc\nroutes=[{'type':t,'depart':ev(t,tuple(s))[1],'stops':s} for t,s in best]\njson.dump({'routes':routes},open(p,'w'),indent=2)\nprint('FINAL',bestc,'target',target,'it',it,'accepted',acc,counts(best))\nPY\nrm -f /tmp/compcand-*.json /tmp/compcand-*.log\nfor n in harbour-lanes old-town riverside north-ring; do for r in 1 2 3 4; do cp /app/plans/$n.json /tmp/compcand-$n-$r.json; (OUT=/tmp/compcand-$n-$r.json python3 /tmp/compound.py $n 180 > /tmp/compcand-$n-$r.log 2>&1) & done; done; wait\n"]
