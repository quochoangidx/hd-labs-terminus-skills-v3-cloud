[2900.382576, "i", "cat > /tmp/xswap.py <<'PY'\nimport sys,json,time\nname=sys.argv[1];limit=float(sys.argv[2])\nsrc=open('/tmp/solve.py').read().split('start=time.time();')[0];exec(src,globals())\np='/app/plans/'+name+'.json';d=json.load(open(p));sol=[(r['type'],r['stops'][:]) for r in d['routes']]\ndef rc(t,s):\n e=ev(t,tuple(s));return e[0] if e else None\ndef tc():return sum(rc(t,s) for t,s in sol)\nstart=time.time();rd=0;print('start',tc(),flush=True)\nwhile time.time()-start<limit:\n best=(0,None)\n for a in range(len(sol)):\n  ta,A=sol[a];oa=rc(ta,A);la=sum(C[x]['demand'] for x in A)\n  for b in range(a+1,len(sol)):\n   tb,B=sol[b];ob=rc(tb,B);lb=sum(C[x]['demand'] for x in B)\n   for ia,x in enumerate(A):\n    A0=A[:ia]+A[ia+1:]\n    for ib,y in enumerate(B):\n     if la-C[x]['demand']+C[y]['demand']>F[ta]['capacity'] or lb-C[y]['demand']+C[x]['demand']>F[tb]['capacity']:continue\n     B0=B[:ib]+B[ib+1:]\n     besta=None\n     for i in range(len(A0)+1):\n      AA=A0[:i]+[y]+A0[i:];ca=rc(ta,AA)\n      if ca is not None and (besta is None or ca<"]
[2900.382731, "i", "besta[0]):besta=(ca,AA)\n     if besta is None:continue\n     bestb=None\n     for j in range(len(B0)+1):\n      BB=B0[:j]+[x]+B0[j:];cb=rc(tb,BB)\n      if cb is not None and (bestb is None or cb<bestb[0]):bestb=(cb,BB)\n     if bestb is not None:\n      delta=besta[0]+bestb[0]-oa-ob\n      if delta<best[0]:best=(delta,(a,b,besta[1],bestb[1]))\n   if time.time()-start>=limit:break\n  if time.time()-start>=limit:break\n if best[1] is None:break\n _,(a,b,A,B)=best;sol[a]=(sol[a][0],A);sol[b]=(sol[b][0],B);rd+=1\n print('move',rd,best[0],tc(),flush=True)\nroutes=[{'type':t,'depart':ev(t,tuple(s))[1],'stops':s} for t,s in sol]\njson.dump({'routes':routes},open(p,'w'),indent=2);print('FINAL',tc(),'moves',rd)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/xswap.py $n 55; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
