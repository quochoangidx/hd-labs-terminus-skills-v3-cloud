[506.594336, "o", "a+cb-oa-ob;move=('pair',a,AA,b,BB)\r\n\u001b[?2004l\r\u001b[?2004h>  if move is None:break\r\n\u001b[?2004l\r\u001b[?2004h>  if move[0]=='one':sol[move[1]]=(sol[move[1]][0],move[2])\r\n\u001b[?2004l\r\u001b[?2004h>  else:\r\n\u001b[?2004l\r\u001b[?2004h>   _,a,A,b,B=move;sol[a]=(sol[a][0],A);sol[b]=(sol[b][0],B)\r\n\u001b[?2004l\r\u001b[?2004h>   sol=[x for x in sol if x[1]]\r\n\u001b[?2004l\r\u001b[?2004h>  print('round',rounds,'delta',bestd,'cost',total(sol),flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> # type improvement\r\n\u001b[?2004l\r\u001b[?2004h> sol=retype(sol)\r\n\u001b[?2004l\r\u001b[?2004h> routes=[]\r\n\u001b[?2004l\r\u001b[?2004h> for t,s in sol:routes.append({'type':t,'depart':ev(t,tuple(s))[1],'stops':s})\r\n\u001b[?2004l\r\u001b[?2004h"]
