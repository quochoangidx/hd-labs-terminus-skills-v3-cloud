[2673.167585, "o", "andom()<math.exp(-(delta+pen*do)/temp):\r\n\u001b[?2004l\r\u001b[?2004h>   cur[a]=(ta,AA)\r\n\u001b[?2004l\r\u001b[?2004h>   if a!=b:cur[b]=(tb,BB)\r\n\u001b[?2004l\r\u001b[?2004h>   curc+=delta;curo+=do;acc+=1\r\n\u001b[?2004l\r\u001b[?2004h>   if curo==0 and curc<bestc:\r\n\u001b[?2004l\r\u001b[?2004h>    best=[(t,s[:]) for t,s in cur];bestc=curc\r\n\u001b[?2004l\r\u001b[?2004h>  # Restart from feasible incumbent for final quarter or excessive overload.\r\n\u001b[?2004l\r\u001b[?2004h>  if (it%500000==0 and (frac>.72 or curo>40)):\r\n\u001b[?2004l\r\u001b[?2004h>   cur=[(t,s[:]) for t,s in best];curc=bestc;curo=0\r\n\u001b[?2004l\r\u001b[?2004h> routes=[{'type':t,'depart':ev(t,tuple(s))[1],'stops':s} for t,s in best]\r\n\u001b[?2004l\r\u001b[?2004h> "]
