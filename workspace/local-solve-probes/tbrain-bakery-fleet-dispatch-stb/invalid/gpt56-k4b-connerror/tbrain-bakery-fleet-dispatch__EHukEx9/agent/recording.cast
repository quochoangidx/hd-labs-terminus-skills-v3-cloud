[3293.966697, "i", "cp /tmp/compound.py /tmp/compoundwide.py; python3 - <<'PY'\np='/tmp/compoundwide.py';s=open(p).read()\ns=s.replace(\"if mode<.38:ka,kb=2,1\\n elif mode<.82:ka,kb=2,2\\n else:ka,kb=3,2\", \"if mode<.20:ka,kb=2,1\\n elif mode<.45:ka,kb=2,2\\n elif mode<.70:ka,kb=3,2\\n elif mode<.90:ka,kb=3,3\\n else:ka,kb=4,3\")\ns=s.replace(\"[:80]\", \"[:120]\")\nopen(p,'w').write(s)\nPY\nrm -f /tmp/gen2-*.json /tmp/gen2-*.log\nfor n in old-town riverside north-ring; do for r in 1 2 3 4; do cp /app/plans/$n.json /tmp/gen2-$n-$r.json; (OUT=/tmp/gen2-$n-$r.json python3 /tmp/compound.py $n 180 > /tmp/gen2-$n-$r.log 2>&1) & done; done\nfor r in 1 2 3 4; do cp /app/plans/harbour-lanes.json /tmp/gen2-harbour-lanes-$r.json; (OUT=/tmp/gen2-harbour-lanes-$r.json python3 /tmp/compoundwide.py harbour-lanes 180 > /tmp/gen2-harbour-lanes-$r.log 2>&1) & done\nwait\n"]
