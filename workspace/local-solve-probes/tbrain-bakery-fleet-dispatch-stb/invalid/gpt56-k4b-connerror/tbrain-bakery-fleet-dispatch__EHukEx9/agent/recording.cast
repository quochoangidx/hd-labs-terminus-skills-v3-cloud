[2647.808745, "i", "python3 - <<'PY'\nimport json,math\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('orders/'+n+'.json'));p=json.load(open('plans/'+n+'.json'));C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};D=o['depot'];di=lambda a,b:math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\n rows=[]\n for k,r in enumerate(p['routes']):\n  pts=[D]+[C[i] for i in r['stops']]+[D];dd=sum(di(a,b) for a,b in zip(pts,pts[1:]));load=sum(C[i]['demand'] for i in r['stops']);rows.append((r['type'],load,F[r['type']]['capacity'],dd,len(r['stops']),k))\n print('\\n',n);print(*sorted(rows),sep='\\n')\nPY\n"]
[2647.809116, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[2647.809935, "o", "\u001b[?2004h> import json,math\r\n\u001b[?2004l\r\u001b[?2004h> for n in ['harbour-lanes','old-town','riverside','north-ring']:\r\n\u001b[?2004l\r\u001b[?2004h>  o=json.load(open('orders/'+n+'.json'));p=json.load(open('plans/'+n+'.json'));C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};D=o['depot'];di=lambda a,b:math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\r\n\u001b[?2004l\r\u001b[?2004h>  rows=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for k,r in enumerate(p['routes']):\r\n\u001b[?2004l\r\u001b[?2004h>   pts=[D]+[C[i] for i in r['stops']]+[D];dd=sum(di(a,b) for a,b in zip(pts,pts[1:]));load=sum(C[i]['demand'] for i in r['stops']);rows.append((r['type'],load,F[r['type']]['capacity'],dd,len(r['stops']),k))\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n',n);print(*sorted(rows),sep='\\n')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
