[1834.86162, "i", "python3 - <<'PY'\nfor p in ['/tmp/solve.py','/tmp/solve2.py','/tmp/fast.py','/tmp/fastlow.py','/tmp/relocate.py','/tmp/segments.py','/tmp/local.py']:\n s=open(p).read()\n s=s.replace(\"dep=latest\\n if dep<D['open']: return None\", \"dep=max(D['open'],latest)\")\n open(p,'w').write(s)\nPY\ncat > /tmp/typeswap.py <<'PY'\nimport sys,json\nname=sys.argv[1]\nsrc=open('/tmp/solve.py').read().split('start=time.time();')[0];exec(src,globals())\np='/app/plans/'+name+'.json';d=json.load(open(p));sol=[(r['type'],r['stops'][:]) for r in d['routes']]\ndef rc(t,s):\n e=ev(t,tuple(s));return e[0] if e else None\ndef tc():return sum(rc(t,s) for t,s in sol)\nprint('start',tc(),counts(sol))\nfor rd in range(20):\n best=(0,None);cnt=counts(sol)\n # direct retype if spare vehicle\n for i,(t,A) in enumerate(sol):\n  for u in TYPES:\n   if u==t or cnt[u]>=F[u]['count']:continue\n   z=rc(u,A)\n   if z is not None and z-rc(t,A)<best[0]:best=(z-rc(t,A),('one',i,u))\n # exchange types of two routes\n for i,(t,A) in enumerate(sol):\n  for j in range(i+1,len(sol)):"]
[1834.861902, "i", "\n   u,B=sol[j]\n   if t==u:continue\n   x=rc(u,A);y=rc(t,B)\n   if x is not None and y is not None:\n    dd=x+y-rc(t,A)-rc(u,B)\n    if dd<best[0]:best=(dd,('two',i,j))\n if not best[1]:break\n if best[1][0]=='one':_,i,u=best[1];sol[i]=(u,sol[i][1])\n else:_,i,j=best[1];ti,A=sol[i];tj,B=sol[j];sol[i]=(tj,A);sol[j]=(ti,B)\n print(rd+1,best[0],tc(),counts(sol))\nroutes=[{'type':t,'depart':ev(t,tuple(s))[1],'stops':s} for t,s in sol]\njson.dump({'routes':routes},open(p,'w'),indent=2);print('FINAL',tc())\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/typeswap.py $n; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
