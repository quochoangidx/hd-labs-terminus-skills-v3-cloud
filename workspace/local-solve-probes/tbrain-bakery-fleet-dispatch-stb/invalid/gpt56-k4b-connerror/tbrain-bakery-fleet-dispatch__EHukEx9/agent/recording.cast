[3276.952732, "i", "python3 - <<'PY'\nimport glob,json,shutil,sys\nsys.path.insert(0,'/app/tools');from check_plan import evaluate\nT=json.load(open('/app/orders/targets.json'))\nfor n in T:\n o=json.load(open('/app/orders/'+n+'.json'));base='/app/plans/'+n+'.json';vals=[(evaluate(o,json.load(open(base))),base)]\n for p in glob.glob('/tmp/compcand-'+n+'-*.json'):\n  try:vals.append((evaluate(o,json.load(open(p))),p))\n  except Exception as e:print('bad',p,e)\n vals.sort();print(n,vals,'target',T[n],'gap',vals[0][0]-T[n])\n if vals[0][1]!=base:shutil.copy(vals[0][1],base)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
[3276.953423, "o", "python3 - <<'PY'"]
[3276.954478, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import glob,json,shutil,sys\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0,'/app/tools');from check_plan import evaluate\r\n\u001b[?2004l\r\u001b[?2004h> T=json.load(open('/app/orders/targets.json'))\r\n\u001b[?2004l\r\u001b[?2004h> for n in T:\r\n\u001b[?2004l\r\u001b[?2004h>  o=json.load(open('/app/orders/'+n+'.json'));base='/app/plans/'+n+'.json';vals=[(evaluate(o,json.load(open(base))),base)]\r\n\u001b[?2004l\r\u001b[?2004h>  for p in glob.glob('/tmp/compcand-'+n+'-*.json'):\r\n\u001b[?2004l\r\u001b[?2004h>   try:vals.append((evaluate(o,json.load(open(p))),p))\r\n\u001b[?2004l\r\u001b[?2004h>   except Exception as e:print('bad',p,e)\r\n\u001b[?2004l\r\u001b[?2004h>  vals.sort();print(n,vals,'target',T[n],'gap',vals[0][0]-T[n])\r\n\u001b[?2004l\r\u001b[?2004h>  if vals[0][1]!=base:shutil.copy(vals[0][1],base)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
