[1035.262972, "i", "cat > /tmp/segments.py <<'PY'\nimport sys,json\nname=sys.argv[1]\nsrc=open('/tmp/solve.py').read().split('start=time.time();')[0];exec(src,globals())\np='/app/plans/'+name+'.json';d=json.load(open(p));sol=[(r['type'],r['stops'][:]) for r in d['routes']]\ndef rc(t,s):\n e=ev(t,tuple(s));return e[0] if e else None\ndef tc():return sum(rc(t,s) for t,s in sol)\nprint('start',tc(),flush=True)\nfor round in range(20):\n best=(0,None)\n # Relocate consecutive segments of length 2 or 3.\n for a,(ta,A) in enumerate(sol):\n  oa=rc(ta,A)\n  for L in (2,3):\n   if len(A)<=L:continue\n   for i in range(len(A)-L+1):\n    seg=A[i:i+L];AA=A[:i]+A[i+L:];ca=rc(ta,AA)\n    if ca is None:continue\n    for b,(tb,B) in enumerate(sol):\n     if b==a:continue\n     ob=rc(tb,B)\n     for sg in (seg,seg[::-1]):\n      for j in range(len(B)+1):\n       BB=B[:j]+sg+B[j:];cb=rc(tb,BB)\n       if cb is not None and ca+cb-oa-ob<best[0]:best=(ca+cb-oa-ob,('m',a,AA,b,BB))\n # Swap 2-customer segments.\n for a in range(len(sol)):\n  ta,A=sol[a];oa=rc(ta,A)\n  for b in ra"]
[1035.263434, "i", "nge(a+1,len(sol)):\n   tb,B=sol[b];ob=rc(tb,B)\n   for i in range(len(A)-1):\n    xa=A[i:i+2]\n    for j in range(len(B)-1):\n     xb=B[j:j+2]\n     for ya in (xb,xb[::-1]):\n      AA=A[:i]+ya+A[i+2:];ca=rc(ta,AA)\n      if ca is None:continue\n      for yb in (xa,xa[::-1]):\n       BB=B[:j]+yb+B[j+2:];cb=rc(tb,BB)\n       if cb is not None and ca+cb-oa-ob<best[0]:best=(ca+cb-oa-ob,('m',a,AA,b,BB))\n if best[1] is None:break\n _,a,A,b,B=best[1];sol[a]=(sol[a][0],A);sol[b]=(sol[b][0],B)\n print(round+1,best[0],tc(),flush=True)\nroutes=[{'type':t,'depart':ev(t,tuple(s))[1],'stops':s} for t,s in sol]\njson.dump({'routes':routes},open(p,'w'),indent=2);print('FINAL',tc(),counts(sol))\nPY\npython3 /tmp/segments.py harbour-lanes\npython3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\n"]
