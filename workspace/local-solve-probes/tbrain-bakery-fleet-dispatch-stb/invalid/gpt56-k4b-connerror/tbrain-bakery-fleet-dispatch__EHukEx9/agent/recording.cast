[1471.214468, "i", "cat > /tmp/fast.py <<'PY'\nimport sys,json,random,time,math,os\nname=sys.argv[1];secs=float(sys.argv[2]);\nsrc=open('/tmp/solve.py').read().split('start=time.time();')[0];exec(src,globals())\np='/app/plans/'+name+'.json';d=json.load(open(p));best=[(r['type'],r['stops'][:]) for r in d['routes']];bestc=cost(best);cur=[(t,s[:]) for t,s in best];curc=bestc\nR=random.Random(time.time_ns());start=time.time();it=0;acc=0\ndef rv(t,s):\n e=ev(t,tuple(s));return e[0] if e else None\nwhile time.time()-start<secs and bestc>target:\n it+=1; a=R.randrange(len(cur)); b=R.randrange(len(cur));ta,A=cur[a];tb,B=cur[b]\n if not A or not B:continue\n u=R.random(); oa=rv(ta,A);ob=rv(tb,B); AA=A;BB=B\n if a==b:\n  if len(A)<2:continue\n  i,j=sorted(R.sample(range(len(A)+1),2))\n  if j-i<2:continue\n  AA=A[:i]+A[i:j][::-1]+A[j:]; na=rv(ta,AA)\n  if na is None:continue\n  delta=na-oa\n else:\n  if u<.45: # relocate one\n   i=R.randrange(len(A));j=R.randrange(len(B)+1);x=A[i];AA=A[:i]+A[i+1:];BB=B[:j]+[x]+B[j:]\n   if not AA:continue\n  elif u<.78: # swap o"]
[1471.214865, "i", "ne\n   i=R.randrange(len(A));j=R.randrange(len(B));AA=A[:];BB=B[:];AA[i],BB[j]=BB[j],AA[i]\n  else: # relocate length 2-3\n   L=2 if R.random()<.75 else 3\n   if len(A)<=L:continue\n   i=R.randrange(len(A)-L+1);j=R.randrange(len(B)+1);sg=A[i:i+L]\n   if R.random()<.5:sg=sg[::-1]\n   AA=A[:i]+A[i+L:];BB=B[:j]+sg+B[j:]\n  na=rv(ta,AA);nb=rv(tb,BB)\n  if na is None or nb is None:continue\n  delta=na+nb-oa-ob\n temp=max(15,700*(1-(time.time()-start)/secs))\n if delta<0 or R.random()<math.exp(-delta/temp):\n  cur[a]=(ta,AA)\n  if a!=b:cur[b]=(tb,BB)\n  curc+=delta;acc+=1\n  if curc<bestc:\n   best=[(t,s[:]) for t,s in cur];bestc=curc\n   if it%100<5:print('best',bestc,'it',it,flush=True)\n # occasional reset to best prevents prolonged drift\n if it%200000==0:cur=[(t,s[:]) for t,s in best];curc=bestc\nroutes=[{'type':t,'depart':ev(t,tuple(s))[1],'stops':s} for t,s in best]\njson.dump({'routes':routes},open(p,'w'),indent=2)\nprint('FINAL',bestc,'target',target,'it',it,'accepted',acc,'counts',counts(best))\nPY\npython3 /tmp/fast.py north-rin"]
