[816.968642, "i", "cp /tmp/solve.py /tmp/fixed.py\npython3 - <<'PY'\np='/tmp/fixed.py';s=open(p).read()\n# Exact desired route counts by instance.\ns=s.replace(\"ids=list(C);\", \"MIX={'harbour-lanes':{'bike':5,'van':7,'truck':1},'old-town':{'bike':9,'van':13,'truck':3},'riverside':{'bike':13,'van':20,'truck':3},'north-ring':{'bike':18,'van':27,'truck':6}}[name]\\nids=list(C);\")\n# Empty slots are retained; their accounting cost is the fixed cost (constant over exact fleet).\ns=s.replace(\"if not s:return None\", \"if not s:return (f['fixed'],D['open'],0)\")\n# Construction begins with all exact slots.\ns=s.replace(\"sol=[]\\n order=sorted(ids\", \"sol=[(t,[]) for t,n in MIX.items() for _ in range(n)]\\n order=sorted(ids\")\n# Existing-plan seed only if its fleet counts exactly match.\ns=s.replace(\"if set(sum((x[1] for x in seed),[]))==set(ids) and all(ev(t,tuple(st)) for t,st in seed):\", \"if set(sum((x[1] for x in seed),[]))==set(ids) and counts(seed)==MIX and all(st and ev(t,tuple(st)) for t,st in seed):\")\n# Do not offer creation of new routes; exac"]
[816.969023, "i", "t slots already exist.\na=s.index(\" cnt=counts(sol)\\n\",s.index(\"def options\")); b=s.index(\" out.sort\",a)\ns=s[:a]+s[b:]\n# Retain empty routes when destroying.\ns=s.replace(\"if x:ns.append((t,x))\", \"ns.append((t,x))\")\n# Disable retyping because type counts are fixed.\ns=s.replace(\"sol=retype(improve_routes(sol))\", \"sol=improve_routes(sol)\")\ns=s.replace(\"if rnd.random()<.35:cand=retype(cand)\", \"# fixed types\")\n# Reject repairs leaving an empty slot (normally impossible with 60+ customers).\ns=s.replace(\"if not cand:continue\\n if rnd.random()<.35\", \"if not cand or any(not st for _,st in cand):continue\\n if rnd.random()<.35\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /tmp/fixed.py\npython3 /tmp/fixed.py harbour-lanes 55\npython3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\n"]
