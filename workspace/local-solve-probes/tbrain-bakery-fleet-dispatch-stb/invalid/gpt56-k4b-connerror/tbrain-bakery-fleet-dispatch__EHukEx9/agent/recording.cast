[891.612373, "i", "cat > /tmp/addbike.py <<'PY'\nimport json,sys\nname=sys.argv[1]\nsrc=open('/tmp/fixed.py').read().split('start=time.time();')[0];exec(src,globals())\np='/app/plans/'+name+'.json'; d=json.load(open(p)); sol=[(r['type'],r['stops'][:]) for r in d['routes']]\nbest=None\nfor r,(t,s) in enumerate(sol):\n if len(s)<2:continue\n for k,x in enumerate(s):\n  e1=ev(t,tuple(s[:k]+s[k+1:])); e2=ev('bike',(x,))\n  if e1 and e2:\n   z=[(a,b[:]) for a,b in sol];z[r]=(t,s[:k]+s[k+1:]);z.append(('bike',[x]));cc=cost(z)\n   if best is None or cc<best[0]:best=(cc,z,x)\nprint('split',best[2],'cost',best[0], 'counts',counts(best[1]))\nroutes=[{'type':t,'depart':ev(t,tuple(s))[1],'stops':s} for t,s in best[1]]\njson.dump({'routes':routes},open(p,'w'),indent=2)\nPY\npython3 /tmp/addbike.py harbour-lanes\npython3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\npython3 /tmp/fixed.py harbour-lanes 55\n"]
[891.613676, "o", "cat > /tmp/addbike.py <<'PY'\r\n\u001b[?2004l\r"]
