[2308.728318, "i", "python3 - <<'PY'\nimport glob,json,shutil,sys\nsys.path.insert(0,'/app/tools');from check_plan import evaluate\ntarget=json.load(open('/app/orders/targets.json'))\nfor n in target:\n o=json.load(open('/app/orders/'+n+'.json')); vals=[]\n base='/app/plans/'+n+'.json';vals.append((evaluate(o,json.load(open(base))),base))\n for p in glob.glob('/tmp/fastcand-'+n+'-*.json'):\n  try: vals.append((evaluate(o,json.load(open(p))),p))\n  except Exception as e: print('bad',p,e)\n vals.sort();print(n,vals,'target',target[n],'gap',vals[0][0]-target[n]);shutil.copy(vals[0][1],base)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
