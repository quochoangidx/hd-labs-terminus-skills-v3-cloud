[94.103292, "i", "]))\n out.sort(key=lambda x:x[0])\n return out[:limit]\n\ndef insert(sol, un, noisy=0, regret=True):\n un=set(un)\n while un:\n  choices=[]\n  sample=list(un) if len(un)<45 else rnd.sample(list(un),45)\n  for c in sample:\n   op=options(sol,c,noisy,3)\n   if op:\n    reg=(op[1][0]-op[0][0] if len(op)>1 else 20000)\n    # prioritize constrained customers; mild urgency/demand tie-break\n    score=reg + C[c]['demand']*8 if regret else -op[0][0]\n    choices.append((score,c,op[0]))\n  if not choices:return None\n  _,c,x=max(choices)\n  _,r,p,t,ns,_=x\n  if r==len(sol):sol.append((t,list(ns)))\n  else:sol[r]=(t,list(ns))\n  un.remove(c)\n return sol\n\ndef initial():\n # hardest first through regret insertion; seed mandatory large-demand customers\n sol=[]\n order=sorted(ids,key=lambda i:(C[i]['demand']>60, C[i]['demand'], -C[i]['due']),reverse=True)\n return insert(sol,order,0,True)\n\ndef retype(sol):\n # greedily accept individual type changes, then pair swaps\n changed=True\n while changed:\n  changed=False; cnt=counts(sol)\n  for r,(t,s) in en"]
