[164.366484, "i", "cat > /tmp/opt.py <<'PY'\nimport json, math, random, sys, time\n\ndef dist(a,b): return math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\n\ndef solve(fn,out,seconds,seed=1):\n d=json.load(open(fn)); dep=d['depot']; C={c['id']:c for c in d['customers']}; ids=list(C)\n D={(a,b):dist(dep if a==0 else C[a],dep if b==0 else C[b]) for a in [0]+ids for b in [0]+ids if a!=b}\n slots=[]\n for v in d['fleet']:\n  for _ in range(v['count']): slots.append(v)\n def info(seq,v):\n  if not seq:return (0,dep['open'])\n  if sum(C[x]['demand'] for x in seq)>v['capacity']: return None\n  dd=D[0,seq[0]]+sum(D[a,b] for a,b in zip(seq,seq[1:]))+D[seq[-1],0]\n  if v['range'] is not None and dd>v['range']:return None\n  # backward latest feasible departure (service-start deadlines)\n  latest=dep['close']-D[seq[-1],0]*v['pace']\n  for i in range(len(seq)-1,-1,-1):\n   c=C[seq[i]]; latest=min(c['due'],latest-c['service'])\n   if i: latest-=D[seq[i-1],seq[i]]*v['pace']\n   else: latest-=D[0,seq[i]]*v['pace']\n  depart=max(dep['open'],latest)\n  if depart>l"]
[164.367035, "i", "atest:return None\n  t=depart\n  for i,x in enumerate(seq):\n   t+=D[0,x]*v['pace'] if i==0 else D[seq[i-1],x]*v['pace']\n   c=C[x]; t=max(t,c['ready'])\n   if t>c['due']:return None\n   t+=c['service']\n  t+=D[seq[-1],0]*v['pace']\n  if t>dep['close'] or t-depart>v['shift']:return None\n  return (v['fixed']+v['per_unit']*dd,depart)\n def construct():\n  routes=[[] for _ in slots]; vals=[(0,dep['open']) for _ in slots]\n  # hard customers first, with randomness; insertion seeks true incremental cost\n  todo=ids[:]\n  random.shuffle(todo)\n  todo.sort(key=lambda x:(C[x]['due']+random.randrange(2400), -C[x]['demand']))\n  for x in todo:\n   cand=[]\n   for r,(q,v,old) in enumerate(zip(routes,slots,vals)):\n    for p in range(len(q)+1):\n     z=q[:p]+[x]+q[p:]; ni=info(z,v)\n     if ni: cand.append((ni[0]-old[0],random.random(),r,p,ni))\n   if not cand:return None\n   cand.sort()\n   # Mostly best, occasionally diversify among near-best choices.\n   k=0 if random.random()<.82 else random.randrange(min(5,len(cand)))\n   _,_,r,p,ni=cand[k]"]
[164.367336, "i", "; routes[r].insert(p,x); vals[r]=ni\n  return routes,vals\n def improve(routes,vals,end):\n  cur=sum(x[0] for x in vals); best=cur; br=[x[:] for x in routes]; bv=vals[:]\n  it=0; start=time.time()\n  while time.time()<end:\n   it+=1; frac=(time.time()-start)/max(.001,end-start); T=max(3,900*(1-frac)**2)\n   typ=random.random(); changed=[]\n   if typ<.52:\n    a=random.randrange(len(routes))\n    if not routes[a]:continue\n    ia=random.randrange(len(routes[a])); x=routes[a][ia]\n    b=random.randrange(len(routes)); ib=random.randrange(len(routes[b])+1)\n    if a==b and (ib==ia or ib==ia+1):continue\n    na=routes[a][:]; na.pop(ia)\n    if a==b:\n     if ib>ia:ib-=1\n     na.insert(ib,x); nb=None\n    else:\n     nb=routes[b][:]; nb.insert(ib,x)\n    va=info(na,slots[a]); vb=va if a==b else info(nb,slots[b])\n    if va is None or vb is None:continue\n    delta=va[0]-vals[a][0] + (0 if a==b else vb[0]-vals[b][0])\n    if delta<=0 or random.random()<math.exp(-delta/T):\n     routes[a]=na; vals[a]=va\n     if a!=b:routes[b]=nb;vals[b]=vb"]
[164.367361, "i", "\n     cur+=delta\n   elif typ<.78:\n    a=random.randrange(len(routes));b=random.randrange(len(routes))\n    if a==b or not routes[a] or not routes[b]:continue\n    ia=random.randrange(len(routes[a]));ib=random.randrange(len(routes[b]))\n    na=routes[a][:];nb=routes[b][:];na[ia],nb[ib]=nb[ib],na[ia]\n    va=info(na,slots[a]);vb=info(nb,slots[b])\n    if va is None or vb is None:continue\n    delta=va[0]+vb[0]-vals[a][0]-vals[b][0]\n    if delta<=0 or random.random()<math.exp(-delta/T):\n     routes[a]=na;routes[b]=nb;vals[a]=va;vals[b]=vb;cur+=delta\n   else:\n    a=random.randrange(len(routes)); n=len(routes[a])\n    if n<3:continue\n    i,j=sorted(random.sample(range(n+1),2))\n    if j-i<2:continue\n    na=routes[a][:i]+routes[a][i:j][::-1]+routes[a][j:];va=info(na,slots[a])\n    if va is None:continue\n    delta=va[0]-vals[a][0]\n    if delta<=0 or random.random()<math.exp(-delta/T):routes[a]=na;vals[a]=va;cur+=delta\n   if cur<best:\n    best=cur;br=[x[:] for x in routes];bv=vals[:]\n  return best,br,bv,it\n random.seed(seed);"]
[164.367401, "i", " deadline=time.time()+seconds; BEST=None; attempt=0\n while time.time()<deadline:\n  attempt+=1; z=construct()\n  if not z:continue\n  # Reserve a search slice, allowing repeated constructions.\n  slice_end=min(deadline,time.time()+max(1.5,seconds/8))\n  cost,r,v,it=improve(z[0],z[1],slice_end)\n  if BEST is None or cost<BEST[0]:\n   BEST=(cost,r,v); print('best',cost,'attempt',attempt,'routes',sum(bool(x) for x in r),flush=True)\n if BEST is None:raise SystemExit('no solution')\n cost,routes,vals=BEST\n plan={'routes':[{'type':slots[i]['type'],'depart':vals[i][1],'stops':q} for i,q in enumerate(routes) if q]}\n json.dump(plan,open(out,'w'),indent=1);print('FINAL',cost)\n\nif __name__=='__main__':solve(sys.argv[1],sys.argv[2],float(sys.argv[3]),int(sys.argv[4]) if len(sys.argv)>4 else 1)\nPY\nmkdir -p plans\nfor n in harbour-lanes old-town riverside north-ring; do echo \"=== $n ===\"; python3 /tmp/opt.py orders/$n.json plans/$n.json 25 17; python3 tools/check_plan.py orders/$n.json plans/$n.json; done\n"]
