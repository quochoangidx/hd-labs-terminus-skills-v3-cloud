[103.233671, "o", "     1\t\"\"\"Check a delivery plan against docs/dispatch-rules.md and print its cost.\r\n     2\t\r\n     3\tUsage: python3 tools/check_plan.py orders/<morning>.json plans/<morning>.json\r\n     4\t\"\"\"\r\n     5\t\r\n     6\timport json\r\n     7\timport math\r\n     8\timport sys\r\n     9\t\r\n    10\t\r\n    11\tclass PlanError(ValueError):\r\n    12\t    pass\r\n    13\t\r\n    14\t\r\n    15\tdef distance(a, b):\r\n    16\t    sq = (a[\"x\"] - b[\"x\"]) ** 2 + (a[\"y\"] - b[\"y\"]) ** 2\r\n    17\t    d = math.isqrt(sq)\r\n    18\t    return d if d * d == sq else d + 1\r\n    19\t\r\n    20\t\r\n    21\tdef evaluate(orders, plan):\r\n    22\t    depot = orders[\"depot\"]\r\n    23\t    customers = {c[\"id\"]: c for c in orders[\"customers\"]}\r\n    24\t    fleet = {f[\"type\"]: f for f in orders[\"fleet\"]}\r\n    25\t    used = {t: 0 for t in fleet}\r\n    26\t    served = set()\r\n    27\t    total = 0\r\n    28\t    if not isinstance(plan, dict) or not isinstance(plan.get(\"routes\"), list):\r\n    29\t        raise PlanError(\"a plan is a JSON object with a routes list\")\r\n    30\t    for number, route in e"]
[103.233706, "o", "numerate(plan[\"routes\"], start=1):\r\n    31\t        where = f\"route {number}\"\r\n    32\t        if not isinstance(route, dict):\r\n    33\t            raise PlanError(f\"{where}: not a JSON object\")\r\n    34\t        kind = fleet.get(route.get(\"type\")) if isinstance(route.get(\"type\"), str) else None\r\n    35\t        if kind is None:\r\n    36\t            raise PlanError(f\"{where}: unknown vehicle type {route.get('type')!r}\")\r\n    37\t        stops = route.get(\"stops\")\r\n    38\t        if not isinstance(stops, list) or not stops:\r\n    39\t            raise PlanError(f\"{where}: no stops\")\r\n    40\t        depart = route.get(\"depart\")\r\n    41\t        if not isinstance(depart, int) or isinstance(depart, bool) or depart < depot[\"open\"]:\r\n    42\t            raise PlanError(f\"{where}: departure must be a whole second, not before opening\")\r\n    43\t        used[route[\"type\"]] += 1\r\n    44\t        clock, here, crates, driven = depart, depot, 0, 0\r\n    45\t        for cid in stops:\r\n    46\t            if not isinstance(cid, int) or isin"]
[103.233928, "o", "stance(cid, bool) or cid not in customers:\r\n    47\t                raise PlanError(f\"{where}: unknown customer {cid!r}\")\r\n    48\t            if cid in served:\r\n    49\t                raise PlanError(f\"{where}: customer {cid} delivered twice\")\r\n    50\t            served.add(cid)\r\n    51\t            customer = customers[cid]\r\n    52\t            leg = distance(here, customer)\r\n    53\t            driven += leg\r\n    54\t            start = max(clock + leg * kind[\"pace\"], customer[\"ready\"])\r\n    55\t            if start > customer[\"due\"]:\r\n    56\t                raise PlanError(f\"{where}: customer {cid} reached at {start}, after its window closes at {customer['due']}\")\r\n    57\t            clock = start + customer[\"service\"]\r\n    58\t            crates += customer[\"demand\"]\r\n    59\t            here = customer\r\n    60\t        leg = distance(here, depot)\r\n    61\t        driven += leg\r\n    62\t        back = clock + leg * kind[\"pace\"]\r\n    63\t        if back > depot[\"close\"]:\r\n    64\t            raise PlanError(f\"{where}: "]
[103.233948, "o", "back at {back}, after the bakery closes\")\r\n    65\t        if back - depart > kind[\"shift\"]:\r\n    66\t            raise PlanError(f\"{where}: out for {back - depart} s, longer than the {kind['shift']} s shift\")\r\n    67\t        if crates > kind[\"capacity\"]:\r\n    68\t            raise PlanError(f\"{where}: {crates} crates on a vehicle that carries {kind['capacity']}\")\r\n    69\t        if kind[\"range\"] is not None and driven > kind[\"range\"]:\r\n    70\t            raise PlanError(f\"{where}: drives {driven} units, beyond its range of {kind['range']}\")\r\n    71\t        total += kind[\"fixed\"] + kind[\"per_unit\"] * driven\r\n    72\t    for name, count in used.items():\r\n    73\t        if count > fleet[name][\"count\"]:\r\n    74\t            raise PlanError(f\"{count} routes use a {name}; only {fleet[name]['count']} are available\")\r\n    75\t    missing = sorted(set(customers) - served)\r\n    76\t    if missing:\r\n    77\t        raise PlanError(f\"{len(missing)} customers get no delivery, first {missing[:5]}\")\r\n    78\t    return total\r\n    7"]
[103.233954, "o", "9\t\r\n    80\t\r\n    81\tdef main(argv):\r\n    82\t    if len(argv) != 3:\r\n    83\t        sys.exit(__doc__)\r\n    84\t    with open(argv[1]) as fh:\r\n    85\t        orders = json.load(fh)\r\n    86\t    with open(argv[2]) as fh:\r\n    87\t        plan = json.load(fh)\r\n    88\t    try:\r\n    89\t        cost = evaluate(orders, plan)\r\n    90\t    except PlanError as exc:\r\n    91\t        print(f\"INFEASIBLE: {exc}\")\r\n    92\t        return 1\r\n    93\t    print(f\"feasible, cost {cost}\")\r\n    94\t    return 0\r\n    95\t\r\n    96\t\r\n    97\tif __name__ == \"__main__\":\r\n    98\t    sys.exit(main(sys.argv))\r\n"]
