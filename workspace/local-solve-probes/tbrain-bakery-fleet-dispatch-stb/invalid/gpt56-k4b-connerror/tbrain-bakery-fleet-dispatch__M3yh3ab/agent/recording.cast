[3075.525049, "i", "mkdir -p /app/multi; python3 - <<'PY'\nimport json,shutil\nnames=['harbour-lanes','old-town','riverside','north-ring']\nfor n in names:\n for k in range(4):\n  a=f'{n}-m{k}';o=json.load(open(f'/app/orders/{n}.json'));o['name']=a\n  json.dump(o,open(f'/app/orders/{a}.json','w'));shutil.copy(f'/app/plans/{n}.json',f'/app/plans/{a}.json')\nfor k,seed in enumerate([314159,271828,161803,141421]):\n s=open('/app/fixed_reloc.py').read().replace('48271+sum(map(ord,name))',f'{seed}+sum(map(ord,name))')\n open(f'/app/multi/reloc{k}.py','w').write(s)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do for k in 0 1 2 3; do (python3 /app/multi/reloc$k.py $n-m$k 300 > /app/multi/$n-$k.log 2>&1) & done; done; wait\n"]
