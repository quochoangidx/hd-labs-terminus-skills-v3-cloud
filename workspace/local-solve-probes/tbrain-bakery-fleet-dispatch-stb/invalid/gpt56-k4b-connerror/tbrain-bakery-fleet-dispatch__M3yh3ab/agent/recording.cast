[221.112341, "i", "cat > /app/improve.py <<'PY'\nimport json,math,random,time,sys,os\n\ndef improve(name,secs):\n o=json.load(open('/app/orders/'+name+'.json')); plan=json.load(open('/app/plans/'+name+'.json'))\n dep=o['depot']; C={c['id']:c for c in o['customers']}; ids=list(C); F={f['type']:f for f in o['fleet']}\n def dst(a,b):\n  A=dep if a==0 else C[a]; B=dep if b==0 else C[b]; q=(A['x']-B['x'])**2+(A['y']-B['y'])**2; z=math.isqrt(q); return z if z*z==q else z+1\n D={(a,b):dst(a,b) for a in [0]+ids for b in [0]+ids if a!=b}\n def inf(s,t):\n  if not s:return (0,dep['open'],0)\n  k=F[t]; load=sum(C[x]['demand'] for x in s)\n  if load>k['capacity']:return None\n  dd=D[0,s[0]]+sum(D[a,b] for a,b in zip(s,s[1:]))+D[s[-1],0]\n  if k['range'] is not None and dd>k['range']:return None\n  # derive latest departure, then verify forwards\n  lim=dep['close']-D[s[-1],0]*k['pace']\n  for i in range(len(s)-1,-1,-1):\n   c=C[s[i]]; st=min(c['due'],lim-c['service'])\n   if st<c['ready']:return None\n   lim=st-(D[0,s[i]] if i==0 else D[s[i-1],s[i]])*k['pace']"]
[221.11343, "o", "cat > /app/improve.py <<'PY'\r\n\u001b[?2004l\r"]
[221.113473, "i", "\n  leave=max(dep['open'],lim); clock=leave; prev=0\n  for x in s:\n   c=C[x]; clock=max(clock+D[prev,x]*k['pace'],c['ready'])\n   if clock>c['due']:return None\n   clock+=c['service']; prev=x\n  clock+=D[prev,0]*k['pace']\n  if clock>dep['close'] or clock-leave>k['shift']:return None\n  return (k['fixed']+dd*k['per_unit'],int(leave),load)\n # slots, retaining input assignments\n routes=[r['stops'][:] for r in plan['routes']]; types=[r['type'] for r in plan['routes']]\n for t,k in F.items():\n  for _ in range(k['count']-types.count(t)):routes.append([]);types.append(t)\n meta=[inf(s,t) for s,t in zip(routes,types)]; score=sum(x[0] for x in meta)\n best=score; bestR=[x[:] for x in routes]; bestM=meta[:]\n rng=random.Random(12345+sum(map(ord,name))); start=time.time(); it=0; accepted=0\n while time.time()-start<secs:\n  elapsed=(time.time()-start)/secs\n  # repeated cooling cycles avoid permanent freezing\n  phase=(it%250000)/250000; temp=3500*(1-phase)**2+25\n  it+=1\n  move=rng.random()\n  if move<.62:\n   non=[i for i,s in enumera"]
