[3907.866494, "i", "python3 - <<'PY'\nimport json,sys,shutil,collections\nsys.path.insert(0,'/app/tools');from check_plan import evaluate\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json')); candidates=[('/app/plans/'+n+'.json',json.load(open('/app/plans/'+n+'.json')))]\n for k in range(4): candidates.append((f'/app/plans/{n}-m{k}.json',json.load(open(f'/app/plans/{n}-m{k}.json'))))\n vals=[(evaluate(o,p),path,p) for path,p in candidates]; cost,path,p=min(vals)\n json.dump(p,open('/app/plans/'+n+'.json','w'),indent=1)\n print(n,'candidates',[x[0] for x in vals],'kept',cost,collections.Counter(r['type'] for r in p['routes']))\nPY\nfor n in harbour-lanes old-town riverside north-ring; do printf '%-16s ' \"$n\"; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
[3907.868041, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[3907.871655, "o", "\u001b[?2004h> import json,sys,shutil,collections\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0,'/app/tools');from check_plan import evaluate\r\n\u001b[?2004l\r\u001b[?2004h> for n in ['harbour-lanes','old-town','riverside','north-ring']:\r\n\u001b[?2004l\r\u001b[?2004h>  o=json.load(open('/app/orders/'+n+'.json')); candidates=[('/app/plans/'+n+'.json',json.load(open('/app/plans/'+n+'.json')))]\r\n\u001b[?2004l\r\u001b[?2004h>  for k in range(4): candidates.append((f'/app/plans/{n}-m{k}.json',json.load(open(f'/app/plans/{n}-m{k}.json'))))\r\n\u001b[?2004l\r\u001b[?2004h>  vals=[(evaluate(o,p),path,p) for path,p in candidates]; cost,path,p=min(vals)\r\n\u001b[?2004l\r\u001b[?2004h>  json.dump(p,open('/app/plans/'+n+'.json','w'),indent=1)\r\n\u001b[?2004l\r\u001b[?2004h>  print(n,'candidates',[x[0] for x in vals],'kept',cost,collections.Counter(r['type'] for r in p['routes']))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
