[19.726063, "i", "python3 - <<'PY'\nimport json,collections,math\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json')); cs=o['customers']\n print('\\n',n,'customers',len(cs),'demand',sum(c['demand'] for c in cs))\n print('windows',sorted(collections.Counter((c['ready'],c['due']) for c in cs).items()))\n print('demand bands',collections.Counter('bike' if c['demand']<=14 else 'van' if c['demand']<=60 else 'truck' for c in cs))\n p=json.load(open('/app/plans/'+n+'.json'))\n print('baseline routes',collections.Counter(r['type'] for r in p['routes']),'served',sum(map(lambda r:len(r['stops']),p['routes'])))\nPY\n"]
