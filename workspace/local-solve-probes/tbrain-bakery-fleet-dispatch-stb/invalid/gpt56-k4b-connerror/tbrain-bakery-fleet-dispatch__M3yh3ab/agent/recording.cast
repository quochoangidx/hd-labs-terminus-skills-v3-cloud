[2011.312385, "i", "python3 - <<'PY'\nimport json,collections,sys,shutil\nsys.path.insert(0,'/app/tools');from check_plan import evaluate\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json'));p=json.load(open('/app/plans/'+n+'.json'));b=json.load(open('/app/backup/'+n+'.json'));cp=evaluate(o,p);cb=evaluate(o,b)\n if cb<cp:shutil.copy('/app/backup/'+n+'.json','/app/plans/'+n+'.json');p=b;cp=cb\n print(n,collections.Counter(r['type'] for r in p['routes']),cp)\nPY\n"]
