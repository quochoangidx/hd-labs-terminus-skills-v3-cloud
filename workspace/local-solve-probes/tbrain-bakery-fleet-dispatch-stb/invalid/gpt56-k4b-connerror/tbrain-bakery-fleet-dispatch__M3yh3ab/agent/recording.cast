[2794.361543, "i", "python3 - <<'PY'\ns=open('/app/descent.py').read()\n# Identify the least-loaded truck after metadata initialization and penalize its remaining load.\ns=s.replace(\"M=[info(s,t) for s,t in zip(R,T)];score=sum(m[0] for m in M);best=score\", \"M=[info(s,t) for s,t in zip(R,T)]; target=min((i for i,t in enumerate(T) if t=='truck' and R[i]),key=lambda i:M[i][2]); PEN=10000; score=sum(m[0] for m in M)+PEN*M[target][2];best=score\")\ns=s.replace(\"delta=ma[0]+mb[0]-M[a][0]-M[b][0]\", \"delta=ma[0]+mb[0]-M[a][0]-M[b][0]+PEN*((ma[2]-M[a][2] if a==target else 0)+(mb[2]-M[b][2] if b==target else 0))\")\n# Do not append additional empty fleet slots; only redistribute among currently active routes.\ns=s.replace(\"for t,k in F.items():\\n for _ in range(k['count']-T.count(t)):R.append([]);T.append(t)\", \"pass\")\n# Skip final 2-opt accounting, whose score excludes the temporary penalty; write the evacuated best directly.\npos=s.index(\"# Final exhaustive feasible 2-opt until stable.\")\nend=s.index(\"out={'routes'\",pos)\ns=s[:pos]+\"# Temporary obj"]
[2794.362736, "i", "ective complete.\\n\"+s[end:]\nopen('/app/evacuate.py','w').write(s)\nPY\npython3 -m py_compile /app/evacuate.py\ncp /app/plans/riverside.json /app/river-pre-evac.json; cp /app/plans/north-ring.json /app/north-pre-evac.json\n# Independent relocation seeds for small instances.\nsed 's/48271+sum(map(ord,name))/137111+sum(map(ord,name))/' /app/fixed_reloc.py > /app/fixed_reloc2.py\n(python3 /app/evacuate.py riverside 240 > /app/evac-river.log 2>&1) &\n(python3 /app/evacuate.py north-ring 240 > /app/evac-north.log 2>&1) &\n(python3 /app/fixed_reloc2.py harbour-lanes 240 > /app/reloc2-harbour.log 2>&1) &\n(python3 /app/fixed_reloc2.py old-town 240 > /app/reloc2-old.log 2>&1) &\nwait\n"]
[2794.362772, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> s=open('/app/descent.py').read()\r\n\u001b[?2004l\r"]
[2794.363987, "o", "\u001b[?2004h> # Identify the least-loaded truck after metadata initialization and penalize its remaining load.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2794.3648, "o", "s=s.replace(\"M=[info(s,t) for s,t in zip(R,T)];score=sum(m[0] for m in M);best=score\", \"M=[info(s,t) for s,t in zip(R,T)]; target=min((i for i,t in enumerate(T) if t=='truck' and R[i]),key=lambda i:M[i][2]); PEN=10000; score=sum(m[0] for m in M)+PEN*M[target][2];best=score\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"delta=ma[0]+mb[0]-M[a][0]-M[b][0]\", \"delta=ma[0]+mb[0]-M[a][0]-M[b][0]+PEN*((ma[2]-M[a][2] if a==target else 0)+(mb[2]-M[b][2] if b==target else 0))\")\r\n\u001b[?2004l\r\u001b[?2004h> # Do not append additional empty fleet slots; only redistribute among currently active routes.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"for t,k in F.items():\\n for _ in range(k['count']-T.count(t)):R.append([]);T.append(t)\", \"pass\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[2794.365157, "o", "# Skip final 2-opt accounting, whose score excludes the temporary penalty; write the evacuated best directly.\r\n\u001b[?2004l\r\u001b[?2004h> pos=s.index(\"# Final exhaustive feasible 2-opt until stable.\")\r\n\u001b[?2004l\r"]
[2794.365501, "o", "\u001b[?2004h> end=s.index(\"out={'routes'\",pos)\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:pos]+\"# Temporary objective complete.\\n\"+s[end:]\r\n\u001b[?2004l\r\u001b[?2004h> open('/app/evacuate.py','w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
