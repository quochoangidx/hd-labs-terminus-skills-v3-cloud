[703.86746, "i", "cat > /app/descent.py <<'PY'\n# Deterministic/random segment-exchange descent using improve.py's feasibility logic pattern.\nimport json,math,random,time,sys\nname=sys.argv[1]; secs=float(sys.argv[2]); o=json.load(open('/app/orders/'+name+'.json')); p=json.load(open('/app/plans/'+name+'.json'))\ndep=o['depot'];C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']}; ids=list(C)\ndef dst(a,b):\n A=dep if a==0 else C[a];B=dep if b==0 else C[b];q=(A['x']-B['x'])**2+(A['y']-B['y'])**2;z=math.isqrt(q);return z if z*z==q else z+1\nD={(a,b):dst(a,b) for a in [0]+ids for b in [0]+ids if a!=b}\ndef info(s,t):\n if not s:return (0,dep['open'],0)\n k=F[t];load=sum(C[x]['demand'] for x in s)\n if load>k['capacity']:return None\n dd=D[0,s[0]]+sum(D[a,b] for a,b in zip(s,s[1:]))+D[s[-1],0]\n if k['range'] is not None and dd>k['range']:return None\n lim=dep['close']-D[s[-1],0]*k['pace']\n for i in range(len(s)-1,-1,-1):\n  c=C[s[i]];st=min(c['due'],lim-c['service'])\n  if st<c['ready']:return None\n  lim=st-(D[0,s[i]] if i="]
[703.867824, "i", "=0 else D[s[i-1],s[i]])*k['pace']\n leave=max(dep['open'],lim);clock=leave;prev=0\n for x in s:\n  c=C[x];clock=max(clock+D[prev,x]*k['pace'],c['ready'])\n  if clock>c['due']:return None\n  clock+=c['service'];prev=x\n clock+=D[prev,0]*k['pace']\n if clock>dep['close'] or clock-leave>k['shift']:return None\n return F[t]['fixed']+dd*F[t]['per_unit'],int(leave),load\nR=[r['stops'][:] for r in p['routes']];T=[r['type'] for r in p['routes']]\nfor t,k in F.items():\n for _ in range(k['count']-T.count(t)):R.append([]);T.append(t)\nM=[info(s,t) for s,t in zip(R,T)];score=sum(m[0] for m in M);best=score;rng=random.Random(991+sum(map(ord,name)));start=time.time();it=0\nwhile time.time()-start<secs:\n it+=1;a,b=rng.sample(range(len(R)),2)\n if not R[a]:continue\n # Exchange segments of length 0..3 (0 means relocation), favor short segments.\n la=rng.randint(1,min(3,len(R[a]))); ia=rng.randrange(len(R[a])-la+1); Aseg=R[a][ia:ia+la]\n lb=0 if rng.random()<.45 or not R[b] else rng.randint(1,min(3,len(R[b])))\n ib=rng.randrange(len(R[b])-lb+"]
[703.86785, "i", "1) if lb else rng.randrange(len(R[b])+1); Bseg=R[b][ib:ib+lb]\n loadA=M[a][2]-sum(C[x]['demand'] for x in Aseg)+sum(C[x]['demand'] for x in Bseg)\n loadB=M[b][2]-sum(C[x]['demand'] for x in Bseg)+sum(C[x]['demand'] for x in Aseg)\n if loadA>F[T[a]]['capacity'] or loadB>F[T[b]]['capacity']:continue\n # Test both orientations of exchanged segments.\n bestmove=None\n for sa in (Aseg,Aseg[::-1]):\n  for sb in (Bseg,Bseg[::-1]):\n   na=R[a][:ia]+sb+R[a][ia+la:]; nb=R[b][:ib]+sa+R[b][ib+lb:]\n   ma=info(na,T[a]);mb=info(nb,T[b])\n   if ma and mb:\n    delta=ma[0]+mb[0]-M[a][0]-M[b][0]\n    if bestmove is None or delta<bestmove[0]:bestmove=(delta,na,nb,ma,mb)\n if bestmove and bestmove[0]<0:\n  delta,R[a],R[b],M[a],M[b]=bestmove;score+=delta\n  if score<best:best=score;print(name,it,best,flush=True)\n# Final exhaustive feasible 2-opt until stable.\nchanged=True\nwhile changed:\n changed=False\n for a,s in enumerate(R):\n  for i in range(len(s)):\n   for j in range(i+1,len(s)):\n    ns=s[:i]+s[i:j+1][::-1]+s[j+1:];m=info(ns,T[a])\n    if m "]
[703.867855, "i", "and m[0]<M[a][0]:R[a]=s=ns;score+=m[0]-M[a][0];M[a]=m;changed=True\nout={'routes':[{'type':t,'depart':m[1],'stops':s} for s,t,m in zip(R,T,M) if s]};json.dump(out,open('/app/plans/'+name+'.json','w'),indent=1);print(name,'final',score,it)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /app/descent.py $n 40; done\n"]
