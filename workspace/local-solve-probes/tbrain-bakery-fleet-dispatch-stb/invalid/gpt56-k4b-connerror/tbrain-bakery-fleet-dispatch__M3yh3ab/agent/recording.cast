[894.759596, "i", "python3 - <<'PY'\ns=open('/app/descent.py').read()\n# Replace strict descent loop setup with annealing state.\ns=s.replace(\"start=time.time();it=0\\nwhile time.time()-start<secs:\", \"start=time.time();it=0; bestR=[x[:] for x in R];bestM=M[:]\\nwhile time.time()-start<secs:\")\ns=s.replace(\"la=rng.randint(1,min(3,len(R[a])))\", \"la=rng.randint(1,min(4,len(R[a])))\")\ns=s.replace(\"rng.randint(1,min(3,len(R[b])))\", \"rng.randint(1,min(4,len(R[b])))\")\nold=\"if bestmove and bestmove[0]<0:\\n  delta,R[a],R[b],M[a],M[b]=bestmove;score+=delta\\n  if score<best:best=score;print(name,it,best,flush=True)\"\nnew=\"\"\"if bestmove:\n  delta,na,nb,ma,mb=bestmove\n  phase=((time.time()-start)/secs*8)%1; temp=1200*(1-phase)**3+1\n  if delta<0 or rng.random()<math.exp(-delta/temp):\n   R[a],R[b],M[a],M[b]=na,nb,ma,mb;score+=delta\n   if score<best:\n    best=score;bestR=[x[:] for x in R];bestM=M[:]\n    if best%200<10:print(name,it,best,flush=True)\"\"\"\ns=s.replace(old,new)\n# Restore best before deterministic final descent.\ns=s.replace(\"# Final exhaustiv"]
[894.761782, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> s=open('/app/descent.py').read()\r\n\u001b[?2004l\r\u001b[?2004h> # Replace strict descent loop setup with annealing state.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"start=time.time();it=0\\nwhile time.time()-start<secs:\", \"start=time.time();it=0; bestR=[x[:] for x in R];bestM=M[:]\\nwhile time.time()-start<secs:\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"la=rng.randint(1,min(3,len(R[a])))\", \"la=rng.randint(1,min(4,len(R[a])))\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"rng.randint(1,min(3,len(R[b])))\", \"rng.randint(1,min(4,len(R[b])))\")\r\n\u001b[?2004l\r\u001b[?2004h> old=\"if bestmove and bestmove[0]<0:\\n  delta,R[a],R[b],M[a],M[b]=bestmove;score+=delta\\n  if score<best:best=score;print(name,it,best,flush=True)\"\r\n\u001b[?2004l\r\u001b[?2004h> new=\"\"\"if bestmove:\r\n\u001b[?2004l\r\u001b[?2004h>   delta,na,nb,ma,mb=bestmove\r\n\u001b[?2004l\r\u001b[?2004h>   phase=((time.time()-start)/secs*8)%1; temp=1200*(1-phase)**3+1\r\n\u001b[?2004l\r\u001b[?2004h>   if delta<0 or rng.random()<math.exp(-delta/temp):\r\n\u001b[?2004l\r"]
[894.761829, "i", "e feasible 2-opt until stable.\\nchanged=True\", \"R=[x[:] for x in bestR];M=bestM[:];score=best\\n# Final exhaustive feasible 2-opt until stable.\\nchanged=True\")\nopen('/app/segment_anneal.py','w').write(s)\nPY\npython3 -m py_compile /app/segment_anneal.py\nfor n in harbour-lanes old-town riverside north-ring; do (python3 /app/segment_anneal.py $n 120 > /app/$n.log 2>&1) & done; wait\n"]
[894.761887, "o", "\u001b[?2004h>    R[a],R[b],M[a],M[b]=na,nb,ma,mb;score+=delta\r\n\u001b[?2004l\r\u001b[?2004h> "]
[894.762051, "o", "   if score<best:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[894.76214, "o", "    best=score;bestR=[x[:] for x in R];bestM=M[:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[894.762154, "o", "> "]
