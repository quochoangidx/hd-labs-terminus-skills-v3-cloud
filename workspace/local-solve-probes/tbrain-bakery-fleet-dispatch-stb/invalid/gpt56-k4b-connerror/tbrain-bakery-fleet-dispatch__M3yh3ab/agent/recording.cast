[703.874317, "o", "  c=C[s[i]];st=min(c['due'],lim-c['service'])\r\n\u001b[?2004l\r\u001b[?2004h>   if st<c['ready']:return None\r\n\u001b[?2004l\r\u001b[?2004h>   lim=st-(D[0,s[i]] if i==0 else D[s[i-1],s[i]])*k['pace']\r\n\u001b[?2004l\r\u001b[?2004h>  leave=max(dep['open'],lim);clock=leave;prev=0\r\n\u001b[?2004l\r\u001b[?2004h>  for x in s:\r\n\u001b[?2004l\r\u001b[?2004h>   c=C[x];clock=max(clock+D[prev,x]*k['pace'],c['ready'])\r\n\u001b[?2004l\r\u001b[?2004h>   if clock>c['due']:return None\r\n\u001b[?2004l\r\u001b[?2004h>   clock+=c['service'];prev=x\r\n\u001b[?2004l\r\u001b[?2004h>  clock+=D[prev,0]*k['pace']\r\n\u001b[?2004l\r\u001b[?2004h>  if clock>dep['close'] or clock-leave>k['shift']:return None\r\n\u001b[?2004l\r\u001b[?2004h>  return F[t]['fixed']+dd*F[t]['per_unit'],int(leave),load\r\n\u001b[?2004l\r\u001b[?2004h> R=[r['stops'][:] for r in p['routes']];T=[r['type'] for r in p['routes']]\r\n\u001b[?2004l\r\u001b[?2004h> for t,k in F.items():\r\n\u001b[?2004l\r\u001b[?2004h>  for _ in range(k['count']-T.count(t)):R.append([]);T.append(t)\r\n\u001b[?2004l\r\u001b[?2004h> M=[info(s,t) for s,t in zip(R,T)];score=sum(m[0] for m in M);best=score;rng=random.Random(991+sum(map(ord,name)));start=tim"]
[703.874335, "o", "e.time();it=0\r\n\u001b[?2004l\r\u001b[?2004h> while time.time()-start<secs:\r\n\u001b[?2004l\r"]
[703.8766, "o", "\u001b[?2004h>  it+=1;a,b=rng.sample(range(len(R)),2)\r\n\u001b[?2004l\r\u001b[?2004h>  if not R[a]:continue\r\n\u001b[?2004l\r\u001b[?2004h>  # Exchange segments of length 0..3 (0 means relocation), favor short segments.\r\n\u001b[?2004l\r\u001b[?2004h>  la=rng.randint(1,min(3,len(R[a]))); ia=rng.randrange(len(R[a])-la+1); Aseg=R[a][ia:ia+la]\r\n\u001b[?2004l\r\u001b[?2004h>  lb=0 if rng.random()<.45 or not R[b] else rng.randint(1,min(3,len(R[b])))\r\n\u001b[?2004l\r\u001b[?2004h>  ib=rng.randrange(len(R[b])-lb+1) if lb else rng.randrange(len(R[b])+1); Bseg=R[b][ib:ib+lb]\r\n\u001b[?2004l\r\u001b[?2004h>  loadA=M[a][2]-sum(C[x]['demand'] for x in Aseg)+sum(C[x]['demand'] for x in Bseg)\r\n\u001b[?2004l\r\u001b[?2004h>  loadB=M[b][2]-sum(C[x]['demand'] for x in Bseg)+sum(C[x]['demand'] for x in Aseg)\r\n\u001b[?2004l\r\u001b[?2004h>  if loadA>F[T[a]]['capacity'] or loadB>F[T[b]]['capacity']:continue\r\n\u001b[?2004l\r\u001b[?2004h>  # Test both orientations of exchanged segments.\r\n\u001b[?2004l\r\u001b[?2004h>  bestmove=None\r\n\u001b[?2004l\r\u001b[?2004h>  for sa in (Aseg,Aseg[::-1]):\r\n\u001b[?2004l\r\u001b[?2004h>   for sb in (Bseg,Bseg[::-1]):\r\n\u001b[?2004l\r\u001b[?20"]
[703.877308, "o", "04h>    na=R[a][:ia]+sb+R[a][ia+la:]; nb=R[b][:ib]+sa+R[b][ib+lb:]\r\n\u001b[?2004l\r\u001b[?2004h>    ma=info(na,T[a]);mb=info(nb,T[b])\r\n\u001b[?2004l\r\u001b[?2004h>    if ma and mb:\r\n\u001b[?2004l\r\u001b[?2004h>     delta=ma[0]+mb[0]-M[a][0]-M[b][0]\r\n\u001b[?2004l\r\u001b[?2004h>     if bestmove is None or delta<bestmove[0]:bestmove=(delta,na,nb,ma,mb)\r\n\u001b[?2004l\r\u001b[?2004h>  if bestmove and bestmove[0]<0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[703.878615, "o", "  delta,R[a],R[b],M[a],M[b]=bestmove;score+=delta\r\n\u001b[?2004l\r\u001b[?2004h>   if score<best:best=score;print(name,it,best,flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> # Final exhaustive feasible 2-opt until stable.\r\n\u001b[?2004l\r\u001b[?2004h> changed=True\r\n\u001b[?2004l\r\u001b[?2004h> while changed:\r\n\u001b[?2004l\r\u001b[?2004h>  changed=False\r\n\u001b[?2004l\r\u001b[?2004h>  for a,s in enumerate(R):\r\n\u001b[?2004l\r\u001b[?2004h>   for i in range(len(s)):\r\n\u001b[?2004l\r\u001b[?2004h>    for j in range(i+1,len(s)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[703.879529, "o", ">     ns=s[:i]+s[i:j+1][::-1]+s[j+1:];m=info(ns,T[a])\r\n\u001b[?2004l\r\u001b[?2004h>     if m and m[0]<M[a][0]:R[a]=s=ns;score+=m[0]-M[a][0];M[a]=m;changed=True\r\n\u001b[?2004l\r\u001b[?2004h> out={'routes':[{'type':t,'depart':m[1],'stops':s} for s,t,m in zip(R,T,M) if s]};json.dump(out,open('/app/plans/'+name+'.json','w'),indent=1);print(name,'final',score,it)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
