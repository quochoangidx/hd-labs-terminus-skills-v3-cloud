[1532.454867, "i", "python3 - <<'PY'\ns=open('/app/segment_anneal.py').read()\n# Do not append unused fleet slots: optimize exactly the active composition.\na=\"for t,k in F.items():\\n for _ in range(k['count']-T.count(t)):R.append([]);T.append(t)\"\ns=s.replace(a,\"pass\")\n# Forbid moves which empty an active route.\ns=s.replace(\"ma=info(na,T[a]);mb=info(nb,T[b])\", \"ma=info(na,T[a]) if na else None;mb=info(nb,T[b]) if nb else None\")\n# Lower temperature for mileage refinement in a fixed fleet basin.\ns=s.replace(\"temp=1200*(1-phase)**3+1\", \"temp=450*(1-phase)**3+.2\")\nopen('/app/fixedfleet.py','w').write(s)\nPY\npython3 -m py_compile /app/fixedfleet.py\npython3 - <<'PY'\nimport json,collections\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n p=json.load(open('/app/plans/'+n+'.json'));print(n,collections.Counter(r['type'] for r in p['routes']))\nPY\nfor n in harbour-lanes old-town riverside north-ring; do (python3 /app/fixedfleet.py $n 180 > /app/fixed-$n.log 2>&1) & done; wait\n"]
