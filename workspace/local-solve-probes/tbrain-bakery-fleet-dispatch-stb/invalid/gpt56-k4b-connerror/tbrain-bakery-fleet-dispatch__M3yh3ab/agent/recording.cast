[2446.172787, "i", "python3 - <<'PY'\ns=open('/app/improve.py').read()\n# Work with exactly active routes and forbid emptying any route.\ns=s.replace(\"for t,k in F.items():\\n  for _ in range(k['count']-types.count(t)):routes.append([]);types.append(t)\", \"pass\")\ns=s.replace(\"nsA=routes[a][:ia]+routes[a][ia+1:]; ma=inf(nsA,types[a])\", \"nsA=routes[a][:ia]+routes[a][ia+1:]; ma=inf(nsA,types[a]) if nsA else None\")\n# Time-based repeated cooling and a different seed.\ns=s.replace(\"rng=random.Random(12345+sum(map(ord,name)))\", \"rng=random.Random(48271+sum(map(ord,name)))\")\ns=s.replace(\"phase=(it%250000)/250000; temp=3500*(1-phase)**2+25\", \"phase=((time.time()-start)/secs*10)%1; temp=500*(1-phase)**3+.1\")\n# Search every destination route rather than only a proximity shortlist.\ns=s.replace(\"candidates.sort(); b=rng.choice(candidates[:min(8,len(candidates))])[1]\", \"candidates.sort(); b=rng.choice(candidates[:min(len(candidates),20)])[1]\")\nopen('/app/fixed_reloc.py','w').write(s)\nPY\npython3 -m py_compile /app/fixed_reloc.py\npython3 - <<'PY'\nimp"]
[2446.17456, "i", "ort json,collections\nfor n in ['riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json'));C={c['id']:c for c in o['customers']};p=json.load(open('/app/plans/'+n+'.json'));F={f['type']:f for f in o['fleet']}\n print('\\n',n,'total demand',sum(c['demand'] for c in C.values()))\n for t in ['bike','van','truck']:\n  loads=sorted(sum(C[x]['demand'] for x in r['stops']) for r in p['routes'] if r['type']==t)\n  print(t,loads,'spare',len(loads)*F[t]['capacity']-sum(loads))\nPY\ncp /app/plans/harbour-lanes.json /app/harbour-before.json; cp /app/plans/old-town.json /app/old-before.json\n(python3 /app/fixed_reloc.py harbour-lanes 300 > /app/reloc-harbour.log 2>&1) & (python3 /app/fixed_reloc.py old-town 300 > /app/reloc-old.log 2>&1) & wait\n"]
