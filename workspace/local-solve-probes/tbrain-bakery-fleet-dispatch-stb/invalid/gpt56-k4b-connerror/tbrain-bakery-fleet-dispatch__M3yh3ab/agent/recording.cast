[77.703994, "i", "eta[r]=z; un.remove(x)\n        if any(not s for s in routes):\n            # Empty vehicles are harmless, but should not normally occur.\n            pass\n        cost=sum((kinds[t]['fixed']+m[0]*kinds[t]['per_unit']) for s,t,m in zip(routes,vehicle_types,meta) if s)\n        return cost,routes,meta\n\n    best=None; start=time.time(); it=0\n    while time.time()-start<seconds:\n        z=build(random.Random(7919*it+hash(o['name'])%100000)); it+=1\n        if z and (best is None or z[0]<best[0]):\n            best=z; print(o['name'],'iteration',it,'cost',z[0],flush=True)\n    if best is None: raise RuntimeError('no construction')\n    cost,routes,meta=best\n    plan={'routes':[{'type':t,'depart':int(m[1]),'stops':s} for s,t,m in zip(routes,vehicle_types,meta) if s]}\n    os.makedirs(os.path.dirname(out),exist_ok=True); json.dump(plan,open(out,'w'),indent=1)\n    print(o['name'],'final',cost,'iterations',it)\n\nif __name__=='__main__': solve(sys.argv[1],sys.argv[2],float(sys.argv[3]) if len(sys.argv)>3 else 12)\nPY\nfor n in ha"]
