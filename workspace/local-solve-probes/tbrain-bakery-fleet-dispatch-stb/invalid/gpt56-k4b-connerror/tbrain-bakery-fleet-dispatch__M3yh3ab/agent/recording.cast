[2035.961802, "i", "mkdir -p /app/best2; cp /app/plans/*.json /app/best2/; python3 - <<'PY'\n# New seeds for hard fleet forcing.\ns=open('/app/hardforce.py').read().replace('991+sum(map(ord,name))','7349+sum(map(ord,name))')\ns=s.replace(\"'truck':400000\", \"'truck':1000000\")\nopen('/app/hardforce2.py','w').write(s)\n# Add single-route arbitrary swaps by increasing frequency of same-route segment permutations:\ns=open('/app/fixedfleet.py').read().replace('991+sum(map(ord,name))','9127+sum(map(ord,name))')\n# Allow a=b, making segment replacement/reversal inside a route difficult in existing code, so retain interroute engine;\n# lower temperature further for intensive local mileage optimization.\ns=s.replace(\"temp=450*(1-phase)**3+.2\", \"temp=180*(1-phase)**3+.05\")\nopen('/app/fixedfleet2.py','w').write(s)\nPY\nfor n in riverside north-ring; do (python3 /app/hardforce2.py $n 360 > /app/hard2-$n.log 2>&1) & done\nfor n in harbour-lanes old-town; do (python3 /app/fixedfleet2.py $n 360 > /app/fixed2-$n.log 2>&1) & done\nwait\n"]
[2035.966069, "o", "mkdir -p /app/best2; cp /app/plans/*.json /app/best2/; python3 - <<'PY'\r\n\u001b[?2004l\r"]
[2035.968478, "o", "\u001b[?2004h> # New seeds for hard fleet forcing.\r\n\u001b[?2004l\r\u001b[?2004h> s=open('/app/hardforce.py').read().replace('991+sum(map(ord,name))','7349+sum(map(ord,name))')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"'truck':400000\", \"'truck':1000000\")\r\n\u001b[?2004l\r\u001b[?2004h> open('/app/hardforce2.py','w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> # Add single-route arbitrary swaps by increasing frequency of same-route segment permutations:\r\n\u001b[?2004l\r\u001b[?2004h> s=open('/app/fixedfleet.py').read().replace('991+sum(map(ord,name))','9127+sum(map(ord,name))')\r\n\u001b[?2004l\r\u001b[?2004h> # Allow a=b, making segment replacement/reversal inside a route difficult in existing code, so retain interroute engine;\r\n\u001b[?2004l\r\u001b[?2004h> # lower temperature further for intensive local mileage optimization.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"temp=450*(1-phase)**3+.2\", \"temp=180*(1-phase)**3+.05\")\r\n\u001b[?2004l\r\u001b[?2004h> open('/app/fixedfleet2.py','w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
