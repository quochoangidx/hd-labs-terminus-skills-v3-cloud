[155.630118, "i", "cat > /app/greedies.py <<'PY'\nimport json,math,itertools,random,os,sys\nfrom pathlib import Path\nsys.path.insert(0,'/app/tools'); from check_plan import distance,evaluate\n\ndef make(o,order,mode,seed):\n d=o['depot']; left={c['id']:c for c in o['customers']}; routes=[]; rng=random.Random(seed)\n fs={f['type']:f for f in o['fleet']}\n for typ in order:\n  k=fs[typ]\n  for z in range(k['count']):\n   if not left: break\n   clock=d['open']; here=d; load=driven=0; stops=[]\n   while 1:\n    opts=[]\n    for c in left.values():\n     leg=distance(here,c); st=max(clock+leg*k['pace'],c['ready'])\n     tot=driven+leg+distance(c,d); back=st+c['service']+distance(c,d)*k['pace']\n     if load+c['demand']>k['capacity'] or st>c['due'] or back>d['close'] or back-d['open']>k['shift'] or (k['range'] is not None and tot>k['range']): continue\n     if mode==0: score=leg\n     elif mode==1: score=leg+.03*max(0,c['ready']-(clock+leg*k['pace']))\n     elif mode==2: score=c['due']+.8*leg*k['pace']\n     elif mode==3: score=leg-2*c['demand']+rng.rand"]
[155.630466, "i", "om()*30\n     else: score=c['due']+.3*leg*k['pace']+rng.random()*900\n     opts.append((score,c,leg,st))\n    if not opts: break\n    _,c,leg,st=min(opts,key=lambda x:x[0]); stops.append(c['id']); load+=c['demand']; driven+=leg; clock=st+c['service']; here=c; del left[c['id']]\n   if stops: routes.append({'type':typ,'depart':d['open'],'stops':stops})\n return {'routes':routes}\n\nfor name in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+name+'.json')); best=None\n # preserve any feasible current plan\n try:\n  p=json.load(open('/app/plans/'+name+'.json')); best=(evaluate(o,p),p,'existing')\n except: pass\n for order in itertools.permutations(['bike','van','truck']):\n  for mode in range(5):\n   for seed in range(4):\n    p=make(o,order,mode,seed)\n    try: cost=evaluate(o,p)\n    except: continue\n    if best is None or cost<best[0]: best=(cost,p,(order,mode,seed)); print(name,best[0],best[2],flush=True)\n if best:\n  json.dump(best[1],open('/app/plans/'+name+'.json','w'),indent=1); print"]
