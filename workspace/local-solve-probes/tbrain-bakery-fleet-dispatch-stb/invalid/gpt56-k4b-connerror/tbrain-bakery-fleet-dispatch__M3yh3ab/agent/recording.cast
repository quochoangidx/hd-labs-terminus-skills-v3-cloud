[703.872649, "o", "delta,na,nb,ma,mb)\r\n if bestmove and bestmove[0]<0:\r\n  delta,R[a],R[b],M[a],M[b]=bestmove;score+=delta\r\n  if score<best:best=score;print(name,it,best,flush=True)\r\n# Final exhaustive feasible 2-opt until stable.\r\nchanged=True\r\nwhile changed:\r\n changed=False\r\n for a,s in enumerate(R):\r\n  for i in range(len(s)):\r\n   for j in range(i+1,len(s)):\r\n    ns=s[:i]+s[i:j+1][::-1]+s[j+1:];m=info(ns,T[a])\r\n    if m and m[0]<M[a][0]:R[a]=s=ns;score+=m[0]-M[a][0];M[a]=m;changed=True\r\nout={'routes':[{'type':t,'depart':m[1],'stops':s} for s,t,m in zip(R,T,M) if s]};json.dump(out,open('/app/plans/'+name+'.json','w'),indent=1);print(name,'final',score,it)\r\nPY\r\nfor n in harbour-lanes old-town riverside north-ring; do python3 /app/descent.py $n 40; done\r\n\u001b[?2004h> dep=o['depot'];C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']}; ids=list(C)\r\n\u001b[?2004l\r\u001b[?2004h> def dst(a,b):\r\n\u001b[?2004l\r\u001b[?2004h>  A=dep if a==0 else C[a];B=dep if b==0 else C[b];q=(A['x']-B['x'])**2+(A['y']-B['y'])**2;z=math.isqrt(q);return z "]
