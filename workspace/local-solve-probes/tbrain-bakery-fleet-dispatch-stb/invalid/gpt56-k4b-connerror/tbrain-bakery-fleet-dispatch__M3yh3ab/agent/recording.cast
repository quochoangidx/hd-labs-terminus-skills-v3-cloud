[186.752995, "i", "python3 - <<'PY'\nimport json,sys,collections,math\nsys.path.insert(0,'/app/tools'); from check_plan import distance\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json')); p=json.load(open('/app/plans/'+n+'.json')); C={c['id']:c for c in o['customers']}; F={f['type']:f for f in o['fleet']}; d=o['depot']; agg=collections.defaultdict(lambda:[0,0,0,0])\n print('\\n'+n)\n for r in p['routes']:\n  s=r['stops']; dd=distance(d,C[s[0]])+sum(distance(C[a],C[b]) for a,b in zip(s,s[1:]))+distance(C[s[-1]],d); load=sum(C[x]['demand'] for x in s); a=agg[r['type']]; a[0]+=1;a[1]+=dd;a[2]+=load;a[3]+=F[r['type']]['fixed']+dd*F[r['type']]['per_unit']\n for t,a in agg.items(): print(t,'routes dist load cost',a)\n print('total routes',len(p['routes']))\nPY\n"]
