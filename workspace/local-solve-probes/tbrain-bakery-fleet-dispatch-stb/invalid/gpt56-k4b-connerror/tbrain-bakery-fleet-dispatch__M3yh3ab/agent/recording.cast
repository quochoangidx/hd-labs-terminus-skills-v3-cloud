[221.113481, "i", "te(routes) if s]; a=rng.choice(non); ia=rng.randrange(len(routes[a])); x=routes[a][ia]\n   # bias destination toward compatible nearby routes, but include empties\n   candidates=[]\n   for b,s in enumerate(routes):\n    if b==a:continue\n    if meta[b][2]+C[x]['demand']<=F[types[b]]['capacity']:\n     proximity=min([D[x,y] for y in s],default=D[0,x])\n     candidates.append((proximity+rng.random()*100,b))\n   if not candidates:continue\n   candidates.sort(); b=rng.choice(candidates[:min(8,len(candidates))])[1]\n   # test every insertion and choose near-best\n   opts=[]\n   nsA=routes[a][:ia]+routes[a][ia+1:]; ma=inf(nsA,types[a])\n   if ma is None:continue\n   for ib in range(len(routes[b])+1):\n    nsB=routes[b][:ib]+[x]+routes[b][ib:]; mb=inf(nsB,types[b])\n    if mb:opts.append((ma[0]+mb[0]-meta[a][0]-meta[b][0],ib,mb))\n   if not opts:continue\n   opts.sort(); delta,ib,mb=opts[0] if rng.random()<.8 else rng.choice(opts[:min(3,len(opts))])\n   if delta<=0 or rng.random()<math.exp(-delta/temp):\n    routes[a]=nsA;routes[b].ins"]
