[324.030128, "i", "python3 - <<'PY'\nimport json,sys,collections\nsys.path.insert(0,'/app/tools');from check_plan import distance\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json'));p=json.load(open('/app/plans/'+n+'.json')); C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};d=o['depot'];A=collections.defaultdict(lambda:[0,0,0,0])\n for r in p['routes']:\n  s=r['stops'];dd=distance(d,C[s[0]])+sum(distance(C[a],C[b]) for a,b in zip(s,s[1:]))+distance(C[s[-1]],d);load=sum(C[x]['demand'] for x in s);a=A[r['type']];a[0]+=1;a[1]+=dd;a[2]+=load;a[3]+=F[r['type']]['fixed']+dd*F[r['type']]['per_unit']\n print(n,dict(A))\nPY\n"]
[324.030633, "o", "python3 - <<'PY'"]
[324.031745, "o", "\r\n"]
[324.031759, "o", "\u001b[?2004l\r\u001b[?2004h> import json,sys,collections\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0,'/app/tools');from check_plan import distance\r\n\u001b[?2004l\r\u001b[?2004h> for n in ['harbour-lanes','old-town','riverside','north-ring']:\r\n\u001b[?2004l\r\u001b[?2004h>  o=json.load(open('/app/orders/'+n+'.json'));p=json.load(open('/app/plans/'+n+'.json')); C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};d=o['depot'];A=collections.defaultdict(lambda:[0,0,0,0])\r\n\u001b[?2004l\r\u001b[?2004h>  for r in p['routes']:\r\n\u001b[?2004l\r\u001b[?2004h>   s=r['stops'];dd=distance(d,C[s[0]])+sum(distance(C[a],C[b]) for a,b in zip(s,s[1:]))+distance(C[s[-1]],d);load=sum(C[x]['demand'] for x in s);a=A[r['type']];a[0]+=1;a[1]+=dd;a[2]+=load;a[3]+=F[r['type']]['fixed']+dd*F[r['type']]['per_unit']\r\n\u001b[?2004l\r\u001b[?2004h>  print(n,dict(A))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
