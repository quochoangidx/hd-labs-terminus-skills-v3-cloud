[77.701513, "i", "cat > /app/solve.py <<'PY'\nimport json, math, random, sys, time, os\n\ndef dist(a,b):\n    q=(a['x']-b['x'])**2+(a['y']-b['y'])**2\n    r=math.isqrt(q); return r if r*r==q else r+1\n\ndef solve(path, out, seconds=12):\n    o=json.load(open(path)); dep=o['depot']; C={c['id']:c for c in o['customers']}; ids=list(C)\n    D={(a,b):dist(dep if a==0 else C[a],dep if b==0 else C[b]) for a in [0]+ids for b in [0]+ids if a!=b}\n    kinds={f['type']:f for f in o['fleet']}\n    demand=sum(c['demand'] for c in C.values())\n    base=kinds['bike']['count']*kinds['bike']['capacity']+kinds['van']['count']*kinds['van']['capacity']\n    nt=max(0,math.ceil((demand-base)/kinds['truck']['capacity']))\n    vehicle_types=['bike']*kinds['bike']['count']+['van']*kinds['van']['count']+['truck']*nt\n\n    def info(seq, typ):\n        k=kinds[typ]\n        load=sum(C[x]['demand'] for x in seq)\n        if load>k['capacity']: return None\n        dd=D[0,seq[0]]+sum(D[a,b] for a,b in zip(seq,seq[1:]))+D[seq[-1],0]\n        if k['range'] is not None and dd>k["]
[77.702955, "i", "'range']: return None\n        # Latest departure permitting all due times and closing time.\n        t=dep['close']-D[seq[-1],0]*k['pace']\n        for i in range(len(seq)-1,-1,-1):\n            c=C[seq[i]]\n            start=min(c['due'],t-c['service'])\n            if start<c['ready']: return None\n            t=start-(D[0,seq[i]] if i==0 else D[seq[i-1],seq[i]])*k['pace']\n        depart=max(dep['open'],t)\n        # Forward verification and duration.\n        clock=depart; here=0\n        for x in seq:\n            c=C[x]; clock=max(clock+D[here,x]*k['pace'],c['ready'])\n            if clock>c['due']: return None\n            clock+=c['service']; here=x\n        clock+=D[here,0]*k['pace']\n        if clock>dep['close'] or clock-depart>k['shift']: return None\n        return dd,depart,load\n\n    def build(rng):\n        routes=[[] for _ in vehicle_types]; meta=[None]*len(routes)\n        # Tight windows and large demands first, with randomized perturbation.\n        order=ids[:]\n        rng.shuffle(order)\n        order.sort(k"]
[77.703002, "i", "ey=lambda x:(C[x]['due']+rng.randrange(-1800,1801), -C[x]['demand']))\n        un=set(order)\n        while un:\n            # Sample constrained early-due customers and use insertion regret.\n            pool=sorted(un,key=lambda x:C[x]['due'])[:min(18,len(un))]\n            if len(un)>18: pool += rng.sample(list(un-set(pool)),min(5,len(un)-18))\n            choices=[]\n            for x in pool:\n                cand=[]\n                for r,(seq,typ) in enumerate(zip(routes,vehicle_types)):\n                    if C[x]['demand']>kinds[typ]['capacity']-(meta[r][2] if meta[r] else 0): continue\n                    for p in range(len(seq)+1):\n                        ns=seq[:p]+[x]+seq[p:]\n                        z=info(ns,typ)\n                        if z:\n                            old=meta[r][0] if meta[r] else 0\n                            delta=(z[0]-old)*kinds[typ]['per_unit']\n                            # Preserve larger vehicles for demands bikes cannot carry.\n                            opp=0\n                 "]
[77.703116, "i", "           if C[x]['demand']<=14:\n                                opp={'bike':0,'van':1300,'truck':2400}[typ]\n                            elif typ=='truck': opp=900\n                            # Mild preference for filling already-open routes.\n                            openpen=250 if not seq else 0\n                            cand.append((delta+opp+openpen,r,p,z))\n                if not cand: continue\n                cand.sort(key=lambda q:q[0])\n                regret=(cand[min(3,len(cand)-1)][0]-cand[0][0]) if len(cand)>1 else 100000\n                urgency=400000/(1+len(cand))\n                choices.append((regret+urgency+rng.random()*800,cand,x))\n            if not choices: return None\n            _,cand,x=max(choices,key=lambda q:q[0])\n            # Randomized choice among the few best insertions.\n            lim=min(4,len(cand)); weights=[math.exp(-(cand[i][0]-cand[0][0])/1800) for i in range(lim)]\n            q=rng.choices(cand[:lim],weights=weights)[0]\n            _,r,p,z=q; routes[r].insert(p,x); m"]
