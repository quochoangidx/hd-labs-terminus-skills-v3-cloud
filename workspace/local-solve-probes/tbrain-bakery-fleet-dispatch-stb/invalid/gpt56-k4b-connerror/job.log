Sending keys: ["cat > /app/improve.py <<'PY'\nimport json,math,random,time,sys,os\n\ndef improve(name,secs):\n o=json.load(open('/app/orders/'+name+'.json')); plan=json.load(open('/app/plans/'+name+'.json'))\n dep=o['depot']; C={c['id']:c for c in o['customers']}; ids=list(C); F={f['type']:f for f in o['fleet']}\n def dst(a,b):\n  A=dep if a==0 else C[a]; B=dep if b==0 else C[b]; q=(A['x']-B['x'])**2+(A['y']-B['y'])**2; z=math.isqrt(q); return z if z*z==q else z+1\n D={(a,b):dst(a,b) for a in [0]+ids for b in [0]+ids if a!=b}\n def inf(s,t):\n  if not s:return (0,dep['open'],0)\n  k=F[t]; load=sum(C[x]['demand'] for x in s)\n  if load>k['capacity']:return None\n  dd=D[0,s[0]]+sum(D[a,b] for a,b in zip(s,s[1:]))+D[s[-1],0]\n  if k['range'] is not None and dd>k['range']:return None\n  # derive latest departure, then verify forwards\n  lim=dep['close']-D[s[-1],0]*k['pace']\n  for i in range(len(s)-1,-1,-1):\n   c=C[s[i]]; st=min(c['due'],lim-c['service'])\n   if st<c['ready']:return None\n   lim=st-(D[0,s[i]] if i==0 else D[s[i-1],s[i]])*k['pace']\n  leave=max(dep['open'],lim); clock=leave; prev=0\n  for x in s:\n   c=C[x]; clock=max(clock+D[prev,x]*k['pace'],c['ready'])\n   if clock>c['due']:return None\n   clock+=c['service']; prev=x\n  clock+=D[prev,0]*k['pace']\n  if clock>dep['close'] or clock-leave>k['shift']:return None\n  return (k['fixed']+dd*k['per_unit'],int(leave),load)\n # slots, retaining input assignments\n routes=[r['stops'][:] for r in plan['routes']]; types=[r['type'] for r in plan['routes']]\n for t,k in F.items():\n  for _ in range(k['count']-types.count(t)):routes.append([]);types.append(t)\n meta=[inf(s,t) for s,t in zip(routes,types)]; score=sum(x[0] for x in meta)\n best=score; bestR=[x[:] for x in routes]; bestM=meta[:]\n rng=random.Random(12345+sum(map(ord,name))); start=time.time(); it=0; accepted=0\n while time.time()-start<secs:\n  elapsed=(time.time()-start)/secs\n  # repeated cooling cycles avoid permanent freezing\n  phase=(it%250000)/250000; temp=3500*(1-phase)**2+25\n  it+=1\n  move=rng.random()\n  if move<.62:\n   non=[i for i,s in enumerate(routes) if s]; a=rng.choice(non); ia=rng.randrange(len(routes[a])); x=routes[a][ia]\n   # bias destination toward compatible nearby routes, but include empties\n   candidates=[]\n   for b,s in enumerate(routes):\n    if b==a:continue\n    if meta[b][2]+C[x]['demand']<=F[types[b]]['capacity']:\n     proximity=min([D[x,y] for y in s],default=D[0,x])\n     candidates.append((proximity+rng.random()*100,b))\n   if not candidates:continue\n   candidates.sort(); b=rng.choice(candidates[:min(8,len(candidates))])[1]\n   # test every insertion and choose near-best\n   opts=[]\n   nsA=routes[a][:ia]+routes[a][ia+1:]; ma=inf(nsA,types[a])\n   if ma is None:continue\n   for ib in range(len(routes[b])+1):\n    nsB=routes[b][:ib]+[x]+routes[b][ib:]; mb=inf(nsB,types[b])\n    if mb:opts.append((ma[0]+mb[0]-meta[a][0]-meta[b][0],ib,mb))\n   if not opts:continue\n   opts.sort(); delta,ib,mb=opts[0] if rng.random()<.8 else rng.choice(opts[:min(3,len(opts))])\n   if delta<=0 or rng.random()<math.exp(-delta/temp):\n    routes[a]=nsA;routes[b].insert(ib,x);meta[a]=ma;meta[b]=mb;score+=delta;accepted+=1\n  elif move<.88:\n   non=[i for i,s in enumerate(routes) if s]; a,b=rng.sample(non,2); ia=rng.randrange(len(routes[a]));ib=rng.randrange(len(routes[b])); x,y=routes[a][ia],routes[b][ib]\n   if meta[a][2]-C[x]['demand']+C[y]['demand']>F[types[a]]['capacity'] or meta[b][2]-C[y]['demand']+C[x]['demand']>F[types[b]]['capacity']:continue\n   A=routes[a][:];B=routes[b][:];A[ia]=y;B[ib]=x; ma=inf(A,types[a]);mb=inf(B,types[b])\n   if not ma or not mb:continue\n   delta=ma[0]+mb[0]-meta[a][0]-meta[b][0]\n   if delta<=0 or rng.random()<math.exp(-delta/temp):routes[a]=A;routes[b]=B;meta[a]=ma;meta[b]=mb;score+=delta;accepted+=1\n  else:\n   cand=[i for i,s in enumerate(routes) if len(s)>=3]\n   if not cand:continue\n   a=rng.choice(cand); i,j=sorted(rng.sample(range(len(routes[a])),2)); A=routes[a][:i]+list(reversed(routes[a][i:j+1]))+routes[a][j+1:];ma=inf(A,types[a])\n   if not ma:continue\n   delta=ma[0]-meta[a][0]\n   if delta<=0 or rng.random()<math.exp(-delta/temp):routes[a]=A;meta[a]=ma;score+=delta;accepted+=1\n  if score<best:\n   best=score;bestR=[x[:] for x in routes];bestM=meta[:]\n   if best%100<5:print(name,it,best,flush=True)\n # exact departures from saved metadata\n out={'routes':[{'type':t,'depart':m[1],'stops':s} for s,t,m in zip(bestR,types,bestM) if s]}\n json.dump(out,open('/app/plans/'+name+'.json','w'),indent=1)\n print(name,'best',best,'iterations',it,'accepted',accepted,flush=True)\nif __name__=='__main__':improve(sys.argv[1],float(sys.argv[2]))\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /app/improve.py $n 20; done\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
