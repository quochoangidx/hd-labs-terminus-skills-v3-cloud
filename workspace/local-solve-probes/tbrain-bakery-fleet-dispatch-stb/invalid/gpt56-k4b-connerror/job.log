n(4,len(cand)); weights=[math.exp(-(cand[i][0]-cand[0][0])/1800) for i in range(lim)]\n            q=rng.choices(cand[:lim],weights=weights)[0]\n            _,r,p,z=q; routes[r].insert(p,x); meta[r]=z; un.remove(x)\n        if any(not s for s in routes):\n            # Empty vehicles are harmless, but should not normally occur.\n            pass\n        cost=sum((kinds[t]['fixed']+m[0]*kinds[t]['per_unit']) for s,t,m in zip(routes,vehicle_types,meta) if s)\n        return cost,routes,meta\n\n    best=None; start=time.time(); it=0\n    while time.time()-start<seconds:\n        z=build(random.Random(7919*it+hash(o['name'])%100000)); it+=1\n        if z and (best is None or z[0]<best[0]):\n            best=z; print(o['name'],'iteration',it,'cost',z[0],flush=True)\n    if best is None: raise RuntimeError('no construction')\n    cost,routes,meta=best\n    plan={'routes':[{'type':t,'depart':int(m[1]),'stops':s} for s,t,m in zip(routes,vehicle_types,meta) if s]}\n    os.makedirs(os.path.dirname(out),exist_ok=True); json.dump(plan,open(out,'w'),indent=1)\n    print(o['name'],'final',cost,'iterations',it)\n\nif __name__=='__main__': solve(sys.argv[1],sys.argv[2],float(sys.argv[3]) if len(sys.argv)>3 else 12)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /app/solve.py /app/orders/$n.json /app/plans/$n.json 12; done\n"] min_timeout_sec: 55.0 max_timeout_sec: 180.0
Sending keys: ["cat > /tmp/solve.py <<'PY'\nimport json, math, random, sys, time, os\nfrom functools import lru_cache\n\nname=sys.argv[1]; seconds=float(sys.argv[2]) if len(sys.argv)>2 else 30\nO=json.load(open('/app/orders/'+name+'.json')); C={c['id']:c for c in O['customers']}; D=O['depot']; F={f['type']:f for f in O['fleet']}; TYPES=list(F)\nids=list(C); rnd=random.Random(41731+len(ids)); target=json.load(open('/app/orders/targets.json'))[name]\ndef dist(a,b): return math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\nDM={(a,b):dist(D if a==0 else C[a],D if b==0 else C[b]) for a in [0]+ids for b in [0]+ids}\n\n@lru_cache(maxsize=1000000)\ndef ev(t, s):\n f=F[t]; s=list(s)\n if not s:return None\n load=sum(C[i]['demand'] for i in s)\n if load>f['capacity']: return None\n dd=DM[0,s[0]]+sum(DM[a,b] for a,b in zip(s,s[1:]))+DM[s[-1],0]\n if f['range'] is not None and dd>f['range']: return None\n # latest departure satisfying all due times and depot close\n latest=D['close']-DM[s[-1],0]*f['pace']\n for k in range(len(s)-1,-1,-1):\n  c=C[s[k]]; start=min(c['due'],latest-c['service'])\n  if start<c['ready']: return None\n  latest=start-DM[0 if k==0 else s[k-1],s[k]]*f['pace']\n dep=latest\n if dep<D['open']: return None\n # forward validation and shift\n clock=dep; prev=0\n for i in s:\n  clock=max(clock+DM[prev,i]*f['pace'],C[i]['ready'])\n  if clock>C[i]['due']:return None\n  clock+=C[i]['service']; prev=i\n back=clock+DM[prev,0]*f['pace']\n if back>D['close'] or back-dep>f['shift']: return None\n return f['fixed']+f['per_unit']*dd, dep, dd\n\ndef cost(sol): return sum(ev(t,tuple(s))[0] for t,s in sol)\ndef counts(sol):\n z={t:0 for t in TYPES}\n for t,s in sol:z[t]+=1\n return z\n\ndef options(sol,cid,noise=0.0, limit=999999):\n out=[]\n for r,(t,s) in enumerate(sol):\n  old=ev(t,tuple(s))[0]\n  for p in range(len(s)+1):\n   ns=tuple(s[:p]+[cid]+s[p:]); e=ev(t,ns)\n   if e: out.append((e[0]-old+rnd.random()*noise,r,p,t,ns,e[0]-old))\n cnt=counts(sol)\n for t in TYPES:\n  if cnt[t]<F[t]['count']:\n   e=ev(t,(cid,))\n   if e:out.append((e[0]+rnd.random()*noise,len(sol),0,t,(cid,),e[0]))\n out.sort(key=lambda x:x[0])\n return out[:limit]\n\ndef insert(sol, un, noisy=0, regret=True):\n un=set(un)\n while un:\n  choices=[]\n  sample=list(un) if len(un)<45 else rnd.sample(list(un),45)\n  for c in sample:\n   op=options(sol,c,noisy,3)\n   if op:\n    reg=(op[1][0]-op[0][0] if len(op)>1 else 20000)\n    # prioritize constrained customers; mild urgency/demand tie-break\n    score=reg + C[c]['demand']*8 if regret else -op[0][0]\n    choices.append((score,c,op[0]))\n  if not choices:return None\n  _,c,x=max(choices)\n  _,r,p,t,ns,_=x\n  if r==len(sol):sol.append((t,list(ns)))\n  else:sol[r]=(t,list(ns))\n  un.remove(c)\n return sol\n\ndef initial():\n # hardest first through regret insertion; seed mandatory large-demand customers\n sol=[]\n order=sorted(ids,key=lambda i:(C[i]['demand']>60, C[i]['demand'], -C[i]['due']),reverse=True)\n return insert(sol,order,0,True)\n\ndef retype(sol):\n # greedily accept individual type changes, then pair swaps\n changed=True\n while changed:\n  changed=False; cnt=counts(sol)\n  for r,(t,s) in enumerate(sol):\n   old=ev(t,tuple(s))[0]\n   for nt in TYPES:\n    if nt==t or cnt[nt]>=F[nt]['count']:continue\n    e=ev(nt,tuple(s))\n    if e and e[0]<old:\n     sol[r]=(nt,s);cnt[t]-=1;cnt[nt]+=1;changed=True;break\n return sol\n\ndef improve_routes(sol):\n # route reversal and random intra-route 2-opt\n for r,(t,s) in enumerate(sol):\n  base=ev(t,tuple(s))[0]; cand=list(reversed(s)); e=ev(t,tuple(cand))\n  if e and e[0]<base:sol[r]=(t,cand);base=e[0];s=cand\n  for _ in range(min(30,len(s)*3)):\n   if len(s)<3:break\n   a,b=sorted(rnd.sample(range(len(s)+1),2))\n   if b-a<2:continue\n   ns=s[:a]+list(reversed(s[a:b]))+s[b:]; e=ev(t,tuple(ns))\n   if e and e[0]<base:s=ns;base=e[0];sol[r]=(t,s)\n return sol\n\nstart=time.time(); best=None; bestc=10**18\n# Several construction attempts\nfor z in range(12):\n sol=initial()\n if sol:\n  sol=retype(improve_routes(sol)); cc=cost(sol)\n  if cc<bestc:best=[(t,s[:]) for t,s in sol];bestc=cc;print('initial',z,bestc,len(best),flush=True)\n if time.time()-start>seconds*.2:break\nif best is None: raise SystemExit('could not construct')\ncur=[(t,s[:]) for t,s in best]; curc=bestc; it=0\nwhile time.time()-start<seconds and bestc>target:\n it+=1; cand=[(t,s[:]) for t,s in cur]\n # related/random destroy\n q=rnd.randint(max(3,len(ids)//25),max(5,len(ids)//9))\n if rnd.random()<.65:\n  seed=rnd.choice(ids); pool=sorted(ids,key=lambda i:DM[seed,i]+abs(C[seed]['ready']-C[i]['ready'])/30)\n  rem=set(pool[:q])\n else: rem=set(rnd.sample(ids,q))\n ns=[]\n for t,s in cand:\n  x=[i for i in s if i not in rem]\n  if x:ns.append((t,x))\n cand=insert(ns,rem,noise=300+rnd.random()*1800,regret=rnd.random()<.8)\n if not cand:continue\n if rnd.random()<.35:cand=retype(cand)\n if rnd.random()<.25:cand=improve_routes(cand)\n cc=cost(cand)\n temp=max(40,1000*(1-(time.time()-start)/seconds))\n if cc<curc or rnd.random()<math.exp((curc-cc)/temp):cur,curc=cand,cc\n if cc<bestc:\n  best=[(t,s[:]) for t,s in cand];bestc=cc\n  print('best',it,bestc,'routes',len(best),'counts',counts(best),flush=True)\n# final departure values\nroutes=[]\nfor t,s in best:\n e=ev(t,tuple(s)); routes.append({'type':t,'depart':int(e[1]),'stops':s})\nos.makedirs('/app/plans',exist_ok=True)\njson.dump({'routes':routes},open('/app/plans/'+name+'.json','w'),indent=2)\nprint('FINAL',name,bestc,'target',target,'iterations',it,'cache',ev.cache_info())\nPY\npython3 /tmp/solve.py harbour-lanes 25\npython3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
