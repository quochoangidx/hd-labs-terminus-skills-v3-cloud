Sending keys: ["cat > /app/solve.py <<'PY'\nimport json, math, random, sys, time, os\n\ndef dist(a,b):\n    q=(a['x']-b['x'])**2+(a['y']-b['y'])**2\n    r=math.isqrt(q); return r if r*r==q else r+1\n\ndef solve(path, out, seconds=12):\n    o=json.load(open(path)); dep=o['depot']; C={c['id']:c for c in o['customers']}; ids=list(C)\n    D={(a,b):dist(dep if a==0 else C[a],dep if b==0 else C[b]) for a in [0]+ids for b in [0]+ids if a!=b}\n    kinds={f['type']:f for f in o['fleet']}\n    demand=sum(c['demand'] for c in C.values())\n    base=kinds['bike']['count']*kinds['bike']['capacity']+kinds['van']['count']*kinds['van']['capacity']\n    nt=max(0,math.ceil((demand-base)/kinds['truck']['capacity']))\n    vehicle_types=['bike']*kinds['bike']['count']+['van']*kinds['van']['count']+['truck']*nt\n\n    def info(seq, typ):\n        k=kinds[typ]\n        load=sum(C[x]['demand'] for x in seq)\n        if load>k['capacity']: return None\n        dd=D[0,seq[0]]+sum(D[a,b] for a,b in zip(seq,seq[1:]))+D[seq[-1],0]\n        if k['range'] is not None and dd>k['range']: return None\n        # Latest departure permitting all due times and closing time.\n        t=dep['close']-D[seq[-1],0]*k['pace']\n        for i in range(len(seq)-1,-1,-1):\n            c=C[seq[i]]\n            start=min(c['due'],t-c['service'])\n            if start<c['ready']: return None\n            t=start-(D[0,seq[i]] if i==0 else D[seq[i-1],seq[i]])*k['pace']\n        depart=max(dep['open'],t)\n        # Forward verification and duration.\n        clock=depart; here=0\n        for x in seq:\n            c=C[x]; clock=max(clock+D[here,x]*k['pace'],c['ready'])\n            if clock>c['due']: return None\n            clock+=c['service']; here=x\n        clock+=D[here,0]*k['pace']\n        if clock>dep['close'] or clock-depart>k['shift']: return None\n        return dd,depart,load\n\n    def build(rng):\n        routes=[[] for _ in vehicle_types]; meta=[None]*len(routes)\n        # Tight windows and large demands