[144.997085, "i", "cat > /app/refine.py <<'PY'\nimport json,math,random,sys,time\nfrom functools import lru_cache\nof,pf,secs=sys.argv[1],sys.argv[2],float(sys.argv[3]); end=time.time()+secs\no=json.load(open(of)); p=json.load(open(pf)); D=o['depot']; C={x['id']:x for x in o['customers']}; F={x['type']:x for x in o['fleet']}; ids=list(C); T=list(F)\ndef ds(a,b):\n q=(a['x']-b['x'])**2+(a['y']-b['y'])**2; z=math.isqrt(q);return z+(z*z<q)\nd={(i,j):ds(D if i==0 else C[i],D if j==0 else C[j]) for i in [0]+ids for j in [0]+ids}\n@lru_cache(maxsize=2000000)\ndef info(t,s):\n f=F[t]\n if not s or sum(C[x]['demand'] for x in s)>f['capacity']:return None\n di=d[0,s[0]]+sum(d[a,b] for a,b in zip(s,s[1:]))+d[s[-1],0]\n if f['range'] is not None and di>f['range']:return None\n # Opening always tests basic feasibility; derive useful later departures by simulating\n cand={D['open']}; clock=D['open']; prev=0\n for x in s:\n  arr=clock+d[prev,x]*f['pace']; clock=max(arr,C[x]['ready']); cand.add(max(D['open'],C[x]['ready']-(arr-D['open']))); clock+=C[x]['servi"]
[145.011663, "i", "ce'];prev=x\n for dep in sorted(cand,reverse=True):\n  clock=dep;prev=0;ok=True\n  for x in s:\n   clock=max(clock+d[prev,x]*f['pace'],C[x]['ready'])\n   if clock>C[x]['due']:ok=False;break\n   clock+=C[x]['service'];prev=x\n  if ok:\n   clock+=d[prev,0]*f['pace']\n   if clock<=D['close'] and clock-dep<=f['shift']:return dep,F[t]['fixed']+F[t]['per_unit']*di\n return None\n\ndef rc(t,s):\n z=info(t,tuple(s));return z[1] if z else 10**9\ndef total(r):return sum(rc(t,s) for t,s in r)\ndef save(r):\n q={'routes':[{'type':t,'depart':info(t,tuple(s))[0],'stops':s} for t,s in r]};json.dump(q,open(pf,'w'),indent=1)\ndef descent(r):\n while time.time()<end:\n  best=0; move=None; old=[rc(t,s) for t,s in r]\n  # exhaustive relocate, including same-route reorder and deleting singleton source\n  for a,(ta,sa) in enumerate(r):\n   for ia,x in enumerate(sa):\n    aa=sa[:ia]+sa[ia+1:]\n    ca=rc(ta,aa) if aa else 0\n    if ca>=10**9:continue\n    for b,(tb,sb) in enumerate(r):\n     if b==a:\n      for j in range(len(aa)+1):\n       ns=aa[:j]+[x]+aa[j:"]
