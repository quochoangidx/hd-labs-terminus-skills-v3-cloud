[29.932865, "i", "nl -ba /app/planner/plan_morning.py\n"]
[29.933418, "o", "nl -ba /app/planner/plan_morning.py\r\n\u001b[?2004l\r"]
[29.934068, "o", "     1\t\"\"\"Current dispatch planner: nearest-next greedy, vans first.\r\n     2\t\r\n     3\tUsage: python3 planner/plan_morning.py orders/<morning>.json plans/<morning>.json\r\n     4\t\r\n     5\tBuilds one route at a time. A route leaves when the bakery opens and keeps\r\n     6\tdriving to the nearest customer it can still reach inside that customer's window\r\n     7\twith room on board; when nothing fits, it goes home and the next vehicle starts.\r\n     8\t\"\"\"\r\n     9\t\r\n    10\timport json\r\n    11\timport os\r\n    12\timport sys\r\n    13\t\r\n    14\tsys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"tools\"))\r\n    15\tfrom check_plan import distance, evaluate  # noqa: E402\r\n    16\t\r\n    17\tORDER = (\"van\", \"truck\", \"bike\")\r\n    18\t\r\n    19\t\r\n    20\tdef plan(orders):\r\n    21\t    depot = orders[\"depot\"]\r\n    22\t    left = {c[\"id\"]: c for c in orders[\"customers\"]}\r\n    23\t    fleet = sorted(orders[\"fleet\"], key=lambda f: ORDER.index(f[\"type\"]) if f[\"type\"] in ORDER else 99)\r\n    24\t    routes = []\r\n    25\t"]
[29.934088, "o", "    for kind in fleet:\r\n    26\t        for _ in range(kind[\"count\"]):\r\n    27\t            if not left:\r\n    28\t                break\r\n    29\t            clock, here, crates, driven, stops = depot[\"open\"], depot, 0, 0, []\r\n    30\t            while True:\r\n    31\t                best = None\r\n    32\t                for c in left.values():\r\n    33\t                    leg = distance(here, c)\r\n    34\t                    start = max(clock + leg * kind[\"pace\"], c[\"ready\"])\r\n    35\t                    if start > c[\"due\"] or crates + c[\"demand\"] > kind[\"capacity\"]:\r\n    36\t                        continue\r\n    37\t                    back = start + c[\"service\"] + distance(c, depot) * kind[\"pace\"]\r\n    38\t                    if back > depot[\"close\"] or back - depot[\"open\"] > kind[\"shift\"]:\r\n    39\t                        continue\r\n    40\t                    total = driven + leg + distance(c, depot)\r\n    41\t                    if kind[\"range\"] is not None and total > kind[\"range\"]:\r\n    42\t                        continue\r"]
[29.934095, "o", "\n    43\t                    if best is None or leg < best[0]:\r\n    44\t                        best = (leg, c, start)\r\n    45\t                if best is None:\r\n    46\t                    break\r\n    47\t                leg, c, start = best\r\n    48\t                stops.append(c[\"id\"])\r\n    49\t                clock, here, crates, driven = start + c[\"service\"], c, crates + c[\"demand\"], driven + leg\r\n    50\t                del left[c[\"id\"]]\r\n    51\t            if stops:\r\n    52\t                routes.append({\"type\": kind[\"type\"], \"depart\": depot[\"open\"], \"stops\": stops})\r\n    53\t    return {\"routes\": routes}\r\n    54\t\r\n    55\t\r\n    56\tdef main(argv):\r\n    57\t    with open(argv[1]) as fh:\r\n    58\t        orders = json.load(fh)\r\n    59\t    result = plan(orders)\r\n    60\t    with open(argv[2], \"w\") as fh:\r\n    61\t        json.dump(result, fh, indent=1)\r\n    62\t    try:\r\n    63\t        print(\"cost\", evaluate(orders, result))\r\n    64\t    except ValueError as exc:\r\n    65\t        print(\"INFEASIBLE:\", exc)\r\n    66\t\r\n    67\t"]
[29.934098, "o", "\r\n    68\tif __name__ == \"__main__\":\r\n    69\t    main(sys.argv)\r\n"]
[29.934318, "o", "\u001b[?2004hroot@f6a2f2c66b28:/app# "]
[30.050883, "i", "mkdir -p /app/baseline /app/plans; for n in harbour-lanes old-town riverside north-ring; do echo \"=== $n ===\"; python3 /app/planner/plan_morning.py \"/app/orders/$n.json\" \"/app/baseline/$n.json\"; python3 /app/tools/check_plan.py \"/app/orders/$n.json\" \"/app/baseline/$n.json\" || true; done\n"]
[30.051285, "o", "mkdir -p /app/baseline /app/plans; for n in harbour-lanes old-town riverside north-ring; do echo \"=== $n ===\"; python3 /app/planner/plan_morning.py \"/app/orders/$n.json\" \"/app/baseline/$n.json\"; python3 /app/tools/check_plan.py \"/app/orders/$n.json\" \"/app/baseline/$n.json\" || true; done\r\n\u001b[?2004l\r"]
