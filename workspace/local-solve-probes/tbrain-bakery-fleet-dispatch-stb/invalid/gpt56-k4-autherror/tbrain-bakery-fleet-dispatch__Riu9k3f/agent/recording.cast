[145.075734, "o", "\u001b[?2004h> # Perturb incumbent with several feasible random moves, then descend.\r\n\u001b[?2004l\r\u001b[?2004h> while time.time()<end:\r\n\u001b[?2004l\r\u001b[?2004h>  r=[(t,s[:]) for t,s in best]\r\n\u001b[?2004l\r\u001b[?2004h>  for z in range(random.randint(2,6)):\r\n\u001b[?2004l\r\u001b[?2004h>   for tries in range(100):\r\n\u001b[?2004l\r\u001b[?2004h>    a,b=random.sample(range(len(r)),2);ta,sa=r[a];tb,sb=r[b]\r\n\u001b[?2004l\r\u001b[?2004h>    if not sa:continue\r\n\u001b[?2004l\r\u001b[?2004h>    i=random.randrange(len(sa));x=sa[i];aa=sa[:i]+sa[i+1:]\r\n\u001b[?2004l\r\u001b[?2004h>    j=random.randrange(len(sb)+1);bb=sb[:j]+[x]+sb[j:]\r\n\u001b[?2004l\r\u001b[?2004h>    if (not aa or info(ta,tuple(aa))) and info(tb,tuple(bb)):\r\n\u001b[?2004l\r\u001b[?2004h>     r[a]=(ta,aa);r[b]=(tb,bb)\r\n\u001b[?2004l\r\u001b[?2004h>     if not aa:r.pop(a)\r\n\u001b[?2004l\r\u001b[?2004h>     break\r\n\u001b[?2004l\r\u001b[?2004h>  r=descent(r);c=total(r)\r\n\u001b[?2004l\r\u001b[?2004h>  if c<bc:\r\n\u001b[?2004l\r\u001b[?2004h>   best=[(t,s[:]) for t,s in r];bc=c;save(best);print('BEST',bc,flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> print('FINAL',bc)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r\u001b[?2004hroot@f6a2f2c66b28:/"]
