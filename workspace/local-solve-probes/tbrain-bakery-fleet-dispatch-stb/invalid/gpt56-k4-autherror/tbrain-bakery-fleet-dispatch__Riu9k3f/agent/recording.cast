[546.833252, "i", "python3 - <<'PY'\nimport glob,json,os,sys,shutil\nsys.path.insert(0,'/app/tools');from check_plan import evaluate\nnames=['harbour-lanes','old-town','riverside','north-ring'];targets=json.load(open('/app/orders/targets.json'))\nfor n in names:\n o=json.load(open('/app/orders/'+n+'.json')); vals=[]\n pats=glob.glob('/app/candidates/'+n+'-*.json')\n if n=='harbour-lanes':pats+=['/app/candidates/harbour-current.json']\n for f in pats:\n  try: vals.append((evaluate(o,json.load(open(f))),f))\n  except Exception as e: print('BAD',f,e)\n vals.sort();print(n,'target',targets[n],'candidates',[(c,os.path.basename(f)) for c,f in vals])\n if vals: shutil.copy(vals[0][1],'/app/plans/'+n+'.json')\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
[546.834759, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import glob,json,os,sys,shutil\r\n\u001b[?2004l\r\u001b[?2004h> sys.path.insert(0,'/app/tools');from check_plan import evaluate\r\n\u001b[?2004l\r\u001b[?2004h> names=['harbour-lanes','old-town','riverside','north-ring'];targets=json.load(open('/app/orders/targets.json'))\r\n\u001b[?2004l\r\u001b[?2004h> for n in names:\r\n\u001b[?2004l\r\u001b[?2004h>  o=json.load(open('/app/orders/'+n+'.json')); vals=[]\r\n\u001b[?2004l\r\u001b[?2004h>  pats=glob.glob('/app/candidates/'+n+'-*.json')\r\n\u001b[?2004l\r\u001b[?2004h>  if n=='harbour-lanes':pats+=['/app/candidates/harbour-current.json']\r\n\u001b[?2004l\r\u001b[?2004h>  for f in pats:\r\n\u001b[?2004l\r\u001b[?2004h>   try: vals.append((evaluate(o,json.load(open(f))),f))\r\n\u001b[?2004l\r\u001b[?2004h>   except Exception as e: print('BAD',f,e)\r\n\u001b[?2004l\r\u001b[?2004h>  vals.sort();print(n,'target',targets[n],'candidates',[(c,os.path.basename(f)) for c,f in vals])\r\n\u001b[?2004l\r\u001b[?2004h>  if vals: shutil.copy(vals[0][1],'/app/plans/'+n+'.json')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
