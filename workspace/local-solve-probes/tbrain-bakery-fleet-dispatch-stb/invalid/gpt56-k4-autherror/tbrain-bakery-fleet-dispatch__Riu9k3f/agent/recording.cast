[35.078877, "i", "python3 - <<'PY'\nimport json\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n try:\n  p=json.load(open('/app/baseline/'+n+'.json'))\n  from collections import Counter\n  print(n,len(p['routes']),Counter(r['type'] for r in p['routes']),[len(r['stops']) for r in p['routes']])\n except Exception as e: print(n,e)\nPY\n"]
