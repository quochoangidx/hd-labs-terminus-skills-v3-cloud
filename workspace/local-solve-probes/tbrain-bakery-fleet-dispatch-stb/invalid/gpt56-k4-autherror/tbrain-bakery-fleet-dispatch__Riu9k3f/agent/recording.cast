[17.856491, "i", "python3 - <<'PY'\nimport json,glob\nfor fn in glob.glob('/app/orders/*.json'):\n if fn.endswith('targets.json'): continue\n o=json.load(open(fn))\n print('\\n',o['name'], 'depot=',o['depot'], 'customers=',len(o['customers']), 'demand=',sum(c['demand'] for c in o['customers']))\n print('fleet:')\n for f in o['fleet']: print(' ',f)\n print('customers: id x y dem ready due svc')\n for c in o['customers']: print(c['id'],c['x'],c['y'],c['demand'],c['ready'],c['due'],c['service'])\nPY\n"]
