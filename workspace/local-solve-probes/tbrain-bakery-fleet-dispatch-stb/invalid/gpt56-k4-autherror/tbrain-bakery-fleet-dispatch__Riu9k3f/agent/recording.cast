[83.718249, "i", "cat > /app/solve.py <<'PY'\nimport json,math,random,sys,time\nfrom functools import lru_cache\n\nfn,out,limit=sys.argv[1],sys.argv[2],float(sys.argv[3])\no=json.load(open(fn)); C={c['id']:c for c in o['customers']}; D=o['depot']; F={f['type']:f for f in o['fleet']}; types=list(F)\nids=list(C); deadline=time.time()+limit\n\ndef dist(a,b):\n q=(a['x']-b['x'])**2+(a['y']-b['y'])**2; z=math.isqrt(q); return z if z*z==q else z+1\nDD={(i,j):dist(D if i==0 else C[i],D if j==0 else C[j]) for i in [0]+ids for j in [0]+ids}\n\n@lru_cache(maxsize=1000000)\ndef routeinfo(t,s):\n f=F[t]\n if not s or sum(C[i]['demand'] for i in s)>f['capacity']: return None\n distance=DD[0,s[0]]+sum(DD[a,b] for a,b in zip(s,s[1:]))+DD[s[-1],0]\n if f['range'] is not None and distance>f['range']: return None\n # Departures at which each possible wait disappears, plus opening.\n pref=DD[0,s[0]]*f['pace']; cand={D['open']}\n for k,i in enumerate(s):\n  cand.add(max(D['open'],C[i]['ready']-pref))\n  pref += C[i]['service']\n  if k+1<len(s): pref += DD[i,s[k+1]]*f['"]
[83.718727, "o", "cat > /app/solve.py <<'PY'\r\n\u001b[?2004l\r"]
[83.718749, "i", "pace']\n for dep in sorted(cand,reverse=True):\n  if dep<D['open']: continue\n  clock=dep; prev=0; ok=True\n  for i in s:\n   clock=max(clock+DD[prev,i]*f['pace'],C[i]['ready'])\n   if clock>C[i]['due']: ok=False; break\n   clock+=C[i]['service']; prev=i\n  if ok:\n   clock+=DD[prev,0]*f['pace']\n   if clock<=D['close'] and clock-dep<=f['shift']:\n    return dep,distance\n return None\n\ndef cost(routes):\n z=0\n for t,s in routes:\n  ri=routeinfo(t,tuple(s))\n  if not ri:return 10**12\n  z+=F[t]['fixed']+F[t]['per_unit']*ri[1]\n return z\n\ndef counts(r):\n d={t:0 for t in types}\n for t,s in r:d[t]+=1\n return d\n\ndef build():\n routes=[]; left=set(ids); used={t:0 for t in types}\n # Regret insertion. Random perturbations diversify ties and near-ties.\n while left and time.time()<deadline:\n  chosen=None\n  sample=list(left) if len(left)<90 else random.sample(list(left),90)\n  for x in sample:\n   opts=[]\n   for q,(t,s) in enumerate(routes):\n    old=routeinfo(t,tuple(s))[1]*F[t]['per_unit']\n    for p in range(len(s)+1):\n     ns=tuple(s[:p]"]
[83.721352, "o", "\u001b[?2004h> import json,math,random,sys,time\r\n\u001b[?2004l\r\u001b[?2004h> from functools import lru_cache\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> fn,out,limit=sys.argv[1],sys.argv[2],float(sys.argv[3])\r\n\u001b[?2004l\r\u001b[?2004h> o=json.load(open(fn)); C={c['id']:c for c in o['customers']}; D=o['depot']; F={f['type']:f for f in o['fleet']}; types=list(F)\r\n\u001b[?2004l\r\u001b[?2004h> ids=list(C); deadline=time.time()+limit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def dist(a,b):\r\n\u001b[?2004l\r\u001b[?2004h>  q=(a['x']-b['x'])**2+(a['y']-b['y'])**2; z=math.isqrt(q); return z if z*z==q else z+1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[83.721369, "i", "+[x]+s[p:]); ri=routeinfo(t,ns)\n     if ri: opts.append((ri[1]*F[t]['per_unit']-old,q,p,t))\n   for t in types:\n    if used[t]<F[t]['count']:\n     ri=routeinfo(t,(x,))\n     if ri: opts.append((F[t]['fixed']+F[t]['per_unit']*ri[1],len(routes),0,t))\n   if not opts: continue\n   opts.sort(); a=opts[0][0]; b=opts[min(2,len(opts)-1)][0]\n   # Most constrained/regretful first; noise avoids deterministic traps.\n   key=(b-a)+random.random()*1000 + (3000 if C[x]['demand']>60 else 0)\n   if chosen is None or key>chosen[0]: chosen=(key,x,opts[:min(4,len(opts))])\n  if chosen is None:return None\n  _,x,opts=chosen\n  # Mostly best, occasionally one of the close alternatives.\n  op=opts[0] if random.random()<.82 else random.choice(opts)\n  _,q,p,t=op\n  if q==len(routes): routes.append((t,[x]));used[t]+=1\n  else: routes[q][1].insert(p,x)\n  left.remove(x)\n return routes if not left else None\n\ndef improve(r,until):\n r=[(t,s[:]) for t,s in r]; cur=cost(r); best=cur; br=[(t,s[:]) for t,s in r]\n temp=1800.0; it=0\n while time.time()<unti"]
