[145.011686, "i", "best:best=delta;move=('type',a,nt)\n  if move is None:return r\n  if move[0]=='same':r[move[1]]=(r[move[1]][0],move[2])\n  elif move[0] in ('rel','swap'):\n   _,a,b,na,nb=move;r[a]=(r[a][0],na);r[b]=(r[b][0],nb)\n   if not r[a][1]:r.pop(a)\n  else:r[move[1]]=(move[2],r[move[1]][1])\n return r\n\nbase=[(x['type'],x['stops'][:]) for x in p['routes']];base=descent(base); best=[(t,s[:]) for t,s in base];bc=total(best);save(best);print('descent',bc,flush=True)\n# Perturb incumbent with several feasible random moves, then descend.\nwhile time.time()<end:\n r=[(t,s[:]) for t,s in best]\n for z in range(random.randint(2,6)):\n  for tries in range(100):\n   a,b=random.sample(range(len(r)),2);ta,sa=r[a];tb,sb=r[b]\n   if not sa:continue\n   i=random.randrange(len(sa));x=sa[i];aa=sa[:i]+sa[i+1:]\n   j=random.randrange(len(sb)+1);bb=sb[:j]+[x]+sb[j:]\n   if (not aa or info(ta,tuple(aa))) and info(tb,tuple(bb)):\n    r[a]=(ta,aa);r[b]=(tb,bb)\n    if not aa:r.pop(a)\n    break\n r=descent(r);c=total(r)\n if c<bc:\n  best=[(t,s[:]) for t,s in r];b"]
