[572.315495, "i", "python3 - <<'PY'\ns=open('/app/refine.py').read(); prefix=s[:s.index(\"base=[\")]\nbottom=r'''base=[(x['type'],x['stops'][:]) for x in p['routes']]\ndef clone(r):return [(t,s[:]) for t,s in r]\ndef insert_all(r,removed):\n removed=set(removed)\n while removed:\n  pick=None\n  for x in removed:\n   opts=[]\n   for a,(t,s) in enumerate(r):\n    old=rc(t,s)\n    for j in range(len(s)+1):\n     ns=s[:j]+[x]+s[j:]; nc=rc(t,ns)\n     if nc<10**9:opts.append((nc-old,a,j))\n   if not opts:return None\n   opts.sort(); regret=opts[min(2,len(opts)-1)][0]-opts[0][0]\n   key=regret+random.random()*80\n   if pick is None or key>pick[0]:pick=(key,x,opts[0])\n  _,x,(_,a,j)=pick;r[a][1].insert(j,x);removed.remove(x)\n return r\ndef route_opt(r):\n # Repeated best feasible relocate within each route and 2-opt segments.\n for a,(t,s) in enumerate(r):\n  changed=True\n  while changed and time.time()<end:\n   changed=False; old=rc(t,s); best=old; bs=s\n   for i,x in enumerate(s):\n    q=s[:i]+s[i+1:]\n    for j in range(len(q)+1):\n     ns=q[:j]+[x]+q[j:]; z=rc"]
[572.31595, "i", "(t,ns)\n     if z<best:best=z;bs=ns\n   for i in range(len(s)-1):\n    for j in range(i+2,len(s)+1):\n     ns=s[:i]+list(reversed(s[i:j]))+s[j:];z=rc(t,ns)\n     if z<best:best=z;bs=ns\n   if best<old:s=bs;r[a]=(t,s);changed=True\n return r\nbest=route_opt(clone(base));bc=total(best);cur=clone(best);cc=bc;save(best);print('START',bc,flush=True)\nit=0; temp=max(500,bc*.015)\nwhile time.time()<end:\n it+=1;r=clone(cur); n=sum(len(s) for t,s in r); k=random.randint(max(4,n//14),max(6,n//5))\n removable=[x for t,s in r if len(s)>1 for x in s]\n if len(removable)<k:continue\n if random.random()<.72:\n  seed=random.choice(removable); cs=C[seed]\n  removable.sort(key=lambda x:(C[x]['x']-cs['x'])**2+(C[x]['y']-cs['y'])**2+((C[x]['ready']-cs['ready'])/100)**2*random.uniform(.2,2))\n  pool=removable[:min(len(removable),k*3)]; rem=random.sample(pool,k)\n else:rem=random.sample(removable,k)\n # Ensure each route retains a seed customer.\n actual=[]\n for a,(t,s) in enumerate(r):\n  take=[x for x in s if x in rem]\n  if len(take)>=len(s):take=t"]
[572.315963, "i", "ake[:len(s)-1]\n  if take:r[a]=(t,[x for x in s if x not in take]);actual+=take\n if len(actual)<2:continue\n r=insert_all(r,actual)\n if r is None:continue\n if random.random()<.35:r=route_opt(r)\n nc=total(r);delta=nc-cc\n if delta<=0 or random.random()<math.exp(-delta/max(1,temp)):\n  cur,cc=r,nc\n  if nc<bc:\n   best=clone(r);bc=nc;save(best);print('BEST',bc,'it',it,flush=True)\n temp*=.999\n if temp<30:temp=max(300,bc*.006)\nprint('FINAL',bc,'iters',it)\n'''\nopen('/app/alns.py','w').write(prefix+bottom)\nPY\npython3 -m py_compile /app/alns.py\nmkdir -p /app/alnscand /app/alnslogs\nfor n in harbour-lanes old-town riverside north-ring; do for k in 1 2 3; do cp /app/plans/$n.json /app/alnscand/$n-$k.json; (python3 /app/alns.py /app/orders/$n.json /app/alnscand/$n-$k.json 150 > /app/alnslogs/$n-$k.log 2>&1) & done; done; wait\n"]
[572.322268, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> s=open('/app/refine.py').read(); prefix=s[:s.index(\"base=[\")]\r\n\u001b[?2004l\r\u001b[?2004h> bottom=r'''base=[(x['type'],x['stops'][:]) for x in p['routes']]\r\n\u001b[?2004l\r\u001b[?2004h> def clone(r):return [(t,s[:]) for t,s in r]\r\n\u001b[?2004l\r\u001b[?2004h> def insert_all(r,removed):\r\n\u001b[?2004l\r\u001b[?2004h>  removed=set(removed)\r\n\u001b[?2004l\r\u001b[?2004h>  while removed:\r\n\u001b[?2004l\r\u001b[?2004h>   pick=None\r\n\u001b[?2004l\r\u001b[?2004h>   for x in removed:\r\n\u001b[?2004l\r\u001b[?2004h>    opts=[]\r\n\u001b[?2004l\r\u001b[?2004h>    for a,(t,s) in enumerate(r):\r\n\u001b[?2004l\r\u001b[?2004h>     old=rc(t,s)\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(len(s)+1):\r\n\u001b[?2004l\r\u001b[?2004h>      ns=s[:j]+[x]+s[j:]; nc=rc(t,ns)\r\n\u001b[?2004l\r\u001b[?2004h>      if nc<10**9:opts.append((nc-old,a,j))\r\n\u001b[?2004l\r\u001b[?2004h>    if not opts:return None\r\n\u001b[?2004l\r\u001b[?2004h>    opts.sort(); regret=opts[min(2,len(opts)-1)][0]-opts[0][0]\r\n\u001b[?2004l\r\u001b[?2004h>    key=regret+random.random()*80\r\n\u001b[?2004l\r\u001b[?2004h>    if pick is None or key>pick[0]:pick=(key,x,opts[0])\r\n\u001b[?2004l\r\u001b[?2004h>   _,x,(_,a,j)"]
