[572.324346, "o", "  changed=True\r\n\u001b[?2004l\r\u001b[?2004h>   while changed and time.time()<end:\r\n\u001b[?2004l\r\u001b[?2004h>    changed=False; old=rc(t,s); best=old; bs=s\r\n\u001b[?2004l\r\u001b[?2004h>    for i,x in enumerate(s):\r\n\u001b[?2004l\r\u001b[?2004h>     q=s[:i]+s[i+1:]\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(len(q)+1):\r\n\u001b[?2004l\r\u001b[?2004h>      ns=q[:j]+[x]+q[j:]; z=rc(t,ns)\r\n\u001b[?2004l\r\u001b[?2004h>      if z<best:best=z;bs=ns\r\n\u001b[?2004l\r\u001b[?2004h>    for i in range(len(s)-1):\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(i+2,len(s)+1):\r\n\u001b[?2004l\r\u001b[?2004h>      ns=s[:i]+list(reversed(s[i:j]))+s[j:];z=rc(t,ns)\r\n\u001b[?2004l\r\u001b[?2004h>      if z<best:best=z;bs=ns\r\n\u001b[?2004l\r\u001b[?2004h>    if best<old:s=bs;r[a]=(t,s);changed=True\r\n\u001b[?2004l\r\u001b[?2004h>  return r\r\n\u001b[?2004l\r\u001b[?2004h> best=route_opt(clone(base));bc=total(best);cur=clone(best);cc=bc;save(best);print('START',bc,flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> it=0; temp=max(500,bc*.015)\r\n\u001b[?2004l\r\u001b[?2004h> while time.time()<end:\r\n\u001b[?2004l\r\u001b[?2004h>  it+=1;r=clone(cur); n=sum(len(s) for t,s in r); k=random.randint(max(4,n//14),max(6,n//5"]
[572.324363, "o", "))\r\n\u001b[?2004l\r\u001b[?2004h>  removable=[x for t,s in r if len(s)>1 for x in s]\r\n\u001b[?2004l\r\u001b[?2004h>  if len(removable)<k:continue\r\n\u001b[?2004l\r\u001b[?2004h>  if random.random()<.72:\r\n\u001b[?2004l\r\u001b[?2004h>   seed=random.choice(removable); cs=C[seed]\r\n\u001b[?2004l\r\u001b[?2004h>   removable.sort(key=lambda x:(C[x]['x']-cs['x'])**2+(C[x]['y']-cs['y'])**2+((C[x]['ready']-cs['ready'])/100)**2*random.uniform(.2,2))\r\n\u001b[?2004l\r\u001b[?2004h>   pool=removable[:min(len(removable),k*3)]; rem=random.sample(pool,k)\r\n\u001b[?2004l\r\u001b[?2004h>  else:rem=random.sample(removable,k)\r\n\u001b[?2004l\r\u001b[?2004h>  # Ensure each route retains a seed customer.\r\n\u001b[?2004l\r"]
[572.324871, "o", "\u001b[?2004h>  actual=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for a,(t,s) in enumerate(r):\r\n\u001b[?2004l\r\u001b[?2004h>   take=[x for x in s if x in rem]\r\n\u001b[?2004l\r\u001b[?2004h>   if len(take)>=len(s):take=take[:len(s)-1]\r\n\u001b[?2004l\r\u001b[?2004h>   if take:r[a]=(t,[x for x in s if x not in take]);actual+=take\r\n\u001b[?2004l\r\u001b[?2004h>  if len(actual)<2:continue\r\n\u001b[?2004l\r\u001b[?2004h>  r=insert_all(r,actual)\r\n\u001b[?2004l\r\u001b[?2004h>  if r is None:continue\r\n\u001b[?2004l\r\u001b[?2004h>  if random.random()<.35:r=route_opt(r)\r\n\u001b[?2004l\r\u001b[?2004h>  nc=total(r);delta=nc-cc\r\n\u001b[?2004l\r\u001b[?2004h>  if delta<=0 or random.random()<math.exp(-delta/max(1,temp)):\r\n\u001b[?2004l\r\u001b[?2004h>   cur,cc=r,nc\r\n\u001b[?2004l\r\u001b[?2004h>   if nc<bc:\r\n\u001b[?2004l\r\u001b[?2004h>    best=clone(r);bc=nc;save(best);print('BEST',bc,'it',it,flush=True)\r\n\u001b[?2004l\r\u001b[?2004h>  temp*=.999\r\n\u001b[?2004l\r\u001b[?2004h>  if temp<30:temp=max(300,bc*.006)\r\n\u001b[?2004l\r\u001b[?2004h> print('FINAL',bc,'iters',it)\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> open('/app/alns.py','w').write(prefix+bottom)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
