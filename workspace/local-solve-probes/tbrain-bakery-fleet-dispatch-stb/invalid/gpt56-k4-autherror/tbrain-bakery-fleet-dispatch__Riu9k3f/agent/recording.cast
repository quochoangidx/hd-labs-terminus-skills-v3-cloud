[83.726471, "i", "l:\n  it+=1; nr=[(t,s[:]) for t,s in r]; typ=random.random()\n  if typ<.48 and len(nr)>1: # relocate\n   a=random.randrange(len(nr)); b=random.randrange(len(nr))\n   if a==b or not nr[a][1]:continue\n   p=random.randrange(len(nr[a][1])); x=nr[a][1].pop(p)\n   if not nr[a][1]: nr.pop(a); b-=b>a\n   if not nr:continue\n   b=max(0,min(b,len(nr)-1)); nr[b][1].insert(random.randrange(len(nr[b][1])+1),x)\n  elif typ<.78 and len(nr)>1: # swap\n   a,b=random.sample(range(len(nr)),2); pa=random.randrange(len(nr[a][1]));pb=random.randrange(len(nr[b][1]))\n   nr[a][1][pa],nr[b][1][pb]=nr[b][1][pb],nr[a][1][pa]\n  elif typ<.93: # reverse a segment\n   a=random.randrange(len(nr)); s=nr[a][1]\n   if len(s)<2:continue\n   p,q=sorted(random.sample(range(len(s)+1),2));\n   if q-p<2:continue\n   s[p:q]=reversed(s[p:q])\n  else: # change vehicle type if fleet permits\n   a=random.randrange(len(nr)); nt=random.choice(types)\n   if nt==nr[a][0] or sum(1 for t,s in nr if t==nt)>=F[nt]['count']:continue\n   nr[a]=(nt,nr[a][1])\n  nc=cost(nr)\n  if nc>=10"]
