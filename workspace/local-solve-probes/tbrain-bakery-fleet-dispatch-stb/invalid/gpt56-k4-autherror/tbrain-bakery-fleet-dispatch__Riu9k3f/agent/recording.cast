[83.726499, "i", "**12:continue\n  delta=nc-cur\n  if delta<=0 or random.random()<math.exp(-delta/max(1,temp)):\n   r,cur=nr,nc\n   if cur<best: best=cur;br=[(t,s[:]) for t,s in r]\n  temp*=.9997\n  if temp<20:temp=900\n return br,best,it\n\nbest=None;bc=10**12; starts=0\nwhile time.time()<deadline:\n r=build();starts+=1\n if not r:continue\n # Give each feasible construction a bounded local-search slice.\n until=min(deadline,time.time()+max(.4,limit/12))\n r,c,it=improve(r,until)\n if c<bc:\n  best,bc=r,c\n  plan={'routes':[{'type':t,'depart':routeinfo(t,tuple(s))[0],'stops':s} for t,s in r]}\n  json.dump(plan,open(out,'w'),indent=1)\n  print('BEST',bc,'routes',len(r),counts(r),'starts',starts,flush=True)\nprint('FINAL',bc,'starts',starts)\nPY\npython3 /app/solve.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json 25\npython3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\n"]
