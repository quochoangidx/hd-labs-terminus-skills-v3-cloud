[?2004l[?2004h> import json,math,random,sys,time
[?2004l[?2004h> from functools import lru_cache
[?2004l[?2004h> 
[?2004l[?2004h> fn,out,limit=sys.argv[1],sys.argv[2],float(sys.argv[3])
[?2004l[?2004h> o=json.load(open(fn)); C={c['id']:c for c in o['customers']}; D=o['depot']; F={f['type']:f for f in o['fleet']}; types=list(F)
[?2004l[?2004h> ids=list(C); deadline=time.time()+limit
[?2004l[?2004h> 
[?2004l[?2004h> def dist(a,b):
[?2004l[?2004h>  q=(a['x']-b['x'])**2+(a['y']-b['y'])**2; z=math.isqrt(q); return z if z*z==q else z+1
[?2004l[?2004h> DD={(i,j):dist(D if i==0 else C[i],D if j==0 else C[j]) for i in [0]+ids for j in [0]+ids}
[?2004l[?2004h> 
[?2004l[?2004h> @lru_cache(maxsize=1000000)
[?2004l[?2004h> def routeinfo(t,s):
[?2004l[?2004h>  f=F[t]
[?2004l[?2004h>  if not s or sum(C[i]['demand'] for i in s)>f['capacity']: return None
[?2004l[?2004h>  distance=DD[0,s[0]]+sum(DD[a,b] for a,b in zip(s,s[1:]))+DD[s[-1],0]
[?2004l[?2004h>  if f['range'] is not None and distance>f['range']: return None
[?2004l[?2004h>  # Departures at which each possible wait disappears, plus opening.
[?2004l[?2004h>  pref=DD[0,s[0]]*f['pace']; cand={D['open']}
[?2004l[?2004h>  for k,i in enumerate(s):
[?2004l[?2004h>   cand.add(max(D['open'],C[i]['ready']-pref))
[?2004l[?2004h>   pref += C[i]['service']
[?2004l[?2004h>   if k+1<len(s): pref += DD[i,s[k+1]]*f['pace']
[?2004l[?2004h>  for dep in sorted(cand,reverse=True):
[?2004l[?2004h>   if dep<D['open']: continue
[?2004l[?2004h>   clock=dep; prev=0; ok=True
[?2004l[?2004h>   for i in s:
[?2004l[?2004h>    clock=max(clock+DD[prev,i]*f['pace'],C[i]['ready'])
[?2004l[?2004h>    if clock>C[i]['due']: ok=False; break
[?2004l[?2004h>    clock+=C[i]['service']; prev=i
[?2004l[?2004h>   if ok:
[?2004l[?2004h>    clock+=DD[prev,0]*f['pace']
[?2004l[?2004h>    if clock<=D['close'] and clock-dep<=f['shift']:
[?2004l[?2004h>     return dep,distance
[?2004l[?2004h>  return None
[?2004l[?2004h> 
[?2004l[?2004h> def cost(routes):
[?2004l[?2004h>  z=0
[?2004l[?2004h>  for t,s in routes:
[?2004l[?2004h>   ri=routeinfo(t,tuple(s))
[?2004l[?2004h>   if not ri:return 10**12
[?2004l[?2004h>   z+=F[t]['fixed']+F[t]['per_unit']*ri[1]
[?2004l[?2004h>  return z
[?2004l[?2004h> 
[?2004l[?2004h> def counts(r):
[?2004l[?2004h>  d={t:0 for t in types}
[?2004l[?2004h>  for t,s in r:d[t]+=1
[?2004l[?2004h>  return d
[?2004l[?2004h> 
[?2004l[?2004h> def build():
[?2004l[?2004h>  routes=[]; left=set(ids); used={t:0 for t in types}
[?2004l[?2004h>  # Regret insertion. Random perturbations diversify ties and near-ties.
[?2004l[?2004h>  while left and time.time()<deadline:
[?2004l[?2004h>   chosen=None
