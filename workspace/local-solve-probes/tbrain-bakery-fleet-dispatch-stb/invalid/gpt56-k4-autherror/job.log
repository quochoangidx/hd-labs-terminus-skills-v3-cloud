Sending keys: ["cat > /app/solve.py <<'PY'\nimport json,math,random,sys,time\nfrom functools import lru_cache\n\nfn,out,limit=sys.argv[1],sys.argv[2],float(sys.argv[3])\no=json.load(open(fn)); C={c['id']:c for c in o['customers']}; D=o['depot']; F={f['type']:f for f in o['fleet']}; types=list(F)\nids=list(C); deadline=time.time()+limit\n\ndef dist(a,b):\n q=(a['x']-b['x'])**2+(a['y']-b['y'])**2; z=math.isqrt(q); return z if z*z==q else z+1\nDD={(i,j):dist(D if i==0 else C[i],D if j==0 else C[j]) for i in [0]+ids for j in [0]+ids}\n\n@lru_cache(maxsize=1000000)\ndef routeinfo(t,s):\n f=F[t]\n if not s or sum(C[i]['demand'] for i in s)>f['capacity']: return None\n distance=DD[0,s[0]]+sum(DD[a,b] for a,b in zip(s,s[1:]))+DD[s[-1],0]\n if f['range'] is not None and distance>f['range']: return None\n # Departures at which each possible wait disappears, plus opening.\n pref=DD[0,s[0]]*f['pace']; cand={D['open']}\n for k,i in enumerate(s):\n  cand.add(max(D['open'],C[i]['ready']-pref))\n  pref += C[i]['service']\n  if k+1<len(s): pref += DD[i,s[k+1]]*f['pace']\n for dep in sorted(cand,reverse=True):\n  if dep<D['open']: continue\n  clock=dep; prev=0; ok=True\n  for i in s:\n   clock=max(clock+DD[prev,i]*f['pace'],C[i]['ready'])\n   if clock>C[i]['due']: ok=False; break\n   clock+=C[i]['service']; prev=i\n  if ok:\n   clock+=DD[prev,0]*f['pace']\n   if clock<=D['close'] and clock-dep<=f['shift']:\n    return dep,distance\n return None\n\ndef cost(routes):\n z=0\n for t,s in routes:\n  ri=routeinfo(t,tuple(s))\n  if not ri:return 10**12\n  z+=F[t]['fixed']+F[t]['per_unit']*ri[1]\n return z\n\ndef counts(r):\n d={t:0 for t in types}\n for t,s in r:d[t]+=1\n return d\n\ndef build():\n routes=[]; left=set(ids); used={t:0 for t in types}\n # Regret insertion. Random perturbations diversify ties and near-ties.\n while left and time.time()<deadline:\n  chosen=None\n  sample=list(left) if len(left)<90 else random.sample(list(left),90)\n  for x in sample:\n   opts=[]\n   for q,(t,s) in enumerate(routes):\n    old=routeinfo(t,tuple(s))[1]*F[t]['per_unit']\n    for p in range(len(s)+1):\n     ns=tuple(s[:p]+[x]+s[p:]); ri=routeinfo(t,ns)\n     if ri: opts.append((ri[1]*F[t]['per_unit']-old,q,p,t))\n   for t in types:\n    if used[t]<F[t]['count']:\n     ri=routeinfo(t,(x,))\n     if ri: opts.append((F[t]['fixed']+F[t]['per_unit']*ri[1],len(routes),0,t))\n   if not opts: continue\n   opts.sort(); a=opts[0][0]; b=opts[min(2,len(opts)-1)][0]\n   # Most constrained/regretful first; noise avoids deterministic traps.\n   key=(b-a)+random.random()*1000 + (3000 if C[x]['demand']>60 else 0)\n   if chosen is None or key>chosen[0]: chosen=(key,x,opts[:min(4,len(opts))])\n  if chosen is None:return None\n  _,x,opts=chosen\n  # Mostly best, occasionally one of the close alternatives.\n  op=opts[0] if random.random()<.82 else random.choice(opts)\n  _,q,p,t=op\n  if q==len(routes): routes.append((t,[x]));used[t]+=1\n  else: routes[q][1].insert(p,x)\n  left.remove(x)\n return routes if not left else None\n\ndef improve(r,until):\n r=[(t,s[:]) for t,s in r]; cur=cost(r); best=cur; br=[(t,s[:]) for t,s in r]\n temp=1800.0; it=0\n while time.time()<until:\n  it+=1; nr=[(t,s[:]) for t,s in r]; typ=random.random()\n  if typ<.48 and len(nr)>1: # relocate\n   a=random.randrange(len(nr)); b=random.randrange(len(nr))\n   if a==b or not nr[a][1]:continue\n   p=random.randrange(len(nr[a][1])); x=nr[a][1].pop(p)\n   if not nr[a][1]: nr.pop(a); b-=b>a\n   if not nr:continue\n   b=max(0,min(b,len(nr)-1)); nr[b][1].insert(random.randrange(len(nr[b][1])+1),x)\n  elif typ<.78 and len(nr)>1: # swap\n   a,b=random.sample(range(len(nr)),2); pa=random.randrange(len(nr[a][1]));pb=random.randrange(len(nr[b][1]))\n   nr[a][1][pa],nr[b][1][pb]=nr[b][1][pb],nr[a][1][pa]\n  elif typ<.93: # reverse a segment\n   a=random.randrange(len(nr)); s=nr[a][1]\n   if len(s)<2:continue\n   p,q=sorted(random.sample(range(len(s)+1),2));\n   if q-p<2:continue\n   s[p:q]=reversed(s[p:q])\n  else: # change vehicle type if fleet permits\n   a=random.randrange(len(nr)); nt=random.choice(types)\n   if nt==nr[a][0] or sum(1 for t,s in nr if t==nt)>=F[nt]['count']:continue\n   nr[a]=(nt,nr[a][1])\n  nc=cost(nr)\n  if nc>=10**12:continue\n  delta=nc-cur\n  if delta<=0 or random.random()<math.exp(-delta/max(1,temp)):\n   r,cur=nr,nc\n   if cur<best: best=cur;br=[(t,s[:]) for t,s in r]\n  temp*=.9997\n  if temp<20:temp=900\n return br,best,it\n\nbest=None;bc=10**12; starts=0\nwhile time.time()<deadline:\n r=build();starts+=1\n if not r:continue\n # Give each feasible construction a bounded local-search slice.\n until=min(deadline,time.time()+max(.4,limit/12))\n r,c,it=improve(r,until)\n if c<bc:\n  best,bc=r,c\n  plan={'routes':[{'type':t,'depart':routeinfo(t,tuple(s))[0],'stops':s} for t,s in r]}\n  json.dump(plan,open(out,'w'),indent=1)\n  print('BEST',bc,'routes',len(r),counts(r),'starts',starts,flush=True)\nprint('FINAL',bc,'starts',starts)\nPY\npython3 /app/solve.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json 25\npython3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
