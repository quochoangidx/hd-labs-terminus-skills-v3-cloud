 start=time.time(); end=start+seconds; best=None; bestcost=10**15; builds=0
 # Spend about 20% constructing diverse starts, then improve each for a slice.
 while time.time()<end:
  r=construct(); builds+=1
  if r is None:continue
  c=total(r)
  slice_end=min(end,time.time()+max(1.5,seconds/8))
  r,c=improve(r,slice_end)
  if c<bestcost:
   best,bestcost=[x[:] for x in r],c
   print(name,'best',c,'build',builds,'elapsed',round(time.time()-start,1),flush=True)
 if best is None:raise RuntimeError('no solution')
 out={'routes':[]}
 for s,t in zip(best,types):
  if s:
   e=ev(s,t);out['routes'].append({'type':t,'depart':e[1],'stops':s})
 os.makedirs('/app/plans',exist_ok=True);json.dump(out,open(f'/app/plans/{name}.json','w'),indent=1)
 print('FINAL',name,bestcost,'routes',[(t,len(s),ev(s,t)[2]) for s,t in zip(best,types)])
if __name__=='__main__':solve(sys.argv[1],float(sys.argv[2]) if len(sys.argv)>2 else 30,int(sys.argv[3]) if len(sys.argv)>3 else 1)
