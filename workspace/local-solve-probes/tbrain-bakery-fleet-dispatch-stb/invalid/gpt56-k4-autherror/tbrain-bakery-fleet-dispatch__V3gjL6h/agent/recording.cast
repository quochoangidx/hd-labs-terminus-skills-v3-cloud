[146.515537, "i", "cat > /app/solve.py <<'PY'\nimport json, math, random, sys, time, os\n\ndef dist(a,b): return math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y']))\n\ndef solve(name, seconds=30, seed=1):\n random.seed(seed); data=json.load(open(f'/app/orders/{name}.json')); D=data['depot']; C={c['id']:c for c in data['customers']}; kinds={k['type']:k for k in data['fleet']}\n ids=list(C); dd={(0,i):dist(D,C[i]) for i in ids}\n for i in ids:\n  dd[(i,0)]=dd[(0,i)]\n  for j in ids: dd[(i,j)]=dist(C[i],C[j])\n # Expected economical fleet: all bikes/vans, and minimum trucks needed for aggregate capacity.\n kb,kv,kt=kinds['bike'],kinds['van'],kinds['truck']; demand=sum(c['demand'] for c in C.values())\n nb,nv=kb['count'],kv['count']; nt=max(0,math.ceil((demand-nb*kb['capacity']-nv*kv['capacity'])/kt['capacity']))\n types=['bike']*nb+['van']*nv+['truck']*nt\n def ev(seq,typ):\n  if not seq:return (0,D['open'],0)\n  k=kinds[typ]\n  if sum(C[x]['demand'] for x in seq)>k['capacity']: return None\n  ds=dd[(0,seq[0])]+sum(dd[(a,b)] for a,b in zip(seq,seq[1:"]
[146.515911, "i", "]))+dd[(seq[-1],0)]\n  if k['range'] is not None and ds>k['range']:return None\n  # Latest possible departure under windows and closing; this minimizes avoidable waiting.\n  latest=D['close']-dd[(seq[-1],0)]*k['pace']-C[seq[-1]]['service']\n  latest=min(latest,C[seq[-1]]['due'])\n  for a,b in zip(reversed(seq[:-1]),reversed(seq[1:])):\n   latest=min(C[a]['due'],latest-dd[(a,b)]*k['pace']-C[a]['service'])\n  dep=latest-dd[(0,seq[0])]*k['pace']\n  if dep<D['open']: dep=D['open']\n  t=dep\n  for p,q in zip([0]+seq,seq):\n   t+=dd[(p,q)]*k['pace']; t=max(t,C[q]['ready'])\n   if t>C[q]['due']:return None\n   t+=C[q]['service']\n  t+=dd[(seq[-1],0)]*k['pace']\n  if t>D['close'] or t-dep>k['shift']:return None\n  return (k['fixed']+k['per_unit']*ds,int(dep),ds)\n def total(routes):\n  z=0\n  for s,t in zip(routes,types):\n   e=ev(s,t)\n   if e is None:return 10**15\n   z+=e[0]\n  return z\n def construct():\n  routes=[[] for _ in types]; un=set(ids)\n  while un:\n   choices=[]\n   for x in un:\n    opts=[]\n    for r,(s,t) in enumerate(zip(route"]
[146.51593, "i", "s,types)):\n     old=ev(s,t)[0]\n     for p in range(len(s)+1):\n      ns=s[:p]+[x]+s[p:]; e=ev(ns,t)\n      if e: opts.append((e[0]-old+random.random()*12,r,p))\n    if opts:\n     opts.sort(); best=opts[0]\n     # Regret across alternatives, emphasizing hard/high-demand customers.\n     alt=opts[min(2,len(opts)-1)][0]\n     regret=alt-best[0]\n     score=regret+5*C[x]['demand']+random.random()*80\n     choices.append((score,x,best))\n   if not choices:return None\n   _,x,(_,r,p)=max(choices)\n   routes[r].insert(p,x); un.remove(x)\n  if any(not s for s in routes): return None\n  return routes\n def improve(routes, until):\n  cur=total(routes); best=cur; br=[x[:] for x in routes]; nmove=0\n  temp=500.0\n  while time.time()<until:\n   nmove+=1\n   a=random.randrange(len(routes));\n   if not routes[a]:continue\n   mode=random.random(); changed=[]\n   if mode<.58:\n    ia=random.randrange(len(routes[a])); x=routes[a].pop(ia); b=random.randrange(len(routes)); ib=random.randrange(len(routes[b])+1); routes[b].insert(ib,x); changed=[a,b]\n  "]
[146.515934, "i", "  undo=('rel',a,ia,b,ib)\n   elif mode<.84:\n    b=random.randrange(len(routes));\n    if not routes[b]:continue\n    ia=random.randrange(len(routes[a])); ib=random.randrange(len(routes[b])); routes[a][ia],routes[b][ib]=routes[b][ib],routes[a][ia]; changed=[a,b]; undo=('swap',a,ia,b,ib)\n   else:\n    if len(routes[a])<3:continue\n    i,j=sorted(random.sample(range(len(routes[a])+1),2))\n    if j-i<2:continue\n    routes[a][i:j]=reversed(routes[a][i:j]); changed=[a]; undo=('rev',a,i,j)\n   new=total(routes); delta=new-cur\n   T=max(3,temp)\n   accept=new<10**14 and (delta<=0 or random.random()<math.exp(-delta/T))\n   if accept:\n    cur=new\n    if cur<best:best=cur;br=[x[:] for x in routes]\n   else:\n    if undo[0]=='rel':\n     _,aa,ii,bb,jj=undo; x=routes[bb].pop(jj);routes[aa].insert(ii,x)\n    elif undo[0]=='swap':\n     _,aa,ii,bb,jj=undo;routes[aa][ii],routes[bb][jj]=routes[bb][jj],routes[aa][ii]\n    else:\n     _,aa,i,j=undo;routes[aa][i:j]=reversed(routes[aa][i:j])\n   temp*=.99993\n   if temp<3:temp=150\n  return br,best"]
[146.516147, "i", "\n start=time.time(); end=start+seconds; best=None; bestcost=10**15; builds=0\n # Spend about 20% constructing diverse starts, then improve each for a slice.\n while time.time()<end:\n  r=construct(); builds+=1\n  if r is None:continue\n  c=total(r)\n  slice_end=min(end,time.time()+max(1.5,seconds/8))\n  r,c=improve(r,slice_end)\n  if c<bestcost:\n   best,bestcost=[x[:] for x in r],c\n   print(name,'best',c,'build',builds,'elapsed',round(time.time()-start,1),flush=True)\n if best is None:raise RuntimeError('no solution')\n out={'routes':[]}\n for s,t in zip(best,types):\n  if s:\n   e=ev(s,t);out['routes'].append({'type':t,'depart':e[1],'stops':s})\n os.makedirs('/app/plans',exist_ok=True);json.dump(out,open(f'/app/plans/{name}.json','w'),indent=1)\n print('FINAL',name,bestcost,'routes',[(t,len(s),ev(s,t)[2]) for s,t in zip(best,types)])\nif __name__=='__main__':solve(sys.argv[1],float(sys.argv[2]) if len(sys.argv)>2 else 30,int(sys.argv[3]) if len(sys.argv)>3 else 1)\nPY\npython3 /app/solve.py harbour-lanes 30 1\npython3 /app/too"]
