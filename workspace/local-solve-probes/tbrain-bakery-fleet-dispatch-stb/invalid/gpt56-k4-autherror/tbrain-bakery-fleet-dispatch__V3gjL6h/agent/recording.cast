[26.420939, "o", "cat docs/dispatch-rules.md\r\n\u001b[?2004l\r# Morning dispatch rules\r\n\r\nThese rules decide whether a delivery plan can be run and what it costs. They\r\nare the rules `tools/check_plan.py` applies.\r\n\r\n## Orders\r\n\r\nEach file in `orders/` is one morning. It lists the bakery (`depot`), the\r\ncustomers to deliver to, and the vehicles available (`fleet`). Positions are\r\ninteger grid coordinates `x`, `y` in units of 100 m; times are seconds after\r\nmidnight. The bakery opens at `open` and closes at `close`.\r\n\r\nA customer has an integer `id`, a position, a `demand` in crates, a delivery\r\nwindow `ready`..`due`, and a `service` time in seconds for unloading. Its\r\n`kind` (cafe, grocer, hotel, market) is for information only and changes no\r\nrule.\r\n\r\nA fleet entry is one kind of vehicle, named by its `type`: `count` vehicles of it are available,\r\neach carrying up to `capacity` crates. It travels at `pace` seconds per unit of\r\ndistance, costs `fixed` for being used at all and `per_unit` for every unit of\r\ndistance it drives, may be "]
[26.4211, "o", "out for at most `shift` seconds from leaving the\r\nbakery to getting back, and, where `range` is not null, may drive at most\r\n`range` units of distance in the morning. Costs are in cents.\r\n\r\n## Distance and time\r\n\r\nThe distance between two points is the Euclidean distance between them,\r\nrounded up to a whole unit. A vehicle takes `distance * pace` seconds to drive\r\nit.\r\n\r\n## A route\r\n\r\nA route is one vehicle's morning: it leaves the bakery at its departure time,\r\nvisits its customers in order, and comes back. Every route visits at least one\r\ncustomer, and each vehicle runs at most one route.\r\n\r\n- The departure is a whole number of seconds, not before the bakery opens.\r\n- At each customer the vehicle unloads from the later of its arrival and the\r\n  customer's `ready` time, and that must not be after `due`. Unloading takes the\r\n  customer's `service` time; the vehicle leaves as soon as it is done.\r\n- The vehicle must be back at the bakery no later than it closes, and no more\r\n  than `shift` seconds after its dep"]
[26.421108, "o", "arture.\r\n- The crates on the route (the sum of its customers' demands) must fit the\r\n  vehicle's `capacity`, and the distance driven must be within its `range`\r\n  where it has one. The distance driven is the sum of the rounded legs, from\r\n  the bakery through each customer in turn and back to the bakery.\r\n\r\n## A plan\r\n\r\nA plan delivers to every customer of the morning exactly once, uses no more\r\nvehicles of a kind than the fleet has, and costs the sum over its routes of the\r\nvehicle's `fixed` cost plus `per_unit` times the route's distance.\r\n\r\nIt is written as JSON:\r\n\r\n    {\"routes\": [{\"type\": \"van\", \"depart\": 18000, \"stops\": [12, 4, 31]}, ...]}\r\n\r\nwhere `type` names a fleet entry, `depart` is the departure time as a JSON\r\ninteger (`18000`, not `18000.0`) and `stops` lists customer ids, as the\r\nintegers in the orders file, in visiting order. Other keys are ignored.\r\n\u001b[?2004hroot@cc824bc89db4:/app# "]
[26.944729, "i", "cat tools/check_plan.py\n"]
[26.945969, "o", "cat tools/check_plan.py\r\n\u001b[?2004l\r\"\"\"Check a delivery plan against docs/dispatch-rules.md and print its cost.\r\n\r\nUsage: python3 tools/check_plan.py orders/<morning>.json plans/<morning>.json\r\n\"\"\"\r\n\r\nimport json\r\nimport math\r\nimport sys\r\n\r\n\r\nclass PlanError(ValueError):\r\n    pass\r\n\r\n\r\ndef distance(a, b):\r\n    sq = (a[\"x\"] - b[\"x\"]) ** 2 + (a[\"y\"] - b[\"y\"]) ** 2\r\n    d = math.isqrt(sq)\r\n    return d if d * d == sq else d + 1\r\n\r\n\r\ndef evaluate(orders, plan):\r\n    depot = orders[\"depot\"]\r\n    customers = {c[\"id\"]: c for c in orders[\"customers\"]}\r\n    fleet = {f[\"type\"]: f for f in orders[\"fleet\"]}\r\n    used = {t: 0 for t in fleet}\r\n    served = set()\r\n    total = 0\r\n    if not isinstance(plan, dict) or not isinstance(plan.get(\"routes\"), list):\r\n        raise PlanError(\"a plan is a JSON object with a routes list\")\r\n    for number, route in enumerate(plan[\"routes\"], start=1):\r\n        where = f\"route {number}\"\r\n        if not isinstance(route, dict):\r\n            raise PlanError(f\"{where}: not a JSON object\")\r\n    "]
[26.946847, "o", "    kind = fleet.get(route.get(\"type\")) if isinstance(route.get(\"type\"), str) else None\r\n        if kind is None:\r\n            raise PlanError(f\"{where}: unknown vehicle type {route.get('type')!r}\")\r\n        stops = route.get(\"stops\")\r\n        if not isinstance(stops, list) or not stops:\r\n            raise PlanError(f\"{where}: no stops\")\r\n        depart = route.get(\"depart\")\r\n        if not isinstance(depart, int) or isinstance(depart, bool) or depart < depot[\"open\"]:\r\n            raise PlanError(f\"{where}: departure must be a whole second, not before opening\")\r\n        used[route[\"type\"]] += 1\r\n        clock, here, crates, driven = depart, depot, 0, 0\r\n        for cid in stops:\r\n            if not isinstance(cid, int) or isinstance(cid, bool) or cid not in customers:\r\n                raise PlanError(f\"{where}: unknown customer {cid!r}\")\r\n            if cid in served:\r\n                raise PlanError(f\"{where}: customer {cid} delivered twice\")\r\n            served.add(cid)\r\n            customer = customers[cid"]
[26.94688, "o", "]\r\n            leg = distance(here, customer)\r\n            driven += leg\r\n            start = max(clock + leg * kind[\"pace\"], customer[\"ready\"])\r\n            if start > customer[\"due\"]:\r\n                raise PlanError(f\"{where}: customer {cid} reached at {start}, after its window closes at {customer['due']}\")\r\n            clock = start + customer[\"service\"]\r\n            crates += customer[\"demand\"]\r\n            here = customer\r\n        leg = distance(here, depot)\r\n        driven += leg\r\n        back = clock + leg * kind[\"pace\"]\r\n        if back > depot[\"close\"]:\r\n            raise PlanError(f\"{where}: back at {back}, after the bakery closes\")\r\n        if back - depart > kind[\"shift\"]:\r\n            raise PlanError(f\"{where}: out for {back - depart} s, longer than the {kind['shift']} s shift\")\r\n        if crates > kind[\"capacity\"]:\r\n            raise PlanError(f\"{where}: {crates} crates on a vehicle that carries {kind['capacity']}\")\r\n        if kind[\"range\"] is not None and driven > kind[\"range\"]:\r\n           "]
[26.946898, "o", " raise PlanError(f\"{where}: drives {driven} units, beyond its range of {kind['range']}\")\r\n        total += kind[\"fixed\"] + kind[\"per_unit\"] * driven\r\n    for name, count in used.items():\r\n        if count > fleet[name][\"count\"]:\r\n            raise PlanError(f\"{count} routes use a {name}; only {fleet[name]['count']} are available\")\r\n    missing = sorted(set(customers) - served)\r\n    if missing:\r\n        raise PlanError(f\"{len(missing)} customers get no delivery, first {missing[:5]}\")\r\n    return total\r\n\r\n\r\ndef main(argv):\r\n    if len(argv) != 3:\r\n        sys.exit(__doc__)\r\n    with open(argv[1]) as fh:\r\n        orders = json.load(fh)\r\n    with open(argv[2]) as fh:\r\n        plan = json.load(fh)\r\n    try:\r\n        cost = evaluate(orders, plan)\r\n    except PlanError as exc:\r\n        print(f\"INFEASIBLE: {exc}\")\r\n        return 1\r\n    print(f\"feasible, cost {cost}\")\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main(sys.argv))\r\n\u001b[?2004hroot@cc824bc89db4:/app# "]
