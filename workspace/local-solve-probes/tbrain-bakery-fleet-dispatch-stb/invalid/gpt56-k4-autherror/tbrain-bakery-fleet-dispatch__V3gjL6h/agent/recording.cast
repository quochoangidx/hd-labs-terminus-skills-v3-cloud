[366.77468, "i", "python3 - <<'PY'\nimport json,math\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n d=json.load(open('orders/'+n+'.json')); p=json.load(open('plans/'+n+'.json')); C={c['id']:c for c in d['customers']}; K={k['type']:k for k in d['fleet']}\n seen={x for r in p['routes'] for x in r['stops']}; miss=set(C)-seen\n print('\\n',n,'target',json.load(open('orders/targets.json'))[n],'routes',len(p['routes']),'missing',[(x,C[x]['demand']) for x in sorted(miss)])\n by={}\n for r in p['routes']:\n  load=sum(C[x]['demand'] for x in r['stops']); pts=[d['depot']]+[C[x] for x in r['stops']]+[d['depot']]\n  ds=sum(math.ceil(math.hypot(a['x']-b['x'],a['y']-b['y'])) for a,b in zip(pts,pts[1:]));by.setdefault(r['type'],[]).append((load,ds,len(r['stops'])))\n for t,v in by.items():print(t,len(v),v,'fixed',len(v)*K[t]['fixed'])\n dem=sum(c['demand'] for c in C.values()); print('demand',dem)\n for nt in range(1,K['truck']['count']+1):\n  cap=K['bike']['count']*14+K['van']['count']*60+nt*150\n  if cap>=dem:\n   fixed=K['bike']['coun"]
[366.774985, "i", "t']*900+K['van']['count']*4200+nt*9500\n   print('aggregate mix trucks',nt,'cap',cap,'fixed',fixed);break\nPY\n"]
