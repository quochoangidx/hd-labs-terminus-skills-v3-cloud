[33.636856, "o", "cat docs/dispatch-rules.md\r\n\u001b[?2004l\r"]
[33.637523, "o", "# Morning dispatch rules\r\n\r\nThese rules decide whether a delivery plan can be run and what it costs. They\r\nare the rules `tools/check_plan.py` applies.\r\n\r\n## Orders\r\n\r\nEach file in `orders/` is one morning. It lists the bakery (`depot`), the\r\ncustomers to deliver to, and the vehicles available (`fleet`). Positions are\r\ninteger grid coordinates `x`, `y` in units of 100 m; times are seconds after\r\nmidnight. The bakery opens at `open` and closes at `close`.\r\n\r\nA customer has an integer `id`, a position, a `demand` in crates, a delivery\r\nwindow `ready`..`due`, and a `service` time in seconds for unloading. Its\r\n`kind` (cafe, grocer, hotel, market) is for information only and changes no\r\nrule.\r\n\r\nA fleet entry is one kind of vehicle, named by its `type`: `count` vehicles of it are available,\r\neach carrying up to `capacity` crates. It travels at `pace` seconds per unit of"]
[33.637697, "o", "\r\ndistance, costs `fixed` for being used at all and `per_unit` for every unit of\r\ndistance it drives, may be out for at most `shift` seconds from leaving the\r\nbakery to getting back, and, where `range` is not null, may drive at most\r\n`range` units of distance in the morning. Costs are in cents.\r\n\r\n## Distance and time\r\n\r\nThe distance between two points is the Euclidean distance between them,\r\nrounded up to a whole unit. A vehicle takes `distance * pace` seconds to drive\r\nit.\r\n\r\n## A route\r\n\r\nA route is one vehicle's morning: it leaves the bakery at its departure time,\r\nvisits its customers in order, and comes back. Every route visits at least one\r\ncustomer, and each vehicle runs at most one route.\r\n\r\n- The departure is a whole number of seconds, not before the bakery opens.\r\n- At each customer the vehicle unloads from the later of its arrival and the\r\n  customer's `ready` time, and that must not be after `due`. Unloading takes the\r\n  customer's `service` time; the vehicle leaves as soon as it is done.\r\n- The "]
[33.637708, "o", "vehicle must be back at the bakery no later than it closes, and no more\r\n  than `shift` seconds after its departure.\r\n- The crates on the route (the sum of its customers' demands) must fit the\r\n  vehicle's `capacity`, and the distance driven must be within its `range`\r\n  where it has one. The distance driven is the sum of the rounded legs, from\r\n  the bakery through each customer in turn and back to the bakery.\r\n\r\n## A plan\r\n\r\nA plan delivers to every customer of the morning exactly once, uses no more\r\nvehicles of a kind than the fleet has, and costs the sum over its routes of the\r\nvehicle's `fixed` cost plus `per_unit` times the route's distance.\r\n\r\nIt is written as JSON:\r\n\r\n    {\"routes\": [{\"type\": \"van\", \"depart\": 18000, \"stops\": [12, 4, 31]}, ...]}\r\n\r\nwhere `type` names a fleet entry, `depart` is the departure time as a JSON\r\ninteger (`18000`, not `18000.0`) and `stops` lists customer ids, as the\r\nintegers in the orders file, in visiting order. Other keys are ignored.\r\n"]
[33.637852, "o", "\u001b[?2004hroot@cc824bc89db4:/app# "]
[37.942158, "i", "nl -ba tools/check_plan.py | sed -n '1,260p'\n"]
[37.942495, "o", "nl -ba tools/check_plan.py | sed -n '1,260p'\r\n\u001b[?2004l\r"]
[37.944106, "o", "     1\t\"\"\"Check a delivery plan against docs/dispatch-rules.md and print its cost.\r\n     2\t\r\n     3\tUsage: python3 tools/check_plan.py orders/<morning>.json plans/<morning>.json\r\n     4\t\"\"\"\r\n     5\t\r\n     6\timport json\r\n     7\timport math\r\n     8\timport sys\r\n     9\t\r\n    10\t\r\n    11\tclass PlanError(ValueError):\r\n    12\t    pass\r\n    13\t\r\n    14\t\r\n    15\tdef distance(a, b):\r\n    16\t    sq = (a[\"x\"] - b[\"x\"]) ** 2 + (a[\"y\"] - b[\"y\"]) ** 2\r\n    17\t    d = math.isqrt(sq)\r\n    18\t    return d if d * d == sq else d + 1\r\n    19\t\r\n    20\t\r\n    21\tdef evaluate(orders, plan):\r\n    22\t    depot = orders[\"depot\"]\r\n    23\t    customers = {c[\"id\"]: c for c in orders[\"customers\"]}\r\n    24\t    fleet = {f[\"type\"]: f for f in orders[\"fleet\"]}\r\n    25\t    used = {t: 0 for t in fleet}\r\n    26\t    served = set()\r\n    27\t    total = 0\r\n    28\t    if not isinstance(plan, dict) or not isinstance(plan.get(\"routes\"), list):\r\n    29\t        raise PlanError(\"a plan is a JSON object with a routes list\")\r\n    30\t    for number, route in e"]
[37.944132, "o", "numerate(plan[\"routes\"], start=1):\r\n    31\t        where = f\"route {number}\"\r\n    32\t        if not isinstance(route, dict):\r\n    33\t            raise PlanError(f\"{where}: not a JSON object\")\r\n    34\t        kind = fleet.get(route.get(\"type\")) if isinstance(route.get(\"type\"), str) else None\r\n    35\t        if kind is None:\r\n    36\t            raise PlanError(f\"{where}: unknown vehicle type {route.get('type')!r}\")\r\n    37\t        stops = route.get(\"stops\")\r\n    38\t        if not isinstance(stops, list) or not stops:\r\n    39\t            raise PlanError(f\"{where}: no stops\")\r\n    40\t        depart = route.get(\"depart\")\r\n    41\t        if not isinstance(depart, int) or isinstance(depart, bool) or depart < depot[\"open\"]:\r\n    42\t            raise PlanError(f\"{where}: departure must be a whole second, not before opening\")\r\n    43\t        used[route[\"type\"]] += 1\r\n    44\t        clock, here, crates, driven = depart, depot, 0, 0\r\n    45\t        for cid in stops:\r\n    46\t            if not isinstance(cid, int) or isin"]
[37.944137, "o", "stance(cid, bool) or cid not in customers:\r\n    47\t                raise PlanError(f\"{where}: unknown customer {cid!r}\")\r\n    48\t            if cid in served:\r\n    49\t                raise PlanError(f\"{where}: customer {cid} delivered twice\")\r\n    50\t            served.add(cid)\r\n    51\t            customer = customers[cid]\r\n    52\t            leg = distance(here, customer)\r\n    53\t            driven += leg\r\n    54\t            start = max(clock + leg * kind[\"pace\"], customer[\"ready\"])\r\n    55\t            if start > customer[\"due\"]:\r\n    56\t                raise PlanError(f\"{where}: customer {cid} reached at {start}, after its window closes at {customer['due']}\")\r\n    57\t            clock = start + customer[\"service\"]\r\n    58\t            crates += customer[\"demand\"]\r\n    59\t            here = customer\r\n    60\t        leg = distance(here, depot)\r\n    61\t        driven += leg\r\n    62\t        back = clock + leg * kind[\"pace\"]\r\n    63\t        if back > depot[\"close\"]:\r\n    64\t            raise PlanError(f\"{where}: "]
[37.94414, "o", "back at {back}, after the bakery closes\")\r\n    65\t        if back - depart > kind[\"shift\"]:\r\n    66\t            raise PlanError(f\"{where}: out for {back - depart} s, longer than the {kind['shift']} s shift\")\r\n    67\t        if crates > kind[\"capacity\"]:\r\n    68\t            raise PlanError(f\"{where}: {crates} crates on a vehicle that carries {kind['capacity']}\")\r\n    69\t        if kind[\"range\"] is not None and driven > kind[\"range\"]:\r\n    70\t            raise PlanError(f\"{where}: drives {driven} units, beyond its range of {kind['range']}\")\r\n    71\t        total += kind[\"fixed\"] + kind[\"per_unit\"] * driven\r\n    72\t    for name, count in used.items():\r\n    73\t        if count > fleet[name][\"count\"]:\r\n    74\t            raise PlanError(f\"{count} routes use a {name}; only {fleet[name]['count']} are available\")\r\n    75\t    missing = sorted(set(customers) - served)\r\n    76\t    if missing:\r\n    77\t        raise PlanError(f\"{len(missing)} customers get no delivery, first {missing[:5]}\")\r\n    78\t    return total\r\n    7"]
[37.944143, "o", "9\t\r\n    80\t\r\n    81\tdef main(argv):\r\n    82\t    if len(argv) != 3:\r\n    83\t        sys.exit(__doc__)\r\n    84\t    with open(argv[1]) as fh:\r\n    85\t        orders = json.load(fh)\r\n    86\t    with open(argv[2]) as fh:\r\n    87\t        plan = json.load(fh)\r\n    88\t    try:\r\n    89\t        cost = evaluate(orders, plan)\r\n    90\t    except PlanError as exc:\r\n    91\t        print(f\"INFEASIBLE: {exc}\")\r\n    92\t        return 1\r\n    93\t    print(f\"feasible, cost {cost}\")\r\n    94\t    return 0\r\n    95\t\r\n    96\t\r\n    97\tif __name__ == \"__main__\":\r\n    98\t    sys.exit(main(sys.argv))\r\n\u001b[?2004hroot@cc824bc89db4:/app# "]
