[285.316071, "i", "],'bike')\n      if e:opts.append((e[0]-old+random.random()*80,x,pos))\n    if opts and (load<10 or random.random()<.7):\n     _,x,pos=min(opts);routes[r].insert(pos,x);un.remove(x);progress=True\n  # Bikes must carry enough demand for remaining aggregate capacity.\n  if sum(C[x]['demand'] for r in bikeidx for x in routes[r]) < demand-nv*60-nt*150:return None\n  others=[i for i,t in enumerate(types) if t!='bike']\n  order=sorted(un,key=lambda x:C[x]['demand']+random.random()*3,reverse=True)\n  for x in order:\n   opts=[]\n   for r in others:\n    seq=routes[r];typ=types[r];k=kinds[typ];load=sum(C[y]['demand'] for y in seq)\n    if load+C[x]['demand']>k['capacity']:continue\n    old=ev(seq,typ)[0]\n    for pos in range(len(seq)+1):\n     e=ev(seq[:pos]+[x]+seq[pos:],typ)\n     if e:\n      residual=k['capacity']-load-C[x]['demand']\n      opts.append((e[0]-old+residual*.2+random.random()*150,r,pos))\n   if not opts:return None\n   _,r,pos=min(opts);routes[r].insert(pos,x)\n  if any(not q for q in routes):return None\n  return route"]
