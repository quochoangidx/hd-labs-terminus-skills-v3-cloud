[85.233435, "i", "python3 - <<'PY'\nimport json,math\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n d=json.load(open('orders/'+n+'.json')); cs=d['customers']\n elig=[c for c in cs if 2*math.ceil(math.hypot(c['x'],c['y']))<=260 and c['demand']<=14]\n print(n,'eligible bike singletons',len(elig),'demand',sum(c['demand'] for c in elig))\n print(' demand histogram', {x:sum(c['demand']==x for c in cs) for x in sorted(set(c['demand'] for c in cs))})\n print(' windows',sorted({(c['ready'],c['due']) for c in cs}))\n print(' first 12',[(c['id'],c['x'],c['y'],c['demand'],c['ready'],c['due'],c['service']) for c in cs[:12]])\nPY\n"]
