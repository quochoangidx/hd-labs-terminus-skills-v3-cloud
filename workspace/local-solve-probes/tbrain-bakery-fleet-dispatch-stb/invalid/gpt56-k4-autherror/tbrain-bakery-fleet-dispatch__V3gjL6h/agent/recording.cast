[19.147809, "o", " {\r\n   \"id\": 219,\r\n   \"x\": 20,\r\n   \"y\": -61,\r\n   \"demand\": 6,\r\n   \"ready\": 28800,\r\n   \"due\": 32400,\r\n   \"service\": 390,\r\n   \"kind\": \"grocer\"\r\n  },\r\n  {\r\n   \"id\": 220,\r\n   \"x\": 136,\r\n   \"y\": -59,\r\n   \"demand\": 22,\r\n   \"ready\": 25200,\r\n   \"due\": 27900,\r\n   \"service\": 790,\r\n   \"kind\": \"hotel\"\r\n  }\r\n ],\r\n \"fleet\": [\r\n  {\r\n   \"type\": \"bike\",\r\n   \"count\": 18,\r\n   \"capacity\": 14,\r\n   \"fixed\": 900,\r\n   \"per_unit\": 2,\r\n   \"pace\": 22,\r\n   \"shift\": 18000,\r\n   \"range\": 260\r\n  },\r\n  {\r\n   \"type\": \"van\",\r\n   \"count\": 27,\r\n   \"capacity\": 60,\r\n   \"fixed\": 4200,\r\n   \"per_unit\": 11,\r\n   \"pace\": 11,\r\n   \"shift\": 25200,\r\n   \"range\": null\r\n  },\r\n  {\r\n   \"type\": \"truck\",\r\n   \"count\": 11,\r\n   \"capacity\": 150,\r\n   \"fixed\": 9500,\r\n   \"per_unit\": 19,\r\n   \"pace\": 13,\r\n   \"shift\": 28800,\r\n   \"range\": null\r\n  }\r\n ]\r\n}\r\n\u001b[?2004hroot@cc824bc89db4:/app# "]
