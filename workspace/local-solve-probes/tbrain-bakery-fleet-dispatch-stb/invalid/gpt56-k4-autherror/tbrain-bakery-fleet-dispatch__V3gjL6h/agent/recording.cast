[45.294204, "o", "back at {back}, after the bakery closes\")\r\n    65\t        if back - depart > kind[\"shift\"]:\r\n    66\t            raise PlanError(f\"{where}: out for {back - depart} s, longer than the {kind['shift']} s shift\")\r\n    67\t        if crates > kind[\"capacity\"]:\r\n    68\t            raise PlanError(f\"{where}: {crates} crates on a vehicle that carries {kind['capacity']}\")\r\n    69\t        if kind[\"range\"] is not None and driven > kind[\"range\"]:\r\n    70\t            raise PlanError(f\"{where}: drives {driven} units, beyond its range of {kind['range']}\")\r\n    71\t        total += kind[\"fixed\"] + kind[\"per_unit\"] * driven\r\n    72\t    for name, count in used.items():\r\n    73\t        if count > fleet[name][\"count\"]:\r\n    74\t            raise PlanError(f\"{count} routes use a {name}; only {fleet[name]['count']} are available\")\r\n    75\t    missing = sorted(set(customers) - served)\r\n    76\t    if missing:\r\n    77\t        raise PlanError(f\"{len(missing)} customers get no delivery, first {missing[:5]}\")\r\n    78\t    return total\r\n    "]
[45.294672, "o", "79\t\r\n    80\t\r\n    81\tdef main(argv):\r\n    82\t    if len(argv) != 3:\r\n    83\t        sys.exit(__doc__)\r\n    84\t    with open(argv[1]) as fh:\r\n    85\t        orders = json.load(fh)\r\n    86\t    with open(argv[2]) as fh:\r\n    87\t        plan = json.load(fh)\r\n    88\t    try:\r\n    89\t        cost = evaluate(orders, plan)\r\n    90\t    except PlanError as exc:\r\n    91\t        print(f\"INFEASIBLE: {exc}\")\r\n    92\t        return 1\r\n    93\t    print(f\"feasible, cost {cost}\")\r\n    94\t    return 0\r\n    95\t\r\n    96\t\r\n    97\tif __name__ == \"__main__\":\r\n    98\t    sys.exit(main(sys.argv))\r\n\u001b[?2004hroot@cc824bc89db4:/app# "]
