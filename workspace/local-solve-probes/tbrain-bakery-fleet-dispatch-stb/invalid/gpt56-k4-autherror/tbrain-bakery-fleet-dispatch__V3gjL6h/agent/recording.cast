[211.347484, "i", "python3 - <<'PY'\np='/app/solve.py'\ns=open(p).read()\na=s.index(' def construct():')\nb=s.index(' def improve(',a)\nnew=''' def construct():\n  routes=[[] for _ in types]; un=set(ids)\n  # Place large and vehicle-constrained orders first; random noise diversifies starts.\n  order=sorted(ids,key=lambda x:(C[x]['demand']+random.random()*5),reverse=True)\n  for x in order:\n   opts=[]\n   for r,(seq,typ) in enumerate(zip(routes,types)):\n    k=kinds[typ]\n    load=sum(C[y]['demand'] for y in seq)\n    if load+C[x]['demand']>k['capacity']: continue\n    old=ev(seq,typ)[0]\n    for pos in range(len(seq)+1):\n     ns=seq[:pos]+[x]+seq[pos:]; e=ev(ns,typ)\n     if e:\n      # Cost plus a modest best-fit term. Avoid wasting scarce bike capacity.\n      residual=k['capacity']-load-C[x]['demand']\n      bias=residual*(5 if typ=='bike' else 1)\n      opts.append((e[0]-old+bias+random.random()*100,r,pos))\n   if not opts:return None\n   _,r,pos=min(opts);routes[r].insert(pos,x)\n  if any(not seq for seq in routes):return None\n  return routes\n''"]
[211.34785, "i", "'\nopen(p,'w').write(s[:a]+new+s[b:])\nPY\npython3 /app/solve.py harbour-lanes 45 2\npython3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\n"]
