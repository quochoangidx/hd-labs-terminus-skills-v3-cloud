[467.593656, "i", "cp plans/harbour-lanes.json /tmp/harbour-best.json\npython3 - <<'PY'\np='/app/solve.py';s=open(p).read()\ns=s.replace(\"   elif mode<.84:\\n\", \"   elif mode<.78:\\n\")\ns=s.replace(\"   else:\\n    if len(routes[a])<3:continue\\n    i,j=sorted(random.sample(range(len(routes[a])+1),2))\\n    if j-i<2:continue\\n    routes[a][i:j]=reversed(routes[a][i:j]); changed=[a]; undo=('rev',a,i,j)\\n\", \"\"\"   elif mode<.90:\n    # Relocate a consecutive pair, allowing coordinated capacity changes.\n    if len(routes[a])<2:continue\n    ia=random.randrange(len(routes[a])-1); seg=routes[a][ia:ia+2];del routes[a][ia:ia+2]\n    b=random.randrange(len(routes));ib=random.randrange(len(routes[b])+1);routes[b][ib:ib]=seg\n    changed=[a,b];undo=('seg',a,ia,b,ib,2)\n   else:\n    if len(routes[a])<3:continue\n    i,j=sorted(random.sample(range(len(routes[a])+1),2))\n    if j-i<2:continue\n    routes[a][i:j]=reversed(routes[a][i:j]); changed=[a]; undo=('rev',a,i,j)\n\"\"\")\ns=s.replace(\"    elif undo[0]=='swap':\\n     _,aa,ii,bb,jj=undo;routes[aa][ii],routes["]
[467.594059, "i", "bb][jj]=routes[bb][jj],routes[aa][ii]\\n    else:\\n\", \"\"\"    elif undo[0]=='swap':\n     _,aa,ii,bb,jj=undo;routes[aa][ii],routes[bb][jj]=routes[bb][jj],routes[aa][ii]\n    elif undo[0]=='seg':\n     _,aa,ii,bb,jj,ll=undo;seg=routes[bb][jj:jj+ll];del routes[bb][jj:jj+ll];routes[aa][ii:ii]=seg\n    else:\n\"\"\")\nopen(p,'w').write(s)\nPY\nfor seed in 11 22 33; do python3 /app/solve.py harbour-lanes 55 $seed; cp plans/harbour-lanes.json /tmp/h-$seed.json; done\npython3 - <<'PY'\nimport json,subprocess,re,glob,shutil\nbest=(10**9,None)\nfor f in ['/tmp/harbour-best.json']+glob.glob('/tmp/h-*.json'):\n out=subprocess.check_output(['python3','tools/check_plan.py','orders/harbour-lanes.json',f],text=True);print(f,out.strip())\n m=re.search(r'cost (\\d+)',out)\n if m and int(m.group(1))<best[0]:best=(int(m.group(1)),f)\nprint('SELECT',best);shutil.copy(best[1],'plans/harbour-lanes.json')\nPY\n"]
[467.595853, "o", "cp plans/harbour-lanes.json /tmp/harbour-best.json\r\n\u001b[?2004l\rbb][jj]=routes[bb][jj],routes[aa][ii]\\n    else:\\n\", \"\"\"    elif undo[0]=='swap':\r\n     _,aa,ii,bb,jj=undo;routes[aa][ii],routes[bb][jj]=routes[bb][jj],routes[aa][ii]\r\n    elif undo[0]=='seg':\r\n     _,aa,ii,bb,jj,ll=undo;seg=routes[bb][jj:jj+ll];del routes[bb][jj:jj+ll];routes[aa][ii:ii]=seg\r\n    else:\r\n\"\"\")\r\nopen(p,'w').write(s)\r\nPY\r\nfor seed in 11 22 33; do python3 /app/solve.py harbour-lanes 55 $seed; cp plans/harbour-lanes.json /tmp/h-$seed.json; done\r\npython3 - <<'PY'\r\nimport json,subprocess,re,glob,shutil\r\nbest=(10**9,None)\r\nfor f in ['/tmp/harbour-best.json']+glob.glob('/tmp/h-*.json'):\r\n out=subprocess.check_output(['python3','tools/check_plan.py','orders/harbour-lanes.json',f],text=True);print(f,out.strip())\r\n m=re.search(r'cost (\\d+)',out)\r\n if m and int(m.group(1))<best[0]:best=(int(m.group(1)),f)\r\nprint('SELECT',best);shutil.copy(best[1],'plans/harbour-lanes.json')\r\nPY\r\n"]
