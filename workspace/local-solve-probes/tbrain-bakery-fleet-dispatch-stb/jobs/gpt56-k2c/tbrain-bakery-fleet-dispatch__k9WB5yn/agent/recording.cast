[2145.491255, "i", "python3 - <<'PY'\nimport json,math\nfor m in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('orders/'+m+'.json'));p=json.load(open('plans/'+m+'.json'));C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};dep=o['depot'];print('\\n',m)\n def d(a,b):q=(a['x']-b['x'])**2+(a['y']-b['y'])**2;z=math.isqrt(q);return z+(z*z<q)\n for t in F:\n  rr=[r for r in p['routes'] if r['type']==t];ds=[];loads=[]\n  for r in rr:\n   s=r['stops'];ds.append(d(dep,C[s[0]])+sum(d(C[a],C[b]) for a,b in zip(s,s[1:]))+d(C[s[-1]],dep));loads.append(sum(C[x]['demand'] for x in s))\n  print(t,len(rr),'load',sum(loads),'slack',len(rr)*F[t]['capacity']-sum(loads),'dist',sum(ds),'cost',len(rr)*F[t]['fixed']+sum(ds)*F[t]['per_unit'])\nPY\n"]
