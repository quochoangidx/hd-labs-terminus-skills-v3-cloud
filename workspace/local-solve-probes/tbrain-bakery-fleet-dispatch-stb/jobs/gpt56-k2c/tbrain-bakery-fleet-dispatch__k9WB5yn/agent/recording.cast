[4530.567166, "i", "cat > exchange21.py <<'PY'\nimport sys,json,time,random\nmorning=sys.argv[1];secs=float(sys.argv[2]);argv=sys.argv[:]\nsrc=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv\np=json.load(open('plans/'+morning+'.json'));S=[r['type'] for r in p['routes']];R=[r['stops'][:] for r in p['routes']]\ndef rc(i,r):\n z=ev(S[i],tuple(r));return None if z is None else z[0]\ncur=sum(rc(i,r) for i,r in enumerate(R));best=cur;BR=[r[:] for r in R];end=time.time()+secs;random.seed(time.time_ns());n=0\nwhile time.time()<end:\n n+=1;a,b=random.sample(range(len(R)),2)\n if len(R[a])<2 or not R[b]:continue\n ia,ja=sorted(random.sample(range(len(R[a])),2));ib=random.randrange(len(R[b]));x,y=R[a][ia],R[a][ja];z=R[b][ib]\n aa=[v for k,v in enumerate(R[a]) if k not in (ia,ja)];bb=R[b][:ib]+R[b][ib+1:];old=rc(a,R[a])+rc(b,R[b]);opts=[]\n for pa in range(len(aa)+1):\n  na=aa[:pa]+[z]+aa[pa:];ca=rc(a,na)\n  if ca is None:continue\n  for order in ((x,y),(y,x)):\n   for p1 in range(len(bb)+1)"]
[4530.568114, "i", ":\n    t=bb[:p1]+[order[0]]+bb[p1:]\n    for p2 in range(len(t)+1):\n     nb=t[:p2]+[order[1]]+t[p2:];cb=rc(b,nb)\n     if cb is not None and ca+cb<old:opts.append((ca+cb-old,na,nb))\n if opts:\n  d,na,nb=min(opts);R[a]=na;R[b]=nb;cur+=d\n  if cur<best:\n   best=cur;BR=[r[:] for r in R];print('BEST',best,'delta',d,flush=True)\n   for i,r in enumerate(p['routes']):r['stops']=BR[i];r['depart']=ev(S[i],tuple(BR[i]))[1]\n   json.dump(p,open('plans/'+morning+'.json','w'),indent=1)\n   if best<=target:break\nprint('FINAL',best,'trials',n)\nPY\npython3 exchange21.py harbour-lanes 58\npython3 tools/check_plan.py orders/harbour-lanes.json plans/harbour-lanes.json\n"]
