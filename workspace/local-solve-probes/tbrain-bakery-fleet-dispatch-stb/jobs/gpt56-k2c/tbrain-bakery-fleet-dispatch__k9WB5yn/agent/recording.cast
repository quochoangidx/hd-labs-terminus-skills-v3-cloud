[47.413721, "o", "\u001b[?2004hroot@5eee95a6122f:/app# cat README.md\r\n\u001b[?2004l\r# Morning dispatch\r\n\r\nWholesale deliveries from the bakery: cafes, grocers, hotels and the two market\r\nhalls, by cargo bike, van and truck.\r\n\r\n- `orders/` - one file per morning: customers, windows, crates, and the vehicles on hand\r\n- `docs/dispatch-rules.md` - what makes a plan runnable and what it costs\r\n- `tools/check_plan.py` - checks a plan and prints its cost\r\n- `planner/plan_morning.py` - the planner in use today\r\n- `plans/` - the plans dispatch will run\r\n\r\n    python3 planner/plan_morning.py orders/old-town.json plans/old-town.json\r\n    python3 tools/check_plan.py orders/old-town.json plans/old-town.json\r\n\u001b[?2004hroot@5eee95a6122f:/app# "]
[123.746387, "i", "cat > /app/optimize.py <<'PY'\nimport json,math,random,sys,time\nfrom functools import lru_cache\n\nname=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 30\no=json.load(open('orders/'+name+'.json')); target=json.load(open('orders/targets.json'))[name]\ndep=o['depot']; C={c['id']:c for c in o['customers']}; ids=list(C)\npts={0:dep}|C\nD={(a,b):math.isqrt((pts[a]['x']-pts[b]['x'])**2+(pts[a]['y']-pts[b]['y'])**2) for a in pts for b in pts}\nfor k,v in list(D.items()):\n a,b=k; sq=(pts[a]['x']-pts[b]['x'])**2+(pts[a]['y']-pts[b]['y'])**2\n if v*v<sq:D[k]=v+1\nkinds={f['type']:f for f in o['fleet']}\nslots=[]\n# trucks first only affects stable representation, not construction cost\nfor f in sorted(o['fleet'],key=lambda z:-z['capacity']): slots += [f['type']]*f['count']\n\n@lru_cache(maxsize=800000)\ndef ev(t,s):\n f=kinds[t]\n if not s:return (0,dep['open'])\n if sum(C[x]['demand'] for x in s)>f['capacity']:return None\n dist=D[0,s[0]]+sum(D[a,b] for a,b in zip(s,s[1:]))+D[s[-1],0]\n if f['range'] is not None and dist>f["]
[123.746606, "i", "'range']:return None\n def sim(start, windows=True):\n  clock=start; here=0\n  for x in s:\n   c=C[x]; clock=max(clock+D[here,x]*f['pace'],c['ready'])\n   if windows and clock>c['due']:return None\n   clock+=c['service']; here=x\n  return clock+D[here,0]*f['pace']\n # Earliest departure must satisfy windows and closing; waiting may make shift too long.\n back=sim(dep['open'])\n if back is None or back>dep['close']:return None\n lo=dep['open']; hi=dep['close']\n # latest departure preserving all windows\n while lo<hi:\n  mid=(lo+hi+1)//2\n  if sim(mid) is None:hi=mid-1\n  else:lo=mid\n latest=lo\n # earliest departure giving an acceptable shift\n lo=dep['open']; hi=latest\n if sim(hi)-hi>f['shift']:return None\n while lo<hi:\n  mid=(lo+hi)//2; b=sim(mid)\n  if b-mid<=f['shift']:hi=mid\n  else:lo=mid+1\n start=lo; back=sim(start)\n if back>dep['close']:return None\n return (f['fixed']+f['per_unit']*dist,start)\n\ndef total(R): return sum(ev(slots[i],tuple(r))[0] for i,r in enumerate(R) if r)\n\ndef construct():\n R=[[] for _ in slots]\n # Hard"]
[123.746614, "i", "/large orders first, with randomization between restarts.\n todo=sorted(ids,key=lambda x:(C[x]['due']+random.random()*2400,-C[x]['demand']))\n for x in todo:\n  opts=[]\n  for i,r in enumerate(R):\n   old=ev(slots[i],tuple(r)); oc=old[0] if old else 0\n   # Equivalent empty slots of a type need only one test.\n   if not r and any(not R[j] and slots[j]==slots[i] for j in range(i)):continue\n   for p in range(len(r)+1):\n    nr=tuple(r[:p]+[x]+r[p:]); z=ev(slots[i],nr)\n    if z: opts.append((z[0]-oc,i,p))\n  if not opts:return None\n  opts.sort()\n  # Restricted candidate list promotes diverse but sensible packings.\n  width=min(len(opts),max(1,1+int(random.random()**3*8)))\n  _,i,p=random.choice(opts[:width]); R[i].insert(p,x)\n return R\n\ndef search(R,end):\n cur=total(R); best=cur; BR=[r[:] for r in R]; nmove=0\n while time.time()<end:\n  nmove+=1; frac=max(0,(end-time.time())/max(.001,limit)); T=800*frac+4\n  typ=random.random(); changed=[]\n  non=[i for i,r in enumerate(R) if r]\n  if typ<.60:\n   a=random.choice(non); p=random."]
[123.746638, "i", "randrange(len(R[a])); x=R[a][p]\n   b=random.randrange(len(R)); q=random.randrange(len(R[b])+1)\n   if a==b and (q==p or q==p+1):continue\n   olda=R[a][:]; oldb=R[b][:] if b!=a else None\n   oldcost=ev(slots[a],tuple(R[a]))[0]+(ev(slots[b],tuple(R[b]))[0] if b!=a and R[b] else 0)\n   R[a].pop(p)\n   if a==b and q>p:q-=1\n   R[b].insert(q,x)\n   za=ev(slots[a],tuple(R[a])); zb=ev(slots[b],tuple(R[b]))\n   if za is None or zb is None:\n    R[a]=olda\n    if b!=a:R[b]=oldb\n    continue\n   newcost=za[0]+(zb[0] if b!=a else 0); delta=newcost-oldcost\n   if delta>0 and random.random()>math.exp(-delta/T):\n    R[a]=olda\n    if b!=a:R[b]=oldb\n    continue\n  elif typ<.82 and len(non)>=2:\n   a,b=random.sample(non,2); p=random.randrange(len(R[a]));q=random.randrange(len(R[b]))\n   olda=R[a][:];oldb=R[b][:]; oldcost=ev(slots[a],tuple(olda))[0]+ev(slots[b],tuple(oldb))[0]\n   R[a][p],R[b][q]=R[b][q],R[a][p]\n   za=ev(slots[a],tuple(R[a]));zb=ev(slots[b],tuple(R[b]))\n   if za is None or zb is None: R[a]=olda;R[b]=oldb;continue\n   delta=z"]
[123.755509, "o", "cat > /app/optimize.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json,math,random,sys,time\r\n\u001b[?2004l\r\u001b[?2004h> from functools import lru_cache\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> name=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 30\r\n\u001b[?2004l\r\u001b[?2004h> o=json.load(open('orders/'+name+'.json')); target=json.load(open('orders/targets.json'))[name]\r\n\u001b[?2004l\r\u001b[?2004h> dep=o['depot']; C={c['id']:c for c in o['customers']}; ids=list(C)\r\n\u001b[?2004l\r\u001b[?2004h> pts={0:dep}|C\r\n\u001b[?2004l\r\u001b[?2004h> D={(a,b):math.isqrt((pts[a]['x']-pts[b]['x'])**2+(pts[a]['y']-pts[b]['y'])**2) for a in pts for b in pts}\r\n\u001b[?2004l\r\u001b[?2004h> for k,v in list(D.items()):\r\n\u001b[?2004l\r\u001b[?2004h>  a,b=k; sq=(pts[a]['x']-pts[b]['x'])**2+(pts[a]['y']-pts[b]['y'])**2\r\n\u001b[?2004l\r\u001b[?2004h>  if v*v<sq:D[k]=v+1\r\n\u001b[?2004l\r\u001b[?2004h> kinds={f['type']:f for f in o['fleet']}\r\n\u001b[?2004l\r\u001b[?2004h> slots=[]\r\n\u001b[?2004l\r\u001b[?2004h> # trucks first only affects stable representation, not construction cost\r\n\u001b[?2004l\r\u001b[?2004h> for f in sorted(o['fleet'],key=lambda"]
[123.755563, "i", "a[0]+zb[0]-oldcost\n   if delta>0 and random.random()>math.exp(-delta/T):R[a]=olda;R[b]=oldb;continue\n  else:\n   cand=[i for i in non if len(R[i])>=3]\n   if not cand:continue\n   a=random.choice(cand); p,q=sorted(random.sample(range(len(R[a])+1),2))\n   if q-p<2:continue\n   old=R[a][:]; oc=ev(slots[a],tuple(old))[0];R[a][p:q]=reversed(R[a][p:q]); z=ev(slots[a],tuple(R[a]))\n   if z is None: R[a]=old;continue\n   delta=z[0]-oc\n   if delta>0 and random.random()>math.exp(-delta/T):R[a]=old;continue\n  cur+=delta\n  if cur<best:best=cur;BR=[r[:] for r in R]\n return BR,best,nmove\n\nrandom.seed(9173+sum(map(ord,name))); start=time.time(); globalbest=10**30; GB=None; runs=0\nwhile time.time()<start+limit:\n R=construct(); runs+=1\n if R is None:continue\n # Give each construction a slice, increasing exploitation after good starts.\n end=min(start+limit,time.time()+max(1.5,limit/10))\n R,c,m=search(R,end)\n if c<globalbest:\n  globalbest=c;GB=R\n  print(name,'best',c,'target',target,'run',runs,'cache',ev.cache_info(),flush=True)\n  ro"]
