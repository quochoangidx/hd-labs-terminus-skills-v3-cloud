[920.445388, "i", "r x in r if x not in set(rem)]\n R=rebuild(R,rem)\n if R is None:continue\n z=tot(R);temp=max(20,500*(end-time.time())/secs)\n if z<cur or random.random()<math.exp((cur-z)/temp):base=R;cur=z\n if z<best:\n  best=z;BR=[r[:] for r in R];save(BR,best)\n  if best<=target:break\n if it%250==0:base=[r[:] for r in BR];cur=best\nprint('FINAL',best,'target',target,'iterations',it)\nPY\npython3 lns.py harbour-lanes 58\npython3 tools/check_plan.py orders/harbour-lanes.json plans/harbour-lanes.json\n"]
[920.445435, "o", "]\r\n\u001b[?2004l\r\u001b[?2004h>  json.dump({'routes':out},open('plans/'+morning+'.json','w'),indent=1);print('BEST',c,flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> def rebuild(R,removed):\r\n\u001b[?2004l\r\u001b[?2004h>  removed=set(removed)\r\n\u001b[?2004l\r\u001b[?2004h>  while removed:\r\n\u001b[?2004l\r\u001b[?2004h>   choices=[]\r\n\u001b[?2004l\r\u001b[?2004h>   for x in removed:\r\n\u001b[?2004l\r\u001b[?2004h>    opts=[]\r\n\u001b[?2004l\r\u001b[?2004h>    for i,r in enumerate(R):\r\n\u001b[?2004l\r\u001b[?2004h>     old=rc(i,r)\r\n\u001b[?2004l\r\u001b[?2004h>     for q in range(len(r)+1):\r\n\u001b[?2004l\r\u001b[?2004h>      nr=r[:q]+[x]+r[q:];z=rc(i,nr)\r\n\u001b[?2004l\r\u001b[?2004h>      if z is not None:opts.append((z-old,i,q))\r\n\u001b[?2004l\r\u001b[?2004h>    if not opts:return None\r\n\u001b[?2004l\r\u001b[?2004h>    opts.sort();reg=(opts[1][0]-opts[0][0] if len(opts)>1 else 100000)\r\n\u001b[?2004l\r\u001b[?2004h>    # prioritize hard-to-place; slight random noise diversifies\r\n\u001b[?2004l\r\u001b[?2004h>    choices.append((reg+random.random()*100,x,opts[0]))\r\n\u001b[?2004l\r\u001b[?2004h>   _,x,(_,i,q)=max(choices);R[i].insert(q,x);removed.remove(x)\r\n\u001b[?2004l\r\u001b[?2004h>  return R\r\n\u001b[?2004l\r\u001b[?20"]
[920.445458, "o", "04h> cur=tot(base);best=cur;BR=[r[:] for r in base];save(BR,best);end=time.time()+secs;random.seed(time.time_ns());it=0\r\n\u001b[?2004l\r\u001b[?2004h> while time.time()<end:\r\n\u001b[?2004l\r\u001b[?2004h>  it+=1;R=[r[:] for r in base]\r\n\u001b[?2004l\r\u001b[?2004h>  allx=[x for r in R for x in r];k=random.randint(5,min(22,max(5,len(allx)//4)))\r\n\u001b[?2004l\r\u001b[?2004h>  seed=random.choice(allx)\r\n\u001b[?2004l\r\u001b[?2004h>  if random.random()<.7:\r\n\u001b[?2004l\r\u001b[?2004h>   # Shaw removal: spatial, temporal, and same-route relatedness\r\n\u001b[?2004l\r\u001b[?2004h>   sr=next(i for i,r in enumerate(R) if seed in r)\r\n\u001b[?2004l\r\u001b[?2004h>   def rel(x):\r\n\u001b[?2004l\r\u001b[?2004h>    c=C[x];s=C[seed];same=0 if x in R[sr] else 150\r\n\u001b[?2004l\r\u001b[?2004h>    return D[x,seed]+abs(c['ready']-s['ready'])/80+same+random.random()*80\r\n\u001b[?2004l\r\u001b[?2004h>   rem=sorted(allx,key=rel)[:k]\r\n\u001b[?2004l\r\u001b[?2004h>  else:rem=random.sample(allx,k)\r\n\u001b[?2004l\r\u001b[?2004h>  for r in R:r[:]=[x for x in r if x not in set(rem)]"]
