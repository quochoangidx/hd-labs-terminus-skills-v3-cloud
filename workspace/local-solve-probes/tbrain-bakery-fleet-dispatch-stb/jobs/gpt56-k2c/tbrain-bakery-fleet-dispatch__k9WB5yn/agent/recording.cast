[920.438202, "i", "in range(len(r)+1):\n     nr=r[:q]+[x]+r[q:];z=rc(i,nr)\n     if z is not None:opts.append((z-old,i,q))\n   if not opts:return None\n   opts.sort();reg=(opts[1][0]-opts[0][0] if len(opts)>1 else 100000)\n   # prioritize hard-to-place; slight random noise diversifies\n   choices.append((reg+random.random()*100,x,opts[0]))\n  _,x,(_,i,q)=max(choices);R[i].insert(q,x);removed.remove(x)\n return R\ncur=tot(base);best=cur;BR=[r[:] for r in base];save(BR,best);end=time.time()+secs;random.seed(time.time_ns());it=0\nwhile time.time()<end:\n it+=1;R=[r[:] for r in base]\n allx=[x for r in R for x in r];k=random.randint(5,min(22,max(5,len(allx)//4)))\n seed=random.choice(allx)\n if random.random()<.7:\n  # Shaw removal: spatial, temporal, and same-route relatedness\n  sr=next(i for i,r in enumerate(R) if seed in r)\n  def rel(x):\n   c=C[x];s=C[seed];same=0 if x in R[sr] else 150\n   return D[x,seed]+abs(c['ready']-s['ready'])/80+same+random.random()*80\n  rem=sorted(allx,key=rel)[:k]\n else:rem=random.sample(allx,k)\n for r in R:r[:]=[x fo"]
