[3485.278935, "i", "cat > transition.py <<'PY'\nimport sys,json,time,random\nmorning=sys.argv[1];secs=float(sys.argv[2]);want={x.split(':')[0]:int(x.split(':')[1]) for x in sys.argv[3].split(',')};argv=sys.argv[:]\nsrc=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv\np=json.load(open('plans/'+morning+'.json'));slots=[];base=[]\nfor r in p['routes']:slots.append(r['type']);base.append(r['stops'][:])\n# append all unused physical vehicles\nfor t,f in kinds.items():\n for _ in range(f['count']-slots.count(t)):slots.append(t);base.append([])\ndef rc(i,r):\n if not r:return 0\n z=ev(slots[i],tuple(r));return None if z is None else z[0]\ndef total(R):return sum(rc(i,r) for i,r in enumerate(R))\ndef rebuild(R,rem,allowed):\n rem=set(rem)\n while rem:\n  choices=[]\n  for x in rem:\n   op=[]\n   for i in allowed:\n    r=R[i];old=rc(i,r)\n    for q in range(len(r)+1):\n     z=rc(i,r[:q]+[x]+r[q:])\n     if z is not None:op.append((z-old+random.random()*60,i,q))\n   if not op:return None\n   op.so"]
[3485.27922, "i", "rt();reg=(op[1][0]-op[0][0] if len(op)>1 else 999999);choices.append((reg+random.random()*100,x,op[0]))\n  _,x,(_,i,q)=max(choices);R[i].insert(q,x);rem.remove(x)\n return R\nindices={t:[i for i,s in enumerate(slots) if s==t] for t in kinds};best=10**30;BR=None;end=time.time()+secs;it=0;random.seed(time.time_ns())\nwhile time.time()<end:\n it+=1;allowed=[]\n for t,ii in indices.items():\n  occupied=[i for i in ii if base[i]];empty=[i for i in ii if not base[i]]\n  n=want.get(t,0)\n  # retain a random subset of occupied and use empties for additions\n  if len(occupied)>n:chosen=random.sample(occupied,n)\n  else:chosen=occupied+random.sample(empty,n-len(occupied))\n  allowed+=chosen\n R=[r[:] if i in allowed else [] for i,r in enumerate(base)]\n kept={x for r in R for x in r};rem=[x for r in base for x in r if x not in kept]\n # occasionally ruin more retained assignments\n if random.random()<.7 and kept:\n  extra=random.sample(list(kept),min(len(kept),random.randint(5,20)));ex=set(extra)\n  for r in R:r[:]=[x for x in r if x no"]
[3485.279245, "i", "t in ex]\n  rem+=extra\n R=rebuild(R,rem,allowed)\n if R is None:continue\n z=total(R)\n if z<best:\n  best=z;BR=R;print('BEST',best,'iteration',it,flush=True)\n  out=[{'type':slots[i],'depart':ev(slots[i],tuple(r))[1],'stops':r} for i,r in enumerate(BR) if r]\n  json.dump({'routes':out},open('plans/'+morning+'.json','w'),indent=1)\nprint('FINAL',best,'iterations',it)\nPY\ncp plans/riverside.json /tmp/riverside-oldmix.json\npython3 transition.py riverside 58 truck:8,van:9,bike:4\npython3 tools/check_plan.py orders/riverside.json plans/riverside.json\n"]
