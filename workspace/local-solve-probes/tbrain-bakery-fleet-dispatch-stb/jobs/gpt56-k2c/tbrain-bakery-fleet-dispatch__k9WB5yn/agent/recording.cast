[838.959361, "i", "cat > strong.py <<'PY'\nimport sys,json,time,random,math\nmorning=sys.argv[1];secs=float(sys.argv[2]);argv=sys.argv[:]\nsrc=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv\np=json.load(open('plans/'+morning+'.json'));slots=[];R=[];used={t:0 for t in kinds}\nfor r in p['routes']:slots.append(r['type']);R.append(r['stops'][:]);used[r['type']]+=1\nfor t,f in kinds.items():\n for _ in range(f['count']-used[t]):slots.append(t);R.append([])\ndef cost(i,r):\n if not r:return 0\n z=ev(slots[i],tuple(r));return None if z is None else z[0]\ndef save(c):\n out=[]\n for i,r in enumerate(BR):\n  if r:out.append({'type':slots[i],'depart':ev(slots[i],tuple(r))[1],'stops':r})\n json.dump({'routes':out},open('plans/'+morning+'.json','w'),indent=1);print('BEST',c,flush=True)\ncur=sum(cost(i,r) for i,r in enumerate(R));best=cur;BR=[r[:] for r in R];save(best)\nend=time.time()+secs;random.seed(time.time_ns());step=0\nwhile time.time()<end:\n step+=1; non=[i for i,r in enumerate(R) "]
[838.959684, "i", "if r]; a=random.choice(non); b=random.randrange(len(R))\n if b==a:continue\n ra,rb=R[a],R[b];oca=cost(a,ra);ocb=cost(b,rb);old=oca+ocb\n typ=random.random()\n if typ<.35: # relocate contiguous segment\n  ln=random.randint(1,min(3,len(ra)));i=random.randrange(len(ra)-ln+1);q=random.randrange(len(rb)+1)\n  seg=ra[i:i+ln];na=ra[:i]+ra[i+ln:];nb=rb[:q]+seg+rb[q:]\n elif typ<.70 and rb: # exchange short segments\n  la=random.randint(1,min(3,len(ra)));lb=random.randint(1,min(3,len(rb)));i=random.randrange(len(ra)-la+1);q=random.randrange(len(rb)-lb+1)\n  na=ra[:i]+rb[q:q+lb]+ra[i+la:];nb=rb[:q]+ra[i:i+la]+rb[q+lb:]\n else: # 2-opt-star / tail exchange, optionally reverse tails\n  i=random.randrange(len(ra)+1);q=random.randrange(len(rb)+1);ta=ra[i:];tb=rb[q:]\n  if random.random()<.35:ta=list(reversed(ta))\n  if random.random()<.35:tb=list(reversed(tb))\n  na=ra[:i]+tb;nb=rb[:q]+ta\n za=cost(a,na);zb=cost(b,nb)\n if za is None or zb is None:continue\n delta=za+zb-old\n # Reheating cycles permit barriers but cool to intensify regularl"]
[838.9597, "o", "cat > strong.py <<'PY'"]
[838.959704, "i", "y.\n phase=(step%120000)/120000;T=700*(1-phase)+8\n if delta<=0 or random.random()<math.exp(-delta/T):\n  R[a]=na;R[b]=nb;cur+=delta\n  if cur<best:\n   best=cur;BR=[r[:] for r in R];save(best)\n # occasional restart from incumbent\n if step%120000==0:R=[r[:] for r in BR];cur=best\nprint('FINAL',best,'steps',step)\nPY\npython3 strong.py harbour-lanes 58\npython3 tools/check_plan.py orders/harbour-lanes.json plans/harbour-lanes.json\n"]
