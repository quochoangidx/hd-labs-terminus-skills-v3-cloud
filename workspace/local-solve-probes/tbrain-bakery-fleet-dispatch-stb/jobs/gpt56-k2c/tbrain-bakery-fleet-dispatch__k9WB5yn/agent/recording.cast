[522.884337, "i", "cat > anneal_inc.py <<'PY'\nimport sys,json,time,random\nmorning=sys.argv[1]; seconds=float(sys.argv[2]); argv=sys.argv[:]\nsrc=open('optimize.py').read().split('random.seed(',1)[0]\nsys.argv=['optimize.py',morning,'1'];exec(src,globals());sys.argv=argv\np=json.load(open('plans/'+morning+'.json')); used={t:0 for t in kinds}; R=[]; slots=[]\nfor r in p['routes']:slots.append(r['type']);R.append(r['stops'][:]);used[r['type']]+=1\nfor t,f in kinds.items():\n for _ in range(f['count']-used[t]):slots.append(t);R.append([])\ndef save(R,c):\n routes=[{'type':slots[i],'depart':ev(slots[i],tuple(r))[1],'stops':r} for i,r in enumerate(R) if r]\n json.dump({'routes':routes},open('plans/'+morning+'.json','w'),indent=1);print('saved',c,flush=True)\n# repair departures immediately\nbest=total(R);BR=[r[:] for r in R];save(BR,best);deadline=time.time()+seconds;random.seed(time.time_ns())\nwhile time.time()<deadline:\n # Search uses global limit to set cooling; restart from global best.\n limit=min(8,max(1,deadline-time.time()))\n cand,c,n=se"]
[522.884733, "i", "arch([r[:] for r in BR],min(deadline,time.time()+limit))\n if c<best:best=c;BR=cand;save(BR,best)\nprint('FINAL',best)\nPY\npython3 anneal_inc.py harbour-lanes 55\npython3 tools/check_plan.py orders/harbour-lanes.json plans/harbour-lanes.json\n"]
