[352.079811, "i", "cat > improve.py <<'PY'\nimport sys,json,time\n# Load definitions only from optimizer, suppressing its main search.\nargv=sys.argv[:]; morning=sys.argv[1]; seconds=float(sys.argv[2])\nsrc=open('optimize2.py').read().split('random.seed(',1)[0]\nsys.argv=['optimize2.py',morning,'1']; exec(src,globals()); sys.argv=argv\np=json.load(open('plans/'+morning+'.json'))\nslots=[];R=[]\nfor route in p['routes']: slots.append(route['type']);R.append(route['stops'][:])\n# Add unused fleet slots, enabling route/type changes through relocation.\nused={t:slots.count(t) for t in kinds}\nfor t,f in kinds.items():\n for _ in range(f['count']-used[t]):slots.append(t);R.append([])\n\ndef rc(i,r=None):\n r=R[i] if r is None else r\n return ev(slots[i],tuple(r))[0] if r else 0\ncur=sum(rc(i) for i in range(len(R))); best=cur; deadline=time.time()+seconds; iteration=0\nprint('start',cur,[(slots[i],len(r),sum(C[x]['demand'] for x in r)) for i,r in enumerate(R) if r],flush=True)\nwhile time.time()<deadline:\n iteration+=1; bd=0; bm=None\n # exhaustive one"]
[352.080034, "i", "-node relocation\n for a,ra in enumerate(R):\n  if not ra:continue\n  oca=rc(a)\n  for xidx,x in enumerate(ra):\n   na=ra[:xidx]+ra[xidx+1:]; za=ev(slots[a],tuple(na)) if na else (0,0)\n   if za is None:continue\n   for b,rb in enumerate(R):\n    if b==a:continue\n    oc=oca+rc(b)\n    for q in range(len(rb)+1):\n     nb=rb[:q]+[x]+rb[q:];zb=ev(slots[b],tuple(nb))\n     if zb:\n      d=za[0]+zb[0]-oc\n      if d<bd:bd=d;bm=('rel',a,xidx,b,q)\n # exhaustive within-route 2-opt\n for a,r in enumerate(R):\n  if len(r)<3:continue\n  oc=rc(a)\n  for i in range(len(r)-1):\n   for j in range(i+2,len(r)+1):\n    nr=r[:i]+list(reversed(r[i:j]))+r[j:];z=ev(slots[a],tuple(nr))\n    if z and z[0]-oc<bd:bd=z[0]-oc;bm=('rev',a,i,j)\n if bm is None:\n  print('local optimum after',iteration);break\n if bm[0]=='rel':\n  _,a,i,b,q=bm;x=R[a].pop(i);R[b].insert(q,x)\n else:\n  _,a,i,j=bm;R[a][i:j]=reversed(R[a][i:j])\n cur+=bd\n print('iter',iteration,'delta',bd,'cost',cur,bm,flush=True)\n routes=[]\n for i,r in enumerate(R):\n  if r:routes.append({'type':slots["]
