[3249.745247, "i", "cat > eliminate.py <<'PY'\nimport sys,json,time,random\nmorning=sys.argv[1];secs=float(sys.argv[2]);argv=sys.argv[:]\nsrc=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv\np=json.load(open('plans/'+morning+'.json'));slots=[];base=[];used={t:0 for t in kinds}\nfor r in p['routes']:slots.append(r['type']);base.append(r['stops'][:]);used[r['type']]+=1\nfor t,f in kinds.items():\n for _ in range(f['count']-used[t]):slots.append(t);base.append([])\ndef rc(i,r):\n if not r:return 0\n z=ev(slots[i],tuple(r));return None if z is None else z[0]\ndef total(R):return sum(rc(i,r) for i,r in enumerate(R))\ndef rebuild(R,removed,ban):\n rem=set(removed)\n while rem:\n  cs=[]\n  for x in rem:\n   op=[]\n   for i,r in enumerate(R):\n    if i in ban:continue\n    old=rc(i,r)\n    for q in range(len(r)+1):\n     z=rc(i,r[:q]+[x]+r[q:])\n     if z is not None:op.append((z-old+random.random()*20,i,q))\n   if not op:return None\n   op.sort();reg=(op[1][0]-op[0][0] if len(op)>1 else 99999);"]
[3249.745921, "i", "cs.append((reg,x,op[0]))\n  _,x,(_,i,q)=max(cs);R[i].insert(q,x);rem.remove(x)\n return R\nbest=total(base);BR=[r[:] for r in base];end=time.time()+secs;random.seed(time.time_ns());it=0\ncands=[i for i,r in enumerate(base) if r and slots[i]=='van']\nwhile time.time()<end:\n it+=1;a=random.choice(cands);R=[r[:] for r in BR];rem=R[a][:];R[a]=[]\n # Ruin additional nearby customers to permit repacking.\n if random.random()<.8:\n  seed=random.choice(rem);others=[x for i,r in enumerate(R) if i!=a for x in r]\n  extra=sorted(others,key=lambda x:D[x,seed]+random.random()*100)[:random.randint(3,12)]\n  ex=set(extra)\n  for r in R:r[:]=[x for x in r if x not in ex]\n  rem+=extra\n R=rebuild(R,rem,{a})\n if R is None:continue\n z=total(R)\n if z<best:\n  best=z;BR=R;print('BEST',best,'eliminated',a,flush=True)\n  out=[{'type':slots[i],'depart':ev(slots[i],tuple(r))[1],'stops':r} for i,r in enumerate(BR) if r]\n  json.dump({'routes':out},open('plans/'+morning+'.json','w'),indent=1)\nprint('FINAL',best,'iterations',it)\nPY\ncp plans/riverside."]
