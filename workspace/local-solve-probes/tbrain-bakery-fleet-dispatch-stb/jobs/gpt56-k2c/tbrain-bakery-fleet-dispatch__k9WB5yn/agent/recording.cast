[4326.302532, "i", "cat > swap_improve.py <<'PY'\nimport sys,json,time\nmorning=sys.argv[1];secs=float(sys.argv[2]);argv=sys.argv[:]\nsrc=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv\np=json.load(open('plans/'+morning+'.json'));slots=[r['type'] for r in p['routes']];R=[r['stops'][:] for r in p['routes']];deadline=time.time()+secs\ndef rc(i,r):\n z=ev(slots[i],tuple(r));return None if z is None else z[0]\ncur=sum(rc(i,r) for i,r in enumerate(R));print('START',cur,flush=True)\nwhile time.time()<deadline:\n bd=0;bm=None\n for a in range(len(R)):\n  if time.time()>=deadline:break\n  for b in range(a+1,len(R)):\n   ra,rb=R[a],R[b];old=rc(a,ra)+rc(b,rb)\n   for ia,x in enumerate(ra):\n    aa=ra[:ia]+ra[ia+1:]\n    for ib,y in enumerate(rb):\n     bb=rb[:ib]+rb[ib+1:]\n     # Reinsert exchanged customers at every position, allowing route reordering around removals.\n     for pa in range(len(aa)+1):\n      na=aa[:pa]+[y]+aa[pa:];za=rc(a,na)\n      if za is None:continue\n      for pb in ra"]
[4326.302709, "i", "nge(len(bb)+1):\n       nb=bb[:pb]+[x]+bb[pb:];zb=rc(b,nb)\n       if zb is not None and za+zb-old<bd:\n        bd=za+zb-old;bm=(a,b,na,nb)\n if bm is None:break\n a,b,na,nb=bm;R[a]=na;R[b]=nb;cur+=bd;print('IMPROVE',bd,cur,flush=True)\n for i,r in enumerate(p['routes']):r['stops']=R[i];r['depart']=ev(slots[i],tuple(R[i]))[1]\n json.dump(p,open('plans/'+morning+'.json','w'),indent=1)\nprint('FINAL',cur)\nPY\npython3 swap_improve.py harbour-lanes 58\npython3 tools/check_plan.py orders/harbour-lanes.json plans/harbour-lanes.json\n"]
