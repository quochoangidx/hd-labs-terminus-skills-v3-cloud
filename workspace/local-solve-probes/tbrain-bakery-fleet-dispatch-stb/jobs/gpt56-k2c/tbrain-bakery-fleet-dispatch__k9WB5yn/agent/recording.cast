[19.038197, "i", "python3 - <<'PY'\nimport json,glob,os\nfor fn in sorted(glob.glob('orders/*.json')):\n if fn.endswith('targets.json'): continue\n d=json.load(open(fn)); print('\\n###',os.path.basename(fn)); print('depot',d['depot']); print('fleet',d['fleet']); print('customers',len(d['customers']))\n for c in d['customers']: print(c)\nPY\n"]
