[352.084106, "o", "zb:\r\n\u001b[?2004l\r\u001b[?2004h>       d=za[0]+zb[0]-oc\r\n\u001b[?2004l\r\u001b[?2004h>       if d<bd:bd=d;bm=('rel',a,xidx,b,q)\r\n\u001b[?2004l\r\u001b[?2004h>  # exhaustive within-route 2-opt\r\n\u001b[?2004l\r\u001b[?2004h>  for a,r in enumerate(R):\r\n\u001b[?2004l\r\u001b[?2004h>   if len(r)<3:continue\r\n\u001b[?2004l\r\u001b[?2004h>   oc=rc(a)\r\n\u001b[?2004l\r\u001b[?2004h>   for i in range(len(r)-1):\r\n\u001b[?2004l\r\u001b[?2004h>    for j in range(i+2,len(r)+1):\r\n\u001b[?2004l\r\u001b[?2004h>     nr=r[:i]+list(reversed(r[i:j]))+r[j:];z=ev(slots[a],tuple(nr))\r\n\u001b[?2004l\r\u001b[?2004h>     if z and z[0]-oc<bd:bd=z[0]-oc;bm=('rev',a,i,j)\r\n\u001b[?2004l\r\u001b[?2004h>  if bm is None:\r\n\u001b[?2004l\r\u001b[?2004h>   print('local optimum after',iteration);break\r\n\u001b[?2004l\r\u001b[?2004h>  if bm[0]=='rel':\r\n\u001b[?2004l\r\u001b[?2004h>   _,a,i,b,q=bm;x=R[a].pop(i);R[b].insert(q,x)\r\n\u001b[?2004l\r\u001b[?2004h>  else:\r\n\u001b[?2004l\r\u001b[?2004h>   _,a,i,j=bm;R[a][i:j]=reversed(R[a][i:j])\r\n\u001b[?2004l\r\u001b[?2004h>  cur+=bd\r\n\u001b[?2004l\r\u001b[?2004h>  print('iter',iteration,'delta',bd,'cost',cur,bm,flush=True)\r\n\u001b[?2004l\r\u001b[?2004h>  routes=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for i,r in enumerate(R):"]
