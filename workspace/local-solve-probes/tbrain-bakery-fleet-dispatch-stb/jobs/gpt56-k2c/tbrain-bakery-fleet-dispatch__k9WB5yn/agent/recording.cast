[29.834708, "i", "python3 - <<'PY'\nimport json,glob,os\nprint('targets:',json.load(open('orders/targets.json')))\nfor fn in sorted(glob.glob('orders/*.json')):\n if fn.endswith('targets.json'): continue\n d=json.load(open(fn)); print('\\n',os.path.basename(fn), 'customers=',len(d['customers']), 'demand=',sum(c['demand'] for c in d['customers'])); print('depot=',d['depot']); print('fleet='); [print(' ',f) for f in d['fleet']]\nPY\n"]
