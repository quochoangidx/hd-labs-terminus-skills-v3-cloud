[757.957325, "i", "python3 - <<'PY'\nimport json,collections,math\nfor m in ['harbour-lanes','old-town']:\n o=json.load(open('orders/'+m+'.json'));p=json.load(open('plans/'+m+'.json'));C={c['id']:c for c in o['customers']};F={f['type']:f for f in o['fleet']};dep=o['depot']\n def d(a,b):\n  q=(a['x']-b['x'])**2+(a['y']-b['y'])**2;return math.isqrt(q)+(math.isqrt(q)**2<q)\n print('\\n',m)\n z=0\n for t in F:\n  rr=[r for r in p['routes'] if r['type']==t]; ds=[];loads=[]\n  for r in rr:\n   s=r['stops'];dist=d(dep,C[s[0]])+sum(d(C[a],C[b]) for a,b in zip(s,s[1:]))+d(C[s[-1]],dep);ds.append(dist);loads.append(sum(C[x]['demand'] for x in s))\n  cost=sum(F[t]['fixed']+F[t]['per_unit']*x for x in ds);z+=cost\n  print(t,'routes',len(rr),'loads',loads,'dist',sum(ds),'cost',cost)\n print('total',z)\nPY\n"]
[757.959047, "o", "python3 - <<'PY'"]
