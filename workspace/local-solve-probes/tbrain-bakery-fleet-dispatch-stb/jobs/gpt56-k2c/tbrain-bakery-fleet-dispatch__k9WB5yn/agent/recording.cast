[2252.64171, "i", "cat > exact_routes.py <<'PY'\nimport sys,json,time,math\nmorning=sys.argv[1];secs=float(sys.argv[2]);argv=sys.argv[:]\nsrc=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv\np=json.load(open('plans/'+morning+'.json'));deadline=time.time()+secs\nfor ri,r in enumerate(p['routes']):\n if time.time()>=deadline:break\n t=r['type'];f=kinds[t];orig=tuple(r['stops']);z=ev(t,orig);bestc=z[0];best=orig\n # Convert incumbent cost to distance.\n bestd=(bestc-f['fixed'])//f['per_unit']; nodes=orig;n=len(nodes);seen=0\n # Earliest-open simulation safely prunes missed due windows.\n def dfs(path,left,clock,here,dist):\n  global bestd,best,seen\n  if time.time()>=deadline:return\n  if not left:\n   dd=dist+D[here,0]\n   if dd>=bestd:return\n   q=tuple(path);v=ev(t,q);seen+=1\n   if v is not None:\n    bestd=dd;best=q;print('route',ri+1,'dist',bestd,'order',best,flush=True)\n   return\n  # Necessary weak distance lower bound.\n  if dist+min(D[here,x] for x in left)+min(D[x,0] for x i"]
[2252.641928, "i", "n left)>=bestd:return\n  for x in sorted(left,key=lambda y:D[here,y]):\n   nd=dist+D[here,x]\n   if nd+D[x,0]>=bestd:continue\n   c=C[x];start=max(clock+D[here,x]*f['pace'],c['ready'])\n   if start>c['due']:continue\n   dfs(path+[x],left-{x},start+c['service'],x,nd)\n dfs([],set(nodes),dep['open'],0,0)\n if best!=orig:\n  r['stops']=list(best);r['depart']=ev(t,best)[1]\n  json.dump(p,open('plans/'+morning+'.json','w'),indent=1)\n print('finished route',ri+1,'n',n,'leaves',seen,'bestd',bestd,flush=True)\nprint('done')\nPY\npython3 exact_routes.py harbour-lanes 55\npython3 tools/check_plan.py orders/harbour-lanes.json plans/harbour-lanes.json\n"]
