[?2004l[?2004h>   for x in removed:
[?2004l[?2004h>    opts=[]
[?2004l[?2004h>    for i,r in enumerate(R):
[?2004l[?2004h>     old=rc(i,r)
[?2004l[?2004h>     for q in range(len(r)+1):
[?2004l[?2004h>      nr=r[:q]+[x]+r[q:];z=rc(i,nr)
[?2004l[?2004h>      if z is not None:opts.append((z-old,i,q))
[?2004l[?2004h>    if not opts:return None
[?2004l[?2004h>    opts.sort();reg=(opts[1][0]-opts[0][0] if len(opts)>1 else 100000)
[?2004l[?2004h>    # prioritize hard-to-place; slight random noise diversifies
[?2004l[?2004h>    choices.append((reg+random.random()*100,x,opts[0]))
[?2004l[?2004h>   _,x,(_,i,q)=max(choices);R[i].insert(q,x);removed.remove(x)
[?2004l[?2004h>  return R
