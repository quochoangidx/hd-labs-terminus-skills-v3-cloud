[?2004l[?2004h>  z=ev(slots[i],tuple(r));return None if z is None else z[0]
[?2004l[?2004h> def tot(R):return sum(rc(i,r) for i,r in enumerate(R))
[?2004l[?2004h> def save(R,c):
[?2004l[?2004h>  out=[{'type':slots[i],'depart':ev(slots[i],tuple(r))[1],'stops':r} for i,r in enumerate(R) if r]
[?2004l[?2004h>  json.dump({'routes':out},open('plans/'+morning+'.json','w'),indent=1);print('BEST',c,flush=True)
[?2004l[?2004h> def rebuild(R,removed):
[?2004l[?2004h>  removed=set(removed)
[?2004l[?2004h>  while removed:
