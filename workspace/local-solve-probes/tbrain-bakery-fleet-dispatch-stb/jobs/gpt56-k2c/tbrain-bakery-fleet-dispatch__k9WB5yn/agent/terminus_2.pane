[?2004hroot@5eee95a6122f:/app# cat README.md
[?2004l# Morning dispatch

Wholesale deliveries from the bakery: cafes, grocers, hotels and the two market
halls, by cargo bike, van and truck.

- `orders/` - one file per morning: customers, windows, crates, and the vehicles on hand
- `docs/dispatch-rules.md` - what makes a plan runnable and what it costs
- `tools/check_plan.py` - checks a plan and prints its cost
- `planner/plan_morning.py` - the planner in use today
- `plans/` - the plans dispatch will run

    python3 planner/plan_morning.py orders/old-town.json plans/old-town.json
    python3 tools/check_plan.py orders/old-town.json plans/old-town.json
[?2004hroot@5eee95a6122f:/app# cat > /app/optimize.py <<'PY'
[?2004l[?2004h> import json,math,random,sys,time
[?2004l[?2004h> from functools import lru_cache
[?2004l[?2004h> 
[?2004l[?2004h> name=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 30
[?2004l[?2004h> o=json.load(open('orders/'+name+'.json')); target=json.load(open('orders/targets.json'))[name]
[?2004l[?2004h> dep=o['depot']; C={c['id']:c for c in o['customers']}; ids=list(C)
[?2004l[?2004h> pts={0:dep}|C
[?2004l[?2004h> D={(a,b):math.isqrt((pts[a]['x']-pts[b]['x'])**2+(pts[a]['y']-pts[b]['y'])**2) for a in pts for b in pts}
[?2004l[?2004h> for k,v in list(D.items()):
[?2004l[?2004h>  a,b=k; sq=(pts[a]['x']-pts[b]['x'])**2+(pts[a]['y']-pts[b]['y'])**2
[?2004l[?2004h>  if v*v<sq:D[k]=v+1
[?2004l[?2004h> kinds={f['type']:f for f in o['fleet']}
[?2004l[?2004h> slots=[]
[?2004l[?2004h> # trucks first only affects stable representation, not construction cost
[?2004l[?2004h> for f in sorted(o['fleet'],key=lambda z:-z['capacity']): slots += [f['type']]*f['count']
[?2004l[?2004h> 
[?2004l[?2004h> @lru_cache(maxsize=800000)
[?2004l[?2004h> def ev(t,s):
[?2004l[?2004h>  f=kinds[t]
[?2004l[?2004h>  if not s:return (0,dep['open'])
[?2004l[?2004h>  if sum(C[x]['demand'] for x in s)>f['capacity']:return None
[?2004l[?2004h>  dist=D[0,s[0]]+sum(D[a,b] for a,b in zip(s,s[1:]))+D[s[-1],0]
[?2004l[?2004h>  if f['range'] is not None and dist>f['range']:return None
[?2004l[?2004h>  def sim(start, windows=True):
[?2004l[?2004h>   clock=start; here=0
[?2004l[?2004h>   for x in s:
[?2004l[?2004h>    c=C[x]; clock=max(clock+D[here,x]*f['pace'],c['ready'])
[?2004l[?2004h>    if windows and clock>c['due']:return None
[?2004l[?2004h>    clock+=c['service']; here=x
[?2004l[?2004h>   return clock+D[here,0]*f['pace']
[?2004l[?2004h>  # Earliest departure must satisfy windows and closing; waiting may make shift too long.
[?2004l[?2004h>  back=sim(dep['open'])
[?2004l[?2004h>  if back is None or back>dep['close']:return None
[?2004l[?2004h>  lo=dep['open']; hi=dep['close']
[?2004l[?2004h>  # latest departure preserving all windows
[?2004l[?2004h>  while lo<hi:
[?2004l[?2004h>   mid=(lo+hi+1)//2
[?2004l[?2004h>   if sim(mid) is None:hi=mid-1
[?2004l[?2004h>   else:lo=mid
[?2004l[?2004h>  latest=lo
[?2004l[?2004h>  # earliest departure giving an acceptable shift
[?2004l[?2004h>  lo=dep['open']; hi=latest
[?2004l[?2004h>  if sim(hi)-hi>f['shift']:return None
[?2004l[?2004h>  while lo<hi:
[?2004l[?2004h>   mid=(lo+hi)//2; b=sim(mid)
[?2004l[?2004h>   if b-mid<=f['shift']:hi=mid
[?2004l[?2004h>   else:lo=mid+1
[?2004l[?2004h>  start=lo; back=sim(start)
[?2004l[?2004h>  if back>dep['close']:return None
[?2004l[?2004h>  return (f['fixed']+f['per_unit']*dist,start)
[?2004l[?2004h> 
[?2004l[?2004h> def total(R): return sum(ev(slots[i],tuple(r))[0] for i,r in enumerate(R) if r)
[?2004l[?2004h> 
[?2004l[?2004h> def construct():
[?2004l[?2004h>  R=[[] for _ in slots]
[?2004l[?2004h>  # Hard/large orders first, with randomization between restarts.
[?2004l[?2004h>  todo=sorted(ids,key=lambda x:(C[x]['due']+random.random()*2400,-C[x]['demand']))
[?2004l[?2004h>  for x in todo:
[?2004l[?2004h>   opts=[]
[?2004l[?2004h>   for i,r in enumerate(R):
[?2004l[?2004h>    old=ev(slots[i],tuple(r)); oc=old[0] if old else 0
[?2004l[?2004h>    # Equivalent empty slots of a type need only one test.
[?2004l[?2004h>    if not r and any(not R[j] and slots[j]==slots[i] for j in range(i)):continue
[?2004l[?2004h>    for p in range(len(r)+1):
[?2004l[?2004h>     nr=tuple(r[:p]+[x]+r[p:]); z=ev(slots[i],nr)
[?2004l[?2004h>     if z: opts.append((z[0]-oc,i,p))
[?2004l[?2004h>   if not opts:return None
[?2004l[?2004h>   opts.sort()
[?2004l[?2004h>   # Restricted candidate list promotes diverse but sensible packings.
[?2004l[?2004h>   width=min(len(opts),max(1,1+int(random.random()**3*8)))
[?2004l[?2004h>   _,i,p=random.choice(opts[:width]); R[i].insert(p,x)
[?2004l[?2004h>  return R
[?2004l[?2004h> 
[?2004l[?2004h> def search(R,end):
[?2004l[?2004h>  cur=total(R); best=cur; BR=[r[:] for r in R]; nmove=0
[?2004l[?2004h>  while time.time()<end:
[?2004l[?2004h>   nmove+=1; frac=max(0,(end-time.time())/max(.001,limit)); T=800*frac+4
[?2004l[?2004h>   typ=random.random(); changed=[]
[?2004l[?2004h>   non=[i for i,r in enumerate(R) if r]
[?2004l[?2004h>   if typ<.60:
[?2004l[?2004h>    a=random.choice(non); p=random.randrange(len(R[a])); x=R[a][p]
[?2004l[?2004h>    b=random.randrange(len(R)); q=random.randrange(len(R[b])+1)
[?2004l[?2004h>    if a==b and (q==p or q==p+1):continue
[?2004l[?2004h>    olda=R[a][:]; oldb=R[b][:] if b!=a else None
[?2004l[?2004h>    oldcost=ev(slots[a],tuple(R[a]))[0]+(ev(slots[b],tuple(R[b]))[0] if b!=a and R[b] else 0)
[?2004l[?2004h>    R[a].pop(p)
[?2004l[?2004h>    if a==b and q>p:q-=1
[?2004l[?2004h>    R[b].insert(q,x)
[?2004l[?2004h>    za=ev(slots[a],tuple(R[a])); zb=ev(slots[b],tuple(R[b]))
[?2004l[?2004h>    if za is None or zb is None:
[?2004l[?2004h>     R[a]=olda
[?2004l[?2004h>     if b!=a:R[b]=oldb
[?2004l[?2004h>     continue
[?2004l[?2004h>    newcost=za[0]+(zb[0] if b!=a else 0); delta=newcost-oldcost
[?2004l[?2004h>    if delta>0 and random.random()>math.exp(-delta/T):
[?2004l[?2004h>     R[a]=olda
[?2004l[?2004h>     if b!=a:R[b]=oldb
[?2004l[?2004h>     continue
