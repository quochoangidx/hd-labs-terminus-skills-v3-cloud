[?2004hroot@5eee95a6122f:/app# cat > exact_routes.py <<'PY'
[?2004l[?2004h> import sys,json,time,math
[?2004l[?2004h> morning=sys.argv[1];secs=float(sys.argv[2]);argv=sys.argv[:]
[?2004l[?2004h> src=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv
[?2004l[?2004h> p=json.load(open('plans/'+morning+'.json'));deadline=time.time()+secs
[?2004l[?2004h> for ri,r in enumerate(p['routes']):
[?2004l[?2004h>  if time.time()>=deadline:break
[?2004l[?2004h>  t=r['type'];f=kinds[t];orig=tuple(r['stops']);z=ev(t,orig);bestc=z[0];best=orig
[?2004l[?2004h>  # Convert incumbent cost to distance.
[?2004l[?2004h>  bestd=(bestc-f['fixed'])//f['per_unit']; nodes=orig;n=len(nodes);seen=0
[?2004l[?2004h>  # Earliest-open simulation safely prunes missed due windows.
[?2004l[?2004h>  def dfs(path,left,clock,here,dist):
[?2004l[?2004h>   global bestd,best,seen
[?2004l[?2004h>   if time.time()>=deadline:return
[?2004l[?2004h>   if not left:
[?2004l[?2004h>    dd=dist+D[here,0]
[?2004l[?2004h>    if dd>=bestd:return
[?2004l[?2004h>    q=tuple(path);v=ev(t,q);seen+=1
[?2004l[?2004h>    if v is not None:
