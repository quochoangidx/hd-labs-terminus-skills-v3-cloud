[?2004l[?2004h> cur=sum(cost(i,r) for i,r in enumerate(R));best=cur;BR=[r[:] for r in R];save(best)
[?2004l[?2004h> end=time.time()+secs;random.seed(time.time_ns());step=0
[?2004l[?2004h> while time.time()<end:
[?2004l[?2004h>  step+=1; non=[i for i,r in enumerate(R) if r]; a=random.choice(non); b=random.randrange(len(R))
[?2004l[?2004h>  if b==a:continue
[?2004l[?2004h>  ra,rb=R[a],R[b];oca=cost(a,ra);ocb=cost(b,rb);old=oca+ocb
[?2004l[?2004h>  typ=random.random()
[?2004l[?2004h>  if typ<.35: # relocate contiguous segment
[?2004l[?2004h>   ln=random.randint(1,min(3,len(ra)));i=random.randrange(len(ra)-ln+1);q=random.randrange(len(rb)+1)
[?2004l[?2004h>   seg=ra[i:i+ln];na=ra[:i]+ra[i+ln:];nb=rb[:q]+seg+rb[q:]
[?2004l[?2004h>  elif typ<.70 and rb: # exchange short segments
[?2004l[?2004h>   la=random.randint(1,min(3,len(ra)));lb=random.randint(1,min(3,len(rb)));i=random.randrange(len(ra)-la+1);q=random.randrange(len(rb)-lb+1)
[?2004l[?2004h>   na=ra[:i]+rb[q:q+lb]+ra[i+la:];nb=rb[:q]+ra[i:i+la]+rb[q+lb:]
[?2004l[?2004h>  else: # 2-opt-star / tail exchange, optionally reverse tails
[?2004l[?2004h>   i=random.randrange(len(ra)+1);q=random.randrange(len(rb)+1);ta=ra[i:];tb=rb[q:]
[?2004l[?2004h>   if random.random()<.35:ta=list(reversed(ta))
[?2004l[?2004h>   if random.random()<.35:tb=list(reversed(tb))
[?2004l[?2004h>   na=ra[:i]+tb;nb=rb[:q]+ta
[?2004l[?2004h>  za=cost(a,na);zb=cost(b,nb)
[?2004l[?2004h>  if za is None or zb is None:continue
[?2004l[?2004h>  delta=za+zb-old
[?2004l[?2004h>  # Reheating cycles permit barriers but cool to intensify regularly.
[?2004l[?2004h>  phase=(step%120000)/120000;T=700*(1-phase)+8
[?2004l[?2004h>  if delta<=0 or random.random()<math.exp(-delta/T):
[?2004l[?2004h>   R[a]=na;R[b]=nb;cur+=delta
[?2004l[?2004h>   if cur<best:
[?2004l[?2004h>    best=cur;BR=[r[:] for r in R];save(best)
[?2004l[?2004h>  # occasional restart from incumbent
[?2004l[?2004h>  if step%120000==0:R=[r[:] for r in BR];cur=best
[?2004l[?2004h> print('FINAL',best,'steps',step)
