[?2004l[?2004h> import sys,json,time
[?2004l[?2004h> morning=sys.argv[1];secs=float(sys.argv[2]);argv=sys.argv[:]
[?2004l[?2004h> src=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv
[?2004l[?2004h> p=json.load(open('plans/'+morning+'.json'));slots=[r['type'] for r in p['routes']];R=[r['stops'][:] for r in p['routes']];deadline=time.time()+secs
[?2004l[?2004h> def rc(i,r):
[?2004l[?2004h>  z=ev(slots[i],tuple(r));return None if z is None else z[0]
[?2004l[?2004h> cur=sum(rc(i,r) for i,r in enumerate(R));print('START',cur,flush=True)
[?2004l[?2004h> while time.time()<deadline:
[?2004l[?2004h>  bd=0;bm=None
[?2004l[?2004h>  for a in range(len(R)):
[?2004l[?2004h>   if time.time()>=deadline:break
[?2004l[?2004h>   for b in range(a+1,len(R)):
[?2004l[?2004h>    ra,rb=R[a],R[b];old=rc(a,ra)+rc(b,rb)
[?2004l[?2004h>    for ia,x in enumerate(ra):
[?2004l[?2004h>     aa=ra[:ia]+ra[ia+1:]
[?2004l[?2004h>     for ib,y in enumerate(rb):
[?2004l[?2004h>      bb=rb[:ib]+rb[ib+1:]
[?2004l[?2004h>      # Reinsert exchanged customers at every position, allowing route reordering around removals.
[?2004l[?2004h>      for pa in range(len(aa)+1):
[?2004l[?2004h>       na=aa[:pa]+[y]+aa[pa:];za=rc(a,na)
[?2004l[?2004h>       if za is None:continue
[?2004l[?2004h>       for pb in range(len(bb)+1):
[?2004l[?2004h>        nb=bb[:pb]+[x]+bb[pb:];zb=rc(b,nb)
[?2004l[?2004h>        if zb is not None and za+zb-old<bd:
[?2004l[?2004h>         bd=za+zb-old;bm=(a,b,na,nb)
[?2004l[?2004h>  if bm is None:break
[?2004l[?2004h>  a,b,na,nb=bm;R[a]=na;R[b]=nb;cur+=bd;print('IMPROVE',bd,cur,flush=True)
[?2004l[?2004h>  for i,r in enumerate(p['routes']):r['stops']=R[i];r['depart']=ev(slots[i],tuple(R[i]))[1]
[?2004l[?2004h>  json.dump(p,open('plans/'+morning+'.json','w'),indent=1)
[?2004l[?2004h> print('FINAL',cur)
[?2004l[?2004h> PY
