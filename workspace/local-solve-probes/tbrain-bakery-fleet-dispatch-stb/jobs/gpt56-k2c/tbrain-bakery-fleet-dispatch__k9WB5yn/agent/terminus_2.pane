[?2004hroot@5eee95a6122f:/app# cat > exchange21.py <<'PY'
[?2004l[?2004h> import sys,json,time,random
[?2004l[?2004h> morning=sys.argv[1];secs=float(sys.argv[2]);argv=sys.argv[:]
[?2004l[?2004h> src=open('optimize.py').read().split('random.seed(',1)[0];sys.argv=['x',morning,'1'];exec(src,globals());sys.argv=argv
[?2004l[?2004h> p=json.load(open('plans/'+morning+'.json'));S=[r['type'] for r in p['routes']];R=[r['stops'][:] for r in p['routes']]
[?2004l[?2004h> def rc(i,r):
[?2004l[?2004h>  z=ev(S[i],tuple(r));return None if z is None else z[0]
[?2004l[?2004h> cur=sum(rc(i,r) for i,r in enumerate(R));best=cur;BR=[r[:] for r in R];end=time.time()+secs;random.seed(time.time_ns());n=0
[?2004l[?2004h> while time.time()<end:
[?2004l[?2004h>  n+=1;a,b=random.sample(range(len(R)),2)
[?2004l[?2004h>  if len(R[a])<2 or not R[b]:continue
[?2004l[?2004h>  ia,ja=sorted(random.sample(range(len(R[a])),2));ib=random.randrange(len(R[b]));x,y=R[a][ia],R[a][ja];z=R[b][ib]
[?2004l[?2004h>  aa=[v for k,v in enumerate(R[a]) if k not in (ia,ja)];bb=R[b][:ib]+R[b][ib+1:];old=rc(a,R[a])+rc(b,R[b]);opts=[]
[?2004l[?2004h>  for pa in range(len(aa)+1):
[?2004l[?2004h>   na=aa[:pa]+[z]+aa[pa:];ca=rc(a,na)
[?2004l[?2004h>   if ca is None:continue
[?2004l[?2004h>   for order in ((x,y),(y,x)):
[?2004l[?2004h>    for p1 in range(len(bb)+1):
[?2004l[?2004h>     t=bb[:p1]+[order[0]]+bb[p1:]
[?2004l[?2004h>     for p2 in range(len(t)+1):
[?2004l[?2004h>      nb=t[:p2]+[order[1]]+t[p2:];cb=rc(b,nb)
[?2004l[?2004h>      if cb is not None and ca+cb<old:opts.append((ca+cb-old,na,nb))
[?2004l[?2004h>  if opts:
[?2004l[?2004h>   d,na,nb=min(opts);R[a]=na;R[b]=nb;cur+=d
[?2004l[?2004h>   if cur<best:
[?2004l[?2004h>    best=cur;BR=[r[:] for r in R];print('BEST',best,'delta',d,flush=True)
[?2004l[?2004h>    for i,r in enumerate(p['routes']):r['stops']=BR[i];r['depart']=ev(S[i],tuple(BR[i]))[1]
[?2004l[?2004h>    json.dump(p,open('plans/'+morning+'.json','w'),indent=1)
[?2004l[?2004h>    if best<=target:break
[?2004l[?2004h> print('FINAL',best,'trials',n)
[?2004l[?2004h> PY
