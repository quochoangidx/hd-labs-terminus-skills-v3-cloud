Sending keys: ['cat > /tmp/solve.py <<\'PY\'\nimport json, math, random, sys, time, os\nsys.path.insert(0,\'/app/tools\')\nfrom check_plan import evaluate\n\nname=sys.argv[1]\no=json.load(open(\'/app/orders/\'+name+\'.json\'))\nD=o[\'depot\']; C={c[\'id\']:c for c in o[\'customers\']}; ids=list(C)\nF={f[\'type\']:f for f in o[\'fleet\']}; types=list(F)\npts={0:D}|C\n\ndef dist(a,b):\n p,q=pts[a],pts[b]; s=(p[\'x\']-q[\'x\'])**2+(p[\'y\']-q[\'y\'])**2\n z=math.isqrt(s); return z if z*z==s else z+1\ndd={(a,b):dist(a,b) for a in pts for b in pts}\n\nfrom functools import lru_cache\n@lru_cache(maxsize=1000000)\ndef info(t,seq):\n if not seq: return (0,D[\'open\'],True)\n f=F[t]\n if sum(C[x][\'demand\'] for x in seq)>f[\'capacity\']: return (0,0,False)\n length=dd[0,seq[0]]+sum(dd[a,b] for a,b in zip(seq,seq[1:]))+dd[seq[-1],0]\n if f[\'range\'] is not None and length>f[\'range\']: return (length,0,False)\n # Repeatedly delay departure enough to eliminate shift excess caused by waiting.\n dep=D[\'open\']\n for _ in range(len(seq)+2):\n  clock=dep; prev=0; ok=True\n  for x in seq:\n   clock=max(clock+dd[prev,x]*f[\'pace\'],C[x][\'ready\'])\n   if clock>C[x][\'due\']: ok=False; break\n   clock+=C[x][\'service\']; prev=x\n  if not ok: return (length,dep,False)\n  back=clock+dd[prev,0]*f[\'pace\']\n  excess=back-dep-f[\'shift\']\n  if excess<=0:\n   return (length,dep,back<=D[\'close\'])\n  dep+=excess\n  if dep<D[\'open\'] or dep>D[\'close\']: return (length,dep,False)\n return (length,dep,False)\n\ndef rcost(t,s):\n if not s:return 0\n z,_,ok=info(t,tuple(s)); return F[t][\'fixed\']+F[t][\'per_unit\']*z if ok else 10**12\n\ndef construct(rng, mode):\n routes=[]\n # Slots retain type, including empty available vehicles.\n for t in types:\n  routes += [[t,[]] for _ in range(F[t][\'count\'])]\n if mode==0:\n  order=sorted(ids,key=lambda x:(C[x][\'due\']+rng.uniform(-2500,2500), math.atan2(C[x][\'y\'],C[x][\'x\'])))\n elif mode==1:\n  ang=rng.uniform(-math.pi,math.pi)\n  order=sorted(ids,key=lambda x:(C[x][\'due\']//3600, (math.atan2(C[x][\'y\'],C[x][\'x\'])-ang)%(2*math.pi)+rng.random()*.7))\n elif mode==2:\n  order=sorted(ids,key=lambda x:(C[x][\'ready\']+rng.uniform(-5000,5000),-C[x][\'demand\']))\n else:\n  order=ids[:]; rng.shuffle(order)\n for x in order:\n  opts=[]\n  seenempty=set()\n  for ri,(t,s) in enumerate(routes):\n   if not s:\n    if t in seenempty: continue\n    seenempty.add(t)\n   old=rcost(t,s)\n   for p in range(len(s)+1):\n    ns=tuple(s[:p]+[x]+s[p:]); z,_,ok=info(t,ns)\n    if ok:\n     delta=(F[t][\'fixed\']+F[t][\'per_unit\']*z)-old\n     # mild randomization, preserving broad cost preference\n     opts.append((delta*(1+rng.random()*.10),delta,ri,p))\n  if not opts:return None\n  opts.sort()\n  # Occasionally select among close alternatives to diversify geometry.\n  lim=min(len(opts),4)\n  k=0 if rng.random()<.82 else rng.randrange(lim)\n  _,_,ri,p=opts[k]; routes[ri][1].insert(p,x)\n return routes\n\ndef improve(routes,rng,deadline):\n # Intra-route 2-opt/reversal improvements, then best relocations.\n changed=True\n while changed and time.time()<deadline:\n  changed=False\n  for ri,(t,s) in enumerate(routes):\n   if len(s)<2: continue\n   old=rcost(t,s); best=old; bs=None\n   for i in range(len(s)):\n    for j in range(i+1,len(s)):\n     ns=s[:i]+list(reversed(s[i:j+1]))+s[j+1:]\n     z=rcost(t,ns)\n     if z<best: best,bs=z,ns\n   if bs is not None: routes[ri][1]=bs; changed=True\n # random/best relocation passes\n for passes in range(8):\n  if time.time()>=deadline: break\n  bestmove=None; bestdelta=-1e-9\n  order=list(range(len(routes))); rng.shuffle(order)\n  for ai in order:\n   ta,a=routes[ai]\n   if not a: continue\n   olda=rcost(ta,a)\n   for ix,x in enumerate(a):\n    na=a[:ix]+a[ix+1:]; ca=rcost(ta,na)\n    for bi,(tb,b) in enumerate(routes):\n     if bi==ai: continue\n     oldb=rcost(tb,b)\n     for p in range(len(b)+1):\n      nb=b[:p]+[x]+b[p:]; cb=rcost(tb,nb)\n      delta=(ca+cb)-(olda+oldb)\n      if delta<bestdelta:\n       bestdelta=delta; bestmove=(ai,ix,bi,p,na,nb)\n  if bestmove is None: break\n  ai,ix,bi,p,na,nb=bestmove\n  routes[ai][1]=na; routes[bi][1]=nb\n return routes\n\ndef planof(routes):\n out=[]\n for t,s in routes:\n  if s:\n   _,dep,ok=info(t,tuple(s)); assert ok\n   out.append({\'type\':t,\'depart\':int(dep),\'stops\':s})\n return {\'routes\':out}\n\ntarget=json.load(open(\'/app/orders/targets.json\'))[name]\nlimit=float(sys.argv[2]) if len(sys.argv)>2 else 25\nend=time.time()+limit; best=None; bestcost=10**18; it=0\nwhile time.time()<end:\n rng=random.Random(9176+it*1000003)\n r=construct(rng,it%4); it+=1\n if r is None: continue\n # Give promising constructions more local-search time.\n p=planof(r)\n try: c=evaluate(o,p)\n except Exception: continue\n if c<bestcost*1.18:\n  r=improve(r,rng,min(end,time.time()+3.0))\n  p=planof(r); c=evaluate(o,p)\n if c<bestcost:\n  bestcost,best=c,p\n  os.makedirs(\'/app/plans\',exist_ok=True)\n  json.dump(best,open(\'/app/plans/\'+name+\'.json\',\'w\'),indent=1)\n  print(name,\'iteration\',it,\'best\',c,\'target\',target,flush=True)\n if bestcost<=target: break\nprint(\'DONE\',name,bestcost,\'iterations\',it)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/solve.py "$n" 35; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json || true; done\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
Sending keys: ["cat > /app/optimize.py <<'PY'\nimport json,math,random,sys,time\nfrom functools import lru_cache\n\nname=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 30\no=json.load(open('orders/'+name+'.json')); target=json.load(open('orders/targets.json'))[name]\ndep=o['depot']; C={c['id']:c for c in o['customers']}; ids=list(C)\npts={0:dep}|C\nD={(a,b):math.isqrt((pts[a]['x']-pts[b]['x'])**2+(pts[a]['y']-pts[b]['y'])**2) for a in pts for b in pts}\nfor k,v in list(D.items()):\n a,b=k; sq=(pts[a]['x']-pts[b]['x'])**2+(pts[a]['y']-pts[b]['y'])**2\n if v*v<sq:D[k]=v+1\nkinds={f['type']:f for f in o['fleet']}\nslots=[]\n# trucks first only affects stable representation, not construction cost\nfor f in sorted(o['fleet'],key=lambda z:-z['capacity']): slots += [f['type']]*f['count']\n\n@lru_cache(maxsize=800000)\ndef ev(t,s):\n f=kinds[t]\n if not s:return (0,dep['open'])\n if sum(C[x]['demand'] for x in s)>f['capacity']:return None\n dist=D[0,s[0]]+sum(D[a,b] for a,b in zip(s,s[1:]))+D[s[-1],0]\n if f['range'] is not None and dist>f['range']:return None\n def sim(start, windows=True):\n  clock=start; here=0\n  for x in s:\n   c=C[x]; clock=max(clock+D[here,x]*f['pace'],c['ready'])\n   if windows and clock>c['due']:return None\n   clock+=c['service']; here=x\n  return clock+D[here,0]*f['pace']\n # Earliest departure must satisfy windows and closing; waiting may make shift too long.\n back=sim(dep['open'])\n if back is None or back>dep['close']:return None\n lo=dep['open']; hi=dep['close']\n # latest departure preserving all windows\n while lo<hi:\n  mid=(lo+hi+1)//2\n  if sim(mid) is None:hi=mid-1\n  else:lo=mid\n latest=lo\n # earliest departure giving an acceptable shift\n lo=dep['open']; hi=latest\n if sim(hi)-hi>f['shift']:return None\n while lo<hi:\n  mid=(lo+hi)//2; b=sim(mid)\n  if b-mid<=f['shift']:hi=mid\n  else:lo=mid+1\n start=lo; back=sim(start)\n if back>dep['close']:return None\n return (f['fixed']+f['per_unit']*dist,start)\n\ndef total(R): return sum(ev(slots[i],tuple(r))[0] for i,r in enumerate(R) if r)\n\ndef construct():\n R=[[] for _ in slots]\n # Hard/large orders first, with randomization between restarts.\n todo=sorted(ids,key=lambda x:(C[x]['due']+random.random()*2400,-C[x]['demand']))\n for x in todo:\n  opts=[]\n  for i,r in enumerate(R):\n   old=ev(slots[i],tuple(r)); oc=old[0] if old else 0\n   # Equivalent empty slots of a type need only one test.\n   if not r and any(not R[j] and slots[j]==slots[i] for j in range(i)):continue\n   for p in range(len(r)+1):\n    nr=tuple(r[:p]+[x]+r[p:]); z=ev(slots[i],nr)\n    if z: opts.append((z[0]-oc,i,p))\n  if not opts:return None\n  opts.sort()\n  # Restricted candidate list promotes diverse but sensible packings.\n  width=min(len(opts),max(1,1+int(random.random()**3*8)))\n  _,i,p=random.choice(opts[:width]); R[i].insert(p,x)\n return R\n\ndef search(R,end):\n cur=total(R); best=cur; BR=[r[:] for r in R]; nmove=0\n while time.time()<end:\n  nmove+=1; frac=max(0,(end-time.time())/max(.001,limit)); T=800*frac+4\n  typ=random.random(); changed=[]\n  non=[i for i,r in enumerate(R) if r]\n  if typ<.60:\n   a=random.choice(non); p=random.randrange(len(R[a])); x=R[a][p]\n   b=random.randrange(len(R)); q=random.randrange(len(R[b])+1)\n   if a==b and (q==p or q==p+1):continue\n   olda=R[a][:]; oldb=R[b][:] if b!=a else None\n   oldcost=ev(slots[a],tuple(R[a]))[0]+(ev(slots[b],tuple(R[b]))[0] if b!=a and R[b] else 0)\n   R[a].pop(p)\n   if a==b and q>p:q-=1\n   R[b].insert(q,x)\n   za=ev(slots[a],tuple(R[a])); zb=ev(slots[b],tuple(R[b]))\n   if za is None or zb is None:\n    R[a]=olda\n    if b!=a:R[b]=oldb\n    continue\n   newcost=za[0]+(zb[0] if b!=a else 0); delta=newcost-oldcost\n   if delta>0 and random.random()>math.exp(-delta/T):\n    R[a]=olda\n    if b!=a:R[b]=oldb\n    continue\n  elif typ<.82 and len(non)>=2:\n   a,b=random.sample(non,2); p=random.randrange(len(R[a]));q=random.randrange(len(R[b]))\n   olda=R[a][:];oldb=R[b][:]; oldcost=ev(slots[a],tuple(olda))[0]+ev(slots[b],tuple(oldb))[0]\n   R[a][p],R[b][q]=R[b][q],R[a][p]\n   za=ev(slots[a],tuple(R[a]));zb=ev(slots[b],tuple(R[b]))\n   if za is None or zb is None: R[a]=olda;R[b]=oldb;continue\n   delta=za[0]+zb[0]-oldcost\n   if delta>0 and random.random()>math.exp(-delta/T):R[a]=olda;R[b]=oldb;continue\n  else:\n   cand=[i for i in non if len(R[i])>=3]\n   if not cand:continue\n   a=random.choice(cand); p,q=sorted(random.sample(range(len(R[a])+1),2))\n   if q-p<2:continue\n   old=R[a][:]; oc=ev(slots[a],tuple(old))[0];R[a][p:q]=reversed(R[a][p:q]); z=ev(slots[a],tuple(R[a]))\n   if z is None: R[a]=old;continue\n   delta=z[0]-oc\n   if delta>0 and random.random()>math.exp(-delta/T):R[a]=old;continue\n  cur+=delta\n  if cur<best:best=cur;BR=[r[:] for r in R]\n return BR,best,nmove\n\nrandom.seed(9173+sum(map(ord,name))); start=time.time(); globalbest=10**30; GB=None; runs=0\nwhile time.time()<start+limit:\n R=construct(); runs+=1\n if R is None:continue\n # Give each construction a slice, increasing exploitation after good starts.\n end=min(start+limit,time.time()+max(1.5,limit/10))\n R,c,m=search(R,end)\n if c<globalbest:\n  globalbest=c;GB=R\n  print(name,'best',c,'target',target,'run',runs,'cache',ev.cache_info(),flush=True)\n  routes=[]\n  for i,r in enumerate(GB):\n   if r: routes.append({'type':slots[i],'depart':ev(slots[i],tuple(r))[1],'stops':r})\n  json.dump({'routes':routes},open('plans/'+name+'.json','w'),indent=1)\n if globalbest<=target:break\nprint('FINAL',name,globalbest,'target',target,'runs',runs)\nPY\npython3 optimize.py harbour-lanes 25\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
