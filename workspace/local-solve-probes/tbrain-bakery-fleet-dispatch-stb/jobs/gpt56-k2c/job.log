Sending keys: ['cat > /tmp/lns2.py <<\'PY\'\nimport sys,json,random,time,math\nname=sys.argv[1];exec(open(\'/tmp/core.py\').read()); target=json.load(open(\'/app/orders/targets.json\'))[name]\nP=json.load(open(\'/app/plans/\'+name+\'.json\')); R=[[r[\'type\'],r[\'stops\'][:]] for r in P[\'routes\']]\n# Add every unused fleet slot so the search can alter route counts and vehicle mix.\nfor t,f in F.items():\n for _ in range(f[\'count\']-sum(a==t for a,s in R)):R.append([t,[]])\nbest=[[t,s[:] for s in [s]][0] for t,s in R]; bc=sum(rcost(t,s) for t,s in R); cur=bc\nend=time.time()+float(sys.argv[2]); rng=random.Random(int(sys.argv[3])); it=0\n\ndef polish(Q,deadline):\n for ri,(t,s) in enumerate(Q):\n  while time.time()<deadline:\n   old=rcost(t,s); bn=None;bv=old\n   for i in range(len(s)):\n    for j in range(i+1,len(s)):\n     ns=s[:i]+list(reversed(s[i:j+1]))+s[j+1:];v=rcost(t,ns)\n     if v<bv:bv,bn=v,ns\n   if bn is None:break\n   s=bn;Q[ri][1]=s\n return Q\nwhile time.time()<end and bc>target:\n it+=1;Q=[[t,s[:] for s in [s]][0] for t,s in R]; allx=[x for t,s in Q for x in s]; mode=it%5\n k=rng.randint(max(6,len(allx)//10),max(9,len(allx)*3//10))\n if mode==0: rem=rng.sample(allx,k)\n elif mode in (1,2):\n  seed=rng.choice(allx)\n  def score(x):\n   if mode==1:return dd[seed,x]+rng.random()*100\n   return dd[seed,x]*.35+abs(C[seed][\'ready\']-C[x][\'ready\'])/40+abs(C[seed][\'due\']-C[x][\'due\'])/60+rng.random()*80\n  rem=sorted(allx,key=score)[:k]\n elif mode==3:\n  # Remove costly customers by their distance saving within current route.\n  vals=[]\n  for t,s in Q:\n   for i,x in enumerate(s):\n    a=0 if i==0 else s[i-1];b=0 if i+1==len(s) else s[i+1]\n    gain=(dd[a,x]+dd[x,b]-dd[a,b])*F[t][\'per_unit\']\n    vals.append((gain+rng.random()*400,x))\n  rem=[x for z,x in sorted(vals,reverse=True)[:k]]\n else:\n  non=[i for i,z in enumerate(Q) if z[1]];rng.shuffle(non);rem=[]\n  for i in non:\n   rem+=Q[i][1]\n   if len(rem)>=k:break\n rs=set(rem)\n for z in Q:z[1][:]=[x for x in z[1] if x not in rs]\n left=set(rem);fail=False\n while left:\n  candidates=[]\n  for x in left:\n   opts=[];seenempty=set()\n   for ri,(t,s) in enumerate(Q):\n    if not s:\n     if t in seenempty:continue\n     seenempty.add(t)\n    old=rcost(t,s)\n    for p in range(len(s)+1):\n     ns=s[:p]+[x]+s[p:];v=rcost(t,ns)\n     if v<10**12:opts.append((v-old,ri,p))\n   if opts:\n    opts.sort(); reg=opts[min(3,len(opts)-1)][0]-opts[0][0]\n    candidates.append((reg+rng.random()*40,x,opts))\n  if not candidates:fail=True;break\n  candidates.sort(reverse=True);_,x,opts=candidates[0]\n  pick=0 if rng.random()<.97 else rng.randrange(min(3,len(opts)))\n  _,ri,p=opts[pick];Q[ri][1].insert(p,x);left.remove(x)\n if fail:continue\n nc=sum(rcost(t,s) for t,s in Q); frac=(end-time.time())/float(sys.argv[2]);temp=30+300*frac\n if nc<=cur or rng.random()<math.exp((cur-nc)/temp):\n  R=Q;cur=nc\n  if nc<bc:\n   Q=polish(Q,min(end,time.time()+1.5));nc=sum(rcost(t,s) for t,s in Q);R=Q;cur=nc\n   if nc<bc:\n    p=planof(Q)\n    try:real=evaluate(o,p)\n    except:continue\n    bc=real;best=[[t,s[:] for s in [s]][0] for t,s in Q];json.dump(p,open(\'/app/plans/\'+name+\'.json\',\'w\'),indent=1)\n    print(name,\'BEST\',bc,\'target\',target,\'iter\',it,\'mode\',mode,flush=True)\n if it%80==0:R=[[t,s[:] for s in [s]][0] for t,s in best];cur=bc\nprint(\'DONE\',name,bc,it)\nPY\nfor spec in \'harbour-lanes 61001\' \'old-town 62003\' \'riverside 63007\' \'north-ring 64009\'; do set -- $spec; python3 /tmp/lns2.py "$1" 240 "$2" > "/tmp/lns2-$1.log" 2>&1 & done; wait\nfor n in harbour-lanes old-town riverside north-ring; do echo "=== $n ==="; tail -8 /tmp/lns2-$n.log; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
