[546.468178, "i", "python3 - <<'PY'\np='/tmp/solve.py'\ns=open(p).read(); s=s[:s.index(\"target=json.load\")]\nopen('/tmp/core.py','w').write(s)\nPY\ncat > /tmp/regret.py <<'PY'\nimport sys,time,random,json,os\nname=sys.argv[1]\nexec(open('/tmp/core.py').read())\ntarget=json.load(open('/app/orders/targets.json'))[name]\ntry:\n old=json.load(open('/app/plans/'+name+'.json')); bestcost=evaluate(o,old); best=old\nexcept: bestcost=10**18;best=None\nend=time.time()+float(sys.argv[2]); it=0\n# Opening discounts vary to encourage high-capacity routes before incremental economics dominate.\ndiscounts=[0.0,.12,.25,.4,.6,1.0]\nwhile time.time()<end:\n rng=random.Random(4409+it*7919); disc=discounts[it%len(discounts)]; it+=1\n R=[]\n for t in types:R += [[t,[]] for _ in range(F[t]['count'])]\n left=set(ids); failed=False\n while left:\n  choices=[]\n  # sample all customers; rank by regret between distinct route slots\n  for x in left:\n   opts=[]; seen=set()\n   for ri,(t,s) in enumerate(R):\n    if not s:\n     if t in seen:continue\n     seen.add(t)\n    oldc=rcost(t"]
[546.46832, "i", ",s)\n    for p in range(len(s)+1):\n     ns=tuple(s[:p]+[x]+s[p:]); z,_,ok=info(t,ns)\n     if ok:\n      new=F[t]['fixed']+F[t]['per_unit']*z\n      delta=new-oldc\n      adj=delta-(1-disc)*F[t]['fixed'] if not s else delta\n      opts.append((adj,delta,ri,p))\n   if not opts:continue\n   opts.sort(); b=opts[0]\n   # Distinct alternatives; large regret means assign now. Tight due windows get a mild bonus.\n   second=opts[min(len(opts)-1,3)][0]\n   regret=second-b[0]\n   urgency=(46800-C[x]['due'])/2000\n   choices.append((regret+urgency+rng.random()*80,x,b))\n  if not choices:failed=True;break\n  choices.sort(reverse=True); _,x,b=choices[0 if rng.random()<.9 else rng.randrange(min(4,len(choices)))]\n  _,_,ri,p=b;R[ri][1].insert(p,x);left.remove(x)\n if failed:continue\n p=planof(R)\n try:c=evaluate(o,p)\n except:continue\n if c<bestcost:\n  # short deterministic improvement from prior solver\n  R=improve(R,rng,min(end,time.time()+4));p=planof(R);c=evaluate(o,p)\n  if c<bestcost:\n   bestcost,best=c,p;json.dump(best,open('/app/plans/'"]
[546.468363, "i", "+name+'.json','w'),indent=1)\n   print(name,'best',c,'target',target,'disc',disc,'iter',it,flush=True)\n if bestcost<=target:break\nprint('DONE',name,bestcost,it)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/regret.py \"$n\" 55; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
