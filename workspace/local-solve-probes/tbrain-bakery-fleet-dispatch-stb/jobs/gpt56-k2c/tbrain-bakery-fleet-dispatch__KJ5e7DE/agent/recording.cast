[546.52312, "o", "[?2004l\r\u001b[?2004h>   choices=[]\r\n\u001b[?2004l\r\u001b[?2004h>   # sample all customers; rank by regret between distinct route slots\r\n\u001b[?2004l\r\u001b[?2004h>   for x in left:\r\n\u001b[?2004l\r\u001b[?2004h>    opts=[]; seen=set()\r\n\u001b[?2004l\r\u001b[?2004h>    for ri,(t,s) in enumerate(R):\r\n\u001b[?2004l\r\u001b[?2004h>     if not s:\r\n\u001b[?2004l\r\u001b[?2004h>      if t in seen:continue\r\n\u001b[?2004l\r\u001b[?2004h>      seen.add(t)\r\n\u001b[?2004l\r\u001b[?2004h>     oldc=rcost(t,s)\r\n\u001b[?2004l\r\u001b[?2004h>     for p in range(len(s)+1):\r\n\u001b[?2004l\r\u001b[?2004h>      ns=tuple(s[:p]+[x]+s[p:]); z,_,ok=info(t,ns)\r\n\u001b[?2004l\r\u001b[?2004h>      if ok:\r\n\u001b[?2004l\r\u001b[?2004h>       new=F[t]['fixed']+F[t]['per_unit']*z\r\n\u001b[?2004l\r\u001b[?2004h>       delta=new-oldc\r\n\u001b[?2004l\r\u001b[?2004h>       adj=delta-(1-disc)*F[t]['fixed'] if not s else delta\r\n\u001b[?2004l\r\u001b[?2004h>       opts.append((adj,delta,ri,p))\r\n\u001b[?2004l\r\u001b[?2004h>    if not opts:continue\r\n\u001b[?2004l\r\u001b[?2004h>    opts.sort(); b=opts[0]\r\n\u001b[?2004l\r\u001b[?2004h>    # Distinct alternatives; large regret means assign now. Tight due windows get a mild bonus.\r\n\u001b[?2004l\r\u001b[?200"]
[546.523128, "o", "4h>    second=opts[min(len(opts)-1,3)][0]\r\n\u001b[?2004l\r\u001b[?2004h>    regret=second-b[0]\r\n\u001b[?2004l\r\u001b[?2004h>    urgency=(46800-C[x]['due'])/2000\r\n\u001b[?2004l\r\u001b[?2004h>    choices.append((regret+urgency+rng.random()*80,x,b))\r\n\u001b[?2004l\r\u001b[?2004h>   if not choices:failed=True;break\r\n\u001b[?2004l\r\u001b[?2004h>   choices.sort(reverse=True); _,x,b=choices[0 if rng.random()<.9 else rng.randrange(min(4,len(choices)))]\r\n\u001b[?2004l\r\u001b[?2004h>   _,_,ri,p=b;R[ri][1].insert(p,x);left.remove(x)\r\n\u001b[?2004l\r\u001b[?2004h>  if failed:continue\r\n\u001b[?2004l\r\u001b[?2004h>  p=planof(R)\r\n\u001b[?2004l\r\u001b[?2004h>  try:c=evaluate(o,p)\r\n\u001b[?2004l\r\u001b[?2004h>  except:continue\r\n\u001b[?2004l\r\u001b[?2004h>  if c<bestcost:\r\n\u001b[?2004l\r\u001b[?2004h>   # short deterministic improvement from prior solver\r\n\u001b[?2004l\r\u001b[?2004h>   R=improve(R,rng,min(end,time.time()+4));p=planof(R);c=evaluate(o,p)\r\n\u001b[?2004l\r\u001b[?2004h>   if c<bestcost:\r\n\u001b[?2004l\r\u001b[?2004h>    bestcost,best=c,p;json.dump(best,open('/app/plans/'+name+'.json','w'),indent=1)\r\n\u001b[?2004l\r\u001b[?2004h>    print(name,'best',c,'target',target,'disc',d"]
