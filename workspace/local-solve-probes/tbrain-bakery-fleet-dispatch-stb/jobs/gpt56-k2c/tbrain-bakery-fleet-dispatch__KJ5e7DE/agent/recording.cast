[272.779521, "i", "cat > /tmp/anneal.py <<'PY'\nimport json,math,random,time,sys,os\nsys.path.insert(0,'/app/tools'); from check_plan import evaluate\nn=sys.argv[1]; limit=float(sys.argv[2]); O=json.load(open('/app/orders/'+n+'.json')); P=json.load(open('/app/plans/'+n+'.json'))\nD=O['depot']; C={c['id']:c for c in O['customers']}; F={f['type']:f for f in O['fleet']}; pts={0:D}|C\nDD={}\nfor a,p in pts.items():\n for b,q in pts.items():\n  z=(p['x']-q['x'])**2+(p['y']-q['y'])**2; r=math.isqrt(z); DD[a,b]=r+(r*r<z)\nfrom functools import lru_cache\n@lru_cache(maxsize=2000000)\ndef inf(t,s):\n if not s:return (0,D['open'],True)\n f=F[t]\n if sum(C[x]['demand'] for x in s)>f['capacity']:return (0,0,False)\n ds=DD[0,s[0]]+sum(DD[a,b] for a,b in zip(s,s[1:]))+DD[s[-1],0]\n if f['range'] is not None and ds>f['range']:return(ds,0,False)\n dep=D['open']\n for z in range(len(s)+2):\n  cl=dep; pr=0\n  for x in s:\n   cl=max(cl+DD[pr,x]*f['pace'],C[x]['ready'])\n   if cl>C[x]['due']:return(ds,dep,False)\n   cl+=C[x]['service'];pr=x\n  back=cl+DD[pr,0]*f['pace'];"]
[272.77983, "i", " ex=back-dep-f['shift']\n  if ex<=0:return(ds,dep,back<=D['close'])\n  dep+=ex\n return(ds,dep,False)\ndef co(t,s):\n if not s:return 0\n d,_,ok=inf(t,tuple(s));return F[t]['fixed']+F[t]['per_unit']*d if ok else 10**9\ndef slots(plan):\n r=[[x['type'],x['stops'][:]] for x in plan['routes']]\n for t,f in F.items():\n  for _ in range(f['count']-sum(x[0]==t for x in r)):r.append([t,[]])\n return r\ndef output(R):\n rr=[]\n for t,s in R:\n  if s:\n   _,dep,ok=inf(t,tuple(s));assert ok\n   rr.append({'type':t,'depart':int(dep),'stops':s})\n return {'routes':rr}\ndef total(R):return sum(co(t,s) for t,s in R)\nbase=slots(P); bc=total(base); best=[[t,s[:]] for t,s in base]; target=json.load(open('/app/orders/targets.json'))[n]\nprint('start',n,bc,'target',target,flush=True)\nend=time.time()+limit; rng=random.Random(77123); epoch=0\nwhile time.time()<end and bc>target:\n # Restart from global best, with high temperature gradually cooling.\n R=[[t,s[:]] for t,s in best]; cur=bc; steps=0; epoch+=1\n T0=1800 if epoch%3 else 4000\n while steps<1200"]
[272.77985, "i", "00 and time.time()<end:\n  steps+=1; temp=max(8,T0*(1-steps/120000))\n  typ=rng.randrange(100); non=[i for i,x in enumerate(R) if x[1]]\n  if not non:continue\n  a=rng.choice(non); ta,A=R[a]; ca=co(ta,A)\n  changed=[]\n  if typ<38: # relocate\n   ix=rng.randrange(len(A)); x=A[ix]; b=rng.randrange(len(R));\n   if b==a:continue\n   tb,B=R[b]; p=rng.randrange(len(B)+1); NA=A[:ix]+A[ix+1:]; NB=B[:p]+[x]+B[p:]\n   nc=co(ta,NA)+co(tb,NB); old=ca+co(tb,B); changed=[(a,NA),(b,NB)]\n  elif typ<72: # swap\n   b=rng.choice(non)\n   if b==a:continue\n   tb,B=R[b]; ix=rng.randrange(len(A));iy=rng.randrange(len(B)); NA=A[:];NB=B[:];NA[ix],NB[iy]=NB[iy],NA[ix]\n   nc=co(ta,NA)+co(tb,NB);old=ca+co(tb,B);changed=[(a,NA),(b,NB)]\n  elif typ<87: # reverse segment\n   if len(A)<2:continue\n   i,j=sorted(rng.sample(range(len(A)+1),2)); NA=A[:i]+list(reversed(A[i:j]))+A[j:]\n   nc=co(ta,NA);old=ca;changed=[(a,NA)]\n  else: # exchange tails / 2-opt star\n   b=rng.choice(non)\n   if b==a:continue\n   tb,B=R[b]; i=rng.randrange(len(A)+1);j=rng.randrange(le"]
[272.779889, "i", "n(B)+1)\n   if rng.random()<.5: NA=A[:i]+B[j:];NB=B[:j]+A[i:]\n   else: NA=A[:i]+list(reversed(B[:j]));NB=list(reversed(A[i:]))+B[j:]\n   nc=co(ta,NA)+co(tb,NB);old=ca+co(tb,B);changed=[(a,NA),(b,NB)]\n  delta=nc-old\n  if nc>=10**9:continue\n  if delta<=0 or rng.random()<math.exp(-delta/temp):\n   for i,s in changed:R[i][1]=s\n   cur+=delta\n   if cur<bc:\n    q=output(R)\n    try: real=evaluate(O,q)\n    except: continue\n    bc=real;best=[[t,s[:]] for t,s in R]\n    json.dump(q,open('/app/plans/'+n+'.json','w'),indent=1)\n    print('best',bc,'epoch',epoch,'step',steps,flush=True)\n    if bc<=target:break\nprint('DONE',n,bc)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/anneal.py \"$n\" 50; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
