[1127.470609, "i", "cat > /tmp/merge.py <<'PY'\nimport sys,json,random,time\nname=sys.argv[1];exec(open('/tmp/core.py').read()); P=json.load(open('/app/plans/'+name+'.json')); target=json.load(open('/app/orders/targets.json'))[name]\nR=[[r['type'],r['stops'][:]] for r in P['routes']]; end=time.time()+float(sys.argv[2]); rng=random.Random(8181)\ndef build(nodes,tries=80):\n best=None;bc=10**18\n orders=[sorted(nodes,key=lambda x:C[x]['due']),sorted(nodes,key=lambda x:C[x]['ready'])]\n for _ in range(tries):\n  z=nodes[:];rng.shuffle(z);orders.append(z)\n for order in orders:\n  s=[];ok=True\n  for x in order:\n   opts=[]\n   for p in range(len(s)+1):\n    ns=s[:p]+[x]+s[p:]; c=rcost('truck',ns)\n    if c<10**12:opts.append((c,p,ns))\n   if not opts:ok=False;break\n   # mostly cheapest, occasionally diversify\n   opts.sort(); s=opts[0 if rng.random()<.9 else rng.randrange(min(3,len(opts)))][2]\n  if ok:\n   c=rcost('truck',s)\n   if c<bc:bc,best=c,s\n return best,bc\nwhile time.time()<end:\n used=sum(t=='truck' for t,s in R)\n if used>=F['truck']['count']"]
[1127.47161, "o", "cat > /tmp/merge.py <<'PY'"]
[1127.490767, "i", ":break\n cand=[]\n inds=[i for i,(t,s) in enumerate(R) if t!='truck' and s]\n for ai,a in enumerate(inds):\n  for b in inds[ai+1:]:\n   nodes=R[a][1]+R[b][1]\n   if sum(C[x]['demand'] for x in nodes)>F['truck']['capacity']:continue\n   s,nc=build(nodes,20)\n   if s is not None:\n    saving=rcost(R[a][0],R[a][1])+rcost(R[b][0],R[b][1])-nc\n    cand.append((saving,a,b,s))\n if not cand:break\n cand.sort(reverse=True); saving,a,b,s=cand[0]\n if saving<=0:break\n print(name,'merge saving',saving,'routes',a,b,flush=True)\n for i in sorted([a,b],reverse=True):R.pop(i)\n R.append(['truck',s])\n q=planof(R); print(' cost',evaluate(o,q),flush=True);json.dump(q,open('/app/plans/'+name+'.json','w'),indent=1)\nprint('DONE',evaluate(o,planof(R)))\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/merge.py \"$n\" 55; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
[1127.496275, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import sys,json,random,time\r\n\u001b[?2004l\r\u001b[?2004h> name=sys.argv[1];exec(open('/tmp/core.py').read()); P=json.load(open('/app/plans/'+name+'.json')); target=json.load(open('/app/orders/targets.json'))[name]\r\n\u001b[?2004l\r\u001b[?2004h> R=[[r['type'],r['stops'][:]] for r in P['routes']]; end=time.time()+float(sys.argv[2]); rng=random.Random(8181)\r\n\u001b[?2004l\r\u001b[?2004h> def build(nodes,tries=80):\r\n\u001b[?2004l\r\u001b[?2004h>  best=None;bc=10**18\r\n\u001b[?2004l\r\u001b[?2004h>  orders=[sorted(nodes,key=lambda x:C[x]['due']),sorted(nodes,key=lambda x:C[x]['ready'])]\r\n\u001b[?2004l\r\u001b[?2004h>  for _ in range(tries):\r\n\u001b[?2004l\r\u001b[?2004h>   z=nodes[:];rng.shuffle(z);orders.append(z)\r\n\u001b[?2004l\r\u001b[?2004h>  for order in orders:\r\n\u001b[?2004l\r\u001b[?2004h>   s=[];ok=True\r\n\u001b[?2004l\r\u001b[?2004h>   for x in order:\r\n\u001b[?2004l\r\u001b[?2004h>    opts=[]\r\n\u001b[?2004l\r\u001b[?2004h>    for p in range(len(s)+1):\r\n\u001b[?2004l\r\u001b[?2004h>     ns=s[:p]+[x]+s[p:]; c=rcost('truck',ns)\r\n\u001b[?2004l\r\u001b[?2004h>     if c<10**12:opts.append((c,p,ns))\r\n\u001b[?2004l\r\u001b[?2004h>    if not opts:ok=False"]
[1127.496302, "o", ";break\r\n\u001b[?2004l\r\u001b[?2004h>    # mostly cheapest, occasionally diversify\r\n\u001b[?2004l\r\u001b[?2004h>    opts.sort(); s=opts[0 if rng.random()<.9 else rng.randrange(min(3,len(opts)))][2]\r\n\u001b[?2004l\r\u001b[?2004h>   if ok:\r\n\u001b[?2004l\r\u001b[?2004h>    c=rcost('truck',s)\r\n\u001b[?2004l\r\u001b[?2004h>    if c<bc:bc,best=c,s\r\n\u001b[?2004l\r\u001b[?2004h>  return best,bc\r\n\u001b[?2004l\r\u001b[?2004h> while time.time()<end:\r\n\u001b[?2004l\r\u001b[?2004h>  used=sum(t=='truck' for t,s in R)\r\n\u001b[?2004l\r\u001b[?2004h>  if used>=F['truck']['count']:break\r\n\u001b[?2004l\r\u001b[?2004h>  cand=[]\r\n\u001b[?2004l\r\u001b[?2004h>  inds=[i for i,(t,s) in enumerate(R) if t!='truck' and s]\r\n\u001b[?2004l\r\u001b[?2004h>  for ai,a in enumerate(inds):\r\n\u001b[?2004l\r\u001b[?2004h>   for b in inds[ai+1:]:\r\n\u001b[?2004l\r\u001b[?2004h>    nodes=R[a][1]+R[b][1]\r\n\u001b[?2004l\r\u001b[?2004h>    if sum(C[x]['demand'] for x in nodes)>F['truck']['capacity']:continue\r\n\u001b[?2004l\r\u001b[?2004h>    s,nc=build(nodes,20)\r\n\u001b[?2004l\r\u001b[?2004h>    if s is not None:\r\n\u001b[?2004l\r\u001b[?2004h>     saving=rcost(R[a][0],R[a][1])+rcost(R[b][0],R[b][1])-nc\r\n\u001b[?2004l\r\u001b[?2004h>     cand.append((sa"]
