[64.734222, "i", "t,'depart':int(dep),'stops':s})\n return {'routes':out}\n\ntarget=json.load(open('/app/orders/targets.json'))[name]\nlimit=float(sys.argv[2]) if len(sys.argv)>2 else 25\nend=time.time()+limit; best=None; bestcost=10**18; it=0\nwhile time.time()<end:\n rng=random.Random(9176+it*1000003)\n r=construct(rng,it%4); it+=1\n if r is None: continue\n # Give promising constructions more local-search time.\n p=planof(r)\n try: c=evaluate(o,p)\n except Exception: continue\n if c<bestcost*1.18:\n  r=improve(r,rng,min(end,time.time()+3.0))\n  p=planof(r); c=evaluate(o,p)\n if c<bestcost:\n  bestcost,best=c,p\n  os.makedirs('/app/plans',exist_ok=True)\n  json.dump(best,open('/app/plans/'+name+'.json','w'),indent=1)\n  print(name,'iteration',it,'best',c,'target',target,flush=True)\n if bestcost<=target: break\nprint('DONE',name,bestcost,'iterations',it)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/solve.py \"$n\" 35; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json || true; done\n"]
