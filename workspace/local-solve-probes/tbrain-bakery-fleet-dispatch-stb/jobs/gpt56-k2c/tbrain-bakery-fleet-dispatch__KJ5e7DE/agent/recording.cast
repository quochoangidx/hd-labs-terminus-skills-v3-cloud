[2113.875268, "i", "python3 - <<'PY'\nimport json,math\nT=json.load(open('/app/orders/targets.json'))\nfor n in T:\n o=json.load(open('/app/orders/'+n+'.json'));p=json.load(open('/app/plans/'+n+'.json'));C={c['id']:c for c in o['customers']};D=o['depot'];F={f['type']:f for f in o['fleet']}\n def d(a,b):\n  q=(a['x']-b['x'])**2+(a['y']-b['y'])**2;r=math.isqrt(q);return r+(r*r<q)\n print('\\n',n,'target',T[n])\n for t,f in F.items():\n  rr=[r for r in p['routes'] if r['type']==t]; ds=[];loads=[]\n  for r in rr:\n   z=[D]+[C[x] for x in r['stops']]+[D];ds.append(sum(d(a,b) for a,b in zip(z,z[1:])));loads.append(sum(C[x]['demand'] for x in r['stops']))\n  print(t,'n',len(rr),'fixed',len(rr)*f['fixed'],'dist',sum(ds),'variable',sum(ds)*f['per_unit'],'loads',loads)\nPY\n"]
[2113.879125, "o", "python3 - <<'PY'"]
[2113.879174, "o", "\r\n\u001b[?2004l\r"]
[2113.885087, "o", "\u001b[?2004h> import json,math\r\n\u001b[?2004l\r\u001b[?2004h> T=json.load(open('/app/orders/targets.json'))\r\n\u001b[?2004l\r\u001b[?2004h> for n in T:\r\n\u001b[?2004l\r\u001b[?2004h>  o=json.load(open('/app/orders/'+n+'.json'));p=json.load(open('/app/plans/'+n+'.json'));C={c['id']:c for c in o['customers']};D=o['depot'];F={f['type']:f for f in o['fleet']}\r\n\u001b[?2004l\r\u001b[?2004h>  def d(a,b):\r\n\u001b[?2004l\r\u001b[?2004h>   q=(a['x']-b['x'])**2+(a['y']-b['y'])**2;r=math.isqrt(q);return r+(r*r<q)\r\n\u001b[?2004l\r\u001b[?2004h>  print('\\n',n,'target',T[n])\r\n\u001b[?2004l\r\u001b[?2004h>  for t,f in F.items():\r\n\u001b[?2004l\r\u001b[?2004h>   rr=[r for r in p['routes'] if r['type']==t]; ds=[];loads=[]\r\n\u001b[?2004l\r\u001b[?2004h>   for r in rr:\r\n\u001b[?2004l\r\u001b[?2004h>    z=[D]+[C[x] for x in r['stops']]+[D];ds.append(sum(d(a,b) for a,b in zip(z,z[1:])));loads.append(sum(C[x]['demand'] for x in r['stops']))\r\n\u001b[?2004l\r\u001b[?2004h>   print(t,'n',len(rr),'fixed',len(rr)*f['fixed'],'dist',sum(ds),'variable',sum(ds)*f['per_unit'],'loads',loads)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[2113.893866, "o", "\r\n harbour-lanes target 77867\r\nbike n 3 fixed 2700 dist 657 variable 1314 loads [14, 12, 14]\r\nvan n 5 fixed 21000 dist 1798 variable 19778 loads [59, 59, 60, 60, 54]\r\ntruck n 2 fixed 19000 dist 877 variable 16663 loads [141, 143]\r\n"]
