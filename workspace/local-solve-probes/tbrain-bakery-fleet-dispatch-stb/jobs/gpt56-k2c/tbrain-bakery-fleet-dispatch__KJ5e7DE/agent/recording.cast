[3463.202996, "i", "aluate\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json')); dest='/app/plans/'+n+'.json'; best=evaluate(o,json.load(open(dest))); bf=dest\n for f in glob.glob('/tmp/cand-'+n+'-*.json'):\n  try:c=evaluate(o,json.load(open(f)))\n  except Exception as e:continue\n  print(n,os.path.basename(f),c)\n  if c<best:best,bf=c,f\n if bf!=dest:shutil.copyfile(bf,dest)\n print('SELECT',n,best,bf)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
