[546.470751, "o", "s=open(p).read(); s=s[:s.index(\"target=json.load\")]\r\n\u001b[?2004l\r\u001b[?2004h> open('/tmp/core.py','w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
