[2143.565949, "i", "cat > /tmp/lns.py <<'PY'\nimport sys,json,random,time,math\nname=sys.argv[1];exec(open('/tmp/core.py').read());target=json.load(open('/app/orders/targets.json'))[name]\nP=json.load(open('/app/plans/'+name+'.json')); R=[[r['type'],r['stops'][:]] for r in P['routes']]; best=[[t,s[:]] for t,s in R];bc=sum(rcost(t,s) for t,s in R);cur=bc\nend=time.time()+float(sys.argv[2]);rng=random.Random(int(sys.argv[3]) if len(sys.argv)>3 else 123);it=0\n\ndef polish(Q,deadline):\n for ri,(t,s) in enumerate(Q):\n  changed=True\n  while changed and time.time()<deadline:\n   changed=False; old=rcost(t,s)\n   # or-opt/reversal within route\n   for i in range(len(s)):\n    for j in range(i+1,len(s)):\n     ns=s[:i]+list(reversed(s[i:j+1]))+s[j+1:];c=rcost(t,ns)\n     if c<old:s=ns;old=c;changed=True\n   Q[ri][1]=s\n return Q\nwhile time.time()<end and bc>target:\n it+=1; Q=[[t,s[:]] for t,s in R]; allx=[x for t,s in Q for x in s]\n # Related removal by spatial and time-window proximity; periodically remove whole routes.\n rem=[]\n if it%7==0:\n  non=[i"]
[2143.566181, "i", " for i,(t,s) in enumerate(Q) if s]; rng.shuffle(non)\n  for i in non[:rng.choice([1,2,2,3])]:rem+=Q[i][1]\n else:\n  seed=rng.choice(allx); k=rng.randint(max(4,len(allx)//25),max(7,len(allx)//10))\n  def rel(x):\n   spatial=dd[seed,x]\n   temporal=abs(C[seed]['ready']-C[x]['ready'])/80+abs(C[seed]['due']-C[x]['due'])/120\n   return spatial+temporal+rng.random()*80\n  rem=sorted(allx,key=rel)[:k]\n rs=set(rem)\n for z in Q:z[1][:]=[x for x in z[1] if x not in rs]\n left=set(rem); failed=False\n while left:\n  choices=[]\n  for x in left:\n   opts=[]\n   for ri,(t,s) in enumerate(Q):\n    old=rcost(t,s)\n    for p in range(len(s)+1):\n     ns=s[:p]+[x]+s[p:]; c=rcost(t,ns)\n     if c<10**12:opts.append((c-old,ri,p))\n   if opts:\n    opts.sort(); regret=opts[min(2,len(opts)-1)][0]-opts[0][0]\n    choices.append((regret+rng.random()*30,x,opts))\n  if not choices:failed=True;break\n  choices.sort(reverse=True);_,x,opts=choices[0]\n  pick=0 if rng.random()<.94 else rng.randrange(min(3,len(opts)))\n  _,ri,p=opts[pick];Q[ri][1].insert(p,x);le"]
[2143.56619, "i", "ft.remove(x)\n if failed:continue\n nc=sum(rcost(t,s) for t,s in Q)\n progress=(end-time.time())/float(sys.argv[2]); temp=20+500*progress\n if nc<=cur or rng.random()<math.exp((cur-nc)/temp):\n  R=Q;cur=nc\n  if nc<bc:\n   Q=polish(Q,min(end,time.time()+1.0));nc=sum(rcost(t,s) for t,s in Q);R=Q;cur=nc\n   if nc<bc:\n    p=planof(Q)\n    try:real=evaluate(o,p)\n    except:continue\n    bc=real;best=[[t,s[:]] for t,s in Q];json.dump(p,open('/app/plans/'+name+'.json','w'),indent=1)\n    print(name,'BEST',bc,'target',target,'iter',it,flush=True)\n # periodic restart from best\n if it%100==0:R=[[t,s[:]] for t,s in best];cur=bc\nprint('DONE',name,bc,it)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/lns.py \"$n\" 90 8291; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
[2143.570383, "o", "cat > /tmp/lns.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import sys,json,random,time,math\r\n\u001b[?2004l\r\u001b[?2004h> name=sys.argv[1];exec(open('/tmp/core.py').read());target=json.load(open('/app/orders/targets.json'))[name]\r\n\u001b[?2004l\r\u001b[?2004h> P=json.load(open('/app/plans/'+name+'.json')); R=[[r['type'],r['stops'][:]] for r in P['routes']]; best=[[t,s[:]] for t,s in R];bc=sum(rcost(t,s) for t,s in R);cur=bc\r\n\u001b[?2004l\r\u001b[?2004h> end=time.time()+float(sys.argv[2]);rng=random.Random(int(sys.argv[3]) if len(sys.argv)>3 else 123);it=0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def polish(Q,deadline):\r\n\u001b[?2004l\r"]
[2143.572386, "o", "\u001b[?2004h>  for ri,(t,s) in enumerate(Q):\r\n\u001b[?2004l\r\u001b[?2004h>   changed=True\r\n\u001b[?2004l\r\u001b[?2004h>   while changed and time.time()<deadline:\r\n\u001b[?2004l\r\u001b[?2004h>    changed=False; old=rcost(t,s)\r\n\u001b[?2004l\r\u001b[?2004h>    # or-opt/reversal within route\r\n\u001b[?2004l\r\u001b[?2004h>    for i in range(len(s)):\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(i+1,len(s)):\r\n\u001b[?2004l\r\u001b[?2004h>      ns=s[:i]+list(reversed(s[i:j+1]))+s[j+1:];c=rcost(t,ns)\r\n\u001b[?2004l\r\u001b[?2004h>      if c<old:s=ns;old=c;changed=True\r\n\u001b[?2004l\r\u001b[?2004h>    Q[ri][1]=s\r\n\u001b[?2004l\r\u001b[?2004h>  return Q\r\n\u001b[?2004l\r\u001b[?2004h"]
[2143.573922, "o", "> while time.time()<end and bc>target:\r\n\u001b[?2004l\r\u001b[?2004h>  it+=1; Q=[[t,s[:]] for t,s in R]; allx=[x for t,s in Q for x in s]\r\n\u001b[?2004l\r\u001b[?2004h>  # Related removal by spatial and time-window proximity; periodically remove whole routes.\r\n\u001b[?2004l\r\u001b[?2004h>  rem=[]\r\n\u001b[?2004l\r\u001b[?2004h>  if it%7==0:\r\n\u001b[?2004l\r\u001b[?2004h>   non=[i for i,(t,s) in enumerate(Q) if s]; rng.shuffle(non)\r\n\u001b[?2004l\r\u001b[?2004h>   for i in non[:rng.choice([1,2,2,3])]:rem+=Q[i][1]\r\n\u001b[?2004l\r\u001b[?2004h>  else:\r\n\u001b[?2004l\r\u001b[?2004h>   seed=rng.choice(allx); k=rng.randint(max(4,len(allx)//25),max(7,len(allx)//10))\r\n\u001b[?2004l\r\u001b[?2004h>   def rel(x):\r\n\u001b[?2004l\r\u001b[?2004h>    spatial=dd[seed,x]\r\n\u001b[?2004l\r\u001b[?2004h>    temporal=abs(C[seed]['ready']-C[x]['ready'])/80+abs(C[seed]['due']-C[x]['due'])/120\r\n\u001b[?2004l\r\u001b[?2004h>    return spatial+temporal+rng.random()*80\r\n\u001b[?2004l\r\u001b[?2004h>   rem=sorted(allx,key=rel)[:k]\r\n\u001b[?2004l\r\u001b[?2004h>  rs=set(rem)\r\n\u001b[?2004l\r\u001b[?2004h>  for z in Q:z[1][:]=[x for x in z[1] if x not in rs]\r\n\u001b[?2004l\r\u001b[?2004h>  left=set(rem); fail"]
[2143.573968, "o", "ed=False\r\n\u001b[?2004l\r\u001b[?2004h>  while left:\r\n\u001b[?2004l\r\u001b[?2004h>   choices=[]\r\n\u001b[?2004l\r\u001b[?2004h>   for x in left:\r\n\u001b[?2004l\r\u001b[?2004h>    opts=[]"]
[2143.574123, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>    for ri,(t,s) in enumerate(Q):\r\n\u001b[?2004l\r\u001b[?2004h>     old=rcost(t,s)\r\n\u001b[?2004l\r\u001b[?2004h>     for p in range(len(s)+1):\r\n\u001b[?2004l\r\u001b[?2004h>      ns=s[:p]+[x]+s[p:]; c=rcost(t,ns)\r\n\u001b[?2004l\r\u001b[?2004h>      if c<10**12:opts.append((c-old,ri,p))\r\n\u001b[?2004l\r\u001b[?2004h>    if opts:\r\n\u001b[?2004l\r\u001b[?2004h>     opts.sort(); regret=opts[min(2,len(opts)-1)][0]-opts[0][0]\r\n\u001b[?2004l\r\u001b[?2004h>     choices.append((regret+rng.random()*30,x,opts))\r\n\u001b[?2004l\r\u001b[?2004h>   if not choices:failed=True;break\r\n\u001b[?2004l\r\u001b[?2004h>   choices.sort(reverse=True);_,x,opts=choices[0]\r\n\u001b[?2004l\r\u001b[?2004h>   pick=0 if rng.random()<.94 else rng.randrange(min(3,len(opts)))\r\n\u001b[?2004l\r\u001b[?2004h>   _,ri,p=opts[pick];Q[ri][1].insert(p,x);left.remove(x)\r\n\u001b[?2004l\r\u001b[?2004h>  if failed:continue\r\n\u001b[?2004l\r\u001b[?2004h>  nc=sum(rcost(t,s) for t,s in Q)\r\n\u001b[?2004l\r\u001b[?2004h>  progress=(end-time.time())/float(sys.argv[2]); temp=20+500*progress\r\n\u001b[?2004l\r\u001b[?2004h>  if nc<=cur or rng.random()<math.exp((cur-nc)/temp):\r\n\u001b[?2004l\r\u001b[?2004h>   R=Q;cur=n"]
