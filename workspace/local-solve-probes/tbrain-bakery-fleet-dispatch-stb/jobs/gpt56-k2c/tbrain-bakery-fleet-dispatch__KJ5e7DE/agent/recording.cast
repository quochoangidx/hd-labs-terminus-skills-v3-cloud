[1234.75068, "i", "cat > /tmp/sweep.py <<'PY'\nimport sys,json,math,time,random\nname=sys.argv[1];exec(open('/tmp/core.py').read()); target=json.load(open('/app/orders/targets.json'))[name]\nbest=json.load(open('/app/plans/'+name+'.json'));bc=evaluate(o,best); end=time.time()+float(sys.argv[2]); rng=random.Random(33)\n# Build a feasible, inexpensive ordering for one angularly contiguous group.\ndef make(t,nodes,variant):\n orders=[]\n if variant%3==0:orders.append(sorted(nodes,key=lambda x:(C[x]['due'],C[x]['ready'])))\n if variant%3==1:orders.append(sorted(nodes,key=lambda x:(C[x]['ready'],C[x]['due'])))\n orders.append(nodes[:]); orders.append(list(reversed(nodes)))\n ans=None;ac=10**12\n for order in orders:\n  s=[];ok=True\n  for x in order:\n   z=[]\n   for p in range(len(s)+1):\n    ns=s[:p]+[x]+s[p:];c=rcost(t,ns)\n    if c<10**12:z.append((c,ns))\n   if not z:ok=False;break\n   z.sort();s=z[0][1]\n  if ok:\n   # steepest feasible 2-opt\n   change=True\n   while change:\n    change=False;cc=rcost(t,s)\n    for i in range(len(s)):\n     for j in r"]
[1234.750818, "i", "ange(i+1,len(s)):\n      ns=s[:i]+list(reversed(s[i:j+1]))+s[j+1:];c=rcost(t,ns)\n      if c<cc:cc,s,change=c,ns,True\n   if cc<ac:ac,ans=cc,s\n return ans,ac\nangles=sorted(ids,key=lambda x:math.atan2(C[x]['y'],C[x]['x']))\nrotations=max(12,min(len(ids),36)); attempt=0\nwhile time.time()<end and bc>target:\n shift=(attempt*len(ids)//rotations)%len(ids); seq=angles[shift:]+angles[:shift]; variant=attempt;attempt+=1\n # Occasionally use a projected-coordinate sweep rather than polar angle.\n if attempt%5==0:\n  th=rng.random()*math.pi\n  seq=sorted(ids,key=lambda x:C[x]['x']*math.cos(th)+C[x]['y']*math.sin(th))\n seg={}\n maxst=18\n for i in range(len(seq)):\n  demand=0\n  for j in range(i,min(len(seq),i+maxst)):\n   demand+=C[seq[j]]['demand']\n   nodes=seq[i:j+1]\n   for ti,t in enumerate(types):\n    if demand<=F[t]['capacity']:\n     s,c=make(t,nodes,variant)\n     if s is not None:seg[i,j+1,t]=(c,s)\n # DP states: (position,bikes,vans,trucks) -> (cost, predecessor)\n states={(0,0,0,0):(0,None)}; layers={0:[(0,0,0,0)]}\n for pos in"]
[1234.750823, "i", " range(len(seq)):\n  for st in layers.get(pos,[]):\n   cost,_=states[st]; counts=list(st[1:])\n   for j in range(pos+1,min(len(seq),pos+maxst)+1):\n    for ti,t in enumerate(types):\n     key=(pos,j,t)\n     if key not in seg or counts[ti]>=F[t]['count']:continue\n     nc=counts[:];nc[ti]+=1; ns=(j,*nc); val=cost+seg[key][0]\n     if ns not in states or val<states[ns][0]:\n      states[ns]=(val,(st,key)); layers.setdefault(j,[]).append(ns)\n finals=[(v[0],s) for s,v in states.items() if s[0]==len(seq)]\n if not finals:continue\n finals.sort()\n for val,st in finals[:5]:\n  routes=[];cur=st\n  while cur[0]:\n   prev,key=states[cur][1];i,j,t=key;c,s=seg[key];routes.append([t,s]);cur=prev\n  p=planof(routes)\n  try:c=evaluate(o,p)\n  except:continue\n  if c<bc:\n   bc,best=c,p;json.dump(p,open('/app/plans/'+name+'.json','w'),indent=1)\n   print(name,'BEST',bc,'target',target,'attempt',attempt,'mix',{t:sum(r['type']==t for r in p['routes']) for t in types},flush=True)\n   break\n print(name,'attempt',attempt,'dp',finals[0][0] if finals "]
