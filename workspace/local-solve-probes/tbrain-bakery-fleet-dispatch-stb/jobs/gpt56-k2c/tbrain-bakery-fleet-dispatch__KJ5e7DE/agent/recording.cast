[64.743514, "o", "\u001b[?2004h>  # Repeatedly delay departure enough to eliminate shift excess caused by waiting.\r\n\u001b[?2004l\r\u001b[?2004h>  dep=D['open']\r\n\u001b[?2004l\r\u001b[?2004h>  for _ in range(len(seq)+2):\r\n\u001b[?2004l\r\u001b[?2004h>   clock=dep; prev=0; ok=True\r\n\u001b[?2004l\r\u001b[?2004h>   for x in seq:\r\n\u001b[?2004l\r\u001b[?2004h>    clock=max(clock+dd[prev,x]*f['pace'],C[x]['ready'])\r\n\u001b[?2004l\r\u001b[?2004h>    if clock>C[x]['due']: ok=False; break\r\n\u001b[?2004l\r\u001b[?2004h>    clock+=C[x]['service']; prev=x\r\n\u001b[?2004l\r\u001b[?2004h>   if not ok: return (length,dep,False)\r\n\u001b[?2004l\r\u001b[?2004h>   back=clock+dd[prev,0]*f['pace']\r\n\u001b[?2004l\r\u001b[?2004h>   excess=back-dep-f['shift']\r\n\u001b[?2004l\r\u001b[?2004h>   if excess<=0:\r\n\u001b[?2004l\r\u001b[?2004h>    return (length,dep,back<=D['close'])\r\n\u001b[?2004l\r\u001b[?2004h>   dep+=excess\r\n\u001b[?2004l\r\u001b[?2004h>   if dep<D['open'] or dep>D['close']: return (length,dep,False)\r\n\u001b[?2004l\r\u001b[?2004h>  return (length,dep,False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def rcost(t,s):\r\n\u001b[?2004l\r\u001b[?2004h>  if not s:return 0\r\n\u001b[?2004l\r\u001b[?2004h>  z,_,ok=info(t,tuple(s)); return F"]
[64.743546, "o", "[t]['fixed']+F[t]['per_unit']*z if ok else 10**12\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def construct(rng, mode):\r\n\u001b[?2004l\r\u001b[?2004h>  routes=[]\r\n\u001b[?2004l\r\u001b[?2004h>  # Slots retain type, including empty available vehicles.\r\n\u001b[?2004l\r\u001b[?2004h>  for t in types:\r\n\u001b[?2004l\r\u001b[?2004h>   routes += [[t,[]] for _ in range(F[t]['count'])]\r\n\u001b[?2004l\r\u001b[?2004h>  if mode==0:\r\n\u001b[?2004l\r\u001b[?2004h>   order=sorted(ids,key=lambda x:(C[x]['due']+rng.uniform(-2500,2500), math.atan2(C[x]['y'],C[x]['x'])))\r\n\u001b[?2004l\r\u001b[?2004h>  elif mode==1:\r\n\u001b[?2004l\r\u001b[?2004h>   ang=rng.uniform(-math.pi,math.pi)\r\n\u001b[?2004l\r\u001b[?2004h>   order=sorted(ids,key=lambda x:(C[x]['due']//3600, (math.atan2(C[x]['y'],C[x]['x'])-ang)%(2*math.pi)+rng.random()*.7))\r\n\u001b[?2004l\r\u001b[?2004h>  elif mode==2:\r\n\u001b[?2004l\r\u001b[?2004h>   order=sorted(ids,key=lambda x:(C[x]['ready']+rng.uniform(-5000,5000),-C[x]['demand']))\r\n\u001b[?2004l\r\u001b[?2004h>  else:\r\n\u001b[?2004l\r\u001b[?2004h>   order=ids[:]; rng.shuffle(order)\r\n\u001b[?2004l\r\u001b[?2004h>  for x in order:\r\n\u001b[?2004l\r\u001b[?2004h>   opts=[]\r\n\u001b[?2004l"]
[64.743565, "o", "\r\u001b[?2004h>   seenempty=set()\r\n\u001b[?2004l\r\u001b[?2004h>   for ri,(t,s) in enumerate(routes):\r\n\u001b[?2004l\r\u001b[?2004h>    if not s:\r\n\u001b[?2004l\r\u001b[?2004h>     if t in seenempty: continue\r\n\u001b[?2004l\r\u001b[?2004h>     seenempty.add(t)\r\n\u001b[?2004l\r\u001b[?2004h>    old=rcost(t,s)\r\n\u001b[?2004l\r\u001b[?2004h>    for p in range(len(s)+1):\r\n\u001b[?2004l\r\u001b[?2004h>     ns=tuple(s[:p]+[x]+s[p:]); z,_,ok=info(t,ns)\r\n\u001b[?2004l\r\u001b[?2004h>     if ok:\r\n\u001b[?2004l\r\u001b[?2004h>      delta=(F[t]['fixed']+F[t]['per_unit']*z)-old\r\n\u001b[?2004l\r\u001b[?2004h>      # mild randomization, preserving broad cost preference\r\n\u001b[?2004l\r\u001b[?2004h"]
[64.747406, "o", ">      opts.append((delta*(1+rng.random()*.10),delta,ri,p))\r\n\u001b[?2004l\r\u001b[?2004h>   if not opts:return None\r\n\u001b[?2004l\r\u001b[?2004h>   opts.sort()\r\n\u001b[?2004l\r\u001b[?2004h>   # Occasionally select among close alternatives to diversify geometry.\r\n\u001b[?2004l\r\u001b[?2004h>   lim=min(len(opts),4)\r\n\u001b[?2004l\r\u001b[?2004h>   k=0 if rng.random()<.82 else rng.randrange(lim)\r\n\u001b[?2004l\r\u001b[?2004h>   _,_,ri,p=opts[k]; routes[ri][1].insert(p,x)\r\n\u001b[?2004l\r\u001b[?2004h>  return routes\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def improve(routes,rng,deadline):\r\n\u001b[?2004l\r\u001b[?2004h>  # Intra-route 2-opt/reversal improvements, then best relocations.\r\n\u001b[?2004l\r\u001b[?2004h>  changed=True\r\n\u001b[?2004l\r\u001b[?2004h>  while changed and time.time()<deadline:\r\n\u001b[?2004l\r\u001b[?2004h>   changed=False\r\n\u001b[?2004l\r\u001b[?2004h>   for ri,(t,s) in enumerate(routes):\r\n\u001b[?2004l\r\u001b[?2004h>    if len(s)<2: continue\r\n\u001b[?2004l\r\u001b[?2004h>    old=rcost(t,s); best=old; bs=None\r\n\u001b[?2004l\r\u001b[?2004h>    for i in range(len(s)):\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(i+1,len(s)):\r\n\u001b[?2004l\r\u001b[?2004h>      ns"]
[64.747425, "o", "=s[:i]+list(reversed(s[i:j+1]))+s[j+1:]\r\n\u001b[?2004l\r\u001b[?2004h>      z=rcost(t,ns)\r\n\u001b[?2004l\r\u001b[?2004h>      if z<best: best,bs=z,ns\r\n\u001b[?2004l\r\u001b[?2004h>    if bs is not None: routes[ri][1]=bs; changed=True\r\n\u001b[?2004l\r\u001b[?2004h>  # random/best relocation passes\r\n\u001b[?2004l\r\u001b[?2004h>  for passes in range(8):\r\n\u001b[?2004l\r\u001b[?2004h>   if time.time()>=deadline: break\r\n\u001b[?2004l\r\u001b[?2004h>   bestmove=None; bestdelta=-1e-9\r\n\u001b[?2004l\r\u001b[?2004h>   order=list(range(len(routes))); rng.shuffle(order)\r\n\u001b[?2004l\r\u001b[?2004h>   for ai in order:\r\n\u001b[?2004l\r\u001b[?2004h>    ta,a=routes[ai]\r\n\u001b[?2004l\r\u001b[?2004h>    if not a: continue\r\n\u001b[?2004l\r\u001b[?2004h>    olda=rcost(ta,a)\r\n\u001b[?2004l\r\u001b[?2004h>    for ix,x in enumerate(a):\r\n\u001b[?2004l\r\u001b[?2004h>     na=a[:ix]+a[ix+1:]; ca=rcost(ta,na)\r\n\u001b[?2004l\r\u001b[?2004h>     for bi,(tb,b) in enumerate(routes):\r\n\u001b[?2004l\r\u001b[?2004h>      if bi==ai: continue\r\n\u001b[?2004l\r\u001b[?2004h>      oldb=rcost(tb,b)\r\n\u001b[?2004l\r\u001b[?2004h>      for p in range(len(b)+1):\r\n\u001b[?2004l\r\u001b[?2004h>       nb=b[:p]+[x]+b[p:]; cb=rcost(tb,nb)\r\n\u001b[?2004l\r\u001b[?200"]
[64.747448, "o", "4h>       delta=(ca+cb)-(olda+oldb)\r\n\u001b[?2004l\r\u001b[?2004h>       if delta<bestdelta:\r\n\u001b[?2004l\r\u001b[?2004h>        bestdelta=delta; bestmove=(ai,ix,bi,p,na,nb)\r\n\u001b[?2004l\r\u001b[?2004h>   if bestmove is None: break\r\n\u001b[?2004l\r\u001b[?2004h>   ai,ix,bi,p,na,nb=bestmove\r\n\u001b[?2004l\r\u001b[?2004h>   routes[ai][1]=na; routes[bi][1]=nb\r\n\u001b[?2004l\r\u001b[?2004h>  return routes\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def planof(routes):\r\n\u001b[?2004l\r\u001b[?2004h>  out=[]\r\n\u001b[?2004l\r\u001b[?2004h>  for t,s in routes:\r\n\u001b[?2004l\r\u001b[?2004h>   if s:\r\n\u001b[?2004l\r\u001b[?2004h>    _,dep,ok=info(t,tuple(s)); assert ok\r\n\u001b[?2004l\r\u001b[?2004h>    out.append({'type':t,'depart':int(dep),'stops':s})\r\n\u001b[?2004l\r\u001b[?2004h>  return {'routes':out}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> target=json.load(open('/app/orders/targets.json'))[name]\r\n\u001b[?2004l\r\u001b[?2004h> limit=float(sys.argv[2]) if len(sys.argv)>2 else 25\r\n\u001b[?2004l\r\u001b[?2004h> end=time.time()+limit; best=None; bestcost=10**18; it=0\r\n\u001b[?2004l\r\u001b[?2004h> while time.time()<end:\r\n\u001b[?2004l\r\u001b[?2004h>  rng=random.Random(9176+it*1000003)\r\n\u001b"]
