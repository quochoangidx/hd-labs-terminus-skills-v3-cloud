[4487.045397, "i", "cat > /tmp/exactlocal.py <<'PY'\nimport sys,json,time\nname=sys.argv[1];exec(open('/tmp/core.py').read());target=json.load(open('/app/orders/targets.json'))[name]\nP=json.load(open('/app/plans/'+name+'.json'));R=[[r['type'],r['stops'][:]] for r in P['routes']]; end=time.time()+float(sys.argv[2]); bc=evaluate(o,P);iteration=0\nwhile time.time()<end and bc>target:\n iteration+=1; bestdelta=0; move=None\n # Exhaustive relocation and direct-position swaps.\n for a,(ta,A) in enumerate(R):\n  ca=rcost(ta,A)\n  for ix,x in enumerate(A):\n   NA=A[:ix]+A[ix+1:]; cna=rcost(ta,NA)\n   for b,(tb,B) in enumerate(R):\n    if b==a:continue\n    cb=rcost(tb,B)\n    for p in range(len(B)+1):\n     NB=B[:p]+[x]+B[p:]; d=cna+rcost(tb,NB)-ca-cb\n     if d<bestdelta:bestdelta=d;move=('r',a,b,NA,NB)\n    for iy,y in enumerate(B):\n     SA=A[:];SB=B[:];SA[ix]=y;SB[iy]=x;d=rcost(ta,SA)+rcost(tb,SB)-ca-cb\n     if d<bestdelta:bestdelta=d;move=('s',a,b,SA,SB)\n  # Exhaustive 2-opt-star tail exchanges for each unordered route pair.\n  for b in range(a+1,le"]
[4487.046072, "i", "n(R)):\n   tb,B=R[b];cb=rcost(tb,B)\n   for i in range(len(A)+1):\n    for j in range(len(B)+1):\n     for rev in (False,True):\n      if not rev:NA=A[:i]+B[j:];NB=B[:j]+A[i:]\n      else:NA=A[:i]+list(reversed(B[:j]));NB=list(reversed(A[i:]))+B[j:]\n      d=rcost(ta,NA)+rcost(tb,NB)-ca-cb\n      if d<bestdelta:bestdelta=d;move=('t',a,b,NA,NB)\n if move is None:break\n _,a,b,NA,NB=move;R[a][1]=NA;R[b][1]=NB;bc+=bestdelta\n p=planof(R);real=evaluate(o,p);bc=real;json.dump(p,open('/app/plans/'+name+'.json','w'),indent=1)\n print(name,'BEST',bc,'target',target,'delta',bestdelta,'iter',iteration,flush=True)\nprint('DONE',name,bc,iteration)\nPY\npython3 -m py_compile /tmp/exactlocal.py\npython3 /tmp/exactlocal.py harbour-lanes 300; python3 /app/tools/check_plan.py /app/orders/harbour-lanes.json /app/plans/harbour-lanes.json\npython3 /tmp/exactlocal.py old-town 300; python3 /app/tools/check_plan.py /app/orders/old-town.json /app/plans/old-town.json\n"]
