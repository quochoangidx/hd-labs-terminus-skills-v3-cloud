[4575.903101, "i", "cat > /tmp/route_dp.py <<'PY'\nimport sys,json,time\nname=sys.argv[1];exec(open('/tmp/core.py').read());P=json.load(open('/app/plans/'+name+'.json')); before=evaluate(o,P); deadline=time.time()+float(sys.argv[2])\n\ndef optimize(t,nodes):\n n=len(nodes)\n if n<2 or n>18:return nodes\n f=F[t]; full=(1<<n)-1\n # labels[(mask,last)] = list of [distance_so_far, service_end_time, parent]\n L={}\n for i,x in enumerate(nodes):\n  arr=max(D['open']+dd[0,x]*f['pace'],C[x]['ready'])\n  if arr<=C[x]['due']:L[(1<<i,i)]=[(dd[0,x],arr+C[x]['service'],None)]\n for size in range(1,n):\n  if time.time()>deadline:return nodes\n  keys=[k for k in L if k[0].bit_count()==size]\n  for mask,last in keys:\n   for li,(dr,cl,par) in enumerate(list(L[(mask,last)])):\n    a=nodes[last]\n    for j,x in enumerate(nodes):\n     if mask>>j&1:continue\n     nd=dr+dd[a,x]; ar=max(cl+dd[a,x]*f['pace'],C[x]['ready'])\n     if ar>C[x]['due']:continue\n     nc=ar+C[x]['service']; key=(mask|1<<j,j); labels=L.setdefault(key,[])\n     # A label with no more distance and no"]
[4575.903149, "i", " later time dominates.\n     if any(d<=nd and c<=nc for d,c,p in labels):continue\n     labels[:]=[z for z in labels if not (nd<=z[0] and nc<=z[1])]\n     labels.append((nd,nc,(mask,last,li)))\n best=None\n for last in range(n):\n  for li,(dr,cl,par) in enumerate(L.get((full,last),[])):\n   total=dr+dd[nodes[last],0]\n   # Reconstruct and use exact official-equivalent feasibility, including shift/departure adjustment.\n   seq=[];state=(full,last,li)\n   while state:\n    m,j,k=state;seq.append(nodes[j]); state=L[(m,j)][k][2]\n   seq.reverse();d,dep,ok=info(t,tuple(seq))\n   if ok and (best is None or d<best[0]):best=(d,seq)\n return best[1] if best else nodes\n\nfor r in P['routes']:\n old=rcost(r['type'],r['stops']); ns=optimize(r['type'],r['stops']); new=rcost(r['type'],ns)\n if new<old:\n  print(name,r['type'],len(ns),'route saving',old-new,flush=True);r['stops']=ns\n # refresh departure for either ordering\n _,dep,ok=info(r['type'],tuple(r['stops']));r['depart']=int(dep)\nafter=evaluate(o,P)\nif after<before:json.dump(P,open('/"]
[4575.903165, "i", "app/plans/'+name+'.json','w'),indent=1)\nprint('DONE',name,before,after)\nPY\npython3 -m py_compile /tmp/route_dp.py\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/route_dp.py \"$n\" 300; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
