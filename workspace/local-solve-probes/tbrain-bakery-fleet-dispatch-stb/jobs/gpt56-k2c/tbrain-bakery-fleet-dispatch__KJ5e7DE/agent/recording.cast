[836.141575, "i", "cat > /tmp/fixed.py <<'PY'\nimport sys,time,random,json\nname=sys.argv[1];exec(open('/tmp/core.py').read()); target=json.load(open('/app/orders/targets.json'))[name]\nbest=json.load(open('/app/plans/'+name+'.json'));bestcost=evaluate(o,best); demand=sum(c['demand'] for c in C.values())\nend=time.time()+float(sys.argv[2]); it=0\n# all trucks; vary van count around capacity minimum and allow some bikes\nnt=F['truck']['count']; base=max(0,(demand-150*nt+59)//60)\npatterns=[]\nfor nv in range(max(0,base-1),min(F['van']['count'],base+6)+1):\n for nb in [0,min(2,F['bike']['count']),min(5,F['bike']['count']),F['bike']['count']]:\n  if 150*nt+60*nv+14*nb>=demand:patterns.append((nb,nv,nt))\n# also one/two fewer trucks\nfor tr in range(max(0,nt-2),nt):\n v=max(0,(demand-150*tr+59)//60)\n for extra in range(4):\n  if v+extra<=F['van']['count']:patterns.append((0,v+extra,tr))\nwhile time.time()<end:\n nb,nv,ntt=patterns[it%len(patterns)];rng=random.Random(9929+it*104729);it+=1\n R=[['bike',[]] for _ in range(nb)]+[['van',[]] for _ in ran"]
[836.141638, "i", "ge(nv)]+[['truck',[]] for _ in range(ntt)]\n left=set(ids); fail=False\n while left:\n  cand=[]\n  for x in left:\n   opts=[]\n   for ri,(t,s) in enumerate(R):\n    old=rcost(t,s)\n    for p in range(len(s)+1):\n     ns=tuple(s[:p]+[x]+s[p:]);z,_,ok=info(t,ns)\n     if ok:opts.append(((F[t]['per_unit']*z+(0 if s else F[t]['fixed']))-old,ri,p))\n   if not opts:continue\n   opts.sort(); regret=(opts[min(2,len(opts)-1)][0]-opts[0][0])\n   # prioritize large demand and tight due when regret similar\n   score=regret+C[x]['demand']*8+(46800-C[x]['due'])/30+rng.random()*100\n   cand.append((score,x,opts[0]))\n  if not cand:fail=True;break\n  cand.sort(reverse=True); _,x,op=cand[0 if rng.random()<.94 else rng.randrange(min(3,len(cand)))]\n  _,ri,p=op;R[ri][1].insert(p,x);left.remove(x)\n if fail:continue\n try:p=planof(R);c=evaluate(o,p)\n except:continue\n if c<bestcost:\n  R=improve(R,rng,min(end,time.time()+5));p=planof(R);c=evaluate(o,p)\n  if c<bestcost:\n   bestcost,best=c,p;json.dump(p,open('/app/plans/'+name+'.json','w'),indent=1)\n  "]
[836.141647, "i", " print(name,'BEST',c,'target',target,'pattern',nb,nv,ntt,'iter',it,flush=True)\n if bestcost<=target:break\nprint('DONE',name,bestcost,it)\nPY\nfor n in harbour-lanes old-town riverside north-ring; do python3 /tmp/fixed.py \"$n\" 60; python3 /app/tools/check_plan.py /app/orders/$n.json /app/plans/$n.json; done\n"]
