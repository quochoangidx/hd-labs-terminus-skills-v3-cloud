[239.772922, "i", "python3 - <<'PY'\nimport json,math\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json')); p=json.load(open('/app/plans/'+n+'.json')); C={c['id']:c for c in o['customers']}; D=o['depot']; F={f['type']:f for f in o['fleet']}\n def d(a,b):\n  s=(a['x']-b['x'])**2+(a['y']-b['y'])**2; z=math.isqrt(s); return z+(z*z<s)\n print('\\n',n)\n tot=0\n for t in F:\n  rows=[]\n  for r in p['routes']:\n   if r['type']!=t:continue\n   q=sum(C[x]['demand'] for x in r['stops']); seq=[D]+[C[x] for x in r['stops']]+[D]; ds=sum(d(a,b) for a,b in zip(seq,seq[1:])); cost=F[t]['fixed']+F[t]['per_unit']*ds; tot+=cost; rows.append((q,ds,cost,len(r['stops'])))\n  print(t,len(rows),'demand',sum(x[0] for x in rows),'loads',[x[0] for x in rows],'distance',sum(x[1] for x in rows),'cost',sum(x[2] for x in rows))\n print('total',tot)\nPY\n"]
