[64.731444, "i", "m(-5000,5000),-C[x]['demand']))\n else:\n  order=ids[:]; rng.shuffle(order)\n for x in order:\n  opts=[]\n  seenempty=set()\n  for ri,(t,s) in enumerate(routes):\n   if not s:\n    if t in seenempty: continue\n    seenempty.add(t)\n   old=rcost(t,s)\n   for p in range(len(s)+1):\n    ns=tuple(s[:p]+[x]+s[p:]); z,_,ok=info(t,ns)\n    if ok:\n     delta=(F[t]['fixed']+F[t]['per_unit']*z)-old\n     # mild randomization, preserving broad cost preference\n     opts.append((delta*(1+rng.random()*.10),delta,ri,p))\n  if not opts:return None\n  opts.sort()\n  # Occasionally select among close alternatives to diversify geometry.\n  lim=min(len(opts),4)\n  k=0 if rng.random()<.82 else rng.randrange(lim)\n  _,_,ri,p=opts[k]; routes[ri][1].insert(p,x)\n return routes\n\ndef improve(routes,rng,deadline):\n # Intra-route 2-opt/reversal improvements, then best relocations.\n changed=True\n while changed and time.time()<deadline:\n  changed=False\n  for ri,(t,s) in enumerate(routes):\n   if len(s)<2: continue\n   old=rcost(t,s); best=old; bs=None\n   for i "]
[64.731448, "i", "in range(len(s)):\n    for j in range(i+1,len(s)):\n     ns=s[:i]+list(reversed(s[i:j+1]))+s[j+1:]\n     z=rcost(t,ns)\n     if z<best: best,bs=z,ns\n   if bs is not None: routes[ri][1]=bs; changed=True\n # random/best relocation passes\n for passes in range(8):\n  if time.time()>=deadline: break\n  bestmove=None; bestdelta=-1e-9\n  order=list(range(len(routes))); rng.shuffle(order)\n  for ai in order:\n   ta,a=routes[ai]\n   if not a: continue\n   olda=rcost(ta,a)\n   for ix,x in enumerate(a):\n    na=a[:ix]+a[ix+1:]; ca=rcost(ta,na)\n    for bi,(tb,b) in enumerate(routes):\n     if bi==ai: continue\n     oldb=rcost(tb,b)\n     for p in range(len(b)+1):\n      nb=b[:p]+[x]+b[p:]; cb=rcost(tb,nb)\n      delta=(ca+cb)-(olda+oldb)\n      if delta<bestdelta:\n       bestdelta=delta; bestmove=(ai,ix,bi,p,na,nb)\n  if bestmove is None: break\n  ai,ix,bi,p,na,nb=bestmove\n  routes[ai][1]=na; routes[bi][1]=nb\n return routes\n\ndef planof(routes):\n out=[]\n for t,s in routes:\n  if s:\n   _,dep,ok=info(t,tuple(s)); assert ok\n   out.append({'type':"]
