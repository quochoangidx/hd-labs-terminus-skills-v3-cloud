[813.391616, "i", "python3 - <<'PY'\nimport json,itertools\nfor n in ['harbour-lanes','old-town','riverside','north-ring']:\n o=json.load(open('/app/orders/'+n+'.json')); p=json.load(open('/app/plans/'+n+'.json')); dem=sum(c['demand'] for c in o['customers']); F={f['type']:f for f in o['fleet']}\n print('\\n',n,'demand',dem,'current', {t:sum(r['type']==t for r in p['routes']) for t in F})\n a=[]\n for b in range(F['bike']['count']+1):\n  for v in range(F['van']['count']+1):\n   for tr in range(F['truck']['count']+1):\n    cap=14*b+60*v+150*tr\n    if cap>=dem:\n     fixed=900*b+4200*v+9500*tr\n     a.append((fixed,cap-dem,b,v,tr))\n print('lowest fixed combos:',sorted(a)[:15])\nPY\n"]
[813.393332, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
