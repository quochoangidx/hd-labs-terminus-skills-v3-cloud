[?2004l[?2004h>    nc=co(ta,NA)+co(tb,NB);old=ca+co(tb,B);changed=[(a,NA),(b,NB)]
[?2004l[?2004h>   elif typ<87: # reverse segment
[?2004l[?2004h>    if len(A)<2:continue
