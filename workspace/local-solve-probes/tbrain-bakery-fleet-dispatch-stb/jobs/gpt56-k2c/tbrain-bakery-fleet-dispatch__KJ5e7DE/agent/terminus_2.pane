[?2004l[?2004h> import sys,time,random,json
[?2004l[?2004h> name=sys.argv[1];exec(open('/tmp/core.py').read()); target=json.load(open('/app/orders/targets.json'))[name]
[?2004l[?2004h> best=json.load(open('/app/plans/'+name+'.json'));bestcost=evaluate(o,best); demand=sum(c['demand'] for c in C.values())
[?2004l[?2004h> end=time.time()+float(sys.argv[2]); it=0
[?2004l[?2004h> # all trucks; vary van count around capacity minimum and allow some bikes
[?2004l[?2004h> nt=F['truck']['count']; base=max(0,(demand-150*nt+59)//60)
[?2004l[?2004h> patterns=[]
[?2004l[?2004h> for nv in range(max(0,base-1),min(F['van']['count'],base+6)+1):
[?2004l[?2004h>  for nb in [0,min(2,F['bike']['count']),min(5,F['bike']['count']),F['bike']['count']]:
[?2004l[?2004h>   if 150*nt+60*nv+14*nb>=demand:patterns.append((nb,nv,nt))
[?2004l[?2004h> # also one/two fewer trucks
[?2004l[?2004h> for tr in range(max(0,nt-2),nt):
[?2004l[?2004h>  v=max(0,(demand-150*tr+59)//60)
[?2004l[?2004h>  for extra in range(4):
[?2004l[?2004h>   if v+extra<=F['van']['count']:patterns.append((0,v+extra,tr))
[?2004l[?2004h> while time.time()<end:
[?2004l[?2004h>  nb,nv,ntt=patterns[it%len(patterns)];rng=random.Random(9929+it*104729);it+=1
[?2004l[?2004h>  R=[['bike',[]] for _ in range(nb)]+[['van',[]] for _ in range(nv)]+[['truck',[]] for _ in range(ntt)]
[?2004l[?2004h>  left=set(ids); fail=False
[?2004l[?2004h>  while left:
[?2004l[?2004h>   cand=[]
[?2004l[?2004h>   for x in left:
[?2004l[?2004h>    opts=[]
[?2004l[?2004h>    for ri,(t,s) in enumerate(R):
[?2004l[?2004h>     old=rcost(t,s)
[?2004l[?2004h>     for p in range(len(s)+1):
[?2004l[?2004h>      ns=tuple(s[:p]+[x]+s[p:]);z,_,ok=info(t,ns)
[?2004l[?2004h>      if ok:opts.append(((F[t]['per_unit']*z+(0 if s else F[t]['fixed']))-old,ri,p))
[?2004l[?2004h>    if not opts:continue
[?2004l[?2004h>    opts.sort(); regret=(opts[min(2,len(opts)-1)][0]-opts[0][0])
[?2004l[?2004h>    # prioritize large demand and tight due when regret similar
[?2004l[?2004h>    score=regret+C[x]['demand']*8+(46800-C[x]['due'])/30+rng.random()*100
