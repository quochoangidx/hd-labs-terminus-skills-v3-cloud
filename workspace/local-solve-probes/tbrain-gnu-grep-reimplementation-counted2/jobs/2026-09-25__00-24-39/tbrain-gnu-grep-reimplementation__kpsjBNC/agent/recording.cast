[279.906757, "i", "python3 - <<'PY'\np='/app/pygrep/grep.py'\ns=open(p).read()\ns=s.replace(\"self.out=None; self.quiet=False; self.silent=False\", \"self.out=None; self.only=False; self.quiet=False; self.silent=False\")\ns=s.replace(\"'quiet':'q','silent':'s'\", \"'quiet':'q','only-matching':'o','silent':'s'\")\ns=s.replace(\"elif c=='q':o.quiet=True\", \"elif c=='q':o.quiet=True\\n   elif c=='o':o.only=True\")\ns=s.replace(\"if o.quiet and count:return 0\", \"if o.quiet and count:return 0\\n  if o.quiet:continue\")\n# Remove the old argv-rewriting parser wrapper.\nstart=s.find(\"# -o is installed as a tiny parser extension\")\nif start>=0:\n end=s.find(\"if __name__=='__main__'\",start)\n s=s[:start]+s[end:]\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pygrep/grep.py\ntail -20 /app/pygrep/grep.py\n"]
[279.912068, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/pygrep/grep.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"self.out=None; self.quiet=False; self.silent=False\", \"self.out=None; self.only=False; self.quiet=False; self.silent=False\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"'quiet':'q','silent':'s'\", \"'quiet':'q','only-matching':'o','silent':'s'\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"elif c=='q':o.quiet=True\", \"elif c=='q':o.quiet=True\\n   elif c=='o':o.only=True\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"if o.quiet and count:return 0\", \"if o.quiet and count:return 0\\n  if o.quiet:continue\")\r\n\u001b[?2004l\r\u001b[?2004h> # Remove the old argv-rewriting parser wrapper.\r\n\u001b[?2004l\r\u001b[?2004h> start=s.find(\"# -o is installed as a tiny parser extension\")\r\n\u001b[?2004l\r\u001b[?2004h> if start>=0:\r\n\u001b[?2004l\r\u001b[?2004h>  end=s.find(\"if __name__=='__main__'\",start)\r\n\u001b[?2004l\r\u001b[?2004h>  s=s[:start]+s[end:]\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
