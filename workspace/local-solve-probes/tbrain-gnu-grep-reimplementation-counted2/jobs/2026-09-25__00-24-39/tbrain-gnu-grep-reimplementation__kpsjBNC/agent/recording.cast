[111.958991, "i", "cd /tmp && printf 'foo\\nbar\\nfood\\n' > a && printf 'foo\\nx\\nfoo\\n' > b && printf 'foo\\nxx\\0foo\\nyy\\0no' > bin2\nprintf '%s\\n' '--- ordinary' && python3 /app/pygrep/grep.py foo a | od -An -tc\nprintf '%s\\n' '--- context' && python3 /app/pygrep/grep.py -n -A0 foo a | od -An -tc\nprintf '%s\\n' '--- separated context groups' && python3 /app/pygrep/grep.py -n -A1 foo b | od -An -tc\nprintf '%s\\n' '--- multi files' && python3 /app/pygrep/grep.py foo a b | od -An -tc\nprintf '%s\\n' '--- binary count' && python3 /app/pygrep/grep.py -c foo bin2; echo st:$?\nprintf '%s\\n' '--- only/invert' && python3 /app/pygrep/grep.py -ov foo a | od -An -tc; echo st:${PIPESTATUS[0]}\nprintf '%s\\n' '--- missing plus match' && python3 /app/pygrep/grep.py foo absent a >/tmp/out; x=$?; cat /tmp/out; echo st:$x\n"]
