[153.073562, "o", "e(range(max(0,x-o.before),min(len(rs),x+o.after+1)))\r\n   308\t  groups=[]\r\n   309\t  for x in sorted(show):\r\n   310\t   if not groups or x>groups[-1][-1]+1:groups.append([x])\r\n   311\t   else:groups[-1].append(x)\r\n   312\t  for gi,g in enumerate(groups):\r\n   313\t   if o.context_given and (last_group or gi) and o.use_sep:output.append(o.sep+b'\\n')\r\n   314\t   for x in g:\r\n   315\t    line,off,term=rs[x]; chosen=x in selset\r\n   316\t    if chosen and o.out is None and not o.inv and getattr(o,'only',False):pass\r\n   317\t    if chosen and hasattr(o,'only') and o.only and not o.inv:\r\n   318\t     pos=0\r\n   319\t     while True:\r\n   320\t      m=one_matches(line,pats,o,pos)\r\n   321\t      if not m:break\r\n   322\t      s,e=m\r\n   323\t      if e>s: output.append(prefix(o,name,multi,x+1,off+s)+line[s:e]+(b'\\0' if o.zero else b'\\n'))\r\n   324\t      pos=e if e>s else s+1\r\n   325\t    else:\r\n   326\t     output.append(prefix(o,name,multi,x+1,off,not chosen)+line+(b'\\0' if o.zero else b'\\n'))\r\n   327\t   last_group=True\r\n   328\t if output:s"]
[153.073576, "o", "ys.stdout.buffer.write(b''.join(output))\r\n   329\t return 2 if err else (0 if had else 1)\r\n   330\t\r\n   331\t# -o is installed as a tiny parser extension without complicating option state above.\r\n   332\t_oldparse=parse\r\n   333\tdef parse(argv):\r\n   334\t mapped=[]; only=False\r\n   335\t for a in argv:\r\n   336\t  if a=='--only-matching':only=True\r\n   337\t  elif a.startswith('-') and not a.startswith('--') and 'o' in a[1:]:\r\n   338\t   only=True; z='-'+a[1:].replace('o','');\r\n   339\t   if z!='-':mapped.append(z)\r\n   340\t  else:mapped.append(a)\r\n   341\t o,f=_oldparse(mapped);o.only=only;return o,f\r\n   342\t\r\n   343\tif __name__=='__main__':sys.exit(main(sys.argv[1:]))\r\n\u001b[?2004hroot@b231699c9d89:/tmp# "]
[153.801459, "i", "python3 - <<'PY'\np='/app/pygrep/grep.py'\ns=open(p).read()\n# Empty pattern files contain no patterns; a nonempty file without a final LF retains its last pattern.\ns=s.replace(\"pp=d.split(b'\\\\n'); pp=pp[:-1] if d.endswith(b'\\\\n') else pp\", \"pp=[] if d==b'' else d.split(b'\\\\n'); pp=pp[:-1] if d.endswith(b'\\\\n') else pp\")\n# Prefix construction with -T padding and -Z after filename.\na=s.index('def prefix(o,name,multi,n,off,context=False):')\nb=s.index('\\ndef main(argv):',a)\ns=s[:a]+'''def prefix(o,name,multi,n,off,context=False):\n sep=b'-' if context else b':'\n use_name=o.fname is True or (o.fname is None and multi)\n fields=[]\n if use_name: fields.append(name)\n if o.num:\n  z=str(n).encode()\n  if o.tab: z=z.rjust(getattr(o,'nwidth',len(z)))\n  fields.append(z)\n if o.byte:\n  z=str(off).encode()\n  if o.tab: z=z.rjust(getattr(o,'bwidth',len(z)))\n  fields.append(z)\n if not fields:return b''\n # -Z replaces only the separator immediately following a filename.\n if use_name and o.zero_name:\n  r=fields[0]+b'\\\\0'\n  if len(fiel"]
[153.801631, "i", "ds)>1:r+=sep.join(fields[1:])+sep\n else:r=sep.join(fields)+sep\n if o.tab:r+=b'\\\\t'\n return r\n'''+s[b:]\n# Establish tab-alignment widths for each input file.\ns=s.replace(\"rs=records(d,0 if o.zero else ((0,10) if binary else 10))\", \"rs=records(d,0 if o.zero else ((0,10) if binary else 10))\\n  o.nwidth=len(str(max(1,len(rs))))\\n  o.bwidth=len(str(max(0,len(d))))\")\n# Counts use the normal filename separator, including -Z, but no line/offset fields.\nold=\"\"\"pr=prefix(o,name,multi,0,0) if (o.fname is True or (o.fname is None and multi)) else b''\n   # count has only a filename prefix, not line/byte fields\n   if pr:\n    sep=b':'; shown=(name+sep)\n   else:shown=b''\n   output.append(shown+str(count).encode()+b'\\\\n');continue\"\"\"\nnew=\"\"\"use_name=o.fname is True or (o.fname is None and multi)\n   shown=(name+(b'\\\\0' if o.zero_name else b':')) if use_name else b''\n   output.append(shown+str(count).encode()+b'\\\\n');continue\"\"\"\ns=s.replace(old,new)\n# -L succeeds when it lists at least one file.\ns=s.replace(\"if yes:output.appen"]
[153.801643, "i", "d(name+(b'\\\\0' if o.zero_name else b'\\\\n'))\\n   continue\", \"if yes:\\n    output.append(name+(b'\\\\0' if o.zero_name else b'\\\\n'))\\n    had=True\\n   continue\")\n# -o makes context ineffective, including separators.\ns=s.replace(\"if o.context_given and (last_group or gi) and o.use_sep:\", \"if o.context_given and not o.only and (last_group or gi) and o.use_sep:\")\n# Replace the exact rendering tail robustly.\ns=s.replace(\"\"\"     else:\n      output.append(prefix(o,name,multi,x+1,off,not chosen)+line+(b'\\\\0' if o.zero else b'\\\\n'))\"\"\", \"\"\"     elif not (o.only and o.inv):\n      output.append(prefix(o,name,multi,x+1,off,not chosen)+line+(b'\\\\0' if o.zero else b'\\\\n'))\"\"\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pygrep/grep.py\n"]
