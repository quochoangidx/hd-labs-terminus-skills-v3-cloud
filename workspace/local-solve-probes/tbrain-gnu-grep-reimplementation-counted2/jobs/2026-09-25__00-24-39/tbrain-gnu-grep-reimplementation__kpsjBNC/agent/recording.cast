[197.223776, "i", "p):buf.append(93);j+=1\n   out.extend(buf);i=j;continue\n  if c==92 and i+1<len(p):\n   d=p[i+1];i+=2\n   if 49<=d<=57:out.extend((92,d));continue\n   if not ere and d in b'()|+?{}':out.append(d);continue\n   if d==60:out.extend(b'(?<![A-Za-z0-9_])(?=[A-Za-z0-9_])');continue\n   if d==62:out.extend(b'(?<=[A-Za-z0-9_])(?![A-Za-z0-9_])');continue\n   if d==98:out.extend(b'\\\\b');continue\n   if d==66:out.extend(b'\\\\B');continue\n   out.extend((92,d));continue\n  i+=1\n  if not ere and c in b'()+?|{}':out.extend((92,c))\n  else:out.append(c)\n return bytes(out)\n\n'''\ns=s.replace(mark,insert+mark)\n# Compile patterns containing a numeric backreference with the fallback.\ns=s.replace(\"if o.mode=='F':out.append(p)\\n  else:\\n   z=Parser(p,o.mode=='E',o.icase).parse()\", \"if o.mode=='F':out.append(p)\\n  else:\\n   if re.search(br'\\\\\\\\[1-9]',p):\\n    out.append(BackrefPattern(p,o.mode=='E',o.icase));continue\\n   z=Parser(p,o.mode=='E',o.icase).parse()\")\n# At a candidate start, test all possible endpoints longest-first for fallback patter"]
