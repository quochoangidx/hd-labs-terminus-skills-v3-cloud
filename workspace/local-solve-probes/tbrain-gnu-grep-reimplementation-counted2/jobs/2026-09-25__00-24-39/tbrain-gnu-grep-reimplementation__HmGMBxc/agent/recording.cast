[80.497074, "i", "   elif c == 'f': load_patterns(o, val)\r                elif c == 'm': o.max_count = number(val)\r                elif c == 'A': o.after = number(val); o.after_set = True; o.context_seen = True\r                elif c == 'B': o.before = number(val); o.before_set = True; o.context_seen = True\r                else: context_both(val)\r                j = len(a)\r            else: raise RuntimeError(\"invalid option -- '%s'\" % c)\r        i += 1\r    if not o.patterns:\r        if not operands: raise RuntimeError(\"no pattern supplied\")\r        o.patterns.extend(split_arg(operands.pop(0)))\r    if o.engine is None: o.engine = 'bre'\r    return o, operands\r\r\rdef split_arg(s):\r    return [x.encode('latin1', 'surrogateescape') for x in s.split('\\n')]\r\r\rdef load_patterns(o, fn):\r    try:\r        data = sys.stdin.buffer.read() if fn == '-' else open(fn, 'rb').read()\r    except OSError as e: raise RuntimeError('%s: %s' % (fn, e.strerror))\r    parts = data.split(b'\\n')\r    if data.endswith(b'\\n'): parts.pop()\r    o.patterns.exten"]
