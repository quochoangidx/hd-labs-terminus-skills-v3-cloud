[515.838404, "o", "\u001b[?2004h> p='/app/pygrep/grep.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"        if self.o.word:\\n            if a and self.wordchar(s[a-1]): return False\", \"        if self.o.word and not self.o.line:\\n            if a and self.wordchar(s[a-1]): return False\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[515.851707, "o", "\u001b[?2004hroot@549045aa6fa8:/app# python3 -m py_compile /app/pygrep/grep.py\r\n\u001b[?2004l\r"]
[515.921145, "o", "\u001b[?2004hroot@549045aa6fa8:/app# printf '@\\nfoo\\n' >/tmp/xw_input\r\n\u001b[?2004l\r\u001b[?2004hroot@549045aa6fa8:/app# python3 /app/pygrep/grep.py -xw '@' /tmp/xw_input >/tmp/xw_out; rc=$?; test \"$rc\" = 0 && test \"$(cat /tmp/xw_out)\" = '@'\r\n\u001b[?2004l\r"]
[515.968134, "o", "\u001b[?2004hroot@549045aa6fa8:/app# python3 /tmp/test_pygrep.py && python3 /tmp/test_more.py && python3 /tmp/test_edge.py && python3 /tmp/test_anchor.py && python3 /tmp/test_final.py\r\n\u001b[?2004l\r"]
[517.137098, "o", "ok\r\n"]
