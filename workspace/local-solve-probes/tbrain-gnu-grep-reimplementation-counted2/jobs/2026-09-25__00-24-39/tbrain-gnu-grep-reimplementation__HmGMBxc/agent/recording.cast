[80.496991, "i", "0)\r        elif name == 'help':\r            sys.stdout.write('Usage: grep [OPTION]... PATTERNS [FILE]...\\n'); raise SystemExit(0)\r        else: raise RuntimeError(\"unrecognized option '--%s'\" % name)\r    while i < len(argv):\r        a = argv[i]\r        if end or not a.startswith('-') or a == '-': operands.append(a); i += 1; continue\r        if a == '--': end = True; i += 1; continue\r        if a.startswith('--'):\r            longopt(a, argv[i+1] if i+1 < len(argv) else None); i += 1; continue\r        if len(a) > 1 and a[1:].isdigit(): context_both(a[1:]); i += 1; continue\r        j = 1\r        while j < len(a):\r            c = a[j]\r            if c in 'GEF': engine({'G':'bre','E':'ere','F':'fixed'}[c]); j += 1\r            elif c in 'ivwxconbsTHhZzqalsIL':\r                if c == 'i': o.ignore = True\r                elif c == 'v': o.invert = True\r                elif c == 'w': o.word = True\r                elif c == 'x': o.line = True\r                elif c == 'c': o.mode = 'count'\r                elif c == 'o"]
