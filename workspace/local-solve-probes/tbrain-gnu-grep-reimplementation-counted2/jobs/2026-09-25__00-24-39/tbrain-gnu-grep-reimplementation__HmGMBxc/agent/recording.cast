[194.550436, "i", "python3 - <<'PY'\np='/app/pygrep/grep.py'\ns=open(p).read()\ns=s.replace(\"    parts = data.split(b'\\\\n')\\n    if data.endswith(b'\\\\n'): parts.pop()\\n    o.patterns.extend(parts)\", \"    if not data:\\n        return\\n    parts = data.split(b'\\\\n')\\n    if data.endswith(b'\\\\n'): parts.pop()\\n    o.patterns.extend(parts)\")\ns=s.replace(\"class Matcher:\\n    def __init__(self, o):\", \"ASCII_FOLD = str.maketrans('ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')\\n\\n\\nclass Matcher:\\n    def __init__(self, o):\")\ns=s.replace(\"self.fixed.append(s.lower() if o.ignore else s)\", \"self.fixed.append(s.translate(ASCII_FOLD) if o.ignore else s)\")\ns=s.replace(\"cmp=s.lower() if self.o.ignore else s\", \"cmp=s.translate(ASCII_FOLD) if self.o.ignore else s\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pygrep/grep.py && python3 /tmp/test_pygrep.py\n"]
