[199.55262, "i", "printf '\\n--- initial-tab ---\\n'; sed -n '/initial-tab/,+18p' /app/docs/grep.txt | head -40; printf '\\n--- binary ---\\n'; sed -n '/binary-files/,+45p' /app/docs/grep.txt | head -70; printf '\\n--- word regexp ---\\n'; sed -n '/word-regexp/,+18p' /app/docs/grep.txt | head -35\n"]
