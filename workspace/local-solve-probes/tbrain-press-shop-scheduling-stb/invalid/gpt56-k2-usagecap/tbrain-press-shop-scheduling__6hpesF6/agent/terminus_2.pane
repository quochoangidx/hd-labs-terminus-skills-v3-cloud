[?2004hroot@807a05a9cfa8:/app# cat > /app/blockopt.py <<'PY'
[?2004l[?2004h> import json,sys,time,random,math
[?2004l[?2004h> sys.path.insert(0,'/app/tools'); from check_schedule import clear_of,minutes,evaluate
[?2004l[?2004h> name=sys.argv[1]; limit=float(sys.argv[2]); start=time.time()
[?2004l[?2004h> w=json.load(open('/app/weeks/'+name+'.json')); target=json.load(open('/app/weeks/targets.json'))[name]
[?2004l[?2004h> P=w['presses']; J={j['id']:j for j in w['jobs']}; n=len(P)
[?2004l[?2004h> s0=json.load(open('/app/schedules/'+name+'.json'))['presses']; best=[s0.get(p['id'],[])[:] for p in P]
[?2004l[?2004h> elig={z:[i for i,p in enumerate(P) if J[z]['tonnage']<=p['tonnage']] for z in J}
[?2004l[?2004h> def cost(i,a):
[?2004l[?2004h>  p=P[i]; clock=st=pen=0; fam=p['initial_family']
[?2004l[?2004h>  for z in a:
[?2004l[?2004h>   j=J[z]; ch=w['setup_minutes'][fam][j['family']]; cs=clear_of(clock,ch,p['maintenance']); run=minutes(j,p); ss=clear_of(max(cs+ch,j['release']),run,p['maintenance']); clock=ss+run; st+=ch; pen+=j['weight']*max(0,clock-j['due']); fam=j['family']
[?2004l[?2004h>  return 40*st+pen
[?2004l[?2004h> def runs(a):
[?2004l[?2004h>  r=[]; x=0
[?2004l[?2004h>  while x<len(a):
[?2004l[?2004h>   y=x+1
[?2004l[?2004h>   while y<len(a) and J[a[y]]['family']==J[a[x]]['family']: y+=1
[?2004l[?2004h>   r.append((x,y)) ; x=y
[?2004l[?2004h>  return r
[?2004l[?2004h> def save():
[?2004l[?2004h>  json.dump({'presses':{P[i]['id']:best[i] for i in range(n)}},open('/app/schedules/'+name+'.json','w'),indent=1)
[?2004l[?2004h>  print(name,'BEST',bc,'target',target,'t',round(time.time()-start,1),flush=True)
[?2004l[?2004h> cc=[cost(i,a) for i,a in enumerate(best)]; bc=sum(cc); save(); cycle=0
[?2004l[?2004h> while time.time()-start<limit and bc>target:
[?2004l[?2004h>  cycle+=1; s=[a[:] for a in best]; c=[cost(i,a) for i,a in enumerate(s)]; cur=sum(c)
[?2004l[?2004h>  for it in range(100000):
[?2004l[?2004h>   if time.time()-start>=limit: break
[?2004l[?2004h>   typ=random.random(); old={}; changed=set()
[?2004l[?2004h>   if typ<.38: # move a complete maximal family run
[?2004l[?2004h>    a=random.randrange(n); rr=runs(s[a])
[?2004l[?2004h>    if not rr: continue
[?2004l[?2004h>    x,y=random.choice(rr); block=s[a][x:y]; poss=set(elig[block[0]])
[?2004l[?2004h>    for z in block[1:]: poss.intersection_update(elig[z])
[?2004l[?2004h>    if not poss: continue
