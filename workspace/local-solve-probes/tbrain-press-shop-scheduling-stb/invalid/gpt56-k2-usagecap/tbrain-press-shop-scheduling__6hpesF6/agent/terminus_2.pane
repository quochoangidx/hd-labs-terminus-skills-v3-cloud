[?2004l[?2004h> for fn in sorted(glob.glob('/app/weeks/week-*.json')):
[?2004l[?2004h>  n=fn.split('/')[-1][:-5]; w=json.load(open(fn)); s=json.load(open('/app/schedules/'+n+'.json')); J={j['id']:j for j in w['jobs']}; P={p['id']:p for p in w['presses']}
[?2004l[?2004h>  print('\n',n,'cost',evaluate(w,s),'target',T[n])
[?2004l[?2004h>  for pid,seq in s['presses'].items():
[?2004l[?2004h>   p=P[pid]; clock=st=pen=0; fam=p['initial_family']
