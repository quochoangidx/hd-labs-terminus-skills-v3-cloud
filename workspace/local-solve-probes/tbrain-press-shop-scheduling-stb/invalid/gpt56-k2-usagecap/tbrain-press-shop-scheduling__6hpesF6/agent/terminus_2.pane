[?2004l[?2004h>    j=J[z]; ch=w['setup_minutes'][fam][j['family']]; cs=clear_of(clock,ch,p['maintenance']); run=minutes(j,p); start=clear_of(max(cs+ch,j['release']),run,p['maintenance']); end=start+run; st+=ch; pen+=j['weight']*max(0,end-j['due']); clock=end; fam=j['family']
[?2004l[?2004h>   print(pid,len(seq),'setup',st,'pen',pen,'cost',40*st+pen,'end',clock,''.join(J[z]['family'] for z in seq))
[?2004l[?2004h> PY
