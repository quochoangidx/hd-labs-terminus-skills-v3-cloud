        S[best].append(x)\n    return S\n\nstarts=[construct(0,0),construct(0,1),construct(1,0),completion_construct(300)]\nS=min(starts,key=total); cur=total(S); best=cur; BS=[s[:] for s in S]\nprint('initial',cur,flush=True)\nend=time.time()+seconds; it=0; accepted=0; restart_at=time.time()+seconds/3\n# Annealing with periodic reheating; target temperatures calibrated in cost units.\nwhile time.time()<end:\n    frac=max(0,(end-time.time())/seconds)\n    T=30 + 3500*(frac**2)\n    typ=random.random()\n    affected=set()\n    undo=None\n    if typ<.68:\n        a=random.randrange(m)\n        if not S[a]: continue\n        i=random.randrange(len(S[a])); x=S[a][i]\n        b=random.choice(elig[x]); k=random.randrange(len(S[b])+1)\n        old=sum(pcost(q,S[q]) for q in {a,b})\n        S[a].pop(i)\n        if a==b and k>i:k-=1\n        S[b].insert(k,x)\n        new=sum(pcost(q,S[q]) for q in {a,b}); delta=new-old\n        undo=('rel',a,i,b,k)\n    elif typ<.93:\n        a=random.randrange(m)\n        if not S[a]:continue\n        b=random.randrange(m)\n        if not S[b]:continue\n        i=random.randrange(len(S[a])); k=random.randrange(len(S[b])); x,y=S[a][i],S[b][k]\n        if b not in elig[x] or a not in elig[y]:continue\n        old=sum(pcost(q,S[q]) for q in {a,b})\n        S[a][i],S[b][k]=y,x\n        new=sum(pcost(q,S[q]) for q in {a,b}); delta=new-old\n        undo=('swap',a,i,b,k)\n    else:\n        a=random.randrange(m)\n        if len(S[a])<2:continue\n        i,k=sorted(random.sample(range(len(S[a])),2)); old=pcost(a,S[a]); S[a][i:k+1]=reversed(S[a][i:k+1]); new=pcost(a,S[a]); delta=new-old\n        undo=('rev',a,i,k)\n    if delta<=0 or random.random()<math.exp(-delta/T):\n        cur+=delta; accepted+=1\n        if cur<best:\n            best=cur; BS=[s[:] for s in S]\n            print('best',best,'it',it,flush=True)\n    else:\n        if undo[0]=='rel':\n            _,a,i,b,k=undo; x=S[b].pop(k); S[a].insert(i,x)\n        elif undo[0]=='swap':\n   