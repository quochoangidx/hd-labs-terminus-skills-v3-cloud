Sending keys: ["cat > /app/optimize.py <<'PY'\nimport json,sys,time,random,math,os\nfrom pathlib import Path\nsys.path.insert(0,'/app/tools')\nfrom check_schedule import clear_of,minutes,evaluate\n\nname=sys.argv[1]; limit=float(sys.argv[2]) if len(sys.argv)>2 else 30\nwf=f'/app/weeks/{name}.json'; out=f'/app/schedules/{name}.json'\nw=json.load(open(wf)); target=json.load(open('/app/weeks/targets.json'))[name]\npress=w['presses']; jobs=w['jobs']; J={j['id']:j for j in jobs}; pindex={p['id']:i for i,p in enumerate(press)}\nelig={j['id']:[i for i,p in enumerate(press) if j['tonnage']<=p['tonnage']] for j in jobs}\n\ndef pcost(pi,seq):\n p=press[pi]; clock=0; fam=p['initial_family']; st=pen=0\n for jid in seq:\n  j=J[jid]; ch=w['setup_minutes'][fam][j['family']]\n  cs=clear_of(clock,ch,p['maintenance']); run=minutes(j,p)\n  start=clear_of(max(cs+ch,j['release']),run,p['maintenance']); end=start+run\n  st+=ch; pen+=j['weight']*max(0,end-j['due']); clock=end; fam=j['family']\n return 40*st+pen\n\ndef save(s,c):\n obj={'presses':{p['id']:s[i] for i,p in enumerate(press)}}\n json.dump(obj,open(out,'w'),indent=1)\n print(name,'BEST',c,'target',target,'t',round(time.time()-begin,1),flush=True)\n\ndef dispatch(seed):\n # randomized due-date dispatch to create diverse feasible starts\n r=random.Random(seed); s=[[] for _ in press]; state=[(0,p['initial_family']) for p in press]\n order=sorted(jobs,key=lambda j:j['due']+r.uniform(-1,1)*700)\n for j in order:\n  cand=[]\n  for pi in elig[j['id']]:\n   p=press[pi]; clock,fam=state[pi]; ch=w['setup_minutes'][fam][j['family']]\n   cs=clear_of(clock,ch,p['maintenance']); run=minutes(j,p)\n   start=clear_of(max(cs+ch,j['release']),run,p['maintenance']); end=start+run\n   score=end + r.random()*250 + (ch*12 if r.random()<.7 else 0)\n   cand.append((score,end,pi))\n  _,end,pi=min(cand); s[pi].append(j['id']); state[pi]=(end,j['family'])\n return s\n\nbegin=time.time(); random.seed((hash(name)^time.time_ns())&0xffffffff)\nif os.path.exists(out):\n old=json.load(open(out)); best=[old['presses'].get(p['id'],[])[:] for p in press]\nelse: best=dispatch(0)\nbc=sum(pcost(i,x) for i,x in enumerate(best)); save(best,bc)\n# Retain the best of several fast constructive starts.\nfor k in range(30):\n s=dispatch(k+123); c=sum(pcost(i,x) for i,x in enumerate(s))\n if c<bc: best=[x[:] for x in s]; bc=c; save(best,bc)\n\ncycle=0\nwhile time.time()-begin<limit and bc>target:\n cycle+=1\n # Usually restart exactly at best; occasionally use a fresh constructor.\n if cycle%8==0:\n  s=dispatch(random.randrange(10**9)); cc=[pcost(i,x) for i,x in enumerate(s)]; cur=sum(cc)\n else:\n  s=[x[:] for x in best]; cc=[pcost(i,x) for i,x in enumerate(s)]; cur=sum(cc)\n steps=60000\n for it in range(steps):\n  if time.time()-begin>=limit: break\n  typ=random.random(); changed=set(); old={}\n  if typ<.48: # relocate one job\n   a=random.randrange(len(press))\n   if not s[a]: continue\n   x=random.randrange(len(s[a])); jid=s[a][x]; b=random.choice(elig[jid])\n   changed={a,b}; old={q:s[q][:] for q in changed}; s[a].pop(x)\n   y=random.randrange(len(s[b])+1); s[b].insert(y,jid)\n  elif typ<.70: # swap jobs\n   a=random.randrange(len(press)); b=random.randrange(len(press))\n   if not s[a] or not s[b]: continue\n   x=random.randrange(len(s[a])); y=random.randrange(len(s[b])); ja,jb=s[a][x],s[b][y]\n   if b not in elig[ja] or a not in elig[jb]: continue\n   changed={a,b}; old={q:s[q][:] for q in changed}; s[a][x],s[b][y]=jb,ja\n  elif typ<.88: # relocate contiguous block (all must fit)\n   a=random.randrange(len(press))\n   if not s[a]: continue\n   x=random.randrange(len(s[a])); ln=random.randint(2,min(6,len(s[a])-x)) if len(s[a])-x>=2 else 1\n   block=s[a][x:x+ln]; common=set(elig[block[0]])\n   for z in block[1:]: common.intersection_update(elig[z])\n   if not common: continue\n   b=random.choice(tuple(common)); changed={a,b}; old={q:s[q][:] for q in changed}\n   del s[a][x:x+ln]; y=random.randrange(len(s[b])+1); s[b][y:y]=block\n  elif typ<.96: # reverse a short segment\n   a=random.randrange(len(press))\n   if len(s[a])<2: continue\n   x=random.randrange(len(s[a])-1); y=random.randrange(x+2,min(len(s[a]),x+9)+1)\n   changed={a}; old={a:s[a][:]}; s[a][x:y]=reversed(s[a][x:y])\n  else: # gather one family's jobs on a press toward one insertion point\n   fam=random.choice('ABCDEF'); b=random.randrange(len(press)); candidates=[]\n   for a in range(len(press)):\n    for x,jid in enumerate(s[a]):\n     if J[jid]['family']==fam and b in elig[jid]: candidates.append((a,x,jid))\n   if not candidates: continue\n   a,x,jid=random.choice(candidates); changed={a,b}; old={q:s[q][:] for q in changed}; s[a].pop(x)\n   spots=[i for i,z in enumerate(s[b]) if J[z]['family']==fam]\n   y=(random.choice(spots)+random.randrange(2)) if spots else random.randrange(len(s[b])+1)\n   s[b].insert(min(y,len(s[b])),jid)\n  nc={q:pcost(q,s[q]) for q in changed}; delta=sum(nc[q]-cc[q] for q in changed)\n  phase=(it%12000)/12000; temp=2500*(.002**phase)\n  if delta<=0 or random.random()<math.exp(-delta/max(temp,1e-9)):\n   cur+=delta\n   for q in changed: cc[q]=nc[q]\n   if cur<bc:\n    best=[x[:] for x in s]; bc=cur; save(best,bc)\n    if bc<=target: break\n  else:\n   for q,v in old.items(): s[q]=v\nprint(name,'DONE',bc,'target',target,'cycles',cycle)\nPY\npython3 /app/optimize.py week-36 25\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
