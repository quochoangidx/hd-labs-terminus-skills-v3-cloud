[475.876257, "i", "cat > /app/descent.py <<'PY'\nimport json,sys,os,math,time\nwf,sf=sys.argv[1:3]; limit=float(sys.argv[3])\nd=json.load(open(wf)); sol=json.load(open(sf))['presses']; P=d['presses']; J=d['jobs']; setup=d['setup_minutes']; sc=d['setup_cost_per_minute']\nix={j['id']:i for i,j in enumerate(J)}; S=[[ix[x] for x in sol.get(p['id'],[])] for p in P]\nelig=[[q for q,p in enumerate(P) if p['tonnage']>=j['tonnage']] for j in J]\ndef avoid(t,L,M):\n while 1:\n  z=t\n  for a,b in M:\n   if t<b and t+L>a:z=max(z,b)\n  if z==t:return t\n  t=z\ndef cost(q,s):\n p=P[q];t=0;f=p['initial_family'];c=0\n for x in s:\n  j=J[x]; u=setup[f][j['family']]; c+=sc*u;t=avoid(t,u,p['maintenance'])+u\n  r=(j['strokes']+p['strokes_per_minute']-1)//p['strokes_per_minute'];t=avoid(max(t,j['release']),r,p['maintenance'])+r\n  c+=max(0,t-j['due'])*j['weight'];f=j['family']\n return c\ndef total():return sum(cost(q,s) for q,s in enumerate(S))\nend=time.time()+limit; cur=total(); print('start',cur,flush=True)\nwhile time.time()<end:\n best=0; move=None; pc=[cost(q,S[q]"]
[475.876701, "i", ") for q in range(len(P))]\n # Exhaustive relocations\n for a in range(len(P)):\n  for i,x in enumerate(S[a]):\n   for b in elig[x]:\n    for k in range(len(S[b])+1):\n     if a==b and (k==i or k==i+1):continue\n     A=S[a][:];A.pop(i)\n     kk=k-(a==b and k>i)\n     if a==b:\n      A.insert(kk,x); delta=cost(a,A)-pc[a]\n     else:\n      B=S[b][:];B.insert(k,x);delta=cost(a,A)+cost(b,B)-pc[a]-pc[b]\n     if delta<best:best=delta;move=('r',a,i,b,k)\n # Exhaustive swaps if time allows\n for a in range(len(P)):\n  for b in range(a,len(P)):\n   for i,x in enumerate(S[a]):\n    ks=range(i+1,len(S[b])) if a==b else range(len(S[b]))\n    for k in ks:\n     y=S[b][k]\n     if b not in elig[x] or a not in elig[y]:continue\n     A=S[a][:]; B=A if a==b else S[b][:];A[i],B[k]=y,x\n     delta=(cost(a,A)-pc[a]) if a==b else cost(a,A)+cost(b,B)-pc[a]-pc[b]\n     if delta<best:best=delta;move=('s',a,i,b,k)\n if not move:break\n if move[0]=='r':\n  _,a,i,b,k=move;x=S[a].pop(i);k-=a==b and k>i;S[b].insert(k,x)\n else:\n  _,a,i,b,k=move;S[a][i],S[b][k]=S[b"]
[475.876828, "i", "][k],S[a][i]\n cur+=best;print(cur,best,move,flush=True)\nout={'presses':{p['id']:[J[x]['id'] for x in S[q]] for q,p in enumerate(P)}};json.dump(out,open(sf,'w'),indent=2);print('FINAL',total())\nPY\npython3 /app/descent.py /app/weeks/week-37.json /app/schedules/week-37.json 58\n"]
[475.877138, "o", "cat > /app/descent.py <<'PY'\r\n"]
