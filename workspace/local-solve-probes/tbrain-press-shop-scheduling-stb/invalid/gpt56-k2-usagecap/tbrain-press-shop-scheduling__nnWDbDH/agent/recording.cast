[58.819804, "i", "cat > /app/optimize.py <<'PY'\nimport json, math, random, time, sys, os\n\nfn=sys.argv[1]; seconds=float(sys.argv[2]); seed=int(sys.argv[3]) if len(sys.argv)>3 else 1\nrandom.seed(seed)\nd=json.load(open(fn)); P=d['presses']; J=d['jobs']; n=len(J); m=len(P)\nidx={j['id']:i for i,j in enumerate(J)}\nelig=[[q for q,p in enumerate(P) if p['tonnage']>=j['tonnage']] for j in J]\nsetup=d['setup_minutes']; sc=d['setup_cost_per_minute']\n\ndef avoid(t,L,maint):\n    while True:\n        nt=t\n        for a,b in maint:\n            if t < b and t+L > a: nt=max(nt,b)\n        if nt==t:return t\n        t=nt\n\ndef pcost(q,seq):\n    p=P[q]; t=0; fam=p['initial_family']; c=0\n    for x in seq:\n        j=J[x]; s=setup[fam][j['family']]; c+=sc*s\n        t=avoid(t,s,p['maintenance'])+s\n        r=(j['strokes']+p['strokes_per_minute']-1)//p['strokes_per_minute']\n        t=avoid(max(t,j['release']),r,p['maintenance'])+r\n        if t>j['due']: c+=(t-j['due'])*j['weight']\n        fam=j['family']\n    return c\n\ndef total(S): return sum(pcost(q,s) fo"]
[58.82034, "i", "r q,s in enumerate(S))\n\ndef construct(rule,noise=0):\n    S=[[] for _ in P]; times=[0]*m; fam=[p['initial_family'] for p in P]\n    order=sorted(range(n),key=lambda x:(J[x]['due']+noise*random.random()*1500, -J[x]['weight'],J[x]['release']))\n    for x in order:\n        best=None\n        for q in elig[x]:\n            old=pcost(q,S[q]); new=pcost(q,S[q]+[x]); delta=new-old\n            # varying emphasis gives diverse starts\n            score = delta if rule==0 else (new + (rule-1)*700*len(S[q]))\n            if best is None or score<best[0]:best=(score,q)\n        S[best[1]].append(x)\n    return S\n\n# include planner-like earliest-completion append construction\ndef completion_construct(noise=0):\n    S=[[] for _ in P]\n    order=sorted(range(n),key=lambda x:(J[x]['due']+random.uniform(-noise,noise),-J[x]['weight']))\n    for x in order:\n        best=min(elig[x],key=lambda q:pcost(q,S[q]+[x])-pcost(q,S[q]))\n        S[best].append(x)\n    return S\n\nstarts=[construct(0,0),construct(0,1),construct(1,0),completion_construct("]
[58.820362, "o", "cat > /app/optimize.py <<'PY'\r\n\u001b[?2004l\r"]
[58.820377, "i", "300)]\nS=min(starts,key=total); cur=total(S); best=cur; BS=[s[:] for s in S]\nprint('initial',cur,flush=True)\nend=time.time()+seconds; it=0; accepted=0; restart_at=time.time()+seconds/3\n# Annealing with periodic reheating; target temperatures calibrated in cost units.\nwhile time.time()<end:\n    frac=max(0,(end-time.time())/seconds)\n    T=30 + 3500*(frac**2)\n    typ=random.random()\n    affected=set()\n    undo=None\n    if typ<.68:\n        a=random.randrange(m)\n        if not S[a]: continue\n        i=random.randrange(len(S[a])); x=S[a][i]\n        b=random.choice(elig[x]); k=random.randrange(len(S[b])+1)\n        old=sum(pcost(q,S[q]) for q in {a,b})\n        S[a].pop(i)\n        if a==b and k>i:k-=1\n        S[b].insert(k,x)\n        new=sum(pcost(q,S[q]) for q in {a,b}); delta=new-old\n        undo=('rel',a,i,b,k)\n    elif typ<.93:\n        a=random.randrange(m)\n        if not S[a]:continue\n        b=random.randrange(m)\n        if not S[b]:continue\n        i=random.randrange(len(S[a])); k=random.randrange(len(S[b])); x,"]
[58.820477, "o", "\u001b[?2004h> "]
[58.820488, "i", "y=S[a][i],S[b][k]\n        if b not in elig[x] or a not in elig[y]:continue\n        old=sum(pcost(q,S[q]) for q in {a,b})\n        S[a][i],S[b][k]=y,x\n        new=sum(pcost(q,S[q]) for q in {a,b}); delta=new-old\n        undo=('swap',a,i,b,k)\n    else:\n        a=random.randrange(m)\n        if len(S[a])<2:continue\n        i,k=sorted(random.sample(range(len(S[a])),2)); old=pcost(a,S[a]); S[a][i:k+1]=reversed(S[a][i:k+1]); new=pcost(a,S[a]); delta=new-old\n        undo=('rev',a,i,k)\n    if delta<=0 or random.random()<math.exp(-delta/T):\n        cur+=delta; accepted+=1\n        if cur<best:\n            best=cur; BS=[s[:] for s in S]\n            print('best',best,'it',it,flush=True)\n    else:\n        if undo[0]=='rel':\n            _,a,i,b,k=undo; x=S[b].pop(k); S[a].insert(i,x)\n        elif undo[0]=='swap':\n            _,a,i,b,k=undo; S[a][i],S[b][k]=S[b][k],S[a][i]\n        else:\n            _,a,i,k=undo; S[a][i:k+1]=reversed(S[a][i:k+1])\n    it+=1\n    # Restart from incumbent and reheat naturally through occasional pe"]
[58.820515, "i", "rturbations\n    if it%50000==0:\n        S=[s[:] for s in BS];cur=best\nprint('FINAL',best,'iterations',it,flush=True)\nout={'presses':{P[q]['id']:[J[x]['id'] for x in BS[q]] for q in range(m)}}\nos.makedirs('/app/schedules',exist_ok=True)\nbase=os.path.basename(fn).removesuffix('.json')\njson.dump(out,open('/app/schedules/'+base+'.json','w'),indent=2)\nPY\npython3 /app/optimize.py /app/weeks/week-36.json 15 11\npython3 /app/optimize.py /app/weeks/week-37.json 25 12\npython3 /app/optimize.py /app/weeks/week-38.json 35 13\n"]
