[566.754481, "o", ":continue\r\n\u001b[?2004l\r\u001b[?2004h>      if a==b:\r\n\u001b[?2004l\r\u001b[?2004h>       A=S[a][:];del A[i:v];kk=k-(v-i if k>v else 0);A[kk:kk]=block;delta=cost(a,A)-pc[a]\r\n\u001b[?2004l\r\u001b[?2004h>      else:\r\n\u001b[?2004l\r\u001b[?2004h>       A=S[a][:];del A[i:v];B=S[b][:];B[k:k]=block;delta=cost(a,A)+cost(b,B)-pc[a]-pc[b]\r\n\u001b[?2004l\r\u001b[?2004h>      if delta<best:best=delta;move=(a,i,v,b,k)\r\n\u001b[?2004l\r\u001b[?2004h>  if move is None:break\r\n\u001b[?2004l\r\u001b[?2004h>  a,i,v,b,k=move;block=S[a][i:v];del S[a][i:v]\r\n\u001b[?2004l\r\u001b[?2004h>  if a==b:k-=v-i if k>v else 0\r\n\u001b[?2004l\r\u001b[?2004h>  S[b][k:k]=block;cur+=best;print('best',cur,best,move,flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> out={'presses':{p['id']:[J[x]['id'] for x in S[q]] for q,p in enumerate(P)}};json.dump(out,open(sf,'w'),indent=2);print('FINAL',total())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
