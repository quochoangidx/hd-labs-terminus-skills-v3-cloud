[566.751695, "i", "cat > /app/blockdescent.py <<'PY'\nexec(open('/app/descent.py').read().split(\"end=time.time()+limit\")[0])\nend=time.time()+limit;cur=total();print('start',cur,flush=True)\nwhile time.time()<end:\n pc=[cost(q,S[q]) for q in range(len(P))];best=0;move=None\n for a in range(len(P)):\n  # all same-family runs, plus bounded arbitrary segments\n  seg=set()\n  i=0\n  while i<len(S[a]):\n   k=i+1\n   while k<len(S[a]) and J[S[a][k]]['family']==J[S[a][i]]['family']:k+=1\n   for u in range(i,k):\n    for v in range(u+1,k+1):seg.add((u,v))\n   i=k\n  for i in range(len(S[a])):\n   for v in range(i+2,min(len(S[a]),i+12)+1):seg.add((i,v))\n  for i,v in seg:\n   block=S[a][i:v]\n   for b in range(len(P)):\n    if not all(b in elig[x] for x in block):continue\n    for k in range(len(S[b])+1):\n     if a==b and i<=k<=v:continue\n     if a==b:\n      A=S[a][:];del A[i:v];kk=k-(v-i if k>v else 0);A[kk:kk]=block;delta=cost(a,A)-pc[a]\n     else:\n      A=S[a][:];del A[i:v];B=S[b][:];B[k:k]=block;delta=cost(a,A)+cost(b,B)-pc[a]-pc[b]\n     if delta<best:b"]
[566.751822, "i", "est=delta;move=(a,i,v,b,k)\n if move is None:break\n a,i,v,b,k=move;block=S[a][i:v];del S[a][i:v]\n if a==b:k-=v-i if k>v else 0\n S[b][k:k]=block;cur+=best;print('best',cur,best,move,flush=True)\nout={'presses':{p['id']:[J[x]['id'] for x in S[q]] for q,p in enumerate(P)}};json.dump(out,open(sf,'w'),indent=2);print('FINAL',total())\nPY\npython3 /app/blockdescent.py /app/weeks/week-37.json /app/schedules/week-37.json 58\n"]
[566.751867, "o", "cat > /app/blockdescent.py <<'PY'\r\n\u001b[?2004l\r"]
[566.752249, "o", "est=delta;move=(a,i,v,b,k)\r\n if move is None:break\r\n a,i,v,b,k=move;block=S[a][i:v];del S[a][i:v]\r\n if a==b:k-=v-i if k>v else 0\r\n S[b][k:k]=block;cur+=best;print('best',cur,best,move,flush=True)\r\nout={'presses':{p['id']:[J[x]['id'] for x in S[q]] for q,p in enumerate(P)}};json.dump(out,open(sf,'w'),indent=2);print('FINAL',total())\r\nPY\r\npython3 /app/blockdescent.py /app/weeks/week-37.json /app/schedules/week-37.json 58\r\n\u001b[?2004h> exec(open('/app/descent.py').read().split(\"end=time.time()+limit\")[0])\r\n\u001b[?2004l\r\u001b[?2004h> end=time.time()+limit;cur=total();print('start',cur,flush=True)"]
