[175.236319, "i", "python3 - <<'PY'\np='/app/optimize.py'\ns=open(p).read()\ns=s.replace(\"starts=[construct(0,0),construct(0,1),construct(1,0),completion_construct(300)]\\nS=min(starts,key=total)\",\"\"\"starts=[construct(0,0),construct(0,1),construct(1,0),completion_construct(300)]\nbase=os.path.basename(fn).removesuffix('.json')\noldfile='/app/schedules/'+base+'.json'\nif os.path.exists(oldfile):\n    od=json.load(open(oldfile))['presses']\n    starts.append([[idx[x] for x in od.get(p['id'],[])] for p in P])\nS=min(starts,key=total)\"\"\")\ns=s.replace(\"if typ<.68:\",\"if typ<.58:\")\ns=s.replace(\"elif typ<.93:\",\"elif typ<.82:\")\ns=s.replace(\"    else:\\n        a=random.randrange(m)\\n        if len(S[a])<2:continue\\n        i,k=sorted(random.sample(range(len(S[a])),2)); old=pcost(a,S[a]); S[a][i:k+1]=reversed(S[a][i:k+1]); new=pcost(a,S[a]); delta=new-old\\n        undo=('rev',a,i,k)\",\"\"\"    elif typ<.94:\n        a=random.randrange(m)\n        if len(S[a])<2: continue\n        L=random.randint(2,min(5,len(S[a]))); i=random.randrange(len(S[a])-L+1); bl"]
[175.236379, "i", "ock=S[a][i:i+L]\n        choices=[q for q in range(m) if all(q in elig[x] for x in block)]\n        b=random.choice(choices); oldseqA=S[a][:]; oldseqB=S[b][:]\n        old=sum(pcost(q,S[q]) for q in {a,b})\n        del S[a][i:i+L]; k=random.randrange(len(S[b])+1); S[b][k:k]=block\n        new=sum(pcost(q,S[q]) for q in {a,b}); delta=new-old\n        undo=('block',a,oldseqA,b,oldseqB)\n    else:\n        a=random.randrange(m)\n        if len(S[a])<2:continue\n        i,k=sorted(random.sample(range(len(S[a])),2)); old=pcost(a,S[a]); S[a][i:k+1]=reversed(S[a][i:k+1]); new=pcost(a,S[a]); delta=new-old\n        undo=('rev',a,i,k)\"\"\")\ns=s.replace(\"        elif undo[0]=='swap':\\n            _,a,i,b,k=undo; S[a][i],S[b][k]=S[b][k],S[a][i]\\n        else:\",\"\"\"        elif undo[0]=='swap':\n            _,a,i,b,k=undo; S[a][i],S[b][k]=S[b][k],S[a][i]\n        elif undo[0]=='block':\n            _,a,sa,b,sb=undo; S[a]=sa\n            if b!=a:S[b]=sb\n        else:\"\"\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/optimize.py && pyth"]
[175.236387, "i", "on3 /app/optimize.py /app/weeks/week-36.json 50 101\n"]
