[30.52721, "i", "python3 - <<'PY'\nimport json,glob,collections,os\nfor fn in glob.glob('/app/weeks/week-*.json'):\n d=json.load(open(fn)); print('\\n',os.path.basename(fn),d.keys()); print('setup cost',d['setup_cost_per_minute']); print('setup',d['setup_minutes']); print('presses:')\n for p in d['presses']: print(p)\n js=d['jobs']; print('jobs',len(js),'families',collections.Counter(j['family'] for j in js),'tonnage',collections.Counter(j['tonnage'] for j in js),'release>0',sum(j['release']>0 for j in js),'due range',(min(j['due'] for j in js),max(j['due'] for j in js)),'weights',collections.Counter(j['weight'] for j in js))\nPY\n"]
