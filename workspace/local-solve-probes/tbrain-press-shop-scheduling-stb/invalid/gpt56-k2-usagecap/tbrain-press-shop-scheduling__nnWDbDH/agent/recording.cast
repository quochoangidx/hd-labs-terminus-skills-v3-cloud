[58.826171, "o", "    T=30 + 3500*(frac**2)\r\n\u001b[?2004l\r\u001b[?2004h>     typ=random.random()\r\n\u001b[?2004l\r\u001b[?2004h>     affected=set()\r\n\u001b[?2004l\r\u001b[?2004h>     undo=None\r\n\u001b[?2004l\r\u001b[?2004h>     if typ<.68:\r\n\u001b[?2004l\r\u001b[?2004h>         a=random.randrange(m)\r\n\u001b[?2004l\r\u001b[?2004h>         if not S[a]: continue\r\n\u001b[?2004l\r\u001b[?2004h>         i=random.randrange(len(S[a])); x=S[a][i]\r\n\u001b[?2004l\r\u001b[?2004h>         b=random.choice(elig[x]); k=random.randrange(len(S[b])+1)\r\n\u001b[?2004l\r\u001b[?2004h>         old=sum(pcost(q,S[q]) for q in {a,b})\r\n\u001b[?2004l\r\u001b[?2004h>         S[a].pop(i)\r\n\u001b[?2004l\r\u001b[?2004h>         if a==b and k>i:k-=1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.826405, "o", "        S[b].insert(k,x)\r\n\u001b[?2004l\r\u001b[?2004h>         new=sum(pcost(q,S[q]) for q in {a,b}); delta=new-old\r\n\u001b[?2004l\r\u001b[?2004h>         undo=('rel',a,i,b,k)\r\n\u001b[?2004l\r\u001b[?2004h>     elif typ<.93:\r\n\u001b[?2004l\r\u001b[?2004h>         a=random.randrange(m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.82671, "o", "        if not S[a]:continue\r\n\u001b[?2004l\r\u001b[?2004h>         b=random.randrange(m)\r\n\u001b[?2004l\r\u001b[?2004h>         if not S[b]:continue\r\n\u001b[?2004l\r\u001b[?2004h>         i=random.randrange(len(S[a])); k=random.randrange(len(S[b])); x,y=S[a][i],S[b][k]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.826893, "o", "        if b not in elig[x] or a not in elig[y]:continue\r\n\u001b[?2004l\r\u001b[?2004h>         old=sum(pcost(q,S[q]) for q in {a,b})\r\n\u001b[?2004l\r\u001b[?2004h>         S[a][i],S[b][k]=y,x\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.827051, "o", "        new=sum(pcost(q,S[q]) for q in {a,b}); delta=new-old\r\n\u001b[?2004l\r\u001b[?2004h>         undo=('swap',a,i,b,k)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         a=random.randrange(m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
