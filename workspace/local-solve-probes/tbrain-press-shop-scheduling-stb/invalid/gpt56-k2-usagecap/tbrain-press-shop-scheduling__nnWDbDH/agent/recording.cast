[546.824946, "i", "cat > /app/report.py <<'PY'\nimport json,sys,math\nw=json.load(open(sys.argv[1])); z=json.load(open(sys.argv[2]))['presses']; J={j['id']:j for j in w['jobs']}; sm=w['setup_minutes']; sc=w['setup_cost_per_minute']\ndef av(t,L,M):\n while 1:\n  q=t\n  for a,b in M:\n   if t<b and t+L>a:q=max(q,b)\n  if q==t:return t\n  t=q\nTS=TT=0\nfor p in w['presses']:\n t=0;f=p['initial_family'];su=ta=0; late=[]; ids=z.get(p['id'],[])\n for x in ids:\n  j=J[x];u=sm[f][j['family']];su+=u;t=av(t,u,p['maintenance'])+u;r=math.ceil(j['strokes']/p['strokes_per_minute']);t=av(max(t,j['release']),r,p['maintenance'])+r\n  v=max(0,t-j['due'])*j['weight'];ta+=v\n  if v:late.append((x,j['family'],t-j['due'],j['weight'],v))\n  f=j['family']\n TS+=su*sc;TT+=ta\n print(p['id'],'n',len(ids),'setup',su*sc,'tardy',ta,'end',t,'families',''.join(J[x]['family'] for x in ids))\n print(' late',late)\nprint('TOTAL setup',TS,'tardy',TT,'=',TS+TT)\nPY\npython3 /app/report.py /app/weeks/week-37.json /app/schedules/week-37.json\n"]
[546.825523, "o", "cat > /app/report.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json,sys,math\r\n\u001b[?2004l\r\u001b[?2004h> "]
