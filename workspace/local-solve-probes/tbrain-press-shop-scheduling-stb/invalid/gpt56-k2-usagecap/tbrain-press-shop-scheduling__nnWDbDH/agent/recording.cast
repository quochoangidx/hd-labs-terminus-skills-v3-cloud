[318.284197, "i", "python3 - <<'PY'\np='/app/optimize.py'; s=open(p).read()\ns=s.replace(\"elif typ<.94:\\n        a=random.randrange(m)\",\"elif typ<.91:\\n        a=random.randrange(m)\")\ns=s.replace(\"    else:\\n        a=random.randrange(m)\\n        if len(S[a])<2:continue\\n        i,k=sorted(random.sample(range(len(S[a])),2)); old=pcost(a,S[a]); S[a][i:k+1]=reversed(S[a][i:k+1]); new=pcost(a,S[a]); delta=new-old\\n        undo=('rev',a,i,k)\",\"\"\"    elif typ<.98:\n        a,b=random.sample(range(m),2)\n        if not S[a] or not S[b]: continue\n        la=random.randint(1,min(4,len(S[a]))); lb=random.randint(1,min(4,len(S[b])))\n        ia=random.randrange(len(S[a])-la+1); ib=random.randrange(len(S[b])-lb+1)\n        ba=S[a][ia:ia+la]; bb=S[b][ib:ib+lb]\n        if not all(b in elig[x] for x in ba) or not all(a in elig[x] for x in bb): continue\n        sa=S[a][:]; sb=S[b][:]; old=pcost(a,S[a])+pcost(b,S[b])\n        S[a][ia:ia+la]=bb; S[b][ib:ib+lb]=ba\n        new=pcost(a,S[a])+pcost(b,S[b]); delta=new-old\n        undo=('blockswap',a,sa,b,s"]
