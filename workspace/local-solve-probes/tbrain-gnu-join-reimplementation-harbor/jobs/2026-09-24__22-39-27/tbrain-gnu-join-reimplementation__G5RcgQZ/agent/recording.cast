[12.294503, "o", "\"\"\"pyjoin: a GNU join (coreutils 9.1) replacement in pure Python.\r\n\r\nUsage: python3 /app/pyjoin/join.py [OPTION]... FILE1 FILE2\r\n\"\"\"\r\n\r\nimport sys\r\n\r\n\r\ndef main(argv):\r\n    sys.stderr.write(\"pyjoin: not implemented yet\\n\")\r\n    return 1\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main(sys.argv[1:]))\r\n"]
