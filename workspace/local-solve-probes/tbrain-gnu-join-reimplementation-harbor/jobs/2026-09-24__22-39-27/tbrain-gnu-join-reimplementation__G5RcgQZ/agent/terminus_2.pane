[?2004l[?2004h>             chunks.append(output_sep.join(vals) + term)
[?2004l[?2004h> 
[?2004l[?2004h>         # Header records are paired unconditionally; file 1 supplies field 0.
[?2004l[?2004h>         if cfg['header'] and (header1 is not None or header2 is not None):
[?2004l[?2004h>             emit(header1, header2, 1 if header1 is not None else 2)
[?2004l[?2004h> 
[?2004l[?2004h>         print_pairs = not cfg['only']
[?2004l[?2004h>         unpaired = cfg['also'] | cfg['only']
[?2004l[?2004h>         i = j = 0
[?2004l[?2004h>         while i < len(rows1) and j < len(rows2):
[?2004l[?2004h>             k1, k2 = key(rows1[i], 1), key(rows2[j], 2)
[?2004l[?2004h>             if k1 < k2:
[?2004l[?2004h>                 if 1 in unpaired:
[?2004l[?2004h>                     emit(rows1[i], None, 1)
[?2004l[?2004h>                 i += 1
[?2004l[?2004h>             elif k1 > k2:
[?2004l[?2004h>                 if 2 in unpaired:
[?2004l[?2004h>                     emit(None, rows2[j], 2)
[?2004l[?2004h>                 j += 1
[?2004l[?2004h>             else:
[?2004l[?2004h>                 i2, j2 = i + 1, j + 1
[?2004l[?2004h>                 while i2 < len(rows1) and key(rows1[i2], 1) == k1:
[?2004l[?2004h>                     i2 += 1
[?2004l[?2004h>                 while j2 < len(rows2) and key(rows2[j2], 2) == k2:
[?2004l[?2004h>                     j2 += 1
[?2004l[?2004h>                 if print_pairs:
[?2004l[?2004h>                     for a in rows1[i:i2]:
