[95.17302, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def read_file(name, stdin_data):\r\n\u001b[?2004l\r\u001b[?2004h>     if name == \"-\":\r\n\u001b[?2004l\r\u001b[?2004h>         return stdin_data\r\n\u001b[?2004l\r\u001b[?2004h>     with open(os.fsencode(name), \"rb\") as f:\r\n\u001b[?2004l\r\u001b[?2004h>         return f.read()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main(argv):\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         c, names = parse_args(argv)\r\n\u001b[?2004l\r\u001b[?2004h>     except ValueError as e:\r\n\u001b[?2004l\r\u001b[?2004h>         return fail(str(e))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         stdin_data = sys.stdin.buffer.read() if \"-\" in names else b\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         data1 = read_file(names[0], stdin_data)\r\n\u001b[?2004l\r\u001b[?2004h>         data2 = read_file(names[1], stdin_data)\r\n\u001b[?2004l\r\u001b[?2004h>     except OSError as e:\r\n\u001b[?2004l\r\u001b[?2004h>         return fail(str(e))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     term = b\"\\0\" if c.zero_terminated else b\"\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>     li"]
[95.173203, "o", "nes1 = records(data1, term)\r\n\u001b[?2004l\r\u001b[?2004h>     lines2 = records(data2, term)\r\n\u001b[?2004l\r\u001b[?2004h>     f1 = [split_fields(x, c) for x in lines1]\r\n\u001b[?2004l\r\u001b[?2004h>     f2 = [split_fields(x, c) for x in lines2]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # -o auto is inferred from the first record, including a header record.\r\n\u001b[?2004l\r\u001b[?2004h>     if c.auto:\r\n\u001b[?2004l\r\u001b[?2004h>         n1 = len(f1[0]) if f1 else 0\r\n\u001b[?2004l\r\u001b[?2004h>         n2 = len(f2[0]) if f2 else 0\r\n\u001b[?2004l\r\u001b[?2004h>         c.outlist = [(0, 0)]\r\n\u001b[?2004l\r\u001b[?2004h>         c.outlist += [(1, n) for n in range(n1) if n != c.j1]\r\n\u001b[?2004l\r\u001b[?2004h>         c.outlist += [(2, n) for n in range(n2) if n != c.j2]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     outsep = b\" \" if c.sep is None else c.sep\r\n\u001b[?2004l\r\u001b[?2004h>     output = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def key(fields, which):\r\n\u001b[?2004l\r\u001b[?2004h>         n = c.j1 if which == 1 else c.j2\r\n\u001b[?2004l\r\u001b[?2004h>         k = getfield(fields, n)\r\n\u001b[?2004l\r\u001b[?2004h>       "]
[95.173442, "o", "  return ascii_fold(k) if c.ignore_case else k\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def emit(a, b, preferred=1):\r\n\u001b[?2004l\r\u001b[?2004h>         \"\"\"Emit a joined or unpaired record. None denotes an absent side.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         if c.outlist is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             vals = []\r\n\u001b[?2004l\r\u001b[?2004h>             for side, n in c.outlist:\r\n\u001b[?2004l\r\u001b[?2004h>                 if side == 0:\r\n\u001b[?2004l\r\u001b[?2004h>                     if preferred == 1 and a is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                         v = getfield(a, c.j1)\r\n\u001b[?2004l\r\u001b[?2004h>                     elif b is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                         v = getfield(b, c.j2)\r\n\u001b[?2004l\r\u001b[?2004h>                     elif a is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                         v = getfield(a, c.j1)\r\n\u001b[?2004l\r\u001b[?2004h>                     else:\r\n\u001b[?2004l\r\u001b[?2004h>                         v = b\"\"\r\n\u001b[?2004l\r\u001b[?2004h>                 else:\r\n\u001b[?2004l\r\u001b[?2004h>                     src = a if side == 1 else b"]
[95.173492, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>                     v = getfield(src, n) if src is not None else b\"\"\r\n\u001b[?2004l\r\u001b[?2004h>                 if v == b\"\" and c.empty:\r\n\u001b[?2004l\r\u001b[?2004h>                     v = c.empty\r\n\u001b[?2004l\r\u001b[?2004h>                 vals.append(v)\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             if a is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 joinval = getfield(a, c.j1)\r\n\u001b[?2004l\r\u001b[?2004h>             elif b is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 joinval = getfield(b, c.j2)\r\n\u001b[?2004l\r\u001b[?2004h>             else:\r\n\u001b[?2004l\r\u001b[?2004h>                 joinval = b\"\"\r\n\u001b[?2004l\r\u001b[?2004h>             vals = [joinval]\r\n\u001b[?2004l\r\u001b[?2004h>             if a is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 vals.extend(v for n, v in enumerate(a) if n != c.j1)\r\n\u001b[?2004l\r\u001b[?2004h>             if b is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 vals.extend(v for n, v in enumerate(b) if n != c.j2)\r\n\u001b[?2004l\r\u001b[?2004h>         output.append(outsep.join(vals) + term)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b"]
[95.173543, "o", "[?2004l\r\u001b[?2004h>     start1 = start2 = 0\r\n\u001b[?2004l\r\u001b[?2004h>     if c.header:\r\n\u001b[?2004l\r\u001b[?2004h>         h1 = f1[0] if f1 else None\r\n\u001b[?2004l\r\u001b[?2004h>         h2 = f2[0] if f2 else None\r\n\u001b[?2004l\r\u001b[?2004h>         if h1 is not None or h2 is not None:\r\n\u001b[?2004l\r\u001b[?2004h>             # The first file supplies field 0 when heading keys differ.\r\n\u001b[?2004l\r\u001b[?2004h>             emit(h1, h2, 1)\r\n\u001b[?2004l\r\u001b[?2004h>         start1 = 1 if h1 is not None else 0\r\n\u001b[?2004l\r\u001b[?2004h>         start2 = 1 if h2 is not None else 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     body1 = f1[start1:]\r\n\u001b[?2004l\r\u001b[?2004h>     body2 = f2[start2:]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if c.order:\r\n\u001b[?2004l\r\u001b[?2004h>         for body, which in ((body1, 1), (body2, 2)):\r\n\u001b[?2004l\r\u001b[?2004h>             for n in range(1, len(body)):\r\n\u001b[?2004l\r\u001b[?2004h>                 if key(body[n], which) < key(body[n - 1], which):\r\n\u001b[?2004l\r\u001b[?2004h>                     return fail(\"input is not in sorted order\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[95.173628, "o", "\u001b[?2004h>     i = j = 0\r\n\u001b[?2004l\r\u001b[?2004h>     while i < len(body1) and j < len(body2):\r\n\u001b[?2004l\r\u001b[?2004h>         k1 = key(body1[i], 1)\r\n\u001b[?2004l\r\u001b[?2004h>         k2 = key(body2[j], 2)\r\n\u001b[?2004l\r\u001b[?2004h>         if k1 < k2:\r\n\u001b[?2004l\r\u001b[?2004h>             if 1 in c.show_unpaired:\r\n\u001b[?2004l\r\u001b[?2004h>                 emit(body1[i], None)\r\n\u001b[?2004l\r\u001b[?2004h>             i += 1\r\n\u001b[?2004l\r\u001b[?2004h>         elif k1 > k2:\r\n\u001b[?2004l\r\u001b[?2004h>             if 2 in c.show_unpaired:\r\n\u001b[?2004l\r\u001b[?2004h>                 emit(None, body2[j], 2)\r\n\u001b[?2004l\r\u001b[?2004h>             j += 1\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             ii = i + 1\r\n\u001b[?2004l\r\u001b[?2004h>             while ii < len(body1) and key(body1[ii], 1) == k1:\r\n\u001b[?2004l\r\u001b[?2004h>                 ii += 1\r\n\u001b[?2004l\r\u001b[?2004h>             jj = j + 1\r\n\u001b[?2004l\r\u001b[?2004h>             while jj < len(body2) and key(body2[jj], 2) == k2:"]
