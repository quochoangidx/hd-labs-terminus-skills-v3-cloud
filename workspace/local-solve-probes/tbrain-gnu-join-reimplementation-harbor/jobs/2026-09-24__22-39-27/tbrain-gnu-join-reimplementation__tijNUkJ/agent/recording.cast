[177.176882, "i", "python3 - <<'PY'\nimport subprocess, tempfile\nJ=['python3','/app/pyjoin/join.py']\nwith tempfile.TemporaryDirectory() as d:\n    a=d+'/a'; b=d+'/b'\n    def put(p,x): open(p,'wb').write(x)\n    def check(args, expected, stdin=None, status=0):\n        r=subprocess.run(J+args, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n        assert r.returncode == status, (args,r.returncode,r.stderr)\n        assert r.stdout == expected, (args,r.stdout,expected)\n\n    # Both files sorted on selected fields in LC_ALL=C.\n    put(a,b'y BB 2\\nx aa 1\\n'); put(b,b'BB q\\naa p\\n')\n    check(['-1','2','-2','1',a,b], b'BB y 2 q\\naa x 1 p\\n')\n\n    put(a,b'A 1\\nb 2\\n'); put(b,b'a X\\nB Y\\n')\n    check(['-i',a,b], b'A 1 X\\nb 2 Y\\n')\n\n    put(a,b'a::c\\nb:x:y\\n'); put(b,b'a:q\\nb::z\\n')\n    check(['-t',':','-e','NA','-o','0,1.2,2.2',a,b], b'a:NA:q\\nb:x:NA\\n')\n    check(['-t',':','-o','1.2\\t2.2',a,b], b':q\\nx:\\n')\n\n    put(a,b'H A\\na 1\\n'); put(b,b'Q B\\na 2\\n')\n    check(['--header','-o','0,1.2,2.2',a,b], b'H A B\\na 1 2\\n')\n\n    put"]
[177.177212, "i", "(b,b'a X\\nb Y\\n')\n    check([a,'-'], b'a 1 X\\n', stdin=open(b,'rb').read())\n\n    put(a,b'a 1\\nc 3\\n'); put(b,b'a X Y\\nb Z\\n')\n    check(['-a','1','-a','2','-o','auto','-e','NA',a,b],\n          b'a 1 X Y\\nb NA Z NA\\nc 3 NA NA\\n')\n    check(['-v','1','-a','2',a,b], b'b Z\\nc 3\\n')\n\n    put(a,b''); put(b,b'a X\\n')\n    check(['-a','2',a,b], b'a X\\n')\n    check(['-a','2','-o','auto','-e','NA',a,b], b'a X\\n')\n\n    put(a,b'b 1\\na 2\\n'); put(b,b'a X\\n')\n    check(['--check-order',a,b], b'', status=1)\n    r=subprocess.run(J+['--nocheck-order',a,b],stdout=subprocess.PIPE,stderr=subprocess.PIPE)\n    assert r.returncode == 0\n\n    r=subprocess.run(J+['-o','',a,b],stdout=subprocess.PIPE,stderr=subprocess.PIPE)\n    assert r.returncode != 0\nprint('all focused assertions passed')\nPY\nwc -l /app/pyjoin/join.py && tail -5 /app/pyjoin/join.py\n"]
