[212.207743, "i", "python3 - <<'PY'\np='/app/pyjoin/join.py'\ns=open(p).read()\ns=s.replace('    outsep = b\" \" if c.sep is None else c.sep\\n', '    outsep = b\" \" if c.sep is None else (b\"\\\\0\" if c.whole_line else c.sep)\\n')\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pyjoin/join.py\ntmp=$(mktemp -d)\nprintf 'a\\nb\\n' > \"$tmp/a\"\nprintf 'a\\nc\\n' > \"$tmp/b\"\ntest \"$(python3 /app/pyjoin/join.py -t '' \"$tmp/a\" \"$tmp/b\")\" = a\npython3 /app/pyjoin/join.py -t '' -o '1.1,2.1' \"$tmp/a\" \"$tmp/b\" | od -An -tx1 | grep -Eq '61 00 61 0a'\nrm -rf \"$tmp\"\necho 'final checks passed'\n"]
