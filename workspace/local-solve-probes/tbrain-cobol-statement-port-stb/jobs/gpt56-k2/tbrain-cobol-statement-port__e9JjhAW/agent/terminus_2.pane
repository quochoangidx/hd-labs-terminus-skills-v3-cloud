     1	      *----------------------------------------------------------------
     2	      * CUSTREC  -  METER-READING INPUT RECORD (80 BYTES)
     3	      *----------------------------------------------------------------
     4	       01  CUST-REC.
     5	           05  REC-TYPE              PIC X.
     6	               88  IS-HEADER         VALUE "H".
     7	               88  IS-CUSTOMER       VALUE "C".
     8	           05  CUST-BODY.
     9	               10  ACCT-NO           PIC X(8).
    10	               10  CUST-NAME         PIC X(24).
    11	               10  TARIFF            PIC X.
    12	                   88  TARIFF-DOMESTIC    VALUE "D".
    13	                   88  TARIFF-COMMERCIAL  VALUE "C".
    14	                   88  TARIFF-RELIEF      VALUE "L".
    15	               10  PREV-READ         PIC 9(6).
    16	               10  CURR-READ         PIC 9(6).
    17	               10  BILL-DAYS         PIC 9(3).
    18	               10  ARREARS           PIC S9(5)V99
    19	                                     SIGN LEADING SEPARATE.
    20	               10  PAID              PIC 9(5)V99.
    21	               10  FILLER            PIC X(16).
    22	           05  HDR-BODY REDEFINES CUST-BODY.
    23	               10  STMT-DATE         PIC 9(8).
    24	               10  HDR-REGION        PIC X(20).
    25	               10  FILLER            PIC X(51).
--- WBILL 1-180 ---
     1	       IDENTIFICATION DIVISION.
     2	       PROGRAM-ID. WBILL.
     3	      *----------------------------------------------------------------
     4	      * WBILL - QUARTERLY WATER STATEMENT RUN.
     5	      * READS THE METER-READING FILE (CUSTIN) AND WRITES THE PRINTED
     6	      * STATEMENT FILE (STMTOUT).  ONE HEADER RECORD, THEN ONE RECORD
     7	      * PER ACCOUNT.  THEN POSTS THE PAYMENTS AND ADJUSTMENTS FILE
     8	      * (PAYIN) AGAINST THE NEW BALANCES AND PRINTS THE LEDGER.
     9	      *----------------------------------------------------------------
    10	       ENVIRONMENT DIVISION.
    11	       INPUT-OUTPUT SECTION.
    12	       FILE-CONTROL.
    13	           SELECT CUST-IN  ASSIGN TO CUSTIN
    14	               ORGANIZATION IS LINE SEQUENTIAL.
    15	           SELECT STMT-OUT ASSIGN TO STMTOUT
    16	               ORGANIZATION IS LINE SEQUENTIAL.
    17	           SELECT PAY-IN   ASSIGN TO PAYIN
    18	               ORGANIZATION IS LINE SEQUENTIAL.
    19	       DATA DIVISION.
    20	       FILE SECTION.
    21	       FD  CUST-IN.
    22	       01  IN-REC                    PIC X(80).
    23	       FD  STMT-OUT.
    24	       01  OUT-REC                   PIC X(72).
    25	       FD  PAY-IN.
    26	       01  PAY-REC                   PIC X(80).
    27	       WORKING-STORAGE SECTION.
    28	       COPY "CUSTREC.cpy".
    29	       COPY "TARIFFS.cpy".
    30	       01  WS-FLAGS.
    31	           05  WS-EOF                PIC X VALUE "N".
    32	               88  END-OF-INPUT      VALUE "Y".
    33	           05  WS-PAY-EOF            PIC X VALUE "N".
    34	               88  END-OF-PAY        VALUE "Y".
    35	       01  ACCT-TABLE.
    36	           05  AT-COUNT              PIC 9(4) VALUE 0.
    37	           05  AT-ENTRY OCCURS 1 TO 999 TIMES
    38	                   DEPENDING ON AT-COUNT INDEXED BY AX.
    39	               10  AT-ACCT           PIC X(8).
    40	               10  AT-BAL            PIC S9(9)V99.
    41	       01  PAY-WORK.
    42	           05  PAY-LINE              PIC X(80).
    43	           05  PL-ACCT               PIC X(8)  VALUE SPACES.
    44	           05  PL-KIND               PIC X(3)  VALUE SPACES.
    45	               88  KIND-PAY          VALUE "PAY".
    46	               88  KIND-ADJ          VALUE "ADJ".
    47	               88  KIND-FEE          VALUE "FEE".
    48	               88  KIND-REF          VALUE "REF".
    49	           05  PL-AMT-TXT            PIC X(16) VALUE SPACES.
    50	           05  PL-MEMO               PIC X(30) VALUE SPACES.
    51	           05  PL-FIELDS             PIC 99.
    52	           05  PL-ACCT-LEN           PIC 99.
    53	           05  WS-LINE-NO            PIC 9(3)  VALUE 0.
    54	           05  WS-AMT                PIC S9(7)V99.
    55	           05  WS-WHOLE              PIC S9(7).
    56	           05  WS-PART               PIC S9(7)V99.
    57	           05  WS-REM                PIC S9(3)V99.
    58	           05  WS-APPLIED            PIC 9(3)  VALUE 0.
    59	           05  WS-PAY-REJECTED       PIC 9(3)  VALUE 0.
    60	           05  WS-TOT-PAID           PIC S9(9)V99 VALUE 0.
    61	           05  WS-TOT-OTHER          PIC S9(9)V99 VALUE 0.
    62	       01  WS-WORK.
    63	           05  WS-UNITS              PIC 9(7).
    64	           05  WS-TEMP               PIC 9(7).
    65	           05  WS-LIM1               PIC 9(5)V9.
    66	           05  WS-LIM2               PIC 9(5)V9.
    67	           05  WS-B1                 PIC 9(5)V9.
    68	           05  WS-B2                 PIC 9(5)V9.
    69	           05  WS-B3                 PIC 9(7)V9.
    70	           05  WS-C1                 PIC 9(6)V99.
    71	           05  WS-C2                 PIC 9(6)V99.
    72	           05  WS-C3                 PIC 9(7)V99.
    73	           05  WS-USAGE              PIC 9(7)V99.
    74	           05  WS-STANDING           PIC 9(5)V99.
    75	           05  WS-DISCOUNT           PIC 9(6)V99.
    76	           05  WS-NET                PIC 9(7)V99.
    77	           05  WS-VAT                PIC 9(6)V99.
    78	           05  WS-CURRENT            PIC 9(7)V99.
    79	           05  WS-INTEREST           PIC 9(5)V99.
    80	           05  WS-BALANCE            PIC S9(7)V99.
    81	           05  WS-CARRY              PIC S9(7)V99.
    82	           05  WS-DUE                PIC 9(7)V99.
    83	           05  WS-NAME               PIC X(24).
    84	           05  WS-NAME-OUT           PIC X(24).
    85	           05  WS-REASON             PIC X(20).
    86	           05  WS-DATE-DMY           PIC 9(8).
    87	       01  WS-TOTALS.
    88	           05  WS-BILLED             PIC 9(3)    VALUE 0.
    89	           05  WS-REJECTED           PIC 9(3)    VALUE 0.
    90	           05  WS-CREDITS            PIC 9(3)    VALUE 0.
    91	           05  WS-TOT-UNITS          PIC 9(11)   VALUE 0.
    92	           05  WS-TOT-CURRENT        PIC 9(11)V99 VALUE 0.
    93	           05  WS-TOT-DUE            PIC 9(11)V99 VALUE 0.
    94	           05  WS-TOT-NET            PIC S9(11)V99 VALUE 0.
    95	           05  WS-AVERAGE            PIC 9(9)V99 VALUE 0.
    96	       01  L-HEAD.
    97	           05  FILLER                PIC X(15) VALUE "STATEMENTS FOR ".
    98	           05  LH-REGION             PIC X(20).
    99	           05  FILLER                PIC X(7)  VALUE " DATED ".
   100	           05  LH-DATE               PIC 99/99/9999.
   101	       01  L-ACCT.
   102	           05  FILLER                PIC X(8)  VALUE "ACCOUNT ".
   103	           05  LA-MASK               PIC X(4)  VALUE "****".
   104	           05  LA-TAIL               PIC X(4).
   105	           05  FILLER                PIC X(2)  VALUE SPACES.
   106	           05  LA-NAME               PIC X(24).
   107	           05  FILLER                PIC X(8)  VALUE " TARIFF ".
   108	           05  LA-TARIFF             PIC X.
   109	       01  L-READ.
   110	           05  FILLER                PIC X(9)  VALUE "READINGS ".
   111	           05  LR-PREV               PIC ZZZZZ9.
   112	           05  FILLER                PIC X(4)  VALUE " TO ".
   113	           05  LR-CURR               PIC ZZZZZ9.
   114	           05  FILLER                PIC X(8)  VALUE "  USAGE ".
   115	           05  LR-UNITS              PIC Z,ZZZ,ZZ9.
   116	           05  FILLER                PIC X(6)  VALUE " OVER ".
   117	           05  LR-DAYS               PIC ZZ9.
   118	           05  FILLER                PIC X(5)  VALUE " DAYS".
   119	       01  L-BANDS.
   120	           05  FILLER                PIC X(6)  VALUE "BANDS ".
   121	           05  LB-1                  PIC ZZ,ZZ9.9.
   122	           05  FILLER                PIC X     VALUE SPACE.
   123	           05  LB-2                  PIC ZZ,ZZ9.9.
   124	           05  FILLER                PIC X     VALUE SPACE.
   125	           05  LB-3                  PIC Z,ZZZ,ZZ9.9.
   126	       01  L-CHARGE.
   127	           05  FILLER                PIC X(13) VALUE "USAGE CHARGE ".
   128	           05  LC-USAGE              PIC $$,$$$,$$9.99.
   129	           05  FILLER                PIC X(10) VALUE "  STANDING".
   130	           05  LC-STANDING           PIC $$$,$$9.99.
   131	       01  L-DISC.
   132	           05  FILLER                PIC X(9)  VALUE "DISCOUNT ".
   133	           05  LD-DISCOUNT           PIC ZZ,ZZ9.99 BLANK WHEN ZERO.
   134	           05  FILLER                PIC X(5)  VALUE "  VAT".
   135	           05  LD-VAT                PIC ZZZ,ZZ9.99.
   136	           05  FILLER                PIC X(9)  VALUE "  CURRENT".
   137	           05  LD-CURRENT            PIC $$$,$$9.99.
   138	       01  L-ARR.
   139	           05  FILLER                PIC X(8)  VALUE "ARREARS ".
   140	           05  LX-ARREARS            PIC ++,+++,++9.99.
   141	           05  FILLER                PIC X(10) VALUE "  INTEREST".
   142	           05  LX-INTEREST           PIC ZZ,ZZ9.99 BLANK WHEN ZERO.
   143	           05  FILLER                PIC X(6)  VALUE "  PAID".
   144	           05  LX-PAID               PIC ZZ,ZZ9.99.
   145	       01  L-BAL.
   146	           05  FILLER                PIC X(8)  VALUE "BALANCE ".
   147	           05  LL-BALANCE            PIC Z,ZZZ,ZZ9.99CR.
   148	           05  FILLER                PIC X(12) VALUE "  AMOUNT DUE".
   149	           05  LL-DUE                PIC ***,**9.99.
   150	       01  L-CARRY.
   151	           05  FILLER                PIC X(11) VALUE "CREDIT C/F ".
   152	           05  LY-CARRY              PIC $$$,$$9.99-.
   153	       01  L-REJECT.
   154	           05  FILLER                PIC X(7)  VALUE "REJECT ".
   155	           05  LJ-ACCT               PIC X(8).
   156	           05  FILLER                PIC X     VALUE SPACE.
   157	           05  LJ-REASON             PIC X(20).
   158	       01  L-LEDGER.
   159	           05  FILLER                PIC X(24)
   160	                                     VALUE "PAYMENTS AND ADJUSTMENTS".
   161	       01  L-POST.
   162	           05  LP-KIND               PIC X(3).
   163	           05  FILLER                PIC X     VALUE SPACE.
   164	           05  LP-ACCT               PIC X(8).
   165	           05  FILLER                PIC X     VALUE SPACE.
   166	           05  LP-AMT                PIC ----,--9.99.
   167	           05  FILLER                PIC X(7)  VALUE " WHOLE ".
   168	           05  LP-WHOLE              PIC -----9.
   169	           05  FILLER                PIC X(5)  VALUE " BAL ".
   170	           05  LP-BAL                PIC Z,ZZZ,ZZ9.99CR.
   171	           05  FILLER                PIC X     VALUE SPACE.
   172	           05  LP-MEMO               PIC X(30).
   173	       01  L-SPLIT.
   174	           05  FILLER                PIC X(16) VALUE "    FEE SPLIT 3X".
   175	           05  LS-PART               PIC ---,--9.99.
   176	           05  FILLER                PIC X(11) VALUE " REMAINDER ".
   177	           05  LS-REM                PIC -9.99.
   178	       01  L-PAYREJ.
   179	           05  FILLER                PIC X(5)  VALUE "LINE ".
   180	           05  LQ-LINE               PIC ZZ9.
[?2004hroot@9188a06336c9:/app# echo '--- WBILL 181-360 ---'; nl -ba /app/legacy/WBILL.cbl | sed -n '181,360p'
[?2004l--- WBILL 181-360 ---
   181	           05  FILLER                PIC X(10) VALUE " REJECTED ".
   182	           05  LQ-REASON             PIC X(20).
   183	       01  L-PAYTOT.
   184	           05  FILLER                PIC X(8)  VALUE "POSTED  ".
   185	           05  LV-APPLIED            PIC ZZ9.
   186	           05  FILLER                PIC X(11) VALUE "  REJECTED ".
   187	           05  LV-REJECTED           PIC ZZ9.
   188	           05  FILLER                PIC X(8)  VALUE "  PAID  ".
   189	           05  LV-PAID               PIC $$,$$$,$$9.99-.
   190	           05  FILLER                PIC X(8)  VALUE "  OTHER ".
   191	           05  LV-OTHER              PIC $$,$$$,$$9.99-.
   192	       01  L-TOT1.
   193	           05  FILLER                PIC X(16) VALUE "ACCOUNTS BILLED ".
   194	           05  LT-BILLED             PIC ZZ9.
   195	           05  FILLER                PIC X(11) VALUE "  REJECTED ".
   196	           05  LT-REJECTED           PIC ZZ9.
   197	           05  FILLER                PIC X(10) VALUE "  CREDITS ".
   198	           05  LT-CREDITS            PIC ZZ9.
   199	       01  L-TOT2.
   200	           05  FILLER                PIC X(12) VALUE "TOTAL UNITS ".
   201	           05  LT-UNITS              PIC ZZZ,ZZZ,ZZ9.
   202	           05  FILLER                PIC X(16) VALUE "  TOTAL CURRENT ".
   203	           05  LT-CURRENT            PIC $$$,$$$,$$9.99.
   204	       01  L-TOT3.
   205	           05  FILLER                PIC X(10) VALUE "TOTAL DUE ".
   206	           05  LT-DUE                PIC $$$,$$$,$$9.99.
   207	           05  FILLER                PIC X(15) VALUE "  AVERAGE BILL ".
   208	           05  LT-AVERAGE            PIC $$,$$$,$$9.99.
   209	       01  L-TOT4.
   210	           05  FILLER                PIC X(13) VALUE "NET POSITION ".
   211	           05  LT-NET                PIC ---,---,--9.99.
   212	       PROCEDURE DIVISION.
   213	       MAIN-LINE.
   214	           OPEN INPUT CUST-IN
   215	                OUTPUT STMT-OUT
   216	           PERFORM READ-IN
   217	           IF NOT END-OF-INPUT AND IS-HEADER
   218	               PERFORM WRITE-HEADER
   219	               PERFORM READ-IN
   220	           END-IF
   221	           PERFORM UNTIL END-OF-INPUT
   222	               IF IS-CUSTOMER
   223	                   PERFORM ONE-ACCOUNT
   224	               END-IF
   225	               PERFORM READ-IN
   226	           END-PERFORM
   227	           PERFORM WRITE-TOTALS
   228	           PERFORM POST-PAYMENTS
   229	           CLOSE CUST-IN STMT-OUT
   230	           STOP RUN.
   231	
   232	       READ-IN.
   233	           READ CUST-IN INTO CUST-REC
   234	               AT END SET END-OF-INPUT TO TRUE
   235	           END-READ.
   236	
   237	       WRITE-HEADER.
   238	           MOVE HDR-REGION TO LH-REGION
   239	           MOVE STMT-DATE(7:2) TO WS-DATE-DMY(1:2)
   240	           MOVE STMT-DATE(5:2) TO WS-DATE-DMY(3:2)
   241	           MOVE STMT-DATE(1:4) TO WS-DATE-DMY(5:4)
   242	           MOVE WS-DATE-DMY TO LH-DATE
   243	           WRITE OUT-REC FROM L-HEAD
   244	           MOVE SPACES TO OUT-REC
   245	           WRITE OUT-REC.
   246	
   247	       ONE-ACCOUNT.
   248	           MOVE SPACES TO WS-REASON
   249	           SET TX TO 1
   250	           SEARCH TARIFF-ROW
   251	               AT END MOVE "UNKNOWN TARIFF" TO WS-REASON
   252	               WHEN TR-CODE(TX) = TARIFF
   253	                   CONTINUE
   254	           END-SEARCH
   255	           EVALUATE TRUE
   256	               WHEN WS-REASON NOT = SPACES
   257	                   CONTINUE
   258	               WHEN BILL-DAYS = 0
   259	                   MOVE "NO BILLING DAYS" TO WS-REASON
   260	               WHEN BILL-DAYS > 120
   261	                   MOVE "PERIOD TOO LONG" TO WS-REASON
   262	           END-EVALUATE
   263	           IF WS-REASON NOT = SPACES
   264	               ADD 1 TO WS-REJECTED
   265	               MOVE ACCT-NO TO LJ-ACCT
   266	               MOVE WS-REASON TO LJ-REASON
   267	               WRITE OUT-REC FROM L-REJECT
   268	               MOVE SPACES TO OUT-REC
   269	               WRITE OUT-REC
   270	           ELSE
   271	               PERFORM CALC-BILL
   272	               PERFORM PRINT-BILL
   273	           END-IF.
   274	
   275	       CALC-BILL.
   276	           IF CURR-READ >= PREV-READ
   277	               SUBTRACT PREV-READ FROM CURR-READ GIVING WS-UNITS
   278	           ELSE
   279	               COMPUTE WS-UNITS = CURR-READ + 1000000 - PREV-READ
   280	           END-IF
   281	           MULTIPLY TR-LIMIT1(TX) BY BILL-DAYS GIVING WS-TEMP
   282	           DIVIDE WS-TEMP BY 30 GIVING WS-LIM1 ROUNDED
   283	           MULTIPLY TR-LIMIT2(TX) BY BILL-DAYS GIVING WS-TEMP
   284	           DIVIDE WS-TEMP BY 30 GIVING WS-LIM2 ROUNDED
   285	           MOVE 0 TO WS-B1 WS-B2 WS-B3
   286	           IF WS-UNITS > WS-LIM1
   287	               MOVE WS-LIM1 TO WS-B1
   288	               IF WS-UNITS > WS-LIM2
   289	                   SUBTRACT WS-LIM1 FROM WS-LIM2 GIVING WS-B2
   290	                   SUBTRACT WS-LIM2 FROM WS-UNITS GIVING WS-B3
   291	               ELSE
   292	                   SUBTRACT WS-LIM1 FROM WS-UNITS GIVING WS-B2
   293	               END-IF
   294	           ELSE
   295	               MOVE WS-UNITS TO WS-B1
   296	           END-IF
   297	           MULTIPLY WS-B1 BY TR-RATE1(TX) GIVING WS-C1 ROUNDED
   298	           MULTIPLY WS-B2 BY TR-RATE2(TX) GIVING WS-C2 ROUNDED
   299	           MULTIPLY WS-B3 BY TR-RATE3(TX) GIVING WS-C3 ROUNDED
   300	           ADD WS-C1 WS-C2 WS-C3 GIVING WS-USAGE
   301	           MULTIPLY BILL-DAYS BY TR-STANDING(TX)
   302	               GIVING WS-STANDING ROUNDED
   303	           MOVE 0 TO WS-DISCOUNT
   304	           IF TARIFF-RELIEF
   305	               MULTIPLY WS-USAGE BY 0.15 GIVING WS-DISCOUNT
   306	               SUBTRACT WS-DISCOUNT FROM WS-USAGE
   307	           END-IF
   308	           ADD WS-USAGE WS-STANDING GIVING WS-NET
   309	           MULTIPLY WS-NET BY 0.05 GIVING WS-VAT ROUNDED
   310	           ADD WS-NET WS-VAT GIVING WS-CURRENT
   311	           MOVE 0 TO WS-INTEREST
   312	           IF ARREARS > 0
   313	               MULTIPLY ARREARS BY 0.015 GIVING WS-INTEREST ROUNDED
   314	           END-IF
   315	           COMPUTE WS-BALANCE = WS-CURRENT + ARREARS + WS-INTEREST
   316	                              - PAID
   317	           MOVE 0 TO WS-DUE WS-CARRY
   318	           IF WS-BALANCE > 0
   319	               MOVE WS-BALANCE TO WS-DUE
   320	           END-IF
   321	           IF WS-BALANCE < 0
   322	               MULTIPLY WS-BALANCE BY 0.975 GIVING WS-CARRY ROUNDED
   323	               ADD 1 TO WS-CREDITS
   324	           END-IF
   325	           ADD 1 TO WS-BILLED
   326	           ADD 1 TO AT-COUNT
   327	           MOVE ACCT-NO TO AT-ACCT(AT-COUNT)
   328	           MOVE WS-BALANCE TO AT-BAL(AT-COUNT)
   329	           ADD WS-UNITS TO WS-TOT-UNITS
   330	           ADD WS-CURRENT TO WS-TOT-CURRENT
   331	           ADD WS-DUE TO WS-TOT-DUE
   332	           ADD WS-BALANCE TO WS-TOT-NET.
   333	
   334	       PRINT-BILL.
   335	           MOVE CUST-NAME TO WS-NAME
   336	           INSPECT WS-NAME CONVERTING "abcdefghijklmnopqrstuvwxyz"
   337	                                   TO "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
   338	           MOVE SPACES TO WS-NAME-OUT
   339	           STRING WS-NAME DELIMITED BY "  " INTO WS-NAME-OUT
   340	           IF WS-NAME-OUT = SPACES
   341	               MOVE "(NO NAME ON FILE)" TO WS-NAME-OUT
   342	           END-IF
   343	           MOVE ACCT-NO(5:4) TO LA-TAIL
   344	           MOVE WS-NAME-OUT TO LA-NAME
   345	           MOVE TARIFF TO LA-TARIFF
   346	           WRITE OUT-REC FROM L-ACCT
   347	           MOVE PREV-READ TO LR-PREV
   348	           MOVE CURR-READ TO LR-CURR
   349	           MOVE WS-UNITS TO LR-UNITS
   350	           MOVE BILL-DAYS TO LR-DAYS
   351	           WRITE OUT-REC FROM L-READ
   352	           MOVE WS-B1 TO LB-1
   353	           MOVE WS-B2 TO LB-2
   354	           MOVE WS-B3 TO LB-3
   355	           WRITE OUT-REC FROM L-BANDS
   356	           MOVE WS-USAGE TO LC-USAGE
   357	           MOVE WS-STANDING TO LC-STANDING
   358	           WRITE OUT-REC FROM L-CHARGE
   359	           MOVE WS-DISCOUNT TO LD-DISCOUNT
   360	           MOVE WS-VAT TO LD-VAT
[?2004hroot@9188a06336c9:/app# echo '--- WBILL 361-560 ---'; nl -ba /app/legacy/WBILL.cbl | sed -n '361,560p'
[?2004l--- WBILL 361-560 ---
   361	           MOVE WS-CURRENT TO LD-CURRENT
   362	           WRITE OUT-REC FROM L-DISC
   363	           MOVE ARREARS TO LX-ARREARS
   364	           MOVE WS-INTEREST TO LX-INTEREST
   365	           MOVE PAID TO LX-PAID
   366	           WRITE OUT-REC FROM L-ARR
   367	           MOVE WS-BALANCE TO LL-BALANCE
   368	           MOVE WS-DUE TO LL-DUE
   369	           WRITE OUT-REC FROM L-BAL
   370	           IF WS-BALANCE < 0
   371	               MOVE WS-CARRY TO LY-CARRY
   372	               WRITE OUT-REC FROM L-CARRY
   373	           END-IF
   374	           MOVE SPACES TO OUT-REC
   375	           WRITE OUT-REC.
   376	
   377	       WRITE-TOTALS.
   378	           MOVE WS-BILLED TO LT-BILLED
   379	           MOVE WS-REJECTED TO LT-REJECTED
   380	           MOVE WS-CREDITS TO LT-CREDITS
   381	           WRITE OUT-REC FROM L-TOT1
   382	           MOVE WS-TOT-UNITS TO LT-UNITS
   383	           MOVE WS-TOT-CURRENT TO LT-CURRENT
   384	           WRITE OUT-REC FROM L-TOT2
   385	           IF WS-BILLED > 0
   386	               DIVIDE WS-TOT-CURRENT BY WS-BILLED
   387	                   GIVING WS-AVERAGE ROUNDED
   388	           END-IF
   389	           MOVE WS-TOT-DUE TO LT-DUE
   390	           MOVE WS-AVERAGE TO LT-AVERAGE
   391	           WRITE OUT-REC FROM L-TOT3
   392	           MOVE WS-TOT-NET TO LT-NET
   393	           WRITE OUT-REC FROM L-TOT4.
   394	
   395	       POST-PAYMENTS.
   396	           MOVE SPACES TO OUT-REC
   397	           WRITE OUT-REC
   398	           WRITE OUT-REC FROM L-LEDGER
   399	           OPEN INPUT PAY-IN
   400	           PERFORM READ-PAY
   401	           PERFORM UNTIL END-OF-PAY
   402	               ADD 1 TO WS-LINE-NO
   403	               PERFORM ONE-PAYMENT
   404	               PERFORM READ-PAY
   405	           END-PERFORM
   406	           CLOSE PAY-IN
   407	           MOVE WS-APPLIED TO LV-APPLIED
   408	           MOVE WS-PAY-REJECTED TO LV-REJECTED
   409	           MOVE WS-TOT-PAID TO LV-PAID
   410	           MOVE WS-TOT-OTHER TO LV-OTHER
   411	           WRITE OUT-REC FROM L-PAYTOT.
   412	
   413	       READ-PAY.
   414	           READ PAY-IN INTO PAY-LINE
   415	               AT END SET END-OF-PAY TO TRUE
   416	           END-READ.
   417	
   418	       ONE-PAYMENT.
   419	           MOVE 0 TO PL-FIELDS PL-ACCT-LEN
   420	           UNSTRING PAY-LINE DELIMITED BY ";"
   421	               INTO PL-ACCT COUNT IN PL-ACCT-LEN
   422	                    PL-KIND
   423	                    PL-AMT-TXT
   424	                    PL-MEMO
   425	               TALLYING IN PL-FIELDS
   426	           END-UNSTRING
   427	           MOVE SPACES TO WS-REASON
   428	           EVALUATE TRUE
   429	               WHEN PL-FIELDS < 3
   430	                   MOVE "TOO FEW FIELDS" TO WS-REASON
   431	               WHEN PL-ACCT-LEN NOT = 8
   432	                   MOVE "BAD ACCOUNT" TO WS-REASON
   433	               WHEN FUNCTION TEST-NUMVAL(PL-AMT-TXT) NOT = 0
   434	                   MOVE "BAD AMOUNT" TO WS-REASON
   435	               WHEN NOT (KIND-PAY OR KIND-ADJ OR KIND-FEE OR KIND-REF)
   436	                   MOVE "BAD KIND" TO WS-REASON
   437	           END-EVALUATE
   438	           IF WS-REASON = SPACES
   439	               SET AX TO 1
   440	               SEARCH AT-ENTRY
   441	                   AT END MOVE "NO SUCH ACCOUNT" TO WS-REASON
   442	                   WHEN AT-ACCT(AX) = PL-ACCT
   443	                       CONTINUE
   444	               END-SEARCH
   445	           END-IF
   446	           IF WS-REASON NOT = SPACES
   447	               ADD 1 TO WS-PAY-REJECTED
   448	               MOVE WS-LINE-NO TO LQ-LINE
   449	               MOVE WS-REASON TO LQ-REASON
   450	               WRITE OUT-REC FROM L-PAYREJ
   451	           ELSE
   452	               PERFORM APPLY-PAYMENT
   453	           END-IF.
   454	
   455	       APPLY-PAYMENT.
   456	           EVALUATE TRUE
   457	               WHEN KIND-PAY
   458	                   COMPUTE WS-AMT ROUNDED MODE NEAREST-EVEN
   459	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   460	                   SUBTRACT WS-AMT FROM AT-BAL(AX)
   461	                   ADD WS-AMT TO WS-TOT-PAID
   462	               WHEN KIND-ADJ
   463	                   COMPUTE WS-AMT ROUNDED
   464	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   465	                   ADD WS-AMT TO AT-BAL(AX)
   466	                   ADD WS-AMT TO WS-TOT-OTHER
   467	               WHEN KIND-FEE
   468	                   COMPUTE WS-AMT = FUNCTION NUMVAL(PL-AMT-TXT)
   469	                   ADD WS-AMT TO AT-BAL(AX)
   470	                   ADD WS-AMT TO WS-TOT-OTHER
   471	                   DIVIDE WS-AMT BY 3 GIVING WS-PART ROUNDED
   472	                       REMAINDER WS-REM
   473	               WHEN KIND-REF
   474	                   COMPUTE WS-AMT ROUNDED MODE TOWARD-LESSER
   475	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   476	                   ADD WS-AMT TO AT-BAL(AX)
   477	                   ADD WS-AMT TO WS-TOT-OTHER
   478	           END-EVALUATE
   479	           COMPUTE WS-WHOLE = FUNCTION INTEGER(WS-AMT)
   480	           INSPECT PL-MEMO CONVERTING "0123456789" TO "XXXXXXXXXX"
   481	               AFTER INITIAL "#"
   482	           ADD 1 TO WS-APPLIED
   483	           MOVE PL-KIND TO LP-KIND
   484	           MOVE PL-ACCT TO LP-ACCT
   485	           MOVE WS-AMT TO LP-AMT
   486	           MOVE WS-WHOLE TO LP-WHOLE
   487	           MOVE AT-BAL(AX) TO LP-BAL
   488	           MOVE PL-MEMO TO LP-MEMO
   489	           WRITE OUT-REC FROM L-POST
   490	           IF KIND-FEE
   491	               MOVE WS-PART TO LS-PART
   492	               MOVE WS-REM TO LS-REM
   493	               WRITE OUT-REC FROM L-SPLIT
   494	           END-IF.
