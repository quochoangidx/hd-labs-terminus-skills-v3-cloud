   408	           MOVE WS-PAY-REJECTED TO LV-REJECTED
   409	           MOVE WS-TOT-PAID TO LV-PAID
   410	           MOVE WS-TOT-OTHER TO LV-OTHER
   411	           WRITE OUT-REC FROM L-PAYTOT.
   412	
   413	       READ-PAY.
   414	           READ PAY-IN INTO PAY-LINE
   415	               AT END SET END-OF-PAY TO TRUE
[?2004hroot@9188a06336c9:/app# nl -ba /app/legacy/WBILL.cbl | sed -n '416,520p'
[?2004l   416	           END-READ.
   417	
   418	       ONE-PAYMENT.
   419	           MOVE 0 TO PL-FIELDS PL-ACCT-LEN
   420	           UNSTRING PAY-LINE DELIMITED BY ";"
   421	               INTO PL-ACCT COUNT IN PL-ACCT-LEN
   422	                    PL-KIND
   423	                    PL-AMT-TXT
   424	                    PL-MEMO
   425	               TALLYING IN PL-FIELDS
   426	           END-UNSTRING
   427	           MOVE SPACES TO WS-REASON
   428	           EVALUATE TRUE
   429	               WHEN PL-FIELDS < 3
   430	                   MOVE "TOO FEW FIELDS" TO WS-REASON
   431	               WHEN PL-ACCT-LEN NOT = 8
   432	                   MOVE "BAD ACCOUNT" TO WS-REASON
   433	               WHEN FUNCTION TEST-NUMVAL(PL-AMT-TXT) NOT = 0
   434	                   MOVE "BAD AMOUNT" TO WS-REASON
   435	               WHEN NOT (KIND-PAY OR KIND-ADJ OR KIND-FEE OR KIND-REF)
   436	                   MOVE "BAD KIND" TO WS-REASON
   437	           END-EVALUATE
   438	           IF WS-REASON = SPACES
   439	               SET AX TO 1
   440	               SEARCH AT-ENTRY
   441	                   AT END MOVE "NO SUCH ACCOUNT" TO WS-REASON
   442	                   WHEN AT-ACCT(AX) = PL-ACCT
   443	                       CONTINUE
   444	               END-SEARCH
   445	           END-IF
   446	           IF WS-REASON NOT = SPACES
   447	               ADD 1 TO WS-PAY-REJECTED
   448	               MOVE WS-LINE-NO TO LQ-LINE
   449	               MOVE WS-REASON TO LQ-REASON
   450	               WRITE OUT-REC FROM L-PAYREJ
   451	           ELSE
   452	               PERFORM APPLY-PAYMENT
   453	           END-IF.
   454	
   455	       APPLY-PAYMENT.
   456	           EVALUATE TRUE
   457	               WHEN KIND-PAY
   458	                   COMPUTE WS-AMT ROUNDED MODE NEAREST-EVEN
   459	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   460	                   SUBTRACT WS-AMT FROM AT-BAL(AX)
   461	                   ADD WS-AMT TO WS-TOT-PAID
   462	               WHEN KIND-ADJ
   463	                   COMPUTE WS-AMT ROUNDED
   464	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   465	                   ADD WS-AMT TO AT-BAL(AX)
   466	                   ADD WS-AMT TO WS-TOT-OTHER
   467	               WHEN KIND-FEE
   468	                   COMPUTE WS-AMT = FUNCTION NUMVAL(PL-AMT-TXT)
   469	                   ADD WS-AMT TO AT-BAL(AX)
   470	                   ADD WS-AMT TO WS-TOT-OTHER
   471	                   DIVIDE WS-AMT BY 3 GIVING WS-PART ROUNDED
   472	                       REMAINDER WS-REM
   473	               WHEN KIND-REF
   474	                   COMPUTE WS-AMT ROUNDED MODE TOWARD-LESSER
   475	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   476	                   ADD WS-AMT TO AT-BAL(AX)
   477	                   ADD WS-AMT TO WS-TOT-OTHER
   478	           END-EVALUATE
   479	           COMPUTE WS-WHOLE = FUNCTION INTEGER(WS-AMT)
   480	           INSPECT PL-MEMO CONVERTING "0123456789" TO "XXXXXXXXXX"
   481	               AFTER INITIAL "#"
   482	           ADD 1 TO WS-APPLIED
   483	           MOVE PL-KIND TO LP-KIND
   484	           MOVE PL-ACCT TO LP-ACCT
   485	           MOVE WS-AMT TO LP-AMT
   486	           MOVE WS-WHOLE TO LP-WHOLE
   487	           MOVE AT-BAL(AX) TO LP-BAL
   488	           MOVE PL-MEMO TO LP-MEMO
   489	           WRITE OUT-REC FROM L-POST
   490	           IF KIND-FEE
   491	               MOVE WS-PART TO LS-PART
   492	               MOVE WS-REM TO LS-REM
   493	               WRITE OUT-REC FROM L-SPLIT
   494	           END-IF.
