[130.386093, "i", "python3 - <<'PY'\np='/app/port/wbill.py'\ns=open(p).read()\ns=s.replace(\"nfmt(b3,1,True).rjust(12)\", \"nfmt(b3,1,True).rjust(11)\")\ns=s.replace(\"signed_lead(arrears,12)\", \"signed_lead(arrears,13)\")\ns=s.replace(\"minus_lead(amt,10)+' WHOLE\", \"minus_lead(amt,11)+' WHOLE\")\ns=s.replace(\"'    FEE SPLIT 3X'+minus_lead(part,9)\", \"'    FEE SPLIT 3X'+minus_lead(part,10)\")\nopen(p,'w').write(s)\nPY\npython3 /app/port/wbill.py /app/legacy/samples/2025q1-north.dat /app/legacy/samples/2025q1-north.pay /tmp/wbill.stmt\npython3 - <<'PY'\na=open('/app/legacy/samples/2025q1-north.stmt','rb').read().splitlines()\nb=open('/tmp/wbill.stmt','rb').read().splitlines()\nprint('bytes/lines expected',sum(map(len,a))+len(a),len(a),'actual',sum(map(len,b))+len(b),len(b))\nn=0\nfor i in range(max(len(a),len(b))):\n    x=a[i] if i<len(a) else b'<missing>'; y=b[i] if i<len(b) else b'<missing>'\n    if x!=y:\n        n+=1\n        print(i+1, 'E',repr(x), '\\n   A',repr(y))\n        if n>=30: break\nprint('shown mismatches',n)\nPY\ncmp -s /tmp/wbill.stmt /app/legac"]
