[25.676153, "o", "   326\t           ADD 1 TO AT-COUNT\r\n   327\t           MOVE ACCT-NO TO AT-ACCT(AT-COUNT)\r\n   328\t           MOVE WS-BALANCE TO AT-BAL(AT-COUNT)\r\n   329\t           ADD WS-UNITS TO WS-TOT-UNITS\r\n   330\t           ADD WS-CURRENT TO WS-TOT-CURRENT\r\n   331\t           ADD WS-DUE TO WS-TOT-DUE\r\n   332\t           ADD WS-BALANCE TO WS-TOT-NET.\r\n   333\t\r\n   334\t       PRINT-BILL.\r\n   335\t           MOVE CUST-NAME TO WS-NAME\r\n   336\t           INSPECT WS-NAME CONVERTING \"abcdefghijklmnopqrstuvwxyz\"\r\n   337\t                                   TO \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\r\n   338\t           MOVE SPACES TO WS-NAME-OUT\r\n   339\t           STRING WS-NAME DELIMITED BY \"  \" INTO WS-NAME-OUT\r\n   340\t           IF WS-NAME-OUT = SPACES\r\n   341\t               MOVE \"(NO NAME ON FILE)\" TO WS-NAME-OUT\r\n   342\t           END-IF\r\n   343\t           MOVE ACCT-NO(5:4) TO LA-TAIL\r\n"]
[25.676198, "o", "   344\t           MOVE WS-NAME-OUT TO LA-NAME\r\n   345\t           MOVE TARIFF TO LA-TARIFF\r\n   346\t           WRITE OUT-REC FROM L-ACCT\r\n   347\t           MOVE PREV-READ TO LR-PREV\r\n   348\t           MOVE CURR-READ TO LR-CURR\r\n   349\t           MOVE WS-UNITS TO LR-UNITS\r\n   350\t           MOVE BILL-DAYS TO LR-DAYS\r\n   351\t           WRITE OUT-REC FROM L-READ\r\n   352\t           MOVE WS-B1 TO LB-1\r\n   353\t           MOVE WS-B2 TO LB-2\r\n   354\t           MOVE WS-B3 TO LB-3\r\n   355\t           WRITE OUT-REC FROM L-BANDS\r\n   356\t           MOVE WS-USAGE TO LC-USAGE\r\n   357\t           MOVE WS-STANDING TO LC-STANDING\r\n   358\t           WRITE OUT-REC FROM L-CHARGE\r\n   359\t           MOVE WS-DISCOUNT TO LD-DISCOUNT\r\n   360\t           MOVE WS-VAT TO LD-VAT\r\n   361\t           MOVE WS-CURRENT TO LD-CURRENT\r\n   362\t           WRITE OUT-REC FROM L-DISC\r\n   363\t           MOVE ARREARS TO LX-ARREARS\r\n   364\t           MOVE WS-INTEREST TO LX-INTEREST\r\n   365\t           MOVE PAID TO LX-PAID\r\n   366\t           WRITE OUT-REC FROM "]
[25.676209, "o", "L-ARR\r\n   367\t           MOVE WS-BALANCE TO LL-BALANCE\r\n   368\t           MOVE WS-DUE TO LL-DUE\r\n   369\t           WRITE OUT-REC FROM L-BAL\r\n   370\t           IF WS-BALANCE < 0\r\n   371\t               MOVE WS-CARRY TO LY-CARRY\r\n   372\t               WRITE OUT-REC FROM L-CARRY\r\n   373\t           END-IF\r\n   374\t           MOVE SPACES TO OUT-REC\r\n   375\t           WRITE OUT-REC.\r\n   376\t\r\n"]
[25.676226, "o", "   377\t       WRITE-TOTALS.\r\n   378\t           MOVE WS-BILLED TO LT-BILLED\r\n   379\t           MOVE WS-REJECTED TO LT-REJECTED\r\n   380\t           MOVE WS-CREDITS TO LT-CREDITS"]
[25.676241, "o", "\r\n   381\t           WRITE OUT-REC FROM L-TOT1\r\n   382\t           MOVE WS-TOT-UNITS TO LT-UNITS\r\n   383\t           MOVE WS-TOT-CURRENT TO LT-CURRENT\r\n   384\t           WRITE OUT-REC FROM L-TOT2\r\n   385\t           IF WS-BILLED > 0\r\n   386\t               DIVIDE WS-TOT-CURRENT BY WS-BILLED\r\n   387\t                   GIVING WS-AVERAGE ROUNDED\r\n"]
[25.676256, "o", "   388\t           END-IF\r\n   389\t           MOVE WS-TOT-DUE TO LT-DUE\r\n   390\t           MOVE WS-AVERAGE TO LT-AVERAGE\r\n   391\t           WRITE OUT-REC FROM L-TOT3\r\n   392"]
[25.676272, "o", "\t           MOVE WS-TOT-NET TO LT-NET\r\n   393\t           WRITE OUT-REC FROM L-TOT4.\r\n   394\t\r\n   395\t       POST-PAYMENTS.\r\n   396\t           MOVE SPACES TO OUT-REC\r\n   397\t           WRITE OUT-REC\r\n"]
[25.676291, "o", "   398\t           WRITE OUT-REC FROM L-LEDGER\r\n   399\t           OPEN INPUT PAY-IN\r\n   400\t           PERFORM READ-PAY\r\n   401\t           PERFORM UNTIL END-OF-PAY\r\n   402\t"]
[25.676301, "o", "               ADD 1 TO WS-LINE-NO\r\n   403\t               PERFORM ONE-PAYMENT\r\n   404\t               PERFORM READ-PAY\r\n   405\t           END-PERFORM\r\n   406\t           CLOSE PAY-IN\r\n   407\t           MOVE WS-APPLIED TO LV-APPLIED\r\n   408\t           MOVE WS-PAY-REJECTED TO LV-REJECTED\r\n   409\t           MOVE WS-TOT-PAID TO LV-PAID\r\n   410\t           MOVE WS-TOT-OTHER TO LV-OTHER\r\n   411\t           WRITE OUT-REC FROM L-PAYTOT.\r\n   412\t\r\n   413\t       READ-PAY.\r\n   414\t           READ PAY-IN INTO PAY-LINE\r\n"]
[25.676314, "o", "   415\t               AT END SET END-OF-PAY TO TRUE\r\n"]
