[33.28456, "o", "                SUBTRACT WS-LIM1 FROM WS-UNITS GIVING WS-B2\r\n   293\t               END-IF\r\n   294\t           ELSE\r\n   295\t               MOVE WS-UNITS TO WS-B1\r\n   296\t           END-IF\r\n   297\t           MULTIPLY WS-B1 BY TR-RATE1(TX) GIVING WS-C1 ROUNDED\r\n   298\t           MULTIPLY WS-B2 BY TR-RATE2(TX) GIVING WS-C2 ROUNDED\r\n   299\t           MULTIPLY WS-B3 BY TR-RATE3(TX) GIVING WS-C3 ROUNDED\r\n   300\t           ADD WS-C1 WS-C2 WS-C3 GIVING WS-USAGE\r\n   301\t           MULTIPLY BILL-DAYS BY TR-STANDING(TX)\r\n   302\t               GIVING WS-STANDING ROUNDED\r\n   303\t           MOVE 0 TO WS-DISCOUNT\r\n   304\t           IF TARIFF-RELIEF\r\n   305\t               MULTIPLY WS-USAGE BY 0.15 GIVING WS-DISCOUNT\r\n   306\t               SUBTRACT WS-DISCOUNT FROM WS-USAGE\r\n   307\t           END-IF\r\n   308\t           ADD WS-USAGE WS-STANDING GIVING WS-NET\r\n   309\t           MULTIPLY WS-NET BY 0.05 GIVING WS-VAT ROUNDED\r\n   310\t           ADD WS-NET WS-VAT GIVING WS-CURRENT\r\n   311\t           MOVE 0 TO WS-INTEREST\r\n   312\t     "]
[33.284572, "o", "      IF ARREARS > 0\r\n   313\t               MULTIPLY ARREARS BY 0.015 GIVING WS-INTEREST ROUNDED\r\n   314\t           END-IF\r\n   315\t           COMPUTE WS-BALANCE = WS-CURRENT + ARREARS + WS-INTEREST\r\n   316\t                              - PAID\r\n   317\t           MOVE 0 TO WS-DUE WS-CARRY\r\n   318\t           IF WS-BALANCE > 0\r\n   319\t               MOVE WS-BALANCE TO WS-DUE\r\n   320\t           END-IF\r\n   321\t           IF WS-BALANCE < 0\r\n   322\t               MULTIPLY WS-BALANCE BY 0.975 GIVING WS-CARRY ROUNDED\r\n   323\t               ADD 1 TO WS-CREDITS\r\n   324\t           END-IF\r\n   325\t           ADD 1 TO WS-BILLED\r\n   326\t           ADD 1 TO AT-COUNT\r\n   327\t           MOVE ACCT-NO TO AT-ACCT(AT-COUNT)\r\n   328\t           MOVE WS-BALANCE TO AT-BAL(AT-COUNT)\r\n   329\t           ADD WS-UNITS TO WS-TOT-UNITS\r\n   330\t           ADD WS-CURRENT TO WS-TOT-CURRENT\r\n   331\t           ADD WS-DUE TO WS-TOT-DUE\r\n   332\t           ADD WS-BALANCE TO WS-TOT-NET.\r\n   333\t\r\n   334\t       PRINT-BILL.\r\n   335\t           MOVE CUST-N"]
