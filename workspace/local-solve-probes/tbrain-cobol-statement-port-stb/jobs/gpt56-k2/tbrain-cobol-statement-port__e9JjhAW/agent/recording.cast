[17.638599, "o", "   361\t           MOVE WS-CURRENT TO LD-CURRENT\r\n   362\t           WRITE OUT-REC FROM L-DISC\r\n   363\t           MOVE ARREARS TO LX-ARREARS\r\n   364\t           MOVE WS-INTEREST TO LX-INTEREST\r\n   365\t           MOVE PAID TO LX-PAID\r\n   366\t           WRITE OUT-REC FROM L-ARR\r\n   367\t           MOVE WS-BALANCE TO LL-BALANCE\r\n   368\t           MOVE WS-DUE TO LL-DUE\r\n   369\t           WRITE OUT-REC FROM L-BAL\r\n   370\t           IF WS-BALANCE < 0\r\n   371\t               MOVE WS-CARRY TO LY-CARRY\r\n   372\t               WRITE OUT-REC FROM L-CARRY\r\n   373\t           END-IF\r\n   374\t           MOVE SPACES TO OUT-REC\r\n   375\t           WRITE OUT-REC.\r\n   376\t\r\n   377\t       WRITE-TOTALS.\r\n   378\t           MOVE WS-BILLED TO LT-BILLED\r\n"]
[17.638684, "o", "   379\t           MOVE WS-REJECTED TO LT-REJECTED\r\n   380\t           MOVE WS-CREDITS TO LT-CREDITS\r\n   381\t           WRITE OUT-REC FROM L-TOT1\r\n   382\t           MOVE WS-TOT-UNITS TO LT-UNITS\r\n   383\t           MOVE WS-TOT-CURRENT TO LT-CURRENT\r\n   384\t           WRITE OUT-REC FROM L-TOT2\r\n   385\t           IF WS-BILLED > 0\r\n   386\t               DIVIDE WS-TOT-CURRENT BY WS-BILLED\r\n   387\t                   GIVING WS-AVERAGE ROUNDED\r\n   388\t           END-IF\r\n"]
[17.638713, "o", "   389\t           MOVE WS-TOT-DUE TO LT-DUE\r\n   390\t           MOVE WS-AVERAGE TO LT-AVERAGE\r\n   391\t           WRITE OUT-REC FROM L-TOT3\r\n   392\t           MOVE WS-TOT-NET TO LT-NET\r\n   393\t           WRITE OUT-REC FROM L-TOT4.\r\n   394\t\r\n   395\t       POST-PAYMENTS.\r\n   396\t           MOVE SPACES TO OUT-REC\r\n   397\t           WRITE OUT-REC\r\n   398\t           WRITE OUT-REC FROM L-LEDGER\r\n   399\t           OPEN INPUT PAY-IN\r\n   400\t           PERFORM READ-PAY\r\n   401\t           PERFORM UNTIL END-OF-PAY\r\n   402\t               ADD 1 TO WS-LINE-NO\r\n   403\t               PERFORM ONE-PAYMENT\r\n   404\t               PERFORM READ-PAY\r\n   405\t           END-PERFORM\r\n   406\t           CLOSE PAY-IN\r\n   407\t           MOVE WS-APPLIED TO LV-APPLIED\r\n   408\t           MOVE WS-PAY-REJECTED TO LV-REJECTED\r\n   409\t           MOVE WS-TOT-PAID TO LV-PAID\r\n"]
[17.638731, "o", "   410\t           MOVE WS-TOT-OTHER TO LV-OTHER\r\n   411\t           WRITE OUT-REC FROM L-PAYTOT.\r\n   412\t\r\n   413\t       READ-PAY.\r\n   414\t           READ PAY-IN INTO PAY-LINE\r\n   415\t               AT END SET END-OF-PAY TO TRUE\r\n   416\t           END-READ.\r\n"]
[17.638781, "o", "   417\t\r\n   418\t       ONE-PAYMENT.\r\n   419\t           MOVE 0 TO PL-FIELDS PL-ACCT-LEN\r\n   420\t           UNSTRING PAY-LINE DELIMITED BY \";\"\r\n   421\t               INTO PL-ACCT COUNT IN PL-ACCT-LEN\r\n"]
[17.638809, "o", "   422\t                    PL-KIND\r\n   423\t                    PL-AMT-TXT\r\n   424\t                    PL-MEMO\r\n"]
[17.638818, "o", "   425\t               TALLYING IN PL-FIELDS\r\n   426\t           END-UNSTRING\r\n   427\t           MOVE SPACES TO WS-REASON\r\n   428\t           EVALUATE TRUE\r\n   429\t               WHEN PL-FIELDS < 3\r\n   430\t                   MOVE \"TOO FEW FIELDS\" TO WS-REASON\r\n   431\t               WHEN PL-ACCT-LEN NOT = 8\r\n   432\t                   MOVE \"BAD ACCOUNT\" TO WS-REASON\r\n   433\t               WHEN FUNCTION TEST-NUMVAL(PL-AMT-TXT) NOT = 0\r\n   434\t                   MOVE \"BAD AMOUNT\" TO WS-REASON\r\n   435\t               WHEN NOT (KIND-PAY OR KIND-ADJ OR KIND-FEE OR KIND-REF)\r\n   436\t                   MOVE \"BAD KIND\" TO WS-REASON\r\n"]
[17.638827, "o", "   437\t           END-EVALUATE\r\n   438\t           IF WS-REASON = SPACES\r\n"]
[17.638835, "o", "   439\t               SET AX TO 1\r\n   440\t               SEARCH AT-ENTRY\r\n"]
[17.638871, "o", "   441\t                   AT END MOVE \"NO SUCH ACCOUNT\" TO WS-REASON\r\n   442\t                   WHEN AT-ACCT(AX) = PL-ACCT\r\n"]
[17.638904, "o", "   443\t                       CONTINUE\r\n   444\t               END-SEARCH\r\n   445\t           END-IF\r\n"]
[17.638913, "o", "   446\t           IF WS-REASON NOT = SPACES\r\n   447\t               ADD 1 TO WS-PAY-REJECTED\r\n   448\t               MOVE WS-LINE-NO TO LQ-LINE\r\n   449\t               MOVE WS-REASON TO LQ-REASON\r\n   450\t               WRITE OUT-REC FROM L-PAYREJ\r\n   451\t           ELSE\r\n   452\t               PERFORM APPLY-PAYMENT\r\n   453\t           END-IF.\r\n   454\t\r\n   455\t       APPLY-PAYMENT.\r\n   456\t           EVALUATE TRUE\r\n   457\t               WHEN KIND-PAY\r\n   458\t                   COMPUTE WS-AMT ROUNDED MODE NEAREST-EVEN\r\n   459\t                       = FUNCTION NUMVAL(PL-AMT-TXT)\r\n"]
[17.638924, "o", "   460\t                   SUBTRACT WS-AMT FROM AT-BAL(AX)\r\n   461\t                   ADD WS-AMT TO WS-TOT-PAID\r\n"]
[17.638953, "o", "   462\t               WHEN KIND-ADJ\r\n   463\t                   COMPUTE WS-AMT ROUNDED\r\n   464\t                       = FUNCTION NUMVAL(PL-AMT-TXT)\r\n"]
[17.638996, "o", "   465\t                   ADD WS-AMT TO AT-BAL(AX)\r\n   466\t                   ADD WS-AMT TO WS-TOT-OTHER\r\n"]
[17.639005, "o", "   467\t               WHEN KIND-FEE\r\n   468\t                   COMPUTE WS-AMT = FUNCTION NUMVAL(PL-AMT-TXT)\r\n   469\t                   ADD WS-AMT TO AT-BAL(AX)\r\n   470\t                   ADD WS-AMT TO WS-TOT-OTHER\r\n   471\t                   DIVIDE WS-AMT BY 3 GIVING WS-PART ROUNDED\r\n   472\t                       REMAINDER WS-REM\r\n   473\t               WHEN KIND-REF\r\n   474\t                   COMPUTE WS-AMT ROUNDED MODE TOWARD-LESSER\r\n   475\t                       = FUNCTION NUMVAL(PL-AMT-TXT)\r\n   476\t                   ADD WS-AMT TO AT-BAL(AX)\r\n   477\t                   ADD WS-AMT TO WS-TOT-OTHER\r\n   478\t           END-EVALUATE\r\n   479\t           COMPUTE WS-WHOLE = FUNCTION INTEGER(WS-AMT)\r\n   480\t           INSPECT PL-MEMO CONVERTING \"0123456789\" TO \"XXXXXXXXXX\"\r\n   481\t               AFTER INITIAL \"#\"\r\n   482\t           ADD 1 TO WS-APPLIED\r\n   483\t           MOVE PL-KIND TO LP-KIND\r\n"]
[17.639038, "o", "   484\t           MOVE PL-ACCT TO LP-ACCT\r\n   485\t           MOVE WS-AMT TO LP-AMT\r\n"]
[17.639116, "o", "   486\t           MOVE WS-WHOLE TO LP-WHOLE\r\n   487\t           MOVE AT-BAL(AX) TO LP-BAL\r\n   488\t           MOVE PL-MEMO TO LP-MEMO\r\n   489\t           WRITE OUT-REC FROM L-POST\r\n"]
[17.639138, "o", "   490\t           IF KIND-FEE\r\n   491\t               MOVE WS-PART TO LS-PART\r\n   492\t               MOVE WS-REM TO LS-REM\r\n   493\t               WRITE OUT-REC FROM L-SPLIT\r\n   494\t           END-IF.\r\n"]
