[33.09703, "o", "   130\t           05  LC-STANDING           PIC $$$,$$9.99.\r\n   131\t       01  L-DISC.\r\n   132\t           05  FILLER                PIC X(9)  VALUE \"DISCOUNT \".\r\n   133\t           05  LD-DISCOUNT           PIC ZZ,ZZ9.99 BLANK WHEN ZERO.\r\n   134\t           05  FILLER                PIC X(5)  VALUE \"  VAT\".\r\n   135\t           05  LD-VAT                PIC ZZZ,ZZ9.99.\r\n   136\t           05  FILLER                PIC X(9)  VALUE \"  CURRENT\".\r\n   137\t           05  LD-CURRENT            PIC $$$,$$9.99.\r\n   138\t       01  L-ARR.\r\n   139\t           05  FILLER                PIC X(8)  VALUE \"ARREARS \".\r\n   140\t           05  LX-ARREARS            PIC ++,+++,++9.99.\r\n   141\t           05  FILLER                PIC X(10) VALUE \"  INTEREST\".\r\n   142\t           05  LX-INTEREST           PIC ZZ,ZZ9.99 BLANK WHEN ZERO.\r\n   143\t           05  FILLER                PIC X(6)  VALUE \"  PAID\".\r\n   144\t           05  LX-PAID               PIC ZZ,ZZ9.99.\r\n   145\t       01  L-BAL.\r\n   146\t           05  FILLER                PIC X"]
[33.097071, "o", "(8)  VALUE \"BALANCE \".\r\n   147\t           05  LL-BALANCE            PIC Z,ZZZ,ZZ9.99CR.\r\n   148\t           05  FILLER                PIC X(12) VALUE \"  AMOUNT DUE\".\r\n   149\t           05  LL-DUE                PIC ***,**9.99.\r\n   150\t       01  L-CARRY.\r\n   151\t           05  FILLER                PIC X(11) VALUE \"CREDIT C/F \".\r\n   152\t           05  LY-CARRY              PIC $$$,$$9.99-.\r\n   153\t       01  L-REJECT.\r\n   154\t           05  FILLER                PIC X(7)  VALUE \"REJECT \".\r\n   155\t           05  LJ-ACCT               PIC X(8).\r\n   156\t           05  FILLER                PIC X     VALUE SPACE.\r\n   157\t           05  LJ-REASON             PIC X(20).\r\n   158\t       01  L-LEDGER.\r\n   159\t           05  FILLER                PIC X(24)\r\n   160\t                                     VALUE \"PAYMENTS AND ADJUSTMENTS\".\r\n   161\t       01  L-POST.\r\n   162\t           05  LP-KIND               PIC X(3).\r\n   163\t           05  FILLER                PIC X     VALUE SPACE.\r\n   164\t           05  LP-ACCT         "]
[33.097911, "o", "      PIC X(8).\r\n   165\t           05  FILLER                PIC X     VALUE SPACE.\r\n   166\t           05  LP-AMT                PIC ----,--9.99.\r\n   167\t           05  FILLER                PIC X(7)  VALUE \" WHOLE \".\r\n   168\t           05  LP-WHOLE              PIC -----9.\r\n   169\t           05  FILLER                PIC X(5)  VALUE \" BAL \".\r\n   170\t           05  LP-BAL                PIC Z,ZZZ,ZZ9.99CR.\r\n   171\t           05  FILLER                PIC X     VALUE SPACE.\r\n   172\t           05  LP-MEMO               PIC X(30).\r\n   173\t       01  L-SPLIT.\r\n   174\t           05  FILLER                PIC X(16) VALUE \"    FEE SPLIT 3X\".\r\n   175\t           05  LS-PART               PIC ---,--9.99.\r\n   176\t           05  FILLER                PIC X(11) VALUE \" REMAINDER \".\r\n   177\t           05  LS-REM                PIC -9.99.\r\n   178\t       01  L-PAYREJ.\r\n   179\t           05  FILLER                PIC X(5)  VALUE \"LINE \".\r\n   180\t           05  LQ-LINE               PIC ZZ9.\r\n   181\t           05  FILLER      "]
