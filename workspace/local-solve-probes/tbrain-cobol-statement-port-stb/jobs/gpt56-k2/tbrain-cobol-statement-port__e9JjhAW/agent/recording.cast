[17.130432, "o", "--- WBILL 1-180 ---\r\n"]
[17.136308, "o", "     1\t       IDENTIFICATION DIVISION.\r\n     2\t       PROGRAM-ID. WBILL.\r\n     3\t      *----------------------------------------------------------------\r\n     4\t      * WBILL - QUARTERLY WATER STATEMENT RUN.\r\n     5\t      * READS THE METER-READING FILE (CUSTIN) AND WRITES THE PRINTED\r\n     6\t      * STATEMENT FILE (STMTOUT).  ONE HEADER RECORD, THEN ONE RECORD\r\n     7\t      * PER ACCOUNT.  THEN POSTS THE PAYMENTS AND ADJUSTMENTS FILE\r\n     8\t      * (PAYIN) AGAINST THE NEW BALANCES AND PRINTS THE LEDGER.\r\n     9\t      *----------------------------------------------------------------\r\n    10\t       ENVIRONMENT DIVISION.\r\n    11\t       INPUT-OUTPUT SECTION.\r\n    12\t       FILE-CONTROL.\r\n    13\t           SELECT CUST-IN  ASSIGN TO CUSTIN\r\n    14\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n    15\t           SELECT STMT-OUT ASSIGN TO STMTOUT\r\n    16\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n    17\t           SELECT PAY-IN   ASSIGN TO PAYIN\r\n    18\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n    19"]
[17.136331, "o", "\t       DATA DIVISION.\r\n    20\t       FILE SECTION.\r\n    21\t       FD  CUST-IN.\r\n    22\t       01  IN-REC                    PIC X(80).\r\n    23\t       FD  STMT-OUT.\r\n    24\t       01  OUT-REC                   PIC X(72).\r\n    25\t       FD  PAY-IN.\r\n    26"]
[17.137185, "o", "\t       01  PAY-REC                   PIC X(80).\r\n    27\t       WORKING-STORAGE SECTION.\r\n    28\t       COPY \"CUSTREC.cpy\".\r\n    29\t       COPY \"TARIFFS.cpy\".\r\n    30\t       01  WS-FLAGS.\r\n    31\t           05  WS-EOF                PIC X VALUE \"N\".\r\n    32\t               88  END-OF-INPUT      VALUE \"Y\".\r\n    33\t           05  WS-PAY-EOF            PIC X VALUE \"N\".\r\n    34\t               88  END-OF-PAY        VALUE \"Y\".\r\n    35\t       01  ACCT-TABLE.\r\n    36\t           05  AT-COUNT              PIC 9(4) VALUE 0.\r\n    37\t           05  AT-ENTRY OCCURS 1 TO 999 TIMES\r\n    38\t                   DEPENDING ON AT-COUNT INDEXED BY AX.\r\n    39\t               10  AT-ACCT           PIC X(8).\r\n    40\t               10  AT-BAL            PIC S9(9)V99.\r\n    41\t       01  PAY-WORK.\r\n    42\t           05  PAY-LINE              PIC X(80).\r\n    43\t           05  PL-ACCT               PIC X(8)  VALUE SPACES.\r\n    44\t           05  PL-KIND               PIC X(3)  VALUE SPACES.\r\n    45\t               88  KIND-PAY          VALUE "]
