   195	           05  FILLER                PIC X(11) VALUE "  REJECTED ".
   196	           05  LT-REJECTED           PIC ZZ9.
   197	           05  FILLER                PIC X(10) VALUE "  CREDITS ".
   198	           05  LT-CREDITS            PIC ZZ9.
   199	       01  L-TOT2.
   200	           05  FILLER                PIC X(12) VALUE "TOTAL UNITS ".
   201	           05  LT-UNITS              PIC ZZZ,ZZZ,ZZ9.
   202	           05  FILLER                PIC X(16) VALUE "  TOTAL CURRENT ".
   203	           05  LT-CURRENT            PIC $$$,$$$,$$9.99.
   204	       01  L-TOT3.
   205	           05  FILLER                PIC X(10) VALUE "TOTAL DUE ".
   206	           05  LT-DUE                PIC $$$,$$$,$$9.99.
   207	           05  FILLER                PIC X(15) VALUE "  AVERAGE BILL ".
   208	           05  LT-AVERAGE            PIC $$,$$$,$$9.99.
   209	       01  L-TOT4.
   210	           05  FILLER                PIC X(13) VALUE "NET POSITION ".
   211	           05  LT-NET                PIC ---,---,--9.99.
   212	       PROCEDURE DIVISION.
   213	       MAIN-LINE.
   214	           OPEN INPUT CUST-IN
   215	                OUTPUT STMT-OUT
   216	           PERFORM READ-IN
   217	           IF NOT END-OF-INPUT AND IS-HEADER
   218	               PERFORM WRITE-HEADER
   219	               PERFORM READ-IN
   220	           END-IF
   221	           PERFORM UNTIL END-OF-INPUT
   222	               IF IS-CUSTOMER
   223	                   PERFORM ONE-ACCOUNT
   224	               END-IF
   225	               PERFORM READ-IN
   226	           END-PERFORM
   227	           PERFORM WRITE-TOTALS
   228	           PERFORM POST-PAYMENTS
   229	           CLOSE CUST-IN STMT-OUT
   230	           STOP RUN.
   231	
   232	       READ-IN.
   233	           READ CUST-IN INTO CUST-REC
   234	               AT END SET END-OF-INPUT TO TRUE
   235	           END-READ.
   236	
   237	       WRITE-HEADER.
   238	           MOVE HDR-REGION TO LH-REGION
   239	           MOVE STMT-DATE(7:2) TO WS-DATE-DMY(1:2)
   240	           MOVE STMT-DATE(5:2) TO WS-DATE-DMY(3:2)
   241	           MOVE STMT-DATE(1:4) TO WS-DATE-DMY(5:4)
   242	           MOVE WS-DATE-DMY TO LH-DATE
   243	           WRITE OUT-REC FROM L-HEAD
   244	           MOVE SPACES TO OUT-REC
   245	           WRITE OUT-REC.
   246	
   247	       ONE-ACCOUNT.
   248	           MOVE SPACES TO WS-REASON
   249	           SET TX TO 1
   250	           SEARCH TARIFF-ROW
   251	               AT END MOVE "UNKNOWN TARIFF" TO WS-REASON
   252	               WHEN TR-CODE(TX) = TARIFF
   253	                   CONTINUE
   254	           END-SEARCH
   255	           EVALUATE TRUE
   256	               WHEN WS-REASON NOT = SPACES
   257	                   CONTINUE
   258	               WHEN BILL-DAYS = 0
   259	                   MOVE "NO BILLING DAYS" TO WS-REASON
   260	               WHEN BILL-DAYS > 120
   261	                   MOVE "PERIOD TOO LONG" TO WS-REASON
   262	           END-EVALUATE
   263	           IF WS-REASON NOT = SPACES
   264	               ADD 1 TO WS-REJECTED
   265	               MOVE ACCT-NO TO LJ-ACCT
   266	               MOVE WS-REASON TO LJ-REASON
   267	               WRITE OUT-REC FROM L-REJECT
   268	               MOVE SPACES TO OUT-REC
   269	               WRITE OUT-REC
   270	           ELSE
   271	               PERFORM CALC-BILL
   272	               PERFORM PRINT-BILL
   273	           END-IF.
   274	
   275	       CALC-BILL.
   276	           IF CURR-READ >= PREV-READ
   277	               SUBTRACT PREV-READ FROM CURR-READ GIVING WS-UNITS
   278	           ELSE
   279	               COMPUTE WS-UNITS = CURR-READ + 1000000 - PREV-READ
   280	           END-IF
[?2004hroot@1a267ab558a6:/app# sed -n '281,420p' /app/legacy/WBILL.cbl | nl -ba -v281
[?2004l   281	           MULTIPLY TR-LIMIT1(TX) BY BILL-DAYS GIVING WS-TEMP
   282	           DIVIDE WS-TEMP BY 30 GIVING WS-LIM1 ROUNDED
   283	           MULTIPLY TR-LIMIT2(TX) BY BILL-DAYS GIVING WS-TEMP
   284	           DIVIDE WS-TEMP BY 30 GIVING WS-LIM2 ROUNDED
   285	           MOVE 0 TO WS-B1 WS-B2 WS-B3
   286	           IF WS-UNITS > WS-LIM1
   287	               MOVE WS-LIM1 TO WS-B1
   288	               IF WS-UNITS > WS-LIM2
   289	                   SUBTRACT WS-LIM1 FROM WS-LIM2 GIVING WS-B2
   290	                   SUBTRACT WS-LIM2 FROM WS-UNITS GIVING WS-B3
   291	               ELSE
   292	                   SUBTRACT WS-LIM1 FROM WS-UNITS GIVING WS-B2
   293	               END-IF
   294	           ELSE
   295	               MOVE WS-UNITS TO WS-B1
   296	           END-IF
   297	           MULTIPLY WS-B1 BY TR-RATE1(TX) GIVING WS-C1 ROUNDED
   298	           MULTIPLY WS-B2 BY TR-RATE2(TX) GIVING WS-C2 ROUNDED
   299	           MULTIPLY WS-B3 BY TR-RATE3(TX) GIVING WS-C3 ROUNDED
   300	           ADD WS-C1 WS-C2 WS-C3 GIVING WS-USAGE
   301	           MULTIPLY BILL-DAYS BY TR-STANDING(TX)
   302	               GIVING WS-STANDING ROUNDED
   303	           MOVE 0 TO WS-DISCOUNT
   304	           IF TARIFF-RELIEF
   305	               MULTIPLY WS-USAGE BY 0.15 GIVING WS-DISCOUNT
   306	               SUBTRACT WS-DISCOUNT FROM WS-USAGE
   307	           END-IF
   308	           ADD WS-USAGE WS-STANDING GIVING WS-NET
   309	           MULTIPLY WS-NET BY 0.05 GIVING WS-VAT ROUNDED
   310	           ADD WS-NET WS-VAT GIVING WS-CURRENT
   311	           MOVE 0 TO WS-INTEREST
   312	           IF ARREARS > 0
   313	               MULTIPLY ARREARS BY 0.015 GIVING WS-INTEREST ROUNDED
   314	           END-IF
   315	           COMPUTE WS-BALANCE = WS-CURRENT + ARREARS + WS-INTEREST
   316	                              - PAID
   317	           MOVE 0 TO WS-DUE WS-CARRY
   318	           IF WS-BALANCE > 0
   319	               MOVE WS-BALANCE TO WS-DUE
   320	           END-IF
   321	           IF WS-BALANCE < 0
   322	               MULTIPLY WS-BALANCE BY 0.975 GIVING WS-CARRY ROUNDED
   323	               ADD 1 TO WS-CREDITS
   324	           END-IF
   325	           ADD 1 TO WS-BILLED
   326	           ADD 1 TO AT-COUNT
   327	           MOVE ACCT-NO TO AT-ACCT(AT-COUNT)
   328	           MOVE WS-BALANCE TO AT-BAL(AT-COUNT)
   329	           ADD WS-UNITS TO WS-TOT-UNITS
   330	           ADD WS-CURRENT TO WS-TOT-CURRENT
   331	           ADD WS-DUE TO WS-TOT-DUE
   332	           ADD WS-BALANCE TO WS-TOT-NET.
   333	
   334	       PRINT-BILL.
   335	           MOVE CUST-NAME TO WS-NAME
   336	           INSPECT WS-NAME CONVERTING "abcdefghijklmnopqrstuvwxyz"
   337	                                   TO "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
   338	           MOVE SPACES TO WS-NAME-OUT
   339	           STRING WS-NAME DELIMITED BY "  " INTO WS-NAME-OUT
   340	           IF WS-NAME-OUT = SPACES
   341	               MOVE "(NO NAME ON FILE)" TO WS-NAME-OUT
   342	           END-IF
   343	           MOVE ACCT-NO(5:4) TO LA-TAIL
   344	           MOVE WS-NAME-OUT TO LA-NAME
   345	           MOVE TARIFF TO LA-TARIFF
   346	           WRITE OUT-REC FROM L-ACCT
   347	           MOVE PREV-READ TO LR-PREV
   348	           MOVE CURR-READ TO LR-CURR
   349	           MOVE WS-UNITS TO LR-UNITS
   350	           MOVE BILL-DAYS TO LR-DAYS
   351	           WRITE OUT-REC FROM L-READ
   352	           MOVE WS-B1 TO LB-1
   353	           MOVE WS-B2 TO LB-2
   354	           MOVE WS-B3 TO LB-3
   355	           WRITE OUT-REC FROM L-BANDS
   356	           MOVE WS-USAGE TO LC-USAGE
   357	           MOVE WS-STANDING TO LC-STANDING
   358	           WRITE OUT-REC FROM L-CHARGE
   359	           MOVE WS-DISCOUNT TO LD-DISCOUNT
   360	           MOVE WS-VAT TO LD-VAT
   361	           MOVE WS-CURRENT TO LD-CURRENT
   362	           WRITE OUT-REC FROM L-DISC
   363	           MOVE ARREARS TO LX-ARREARS
   364	           MOVE WS-INTEREST TO LX-INTEREST
   365	           MOVE PAID TO LX-PAID
   366	           WRITE OUT-REC FROM L-ARR
   367	           MOVE WS-BALANCE TO LL-BALANCE
   368	           MOVE WS-DUE TO LL-DUE
   369	           WRITE OUT-REC FROM L-BAL
   370	           IF WS-BALANCE < 0
   371	               MOVE WS-CARRY TO LY-CARRY
   372	               WRITE OUT-REC FROM L-CARRY
   373	           END-IF
   374	           MOVE SPACES TO OUT-REC
   375	           WRITE OUT-REC.
   376	
   377	       WRITE-TOTALS.
   378	           MOVE WS-BILLED TO LT-BILLED
   379	           MOVE WS-REJECTED TO LT-REJECTED
   380	           MOVE WS-CREDITS TO LT-CREDITS
   381	           WRITE OUT-REC FROM L-TOT1
   382	           MOVE WS-TOT-UNITS TO LT-UNITS
   383	           MOVE WS-TOT-CURRENT TO LT-CURRENT
   384	           WRITE OUT-REC FROM L-TOT2
   385	           IF WS-BILLED > 0
   386	               DIVIDE WS-TOT-CURRENT BY WS-BILLED
   387	                   GIVING WS-AVERAGE ROUNDED
   388	           END-IF
   389	           MOVE WS-TOT-DUE TO LT-DUE
   390	           MOVE WS-AVERAGE TO LT-AVERAGE
   391	           WRITE OUT-REC FROM L-TOT3
   392	           MOVE WS-TOT-NET TO LT-NET
   393	           WRITE OUT-REC FROM L-TOT4.
   394	
   395	       POST-PAYMENTS.
   396	           MOVE SPACES TO OUT-REC
   397	           WRITE OUT-REC
   398	           WRITE OUT-REC FROM L-LEDGER
   399	           OPEN INPUT PAY-IN
   400	           PERFORM READ-PAY
   401	           PERFORM UNTIL END-OF-PAY
   402	               ADD 1 TO WS-LINE-NO
   403	               PERFORM ONE-PAYMENT
   404	               PERFORM READ-PAY
   405	           END-PERFORM
   406	           CLOSE PAY-IN
   407	           MOVE WS-APPLIED TO LV-APPLIED
   408	           MOVE WS-PAY-REJECTED TO LV-REJECTED
   409	           MOVE WS-TOT-PAID TO LV-PAID
   410	           MOVE WS-TOT-OTHER TO LV-OTHER
   411	           WRITE OUT-REC FROM L-PAYTOT.
   412	
   413	       READ-PAY.
   414	           READ PAY-IN INTO PAY-LINE
   415	               AT END SET END-OF-PAY TO TRUE
   416	           END-READ.
   417	
   418	       ONE-PAYMENT.
   419	           MOVE 0 TO PL-FIELDS PL-ACCT-LEN
   420	           UNSTRING PAY-LINE DELIMITED BY ";"
[?2004hroot@1a267ab558a6:/app# sed -n '421,620p' /app/legacy/WBILL.cbl | nl -ba -v421
[?2004l   421	               INTO PL-ACCT COUNT IN PL-ACCT-LEN
   422	                    PL-KIND
   423	                    PL-AMT-TXT
   424	                    PL-MEMO
   425	               TALLYING IN PL-FIELDS
   426	           END-UNSTRING
   427	           MOVE SPACES TO WS-REASON
   428	           EVALUATE TRUE
   429	               WHEN PL-FIELDS < 3
   430	                   MOVE "TOO FEW FIELDS" TO WS-REASON
   431	               WHEN PL-ACCT-LEN NOT = 8
   432	                   MOVE "BAD ACCOUNT" TO WS-REASON
   433	               WHEN FUNCTION TEST-NUMVAL(PL-AMT-TXT) NOT = 0
   434	                   MOVE "BAD AMOUNT" TO WS-REASON
   435	               WHEN NOT (KIND-PAY OR KIND-ADJ OR KIND-FEE OR KIND-REF)
   436	                   MOVE "BAD KIND" TO WS-REASON
   437	           END-EVALUATE
   438	           IF WS-REASON = SPACES
   439	               SET AX TO 1
   440	               SEARCH AT-ENTRY
   441	                   AT END MOVE "NO SUCH ACCOUNT" TO WS-REASON
   442	                   WHEN AT-ACCT(AX) = PL-ACCT
   443	                       CONTINUE
   444	               END-SEARCH
   445	           END-IF
   446	           IF WS-REASON NOT = SPACES
   447	               ADD 1 TO WS-PAY-REJECTED
   448	               MOVE WS-LINE-NO TO LQ-LINE
   449	               MOVE WS-REASON TO LQ-REASON
   450	               WRITE OUT-REC FROM L-PAYREJ
   451	           ELSE
   452	               PERFORM APPLY-PAYMENT
   453	           END-IF.
   454	
   455	       APPLY-PAYMENT.
   456	           EVALUATE TRUE
   457	               WHEN KIND-PAY
   458	                   COMPUTE WS-AMT ROUNDED MODE NEAREST-EVEN
   459	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   460	                   SUBTRACT WS-AMT FROM AT-BAL(AX)
   461	                   ADD WS-AMT TO WS-TOT-PAID
   462	               WHEN KIND-ADJ
   463	                   COMPUTE WS-AMT ROUNDED
   464	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   465	                   ADD WS-AMT TO AT-BAL(AX)
   466	                   ADD WS-AMT TO WS-TOT-OTHER
   467	               WHEN KIND-FEE
   468	                   COMPUTE WS-AMT = FUNCTION NUMVAL(PL-AMT-TXT)
   469	                   ADD WS-AMT TO AT-BAL(AX)
   470	                   ADD WS-AMT TO WS-TOT-OTHER
   471	                   DIVIDE WS-AMT BY 3 GIVING WS-PART ROUNDED
   472	                       REMAINDER WS-REM
   473	               WHEN KIND-REF
   474	                   COMPUTE WS-AMT ROUNDED MODE TOWARD-LESSER
   475	                       = FUNCTION NUMVAL(PL-AMT-TXT)
   476	                   ADD WS-AMT TO AT-BAL(AX)
   477	                   ADD WS-AMT TO WS-TOT-OTHER
   478	           END-EVALUATE
   479	           COMPUTE WS-WHOLE = FUNCTION INTEGER(WS-AMT)
   480	           INSPECT PL-MEMO CONVERTING "0123456789" TO "XXXXXXXXXX"
   481	               AFTER INITIAL "#"
   482	           ADD 1 TO WS-APPLIED
   483	           MOVE PL-KIND TO LP-KIND
   484	           MOVE PL-ACCT TO LP-ACCT
   485	           MOVE WS-AMT TO LP-AMT
   486	           MOVE WS-WHOLE TO LP-WHOLE
   487	           MOVE AT-BAL(AX) TO LP-BAL
   488	           MOVE PL-MEMO TO LP-MEMO
   489	           WRITE OUT-REC FROM L-POST
   490	           IF KIND-FEE
   491	               MOVE WS-PART TO LS-PART
   492	               MOVE WS-REM TO LS-REM
   493	               WRITE OUT-REC FROM L-SPLIT
   494	           END-IF.
