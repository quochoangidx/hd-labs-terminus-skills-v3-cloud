[166.225206, "o", "> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"def currency(v, width, dec=2):\\n    s = '$' + comma(v, dec)\\n    return s[-width:].rjust(width)\\n\", \"def currency(v, width, dec=2):\\n    n = comma(v, dec)\\n    s = '$' + n\\n    if len(s) > width:\\n        s = '$' + n[-(width-1):]\\n    return s.rjust(width)\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.227764, "o", "s=s.replace(\"def money_trailing(v, width):\\n    s = '$' + comma(v, 2)\\n    suffix = '-' if D(v) < 0 else ' '\\n    return s[-(width-1):].rjust(width-1) + suffix\\n\", \"def money_trailing(v, width):\\n    n = comma(v, 2)\\n    s = '$' + n\\n    body = width - 1\\n    if len(s) > body:\\n        s = '$' + n[-(body-1):]\\n    suffix = '-' if D(v) < 0 else ' '\\n    return s.rjust(body) + suffix\\n\\ndef signed_integer(v, width):\\n    s = str(abs(int(v)))\\n    if D(v) < 0:\\n        s = '-' + s\\n    return s[-width:].rjust(width)\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
