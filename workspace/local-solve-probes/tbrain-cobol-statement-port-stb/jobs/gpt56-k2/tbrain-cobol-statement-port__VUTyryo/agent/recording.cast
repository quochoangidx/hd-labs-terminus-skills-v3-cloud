[166.223911, "i", "python3 - <<'PY'\np='/app/port/wbill.py'\ns=open(p).read()\ns=s.replace(\"def currency(v, width, dec=2):\\n    s = '$' + comma(v, dec)\\n    return s[-width:].rjust(width)\\n\", \"def currency(v, width, dec=2):\\n    n = comma(v, dec)\\n    s = '$' + n\\n    if len(s) > width:\\n        s = '$' + n[-(width-1):]\\n    return s.rjust(width)\\n\")\ns=s.replace(\"def money_trailing(v, width):\\n    s = '$' + comma(v, 2)\\n    suffix = '-' if D(v) < 0 else ' '\\n    return s[-(width-1):].rjust(width-1) + suffix\\n\", \"def money_trailing(v, width):\\n    n = comma(v, 2)\\n    s = '$' + n\\n    body = width - 1\\n    if len(s) > body:\\n        s = '$' + n[-(body-1):]\\n    suffix = '-' if D(v) < 0 else ' '\\n    return s.rjust(body) + suffix\\n\\ndef signed_integer(v, width):\\n    s = str(abs(int(v)))\\n    if D(v) < 0:\\n        s = '-' + s\\n    return s[-width:].rjust(width)\\n\")\ns=s.replace(\"currency(tot_current,13)\", \"currency(tot_current,14)\")\ns=s.replace(\"currency(tot_due,13)\", \"currency(tot_due,14)\")\ns=s.replace(\"currency(average,12)\", \"curre"]
[166.224123, "i", "ncy(average,13)\")\ns=s.replace(\"float_sign(tot_net,13)\", \"float_sign(tot_net,14)\")\ns=s.replace(\"float_sign(D(whole),6,0)\", \"signed_integer(whole,6)\")\ns=s.replace(\"float_sign(part,11)\", \"float_sign(part,10)\")\nopen(p,'w').write(s)\nPY\npython3 /app/port/wbill.py /app/legacy/samples/2025q1-north.dat /app/legacy/samples/2025q1-north.pay /tmp/test.stmt\ncmp -s /app/legacy/samples/2025q1-north.stmt /tmp/test.stmt; echo \"cmp_status=$?\"\ndiff -u /app/legacy/samples/2025q1-north.stmt /tmp/test.stmt | sed -n '1,200p' || true\n"]
