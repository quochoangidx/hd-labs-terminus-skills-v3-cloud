[45.637362, "o", "   247\t       ONE-ACCOUNT.\r\n"]
[45.63738, "o", "   248\t           MOVE SPACES TO WS-REASON\r\n"]
[45.637388, "o", "   249\t           SET TX TO 1\r\n"]
[45.637414, "o", "   250\t           SEARCH TARIFF-ROW\r\n"]
[45.637421, "o", "   251\t               AT END MOVE \"UNKNOWN TARIFF\" TO WS-REASON\r\n"]
[45.63743, "o", "   252\t               WHEN TR-CODE(TX) = TARIFF\r\n"]
[45.637437, "o", "   253\t                   CONTINUE\r\n"]
[45.637448, "o", "   254\t           END-SEARCH\r\n"]
[45.637474, "o", "   255\t           EVALUATE TRUE\r\n"]
[45.637486, "o", "   256\t               WHEN WS-REASON NOT = SPACES\r\n   257\t                   CONTINUE\r\n   258\t               WHEN BILL-DAYS = 0\r\n   259\t                   MOVE \"NO BILLING DAYS\" TO WS-REASON\r\n   260\t               WHEN BILL-DAYS > 120\r\n"]
[45.637501, "o", "   261\t                   MOVE \"PERIOD TOO LONG\" TO WS-REASON\r\n   262\t           END-EVALUATE\r\n   263\t           IF WS-REASON NOT = SPACES\r\n   264\t               ADD 1 TO WS-REJECTED\r\n"]
[45.637533, "o", "   265\t               MOVE ACCT-NO TO LJ-ACCT\r\n   266\t               MOVE WS-REASON TO LJ-REASON\r\n   267\t               WRITE OUT-REC FROM L-REJECT\r\n   268\t               MOVE SPACES TO OUT-REC\r\n   269\t               WRITE OUT-REC\r\n"]
[45.6376, "o", "   270\t           ELSE\r\n   271\t               PERFORM CALC-BILL\r\n   272\t               PERFORM PRINT-BILL\r\n   273\t           END-IF.\r\n   274\t\r\n   275\t       CALC-BILL.\r\n   276\t           IF CURR-READ >= PREV-READ\r\n   277\t               SUBTRACT PREV-READ FROM CURR-READ GIVING WS-UNITS\r\n   278\t           ELSE\r\n   279\t               COMPUTE WS-UNITS = CURR-READ + 1000000 - PREV-READ\r\n"]
