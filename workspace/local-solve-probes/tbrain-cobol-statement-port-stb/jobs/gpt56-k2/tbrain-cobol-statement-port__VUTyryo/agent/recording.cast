[9.38726, "o", "for f in /app/legacy/*; do if [ -f \"$f\" ] && [ \"$f\" != /app/legacy/WBILL.cbl ] && [ \"$f\" != /app/legacy/RUNBOOK.md ]; then echo \"--- $f ---\"; nl -ba \"$f\"; fi; done\r\n\u001b[?2004l\r--- /app/legacy/CUSTREC.cpy ---\r\n     1\t      *----------------------------------------------------------------\r\n     2\t      * CUSTREC  -  METER-READING INPUT RECORD (80 BYTES)\r\n     3\t      *----------------------------------------------------------------\r\n     4\t       01  CUST-REC.\r\n     5\t           05  REC-TYPE              PIC X.\r\n     6\t               88  IS-HEADER         VALUE \"H\".\r\n     7\t               88  IS-CUSTOMER       VALUE \"C\".\r\n     8\t           05  CUST-BODY.\r\n     9\t               10  ACCT-NO           PIC X(8).\r\n    10\t               10  CUST-NAME         PIC X(24).\r\n    11\t               10  TARIFF            PIC X.\r\n    12\t                   88  TARIFF-DOMESTIC    VALUE \"D\".\r\n    13\t                   88  TARIFF-COMMERCIAL  VALUE \"C\".\r\n    14\t                   88  TARIFF-RELIEF      VALUE \"L\".\r\n    15\t           "]
