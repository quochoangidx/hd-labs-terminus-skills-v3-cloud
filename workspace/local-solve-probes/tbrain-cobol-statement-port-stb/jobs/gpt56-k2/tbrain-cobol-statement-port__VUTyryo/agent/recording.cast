[16.634594, "o", "   141\t           05  FILLER                PIC X(10) VALUE \"  INTEREST\".\r\n   142\t           05  LX-INTEREST           PIC ZZ,ZZ9.99 BLANK WHEN ZERO.\r\n   143\t           05  FILLER                PIC X(6)  VALUE \"  PAID\".\r\n   144\t           05  LX-PAID               PIC ZZ,ZZ9.99.\r\n   145\t       01  L-BAL.\r\n   146\t           05  FILLER                PIC X(8)  VALUE \"BALANCE \".\r\n   147\t           05  LL-BALANCE            PIC Z,ZZZ,ZZ9.99CR.\r\n   148\t           05  FILLER                PIC X(12) VALUE \"  AMOUNT DUE\".\r\n   149\t           05  LL-DUE                PIC ***,**9.99.\r\n   150\t       01  L-CARRY.\r\n   151\t           05  FILLER                PIC X(11) VALUE \"CREDIT C/F \".\r\n   152\t           05  LY-CARRY              PIC $$$,$$9.99-.\r\n   153\t       01  L-REJECT.\r\n   154\t           05  FILLER                PIC X(7)  VALUE \"REJECT \".\r\n   155\t           05  LJ-ACCT               PIC X(8).\r\n   156\t           05  FILLER                PIC X     VALUE SPACE.\r\n   157\t           05  LJ-REASON             PIC X("]
[16.635399, "o", "20).\r\n   158\t       01  L-LEDGER.\r\n   159\t           05  FILLER                PIC X(24)\r\n   160\t                                     VALUE \"PAYMENTS AND ADJUSTMENTS\".\r\n   161\t       01  L-POST.\r\n   162\t           05  LP-KIND               PIC X(3).\r\n   163\t           05  FILLER                PIC X     VALUE SPACE.\r\n   164\t           05  LP-ACCT               PIC X(8).\r\n   165\t           05  FILLER                PIC X     VALUE SPACE.\r\n   166\t           05  LP-AMT                PIC ----,--9.99.\r\n   167\t           05  FILLER                PIC X(7)  VALUE \" WHOLE \".\r\n   168\t           05  LP-WHOLE              PIC -----9.\r\n   169\t           05  FILLER                PIC X(5)  VALUE \" BAL \".\r\n   170\t           05  LP-BAL                PIC Z,ZZZ,ZZ9.99CR.\r\n   171\t           05  FILLER                PIC X     VALUE SPACE.\r\n   172\t           05  LP-MEMO               PIC X(30).\r\n   173\t       01  L-SPLIT.\r\n   174\t           05  FILLER                PIC X(16) VALUE \"    FEE SPLIT 3X\".\r\n   175\t           05  L"]
[16.635574, "o", "S-PART               PIC ---,--9.99.\r\n   176\t           05  FILLER                PIC X(11) VALUE \" REMAINDER \".\r\n   177\t           05  LS-REM                PIC -9.99.\r\n   178\t       01  L-PAYREJ.\r\n   179\t           05  FILLER                PIC X(5)  VALUE \"LINE \".\r\n"]
[16.635613, "o", "   180\t           05  LQ-LINE               PIC ZZ9.\r\n   181\t           05  FILLER                PIC X(10) VALUE \" REJECTED \".\r\n   182\t           05  LQ-REASON             PIC X(20).\r\n   183\t       01  L-PAYTOT.\r\n   184\t           05  FILLER                PIC X(8)  VALUE \"POSTED  \".\r\n   185\t           05  LV-APPLIED            PIC ZZ9.\r\n   186\t           05  FILLER                PIC X(11) VALUE \"  REJECTED \".\r\n   187\t           05  LV-REJECTED           PIC ZZ9.\r\n   188\t           05  FILLER                PIC X(8)  VALUE \"  PAID  \".\r\n   189\t           05  LV-PAID               PIC $$,$$$,$$9.99-.\r\n   190\t           05  FILLER                PIC X(8)  VALUE \"  OTHER \".\r\n   191\t           05  LV-OTHER              PIC $$,$$$,$$9.99-.\r\n"]
[16.635749, "o", "   192\t       01  L-TOT1.\r\n"]
[16.636369, "o", "   193\t           05  FILLER                PIC X(16) VALUE \"ACCOUNTS BILLED \".\r\n   194\t           05  LT-BILLED             PIC ZZ9.\r\n   195\t           05  FILLER                PIC X(11) VALUE \"  REJECTED \".\r\n   196\t           05  LT-REJECTED           PIC ZZ9.\r\n   197\t           05  FILLER                PIC X(10) VALUE \"  CREDITS \".\r\n   198\t           05  LT-CREDITS            PIC ZZ9.\r\n   199\t       01  L-TOT2.\r\n"]
[16.63704, "o", "   200\t           05  FILLER                PIC X(12) VALUE \"TOTAL UNITS \".\r\n   201\t           05  LT-UNITS              PIC ZZZ,ZZZ,ZZ9.\r\n   202\t           05  FILLER                PIC X(16) VALUE \"  TOTAL CURRENT \".\r\n   203\t           05  LT-CURRENT            PIC $$$,$$$,$$9.99.\r\n   204\t       01  L-TOT3.\r\n   205\t           05  FILLER                PIC X(10) VALUE \"TOTAL DUE \".\r\n   206\t           05  LT-DUE                PIC $$$,$$$,$$9.99.\r\n   207\t           05  FILLER                PIC X(15) VALUE \"  AVERAGE BILL \".\r\n   208\t           05  LT-AVERAGE            PIC $$,$$$,$$9.99.\r\n   209\t       01  L-TOT4.\r\n   210\t           05  FILLER                PIC X(13) VALUE \"NET POSITION \".\r\n   211\t           05  LT-NET                PIC ---,---,--9.99.\r\n   212\t       PROCEDURE DIVISION.\r\n   213\t       MAIN-LINE.\r\n   214\t           OPEN INPUT CUST-IN\r\n   215\t                OUTPUT STMT-OUT\r\n   216\t           PERFORM READ-IN\r\n"]
[16.637239, "o", "   217\t           IF NOT END-OF-INPUT AND IS-HEADER\r\n   218\t               PERFORM WRITE-HEADER\r\n   219\t               PERFORM READ-IN\r\n   220\t           END-IF\r\n   221\t           PERFORM UNTIL END-OF-INPUT\r\n   222\t               IF IS-CUSTOMER\r\n   223\t                   PERFORM ONE-ACCOUNT\r\n   224\t               END-IF\r\n   225\t               PERFORM READ-IN\r\n   226\t           END-PERFORM\r\n   227\t           PERFORM WRITE-TOTALS\r\n   228\t           PERFORM POST-PAYMENTS\r\n   229\t           CLOSE CUST-IN STMT-OUT\r\n   230\t           STOP RUN.\r\n   231\t\r\n   232\t       READ-IN.\r\n   233\t           READ CUST-IN INTO CUST-REC\r\n   234\t               AT END SET END-OF-INPUT TO TRUE\r\n   235\t           END-READ.\r\n   236\t\r\n   237\t       WRITE-HEADER.\r\n   238\t           MOVE HDR-REGION TO LH-REGION\r\n   239\t           MOVE STMT-DATE(7:2) TO WS-DATE-DMY(1:2)\r\n   240\t           MOVE STMT-DATE(5:2) TO WS-DATE-DMY(3:2)\r\n   241\t           MOVE STMT-DATE(1:4) TO WS-DATE-DMY(5:4)\r\n   242\t           MOVE WS-DATE-DMY TO LH-DATE\r\n   243"]
[16.637563, "o", "\t           WRITE OUT-REC FROM L-HEAD\r\n   244\t           MOVE SPACES TO OUT-REC\r\n   245\t           WRITE OUT-REC.\r\n   246\t\r\n   247\t       ONE-ACCOUNT.\r\n   248\t           MOVE SPACES TO WS-REASON\r\n   249\t           SET TX TO 1\r\n   250\t           SEARCH TARIFF-ROW\r\n   251\t               AT END MOVE \"UNKNOWN TARIFF\" TO WS-REASON\r\n   252\t               WHEN TR-CODE(TX) = TARIFF\r\n   253\t                   CONTINUE\r\n   254\t           END-SEARCH\r\n   255\t           EVALUATE TRUE\r\n   256\t               WHEN WS-REASON NOT = SPACES\r\n   257\t                   CONTINUE\r\n   258\t               WHEN BILL-DAYS = 0\r\n   259\t                   MOVE \"NO BILLING DAYS\" TO WS-REASON\r\n   260\t               WHEN BILL-DAYS > 120\r\n   261\t                   MOVE \"PERIOD TOO LONG\" TO WS-REASON\r\n   262\t           END-EVALUATE\r\n   263\t           IF WS-REASON NOT = SPACES\r\n   264\t               ADD 1 TO WS-REJECTED\r\n   265\t               MOVE ACCT-NO TO LJ-ACCT\r\n"]
[16.637794, "o", "   266\t               MOVE WS-REASON TO LJ-REASON\r\n   267\t               WRITE OUT-REC FROM L-REJECT\r\n   268\t               MOVE SPACES TO OUT-REC\r\n   269\t               WRITE OUT-REC\r\n   270\t           ELSE\r\n   271\t               PERFORM CALC-BILL\r\n   272\t               PERFORM PRINT-BILL\r\n   273\t           END-IF.\r\n"]
[16.638081, "o", "   274\t\r\n   275\t       CALC-BILL.\r\n   276\t           IF CURR-READ >= PREV-READ\r\n   277\t               SUBTRACT PREV-READ FROM CURR-READ GIVING WS-UNITS\r\n   278\t           ELSE\r\n   279\t               COMPUTE WS-UNITS = CURR-READ + 1000000 - PREV-READ\r\n   280\t           END-IF\r\n"]
