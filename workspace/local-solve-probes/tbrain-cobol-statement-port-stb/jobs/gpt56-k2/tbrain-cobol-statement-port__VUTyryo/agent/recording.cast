[36.330065, "o", "   461\t                   ADD WS-AMT TO WS-TOT-PAID\r\n   462\t               WHEN KIND-ADJ\r\n   463\t                   COMPUTE WS-AMT ROUNDED\r\n   464\t                       = FUNCTION NUMVAL(PL-AMT-TXT)\r\n   465\t                   ADD WS-AMT TO AT-BAL(AX)\r\n   466\t                   ADD WS-AMT TO WS-TOT-OTHER\r\n   467\t               WHEN KIND-FEE\r\n   468\t                   COMPUTE WS-AMT = FUNCTION NUMVAL(PL-AMT-TXT)\r\n   469\t                   ADD WS-AMT TO AT-BAL(AX)\r\n   470\t                   ADD WS-AMT TO WS-TOT-OTHER\r\n   471\t                   DIVIDE WS-AMT BY 3 GIVING WS-PART ROUNDED\r\n   472\t                       REMAINDER WS-REM\r\n   473\t               WHEN KIND-REF\r\n   474\t                   COMPUTE WS-AMT ROUNDED MODE TOWARD-LESSER\r\n   475\t                       = FUNCTION NUMVAL(PL-AMT-TXT)\r\n   476\t                   ADD WS-AMT TO AT-BAL(AX)\r\n   477\t                   ADD WS-AMT TO WS-TOT-OTHER\r\n   478\t           END-EVALUATE\r\n   479\t           COMPUTE WS-WHOLE = FUNCTION INTEGER(WS-AMT)\r\n   480\t          "]
[36.330076, "o", " INSPECT PL-MEMO CONVERTING \"0123456789\" TO \"XXXXXXXXXX\"\r\n   481\t               AFTER INITIAL \"#\"\r\n   482\t           ADD 1 TO WS-APPLIED\r\n   483\t           MOVE PL-KIND TO LP-KIND\r\n   484\t           MOVE PL-ACCT TO LP-ACCT\r\n   485\t           MOVE WS-AMT TO LP-AMT\r\n   486\t           MOVE WS-WHOLE TO LP-WHOLE\r\n   487\t           MOVE AT-BAL(AX) TO LP-BAL\r\n   488\t           MOVE PL-MEMO TO LP-MEMO\r\n   489\t           WRITE OUT-REC FROM L-POST\r\n   490\t           IF KIND-FEE\r\n   491\t               MOVE WS-PART TO LS-PART\r\n   492\t               MOVE WS-REM TO LS-REM\r\n   493\t               WRITE OUT-REC FROM L-SPLIT\r\n   494\t           END-IF.\r\n"]
