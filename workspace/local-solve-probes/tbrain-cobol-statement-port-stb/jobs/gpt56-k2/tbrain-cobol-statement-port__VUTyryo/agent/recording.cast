[16.950395, "o", "\r\n\u001b[?2004l\r"]
[16.952303, "o", "   281\t           MULTIPLY TR-LIMIT1(TX) BY BILL-DAYS GIVING WS-TEMP\r\n   282\t           DIVIDE WS-TEMP BY 30 GIVING WS-LIM1 ROUNDED\r\n   283\t           MULTIPLY TR-LIMIT2(TX) BY BILL-DAYS GIVING WS-TEMP\r\n   284\t           DIVIDE WS-TEMP BY 30 GIVING WS-LIM2 ROUNDED\r\n   285\t           MOVE 0 TO WS-B1 WS-B2 WS-B3\r\n   286\t           IF WS-UNITS > WS-LIM1\r\n   287\t               MOVE WS-LIM1 TO WS-B1\r\n   288\t               IF WS-UNITS > WS-LIM2\r\n   289\t                   SUBTRACT WS-LIM1 FROM WS-LIM2 GIVING WS-B2\r\n   290\t                   SUBTRACT WS-LIM2 FROM WS-UNITS GIVING WS-B3\r\n   291\t               ELSE\r\n   292\t                   SUBTRACT WS-LIM1 FROM WS-UNITS GIVING WS-B2\r\n   293\t               END-IF\r\n   294\t           ELSE\r\n   295\t               MOVE WS-UNITS TO WS-B1\r\n   296\t           END-IF\r\n   297\t           MULTIPLY WS-B1 BY TR-RATE1(TX) GIVING WS-C1 ROUNDED\r\n   298\t           MULTIPLY WS-B2 BY TR-RATE2(TX) GIVING WS-C2 ROUNDED\r\n   299\t           MULTIPLY WS-B3 BY TR-RATE3(TX) GIVING WS-C3 ROUNDED\r\n "]
[16.952323, "o", "  300\t           ADD WS-C1 WS-C2 WS-C3 GIVING WS-USAGE\r\n   301\t           MULTIPLY BILL-DAYS BY TR-STANDING(TX)\r\n   302\t               GIVING WS-STANDING ROUNDED\r\n   303\t           MOVE 0 TO WS-DISCOUNT\r\n   304\t           IF TARIFF-RELIEF\r\n   305\t               MULTIPLY WS-USAGE BY 0.15 GIVING WS-DISCOUNT\r\n   306\t               SUBTRACT WS-DISCOUNT FROM WS-USAGE\r\n   307\t           END-IF\r\n   308\t           ADD WS-USAGE WS-STANDING GIVING WS-NET\r\n   309\t           MULTIPLY WS-NET BY 0.05 GIVING WS-VAT ROUNDED\r\n   310\t           ADD WS-NET WS-VAT GIVING WS-CURRENT\r\n   311\t           MOVE 0 TO WS-INTEREST\r\n   312\t           IF ARREARS > 0\r\n   313\t               MULTIPLY ARREARS BY 0.015 GIVING WS-INTEREST ROUNDED\r\n   314\t           END-IF\r\n   315\t           COMPUTE WS-BALANCE = WS-CURRENT + ARREARS + WS-INTEREST\r\n   316\t                              - PAID\r\n   317\t           MOVE 0 TO WS-DUE WS-CARRY\r\n   318\t           IF WS-BALANCE > 0\r\n   319\t               MOVE WS-BALANCE TO WS-DUE\r\n   320\t           END-IF\r\n"]
[16.95233, "o", "   321\t           IF WS-BALANCE < 0\r\n   322\t               MULTIPLY WS-BALANCE BY 0.975 GIVING WS-CARRY ROUNDED\r\n   323\t               ADD 1 TO WS-CREDITS\r\n   324\t           END-IF\r\n   325\t           ADD 1 TO WS-BILLED\r\n   326\t           ADD 1 TO AT-COUNT\r\n   327\t           MOVE ACCT-NO TO AT-ACCT(AT-COUNT)\r\n   328\t           MOVE WS-BALANCE TO AT-BAL(AT-COUNT)\r\n   329\t           ADD WS-UNITS TO WS-TOT-UNITS\r\n   330\t           ADD WS-CURRENT TO WS-TOT-CURRENT\r\n   331\t           ADD WS-DUE TO WS-TOT-DUE\r\n   332\t           ADD WS-BALANCE TO WS-TOT-NET.\r\n   333\t\r\n   334\t       PRINT-BILL.\r\n   335\t           MOVE CUST-NAME TO WS-NAME\r\n   336\t           INSPECT WS-NAME CONVERTING \"abcdefghijklmnopqrstuvwxyz\"\r\n   337\t                                   TO \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\r\n   338\t           MOVE SPACES TO WS-NAME-OUT\r\n   339\t           STRING WS-NAME DELIMITED BY \"  \" INTO WS-NAME-OUT\r\n   340\t           IF WS-NAME-OUT = SPACES\r\n   341\t               MOVE \"(NO NAME ON FILE)\" TO WS-NAME-OUT\r\n   342\t       "]
[16.952336, "o", "    END-IF\r\n   343\t           MOVE ACCT-NO(5:4) TO LA-TAIL\r\n   344\t           MOVE WS-NAME-OUT TO LA-NAME\r\n   345\t           MOVE TARIFF TO LA-TARIFF\r\n   346\t           WRITE OUT-REC FROM L-ACCT\r\n   347\t           MOVE PREV-READ TO LR-PREV\r\n   348\t           MOVE CURR-READ TO LR-CURR\r\n   349\t           MOVE WS-UNITS TO LR-UNITS\r\n   350\t           MOVE BILL-DAYS TO LR-DAYS\r\n   351\t           WRITE OUT-REC FROM L-READ\r\n   352\t           MOVE WS-B1 TO LB-1\r\n   353\t           MOVE WS-B2 TO LB-2\r\n   354\t           MOVE WS-B3 TO LB-3\r\n   355\t           WRITE OUT-REC FROM L-BANDS\r\n   356\t           MOVE WS-USAGE TO LC-USAGE\r\n   357\t           MOVE WS-STANDING TO LC-STANDING\r\n   358\t           WRITE OUT-REC FROM L-CHARGE\r\n   359\t           MOVE WS-DISCOUNT TO LD-DISCOUNT\r\n   360\t           MOVE WS-VAT TO LD-VAT\r\n   361\t           MOVE WS-CURRENT TO LD-CURRENT\r\n   362\t           WRITE OUT-REC FROM L-DISC\r\n   363\t           MOVE ARREARS TO LX-ARREARS\r\n   364\t           MOVE WS-INTEREST TO LX-INTEREST\r\n   365\t          "]
[16.95234, "o", " MOVE PAID TO LX-PAID\r\n   366\t           WRITE OUT-REC FROM L-ARR\r\n   367\t           MOVE WS-BALANCE TO LL-BALANCE\r\n   368\t           MOVE WS-DUE TO LL-DUE\r\n   369\t           WRITE OUT-REC FROM L-BAL\r\n   370\t           IF WS-BALANCE < 0\r\n   371\t               MOVE WS-CARRY TO LY-CARRY\r\n   372\t               WRITE OUT-REC FROM L-CARRY\r\n   373\t           END-IF\r\n   374\t           MOVE SPACES TO OUT-REC\r\n   375\t           WRITE OUT-REC.\r\n   376\t\r\n   377\t       WRITE-TOTALS.\r\n   378\t           MOVE WS-BILLED TO LT-BILLED\r\n   379\t           MOVE WS-REJECTED TO LT-REJECTED\r\n   380\t           MOVE WS-CREDITS TO LT-CREDITS\r\n   381\t           WRITE OUT-REC FROM L-TOT1\r\n   382\t           MOVE WS-TOT-UNITS TO LT-UNITS\r\n   383\t           MOVE WS-TOT-CURRENT TO LT-CURRENT\r\n   384\t           WRITE OUT-REC FROM L-TOT2\r\n   385\t           IF WS-BILLED > 0\r\n   386\t               DIVIDE WS-TOT-CURRENT BY WS-BILLED\r\n   387\t                   GIVING WS-AVERAGE ROUNDED\r\n   388\t           END-IF\r\n   389\t           MOVE WS-TOT-DUE T"]
[16.952344, "o", "O LT-DUE\r\n   390\t           MOVE WS-AVERAGE TO LT-AVERAGE\r\n   391\t           WRITE OUT-REC FROM L-TOT3\r\n   392\t           MOVE WS-TOT-NET TO LT-NET\r\n   393\t           WRITE OUT-REC FROM L-TOT4.\r\n   394\t\r\n   395\t       POST-PAYMENTS.\r\n   396\t           MOVE SPACES TO OUT-REC\r\n   397\t           WRITE OUT-REC\r\n   398\t           WRITE OUT-REC FROM L-LEDGER\r\n   399\t           OPEN INPUT PAY-IN\r\n   400\t           PERFORM READ-PAY\r\n   401\t           PERFORM UNTIL END-OF-PAY\r\n   402\t               ADD 1 TO WS-LINE-NO\r\n   403\t               PERFORM ONE-PAYMENT\r\n   404\t               PERFORM READ-PAY\r\n   405\t           END-PERFORM\r\n   406\t           CLOSE PAY-IN\r\n   407\t           MOVE WS-APPLIED TO LV-APPLIED\r\n   408\t           MOVE WS-PAY-REJECTED TO LV-REJECTED\r\n   409\t           MOVE WS-TOT-PAID TO LV-PAID\r\n   410\t           MOVE WS-TOT-OTHER TO LV-OTHER\r\n   411\t           WRITE OUT-REC FROM L-PAYTOT.\r\n   412\t\r\n   413\t       READ-PAY.\r\n   414\t           READ PAY-IN INTO PAY-LINE\r\n   415\t               AT END SET EN"]
[16.952349, "o", "D-OF-PAY TO TRUE\r\n   416\t           END-READ.\r\n   417\t\r\n   418\t       ONE-PAYMENT.\r\n   419\t           MOVE 0 TO PL-FIELDS PL-ACCT-LEN\r\n   420\t           UNSTRING PAY-LINE DELIMITED BY \";\"\r\n"]
