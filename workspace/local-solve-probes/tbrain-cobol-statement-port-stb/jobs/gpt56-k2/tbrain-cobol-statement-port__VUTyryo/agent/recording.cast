[16.322313, "o", "     1\t       IDENTIFICATION DIVISION.\r\n     2\t       PROGRAM-ID. WBILL.\r\n     3\t      *----------------------------------------------------------------\r\n     4\t      * WBILL - QUARTERLY WATER STATEMENT RUN.\r\n     5\t      * READS THE METER-READING FILE (CUSTIN) AND WRITES THE PRINTED\r\n     6\t      * STATEMENT FILE (STMTOUT).  ONE HEADER RECORD, THEN ONE RECORD\r\n"]
[16.32232, "o", "     7\t      * PER ACCOUNT.  THEN POSTS THE PAYMENTS AND ADJUSTMENTS FILE\r\n     8\t      * (PAYIN) AGAINST THE NEW BALANCES AND PRINTS THE LEDGER.\r\n"]
[16.322327, "o", "     9\t      *----------------------------------------------------------------\r\n    10\t       ENVIRONMENT DIVISION.\r\n    11\t       INPUT-OUTPUT SECTION.\r\n    12\t       FILE-CONTROL.\r\n"]
[16.322332, "o", "    13\t           SELECT CUST-IN  ASSIGN TO CUSTIN\r\n    14\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n    15\t           SELECT STMT-OUT ASSIGN TO STMTOUT\r\n"]
[16.322335, "o", "    16\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n"]
[16.322705, "o", "    17\t           SELECT PAY-IN   ASSIGN TO PAYIN\r\n    18\t               ORGANIZATION IS LINE SEQUENTIAL.\r\n"]
[16.322719, "o", "    19\t       DATA DIVISION.\r\n    20\t       FILE SECTION.\r\n    21\t       FD  CUST-IN.\r\n    22\t       01  IN-REC                    PIC X(80).\r\n    23\t       FD  STMT-OUT.\r\n    24\t       01  OUT-REC                   PIC X(72).\r\n    25\t       FD  PAY-IN.\r\n    26\t       01  PAY-REC                   PIC X(80).\r\n    27\t       WORKING-STORAGE SECTION.\r\n    28\t       COPY \"CUSTREC.cpy\".\r\n    29\t       COPY \"TARIFFS.cpy\".\r\n    30\t       01  WS-FLAGS.\r\n    31\t           05  WS-EOF                PIC X VALUE \"N\".\r\n    32\t               88  END-OF-INPUT      VALUE \"Y\".\r\n    33\t           05  WS-PAY-EOF            PIC X VALUE \"N\".\r\n    34\t               88  END-OF-PAY        VALUE \"Y\".\r\n    35\t       01  ACCT-TABLE.\r\n    36\t           05  AT-COUNT              PIC 9(4) VALUE 0.\r\n    37\t           05  AT-ENTRY OCCURS 1 TO 999 TIMES\r\n    38\t                   DEPENDING ON AT-COUNT INDEXED BY AX.\r\n    39\t               10  AT-ACCT           PIC X(8).\r\n    40\t               10  AT-BAL            PIC S9(9)V99.\r\n    41\t     "]
[16.322729, "o", "  01  PAY-WORK.\r\n    42\t           05  PAY-LINE              PIC X(80).\r\n    43\t           05  PL-ACCT               PIC X(8)  VALUE SPACES.\r\n    44\t           05  PL-KIND               PIC X(3)  VALUE SPACES.\r\n    45\t               88  KIND-PAY          VALUE \"PAY\".\r\n    46\t               88  KIND-ADJ          VALUE \"ADJ\".\r\n    47\t               88  KIND-FEE          VALUE \"FEE\".\r\n    48\t               88  KIND-REF          VALUE \"REF\".\r\n    49\t           05  PL-AMT-TXT            PIC X(16) VALUE SPACES.\r\n    50\t           05  PL-MEMO               PIC X(30) VALUE SPACES.\r\n    51\t           05  PL-FIELDS             PIC 99.\r\n    52\t           05  PL-ACCT-LEN           PIC 99.\r\n    53\t           05  WS-LINE-NO            PIC 9(3)  VALUE 0.\r\n    54\t           05  WS-AMT                PIC S9(7)V99.\r\n    55\t           05  WS-WHOLE              PIC S9(7).\r\n    56\t           05  WS-PART               PIC S9(7)V99.\r\n    57\t           05  WS-REM                PIC S9(3)V99.\r\n    58\t           05  WS-APPLIED        "]
[16.322742, "o", "    PIC 9(3)  VALUE 0.\r\n    59\t           05  WS-PAY-REJECTED       PIC 9(3)  VALUE 0.\r\n    60\t           05  WS-TOT-PAID           PIC S9(9)V99 VALUE 0.\r\n    61\t           05  WS-TOT-OTHER          PIC S9(9)V99 VALUE 0.\r\n    62\t       01  WS-WORK.\r\n    63\t           05  WS-UNITS              PIC 9(7).\r\n    64\t           05  WS-TEMP               PIC 9(7).\r\n    65\t           05  WS-LIM1               PIC 9(5)V9.\r\n    66\t           05  WS-LIM2               PIC 9(5)V9.\r\n    67\t           05  WS-B1                 PIC 9(5)V9.\r\n    68\t           05  WS-B2                 PIC 9(5)V9.\r\n    69\t           05  WS-B3                 PIC 9(7)V9.\r\n    70\t           05  WS-C1                 PIC 9(6)V99.\r\n    71\t           05  WS-C2                 PIC 9(6)V99.\r\n    72\t           05  WS-C3                 PIC 9(7)V99.\r\n    73\t           05  WS-USAGE              PIC 9(7)V99.\r\n    74\t           05  WS-STANDING           PIC 9(5)V99.\r\n    75\t           05  WS-DISCOUNT           PIC 9(6)V99.\r\n    76\t           05  WS-NET   "]
[16.322854, "o", "             PIC 9(7)V99.\r\n    77\t           05  WS-VAT                PIC 9(6)V99.\r\n    78\t           05  WS-CURRENT            PIC 9(7)V99.\r\n    79\t           05  WS-INTEREST           PIC 9(5)V99.\r\n    80\t           05  WS-BALANCE            PIC S9(7)V99.\r\n    81\t           05  WS-CARRY              PIC S9(7)V99.\r\n    82\t           05  WS-DUE                PIC 9(7)V99.\r\n    83\t           05  WS-NAME               PIC X(24).\r\n    84\t           05  WS-NAME-OUT           PIC X(24).\r\n    85\t           05  WS-REASON             PIC X(20).\r\n    86\t           05  WS-DATE-DMY           PIC 9(8).\r\n    87\t       01  WS-TOTALS.\r\n    88\t           05  WS-BILLED             PIC 9(3)    VALUE 0.\r\n    89\t           05  WS-REJECTED           PIC 9(3)    VALUE 0.\r\n    90\t           05  WS-CREDITS            PIC 9(3)    VALUE 0.\r\n    91\t           05  WS-TOT-UNITS          PIC 9(11)   VALUE 0.\r\n    92\t           05  WS-TOT-CURRENT        PIC 9(11)V99 VALUE 0.\r\n    93\t           05  WS-TOT-DUE            PIC 9(11)V99 VALUE "]
[16.322865, "o", "0.\r\n    94\t           05  WS-TOT-NET            PIC S9(11)V99 VALUE 0.\r\n    95\t           05  WS-AVERAGE            PIC 9(9)V99 VALUE 0.\r\n    96\t       01  L-HEAD.\r\n    97\t           05  FILLER                PIC X(15) VALUE \"STATEMENTS FOR \".\r\n    98\t           05  LH-REGION             PIC X(20).\r\n    99\t           05  FILLER                PIC X(7)  VALUE \" DATED \".\r\n   100\t           05  LH-DATE               PIC 99/99/9999.\r\n   101\t       01  L-ACCT.\r\n   102\t           05  FILLER                PIC X(8)  VALUE \"ACCOUNT \".\r\n   103\t           05  LA-MASK               PIC X(4)  VALUE \"****\".\r\n   104\t           05  LA-TAIL               PIC X(4).\r\n   105\t           05  FILLER                PIC X(2)  VALUE SPACES.\r\n   106\t           05  LA-NAME               PIC X(24).\r\n   107\t           05  FILLER                PIC X(8)  VALUE \" TARIFF \".\r\n   108\t           05  LA-TARIFF             PIC X.\r\n   109\t       01  L-READ.\r\n   110\t           05  FILLER                PIC X(9)  VALUE \"READINGS \".\r\n   111\t        "]
[16.322944, "o", "   05  LR-PREV               PIC ZZZZZ9.\r\n   112\t           05  FILLER                PIC X(4)  VALUE \" TO \".\r\n   113\t           05  LR-CURR               PIC ZZZZZ9.\r\n   114\t           05  FILLER                PIC X(8)  VALUE \"  USAGE \".\r\n   115\t           05  LR-UNITS              PIC Z,ZZZ,ZZ9.\r\n   116\t           05  FILLER                PIC X(6)  VALUE \" OVER \".\r\n   117\t           05  LR-DAYS               PIC ZZ9.\r\n   118\t           05  FILLER                PIC X(5)  VALUE \" DAYS\".\r\n   119\t       01  L-BANDS.\r\n   120\t           05  FILLER                PIC X(6)  VALUE \"BANDS \".\r\n   121\t           05  LB-1                  PIC ZZ,ZZ9.9.\r\n   122\t           05  FILLER                PIC X     VALUE SPACE.\r\n   123\t           05  LB-2                  PIC ZZ,ZZ9.9.\r\n   124\t           05  FILLER                PIC X     VALUE SPACE.\r\n   125\t           05  LB-3                  PIC Z,ZZZ,ZZ9.9.\r\n   126\t       01  L-CHARGE.\r\n   127\t           05  FILLER                PIC X(13) VALUE \"USAGE CHARGE \".\r\n   128"]
[16.322957, "o", "\t           05  LC-USAGE              PIC $$,$$$,$$9.99.\r\n   129\t           05  FILLER                PIC X(10) VALUE \"  STANDING\".\r\n   130\t           05  LC-STANDING           PIC $$$,$$9.99.\r\n   131\t       01  L-DISC.\r\n   132\t           05  FILLER                PIC X(9)  VALUE \"DISCOUNT \".\r\n   133\t           05  LD-DISCOUNT           PIC ZZ,ZZ9.99 BLANK WHEN ZERO.\r\n   134\t           05  FILLER                PIC X(5)  VALUE \"  VAT\".\r\n   135\t           05  LD-VAT                PIC ZZZ,ZZ9.99.\r\n   136\t           05  FILLER                PIC X(9)  VALUE \"  CURRENT\".\r\n   137\t           05  LD-CURRENT            PIC $$$,$$9.99.\r\n   138\t       01  L-ARR.\r\n   139\t           05  FILLER                PIC X(8)  VALUE \"ARREARS \".\r\n   140\t           05  LX-ARREARS            PIC ++,+++,++9.99.\r\n"]
