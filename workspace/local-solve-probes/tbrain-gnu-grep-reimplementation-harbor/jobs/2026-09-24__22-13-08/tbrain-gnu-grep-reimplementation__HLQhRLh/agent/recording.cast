[344.950481, "i", " o['binary'] == 'without-match': recs=[]\n        else: recs = records(data, sep)\n        # GNU uses the potential input ranges to align -T numeric fields.\n        o['_nw'] = len(str(max(1, len(recs))))\n        o['_bw'] = len(str(max(0, len(data) - 1)))\n        selected, mm = [], {}\n\"\"\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pygrep/grep.py\ncd /tmp\npython3 /app/pygrep/grep.py -n '\\(ab\\)\\1' cases; echo backref:$?\npython3 /app/pygrep/grep.py -w -n '\\(ab\\)\\1' cases; echo word_backref:$?\npython3 - <<'PY'\nwith open('/tmp/long','wb') as f:\n for i in range(1,106): f.write(('foo %d\\n'%i).encode())\nPY\npython3 /app/pygrep/grep.py -nTb -m2 foo long | od -An -tc\npython3 /app/pygrep/grep.py -n -C1 --group-separator='SEP' 'foo 1$\\|foo 5$' long | head -12\npython3 /app/pygrep/grep.py -F -e 'foo 1' -e 'foo 2' -c long; echo fixed:$?\npython3 /app/pygrep/grep.py nomatch long >/dev/null; echo no_match:$?\npython3 /app/pygrep/grep.py foo long >/dev/null; echo match:$?\npython3 /app/pygrep/grep.py '[' long >/dev/null 2>/de"]
[344.95167, "o", "\u001b[?2004h> p='/app/pygrep/grep.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"if o['line']: p += str(lineno).encode() + delim\\n        if o['byte']: p += str(off).encode() + delim\", \"if o['line']:\\n            v = str(lineno).encode()\\n            if o['tab']: v = v.rjust(o.get('_nw', len(v)))\\n            p += v + delim\\n        if o['byte']:\\n            v = str(off).encode()\\n            if o['tab']: v = v.rjust(o.get('_bw', len(v)))\\n            p += v + delim\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"if o['line']: parts.append(str(lineno).encode())\\n        if o['byte']: parts.append(str(off).encode())\", \"if o['line']:\\n            v = str(lineno).encode()\\n            parts.append(v.rjust(o.get('_nw', len(v))) if o['tab'] else v)\\n        if o['byte']:\\n            v = str(off).encode()\\n            parts.append(v.rjust(o.get('_bw', len(v))) if o['tab'] else v)\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
