[207.039157, "i", "ses; echo multi:$?\nprintf 'foo\\nbar\\n' > pats; python3 /app/pygrep/grep.py -f pats -c cases; echo patfile:$?\npython3 /app/pygrep/grep.py -z -n foo nul | od -An -tx1c; echo z:${PIPESTATUS[0]}\npython3 /app/pygrep/grep.py foo binary >/tmp/binout 2>/dev/null; st=$?; wc -c </tmp/binout; echo binary_status:$st\npython3 /app/pygrep/grep.py -a -n foo binary | od -An -tx1c\npython3 /app/pygrep/grep.py -I foo binary; echo I_status:$?\npython3 /app/pygrep/grep.py -m -1 foo cases; echo minfinity:$?\npython3 /app/pygrep/grep.py foo no-such-file cases >/tmp/errmix 2>/dev/null; st=$?; cat /tmp/errmix; echo error_status:$st\n"]
