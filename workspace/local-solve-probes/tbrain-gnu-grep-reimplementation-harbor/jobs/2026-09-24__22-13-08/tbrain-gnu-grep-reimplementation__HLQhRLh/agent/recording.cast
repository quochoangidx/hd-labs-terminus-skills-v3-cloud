[344.949446, "i", "python3 - <<'PY'\np='/app/pygrep/grep.py'\ns=open(p).read()\ns=s.replace(\"if o['line']: p += str(lineno).encode() + delim\\n        if o['byte']: p += str(off).encode() + delim\", \"if o['line']:\\n            v = str(lineno).encode()\\n            if o['tab']: v = v.rjust(o.get('_nw', len(v)))\\n            p += v + delim\\n        if o['byte']:\\n            v = str(off).encode()\\n            if o['tab']: v = v.rjust(o.get('_bw', len(v)))\\n            p += v + delim\")\ns=s.replace(\"if o['line']: parts.append(str(lineno).encode())\\n        if o['byte']: parts.append(str(off).encode())\", \"if o['line']:\\n            v = str(lineno).encode()\\n            parts.append(v.rjust(o.get('_nw', len(v))) if o['tab'] else v)\\n        if o['byte']:\\n            v = str(off).encode()\\n            parts.append(v.rjust(o.get('_bw', len(v))) if o['tab'] else v)\")\ns=s.replace(\"\"\"        if binary and o['binary'] == 'without-match': recs=[]\n        else: recs = records(data, sep)\n        selected, mm = [], {}\n\"\"\", \"\"\"        if binary and"]
