[271.10488, "i", "python3 - <<'PY'\np='/app/pygrep/grep.py'\ns=open(p).read()\ns=s.replace('def __init__(self, pat, extended, icase):\\n        self.mem', 'def __init__(self, pat, extended, icase, newline=True):\\n        self.mem')\ns=s.replace(\"flags = (1 if extended else 0) | (2 if icase else 0) | 4  # EXTENDED, ICASE, NEWLINE\", \"flags = (1 if extended else 0) | (2 if icase else 0) | (4 if newline else 0)\")\ns=s.replace(\"self.regex=[Regex(p,o.mode=='E',o.icase) for p in o.pats]\", \"self.regex=[Regex(p,o.mode=='E',o.icase,not o.zero) for p in o.pats]\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pygrep/grep.py\nprintf 'a\\nb\\0c\\0' | python3 /app/pygrep/grep.py -z -x 'a.b' | od -An -tx1\n"]
