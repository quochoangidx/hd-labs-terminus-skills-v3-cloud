[18.493924, "o", "# pygrep\r\n\r\nA pure-Python replacement for GNU grep 3.8, for the minimal images that ship\r\nwithout grep.\r\n\r\n- `pygrep/grep.py` — the command (`python3 /app/pygrep/grep.py ...`)\r\n- `docs/grep.txt` — the GNU grep manual\r\n"]
