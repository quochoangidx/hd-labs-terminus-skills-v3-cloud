"""pybc: a GNU bc 1.07.1 replacement in pure Python.

Usage: python3 /app/pybc/bc.py [FILE]...
"""

import sys


def main(argv):
    sys.stderr.write("pybc: not implemented yet\n")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
