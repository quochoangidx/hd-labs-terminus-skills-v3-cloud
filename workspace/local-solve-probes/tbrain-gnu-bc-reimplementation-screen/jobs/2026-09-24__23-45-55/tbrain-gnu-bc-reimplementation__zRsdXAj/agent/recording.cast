[246.159125, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'; s=open(p).read()\ns=s.replace(\"import sys, math\\n\", \"import sys, math\\nsys.setrecursionlimit(100000)\\nif hasattr(sys, 'set_int_max_str_digits'): sys.set_int_max_str_digits(0)\\n\")\nold=\"\"\"        if k in ('block','topblock'):\n            for x in s[1]: self.execstmt(x)\n\"\"\"\nnew=\"\"\"        if k in ('block','topblock'):\n            if k=='topblock':\n                for x in s[1]:\n                    if x[0]=='define': self.stmt(x)\n            for x in s[1]:\n                if not (k=='topblock' and x[0]=='define'): self.execstmt(x)\n\"\"\"\nassert old in s; s=s.replace(old,new)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pybc/bc.py\npython3 /app/pybc/bc.py <<'EOF'\nobase=20\n399\n.5\n-.25\nobase=16\n255\n.5\nobase=10\nscale=4\n1/3\n2.50*3\nscale(1.2300)\nlength(.000001)\n/* block\ncomment */ 4+5 # line comment\nif(0) print \"bad\" else print \"if-ok\\n\"\ni=0;while(i<5){i++;if(i==3)break;print i}\nprint \"\\n\"\nunknown(); define unknown() { return(42); }\nunknown()\nEOF\npython3 /app/pybc/bc.py <<'EOF'\n10"]
