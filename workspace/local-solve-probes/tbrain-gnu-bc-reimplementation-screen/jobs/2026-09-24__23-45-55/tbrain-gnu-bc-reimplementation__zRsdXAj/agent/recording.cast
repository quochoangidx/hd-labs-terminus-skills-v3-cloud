[181.966026, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'; s=open(p).read()\ns=s.replace(\"ch in 'ABCDEF'\", \"ch in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\")\ns=s.replace(\"s[i+1] in 'ABCDEF'\", \"s[i+1] in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\")\ns=s.replace(\"s[j] in 'ABCDEF'\", \"s[j] in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\")\n# Program parser: make newline-delimited top-level execution blocks.\nold=\"\"\"    def program(self):\n        a=[]; self.seps()\n        try:\n            while not self.peek('EOF'):\n                a.append(self.stmt()); self.seps()\n        except QuitParse: pass\n        return a\n\"\"\"\nnew=\"\"\"    def program(self):\n        blocks=[]; cur=[]\n        while self.peek('NL') or self.peek(';'): self.i+=1\n        try:\n            while not self.peek('EOF'):\n                cur.append(self.stmt())\n                saw_nl=False\n                while self.peek('NL') or self.peek(';'):\n                    if self.peek('NL'): saw_nl=True\n                    self.i+=1\n                if saw_nl:\n                    blocks.append(('topblock',cur)); cur=[]\n        e"]
