[119.822021, "i", "python3 - <<'PY'\nimport sys\nsys.path.insert(0,'/app/pybc')\nimport bc\ns='''1+2\nscale=3\n1/8\n2.50*3\n-2^2\n2^3^2\nibase=16\nA+F\nobase=16\n255\nobase=10\nfor(i=0;i<4;i++) print i,\":\"\nprint \" done\\\\\\\\n\"\ndefine f(n) { if(n<=1) return(1); return(n*f(n-1)); }\nf(6)\na[2]=9\ndefine g(*x[]) { x[2]+=1; }\ng(a[])\na[2]\n1/0\n77\n'''\nfor n in range(1,len(s.splitlines())+1):\n x='\\n'.join(s.splitlines()[:n])+'\\n'\n try: bc.Parser(bc.Lexer(x).run()).program()\n except Exception as e:\n  print('FAIL line prefix',n,repr(s.splitlines()[n-1]),repr(e))\n  ts=bc.Lexer(x).run(); print([(t.k,t.v,t.line) for t in ts[-20:]])\n  break\nelse: print('all parsed')\nPY\n"]
