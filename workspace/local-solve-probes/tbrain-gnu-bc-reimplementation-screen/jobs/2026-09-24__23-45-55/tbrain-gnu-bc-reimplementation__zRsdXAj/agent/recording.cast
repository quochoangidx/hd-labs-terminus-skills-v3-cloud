[12.020943, "o", "# pybc\r\n\r\nA pure-Python replacement for GNU bc 1.07.1, for the minimal images that ship\r\nwithout bc.\r\n\r\n- `pybc/bc.py` — the command (`python3 /app/pybc/bc.py [FILE]...`)\r\n- `docs/bc.txt` — the GNU bc manual page\r\n"]
[12.021304, "o", "\"\"\"pybc: a GNU bc 1.07.1 replacement in pure Python.\r\n\r\nUsage: python3 /app/pybc/bc.py [FILE]...\r\n\"\"\"\r\n\r\nimport sys\r\n\r\n\r\ndef main(argv):\r\n    sys.stderr.write(\"pybc: not implemented yet\\n\")\r\n    return 1\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main(sys.argv[1:]))\r\n"]
[12.022754, "o", "26:   OPTIONS\r\n48:   NUMBERS\r\n60:   VARIABLES\r\n78:   COMMENTS\r\n91:   EXPRESSIONS\r\n278:   STATEMENTS\r\n"]
[12.023094, "o", "399:   PSEUDO STATEMENTS\r\n413:   FUNCTIONS\r\n502:   MATH LIBRARY\r\n521:   EXAMPLES\r\n596:   READLINE AND LIBEDIT OPTIONS\r\n610:   DIFFERENCES\r\n"]
[12.02312, "o", "727:   LIMITS\r\n"]
[12.023694, "o", "\u001b[?2004hroot@bb2837eefcbd:/app# "]
