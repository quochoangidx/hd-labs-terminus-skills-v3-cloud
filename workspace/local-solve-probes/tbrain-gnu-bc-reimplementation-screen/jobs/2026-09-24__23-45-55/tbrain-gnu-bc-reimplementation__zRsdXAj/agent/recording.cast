[328.04979, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'; s=open(p).read()\n# Calls evaluated as expressions require a value.\ns=s.replace(\"if k=='call': return self.call(e[1],e[2])\", \"if k=='call':\\n            if e[1] in self.funcs and self.funcs[e[1]][3]: raise RuntimeError()\\n            return self.call(e[1],e[2])\")\n# A standalone void call is legal and executes without obtaining a value.\nold=\"\"\"        elif k=='expr':\n            v=self.eval(s[1])\n            if not s[2] and not (s[1][0]=='call' and self.funcs.get(s[1][1],(None,None,None,False))[3]): self.printnum(v,True)\n\"\"\"\nnew=\"\"\"        elif k=='expr':\n            isvoid = s[1][0]=='call' and s[1][1] in self.funcs and self.funcs[s[1][1]][3]\n            if isvoid:\n                self.call(s[1][1],s[1][2])\n            else:\n                v=self.eval(s[1])\n                if not s[2]: self.printnum(v,True)\n\"\"\"\nassert old in s; s=s.replace(old,new)\n# Argument expressions run before function-entry ibase is captured.\ns=s.replace(\"        callbase=self.integer(self.ivar('iba"]
