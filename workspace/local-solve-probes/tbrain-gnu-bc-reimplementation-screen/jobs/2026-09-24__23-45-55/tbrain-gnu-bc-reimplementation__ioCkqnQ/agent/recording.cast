[185.555778, "i", "       return blocks\n            if saw_nl:\n                blocks.append(cur); cur=[]\n        if cur: blocks.append(cur)\n        return blocks\n    def hasquit(self,x):\n        if isinstance(x,tuple):\n            if x and x[0]=='quit': return True\n            return any(self.hasquit(q) for q in x[1:])\n        if isinstance(x,list): return any(self.hasquit(q) for q in x)\n        return False\n\"\"\"\nassert old in s\ns=s.replace(old,new)\ns=s.replace(\"        if t=='ID' and v=='quit': raise QuitSig()\", \"        if t=='ID' and v=='quit': self.take(); return ('quit',)\")\ns=s.replace(\"if self.typ() in ('=','+=','-=','*=','/=','%=','^='):\", \"if self.typ() in ('=','+=','-=','*=','/=','%=','^=','=+','=-','=*','=/','=%','=^'):\")\ns=s.replace(\"            if op!='=': rhs=self.binary(op[0],self.refget(x[2]).copy(),rhs)\", \"            if op!='=': rhs=self.binary(op[0] if op[0]!='=' else op[1],self.refget(x[2]).copy(),rhs)\")\noldidx=\"\"\"        if v.c<0 or (v.s and v.c % 10**v.s): raise BCError('bad index')\n        i=v.integer()\n\"\""]
