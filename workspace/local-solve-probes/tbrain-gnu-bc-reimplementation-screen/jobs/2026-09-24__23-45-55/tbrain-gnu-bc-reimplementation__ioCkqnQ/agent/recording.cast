[234.681257, "o", "514 /app/pybc/bc.py\r\n"]
[234.681911, "o", "def main(argv):\r\n    chunks=[]\r\n    try:\r\n        for f in argv:\r\n            with open(f,encoding='latin1') as h: chunks.append(h.read())\r\n        chunks.append(sys.stdin.read())\r\n    except OSError as e:\r\n        sys.stderr.write(str(e)+'\\n'); return 1\r\n    src=''.join(chunks); eng=Engine()\r\n    try: prog=Parser(src).program()\r\n    except QuitSig: return 0\r\n    except BCError as e: return 0\r\n    try:\r\n        # A runtime error abandons the entire newline execution block.\r\n        for block in prog:\r\n            try: eng.run(block)\r\n            except BCError: continue\r\n    except (HaltSig,QuitSig): pass\r\n    return 0\r\nif __name__=='__main__': sys.exit(main(sys.argv[1:]))\r\n"]
[234.682093, "o", "\u001b[?2004hroot@4b378062c874:/app# "]
[270.387865, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'\ns=open(p).read()\nold=\"\"\"    def refget(self,x):\n        if x[0]=='var': return self.getv(x[1])\n        return self.geta(x[1]).get(self.idx(x[2]),Num(0))\n    def refset(self,x,v):\n        if x[0]=='var': return self.setv(x[1],v)\n        a=self.geta(x[1]); a[self.idx(x[2])]=v.copy(); return v\n\"\"\"\nnew=\"\"\"    def resolve(self,x):\n        if x[0]=='var': return ('v',x[1])\n        return ('a',self.geta(x[1]),self.idx(x[2]))\n    def resolved_get(self,r):\n        return self.getv(r[1]) if r[0]=='v' else r[1].get(r[2],Num(0))\n    def resolved_set(self,r,v):\n        if r[0]=='v': return self.setv(r[1],v)\n        r[1][r[2]]=v.copy(); return v\n    def refget(self,x): return self.resolved_get(self.resolve(x))\n    def refset(self,x,v): return self.resolved_set(self.resolve(x),v)\n\"\"\"\nassert old in s\ns=s.replace(old,new)\ns=s.replace(\"            old=self.refget(x[2]).copy(); new=add(old,Num(1),x[1]=='--'); self.refset(x[2],new)\\n\", \"            ref=self.resolve(x[2]); old=self.resolved_ge"]
[270.388232, "i", "t(ref).copy()\\n            new=add(old,Num(1),x[1]=='--'); self.resolved_set(ref,new)\\n\")\noldassign=\"\"\"        if k=='assign':\n            rhs=self.ev(x[3]); op=x[1]\n            if rhs is None: raise BCError('void value')\n            if op!='=': rhs=self.binary(op[0] if op[0]!='=' else op[1],self.refget(x[2]).copy(),rhs)\n            self.refset(x[2],rhs); return rhs.copy()\n\"\"\"\nnewassign=\"\"\"        if k=='assign':\n            ref=self.resolve(x[2])\n            rhs=self.ev(x[3]); op=x[1]\n            if rhs is None: raise BCError('void value')\n            if op!='=':\n                oper=op[0] if op[0]!='=' else op[1]\n                rhs=self.binary(oper,self.resolved_get(ref).copy(),rhs)\n            self.resolved_set(ref,rhs); return rhs.copy()\n\"\"\"\nassert oldassign in s\ns=s.replace(oldassign,newassign)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pybc/bc.py\npython3 /app/pybc/bc.py <<'EOF'\ni=0\na[0]=10\na[i++] += 5\ni\na[0]\ni=0\na[i++]++\ni\na[0]\ni=0\na[i++]=i\ni\na[0]\nEOF\n"]
[270.394876, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/pybc/bc.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> old=\"\"\"    def refget(self,x):\r\n\u001b[?2004l\r\u001b[?2004h>         if x[0]=='var': return self.getv(x[1])\r\n\u001b[?2004l\r\u001b[?2004h>         return self.geta(x[1]).get(self.idx(x[2]),Num(0))\r\n\u001b[?2004l\r\u001b[?2004h>     def refset(self,x,v):\r\n\u001b[?2004l\r\u001b[?2004h>         if x[0]=='var': return self.setv(x[1],v)\r\n\u001b[?2004l\r\u001b[?2004h>         a=self.geta(x[1]); a[self.idx(x[2])]=v.copy(); return v\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> new=\"\"\"    def resolve(self,x):\r\n\u001b[?2004l\r\u001b[?2004h>         if x[0]=='var': return ('v',x[1])\r\n\u001b[?2004l\r\u001b[?2004h>         return ('a',self.geta(x[1]),self.idx(x[2]))\r\n\u001b[?2004l\r\u001b[?2004h>     def resolved_get(self,r):\r\n\u001b[?2004l\r\u001b[?2004h>         return self.getv(r[1]) if r[0]=='v' else r[1].get(r[2],Num(0))\r\n\u001b[?2004l\r\u001b[?2004h>     def resolved_set(self,r,v):\r\n\u001b[?2004l\r\u001b[?2004h>         if r[0]=='v': return self.setv(r[1],v)\r\n\u001b[?2004l\r\u001b[?2004h>         r[1][r[2]]=v.copy(); return v\r\n\u001b[?200"]
[270.394917, "o", "4l\r\u001b[?2004h>     def refget(self,x): return self.resolved_get(self.resolve(x))\r\n\u001b[?2004l\r\u001b[?2004h>     def refset(self,x,v): return self.resolved_set(self.resolve(x),v)\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> assert old in s\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"            old=self.refget(x[2]).copy(); new=add(old,Num(1),x[1]=='--'); self.refset(x[2],new)\\n\", \"            ref=self.resolve(x[2]); old=self.resolved_get(ref).copy()\\n            new=add(old,Num(1),x[1]=='--'); self.resolved_set(ref,new)\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> oldassign=\"\"\"        if k=='assign':\r\n\u001b[?2004l\r\u001b[?2004h>             rhs=self.ev(x[3]); op=x[1]\r\n\u001b[?2004l\r\u001b[?2004h>             if rhs is None: raise BCError('void value')\r\n\u001b[?2004l\r\u001b[?2004h>             if op!='=': rhs=self.binary(op[0] if op[0]!='=' else op[1],self.refget(x[2]).copy(),rhs)\r\n\u001b[?2004l\r\u001b[?2004h>             self.refset(x[2],rhs); return rhs.copy()\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> newassign=\"\"\"        if k=='assign':\r\n\u001b[?200"]
[270.394938, "o", "4l\r\u001b[?2004h>             ref=self.resolve(x[2])\r\n\u001b[?2004l\r\u001b[?2004h>             rhs=self.ev(x[3]); op=x[1]\r\n\u001b[?2004l\r\u001b[?2004h>             if rhs is None: raise BCError('void value')\r\n\u001b[?2004l\r\u001b[?2004h>             if op!='=':\r\n\u001b[?2004l\r\u001b[?2004h>                 oper=op[0] if op[0]!='=' else op[1]\r\n\u001b[?2004l\r\u001b[?2004h>                 rhs=self.binary(oper,self.resolved_get(ref).copy(),rhs)\r\n\u001b[?2004l\r\u001b[?2004h>             self.resolved_set(ref,rhs); return rhs.copy()\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> assert oldassign in s\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(oldassign,newassign)\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
