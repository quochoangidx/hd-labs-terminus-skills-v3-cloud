[185.555808, "i", "\"\nnewidx=\"\"\"        if v.c<0: raise BCError('bad index')\n        # GNU bc truncates indexes >= 1, but rejects a positive fraction < 1.\n        if v.s and 0 < v.c < 10**v.s: raise BCError('bad index')\n        i=v.integer()\n\"\"\"\nassert oldidx in s\ns=s.replace(oldidx,newidx)\ns=s.replace(\"            a=self.ev(x[2]); b=self.ev(x[3]); return self.binary(x[1],a,b)\", \"            a=self.ev(x[2]); b=self.ev(x[3])\\n            if a is None or b is None: raise BCError('void value')\\n            return self.binary(x[1],a,b)\")\noldmain=\"\"\"        # Top-level statements are recoverable execution units in this parser.\n        for s in prog:\n            try: eng.exec(s)\n            except BCError: continue\n\"\"\"\nnewmain=\"\"\"        # A runtime error abandons the entire newline execution block.\n        for block in prog:\n            try: eng.run(block)\n            except BCError: continue\n\"\"\"\nassert oldmain in s\ns=s.replace(oldmain,newmain)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pybc/bc.py\n"]
