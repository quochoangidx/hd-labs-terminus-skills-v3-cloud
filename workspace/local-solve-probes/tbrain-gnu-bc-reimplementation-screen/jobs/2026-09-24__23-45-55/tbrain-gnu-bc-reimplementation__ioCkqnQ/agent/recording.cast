[7.178603, "o", "3:NAME\r\n6:SYNTAX\r\n9:DESCRIPTION\r\n26:   OPTIONS\r\n48:   NUMBERS\r\n60:   VARIABLES\r\n78:   COMMENTS\r\n91:   EXPRESSIONS\r\n278:   STATEMENTS\r\n399:   PSEUDO STATEMENTS\r\n413:   FUNCTIONS\r\n502:   MATH LIBRARY\r\n521:   EXAMPLES\r\n596:   READLINE AND LIBEDIT OPTIONS\r\n610:   DIFFERENCES\r\n727:   LIMITS\r\n757:ENVIRONMENT VARIABLES\r\n780:DIAGNOSTICS\r\n785:BUGS\r\n791:AUTHOR\r\n795:ACKNOWLEDGEMENTS\r\n"]
