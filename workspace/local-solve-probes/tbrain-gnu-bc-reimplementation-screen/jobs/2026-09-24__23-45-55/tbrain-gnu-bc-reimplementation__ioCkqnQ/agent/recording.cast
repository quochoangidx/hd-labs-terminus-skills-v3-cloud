[271.42082, "i", "python3 /app/pybc/bc.py <<'EOF'\n/* arithmetic and precision */\nscale=4\n1/7\n2.50*3.0\n2^10\nsqrt(2)\n# control and functions\ndefine fact(n) { if(n<=1) return(1); return(n*fact(n-1)); }\nfact(20)\nfor(i=0;i<5;i++) { if(i==2) continue; print i; }\nprint \"\\n\"\ndefine void mutate(*a[]) { a[3]=99; }\nmutate(q[])\nq[3]\nibase=16\nFF\nibase=A\nobase=20\n399\nprint \"\\n\"\nEOF\npython3 -m py_compile /app/pybc/bc.py\n"]
