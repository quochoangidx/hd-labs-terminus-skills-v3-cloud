[7.057406, "o", "drwxr-xr-x 1 root root 4096 Sep 24 15:08 .\r\ndrwxr-xr-x 1 root root 4096 Sep 24 16:24 ..\r\n-rw-r--r-- 1 root root  215 Sep 24 15:08 README.md\r\ndrwxr-xr-x 2 root root 4096 Sep 24 15:08 docs\r\ndrwxr-xr-x 2 root root 4096 Sep 24 15:08 pygrep\r\n\r\n/app/pygrep:\r\ntotal 12\r\ndrwxr-xr-x 2 root root 4096 Sep 24 15:08 .\r\ndrwxr-xr-x 1 root root 4096 Sep 24 15:08 ..\r\n-rw-r--r-- 1 root root  284 Sep 24 15:08 grep.py\r\n"]
