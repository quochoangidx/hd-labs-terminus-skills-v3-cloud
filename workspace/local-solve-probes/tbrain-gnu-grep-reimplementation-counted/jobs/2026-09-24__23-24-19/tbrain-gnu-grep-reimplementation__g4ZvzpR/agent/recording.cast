[266.729391, "i", "python3 - <<'PY'\np='/app/pygrep/grep.py'\ns=open(p).read()\n# All matching is byte-oriented; preserve arbitrary argv bytes one-to-one.\ns=s.replace(\"def main(argv):\\n    try: o,files=parse(argv); matcher=Matcher(o)\", \"def main(argv):\\n    argv=[os.fsencode(a).decode('latin1') for a in argv]\\n    try: o,files=parse(argv); matcher=Matcher(o)\")\ns=s.replace(\"open(v,'rb').read()\", \"open(v.encode('latin1'),'rb').read()\")\ns=s.replace(\"with open(fn,'rb') as f: data=f.read()\", \"with open(fn.encode('latin1'),'rb') as f: data=f.read()\")\nopen(p,'w').write(s)\nPY\npython3 -Werror -m py_compile /app/pygrep/grep.py\ncd /tmp\nprintf '\\300\\340\\nA\\na\\n' > ic\npython3 /app/pygrep/grep.py -Fi $'\\300' ic > out\npython3 - <<'PY'\nassert open('out','rb').read()==b'\\xc0\\xe0\\n'\nPY\nprintf 'hit\\n' > $'name-\\300'\npython3 /app/pygrep/grep.py hit $'name-\\300' > out\ncmp out <(printf 'hit\\n')\nprintf 'a\\nb\\0' > final-z\npython3 /app/pygrep/grep.py -z -x 'a.b' final-z > out\npython3 - <<'PY'\nassert open('out','rb').read()==b'a\\nb\\0'\nPY\npython3 /app/pygre"]
