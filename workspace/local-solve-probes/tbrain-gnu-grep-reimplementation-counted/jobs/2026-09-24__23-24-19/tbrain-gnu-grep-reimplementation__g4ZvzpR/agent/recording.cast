[185.185105, "i", "cd /tmp\n# -w must permit a shorter alternative when the longer one violates its right boundary.\nprintf 'a-b\\n' > w\npython3 /app/pygrep/grep.py -Ewo 'a.|a' w > out; cmp out <(printf 'a\\n')\n# An empty pattern file has no patterns, while a one-newline file has one empty pattern.\n: > pf; printf 'x\\n' > one\npython3 /app/pygrep/grep.py -f pf one > out; test $? = 1 && test ! -s out\nprintf '\\n' > pf\npython3 /app/pygrep/grep.py -f pf one > out; test $? = 0 && cmp out one\n# BRE grouping, repetition, alternation, and backreference.\nprintf 'abab\\naaab\\nac\\n' > bre\npython3 /app/pygrep/grep.py -x '\\(ab\\)\\1' bre > out; cmp out <(printf 'abab\\n')\npython3 /app/pygrep/grep.py -x 'a\\+b\\|ac' bre > out; cmp out <(printf 'aaab\\nac\\n')\n# Output-mode precedence and max count.\nprintf 'a\\na\\nz\\n' > modes\npython3 /app/pygrep/grep.py -o -c a modes > out; cmp out <(printf '2\\n')\npython3 /app/pygrep/grep.py -c -l a modes > out; cmp out <(printf 'modes\\n')\npython3 /app/pygrep/grep.py -m1 -A1 a modes > out; cmp out <(printf 'a\\na\\n')\npython"]
[185.185166, "o", "cd /tmp\r\n\u001b[?2004l\r"]
[185.18537, "i", "3 /app/pygrep/grep.py -m-2 a modes >/dev/null 2>&1; test $? = 2\n# Context groups and separators.\nprintf 'M\\nx\\nx\\nM\\n' > groups\npython3 /app/pygrep/grep.py -A1 M groups > out; cmp out <(printf 'M\\nx\\n--\\nM\\n')\npython3 /app/pygrep/grep.py -A1 --no-group-separator M groups > out; cmp out <(printf 'M\\nx\\nM\\n')\n# -T inserts a tab and aligns numeric fields to the widest relevant value.\npython3 /app/pygrep/grep.py -nT a modes > out\npython3 - <<'PY'\nassert open('out','rb').read()==b'1:\\ta\\n2:\\ta\\n'\nPY\nprintf 'extended tests passed\\n'\n"]
