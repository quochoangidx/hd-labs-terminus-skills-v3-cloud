[235.782069, "i", "python3 - <<'PY'\np='/app/pygrep/grep.py'\ns=open(p).read()\ninsert=\"\"\"\ndef ascii_fold(s):\n    return s.translate(str.maketrans('ABCDEFGHIJKLMNOPQRSTUVWXYZ',\n                                     'abcdefghijklmnopqrstuvwxyz'))\n\n\"\"\"\ns=s.replace('\\nclass Matcher:\\n', insert+'class Matcher:\\n')\ns=s.replace(\"flags=re.ASCII | (re.IGNORECASE if o.icase else 0)\", \"flags=re.ASCII | (re.IGNORECASE if o.icase else 0) | (re.DOTALL if o.zero else 0)\")\ns=s.replace(\"self.fixed.append(p.lower() if o.icase else p)\", \"self.fixed.append(ascii_fold(p) if o.icase else p)\")\ns=s.replace(\"cmp=s.lower() if self.o.icase else s\", \"cmp=ascii_fold(s) if self.o.icase else s\")\nopen(p,'w').write(s)\nPY\npython3 -Werror -m py_compile /app/pygrep/grep.py\ncd /tmp\n# Under -z, newline is data and dot matches it.\nprintf 'a\\nb\\0c\\0' > zd\npython3 /app/pygrep/grep.py -z -x 'a.b' zd > out\npython3 - <<'PY'\nassert open('out','rb').read()==b'a\\nb\\0'\nPY\n# C-locale case folding affects ASCII only.\nprintf '\\300\\340\\nA\\na\\n' > ic\npython3 /app/pygrep/grep.py -Fi "]
[235.784574, "i", "$'\\300' ic > out\npython3 - <<'PY'\nassert open('out','rb').read()==b'\\xc0\\xe0\\n'\nPY\npython3 /app/pygrep/grep.py -Fi A ic > out\npython3 - <<'PY'\nassert open('out','rb').read()==b'A\\na\\n'\nPY\n# Quiet success overrides an earlier open error; otherwise an open error returns 2.\nprintf 'yes\\n' > good\npython3 /app/pygrep/grep.py -q yes missing good >/dev/null 2>/dev/null; test $? = 0\npython3 /app/pygrep/grep.py yes missing good >/dev/null 2>/dev/null; test $? = 2\n# Binary records, counting, and offsets.\nprintf 'no\\0yes\\nno\\0yes' > bb\npython3 /app/pygrep/grep.py -c yes bb > out; cmp out <(printf '2\\n')\npython3 /app/pygrep/grep.py -abn yes bb > out\npython3 - <<'PY'\nassert open('out','rb').read()==b'1:0:no\\0yes\\n2:7:no\\0yes\\n'\nPY\n# Matcher conflicts and newline-separated pattern operands.\npython3 /app/pygrep/grep.py -E -F x good > out 2>/dev/null; test $? = 2 && test ! -s out\nprintf 'x\\ny\\nz\\n' > pats\npython3 /app/pygrep/grep.py $'x\\ny' pats > out; cmp out <(printf 'x\\ny\\n')\npython3 /app/pygrep/grep.py -e $'x\\n' pats > o"]
[235.784787, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/pygrep/grep.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> insert=\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> def ascii_fold(s):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.784798, "i", "ut; cmp out pats\n# Context groups from separate files require a separator.\nprintf 'M\\n' > ca; printf 'M\\n' > cb\npython3 /app/pygrep/grep.py -n -A1 M ca cb > out\ncmp out <(printf 'ca:1:M\\n--\\ncb:1:M\\n')\n# Final integrity checks.\nwc -l /app/pygrep/grep.py\npython3 -Werror /app/pygrep/grep.py --no-ignore-case -F x pats >/dev/null; test $? = 0\nprintf 'final tests passed\\n'\n"]
