[184.214176, "i", "python3 - <<'PY'\np='/app/pygrep/grep.py'\ns=open(p).read()\ns=s.replace(\"def split_patterns(s, file_source=False):\\n    a = s.split('\\\\n')\", \"def split_patterns(s, file_source=False):\\n    if file_source and s == '': return []\\n    a = s.split('\\\\n')\")\ns=s.replace(\"'[:punct:]': '!-/:-@[-`{-~'\", \"'[:punct:]': r'!-/:-@\\\\[-`{-~'\")\ns=s.replace(\"        if n < 0 and what != 'max-count': raise ValueError\", \"        if n < 0 and not (what == 'max-count' and n == -1): raise ValueError\")\nstart=s.index('    def span(self,s,start=0):')\nend=s.index('    def matches(self,s):', start)\nnew='''    def span(self,s,start=0):\n        \"\"\"Return the POSIX leftmost-longest match satisfying -w/-x.\"\"\"\n        cmp=s.lower() if self.o.icase else s\n        for pos in range(start,len(s)+1):\n            ends=[]\n            for p in self.fixed:\n                if cmp.startswith(p,pos): ends.append(pos+len(p))\n            for ri,r in enumerate(self.regex):\n                for e in range(len(s),pos-1,-1):\n                    rem=len(s)-e; key"]
