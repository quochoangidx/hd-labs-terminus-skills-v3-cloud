[273.896096, "i", "python3 - <<'PY'\np='/app/pysed/sed.py'; s=open(p).read()\n# Dot includes newline in sed pattern space.\ns=s.replace('re.compile(self.pattern, re.ASCII)', 're.compile(self.pattern, re.ASCII | re.DOTALL)')\ns=s.replace(\"re.escape(suffix) + r'\\\\Z)', re.ASCII)\", \"re.escape(suffix) + r'\\\\Z)', re.ASCII | re.DOTALL)\")\n# Decode documented C-style escapes in text command payloads.\nneedle=\"\"\"    def subst(self):\n\"\"\"\ninsert=\"\"\"    def textesc(self, text):\n        out=[]; i=0\n        tab={'a':'\\\\a','f':'\\\\f','n':'\\\\n','r':'\\\\r','t':'\\\\t','v':'\\\\v'}\n        while i < len(text):\n            if text[i] == '\\\\\\\\' and i+1 < len(text):\n                d=text[i+1]; i += 2\n                out.append(tab.get(d, d if d == '\\\\\\\\' else '\\\\\\\\'+d))\n            else:\n                out.append(text[i]); i += 1\n        return ''.join(out)\n\n    def subst(self):\n\"\"\"\ns=s.replace(needle,insert)\ns=s.replace(\"            elif c.op in 'aic': c.arg = self.textarg()\\n\", \"            elif c.op in 'aic': c.arg = self.textesc(self.textarg())\\n\")\n# Sup"]
[273.896171, "i", "press terminal empty match directly after a nonempty global match.\ns=s.replace(\"        out=[]; pos=0; count=0; changed=False; last_empty=-1\\n\", \"        out=[]; pos=0; count=0; changed=False; previous_nonempty_end=-1\\n\")\ns=s.replace(\"            count += 1\\n            use =\", \"            if m.start() == m.end() == previous_nonempty_end:\\n                if m.end() >= len(pat): break\\n                out.append(pat[pos]); pos += 1; previous_nonempty_end=-1\\n                continue\\n            count += 1\\n            use =\")\ns=s.replace(\"                pos=m.end()\\n                if not g: break\\n\", \"                pos=m.end()\\n                previous_nonempty_end = m.end() if m.end() > m.start() else -1\\n                if not g: break\\n\")\nopen(p,'w').write(s)\nPY\n# Add BRE positional handling with a small source-level insertion.\npython3 - <<'PY'\np='/app/pysed/sed.py'; s=open(p).read()\nold=\"\"\"        if not extended and c in '()+?|{}': out.append('\\\\\\\\' + c)\n        elif extended and c in '(){}+?|': ou"]
[273.896177, "i", "t.append(c)\n        elif c == '\\\\x00': out.append('\\\\\\\\x00')\n        else: out.append(c)\n\"\"\"\nnew=\"\"\"        if not extended and c == '^' and i != 0:\n            out.append('\\\\\\\\^')\n        elif not extended and c == '$' and i+1 != len(src):\n            # Before an escaped group close or alternation it is still an\n            # end anchor; elsewhere a BRE dollar is literal.\n            if not (i+2 < len(src) and src[i+1] == '\\\\\\\\' and src[i+2] in ')|'):\n                out.append('\\\\\\\\$')\n            else: out.append('$')\n        elif not extended and c in '()+?|{}': out.append('\\\\\\\\' + c)\n        elif extended and c in '(){}+?|': out.append(c)\n        elif c == '\\\\x00': out.append('\\\\\\\\x00')\n        else: out.append(c)\n\"\"\"\nif old not in s: print('anchor patch target not found')\nelse: s=s.replace(old,new)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pysed/sed.py\n"]
