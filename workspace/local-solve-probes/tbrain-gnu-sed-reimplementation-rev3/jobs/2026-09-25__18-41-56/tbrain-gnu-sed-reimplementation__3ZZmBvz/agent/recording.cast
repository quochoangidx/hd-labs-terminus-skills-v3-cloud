[238.644326, "o", "1281: 3.8.1 Commands Requiring a newline\r\n1285: newline:\r\n1293:           $ seq 2 | sed '1aHello ; 2d'\r\n1298:      Separate the commands using ‘-e’ or a newline:\r\n1300:           $ seq 2 | sed -e 1aHello -e 2d\r\n1304:           $ seq 2 | sed '1aHello\r\n1313:           $ seq 2 | sed '1a\\\r\n1321:      All characters following ‘#’ until the next newline are ignored.\r\n1323:           $ seq 3 | sed '# this is a comment ; 2d'\r\n1329:           $ seq 3 | sed '# this is a comment\r\n1340:           $ seq 2 | sed '1w hello.txt ; 2d'\r\n1344:           $ ls -log\r\n1348:           $ cat 'hello.txt ; 2d'\r\n1356:           $ echo x | sed '1rhello.txt ; N'\r\n1366:           $ echo a | sed '1e touch foo#bar'\r\n1369:           $ ls -1\r\n1372:           $ echo a | sed '1e touch foo ; s/a/b/'\r\n1381:      be terminated with a newline.  If whitespace, comments or\r\n1385:           $ echo a | sed 's/a/b/w1.txt#foo'\r\n1388:           $ ls -1\r\n"]
