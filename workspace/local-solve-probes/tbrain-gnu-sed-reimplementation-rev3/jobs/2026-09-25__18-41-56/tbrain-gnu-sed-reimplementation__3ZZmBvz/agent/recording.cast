[273.916431, "o", "# Add BRE positional handling with a small source-level insertion.\r\n\u001b[?2004l\r\u001b[?2004hroot@4c62d36b2fbb:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/pysed/sed.py'; s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> old=\"\"\"        if not extended and c in '()+?|{}': out.append('\\\\\\\\' + c)\r\n\u001b[?2004l\r\u001b[?2004h"]
[273.918394, "o", ">         elif extended and c in '(){}+?|': out.append(c)\r\n\u001b[?2004l\r\u001b[?2004h>         elif c == '\\\\x00': out.append('\\\\\\\\x00')\r\n\u001b[?2004l\r\u001b[?2004h>         else: out.append(c)\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> new=\"\"\"        if not extended and c == '^' and i != 0:\r\n\u001b[?2004l\r\u001b[?2004h>             out.append('\\\\\\\\^')\r\n\u001b[?2004l\r\u001b[?2004h>         elif not extended and c == '$' and i+1 != len(src):\r\n\u001b[?2004l\r\u001b[?2004h>             # Before an escaped group close or alternation it is still an\r\n\u001b[?2004l\r\u001b[?2004h>             # end anchor; elsewhere a BRE dollar is literal.\r\n\u001b[?2004l\r\u001b[?2004h>             if not (i+2 < len(src) and src[i+1] == '\\\\\\\\' and src[i+2] in ')|'):\r\n\u001b[?2004l\r\u001b[?2004h>                 out.append('\\\\\\\\$')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[273.919398, "o", "            else: out.append('$')\r\n\u001b[?2004l\r\u001b[?2004h>         elif not extended and c in '()+?|{}': out.append('\\\\\\\\' + c)\r\n\u001b[?2004l\r\u001b[?2004h>         elif extended and c in '(){}+?|': out.append(c)\r\n\u001b[?2004l\r\u001b[?2004h>         elif c == '\\\\x00': out.append('\\\\\\\\x00')\r\n\u001b[?2004l\r\u001b[?2004h>         else: out.append(c)\r\n\u001b[?2004l\r"]
[273.919669, "o", "\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s: print('anchor patch target not found')\r\n\u001b[?2004l\r\u001b[?2004h> else: s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
