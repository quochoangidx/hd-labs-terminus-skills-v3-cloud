[17.083187, "o", "# pysed\r\n\r\nA Python replacement for GNU sed 4.9, for the minimal images that ship\r\nwithout sed.\r\n\r\n- `pysed/sed.py` — the command (`python3 /app/pysed/sed.py ...`)\r\n- `docs/sed.txt` — the GNU sed manual\r\n--- sed.py ---\r\n"]
[17.091767, "o", "15 /app/pysed/sed.py\r\n"]
[17.092264, "o", "\"\"\"pysed: a GNU sed 4.9 replacement in pure Python.\r\n\r\nUsage: python3 /app/pysed/sed.py [OPTION]... {script-only-if-no-other-script} [input-file]...\r\n\"\"\"\r\n\r\nimport sys\r\n\r\n\r\ndef main(argv):\r\n    sys.stderr.write(\"pysed: not implemented yet\\n\")\r\n    return 4\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main(sys.argv[1:]))\r\n\u001b[?2004hroot@6dd744bcf04d:/app# "]
[17.561178, "i", "python3 -m py_compile /app/pysed/sed.py; file /app/docs/sed.txt /app/pysed/sed.py\n"]
[17.56238, "o", "python3 -m py_compile /app/pysed/sed.py; file /app/docs/sed.txt /app/pysed/sed.py\r\n\u001b[?2004l\r"]
