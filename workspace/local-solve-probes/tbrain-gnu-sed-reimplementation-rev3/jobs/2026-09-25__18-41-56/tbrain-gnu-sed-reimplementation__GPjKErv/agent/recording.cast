[205.342247, "i", "set -e\nS='python3 /app/pysed/sed.py'\necho '--- embedded controls remain one line ---'\nprintf 'a\\vb\\fc\\n' | $S -n '='\necho '--- dot spans N newline ---'\nprintf 'a\\nb\\n' | $S -n 'N;s/a.b/X/;p'\necho '--- text commands ---'\nprintf 'a\\nb\\n' | $S '1i BEFORE' | cat\nprintf 'a\\nb\\n' | $S '1a AFTER' | cat\nprintf 'a\\nb\\nc\\nd\\n' | $S '2,3c MID' | cat\necho '--- blocks and negation ---'\nprintf 'a\\nb\\nc\\n' | $S -n '2!{p}'\necho '--- BRE and ERE repetitions ---'\nprintf 'abbb\\nac\\n' | $S -n 's/ab\\{2,3\\}/X/p'\nprintf 'abbb\\nac\\n' | $S -E -n 's/ab{2,3}/X/p'\necho '--- numbered/global/print flags ---'\nprintf 'x x x x\\n' | $S -n 's/x/Y/2gp'\necho '--- D and P ---'\nprintf 'a\\nb\\nc\\n' | $S -n 'N;P;D'\necho '--- multiple -e pieces ---'\nprintf 'a\\n' | $S -n -e 's/a/A/' -e 'p'\necho '--- n does not cross -s boundary ---'\nprintf 'a\\n' >/tmp/one; printf 'b\\n' >/tmp/two\n$S -s -n 'n;p' /tmp/one /tmp/two\n"]
