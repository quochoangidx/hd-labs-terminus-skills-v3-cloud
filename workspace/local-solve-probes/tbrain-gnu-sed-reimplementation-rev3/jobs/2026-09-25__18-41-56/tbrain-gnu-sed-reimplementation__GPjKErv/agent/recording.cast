[103.953454, "i", "  for b in range(n,a-1,-1):\r                tail=n-b\r                try: rr=re.compile('(?:'+self.py+')(?=[\\\\s\\\\S]{'+str(tail)+'}\\\\Z)',re.ASCII)\r                except re.error: return None\r                m=rr.match(text,a)\r                if m is not None and m.end()==b: return m\r        return None\r\rclass Addr:\r    def __init__(self,kind,val=None): self.kind=kind; self.val=val\r    def hit(self,ctx):\r        if self.kind=='num': return ctx.lineno==self.val\r        if self.kind=='last': return ctx.last\r        if self.kind=='step':\r            first,step=self.val\r            return ctx.lineno>=first and (ctx.lineno-first)%step==0\r        if self.kind=='rx': return ctx.rxhit(self.val)\r        return False\r\rclass Cmd:\r    def __init__(self,a1=None,a2=None,neg=False,op='',arg=None):\r        self.a1=a1; self.a2=a2; self.neg=neg; self.op=op; self.arg=arg\r        self.active=False\r    def selected(self,ctx):\r        if not self.a1: h=True\r        elif not self.a2: h=self.a1.hit(ctx)\r        elif self.a1.kind=='n"]
