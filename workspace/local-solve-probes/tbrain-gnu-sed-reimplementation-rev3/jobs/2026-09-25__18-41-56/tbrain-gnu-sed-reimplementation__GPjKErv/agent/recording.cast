[271.293721, "i", "set -e\nS='python3 /app/pysed/sed.py'\necho '--- tilde range starts on a multiple and closes at next multiple ---'\nprintf '1\\n2\\n3\\n4\\n5\\n6\\n7\\n' | $S -n '3,~3p'\necho '--- global empty-match progression ---'\nprintf 'aaa\\nbbb\\n' | $S 's/a*/X/g'\necho '--- zero-length anchor remains replaceable ---'\nprintf 'abc\\n' | $S -n 's/^/X/gp'\necho '--- final compile and core regressions ---'\nprintf 'a\\nb\\nc\\n' | $S -n '2p;$p'\nprintf 'aa\\n' | $S -E 's/a|aa/X/'\nprintf '1\\n2\\n3\\n4\\n5\\n' | $S -n '2,+2p'\npython3 -m py_compile /app/pysed/sed.py\n"]
