[270.334025, "i", "python3 - <<'PY'\np='/app/pysed/sed.py'\ns=open(p).read()\ns=s.replace(\"elif self.a2.kind=='tilde':\\n                self.active=(ctx.lineno%self.a2.val)!=0\", \"elif self.a2.kind=='tilde':\\n                # The second address is not tested on the line matching addr1.\\n                self.active=True\")\nstart=s.index('def substitute(text,rx,rep,flags):')\nend=s.index('\\n\\nclass Context:',start)\nnew='''def substitute(text,rx,rep,flags):\n    nums=[int(x) for x in re.findall(r'\\\\d+',flags)]; nth=nums[-1] if nums else 1\n    glob='g' in flags; matches=[]; pos=0; previous_nonempty_end=None\n    while pos<=len(text):\n        m=rx.match(text,pos)\n        if not m: break\n        # sed does not replace an empty match immediately adjacent to the end\n        # of the preceding non-empty match; continue searching one byte later.\n        if m.start()==m.end() and previous_nonempty_end==m.start():\n            if m.start()>=len(text): break\n            pos=m.start()+1\n            continue\n        matches.append(m)\n        if m.end"]
[270.334239, "i", "()>m.start():\n            previous_nonempty_end=m.end(); pos=m.end()\n        else:\n            previous_nonempty_end=None; pos=m.end()+1\n    chosen=[]\n    for k,m in enumerate(matches,1):\n        if (glob and k>=nth) or (not glob and k==nth): chosen.append(m)\n    if not chosen:return text,False\n    out='';pos=0\n    for m in chosen:out+=text[pos:m.start()]+replacement(rep,m);pos=m.end()\n    return out+text[pos:],True\n'''\ns=s[:start]+new+s[end:]\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pysed/sed.py\n"]
