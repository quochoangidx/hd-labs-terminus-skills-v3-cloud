[210.628799, "o", ";self.sep=separate;self.r=records;self.h=b'';self.last_rx=None;self.last_pat=None;self.out\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"if p==b'': return self.last_rx\\n        x=RX(p,self.ext,b'I' in mods,b'M' in mods);self.last_rx=x;return x\", \"if p==b'':\\n            p=self.last_pat\\n            if p is None:return self.last_rx\\n        else:self.last_pat=p\\n        x=RX(p,self.ext,b'I' in mods,b'M' in mods);self.last_rx=x;return x\")\r\n\u001b[?2004l\r\u001b[?2004h> # Suppress the empty match directly after a nonempty match ending at the same\r\n\u001b[?2004l\r\u001b[?2004h> # offset, while retaining empty matches reached after advancing over a byte.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"out=bytearray();pos=0;count=0;changed=False;lastempty=-1\", \"out=bytearray();pos=0;count=0;changed=False;last_nonempty_end=-1\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"a,b=m[0];count+=1;take=\", \"a,b=m[0]\\n            if a==b and a==last_nonempty_end:\\n                if pos<len(ps):out.extend(ps[pos:pos+1]);pos+=1;last_nonempty_end=-1;continue\\n                break\\n    "]
[210.628805, "o", "        count+=1;take=\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[210.630721, "o", "s=s.replace(\"if take:\\n                out.extend(ps[pos:a]);out.extend(repl_expand(r,ps,m));pos=b;changed=True\", \"if take:\\n                out.extend(ps[pos:a]);out.extend(repl_expand(r,ps,m));pos=b;changed=True\\n                if b>a:last_nonempty_end=b\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
