[210.895962, "i", "S='python3 /app/pysed/sed.py'\nprintf '%s\\n' '== empty global matches =='\nprintf 'a\\nab\\nba\\n' | $S 's/a*/X/g'\nprintf 'ab\\n' | $S 's/x*/-/g'\nprintf 'aaa\\n' | $S 's/a*/X/g'\nprintf '%s\\n' '== listing boundaries =='\nprintf '1234\\t67\\n' | $S -n 'l 6'\nprintf '12345\\n' | $S -n 'l 6'\nprintf '$\\\\\\t\\n' | $S -n 'l 0'\nprintf '%s\\n' '== reused regex/modifiers =='\nprintf 'A\\na\\n' | $S -n '/a/p;//Ip'\nprintf 'A\\na\\n' | $S -n 's/a/x/;s//Y/Ip'\nprintf '%s\\n' '== blocks and negation =='\nprintf '1\\n2\\n3\\n' | $S -n '2!{=;p}'\nprintf '1\\n2\\n3\\n' | $S -n '1,2{ s/[0-9]/X/; p };3p'\nprintf '%s\\n' '== q and pending append =='\nprintf 'a\\nb\\n' | $S '1a tail\n1q 3'; echo status:$?\nprintf '%s\\n' '== multiline text forms =='\nprintf 'x\\n' | $S -n 'i\\\nline1\\\nline2\np'\n"]
