[76.142704, "i", "cat > /app/pysed/sed.py <<'PY'\r#!/usr/bin/env python3\r\"\"\"Small, byte-oriented GNU sed 4.9 compatible interpreter.\"\"\"\rimport sys, os, ctypes\r\rlibc = ctypes.CDLL(None)\rclass RM(ctypes.Structure):\r    _fields_ = [('so', ctypes.c_int), ('eo', ctypes.c_int)]\rlibc.regcomp.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]\rlibc.regcomp.restype = ctypes.c_int\rlibc.regexec.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.POINTER(RM), ctypes.c_int]\rlibc.regexec.restype = ctypes.c_int\rlibc.regfree.argtypes = [ctypes.c_void_p]\rREG_EXTENDED, REG_ICASE, REG_NEWLINE = 1, 2, 4\r\rdef numesc(s):\r    out=bytearray(); i=0\r    while i<len(s):\r        if s[i:i+2] in (b'\\\\d',b'\\\\o',b'\\\\x'):\r            typ=s[i+1]; base={100:10,111:8,120:16}[typ]; lim=2 if typ==120 else 3\r            j=i+2\r            while j<len(s) and j<i+2+lim and chr(s[j]).lower() in '0123456789abcdef' and int(chr(s[j]),16)<base: j+=1\r            if j>i+2: out.append(int(s[i+2:j],base)&255); i=j; continue\r        out.append(s[i]); i+"]
[76.143081, "i", "=1\r    return bytes(out)\r\rclass RX:\r    def __init__(self, pat, ext=False, icase=False, multi=False):\r        self.pat=numesc(pat); self.buf=ctypes.create_string_buffer(4096)\r        flags=(REG_EXTENDED if ext else 0)|(REG_ICASE if icase else 0)|(REG_NEWLINE if multi else 0)\r        rc=libc.regcomp(self.buf, self.pat, flags)\r        if rc: raise ValueError('bad regexp')\r    def find(self, data, start=0, n=10):\r        # REG_STARTEND makes embedded newlines and a nonzero starting point safe.\r        a=(RM*n)(); a[0].so=start; a[0].eo=len(data)\r        db=ctypes.create_string_buffer(data+b'\\0')\r        if libc.regexec(self.buf, db, n, a, 4): return None\r        return [(x.so,x.eo) if x.so>=0 else None for x in a]\r    def __del__(self):\r        try: libc.regfree(self.buf)\r        except: pass\r\rdef scan_delim(s,i,d):\r    out=bytearray()\r    while i<len(s):\r        c=s[i]\r        if c==d: return bytes(out),i+1\r        if c==92 and i+1<len(s):\r            out.extend(s[i:i+2]); i+=2\r        else: out.append(c); i+=1"]
