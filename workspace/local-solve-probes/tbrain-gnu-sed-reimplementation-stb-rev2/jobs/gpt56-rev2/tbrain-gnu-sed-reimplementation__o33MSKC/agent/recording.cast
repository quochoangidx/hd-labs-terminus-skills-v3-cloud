[158.65574, "i", "2:j],base)&255);i=j;continue\n        # These backslashes belong to the regexp or replacement grammar.\n        out.extend((92,z)); i+=2\n    return bytes(out)\n\ndef numesc(s):\n    return sed_escapes(s, 'regex')\n'''\ns=s[:start]+new+s[end:]\n# RX already calls numesc, now expanded fully.\n# y lists need all escapes expanded but no accidental stripping.\ns=s.replace(\"c.arg=(numesc(unescape_text(x)),numesc(unescape_text(y)))\", \"c.arg=(sed_escapes(x,'text'),sed_escapes(y,'text'))\")\n# Replacement literal character escapes are handled before replacement grammar,\n# but protect grammar escapes and backreferences naturally in sed_escapes.\ns=s.replace(\"p,r,fl=arg; mods=bytes(x for x in fl if x in b'IM');rx=self.rx(p,mods)\", \"p,r,fl=arg; r=sed_escapes(r,'replacement'); mods=bytes(x for x in fl if x in b'IM');rx=self.rx(p,mods)\")\n# Numeric second address at or before addr1 closes on the starting line; once\n# active, a numeric end is reached at >= its value.\ns=s.replace(\"else:end=self.amatch(c.a2,ps,num,idx,c._start)\", \"elif c.a"]
