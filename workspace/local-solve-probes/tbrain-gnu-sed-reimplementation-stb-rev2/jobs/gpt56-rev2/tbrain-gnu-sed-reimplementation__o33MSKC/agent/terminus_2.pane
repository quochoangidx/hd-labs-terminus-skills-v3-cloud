cases=[
 (['-n','1p'],b'a\nb\n',b'a\n',0),
 (['s/[[:digit:]][[:digit:]]*/N/g'],b'a12b003\n',b'aNbN\n',0),
 (['-E','s/(a|aa)/X/'],b'aa\n',b'X\n',0),
 (['-n','0,/x/p'],b'x\ny\nx\n',b'x\n',0),
