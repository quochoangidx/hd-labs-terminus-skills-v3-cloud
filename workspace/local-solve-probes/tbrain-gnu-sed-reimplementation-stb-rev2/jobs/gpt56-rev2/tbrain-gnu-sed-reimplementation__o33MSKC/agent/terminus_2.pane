 if (r.stdout,r.returncode)!=(want,rc):
  ok=False;print('FAIL',args,r.stdout,r.returncode,'wanted',want,rc)
print('final regression:', 'PASS' if ok else 'FAIL')
raise SystemExit(0 if ok else 1)
