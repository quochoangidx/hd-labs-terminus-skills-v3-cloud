[18.931459, "i", "for x in /bin/* /usr/bin/*; do case \"$x\" in *sed*|*busybox*|*toybox*|*perl*|*awk*|*grep*) [ -x \"$x\" ] && echo \"$x\";; esac; done; command -v busybox toybox perl awk mawk gawk grep pcre2grep || true\n"]
[18.934393, "o", "for x in /bin/* /usr/bin/*; do case \"$x\" in *sed*|*busybox*|*toybox*|*perl*|*awk*|*grep*) [ -x \"$x\" ] && echo \"$x\";; esac; done; command -v busybox toybox perl awk mawk gawk grep pcre2grep || true\r\n\u001b[?2004l\r"]
