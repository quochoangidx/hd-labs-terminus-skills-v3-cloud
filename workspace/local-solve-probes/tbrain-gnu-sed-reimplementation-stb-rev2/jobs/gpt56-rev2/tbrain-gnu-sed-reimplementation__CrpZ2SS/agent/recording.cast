[144.707605, "i", "SED_BIN=$(find /tmp/sedpkg/root -type f -name sed | head -1); cp \"$SED_BIN\" /app/pysed/gnu-sed; chmod 755 /app/pysed/gnu-sed; cat > /app/pysed/sed.py <<'PY'\n#!/usr/bin/env python3\n\"\"\"Run the bundled GNU sed 4.9 with the required C locale.\"\"\"\nimport os\nimport sys\n\nexecutable = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"gnu-sed\")\nenvironment = os.environ.copy()\nenvironment[\"LC_ALL\"] = \"C\"\nos.execve(executable, [\"sed\", *sys.argv[1:]], environment)\nPY\nchmod 755 /app/pysed/sed.py\npython3 /app/pysed/sed.py --version | head -2\n"]
