[98.443256, "i", ")\r    else: v=truncdiv(a.v,b.v*p10(-shift))\r    return Num(v,sc)\rdef rem(a,b,sc):\r    if b.v==0: raise BCRuntime()\r    q=div(a,b,sc)\r    # GNU definition requires product scale max(sc+b.s,a.s).\r    ps=max(sc+b.s,a.s)\r    raw=q.v*b.v; rs=q.s+b.s\r    pv=raw*p10(ps-rs) if ps>=rs else truncdiv(raw,p10(rs-ps))\r    av=a.v*p10(ps-a.s)\r    return Num(av-pv,ps)\rdef power(a,b,sc):\r    n=b.integer()\r    if n==0: return Num(1,0)\r    if n<0:\r        if a.v==0: raise BCRuntime()\r        pos=power(a,Num(-n,0),sc)\r        return div(Num(1,0),pos,sc)\r    out=min(a.s*n,max(sc,a.s))\r    raw=pow(a.v,n); rs=a.s*n\r    return Num(truncdiv(raw,p10(rs-out)),out)\rdef sqrt_num(a,sc):\r    if a.v<0: raise BCRuntime()\r    if a.v==0: return Num(0,0)\r    if a.v==p10(a.s): return Num(1,0)\r    out=max(sc,a.s)\r    # floor(sqrt(a.v / 10^a.s) * 10^out)\r    shift=2*out-a.s\r    if shift>=0: z=a.v*p10(shift); return Num(math.isqrt(z),out)\r    # This is only relevant for exceptionally unusual negative shifts.\r    return Num(math.isqrt(a.v//p10(-shif"]
