[117.190543, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> # arrays and index once\r\n\u001b[?2004l\r\u001b[?2004h> scale=0;i=1;a[i++]+=5;i;a[1]\r\n\u001b[?2004l\r\u001b[?2004h> define av(x[]) { x[0]=99; return(x[1]); }\r\n\u001b[?2004l\r\u001b[?2004h> define ar(*x[]) { x[0]=88; return(x[1]); }\r\n\u001b[?2004l\r\u001b[?2004h> a[0]=7;a[1]=6;av(a[]);a[0];ar(a[]);a[0]\r\n\u001b[?2004l\r\u001b[?2004h> # dynamic locals and recursion\r\n\u001b[?2004l\r\u001b[?2004h> define outer(x){ auto z; z=12; return(inner()); }\r\n\u001b[?2004l\r\u001b[?2004h> define inner(){ return(z); }\r\n\u001b[?2004l\r\u001b[?2004h> outer(1)\r\n\u001b[?2004l\r\u001b[?2004h> # continue\r\n\u001b[?2004l\r\u001b[?2004h> define void loop(){auto j;for(j=0;j<5;j++){if(j==2)continue;print j;}print \"\\n\";}\r\n\u001b[?2004l\r\u001b[?2004h> loop()\r\n\u001b[?2004l\r\u001b[?2004h> # errors should preserve earlier effects\r\n\u001b[?2004l\r\u001b[?2004h> q=1; print \"A\"; q=2; 1/0; print \"B\"; q=3\r\n\u001b[?2004l\r\u001b[?2004h> q\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
