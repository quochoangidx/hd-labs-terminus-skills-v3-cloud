[160.624891, "o", "pt ParseQuit:\r\n\u001b[?2004l\r\u001b[?2004h>                 self.quit_seen=True\r\n\u001b[?2004l\r\u001b[?2004h>                 block=[]                 # the block being compiled never runs\r\n\u001b[?2004l\r\u001b[?2004h>                 break\r\n\u001b[?2004l\r\u001b[?2004h>             saw_nl=False\r\n\u001b[?2004l\r\u001b[?2004h>             while self.cur() in ('NL',';'):\r\n\u001b[?2004l\r\u001b[?2004h>                 if self.pop().k=='NL': saw_nl=True\r\n\u001b[?2004l\r\u001b[?2004h>             if saw_nl:\r\n\u001b[?2004l\r\u001b[?2004h>                 if block: out.append(('topblock',block)); block=[]\r\n\u001b[?2004l\r\u001b[?2004h>         if block: out.append(('topblock',block))\r\n\u001b[?2004l\r\u001b[?2004h>         return out\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> assert old in s\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"        if k in ('break','continue','halt','quit'):\\n            self.pop(); return (k,)\\n\", \"        if k=='quit':\\n            self.pop(); raise ParseQuit()\\n        if k in ('break','continue','halt'):\\n            self.pop(); return (k,)\\n\")\r\n\u001b[?2004l\r\u001b[?20"]
