[197.554022, "i", "cat >/tmp/bcfile <<'EOF'\nibase=2\ndefine f(){ ibase=A; return(10); }\ndefine g(){ return(10); }\nprint f(),\",\",g(),\"\\n\"\nibase=A\nx=7\ndefine inner(){return(z+x);}\ndefine outer(x){auto z;z=12;return(inner());}\nouter(3)\ndefine fact(n){if(n<2)return(1);return(n*fact(n-1));}\nfact(30)\n/* multi\nline */ 1+1 # tail\nprint \"1234567890123456789012345678901234567890123456789012345678901234567\"\nEOF\nprintf 'print \"X\"; 99\\n' | python3 /app/pybc/bc.py /tmp/bcfile\n"]
[197.557625, "o", "cat >/tmp/bcfile <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> ibase=2\r\n\u001b[?2004l\r\u001b[?2004h> define f(){ ibase=A; return(10); }\r\n\u001b[?2004l\r\u001b[?2004h> define g(){ return(10); }\r\n\u001b[?2004l\r\u001b[?2004h> print f(),\",\",g(),\"\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> ibase=A\r\n\u001b[?2004l\r\u001b[?2004h> x=7\r\n\u001b[?2004l\r\u001b[?2004h> define inner(){return(z+x);}\r\n\u001b[?2004l\r\u001b[?2004h> define outer(x){auto z;z=12;return(inner());}\r\n\u001b[?2004l\r\u001b[?2004h> outer(3)\r\n\u001b[?2004l\r\u001b[?2004h> define fact(n){if(n<2)return(1);return(n*fact(n-1));}\r\n\u001b[?2004l\r\u001b[?2004h> fact(30)\r\n\u001b[?2004l\r\u001b[?2004h> /* multi\r\n\u001b[?2004l\r\u001b[?2004h> line */ 1+1 # tail\r\n\u001b[?2004l\r\u001b[?2004h> print \"1234567890123456789012345678901234567890123456789012345678901234567\"\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
