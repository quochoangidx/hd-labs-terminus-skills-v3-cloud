[8.864968, "o", "\u001b[?2004hroot@0f57bcdb6b24:/app# "]
[13.825899, "i", "cat /app/README.md; sed -n '1,756p' /app/docs/bc.txt\n"]
[13.827316, "o", "cat /app/README.md; sed -n '1,756p' /app/docs/bc.txt\r\n"]
[13.827501, "o", "\u001b[?2004l\r"]
[13.828131, "o", "# pybc\r\n\r\nA pure-Python replacement for GNU bc 1.07.1, for the minimal images that ship\r\nwithout bc.\r\n\r\n- `pybc/bc.py` — the command (`python3 /app/pybc/bc.py [FILE]...`)\r\n- `docs/bc.txt` — the GNU bc manual page\r\n"]
[13.829306, "o", "bc(1)                       General Commands Manual                      bc(1)\r\n"]
[13.829391, "o", "\r\n"]
[13.829446, "o", "NAME\r\n"]
[13.829492, "o", "     bc - An arbitrary precision calculator language\r\n"]
[13.82953, "o", "\r\n"]
[13.829569, "o", "SYNTAX\r\n"]
[13.829641, "o", "     bc [ -hlwsqv ] [long-options] [  file ... ]\r\n"]
[13.82967, "o", "\r\n"]
[13.829736, "o", "DESCRIPTION\r\n"]
[13.829778, "o", "     bc is a language that supports arbitrary precision numbers with\r\n"]
[13.8298, "o", "     interactive execution of statements.  There are some similarities in the\r\n"]
[13.829861, "o", "     syntax to the C programming language.  A standard math library is\r\n     available by command line option.  If requested, the math library is\r\n"]
[13.829941, "o", "     defined before processing any files.  bc starts by processing code from\r\n     all the files listed on the command line in the order listed.  After all\r\n     files have been processed, bc reads from the standard input.  All code is\r\n     executed as it is read.  (If a file contains a command to halt the\r\n"]
[13.830068, "o", "     processor, bc will never read from the standard input.)\r\n\r\n     This version of bc contains several extensions beyond traditional bc\r\n     implementations and the POSIX draft standard.  Command line options can\r\n     cause these extensions to print a warning or to be rejected.  This\r\n     document describes the language accepted by this processor.  Extensions\r\n"]
[13.8302, "o", "     will be identified as such.\r\n\r\n   OPTIONS\r\n     -h, --help\r\n            Print the usage and exit.\r\n\r\n     -i, --interactive\r\n            Force interactive mode.\r\n\r\n     -l, --mathlib\r\n            Define the standard math library.\r\n\r\n     -w, --warn\r\n            Give warnings for extensions to POSIX bc.\r\n\r\n     -s, --standard\r\n            Process exactly the POSIX bc language.\r\n\r\n     -q, --quiet\r\n            Do not print the normal GNU bc welcome.\r\n\r\n     -v, --version\r\n            Print the version number and copyright and quit.\r\n"]
[13.830303, "o", "\r\n   NUMBERS\r\n     The most basic element in bc is the number.  Numbers are arbitrary\r\n     precision numbers.  This precision is both in the integer part and the\r\n     fractional part.  All numbers are represented internally in decimal and\r\n"]
[13.83034, "o", "     all computation is done in decimal.  (This version truncates results from\r\n     divide and multiply operations.)  There are two attributes of numbers,\r\n     the length and the scale.  The length is the total number of decimal\r\n     digits used by bc to represent a number and the scale is the total number\r\n     of decimal digits after the decimal point.  For example:\r\n             .000001 has a length of 6 and scale of 6.\r\n             1935.000 has a length of 7 and a scale of 3.\r\n\r\n   VARIABLES\r\n     Numbers are stored in two types of variables, simple variables and\r\n     arrays.  Both simple variables and array variables are named.  Names\r\n     begin with a letter followed by any number of letters, digits and\r\n     underscores.  All letters must be lower case.  (Full alpha-numeric names\r\n     are an extension. In POSIX bc all names are a single lower case letter.)\r\n     The type of variable is clear by the context because all array variable\r\n     names will be followed by brackets ([]).\r\n\r\n     There ar"]
[13.830368, "o", "e four special variables, scale, ibase, obase, and last.  scale\r\n     defines how some operations use digits after the decimal point.  The\r\n     default value of scale is 0. ibase and obase define the conversion base\r\n     for input and output numbers.  The default for both input and output is\r\n     base 10.  last (an extension) is a variable that has the value of the\r\n     last printed number.  These will be discussed in further detail where\r\n     appropriate.  All of these variables may have values assigned to them as\r\n     well as used in expressions.\r\n\r\n   COMMENTS\r\n"]
[13.830387, "o", "     Comments in bc start with the characters /* and end with the characters\r\n     */.  Comments may start anywhere and appear as a single space in the\r\n     input.  (This causes comments to delimit other input items.  For example,\r\n"]
[13.830404, "o", "     a comment can not be found in the middle of a variable name.)  Comments\r\n     include any newlines (end of line) between the start and the end of the\r\n"]
[13.830426, "o", "     comment.\r\n\r\n"]
[13.830445, "o", "     To support the use of scripts for bc, a single line comment has been\r\n     added as an extension.  A single line comment starts at a # character and\r\n"]
[13.830617, "o", "     continues to the next end of the line.  The end of line character is not\r\n"]
[13.83079, "o", "     part of the comment and is processed normally.\r\n"]
[13.830809, "o", "\r\n   EXPRESSIONS\r\n     The numbers are manipulated by expressions and statements.  Since the\r\n     language was designed to be interactive, statements and expressions are\r\n     executed as soon as possible.  There is no \"main\" program.  Instead, code\r\n     is executed as it is encountered.  (Functions, discussed in detail later,\r\n     are defined when encountered.)\r\n\r\n     A simple expression is just a constant. bc converts constants into\r\n     internal decimal numbers using the current input base, specified by the\r\n     variable ibase. (There is an exception in functions.)  The legal values\r\n     of ibase are 2 through 36. (Bases greater than 16 are an extension.)\r\n     Assigning a value outside this range to ibase will result in a value of 2\r\n     or 36.  Input numbers may contain the characters 0-9 and A-Z. (Note: They\r\n     must be capitals.  Lower case letters are variable names.)  Single digit\r\n     numbers always have the value of the digit regardless of the value of\r\n     ibase. (i.e. A = 10.)  For mu"]
[13.830835, "o", "lti-digit numbers, bc changes all input\r\n     digits greater or equal to ibase to the value of ibase-1.  This makes the\r\n     number ZZZ always be the largest 3 digit number of the input base.\r\n\r\n     Full expressions are similar to many other high level languages.  Since\r\n     there is only one kind of number, there are no rules for mixing types.\r\n     Instead, there are rules on the scale of expressions.  Every expression\r\n     has a scale.  This is derived from the scale of original numbers, the\r\n     operation performed and in many cases, the value of the variable scale.\r\n     Legal values of the variable scale are 0 to the maximum number\r\n     representable by a C integer.\r\n\r\n     In the following descriptions of legal expressions, \"expr\" refers to a\r\n     complete expression and \"var\" refers to a simple or an array variable.  A\r\n     simple variable is just a\r\n            name\r\n     and an array variable is specified as\r\n            name[expr]\r\n     Unless specifically mentioned the scale of the result "]
[13.830854, "o", "is the maximum\r\n     scale of the expressions involved.\r\n\r\n     - expr The result is the negation of the expression.\r\n\r\n     ++ var The variable is incremented by one and the new value is the result\r\n            of the expression.\r\n\r\n     -- var The variable is decremented by one and the new value is the result\r\n            of the expression.\r\n\r\n     var ++  The result of the expression is the value of the variable and\r\n            then the variable is incremented by one.\r\n\r\n     var -- The result of the expression is the value of the variable and then\r\n            the variable is decremented by one.\r\n\r\n"]
[13.830878, "o", "     expr + expr\r\n            The result of the expression is the sum of the two expressions.\r\n"]
[13.830895, "o", "\r\n     expr - expr\r\n"]
[13.830912, "o", "            The result of the expression is the difference of the two\r\n            expressions.\r\n"]
[13.830935, "o", "\r\n     expr * expr\r\n"]
[13.830949, "o", "            The result of the expression is the product of the two\r\n            expressions.\r\n\r\n"]
[13.830966, "o", "     expr / expr\r\n"]
[13.830983, "o", "            The result of the expression is the quotient of the two\r\n            expressions.  The scale of the result is the value of the variable\r\n"]
[13.831001, "o", "            scale.\r\n\r\n"]
[13.831018, "o", "     expr % expr\r\n            The result of the expression is the \"remainder\" and it is computed\r\n"]
[13.831032, "o", "            in the following way.  To compute a%b, first a/b is computed to\r\n            scale digits.  That result is used to compute a-(a/b)*b to the\r\n"]
[13.831051, "o", "            scale of the maximum of scale+scale(b) and scale(a).  If scale is\r\n"]
[13.831068, "o", "            set to zero and both expressions are integers this expression is\r\n            the integer remainder function.\r\n"]
[13.831086, "o", "\r\n     expr ^ expr\r\n"]
[13.831353, "o", "            The result of the expression is the value of the first raised to\r\n            the second. The second expression must be an integer.  (If the\r\n"]
[13.831612, "o", "            second expression is not an integer, a warning is generated and\r\n            the expression is truncated to get an integer value.)  The scale\r\n            of the result is scale if the exponent is negative.  If the\r\n"]
[13.831643, "o", "            exponent is positive the scale of the result is the minimum of the\r\n            scale of the first expression times the value of the exponent and\r\n            the maximum of scale and the scale of the first expression.  (e.g.\r\n            scale(a^b) = min(scale(a)*b, max( scale, scale(a))).)  It should\r\n            be noted that expr^0 will always return the value of 1.\r\n\r\n     ( expr )\r\n            This alters the standard precedence to force the evaluation of the\r\n            expression.\r\n\r\n     var = expr\r\n            The variable is assigned the value of the expression.\r\n\r\n     var <op>= expr\r\n            This is equivalent to \"var = var <op> expr\" with the exception\r\n            that the \"var\" part is evaluated only once.  This can make a\r\n            difference if \"var\" is an array.\r\n\r\n     Relational expressions are a special kind of expression that always\r\n     evaluate to 0 or 1, 0 if the relation is false and 1 if the relation is\r\n     true.  These may appear in any legal expression.  (P"]
[13.831666, "o", "OSIX bc requires that\r\n     relational expressions are used only in if, while, and for statements and\r\n     that only one relational test may be done in them.)  The relational\r\n     operators are\r\n\r\n     expr1 < expr2\r\n            The result is 1 if expr1 is strictly less than expr2.\r\n\r\n     expr1 <= expr2\r\n            The result is 1 if expr1 is less than or equal to expr2.\r\n\r\n     expr1 > expr2\r\n            The result is 1 if expr1 is strictly greater than expr2.\r\n\r\n     expr1 >= expr2\r\n            The result is 1 if expr1 is greater than or equal to expr2.\r\n\r\n     expr1 == expr2\r\n            The result is 1 if expr1 is equal to expr2.\r\n\r\n     expr1 != expr2\r\n            The result is 1 if expr1 is not equal to expr2.\r\n\r\n     Boolean operations are also legal.  (POSIX bc does NOT have boolean\r\n     operations). The result of all boolean operations are 0 and 1 (for false\r\n     and true) as in relational expressions.  The boolean operators are:\r\n\r\n     !expr  The result is 1 if expr is 0.\r\n\r\n     expr && expr"]
[13.83169, "o", "\r\n            The result is 1 if both expressions are non-zero.\r\n\r\n     expr || expr\r\n            The result is 1 if either expression is non-zero.\r\n\r\n     The expression precedence is as follows: (lowest to highest)\r\n            || operator, left associative\r\n            && operator, left associative\r\n            ! operator, nonassociative\r\n            Relational operators, left associative\r\n            Assignment operator, right associative\r\n            + and - operators, left associative\r\n            *, / and % operators, left associative\r\n            ^ operator, right associative\r\n            unary - operator, nonassociative\r\n            ++ and -- operators, nonassociative\r\n\r\n     This precedence was chosen so that POSIX compliant bc programs will run\r\n     correctly. This will cause the use of the relational and logical\r\n     operators to have some unusual behavior when used with assignment\r\n     expressions.  Consider the expression:\r\n"]
[13.831709, "o", "            a = 3 < 5\r\n\r\n     Most C programmers would assume this would assign the result of \"3 < 5\"\r\n"]
[13.831722, "o", "     (the value 1) to the variable \"a\".  What this does in bc is assign the\r\n     value 3 to the variable \"a\" and then compare 3 to 5.  It is best to use\r\n"]
[13.831742, "o", "     parenthesis when using relational and logical operators with the\r\n"]
[13.831759, "o", "     assignment operators.\r\n\r\n"]
[13.831777, "o", "     There are a few more special expressions that are provided in bc.  These\r\n     have to do with user defined functions and standard functions.  They all\r\n"]
[13.831803, "o", "     appear as \"name(parameters)\".  See the section on functions for user\r\n     defined functions.  The standard functions are:\r\n"]
[13.831815, "o", "\r\n"]
[13.831833, "o", "     length ( expression )\r\n"]
[13.831882, "o", "            The value of the length function is the number of significant\r\n            digits in the expression.\r\n"]
[13.831905, "o", "\r\n     read ( )\r\n            The read function (an extension) will read a number from the\r\n"]
[13.831923, "o", "            standard input, regardless of where the function occurs.   Beware,\r\n            this can cause problems with the mixing of data and program in the\r\n"]
[13.831941, "o", "            standard input.  The best use for this function is in a previously\r\n            written program that needs input from the user, but never allows\r\n"]
[13.831956, "o", "            program code to be input from the user.  The value of the read\r\n"]
[13.83601, "o", "            function is the number read from the standard input using the\r\n"]
[13.836123, "o", "            current value of the variable ibase for the conversion base.\r\n\r\n     scale ( expression )\r\n            The value of the scale function is the number of digits after the\r\n            decimal point in the expression.\r\n\r\n     sqrt ( expression )\r\n            The value of the sqrt function is the square root of the\r\n            expression.  If the expression is negative, a run time error is\r\n            generated.\r\n\r\n   STATEMENTS\r\n     Statements (as in most algebraic languages) provide the sequencing of\r\n     expression evaluation.  In bc statements are executed \"as soon as\r\n     possible.\"  Execution happens when a newline in encountered and there is\r\n     one or more complete statements.  Due to this immediate execution,\r\n     newlines are very important in bc. In fact, both a semicolon and a\r\n     newline are used as statement separators.  An improperly placed newline\r\n     will cause a syntax error.  Because newlines are statement separators, it\r\n     is possible to hide a newline by using the b"]
[13.8362, "o", "ackslash character.  The\r\n     sequence \"\\<nl>\", where <nl> is the newline appears to bc as whitespace\r\n     instead of a newline.  A statement list is a series of statements\r\n     separated by semicolons and newlines.  The following is a list of bc\r\n     statements and what they do: (Things enclosed in brackets ([]) are\r\n     optional parts of the statement.)\r\n\r\n     expression\r\n            This statement does one of two things.  If the expression starts\r\n            with \"<variable> <assignment> ...\", it is considered to be an\r\n            assignment statement.  If the expression is not an assignment\r\n            statement, the expression is evaluated and printed to the output.\r\n            After the number is printed, a newline is printed.  For example,\r\n            \"a=1\" is an assignment statement and \"(a=1)\" is an expression that\r\n            has an embedded assignment.  All numbers that are printed are\r\n            printed in the base specified by the variable obase. The legal\r\n            values for  o"]
[13.836271, "o", "base are 2 through BC_BASE_MAX.  (See the section\r\n            LIMITS.)  For bases 2 through 16, the usual method of writing\r\n            numbers is used.  For bases greater than 16, bc uses a multi-\r\n            character digit method of printing the numbers where each higher\r\n            base digit is printed as a base 10 number.  The multi-character\r\n            digits are separated by spaces.  Each digit contains the number of\r\n            characters required to represent the base ten value of \"obase-1\".\r\n            Since numbers are of arbitrary precision, some numbers may not be\r\n            printable on a single output line.  These long numbers will be\r\n            split across lines using the \"\\\" as the last character on a line.\r\n            The maximum number of characters printed per line is 70.  Due to\r\n            the interactive nature of bc, printing a number causes the side\r\n            effect of assigning the printed value to the special variable\r\n            last. This allows the user to rec"]
[13.836343, "o", "over the last value printed\r\n            without having to retype the expression that printed the number.\r\n            Assigning to last is legal and will overwrite the last printed\r\n            value with the assigned value.  The newly assigned value will\r\n            remain until the next number is printed or another value is\r\n            assigned to last.  (Some installations may allow the use of a\r\n            single period (.) which is not part of a number as a short hand\r\n            notation for for last.)\r\n\r\n     string The string is printed to the output.  Strings start with a double\r\n            quote character and contain all characters until the next double\r\n            quote character.  All characters are take literally, including any\r\n            newline.  No newline character is printed after the string.\r\n\r\n     print list\r\n            The print statement (an extension) provides another method of\r\n            output.  The \"list\" is a list of strings and expressions separated\r\n            by com"]
[13.836416, "o", "mas.  Each string or expression is printed in the order of\r\n            the list.  No terminating newline is printed.  Expressions are\r\n            evaluated and their value is printed and assigned to the variable\r\n            last. Strings in the print statement are printed to the output and\r\n            may contain special characters.  Special characters start with the\r\n            backslash character (\\).  The special characters recognized by bc\r\n            are \"a\" (alert or bell), \"b\" (backspace), \"f\" (form feed), \"n\"\r\n            (newline), \"r\" (carriage return), \"q\" (double quote), \"t\" (tab),\r\n            and \"\\\" (backslash).  Any other character following the backslash\r\n            will be ignored.\r\n\r\n     { statement_list }\r\n            This is the compound statement.  It allows multiple statements to\r\n            be grouped together for execution.\r\n\r\n     if ( expression ) statement1 [else statement2]\r\n            The if statement evaluates the expression and executes statement1\r\n            or stat"]
[13.836491, "o", "ement2 depending on the value of the expression.  If the\r\n            expression is non-zero, statement1 is executed.  If statement2 is\r\n            present and the value of the expression is 0, then statement2 is\r\n            executed.  (The else clause is an extension.)\r\n\r\n     while ( expression ) statement\r\n            The while statement will execute the statement while the\r\n            expression is non-zero.  It evaluates the expression before each\r\n            execution of the statement.   Termination of the loop is caused by\r\n            a zero expression value or the execution of a break statement.\r\n\r\n     for ( [expression1] ; [expression2] ; [expression3] ) statement\r\n            The for statement controls repeated execution of the statement.\r\n            Expression1 is evaluated before the loop.  Expression2 is\r\n            evaluated before each execution of the statement.  If it is non-\r\n            zero, the statement is evaluated.  If it is zero, the loop is\r\n            terminated.  After eac"]
[13.836563, "o", "h execution of the statement, expression3 is\r\n            evaluated before the reevaluation of expression2.  If expression1\r\n            or expression3 are missing, nothing is evaluated at the point they\r\n            would be evaluated.  If expression2 is missing, it is the same as\r\n            substituting the value 1 for expression2.  (The optional\r\n            expressions are an extension. POSIX bc requires all three\r\n            expressions.)  The following is equivalent code for the for\r\n            statement:\r\n            expression1;\r\n            while (expression2) {\r\n               statement;\r\n               expression3;\r\n            }\r\n\r\n     break  This statement causes a forced exit of the most recent enclosing\r\n            while statement or for statement.\r\n\r\n     continue\r\n            The continue statement (an extension)  causes the most recent\r\n            enclosing for statement to start the next iteration.\r\n\r\n     halt   The halt statement (an extension) is an executed statement that\r\n      "]
[13.83665, "o", "      causes the bc processor to quit only when it is executed.  For\r\n            example, \"if (0 == 1) halt\" will not cause bc to terminate because\r\n            the halt is not executed.\r\n\r\n     return Return the value 0 from a function.  (See the section on\r\n            functions.)\r\n\r\n     return ( expression )\r\n            Return the value of the expression from a function.  (See the\r\n            section on functions.)  As an extension, the parenthesis are not\r\n            required.\r\n\r\n   PSEUDO STATEMENTS\r\n     These statements are not statements in the traditional sense.  They are\r\n     not executed statements.  Their function is performed at \"compile\" time.\r\n\r\n     limits Print the local limits enforced by the local version of bc.  This\r\n            is an extension.\r\n\r\n     quit   When the quit statement is read, the bc processor is terminated,\r\n            regardless of where the quit statement is found.  For example, \"if\r\n            (0 == 1) quit\" will cause bc to terminate.\r\n\r\n     warranty\r\n       "]
[13.836734, "o", "     Print a longer warranty notice.  This is an extension.\r\n\r\n   FUNCTIONS\r\n     Functions provide a method of defining a computation that can be executed\r\n     later.  Functions in bc always compute a value and return it to the\r\n     caller.  Function definitions are \"dynamic\" in the sense that a function\r\n     is undefined until a definition is encountered in the input.  That\r\n     definition is then used until another definition function for the same\r\n     name is encountered.  The new definition then replaces the older\r\n     definition.  A function is defined as follows:\r\n            define name ( parameters ) { newline\r\n                auto_list   statement_list }\r\n     A function call is just an expression of the form \"name(parameters)\".\r\n\r\n     Parameters are numbers or arrays (an extension).  In the function\r\n     definition, zero or more parameters are defined by listing their names\r\n     separated by commas.  All parameters are call by value parameters.\r\n     Arrays are specified in the parameter d"]
[13.836811, "o", "efinition by the notation\r\n     \"name[]\".   In the function call, actual parameters are full expressions\r\n     for number parameters.  The same notation is used for passing arrays as\r\n     for defining array parameters.  The named array is passed by value to the\r\n     function.  Since function definitions are dynamic, parameter numbers and\r\n     types are checked when a function is called.  Any mismatch in number or\r\n     types of parameters will cause a runtime error.  A runtime error will\r\n     also occur for the call to an undefined function.\r\n\r\n     The auto_list is an optional list of variables that are for \"local\" use.\r\n     The syntax of the auto list (if present) is \"auto name, ... ;\".  (The\r\n     semicolon is optional.)  Each name is the name of an auto variable.\r\n     Arrays may be specified by using the same notation as used in parameters.\r\n     These variables have their values pushed onto a stack at the start of the\r\n     function.  The variables are then initialized to zero and used throughout\r\n"]
[13.836884, "o", "     the execution of the function.  At function exit, these variables are\r\n     popped so that the original value (at the time of the function call) of\r\n     these variables are restored.  The parameters are really auto variables\r\n     that are initialized to a value provided in the function call.  Auto\r\n     variables are different than traditional local variables because if\r\n     function A calls function B, B may access function A's auto variables by\r\n     just using the same name, unless function B has called them auto\r\n     variables.  Due to the fact that auto variables and parameters are pushed\r\n     onto a stack, bc supports recursive functions.\r\n\r\n     The function body is a list of bc statements.  Again, statements are\r\n     separated by semicolons or newlines.  Return statements cause the\r\n     termination of a function and the return of a value.  There are two\r\n     versions of the return statement.  The first form, \"return\", returns the\r\n     value 0 to the calling expression.  The second form, "]
[13.836948, "o", "\"return ( expression\r\n     )\", computes the value of the expression and returns that value to the\r\n     calling expression.  There is an implied \"return (0)\" at the end of every\r\n     function.  This allows a function to terminate and return 0 without an\r\n     explicit return statement.\r\n\r\n     Functions also change the usage of the variable ibase.  All constants in\r\n     the function body will be converted using the value of ibase at the time\r\n     of the function call.  Changes of ibase will be ignored during the\r\n     execution of the function except for the standard function read, which\r\n     will always use the current value of ibase for conversion of numbers.\r\n\r\n     Several extensions have been added to functions.  First, the format of\r\n     the definition has been slightly relaxed.  The standard requires the\r\n     opening brace be on the same line as the define keyword and all other\r\n     parts must be on following lines.  This version of bc will allow any\r\n     number of newlines before and after the"]
[13.837029, "o", " opening brace of the function.\r\n     For example, the following definitions are legal.\r\n            define d (n) { return (2*n); }\r\n            define d (n)\r\n              { return (2*n); }\r\n\r\n     Functions may be defined as void.  A void funtion returns no value and\r\n     thus may not be used in any place that needs a value.  A void function\r\n     does not produce any output when called by itself on an input line.  The\r\n     key word void is placed between the key word define and the function\r\n     name.  For example, consider the following session.\r\n            define py (y) { print \"--->\", y, \"<---\", \"\\n\"; }\r\n            define void px (x) { print \"--->\", x, \"<---\", \"\\n\"; }\r\n            py(1)\r\n            --->1<---\r\n            0\r\n            px(1)\r\n            --->1<---\r\n     Since py is not a void function, the call of py(1) prints the desired\r\n     output and then prints a second line that is the value of the function.\r\n     Since the value of a function that is not given an explicit return\r\n     stat"]
[13.837099, "o", "ement is zero, the zero is printed.  For px(1), no zero is printed\r\n     because the function is a void function.\r\n\r\n     Also, call by variable for arrays was added.  To declare a call by\r\n     variable array, the declaration of the array parameter in the function\r\n     definition looks like \"*name[]\".  The call to the function remains the\r\n     same as call by value arrays.\r\n\r\n   MATH LIBRARY\r\n     If bc is invoked with the -l option, a math library is preloaded and the\r\n     default scale is set to 20.   The math functions will calculate their\r\n     results to the scale set at the time of their call.  The math library\r\n     defines the following functions:\r\n\r\n     s (x)  The sine of x, x is in radians.\r\n\r\n     c (x)  The cosine of x, x is in radians.\r\n\r\n     a (x)  The arctangent of x, arctangent returns radians.\r\n\r\n     l (x)  The natural logarithm of x.\r\n\r\n     e (x)  The exponential function of raising e to the value x.\r\n\r\n     j (n,x)\r\n            The Bessel function of integer order n of x.\r\n\r\n   EXAM"]
[13.837182, "o", "PLES\r\n     In /bin/sh,  the following will assign the value of \"pi\" to the shell\r\n     variable pi.\r\n             pi=$(echo \"scale=10; 4*a(1)\" | bc -l)\r\n\r\n     The following is the definition of the exponential function used in the\r\n     math library.  This function is written in POSIX bc.\r\n            scale = 20\r\n\r\n            /* Uses the fact that e^x = (e^(x/2))^2\r\n               When x is small enough, we use the series:\r\n                 e^x = 1 + x + x^2/2! + x^3/3! + ...\r\n            */\r\n\r\n            define e(x) {\r\n              auto  a, d, e, f, i, m, v, z\r\n\r\n              /* Check the sign of x. */\r\n              if (x<0) {\r\n                m = 1\r\n                x = -x\r\n              }\r\n\r\n              /* Precondition x. */\r\n              z = scale;\r\n              scale = 4 + z + .44*x;\r\n              while (x > 1) {\r\n                f += 1;\r\n                x /= 2;\r\n              }\r\n\r\n              /* Initialize the variables. */\r\n              v = 1+x\r\n              a = x\r\n              d = 1\r\n\r\n"]
[13.837252, "o", "              for (i=2; 1; i++) {\r\n                e = (a *= x) / (d *= i)\r\n                if (e == 0) {\r\n                  if (f>0) while (f--)  v = v*v;\r\n                  scale = z\r\n                  if (m) return (1/v);\r\n                  return (v/1);\r\n                }\r\n                v += e\r\n              }\r\n            }\r\n\r\n     The following is code that uses the extended features of bc to implement\r\n     a simple program for calculating checkbook balances.  This program is\r\n     best kept in a file so that it can be used many times without having to\r\n     retype it at every use.\r\n            scale=2\r\n            print \"\\nCheck book program!\\n\"\r\n            print \"  Remember, deposits are negative transactions.\\n\"\r\n            print \"  Exit by a 0 transaction.\\n\\n\"\r\n\r\n            print \"Initial balance? \"; bal = read()\r\n            bal /= 1\r\n            print \"\\n\"\r\n            while (1) {\r\n              \"current balance = \"; bal\r\n              \"transaction? \"; trans = read()\r\n              if (tran"]
[13.837326, "o", "s == 0) break;\r\n              bal -= trans\r\n              bal /= 1\r\n            }\r\n            quit\r\n\r\n     The following is the definition of the recursive factorial function.\r\n            define f (x) {\r\n              if (x <= 1) return (1);\r\n              return (f(x-1) * x);\r\n            }\r\n\r\n   READLINE AND LIBEDIT OPTIONS\r\n     GNU bc can be compiled (via a configure option) to use the GNU readline\r\n     input editor library or the BSD libedit library.  This allows the user to\r\n     do editing of lines before sending them to bc.  It also allows for a\r\n     history of previous lines typed.  When this option is selected, bc has\r\n     one more special variable.  This special variable, history is the number\r\n     of lines of history retained.  For readline, a value of -1 means that an\r\n     unlimited number of history lines are retained.  Setting the value of\r\n     history to a positive number restricts the number of history lines to the\r\n     number given.  The value of 0 disables the history feature.  The"]
[13.837387, "o", " default\r\n     value is 100. For more information, read the user manuals for the GNU\r\n     readline, history and BSD libedit libraries.  One can not enable both\r\n     readline and libedit at the same time.\r\n\r\n   DIFFERENCES\r\n     This version of bc was implemented from the POSIX P1003.2/D11 draft and\r\n     contains several differences and extensions relative to the draft and\r\n     traditional implementations.  It is not implemented in the traditional\r\n     way using dc(1).  This version is a single process which parses and runs\r\n     a byte code translation of the program.  There is an \"undocumented\"\r\n     option (-c) that causes the program to output the byte code to the\r\n     standard output instead of running it.  It was mainly used for debugging\r\n     the parser and preparing the math library.\r\n\r\n     A major source of differences is extensions, where a feature is extended\r\n     to add more functionality and additions, where new features are added.\r\n     The following is the list of differences and extens"]
[13.838097, "o", "ions.\r\n\r\n     LANG environment\r\n            This version does not conform to the POSIX standard in the\r\n            processing of the LANG environment variable and all environment\r\n            variables starting with LC_.\r\n\r\n     names  Traditional and POSIX bc have single letter names for functions,\r\n            variables and arrays.  They have been extended to be multi-\r\n            character names that start with a letter and may contain letters,\r\n            numbers and the underscore character.\r\n\r\n     Strings\r\n            Strings are not allowed to contain NUL characters.  POSIX says all\r\n            characters must be included in strings."]
[13.838176, "o", "\r\n\r\n     last   POSIX bc does not have a last variable.  Some implementations of\r\n            bc use the period (.) in a similar way.\r\n\r\n     comparisons\r\n            POSIX bc allows comparisons only in the if statement, the while\r\n            statement, and the second expression of the for statement.  Also,\r\n            only one relational operation is allowed in each of those\r\n            statements.\r\n\r\n     if statement, else clause\r\n            POSIX bc does not have an else clause.\r\n\r\n     for statement\r\n            POSIX bc requires all expressions to be present in the for\r\n            statement.\r\n\r\n     &&, ||, !\r\n            POSIX bc does not have the logical operators.\r\n\r\n     read function\r\n            POSIX bc does not have a read function.\r\n\r\n     print statement\r\n            POSIX bc does not have a print statement .\r\n\r\n     continue statement\r\n            POSIX bc does not have a continue statement.\r\n\r\n     return statement\r\n            POSIX bc requires parentheses around the return expression."]
[13.838376, "o", "\r\n\r\n     array parameters\r\n            POSIX bc does not (currently) support array parameters in full.\r\n            The POSIX grammar allows for arrays in function definitions, but\r\n            does not provide a method to specify an array as an actual\r\n            parameter.  (This is most likely an oversight in the grammar.)\r\n            Traditional implementations of bc have only call by value array\r\n            parameters.\r\n\r\n     function format\r\n            POSIX bc requires the opening brace on the same line as the define\r\n            key word and the auto statement on the next line.\r\n\r\n     =+, =-, =*, =/, =%, =^\r\n            POSIX bc does not require these \"old style\" assignment operators\r\n            to be defined.  This version may allow these \"old style\"\r\n            assignments.  Use the limits statement to see if the installed\r\n            version supports them.  If it does support the \"old style\"\r\n            assignment operators, the statement \"a =- 1\" will decrement a by 1\r\n            instea"]
[13.838443, "o", "d of setting a to the value -1.\r\n\r\n     spaces in numbers\r\n            Other implementations of bc allow spaces in numbers.  For example,\r\n            \"x=1 3\" would assign the value 13 to the variable x.  The same\r\n            statement would cause a syntax error in this version of bc.\r\n\r\n     errors and execution\r\n            This implementation varies from other implementations in terms of\r\n            what code will be executed when syntax and other errors are found\r\n            in the program.  If a syntax error is found in a function\r\n            definition, error recovery tries to find the beginning of a\r\n            statement and continue to parse the function.  Once a syntax error\r\n            is found in the function, the function will not be callable and\r\n            becomes undefined.  Syntax errors in the interactive execution\r\n            code will invalidate the current execution block.  The execution\r\n            block is terminated by an end of line that appears after a\r\n            complete s"]
[13.838506, "o", "equence of statements.  For example,\r\n            a = 1\r\n            b = 2\r\n     has two execution blocks and\r\n            { a = 1\r\n              b = 2 }\r\n     has one execution block.  Any runtime error will terminate the execution\r\n     of the current execution block.  A runtime warning will not terminate the\r\n     current execution block.\r\n\r\n     Interrupts\r\n            During an interactive session, the SIGINT signal (usually\r\n            generated by the control-C character from the terminal) will cause\r\n            execution of the current execution block to be interrupted.  It\r\n            will display a \"runtime\" error indicating which function was\r\n            interrupted.  After all runtime structures have been cleaned up, a\r\n            message will be printed to notify the user that bc is ready for\r\n            more input.  All previously defined functions remain defined and\r\n            the value of all non-auto variables are the value at the point of\r\n            interruption.  All auto variable"]
[13.838585, "o", "s and function parameters are\r\n            removed during the clean up process.  During a non-interactive\r\n            session, the SIGINT signal will terminate the entire run of bc.\r\n\r\n   LIMITS\r\n     The following are the limits currently in place for this bc processor.\r\n     Some of them may have been changed by an installation.  Use the limits\r\n     statement to see the actual values.\r\n\r\n     BC_BASE_MAX\r\n            The maximum output base is currently set at 999.  The maximum\r\n            input base is 16.\r\n\r\n     BC_DIM_MAX\r\n            This is currently an arbitrary limit of 65535 as distributed.\r\n            Your installation may be different.\r\n\r\n     BC_SCALE_MAX\r\n            The number of digits after the decimal point is limited to INT_MAX\r\n            digits.  Also, the number of digits before the decimal point is\r\n            limited to INT_MAX digits.\r\n\r\n     BC_STRING_MAX\r\n            The limit on the number of characters in a string is INT_MAX\r\n            characters.\r\n\r\n     exponent\r\n      "]
[13.838625, "o", "      The value of the exponent in the raise operation (^) is limited to\r\n            LONG_MAX.\r\n\r\n     variable names\r\n            The current limit on the number of unique names is 32767 for each\r\n            of simple variables, arrays and functions.\r\n\r\n\u001b[?2004h"]
[13.838675, "o", "root@0f57bcdb6b24:/app# "]
[18.925896, "i", "nl -ba /app/docs/bc.txt | sed -n '95,260p'\n"]
[18.93559, "o", "nl -ba /app/docs/bc.txt | sed -n '95,260p'\r\n\u001b[?2004l\r"]
[18.935667, "o", "    95\t     is executed as it is encountered.  (Functions, discussed in detail later,\r\n    96\t     are defined when encountered.)\r\n    97\t\r\n    98\t     A simple expression is just a constant. bc converts constants into\r\n    99\t     internal decimal numbers using the current input base, specified by the\r\n"]
[18.935672, "o", "   100\t     variable ibase. (There is an exception in functions.)  The legal values\r\n"]
[18.937231, "o", "   101\t     of ibase are 2 through 36. (Bases greater than 16 are an extension.)\r\n   102\t     Assigning a value outside this range to ibase will result in a value of 2\r\n   103\t     or 36.  Input numbers may contain the characters 0-9 and A-Z. (Note: They\r\n   104\t     must be capitals.  Lower case letters are variable names.)  Single digit\r\n   105\t     numbers always have the value of the digit regardless of the value of\r\n   106\t     ibase. (i.e. A = 10.)  For multi-digit numbers, bc changes all input\r\n   107\t     digits greater or equal to ibase to the value of ibase-1.  This makes the\r\n   108\t     number ZZZ always be the largest 3 digit number of the input base.\r\n   109\t\r\n   110\t     Full expressions are similar to many other high level languages.  Since\r\n   111\t     there is only one kind of number, there are no rules for mixing types.\r\n   112\t     Instead, there are rules on the scale of expressions.  Every expression\r\n   113\t     has a scale.  This is derived from the scale of original numbers, the\r\n   1"]
[18.937251, "o", "14\t     operation performed and in many cases, the value of the variable scale.\r\n   115\t     Legal values of the variable scale are 0 to the maximum number\r\n   116\t     representable by a C integer.\r\n   117\t\r\n   118\t     In the following descriptions of legal expressions, \"expr\" refers to a\r\n   119\t     complete expression and \"var\" refers to a simple or an array variable.  A\r\n   120\t     simple variable is just a\r\n   121\t            name\r\n   122\t     and an array variable is specified as\r\n   123\t            name[expr]\r\n   124\t     Unless specifically mentioned the scale of the result is the maximum\r\n   125\t     scale of the expressions involved.\r\n   126\t\r\n   127\t     - expr The result is the negation of the expression.\r\n   128\t\r\n   129\t     ++ var The variable is incremented by one and the new value is the result\r\n   130\t            of the expression.\r\n   131\t\r\n   132\t     -- var The variable is decremented by one and the new value is the result\r\n   133\t            of the expression.\r\n   134\t\r\n   135\t     va"]
[18.937257, "o", "r ++  The result of the expression is the value of the variable and\r\n   136\t            then the variable is incremented by one.\r\n   137\t\r\n   138\t     var -- The result of the expression is the value of the variable and then\r\n   139\t            the variable is decremented by one.\r\n   140\t\r\n   141\t     expr + expr\r\n   142\t            The result of the expression is the sum of the two expressions.\r\n   143\t\r\n   144\t     expr - expr\r\n   145\t            The result of the expression is the difference of the two\r\n   146\t            expressions.\r\n   147\t\r\n   148\t     expr * expr\r\n   149\t            The result of the expression is the product of the two\r\n   150\t            expressions.\r\n   151\t\r\n   152\t     expr / expr\r\n   153\t            The result of the expression is the quotient of the two\r\n   154\t            expressions.  The scale of the result is the value of the variable\r\n   155\t            scale.\r\n   156\t\r\n   157\t     expr % expr\r\n   158\t            The result of the expression is the \"remainder\" and it is co"]
[18.937261, "o", "mputed\r\n   159\t            in the following way.  To compute a%b, first a/b is computed to\r\n   160\t            scale digits.  That result is used to compute a-(a/b)*b to the\r\n   161\t            scale of the maximum of scale+scale(b) and scale(a).  If scale is\r\n   162\t            set to zero and both expressions are integers this expression is\r\n   163\t            the integer remainder function.\r\n   164\t\r\n   165\t     expr ^ expr\r\n   166\t            The result of the expression is the value of the first raised to\r\n   167\t            the second. The second expression must be an integer.  (If the\r\n   168\t            second expression is not an integer, a warning is generated and\r\n   169\t            the expression is truncated to get an integer value.)  The scale\r\n   170\t            of the result is scale if the exponent is negative.  If the\r\n   171\t            exponent is positive the scale of the result is the minimum of the\r\n   172\t            scale of the first expression times the value of the exponent and\r\n  "]
[18.937269, "o", " 173\t            the maximum of scale and the scale of the first expression.  (e.g.\r\n   174\t            scale(a^b) = min(scale(a)*b, max( scale, scale(a))).)  It should\r\n   175\t            be noted that expr^0 will always return the value of 1.\r\n   176\t\r\n   177\t     ( expr )\r\n   178\t            This alters the standard precedence to force the evaluation of the\r\n   179\t            expression.\r\n   180\t\r\n   181\t     var = expr\r\n   182\t            The variable is assigned the value of the expression.\r\n   183\t\r\n   184\t     var <op>= expr\r\n   185\t            This is equivalent to \"var = var <op> expr\" with the exception\r\n   186\t            that the \"var\" part is evaluated only once.  This can make a\r\n   187\t            difference if \"var\" is an array.\r\n   188\t\r\n   189\t     Relational expressions are a special kind of expression that always\r\n   190\t     evaluate to 0 or 1, 0 if the relation is false and 1 if the relation is\r\n   191\t     true.  These may appear in any legal expression.  (POSIX bc requires that\r\n   19"]
[18.937277, "o", "2\t     relational expressions are used only in if, while, and for statements and\r\n   193\t     that only one relational test may be done in them.)  The relational\r\n   194\t     operators are\r\n   195\t\r\n   196\t     expr1 < expr2\r\n   197\t            The result is 1 if expr1 is strictly less than expr2.\r\n   198\t\r\n   199\t     expr1 <= expr2\r\n   200\t            The result is 1 if expr1 is less than or equal to expr2.\r\n   201\t\r\n   202\t     expr1 > expr2\r\n   203\t            The result is 1 if expr1 is strictly greater than expr2.\r\n   204\t\r\n   205\t     expr1 >= expr2\r\n   206\t            The result is 1 if expr1 is greater than or equal to expr2.\r\n   207\t\r\n   208\t     expr1 == expr2\r\n   209\t            The result is 1 if expr1 is equal to expr2.\r\n   210\t\r\n   211\t     expr1 != expr2\r\n   212\t            The result is 1 if expr1 is not equal to expr2.\r\n   213\t\r\n   214\t     Boolean operations are also legal.  (POSIX bc does NOT have boolean\r\n   215\t     operations). The result of all boolean operations are 0 and 1 (for false"]
[18.93728, "o", "\r\n   216\t     and true) as in relational expressions.  The boolean operators are:\r\n   217\t\r\n   218\t     !expr  The result is 1 if expr is 0.\r\n   219\t\r\n   220\t     expr && expr\r\n   221\t            The result is 1 if both expressions are non-zero.\r\n   222\t\r\n   223\t     expr || expr\r\n   224\t            The result is 1 if either expression is non-zero.\r\n   225\t\r\n   226\t     The expression precedence is as follows: (lowest to highest)\r\n   227\t            || operator, left associative\r\n   228\t            && operator, left associative\r\n   229\t            ! operator, nonassociative\r\n   230\t            Relational operators, left associative\r\n   231\t            Assignment operator, right associative\r\n   232\t            + and - operators, left associative\r\n   233\t            *, / and % operators, left associative\r\n   234\t            ^ operator, right associative\r\n   235\t            unary - operator, nonassociative\r\n   236\t            ++ and -- operators, nonassociative\r\n   237\t\r\n   238\t     This precedence was chosen so"]
[18.93729, "o", " that POSIX compliant bc programs will run\r\n   239\t     correctly. This will cause the use of the relational and logical\r\n   240\t     operators to have some unusual behavior when used with assignment\r\n   241\t     expressions.  Consider the expression:\r\n   242\t            a = 3 < 5\r\n   243\t\r\n   244\t     Most C programmers would assume this would assign the result of \"3 < 5\"\r\n   245\t     (the value 1) to the variable \"a\".  What this does in bc is assign the\r\n   246\t     value 3 to the variable \"a\" and then compare 3 to 5.  It is best to use\r\n   247\t     parenthesis when using relational and logical operators with the\r\n   248\t     assignment operators.\r\n   249\t\r\n   250\t     There are a few more special expressions that are provided in bc.  These\r\n   251\t     have to do with user defined functions and standard functions.  They all\r\n   252\t     appear as \"name(parameters)\".  See the section on functions for user\r\n   253\t     defined functions.  The standard functions are:\r\n   254\t\r\n   255\t     length ( expression "]
[18.937295, "o", ")\r\n   256\t            The value of the length function is the number of significant\r\n   257\t            digits in the expression.\r\n   258\t\r\n   259\t     read ( )\r\n   260\t            The read function (an extension) will read a number from the\r\n\u001b[?2004hroot@0f57bcdb6b24:/app# "]
[19.276752, "i", "nl -ba /app/docs/bc.txt | sed -n '261,440p'\n"]
[19.279939, "o", "nl -ba /app/docs/bc.txt | sed -n '261,440p'\r\n\u001b[?2004l\r"]
[19.286243, "o", "   261\t            standard input, regardless of where the function occurs.   Beware,\r\n   262\t            this can cause problems with the mixing of data and program in the\r\n   263\t            standard input.  The best use for this function is in a previously\r\n   264\t            written program that needs input from the user, but never allows\r\n   265\t            program code to be input from the user.  The value of the read\r\n   266\t            function is the number read from the standard input using the\r\n   267\t            current value of the variable ibase for the conversion base.\r\n   268\t\r\n   269\t     scale ( expression )\r\n   270\t            The value of the scale function is the number of digits after the\r\n   271\t            decimal point in the expression.\r\n   272\t\r\n   273\t     sqrt ( expression )\r\n   274\t            The value of the sqrt function is the square root of the\r\n   275\t            expression.  If the expression is negative, a run time error is\r\n   276\t            generated.\r\n   277\t\r\n   278\t"]
[19.28626, "o", "   STATEMENTS\r\n   279\t     Statements (as in most algebraic languages) provide the sequencing of\r\n   280\t     expression evaluation.  In bc statements are executed \"as soon as\r\n   281\t     possible.\"  Execution happens when a newline in encountered and there is\r\n   282\t     one or more complete statements.  Due to this immediate execution,\r\n   283\t     newlines are very important in bc. In fact, both a semicolon and a\r\n   284\t     newline are used as statement separators.  An improperly placed newline\r\n   285\t     will cause a syntax error.  Because newlines are statement separators, it\r\n   286\t     is possible to hide a newline by using the backslash character.  The\r\n   287\t     sequence \"\\<nl>\", where <nl> is the newline appears to bc as whitespace\r\n   288\t     instead of a newline.  A statement list is a series of statements\r\n   289\t     separated by semicolons and newlines.  The following is a list of bc\r\n   290\t     statements and what they do: (Things enclosed in brackets ([]) are\r\n   291\t     optional "]
[19.286264, "o", "parts of the statement.)\r\n   292\t\r\n   293\t     expression\r\n   294\t            This statement does one of two things.  If the expression starts\r\n   295\t            with \"<variable> <assignment> ...\", it is considered to be an\r\n   296\t            assignment statement.  If the expression is not an assignment\r\n   297\t            statement, the expression is evaluated and printed to the output.\r\n   298\t            After the number is printed, a newline is printed.  For example,\r\n   299\t            \"a=1\" is an assignment statement and \"(a=1)\" is an expression that\r\n   300\t            has an embedded assignment.  All numbers that are printed are\r\n   301\t            printed in the base specified by the variable obase. The legal\r\n   302\t            values for  obase are 2 through BC_BASE_MAX.  (See the section\r\n   303\t            LIMITS.)  For bases 2 through 16, the usual method of writing\r\n   304\t            numbers is used.  For bases greater than 16, bc uses a multi-\r\n   305\t            character digit method of p"]
[19.286268, "o", "rinting the numbers where each higher\r\n   306\t            base digit is printed as a base 10 number.  The multi-character\r\n   307\t            digits are separated by spaces.  Each digit contains the number of\r\n   308\t            characters required to represent the base ten value of \"obase-1\".\r\n   309\t            Since numbers are of arbitrary precision, some numbers may not be\r\n   310\t            printable on a single output line.  These long numbers will be\r\n   311\t            split across lines using the \"\\\" as the last character on a line.\r\n   312\t            The maximum number of characters printed per line is 70.  Due to\r\n   313\t            the interactive nature of bc, printing a number causes the side\r\n   314\t            effect of assigning the printed value to the special variable\r\n   315\t            last. This allows the user to recover the last value printed\r\n   316\t            without having to retype the expression that printed the number.\r\n   317\t            Assigning to last is legal and will "]
[19.28849, "o", "overwrite the last printed\r\n   318\t            value with the assigned value.  The newly assigned value will\r\n   319\t            remain until the next number is printed or another value is\r\n   320\t            assigned to last.  (Some installations may allow the use of a\r\n   321\t            single period (.) which is not part of a number as a short hand\r\n   322\t            notation for for last.)\r\n   323\t\r\n   324\t     string The string is printed to the output.  Strings start with a double\r\n   325\t            quote character and contain all characters until the next double\r\n   326\t            quote character.  All characters are take literally, including any\r\n   327\t            newline.  No newline character is printed after the string.\r\n   328\t\r\n   329\t     print list\r\n   330\t            The print statement (an extension) provides another method of\r\n   331\t            output.  The \"list\" is a list of strings and expressions separated\r\n   332\t            by commas.  Each string or expression is printed in the "]
[19.288822, "o", "order of\r\n   333\t            the list.  No terminating newline is printed.  Expressions are\r\n   334\t            evaluated and their value is printed and assigned to the variable\r\n   335\t            last. Strings in the print statement are printed to the output and\r\n   336\t            may contain special characters.  Special characters start with the\r\n   337\t            backslash character (\\).  The special characters recognized by bc\r\n   338\t            are \"a\" (alert or bell), \"b\" (backspace), \"f\" (form feed), \"n\"\r\n   339\t            (newline), \"r\" (carriage return), \"q\" (double quote), \"t\" (tab),\r\n   340\t            and \"\\\" (backslash).  Any other character following the backslash\r\n   341\t            will be ignored.\r\n   342\t\r\n   343\t     { statement_list }\r\n   344\t            This is the compound statement.  It allows multiple statements to\r\n   345\t            be grouped together for execution.\r\n   346\t\r\n   347\t     if ( expression ) statement1 [else statement2]\r\n   348\t            The if statement evaluat"]
[19.288841, "o", "es the expression and executes statement1\r\n   349\t            or statement2 depending on the value of the expression.  If the\r\n   350\t            expression is non-zero, statement1 is executed.  If statement2 is\r\n   351\t            present and the value of the expression is 0, then statement2 is\r\n   352\t            executed.  (The else clause is an extension.)\r\n   353\t\r\n   354\t     while ( expression ) statement\r\n   355\t            The while statement will execute the statement while the\r\n   356\t            expression is non-zero.  It evaluates the expression before each\r\n   357\t            execution of the statement.   Termination of the loop is caused by\r\n   358\t            a zero expression value or the execution of a break statement.\r\n   359\t\r\n   360\t     for ( [expression1] ; [expression2] ; [expression3] ) statement\r\n   361\t            The for statement controls repeated execution of the statement.\r\n   362\t            Expression1 is evaluated before the loop.  Expression2 is\r\n   363\t            evaluate"]
[19.288854, "o", "d before each execution of the statement.  If it is non-\r\n   364\t            zero, the statement is evaluated.  If it is zero, the loop is\r\n   365\t            terminated.  After each execution of the statement, expression3 is\r\n   366\t            evaluated before the reevaluation of expression2.  If expression1\r\n   367\t            or expression3 are missing, nothing is evaluated at the point they\r\n   368\t            would be evaluated.  If expression2 is missing, it is the same as\r\n   369\t            substituting the value 1 for expression2.  (The optional\r\n   370\t            expressions are an extension. POSIX bc requires all three\r\n   371\t            expressions.)  The following is equivalent code for the for\r\n   372\t            statement:\r\n   373\t            expression1;\r\n   374\t            while (expression2) {\r\n   375\t               statement;\r\n   376\t               expression3;\r\n   377\t            }\r\n   378\t\r\n   379\t     break  This statement causes a forced exit of the most recent enclosing\r\n   380\t    "]
[19.288871, "o", "        while statement or for statement.\r\n   381\t\r\n   382\t     continue\r\n   383\t            The continue statement (an extension)  causes the most recent\r\n   384\t            enclosing for statement to start the next iteration.\r\n   385\t\r\n   386\t     halt   The halt statement (an extension) is an executed statement that\r\n   387\t            causes the bc processor to quit only when it is executed.  For\r\n   388\t            example, \"if (0 == 1) halt\" will not cause bc to terminate because\r\n   389\t            the halt is not executed.\r\n   390\t\r\n   391\t     return Return the value 0 from a function.  (See the section on\r\n   392\t            functions.)\r\n   393\t\r\n   394\t     return ( expression )\r\n   395\t            Return the value of the expression from a function.  (See the\r\n   396\t            section on functions.)  As an extension, the parenthesis are not\r\n   397\t            required.\r\n   398\t\r\n   399\t   PSEUDO STATEMENTS\r\n   400\t     These statements are not statements in the traditional sense.  They are\r\n   4"]
[19.288882, "o", "01\t     not executed statements.  Their function is performed at \"compile\" time.\r\n   402\t\r\n   403\t     limits Print the local limits enforced by the local version of bc.  This\r\n   404\t            is an extension.\r\n   405\t\r\n   406\t     quit   When the quit statement is read, the bc processor is terminated,\r\n   407\t            regardless of where the quit statement is found.  For example, \"if\r\n   408\t            (0 == 1) quit\" will cause bc to terminate.\r\n   409\t\r\n   410\t     warranty\r\n   411\t            Print a longer warranty notice.  This is an extension.\r\n   412\t\r\n   413\t   FUNCTIONS\r\n   414\t     Functions provide a method of defining a computation that can be executed\r\n   415\t     later.  Functions in bc always compute a value and return it to the\r\n   416\t     caller.  Function definitions are \"dynamic\" in the sense that a function\r\n   417\t     is undefined until a definition is encountered in the input.  That\r\n   418\t     definition is then used until another definition function for the same\r\n   419\t     "]
[19.288893, "o", "name is encountered.  The new definition then replaces the older\r\n   420\t     definition.  A function is defined as follows:\r\n   421\t            define name ( parameters ) { newline\r\n   422\t                auto_list   statement_list }\r\n   423\t     A function call is just an expression of the form \"name(parameters)\".\r\n   424\t\r\n   425\t     Parameters are numbers or arrays (an extension).  In the function\r\n   426\t     definition, zero or more parameters are defined by listing their names\r\n   427\t     separated by commas.  All parameters are call by value parameters.\r\n   428\t     Arrays are specified in the parameter definition by the notation\r\n   429\t     \"name[]\".   In the function call, actual parameters are full expressions\r\n   430\t     for number parameters.  The same notation is used for passing arrays as\r\n   431\t     for defining array parameters.  The named array is passed by value to the\r\n   432\t     function.  Since function definitions are dynamic, parameter numbers and\r\n   433\t     types are checked w"]
[19.288904, "o", "hen a function is called.  Any mismatch in number or\r\n   434\t     types of parameters will cause a runtime error.  A runtime error will\r\n   435\t     also occur for the call to an undefined function.\r\n   436\t\r\n   437\t     The auto_list is an optional list of variables that are for \"local\" use.\r\n   438\t     The syntax of the auto list (if present) is \"auto name, ... ;\".  (The\r\n   439\t     semicolon is optional.)  Each name is the name of an auto variable.\r\n   440\t     Arrays may be specified by using the same notation as used in parameters.\r\n\u001b[?2004hroot@0f57bcdb6b24:/app# "]
[19.653021, "i", "nl -ba /app/docs/bc.txt | sed -n '441,620p'\n"]
[19.654179, "o", "nl -ba /app/docs/bc.txt | sed -n '441,620p'\r\n\u001b[?2004l\r"]
[19.656913, "o", "   441\t     These variables have their values pushed onto a stack at the start of the\r\n   442\t     function.  The variables are then initialized to zero and used throughout\r\n   443\t     the execution of the function.  At function exit, these variables are\r\n   444\t     popped so that the original value (at the time of the function call) of\r\n   445\t     these variables are restored.  The parameters are really auto variables\r\n   446\t     that are initialized to a value provided in the function call.  Auto\r\n   447\t     variables are different than traditional local variables because if\r\n   448\t     function A calls function B, B may access function A's auto variables by\r\n   449\t     just using the same name, unless function B has called them auto\r\n   450\t     variables.  Due to the fact that auto variables and parameters are pushed\r\n   451\t     onto a stack, bc supports recursive functions.\r\n   452\t\r\n   453\t     The function body is a list of bc statements.  Again, statements are\r\n   454\t     separated by semicol"]
[19.656949, "o", "ons or newlines.  Return statements cause the\r\n   455\t     termination of a function and the return of a value.  There are two\r\n   456\t     versions of the return statement.  The first form, \"return\", returns the\r\n   457\t     value 0 to the calling expression.  The second form, \"return ( expression\r\n   458\t     )\", computes the value of the expression and returns that value to the\r\n   459\t     calling expression.  There is an implied \"return (0)\" at the end of every\r\n   460\t     function.  This allows a function to terminate and return 0 without an\r\n   461\t     explicit return statement.\r\n   462\t\r\n   463\t     Functions also change the usage of the variable ibase.  All constants in\r\n   464\t     the function body will be converted using the value of ibase at the time\r\n   465\t     of the function call.  Changes of ibase will be ignored during the\r\n   466\t     execution of the function except for the standard function read, which\r\n   467\t     will always use the current value of ibase for conversion of numbers.\r\n"]
[19.656958, "o", "   468\t\r\n   469\t     Several extensions have been added to functions.  First, the format of\r\n   470\t     the definition has been slightly relaxed.  The standard requires the\r\n   471\t     opening brace be on the same line as the define keyword and all other\r\n   472\t     parts must be on following lines.  This version of bc will allow any\r\n   473\t     number of newlines before and after the opening brace of the function.\r\n   474\t     For example, the following definitions are legal.\r\n   475\t            define d (n) { return (2*n); }\r\n   476\t            define d (n)\r\n   477\t              { return (2*n); }\r\n   478\t\r\n   479\t     Functions may be defined as void.  A void funtion returns no value and\r\n   480\t     thus may not be used in any place that needs a value.  A void function\r\n   481\t     does not produce any output when called by itself on an input line.  The\r\n   482\t     key word void is placed between the key word define and the function\r\n   483\t     name.  For example, consider the following session.\r\n   "]
[19.656966, "o", "484\t            define py (y) { print \"--->\", y, \"<---\", \"\\n\"; }\r\n   485\t            define void px (x) { print \"--->\", x, \"<---\", \"\\n\"; }\r\n   486\t            py(1)\r\n   487\t            --->1<---\r\n   488\t            0\r\n   489\t            px(1)\r\n   490\t            --->1<---\r\n   491\t     Since py is not a void function, the call of py(1) prints the desired\r\n   492\t     output and then prints a second line that is the value of the function.\r\n   493\t     Since the value of a function that is not given an explicit return\r\n   494\t     statement is zero, the zero is printed.  For px(1), no zero is printed\r\n   495\t     because the function is a void function.\r\n   496\t\r\n   497\t     Also, call by variable for arrays was added.  To declare a call by\r\n   498\t     variable array, the declaration of the array parameter in the function\r\n   499\t     definition looks like \"*name[]\".  The call to the function remains the\r\n   500\t     same as call by value arrays.\r\n   501\t\r\n   502\t   MATH LIBRARY\r\n   503\t     If bc is invoked w"]
[19.657588, "o", "ith the -l option, a math library is preloaded and the\r\n   504\t     default scale is set to 20.   The math functions will calculate their\r\n   505\t     results to the scale set at the time of their call.  The math library\r\n   506\t     defines the following functions:\r\n   507\t\r\n   508\t     s (x)  The sine of x, x is in radians.\r\n   509\t\r\n   510\t     c (x)  The cosine of x, x is in radians.\r\n   511\t\r\n   512\t     a (x)  The arctangent of x, arctangent returns radians.\r\n   513\t\r\n   514\t     l (x)  The natural logarithm of x.\r\n   515\t\r\n   516\t     e (x)  The exponential function of raising e to the value x.\r\n   517\t\r\n   518\t     j (n,x)\r\n   519\t            The Bessel function of integer order n of x.\r\n   520\t\r\n   521\t   EXAMPLES\r\n   522\t     In /bin/sh,  the following will assign the value of \"pi\" to the shell\r\n   523\t     variable pi.\r\n   524\t             pi=$(echo \"scale=10; 4*a(1)\" | bc -l)\r\n   525\t\r\n   526\t     The following is the definition of the exponential function used in the\r\n   527\t     math library.  T"]
[19.657609, "o", "his function is written in POSIX bc.\r\n   528\t            scale = 20\r\n   529\t\r\n   530\t            /* Uses the fact that e^x = (e^(x/2))^2\r\n   531\t               When x is small enough, we use the series:\r\n   532\t                 e^x = 1 + x + x^2/2! + x^3/3! + ...\r\n   533\t            */\r\n   534\t\r\n   535\t            define e(x) {\r\n   536\t              auto  a, d, e, f, i, m, v, z\r\n   537\t\r\n   538\t              /* Check the sign of x. */\r\n   539\t              if (x<0) {\r\n   540\t                m = 1\r\n   541\t                x = -x\r\n   542\t              }\r\n   543\t\r\n   544\t              /* Precondition x. */\r\n   545\t              z = scale;\r\n   546\t              scale = 4 + z + .44*x;\r\n   547\t              while (x > 1) {\r\n   548\t                f += 1;\r\n   549\t                x /= 2;\r\n   550\t              }\r\n   551\t\r\n   552\t              /* Initialize the variables. */\r\n   553\t              v = 1+x\r\n   554\t              a = x\r\n   555\t              d = 1\r\n   556\t\r\n   557\t              for (i=2; 1; i++) {\r\n   558\t  "]
[19.657613, "o", "              e = (a *= x) / (d *= i)\r\n   559\t                if (e == 0) {\r\n   560\t                  if (f>0) while (f--)  v = v*v;\r\n   561\t                  scale = z\r\n   562\t                  if (m) return (1/v);\r\n   563\t                  return (v/1);\r\n   564\t                }\r\n   565\t                v += e\r\n   566\t              }\r\n   567\t            }\r\n   568\t\r\n   569\t     The following is code that uses the extended features of bc to implement\r\n   570\t     a simple program for calculating checkbook balances.  This program is\r\n   571\t     best kept in a file so that it can be used many times without having to\r\n   572\t     retype it at every use.\r\n   573\t            scale=2\r\n   574\t            print \"\\nCheck book program!\\n\"\r\n   575\t            print \"  Remember, deposits are negative transactions.\\n\"\r\n   576\t            print \"  Exit by a 0 transaction.\\n\\n\"\r\n   577\t\r\n   578\t            print \"Initial balance? \"; bal = read()\r\n   579\t            bal /= 1\r\n   580\t            print \"\\n\"\r\n   581\t           "]
[19.657616, "o", " while (1) {\r\n   582\t              \"current balance = \"; bal\r\n   583\t              \"transaction? \"; trans = read()\r\n   584\t              if (trans == 0) break;\r\n   585\t              bal -= trans\r\n   586\t              bal /= 1\r\n   587\t            }\r\n   588\t            quit\r\n   589\t\r\n   590\t     The following is the definition of the recursive factorial function.\r\n   591\t            define f (x) {\r\n   592\t              if (x <= 1) return (1);\r\n   593\t              return (f(x-1) * x);\r\n   594\t            }\r\n   595\t\r\n   596\t   READLINE AND LIBEDIT OPTIONS\r\n   597\t     GNU bc can be compiled (via a configure option) to use the GNU readline\r\n   598\t     input editor library or the BSD libedit library.  This allows the user to\r\n   599\t     do editing of lines before sending them to bc.  It also allows for a\r\n   600\t     history of previous lines typed.  When this option is selected, bc has\r\n   601\t     one more special variable.  This special variable, history is the number\r\n   602\t     of lines of history retaine"]
[19.658102, "o", "d.  For readline, a value of -1 means that an\r\n   603\t     unlimited number of history lines are retained.  Setting the value of\r\n   604\t     history to a positive number restricts the number of history lines to the\r\n   605\t     number given.  The value of 0 disables the history feature.  The default\r\n   606\t     value is 100. For more information, read the user manuals for the GNU\r\n   607\t     readline, history and BSD libedit libraries.  One can not enable both\r\n   608\t     readline and libedit at the same time.\r\n   609\t\r\n   610\t   DIFFERENCES\r\n   611\t     This version of bc was implemented from the POSIX P1003.2/D11 draft and\r\n   612\t     contains several differences and extensions relative to the draft and\r\n   613\t     traditional implementations.  It is not implemented in the traditional\r\n   614\t     way using dc(1).  This version is a single process which parses and runs\r\n   615\t     a byte code translation of the program.  There is an \"undocumented\"\r\n   616\t     option (-c) that causes the program to o"]
[19.658113, "o", "utput the byte code to the\r\n   617\t     standard output instead of running it.  It was mainly used for debugging\r\n   618\t     the parser and preparing the math library.\r\n   619\t\r\n   620\t     A major source of differences is extensions, where a feature is extended\r\n\u001b[?2004hroot@0f57bcdb6b24:/app# "]
[24.493204, "i", "sed -n '180,380p' /app/docs/bc.txt\n"]
[24.493835, "o", "sed -n '180,380p' /app/docs/bc.txt\r\n\u001b[?2004l\r"]
[24.495973, "o", "\r\n     var = expr\r\n            The variable is assigned the value of the expression.\r\n\r\n     var <op>= expr\r\n            This is equivalent to \"var = var <op> expr\" with the exception\r\n            that the \"var\" part is evaluated only once.  This can make a\r\n            difference if \"var\" is an array.\r\n\r\n     Relational expressions are a special kind of expression that always\r\n     evaluate to 0 or 1, 0 if the relation is false and 1 if the relation is\r\n     true.  These may appear in any legal expression.  (POSIX bc requires that\r\n     relational expressions are used only in if, while, and for statements and\r\n     that only one relational test may be done in them.)  The relational\r\n     operators are\r\n\r\n     expr1 < expr2\r\n            The result is 1 if expr1 is strictly less than expr2.\r\n\r\n     expr1 <= expr2\r\n            The result is 1 if expr1 is less than or equal to expr2.\r\n\r\n     expr1 > expr2\r\n            The result is 1 if expr1 is strictly greater than expr2.\r\n\r\n     expr1 >= expr2\r\n            Th"]
[24.496012, "o", "e result is 1 if expr1 is greater than or equal to expr2.\r\n\r\n     expr1 == expr2\r\n            The result is 1 if expr1 is equal to expr2.\r\n\r\n     expr1 != expr2\r\n            The result is 1 if expr1 is not equal to expr2.\r\n\r\n     Boolean operations are also legal.  (POSIX bc does NOT have boolean\r\n     operations). The result of all boolean operations are 0 and 1 (for false\r\n     and true) as in relational expressions.  The boolean operators are:\r\n\r\n     !expr  The result is 1 if expr is 0.\r\n\r\n     expr && expr\r\n            The result is 1 if both expressions are non-zero.\r\n\r\n     expr || expr\r\n            The result is 1 if either expression is non-zero.\r\n\r\n     The expression precedence is as follows: (lowest to highest)\r\n            || operator, left associative\r\n            && operator, left associative\r\n            ! operator, nonassociative\r\n            Relational operators, left associative\r\n            Assignment operator, right associative\r\n            + and - operators, left associative\r\n           "]
[24.496022, "o", " *, / and % operators, left associative\r\n            ^ operator, right associative\r\n            unary - operator, nonassociative\r\n            ++ and -- operators, nonassociative\r\n\r\n     This precedence was chosen so that POSIX compliant bc programs will run\r\n     correctly. This will cause the use of the relational and logical\r\n     operators to have some unusual behavior when used with assignment\r\n     expressions.  Consider the expression:\r\n            a = 3 < 5\r\n\r\n     Most C programmers would assume this would assign the result of \"3 < 5\"\r\n     (the value 1) to the variable \"a\".  What this does in bc is assign the\r\n     value 3 to the variable \"a\" and then compare 3 to 5.  It is best to use\r\n     parenthesis when using relational and logical operators with the\r\n     assignment operators.\r\n\r\n     There are a few more special expressions that are provided in bc.  These\r\n     have to do with user defined functions and standard functions.  They all\r\n     appear as \"name(parameters)\".  See the section on funct"]
[24.496029, "o", "ions for user\r\n     defined functions.  The standard functions are:\r\n\r\n     length ( expression )\r\n            The value of the length function is the number of significant\r\n            digits in the expression.\r\n\r\n     read ( )\r\n            The read function (an extension) will read a number from the\r\n            standard input, regardless of where the function occurs.   Beware,\r\n            this can cause problems with the mixing of data and program in the\r\n            standard input.  The best use for this function is in a previously\r\n            written program that needs input from the user, but never allows\r\n            program code to be input from the user.  The value of the read\r\n            function is the number read from the standard input using the\r\n            current value of the variable ibase for the conversion base.\r\n\r\n     scale ( expression )\r\n            The value of the scale function is the number of digits after the\r\n            decimal point in the expression.\r\n\r\n     sqrt ( expressi"]
[24.496403, "o", "on )\r\n            The value of the sqrt function is the square root of the\r\n            expression.  If the expression is negative, a run time error is\r\n            generated.\r\n\r\n   STATEMENTS\r\n     Statements (as in most algebraic languages) provide the sequencing of\r\n     expression evaluation.  In bc statements are executed \"as soon as\r\n     possible.\"  Execution happens when a newline in encountered and there is\r\n     one or more complete statements.  Due to this immediate execution,\r\n     newlines are very important in bc. In fact, both a semicolon and a\r\n     newline are used as statement separators.  An improperly placed newline\r\n     will cause a syntax error.  Because newlines are statement separators, it\r\n     is possible to hide a newline by using the backslash character.  The\r\n     sequence \"\\<nl>\", where <nl> is the newline appears to bc as whitespace\r\n     instead of a newline.  A statement list is a series of statements\r\n     separated by semicolons and newlines.  The following is a list of bc\r"]
[24.496416, "o", "\n     statements and what they do: (Things enclosed in brackets ([]) are\r\n     optional parts of the statement.)\r\n\r\n     expression\r\n            This statement does one of two things.  If the expression starts\r\n            with \"<variable> <assignment> ...\", it is considered to be an\r\n            assignment statement.  If the expression is not an assignment\r\n            statement, the expression is evaluated and printed to the output.\r\n            After the number is printed, a newline is printed.  For example,\r\n            \"a=1\" is an assignment statement and \"(a=1)\" is an expression that\r\n            has an embedded assignment.  All numbers that are printed are\r\n            printed in the base specified by the variable obase. The legal\r\n            values for  obase are 2 through BC_BASE_MAX.  (See the section\r\n            LIMITS.)  For bases 2 through 16, the usual method of writing\r\n            numbers is used.  For bases greater than 16, bc uses a multi-\r\n            character digit method of printing th"]
[24.496423, "o", "e numbers where each higher\r\n            base digit is printed as a base 10 number.  The multi-character\r\n            digits are separated by spaces.  Each digit contains the number of\r\n            characters required to represent the base ten value of \"obase-1\".\r\n            Since numbers are of arbitrary precision, some numbers may not be\r\n            printable on a single output line.  These long numbers will be\r\n            split across lines using the \"\\\" as the last character on a line.\r\n            The maximum number of characters printed per line is 70.  Due to\r\n            the interactive nature of bc, printing a number causes the side\r\n            effect of assigning the printed value to the special variable\r\n            last. This allows the user to recover the last value printed\r\n            without having to retype the expression that printed the number.\r\n            Assigning to last is legal and will overwrite the last printed\r\n            value with the assigned value.  The newly assigned valu"]
[24.49643, "o", "e will\r\n            remain until the next number is printed or another value is\r\n            assigned to last.  (Some installations may allow the use of a\r\n            single period (.) which is not part of a number as a short hand\r\n            notation for for last.)\r\n\r\n     string The string is printed to the output.  Strings start with a double\r\n            quote character and contain all characters until the next double\r\n            quote character.  All characters are take literally, including any\r\n            newline.  No newline character is printed after the string.\r\n\r\n     print list\r\n            The print statement (an extension) provides another method of\r\n            output.  The \"list\" is a list of strings and expressions separated\r\n            by commas.  Each string or expression is printed in the order of\r\n            the list.  No terminating newline is printed.  Expressions are\r\n            evaluated and their value is printed and assigned to the variable\r\n            last. Strings in the p"]
[24.496808, "o", "rint statement are printed to the output and\r\n            may contain special characters.  Special characters start with the\r\n            backslash character (\\).  The special characters recognized by bc\r\n            are \"a\" (alert or bell), \"b\" (backspace), \"f\" (form feed), \"n\"\r\n            (newline), \"r\" (carriage return), \"q\" (double quote), \"t\" (tab),\r\n            and \"\\\" (backslash).  Any other character following the backslash\r\n            will be ignored.\r\n\r\n     { statement_list }\r\n            This is the compound statement.  It allows multiple statements to\r\n            be grouped together for execution.\r\n\r\n     if ( expression ) statement1 [else statement2]\r\n            The if statement evaluates the expression and executes statement1\r\n            or statement2 depending on the value of the expression.  If the\r\n            expression is non-zero, statement1 is executed.  If statement2 is\r\n            present and the value of the expression is 0, then statement2 is\r\n            executed.  (The else c"]
[24.496832, "o", "lause is an extension.)\r\n\r\n     while ( expression ) statement\r\n            The while statement will execute the statement while the\r\n            expression is non-zero.  It evaluates the expression before each\r\n            execution of the statement.   Termination of the loop is caused by\r\n            a zero expression value or the execution of a break statement.\r\n\r\n     for ( [expression1] ; [expression2] ; [expression3] ) statement\r\n            The for statement controls repeated execution of the statement.\r\n            Expression1 is evaluated before the loop.  Expression2 is\r\n            evaluated before each execution of the statement.  If it is non-\r\n            zero, the statement is evaluated.  If it is zero, the loop is\r\n            terminated.  After each execution of the statement, expression3 is\r\n            evaluated before the reevaluation of expression2.  If expression1\r\n            or expression3 are missing, nothing is evaluated at the point they\r\n            would be evaluated.  If expressi"]
[24.496923, "o", "on2 is missing, it is the same as\r\n            substituting the value 1 for expression2.  (The optional\r\n            expressions are an extension. POSIX bc requires all three\r\n            expressions.)  The following is equivalent code for the for\r\n            statement:\r\n            expression1;\r\n            while (expression2) {\r\n               statement;\r\n               expression3;\r\n            }\r\n\r\n     break  This statement causes a forced exit of the most recent enclosing\r\n            while statement or for statement.\r\n\u001b[?2004hroot@0f57bcdb6b24:/app# "]
[28.688323, "i", "sed -n '285,410p' /app/docs/bc.txt\n"]
[28.71157, "o", "sed -n '285,410p' /app/docs/bc.txt\r\n\u001b[?2004l\r     will cause a syntax error.  Because newlines are statement separators, it\r\n     is possible to hide a newline by using the backslash character.  The\r\n     sequence \"\\<nl>\", where <nl> is the newline appears to bc as whitespace\r\n     instead of a newline.  A statement list is a series of statements\r\n     separated by semicolons and newlines.  The following is a list of bc\r\n     statements and what they do: (Things enclosed in brackets ([]) are\r\n     optional parts of the statement.)\r\n\r\n     expression\r\n            This statement does one of two things.  If the expression starts\r\n            with \"<variable> <assignment> ...\", it is considered to be an\r\n            assignment statement.  If the expression is not an assignment\r\n            statement, the expression is evaluated and printed to the output.\r\n            After the number is printed, a newline is printed.  For example,\r\n            \"a=1\" is an assignment statement and \"(a=1)\" is an expression that\r\n  "]
[28.711615, "o", "          has an embedded assignment.  All numbers that are printed are\r\n            printed in the base specified by the variable obase. The legal\r\n            values for  obase are 2 through BC_BASE_MAX.  (See the section\r\n            LIMITS.)  For bases 2 through 16, the usual method of writing\r\n            numbers is used.  For bases greater than 16, bc uses a multi-\r\n            character digit method of printing the numbers where each higher\r\n            base digit is printed as a base 10 number.  The multi-character\r\n            digits are separated by spaces.  Each digit contains the number of\r\n            characters required to represent the base ten value of \"obase-1\".\r\n            Since numbers are of arbitrary precision, some numbers may not be\r\n            printable on a single output line.  These long numbers will be\r\n            split across lines using the \"\\\" as the last character on a line.\r\n            The maximum number of characters printed per line is 70.  Due to\r\n            the interac"]
[28.711624, "o", "tive nature of bc, printing a number causes the side\r\n            effect of assigning the printed value to the special variable\r\n            last. This allows the user to recover the last value printed\r\n            without having to retype the expression that printed the number.\r\n            Assigning to last is legal and will overwrite the last printed\r\n            value with the assigned value.  The newly assigned value will\r\n            remain until the next number is printed or another value is\r\n            assigned to last.  (Some installations may allow the use of a\r\n            single period (.) which is not part of a number as a short hand\r\n            notation for for last.)\r\n\r\n     string The string is printed to the output.  Strings start with a double\r\n            quote character and contain all characters until the next double\r\n            quote character.  All characters are take literally, including any\r\n            newline.  No newline character is printed after the string.\r\n\r\n     print list\r"]
[28.711633, "o", "\n            The print statement (an extension) provides another method of\r\n            output.  The \"list\" is a list of strings and expressions separated\r\n            by commas.  Each string or expression is printed in the order of\r\n            the list.  No terminating newline is printed.  Expressions are\r\n            evaluated and their value is printed and assigned to the variable\r\n            last. Strings in the print statement are printed to the output and\r\n            may contain special characters.  Special characters start with the\r\n            backslash character (\\).  The special characters recognized by bc\r\n            are \"a\" (alert or bell), \"b\" (backspace), \"f\" (form feed), \"n\"\r\n            (newline), \"r\" (carriage return), \"q\" (double quote), \"t\" (tab),\r\n            and \"\\\" (backslash).  Any other character following the backslash\r\n            will be ignored.\r\n\r\n     { statement_list }\r\n            This is the compound statement.  It allows multiple statements to\r\n            be grouped tog"]
[28.713896, "o", "ether for execution.\r\n\r\n     if ( expression ) statement1 [else statement2]\r\n            The if statement evaluates the expression and executes statement1\r\n            or statement2 depending on the value of the expression.  If the\r\n            expression is non-zero, statement1 is executed.  If statement2 is\r\n            present and the value of the expression is 0, then statement2 is\r\n            executed.  (The else clause is an extension.)\r\n\r\n     while ( expression ) statement\r\n            The while statement will execute the statement while the\r\n            expression is non-zero.  It evaluates the expression before each\r\n            execution of the statement.   Termination of the loop is caused by\r\n            a zero expression value or the execution of a break statement.\r\n\r\n     for ( [expression1] ; [expression2] ; [expression3] ) statement\r\n            The for statement controls repeated execution of the statement.\r\n            Expression1 is evaluated before the loop.  Expression2 is\r\n            "]
[28.713916, "o", "evaluated before each execution of the statement.  If it is non-\r\n            zero, the statement is evaluated.  If it is zero, the loop is\r\n            terminated.  After each execution of the statement, expression3 is\r\n            evaluated before the reevaluation of expression2.  If expression1\r\n            or expression3 are missing, nothing is evaluated at the point they\r\n            would be evaluated.  If expression2 is missing, it is the same as\r\n            substituting the value 1 for expression2.  (The optional\r\n            expressions are an extension. POSIX bc requires all three\r\n            expressions.)  The following is equivalent code for the for\r\n            statement:\r\n            expression1;\r\n            while (expression2) {\r\n               statement;\r\n               expression3;\r\n            }\r\n\r\n     break  This statement causes a forced exit of the most recent enclosing\r\n            while statement or for statement.\r\n\r\n     continue\r\n            The continue statement (an extension)  "]
[28.713924, "o", "causes the most recent\r\n            enclosing for statement to start the next iteration.\r\n\r\n     halt   The halt statement (an extension) is an executed statement that\r\n            causes the bc processor to quit only when it is executed.  For\r\n            example, \"if (0 == 1) halt\" will not cause bc to terminate because\r\n            the halt is not executed.\r\n\r\n     return Return the value 0 from a function.  (See the section on\r\n            functions.)\r\n\r\n     return ( expression )\r\n            Return the value of the expression from a function.  (See the\r\n            section on functions.)  As an extension, the parenthesis are not\r\n            required.\r\n\r\n   PSEUDO STATEMENTS\r\n     These statements are not statements in the traditional sense.  They are\r\n     not executed statements.  Their function is performed at \"compile\" time.\r\n\r\n     limits Print the local limits enforced by the local version of bc.  This\r\n            is an extension.\r\n\r\n     quit   When the quit statement is read, the bc processor i"]
[28.713931, "o", "s terminated,\r\n            regardless of where the quit statement is found.  For example, \"if\r\n            (0 == 1) quit\" will cause bc to terminate.\r\n\r\n     warranty\r\n\u001b[?2004hroot@0f57bcdb6b24:/app# "]
[29.389028, "i", "sed -n '410,510p' /app/docs/bc.txt\n"]
[29.39104, "o", "sed -n '410,510p' /app/docs/bc.txt\r\n\u001b[?2004l\r"]
[29.396569, "o", "     warranty\r\n            Print a longer warranty notice.  This is an extension.\r\n\r\n   FUNCTIONS\r\n     Functions provide a method of defining a computation that can be executed\r\n     later.  Functions in bc always compute a value and return it to the\r\n     caller.  Function definitions are \"dynamic\" in the sense that a function\r\n     is undefined until a definition is encountered in the input.  That\r\n     definition is then used until another definition function for the same\r\n     name is encountered.  The new definition then replaces the older\r\n     definition.  A function is defined as follows:\r\n            define name ( parameters ) { newline\r\n                auto_list   statement_list }\r\n     A function call is just an expression of the form \"name(parameters)\".\r\n\r\n     Parameters are numbers or arrays (an extension).  In the function\r\n     definition, zero or more parameters are defined by listing their names\r\n     separated by commas.  All parameters are call by value parameters.\r\n     Arrays are specif"]
[29.396608, "o", "ied in the parameter definition by the notation\r\n     \"name[]\".   In the function call, actual parameters are full expressions\r\n     for number parameters.  The same notation is used for passing arrays as\r\n     for defining array parameters.  The named array is passed by value to the\r\n     function.  Since function definitions are dynamic, parameter numbers and\r\n     types are checked when a function is called.  Any mismatch in number or\r\n     types of parameters will cause a runtime error.  A runtime error will\r\n     also occur for the call to an undefined function.\r\n\r\n     The auto_list is an optional list of variables that are for \"local\" use.\r\n     The syntax of the auto list (if present) is \"auto name, ... ;\".  (The\r\n     semicolon is optional.)  Each name is the name of an auto variable.\r\n     Arrays may be specified by using the same notation as used in parameters.\r\n     These variables have their values pushed onto a stack at the start of the\r\n     function.  The variables are then initialized to zero"]
[29.396616, "o", " and used throughout\r\n     the execution of the function.  At function exit, these variables are\r\n     popped so that the original value (at the time of the function call) of\r\n     these variables are restored.  The parameters are really auto variables\r\n     that are initialized to a value provided in the function call.  Auto\r\n     variables are different than traditional local variables because if\r\n     function A calls function B, B may access function A's auto variables by\r\n     just using the same name, unless function B has called them auto\r\n     variables.  Due to the fact that auto variables and parameters are pushed\r\n     onto a stack, bc supports recursive functions.\r\n\r\n     The function body is a list of bc statements.  Again, statements are\r\n     separated by semicolons or newlines.  Return statements cause the\r\n     termination of a function and the return of a value.  There are two\r\n     versions of the return statement.  The first form, \"return\", returns the\r\n     value 0 to the calling expressi"]
[29.396623, "o", "on.  The second form, \"return ( expression\r\n     )\", computes the value of the expression and returns that value to the\r\n     calling expression.  There is an implied \"return (0)\" at the end of every\r\n     function.  This allows a function to terminate and return 0 without an\r\n     explicit return statement.\r\n\r\n     Functions also change the usage of the variable ibase.  All constants in\r\n     the function body will be converted using the value of ibase at the time\r\n     of the function call.  Changes of ibase will be ignored during the\r\n     execution of the function except for the standard function read, which\r\n     will always use the current value of ibase for conversion of numbers.\r\n\r\n     Several extensions have been added to functions.  First, the format of\r\n     the definition has been slightly relaxed.  The standard requires the\r\n     opening brace be on the same line as the define keyword and all other\r\n     parts must be on following lines.  This version of bc will allow any\r\n     number of newlin"]
[29.397327, "o", "es before and after the opening brace of the function.\r\n     For example, the following definitions are legal.\r\n            define d (n) { return (2*n); }\r\n            define d (n)\r\n              { return (2*n); }\r\n\r\n     Functions may be defined as void.  A void funtion returns no value and\r\n     thus may not be used in any place that needs a value.  A void function\r\n     does not produce any output when called by itself on an input line.  The\r\n     key word void is placed between the key word define and the function\r\n     name.  For example, consider the following session.\r\n            define py (y) { print \"--->\", y, \"<---\", \"\\n\"; }\r\n            define void px (x) { print \"--->\", x, \"<---\", \"\\n\"; }\r\n            py(1)\r\n            --->1<---\r\n            0\r\n            px(1)\r\n            --->1<---\r\n     Since py is not a void function, the call of py(1) prints the desired\r\n     output and then prints a second line that is the value of the function.\r\n     Since the value of a function that is not given an exp"]
[29.397542, "o", "licit return\r\n     statement is zero, the zero is printed.  For px(1), no zero is printed\r\n     because the function is a void function.\r\n\r\n     Also, call by variable for arrays was added.  To declare a call by\r\n     variable array, the declaration of the array parameter in the function\r\n     definition looks like \"*name[]\".  The call to the function remains the\r\n     same as call by value arrays.\r\n\r\n   MATH LIBRARY\r\n     If bc is invoked with the -l option, a math library is preloaded and the\r\n     default scale is set to 20.   The math functions will calculate their\r\n     results to the scale set at the time of their call.  The math library\r\n     defines the following functions:\r\n\r\n     s (x)  The sine of x, x is in radians.\r\n\r\n     c (x)  The cosine of x, x is in radians.\r\n\u001b[?2004hroot@0f57bcdb6b24:/app# "]
[98.439887, "i", "cat > /app/pybc/bc.py <<'PY'\r#!/usr/bin/env python3\r\"\"\"A small, pure Python implementation of the GNU bc language.\"\"\"\rimport sys, math\rfrom dataclasses import dataclass\r\rP10=[1]\rdef p10(n):\r    while len(P10)<=n: P10.append(P10[-1]*10)\r    return P10[n]\rdef truncdiv(a,b):\r    if b==0: raise BCRuntime()\r    q=abs(a)//abs(b)\r    return -q if (a<0) != (b<0) else q\r\r@dataclass(frozen=True)\rclass Num:\r    v:int=0; s:int=0\r    def integer(self): return truncdiv(self.v,p10(self.s))\r    def truth(self): return self.v!=0\r\rdef align(a,b):\r    s=max(a.s,b.s); return a.v*p10(s-a.s),b.v*p10(s-b.s),s\rdef add(a,b):\r    x,y,s=align(a,b); return Num(x+y,s)\rdef sub(a,b):\r    x,y,s=align(a,b); return Num(x-y,s)\rdef neg(a): return Num(-a.v,a.s)\rdef mul(a,b,sc):\r    raw=a.v*b.v; rs=a.s+b.s\r    out=min(rs,max(sc,a.s,b.s))\r    return Num(truncdiv(raw,p10(rs-out)),out)\rdef div(a,b,sc):\r    if b.v==0: raise BCRuntime()\r    # (a.v/10^as)/(b.v/10^bs), represented at sc\r    shift=sc+b.s-a.s\r    if shift>=0: v=truncdiv(a.v*p10(shift),b.v"]
