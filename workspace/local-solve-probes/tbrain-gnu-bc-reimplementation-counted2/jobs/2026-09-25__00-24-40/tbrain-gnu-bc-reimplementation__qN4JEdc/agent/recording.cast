[8.859123, "o", "grep -nE '^(SYNTAX|NUMBERS|VARIABLES|EXPRESSIONS|STATEMENTS|FUNCTIONS|MATH LIBRARY|GRAMMAR|[A-Z][A-Z ]+)$' /app/docs/bc.txt | head -80"]
