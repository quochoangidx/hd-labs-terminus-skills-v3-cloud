[8.560879, "o", "sed -n '1,240p' /app/pybc/bc.py 2>/dev/null || true\r\n\u001b[?2004l\r\"\"\"pybc: a GNU bc 1.07.1 replacement in pure Python.\r\n\r\nUsage: python3 /app/pybc/bc.py [FILE]...\r\n\"\"\"\r\n\r\nimport sys\r\n\r\n\r\ndef main(argv):\r\n    sys.stderr.write(\"pybc: not implemented yet\\n\")\r\n    return 1\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main(sys.argv[1:]))\r\n"]
