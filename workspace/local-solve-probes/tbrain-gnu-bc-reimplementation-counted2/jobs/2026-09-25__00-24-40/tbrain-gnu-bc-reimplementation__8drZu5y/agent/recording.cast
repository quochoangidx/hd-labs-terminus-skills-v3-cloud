[74.55773, "i", "nd not (end and self.pk(end)):\r            a.append(self.stmt()); self.seps()\r        return a\r    def stmt(self):\r        if self.pk('{'):\r            self.pop(); a=self.program('}'); self.pop('}'); return ('block',a)\r        if self.pk('ID'):\r            w=self.pk()[1]\r            if w=='define': return self.func()\r            if w=='if':\r                self.pop(); self.softnl(); self.pop('('); e=self.expr(); self.pop(')'); self.softnl(); a=self.stmt()\r                save=self.i; self.seps()\r                if self.pk('ID') and self.pk()[1]=='else': self.pop(); self.softnl(); b=self.stmt()\r                else: self.i=save; b=None\r                return ('if',e,a,b)\r            if w=='while':\r                self.pop(); self.softnl(); self.pop('('); e=self.expr(); self.pop(')'); self.softnl(); return ('while',e,self.stmt())\r            if w=='for':\r                self.pop(); self.softnl(); self.pop('(')\r                a=None if self.pk(';') else self.expr(); self.pop(';')\r                b=None if self."]
