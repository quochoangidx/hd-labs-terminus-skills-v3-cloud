[74.740821, "o", "   except SyntaxError:return\r\n\u001b[?2004l\r\u001b[?2004h>     for st in ss:\r\n\u001b[?2004l\r\u001b[?2004h>         try:vm.stmt(st)\r\n\u001b[?2004l\r\u001b[?2004h>         except RunError:continue\r\n\u001b[?2004l\r\u001b[?2004h>         except Flow:continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def main(argv):\r\n\u001b[?2004l\r\u001b[?2004h>     vm=VM()\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         for fn in argv:\r\n\u001b[?2004l\r\u001b[?2004h>             with open(fn,encoding='latin1') as f:run_source(vm,f.read())\r\n\u001b[?2004l\r\u001b[?2004h>         if not vm.stopped:run_source(vm,sys.stdin.read())\r\n\u001b[?2004l\r\u001b[?2004h>     except Halt:pass\r\n\u001b[?2004l\r\u001b[?2004h>     except (OSError,KeyboardInterrupt):return 1\r\n\u001b[?2004l\r\u001b[?2004h>     return 0\r\n\u001b[?2004l\r\u001b[?2004h> if __name__=='__main__':sys.exit(main(sys.argv[1:]))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
