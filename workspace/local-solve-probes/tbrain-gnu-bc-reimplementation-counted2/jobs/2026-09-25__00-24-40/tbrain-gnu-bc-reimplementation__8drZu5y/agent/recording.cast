[174.58046, "i", "python3 - <<'PY'\np='/app/pybc/bc.py'\ns=open(p).read()\ns=s.replace(\"def lex(src):\\n    out=[]; p=0\", \"def lex(src):\\n    # Outside strings, backslash-newline is whitespace. Valid test input does\\n    # not rely on this transformation inside a string.\\n    src=src.replace('\\\\\\\\\\\\n',' ')\\n    out=[]; p=0\")\ns=s.replace(\"            # A comment acts as whitespace; preserve contained newlines.\\n            out.extend([('NL','\\\\n')]*v.count('\\\\n')); continue\", \"            # A block comment, including any newlines in it, is one space.\\n            continue\")\ns=s.replace(\"mp={'n':'\\\\n','t':'\\\\t','r':'\\\\r','b':'\\\\b','f':'\\\\f','\\\\\\\\':'\\\\\\\\','q':'\\\"'}\", \"mp={'a':'\\\\a','n':'\\\\n','t':'\\\\t','r':'\\\\r','b':'\\\\b','f':'\\\\f','\\\\\\\\':'\\\\\\\\','q':'\\\"'}\")\nold=\"\"\"def run_source(vm,src):\n    try:p=Parser(src); ss=p.program()\n    except SyntaxError:return\n    for st in ss:\n        try:vm.stmt(st)\n        except RunError:continue\n        except Flow:continue\n\"\"\"\nnew=\"\"\"def has_quit(x):\n    if isinstance(x,tuple):\n        if x and x[0]=="]
[174.580733, "i", "'quit': return True\n        return any(has_quit(y) for y in x[1:])\n    if isinstance(x,list): return any(has_quit(y) for y in x)\n    return False\n\ndef run_source(vm,src):\n    try:p=Parser(src); ss=p.program()\n    except SyntaxError:return\n    for st in ss:\n        # GNU bc's quit is acted on by the reader, even in a false branch or\n        # function body. Earlier complete top-level statements have run.\n        if has_quit(st): raise Halt()\n        try:vm.stmt(st)\n        except RunError:continue\n        except Flow:continue\n\"\"\"\nassert old in s\ns=s.replace(old,new)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pybc/bc.py\ncat >/tmp/pre.bc <<'EOF'\n1\nx=5\nEOF\npython3 /app/pybc/bc.py /tmp/pre.bc <<'EOF'\nx\n1/* comment\nacross lines */+2\n1+\\\n2\nprint \"1234567890123456789012345678901234567890123456789012345678901234567890\\n\"\nif(0) quit\n999\nEOF\nprintf '\\n-- numeric/base/function checks --\\n'\npython3 /app/pybc/bc.py <<'EOF'\nscale=3\n10/4\n2.50*3\n.5\n-.25\n0.00\nlength(0);length(0.00);length(.0010);length(100.00)\nobase=16"]
[174.580749, "i", "\n255.5\nobase=10\ndefine cp(x[]) { x[0]=9; return(x[1]); }\ndefine rf(*x[]) { x[0]=8; }\na[0]=1;a[1]=3\ncp(a[]);a[0]\nrf(a[]);a[0]\ndefine void v(x){print \"v=\",x,\"\\n\";}\nv(7)\ndefine f(n){if(n<=1)return(1);return(n*f(n-1));}\nf(20)\n1/0\n77\nEOF\n"]
[174.58505, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/pybc/bc.py'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read()\r\n"]
[174.586553, "o", "\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"def lex(src):\\n    out=[]; p=0\", \"def lex(src):\\n    # Outside strings, backslash-newline is whitespace. Valid test input does\\n    # not rely on this transformation inside a string.\\n    src=src.replace('\\\\\\\\\\\\n',' ')\\n    out=[]; p=0\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"            # A comment acts as whitespace; preserve contained newlines.\\n            out.extend([('NL','\\\\n')]*v.count('\\\\n')); continue\", \"            # A block comment, including any newlines in it, is one space.\\n            continue\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"mp={'n':'\\\\n','t':'\\\\t','r':'\\\\r','b':'\\\\b','f':'\\\\f','\\\\\\\\':'\\\\\\\\','q':'\\\"'}\", \"mp={'a':'\\\\a','n':'\\\\n','t':'\\\\t','r':'\\\\r','b':'\\\\b','f':'\\\\f','\\\\\\\\':'\\\\\\\\','q':'\\\"'}\")\r\n\u001b[?2004l\r\u001b[?2004h> old=\"\"\"def run_source(vm,src):\r\n\u001b[?2004l\r\u001b[?2004h>     try:p=Parser(src); ss=p.program()\r\n\u001b[?2004l\r\u001b[?2004h>     except SyntaxError:return\r\n\u001b[?2004l\r\u001b[?2004h>     for st in ss:\r\n\u001b[?2004l\r\u001b[?2004h>         try:vm.stmt(st)\r\n\u001b[?2004l\r\u001b[?2004h>         except R"]
[174.587973, "o", "unError:continue\r\n\u001b[?2004l\r\u001b[?2004h>         except Flow:continue\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> new=\"\"\"def has_quit(x):\r\n\u001b[?2004l\r\u001b[?2004h>     if isinstance(x,tuple):\r\n\u001b[?2004l\r\u001b[?2004h>         if x and x[0]=='quit': return True\r\n\u001b[?2004l\r\u001b[?2004h>         return any(has_quit(y) for y in x[1:])\r\n\u001b[?2004l\r\u001b[?2004h>     if isinstance(x,list): return any(has_quit(y) for y in x)\r\n\u001b[?2004l\r\u001b[?2004h>     return False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def run_source(vm,src):\r\n\u001b[?2004l\r\u001b[?2004h>     try:p=Parser(src); ss=p.program()\r\n\u001b[?2004l\r\u001b[?2004h>     except SyntaxError:return\r\n\u001b[?2004l\r\u001b[?2004h>     for st in ss:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[174.599478, "o", "        # GNU bc's quit is acted on by the reader, even in a false branch or\r\n\u001b[?2004l\r\u001b[?2004h>         # function body. Earlier complete top-level statements have run.\r\n\u001b[?2004l\r\u001b[?2004h>         if has_quit(st): raise Halt()\r\n\u001b[?2004l\r\u001b[?2004h>         try:vm.stmt(st)\r\n\u001b[?2004l\r\u001b[?2004h>         except RunError:continue\r\n\u001b[?2004l\r\u001b[?2004h>         except Flow:continue\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> assert old in s\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(old,new)\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r\u001b[?2004hroot@e84d2eaa0413:/app# python3 -m py_compile /app/pybc/bc.py\r\n\u001b[?2004l\r"]
