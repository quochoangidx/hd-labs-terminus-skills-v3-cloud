[74.558016, "i", " xs.append((n,arr))\r                    if not self.pk(','): break\r                    self.pop()\r                return ('auto',xs)\r        if self.pk()[0]=='STR': return ('string',self.pop()[1])\r        e=self.expr(); return ('expr',e)\r    def func(self):\r        self.pop(); void=False\r        if self.pk('ID') and self.pk()[1]=='void': self.pop(); void=True\r        name=self.pop()[1]; self.pop('('); ps=[]\r        if not self.pk(')'):\r            while True:\r                ref=False\r                if self.pk('*'): self.pop(); ref=True\r                n=self.pop()[1]; arr=False\r                if self.pk('['): self.pop(); self.pop(']'); arr=True\r                ps.append((n,arr,ref))\r                if not self.pk(','): break\r                self.pop()\r        self.pop(')'); self.softnl(); self.pop('{'); body=self.program('}'); self.pop('}')\r        return ('define',name,ps,body,void)\r    # Pratt parser, binding powers match GNU bc's documented unusual order.\r    def expr(self,minp=0):\r        if self.pk('-"]
