[74.854474, "o", "\u001b[?2004hroot@e84d2eaa0413:/app# python3 /app/pybc/bc.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> 1+2\r\n\u001b[?2004l\r\u001b[?2004h> scale=3\r\n\u001b[?2004l\r\u001b[?2004h> 10/4\r\n\u001b[?2004l\r\u001b[?2004h> 2.50*3\r\n\u001b[?2004l\r\u001b[?2004h> length(.0010); scale(2.30); sqrt(2)\r\n\u001b[?2004l\r\u001b[?2004h> a=0\r\n\u001b[?2004l\r\u001b[?2004h> for(i=0;i<4;i++) a+=i\r\n\u001b[?2004l\r\u001b[?2004h> a\r\n\u001b[?2004l\r\u001b[?2004h> ibase=16\r\n\u001b[?2004l\r\u001b[?2004h> FF.8\r\n\u001b[?2004l\r\u001b[?2004h> obase=16\r\n\u001b[?2004l\r\u001b[?2004h> 255.5\r\n\u001b[?2004l\r\u001b[?2004h> print \"x=\",a,\" done\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> define f(n) { if(n<=1) return(1); return(n*f(n-1)); }\r\n\u001b[?2004l\r\u001b[?2004h> f(10)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
