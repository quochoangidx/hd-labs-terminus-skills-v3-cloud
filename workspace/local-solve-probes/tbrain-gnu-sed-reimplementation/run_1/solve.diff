+# ---------------------------------------------------------------------------
+# Regular expressions: POSIX BRE/ERE (GNU flavour) -> Python re
+# ---------------------------------------------------------------------------
+
+INF = float('inf')
+
+
+def preprocess_regex(s):
+    """Apply GNU sed escape conversions (\\t, \\xHH, ...) to a regex."""
+    out = []
+    i = 0
+    n = len(s)
+    while i < n:
+        c = s[i]
+        if c == '\\' and i + 1 < n:
+            d = s[i + 1]
+            if d in SIMPLE_ESC:
+                out.append(SIMPLE_ESC[d])
+                i += 2
+            elif d in 'dox':
+                ch, j = convert_number(s, i + 1, {'d': 10, 'o': 8, 'x': 16}[d])
+                if j == i + 2 and ch == d:
+                    out.append(d)
+                else:
+                    out.append('\\\\' if ch == '\\' else ch)
+                i = j
+            elif d == 'c' and i + 2 < n:
+                ch = ctrl_char(s[i + 2])
+                out.append('\\\\' if ch == '\\' else ch)
+                i += 3
+            else:
+                out.append(c + d)
+                i += 2
+        else:
+            out.append(c)
+            i += 1
+    return ''.join(out)
+
+
+def class_to_py(chars, negate):
+    """Build a Python character class from a set of characters."""
+    codes = sorted(ord(c) for c in chars)
+    parts = []
+    i = 0
+    while i < len(codes):
+        j = i
+        while j + 1 < len(codes) and codes[j + 1] == codes[j] + 1:
+            j += 1
+        if j == i:
+            parts.append('\\x%02x' % codes[i])
+        else:
+            parts.append('\\x%02x-\\x%02x' % (codes[i], codes[j]))
+        i = j + 1
+    body = ''.join(parts)
+    if negate:
+        if not body:
+            return '[\\x00-\\xff]'
+        return '[^' + body + ']'
+    if not body:
+        return '(?!)'
+    return '[' + body + ']'
+
+
+class Tok(object):
+    __slots__ = ('kind', 'val')
+
+    def __init__(self, kind, val=None):
+        self.kind = kind
+        self.val = val
+
+
+def parse_bracket(s, i):
+    """s[i] is just after '['.  Returns (set, negate, new_index)."""
+    n = len(s)
+    negate = False
+    if i < n and s[i] == '^':
+        negate = True
+        i += 1
+    items = set()
+    first = True
+
+    def read_elem(i):
+        # returns (kind, value, new_i) ; kind 'char' or 'class'
+        c = s[i]
+        if c == '[' and i + 1 < n and s[i + 1] in '.:=':
+            t = s[i + 1]
+            end = s.find(t + ']', i + 2)
+            if end < 0:
+                raise SedError('unterminated address regex')
+            name = s[i + 2:end]
+            if t == ':':
+                if name not in CLASSES:
+                    raise SedError('invalid character class')
+                return 'class', CLASSES[name], end + 2
+            # collating symbol / equivalence class
+            if len(name) != 1:
+                raise SedError('invalid collation character')
+            return 'char', name, end + 2
+        return 'char', c, i + 1
+
+    while True:
+        if i >= n:
+            raise SedError('unterminated address regex')
+        c = s[i]
+        if c == ']' and not first:
+            i += 1
+            break
+        first = False
+        kind, val, i = read_elem(i)
+        if kind == 'class':
+            items |= val
+            continue
+        # possible range
+        if i + 1 < n and s[i] == '-' and s[i + 1] != ']':
+            kind2, val2, j = read_elem(i + 1)
+            if kind2 == 'class':
+                raise SedError('invalid range end')
+            lo, hi = ord(val), ord(val2)
+            if lo > hi:
+                raise SedError('invalid range end')
+            for k in range(lo, hi + 1):
+                items.add(chr(k))
+            i = j
+            continue
+        items.add(val)
+    return items, negate, i
+
