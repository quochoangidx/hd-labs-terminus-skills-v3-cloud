+def read_script_file(path):
+    if path == '-':
+        data = sys.stdin.buffer.read()
+    else:
+        with open(path, 'rb') as fh:
+            data = fh.read()
+    text = data.decode('latin-1')
+    if text.endswith('\n'):
+        text = text[:-1]
+    return text
