+def tokenize(s, ere):
+    toks = []
+    i = 0
+    n = len(s)
+    while i < n:
+        c = s[i]
+        if c == '\\':
+            if i + 1 >= n:
+                raise SedError('trailing backslash (\\)')
+            d = s[i + 1]
+            i += 2
+            if not ere and d == '(':
+                toks.append(Tok('open'))
+            elif not ere and d == ')':
+                toks.append(Tok('close'))
+            elif not ere and d == '|':
+                toks.append(Tok('alt'))
+            elif not ere and d == '+':
+                toks.append(Tok('quant', (1, None, '+')))
+            elif not ere and d == '?':
+                toks.append(Tok('quant', (0, 1, '?')))
+            elif not ere and d == '{':
+                end = s.find('\\}', i)
+                if end < 0:
+                    raise SedError('unmatched \\{')
+                body = s[i:end]
+                iv = parse_interval(body)
+                if iv is None:
+                    raise SedError('invalid content of \\{\\}')
+                toks.append(Tok('quant', (iv[0], iv[1], '{')))
+                i = end + 2
+            elif d in '123456789':
+                toks.append(Tok('backref', int(d)))
+            elif d == 'w':
+                toks.append(Tok('set', '[A-Za-z0-9_]'))
+            elif d == 'W':
+                toks.append(Tok('set', '[^A-Za-z0-9_]'))
+            elif d == 's':
+                toks.append(Tok('set', '[ \\t\\n\\r\\f\\v]'))
+            elif d == 'S':
+                toks.append(Tok('set', '[^ \\t\\n\\r\\f\\v]'))
+            elif d == 'b':
+                toks.append(Tok('assert', ('(?:(?<=[A-Za-z0-9_])(?![A-Za-z0-9_])|(?<![A-Za-z0-9_])(?=[A-Za-z0-9_]))', True)))
+            elif d == 'B':
+                toks.append(Tok('assert', ('(?:(?<=[A-Za-z0-9_])(?=[A-Za-z0-9_])|(?<![A-Za-z0-9_])(?![A-Za-z0-9_]))', True)))
+            elif d == '<':
+                toks.append(Tok('assert', ('(?<![A-Za-z0-9_])(?=[A-Za-z0-9_])', True)))
+            elif d == '>':
+                toks.append(Tok('assert', ('(?<=[A-Za-z0-9_])(?![A-Za-z0-9_])', True)))
+            elif d == '`':
+                toks.append(Tok('assert', ('(?<![\\s\\S])', False)))
+            elif d == "'":
+                toks.append(Tok('assert', ('(?![\\s\\S])', True)))
+            elif d == 'n':
+                toks.append(Tok('lit', '\n'))
+            else:
+                toks.append(Tok('lit', d))
+            continue
+        if c == '[':
+            items, negate, i = parse_bracket(s, i + 1)
+            toks.append(Tok('bracket', (items, negate)))
+            continue
+        i += 1
+        if c == '.':
+            toks.append(Tok('any'))
+        elif c == '*':
+            toks.append(Tok('quant', (0, None, '*')))
+        elif c == '^':
+            toks.append(Tok('bol'))
+        elif c == '$':
+            toks.append(Tok('eol'))
+        elif ere and c == '(':
+            toks.append(Tok('open'))
+        elif ere and c == ')':
+            toks.append(Tok('close'))
+        elif ere and c == '|':
+            toks.append(Tok('alt'))
+        elif ere and c == '+':
+            toks.append(Tok('quant', (1, None, '+')))
+        elif ere and c == '?':
+            toks.append(Tok('quant', (0, 1, '?')))
+        elif ere and c == '{':
+            end = s.find('}', i)
+            iv = parse_interval(s[i:end]) if end >= 0 else None
+            if iv is None:
+                toks.append(Tok('lit', '{'))
+            else:
+                toks.append(Tok('quant', (iv[0], iv[1], '{')))
+                i = end + 1
+        else:
+            toks.append(Tok('lit', c))
+    return toks
+
+
+def parse_interval(body):
+    m = re.match(r'^([0-9]*)(,([0-9]*))?$', body)
+    if not m:
+        return None
+    if m.group(2) is None:
+        if not m.group(1):
+            return None
+        v = int(m.group(1))
+        return (v, v)
+    lo = int(m.group(1)) if m.group(1) else 0
+    hi = int(m.group(3)) if m.group(3) else None
+    if hi is not None and hi < lo:
+        return None
+    return (lo, hi)
+
+
+class RegexTranslator(object):
+    def __init__(self, toks, ere, mline):
+        self.toks = toks
+        self.pos = 0
+        self.ere = ere
+        self.mline = mline
+        self.ngroups = 0
+        self.closed = set()
+        self.lookahead = False
+        self.has_backref = False
+
+    def peek(self, k=0):
+        p = self.pos + k
+        return self.toks[p] if p < len(self.toks) else None
+
+    def parse(self):
+        py, mn, mx = self.parse_alt(0)
+        while self.pos < len(self.toks):
+            # unmatched close at top level: literal
+            t = self.toks[self.pos]
+            self.pos += 1
+            b = self.parse_alt(0)
+            py = py + re.escape(')') + b[0]
+            mn = mn + 1 + b[1]
+            mx = mx + 1 + b[2]
+        return py, mn, mx
+
+    def parse_alt(self, depth):
+        branches = [self.parse_branch(depth)]
+        while True:
+            t = self.peek()
+            if t is not None and t.kind == 'alt':
+                self.pos += 1
+                branches.append(self.parse_branch(depth))
+            else:
+                break
+        if len(branches) == 1:
+            return branches[0]
+        py = '(?:' + '|'.join(b[0] for b in branches) + ')'
+        return py, min(b[1] for b in branches), max(b[2] for b in branches)
+
+    def anchor_bol(self):
+        return '(?<![^\\n])' if self.mline else '(?<![\\s\\S])'
+
+    def anchor_eol(self):
+        self.lookahead = True
+        return '(?![^\\n])' if self.mline else '(?![\\s\\S])'
+
+    def parse_branch(self, depth):
+        items = []  # list of [py, min, max, quantifiable]
+        start = True
+        after_anchor = False
+        while True:
+            t = self.peek()
+            if t is None or t.kind == 'alt':
+                break
+            if t.kind == 'close':
+                if depth > 0:
+                    break
+                if self.ere or True:
+                    # unmatched close paren: treat literally
+                    self.pos += 1
+                    items.append([re.escape(')'), 1, 1, True])
+                    start = False
+                    after_anchor = False
+                    continue
+            self.pos += 1
+            k = t.kind
+            if k == 'bol':
+                if self.ere or start:
+                    items.append([self.anchor_bol(), 0, 0, False])
+                    start = False
+                    after_anchor = True
+                    continue
+                items.append([re.escape('^'), 1, 1, True])
+            elif k == 'eol':
+                nt = self.peek()
+                if self.ere or nt is None or nt.kind in ('alt', 'close'):
+                    items.append([self.anchor_eol(), 0, 0, False])
+                    start = False
+                    after_anchor = False
+                    continue
+                items.append([re.escape('$'), 1, 1, True])
+            elif k == 'quant':
+                lo, hi, sym = t.val
+                if start or after_anchor or not items:
+                    if sym == '{':
+                        raise SedError('Invalid preceding regular expression')
+                    items.append([re.escape(sym), 1, 1, True])
+                else:
+                    items[-1] = self.apply_quant(items[-1], lo, hi)
+                    start = False
+                    continue
+            elif k == 'lit':
+                items.append([re.escape(t.val), 1, 1, True])
+            elif k == 'any':
+                items.append(['[^\\n]' if self.mline else '[\\s\\S]', 1, 1, True])
+            elif k == 'set':
+                items.append([t.val, 1, 1, True])
+            elif k == 'bracket':
+                chars, negate = t.val
+                if negate and self.mline:
+                    chars = set(chars) | {'\n'}
+                items.append([class_to_py(chars, negate), 1, 1, True])
+            elif k == 'assert':
+                py, la = t.val
+                if la:
+                    self.lookahead = True
+                items.append([py, 0, 0, False])
+            elif k == 'backref':
+                if t.val not in self.closed:
+                    raise SedError('Invalid back reference')
+                self.has_backref = True
+                items.append(['(?:\\%d)' % t.val, 0, INF, True])
+            elif k == 'open':
+                self.ngroups += 1
+                g = self.ngroups
+                py, mn, mx = self.parse_alt(depth + 1)
+                ct = self.peek()
+                if ct is None or ct.kind != 'close':
+                    raise SedError('Unmatched ( or \\(')
+                self.pos += 1
+                self.closed.add(g)
+                items.append(['(' + py + ')', mn, mx, True])
+            start = False
+            after_anchor = False
+        py = ''.join(it[0] for it in items)
+        mn = sum(it[1] for it in items)
+        mx = sum(it[2] for it in items)
+        return py, mn, mx
+
+    def apply_quant(self, item, lo, hi):
+        py, mn, mx, _ = item
+        if mx == 0:
+            if lo == 0:
+                return ['(?:' + py + ')?', 0, 0, True]
+            return item
+        if hi is None:
+            q = '*' if lo == 0 else ('+' if lo == 1 else '{%d,}' % lo)
+            nmx = INF
+        else:
+            if lo == 0 and hi == 1:
+                q = '?'
+            elif lo == hi:
+                q = '{%d}' % lo
+            else:
+                q = '{%d,%d}' % (lo, hi)
+            nmx = mx * hi
+        return ['(?:' + py + ')' + q, mn * lo, nmx, True]
+
+
+class Regex(object):
+    def __init__(self, src, ere, icase, mline):
+        self.src = src
+        pre = preprocess_regex(src)
+        toks = tokenize(pre, ere)
+        tr = RegexTranslator(toks, ere, mline)
+        py, mn, mx = tr.parse()
+        self.py = py
+        self.ngroups = tr.ngroups
+        self.maxlen = mx
+        self.lookahead = tr.lookahead
+        self.flags = re.ASCII | re.DOTALL | (re.IGNORECASE if icase else 0)
+        try:
+            self.rx = re.compile(py, self.flags)
+        except re.error as e:
+            raise SedError('invalid regex: %s' % e)
+        self.endcache = {}
+
+    def search_any(self, s):
+        return self.rx.search(s) is not None
+
+    def _check(self, s, st, e):
+        """A match starting at st and ending at or after e, if any."""
+        r = len(s) - e
+        c = self.endcache.get(r)
+        if c is None:
+            c = re.compile('(?:' + self.py + ')(?![\\s\\S]{%d})' % (r + 1), self.flags)
+            if len(self.endcache) > 3000:
+                self.endcache.clear()
+            self.endcache[r] = c
+        return c.match(s, st)
+
+    def find(self, s, pos):
+        """Leftmost-longest match starting at or after pos."""
+        m = self.rx.search(s, pos)
+        if m is None:
+            return None
+        st, e0 = m.span()
+        n = len(s)
+        hi = n
+        if self.maxlen != INF:
+            hi = min(n, st + int(self.maxlen))
+        if hi <= e0:
+            return m
+        m1 = self._check(s, st, e0 + 1)
+        if m1 is None:
+            return m
+        best = m1
+        lo = m1.end()
+        while lo < hi:
+            mid = (lo + 1 + hi) // 2
+            mm = self._check(s, st, mid)
+            if mm is not None:
+                best = mm
+                lo = mm.end()
+            else:
+                hi = mid - 1
+        return best
+
