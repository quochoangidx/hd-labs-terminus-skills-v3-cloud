+# ---------------------------------------------------------------------------
+# Character helpers (C locale, bytes decoded as latin-1)
+# ---------------------------------------------------------------------------
+
+_UPPER = {i: i - 32 for i in range(ord('a'), ord('z') + 1)}
+_LOWER = {i: i + 32 for i in range(ord('A'), ord('Z') + 1)}
+
+
+def to_upper(s):
+    return s.translate(_UPPER)
+
+
+def to_lower(s):
+    return s.translate(_LOWER)
+
+
+def _chars(pred):
+    return frozenset(chr(i) for i in range(256) if pred(i))
+
+
+CLASSES = {
+    'alpha': _chars(lambda c: 65 <= c <= 90 or 97 <= c <= 122),
+    'digit': _chars(lambda c: 48 <= c <= 57),
+    'alnum': _chars(lambda c: 65 <= c <= 90 or 97 <= c <= 122 or 48 <= c <= 57),
+    'upper': _chars(lambda c: 65 <= c <= 90),
+    'lower': _chars(lambda c: 97 <= c <= 122),
+    'space': frozenset(' \t\n\r\f\v'),
+    'blank': frozenset(' \t'),
+    'punct': _chars(lambda c: 33 <= c <= 126 and not (65 <= c <= 90 or 97 <= c <= 122 or 48 <= c <= 57)),
+    'print': _chars(lambda c: 32 <= c <= 126),
+    'graph': _chars(lambda c: 33 <= c <= 126),
+    'cntrl': _chars(lambda c: c < 32 or c == 127),
+    'xdigit': frozenset('0123456789abcdefABCDEF'),
+}
+
+SIMPLE_ESC = {'a': '\a', 'f': '\f', 'n': '\n', 'r': '\r', 't': '\t', 'v': '\v'}
+
+
+def convert_number(s, i, base):
+    """s[i] is the letter d/o/x.  Returns (char, new_index)."""
+    ndig = {10: 3, 8: 3, 16: 2}[base]
+    j = i + 1
+    n = 0
+    cnt = 0
+    while j < len(s) and cnt < ndig:
+        c = s[j]
+        try:
+            d = int(c, 16)
+        except ValueError:
+            break
+        if d >= base:
+            break
+        n = n * base + d
+        j += 1
+        cnt += 1
+    if cnt == 0:
+        return s[i], i + 1
+    return chr(n & 0xff), j
+
+
+def ctrl_char(c):
+    return chr(ord(to_upper(c)) ^ 0x40)
+
