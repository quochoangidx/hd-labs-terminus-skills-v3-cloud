 import sys
 
+# ---------------------------------------------------------------------------
+# Regular expressions (POSIX BRE / ERE with GNU extensions, leftmost-longest)
+# ---------------------------------------------------------------------------
 
+T_CHAR, T_ANY, T_SET, T_BOL, T_EOL, T_GROUP, T_BREF, T_CAT, T_ALT, T_REP, \
+    T_EMPTY = range(11)
+
+INF = 1 << 30
+RE_DUP_MAX = 0x7fff
+
+
+class RegexError(Exception):
+    pass
+
+
+class RNode(object):
+    __slots__ = ('t', 'a', 'b', 'mn', 'mx')
+
+    def __init__(self, t, a=None, b=None, mn=0, mx=0):
+        self.t = t
+        self.a = a
+        self.b = b
+        self.mn = mn
+        self.mx = mx
+
+
+def _cls_chars(name):
+    r = set()
+    for o in range(256):
+        c = chr(o)
+        ok = False
+        if o < 128:
+            if name == 'alpha':
+                ok = c.isalpha()
+            elif name == 'digit':
+                ok = '0' <= c <= '9'
+            elif name == 'alnum':
+                ok = c.isalnum()
+            elif name == 'upper':
+                ok = 'A' <= c <= 'Z'
+            elif name == 'lower':
+                ok = 'a' <= c <= 'z'
+            elif name == 'space':
+                ok = c in ' \t\n\r\f\v'
+            elif name == 'blank':
+                ok = c in ' \t'
+            elif name == 'punct':
+                ok = (33 <= o <= 47) or (58 <= o <= 64) or (91 <= o <= 96) \
+                    or (123 <= o <= 126)
+            elif name == 'print':
+                ok = 32 <= o <= 126
+            elif name == 'graph':
+                ok = 33 <= o <= 126
+            elif name == 'cntrl':
+                ok = o < 32 or o == 127
+            elif name == 'xdigit':
+                ok = c in '0123456789abcdefABCDEF'
+        if ok:
+            r.add(c)
+    return r
+
+
+CLASS_NAMES = ('alpha', 'digit', 'alnum', 'upper', 'lower', 'space', 'blank',
+               'punct', 'print', 'graph', 'cntrl', 'xdigit')
+
+
+class Parser(object):
+    def __init__(self, pat, ere, icase):
+        self.p = pat
+        self.n = len(pat)
+        self.i = 0
+        self.ere = ere
+        self.icase = icase
+        self.ngroups = 0
+        self.completed = set()
+        self.hasbr = False
+        self.depth = 0
+
+    def parse(self):
+        node = self.parse_alt()
+        if self.i < self.n:
+            raise RegexError('unmatched')
+        return node
+
+    def at_alt(self):
+        p, i = self.p, self.i
+        if i >= self.n:
+            return False
+        if self.ere:
+            return p[i] == '|'
+        return p[i] == '\\' and i + 1 < self.n and p[i + 1] == '|'
+
+    def at_close(self):
+        p, i = self.p, self.i
+        if i >= self.n:
+            return False
+        if self.ere:
+            return p[i] == ')' and self.depth > 0
+        return p[i] == '\\' and i + 1 < self.n and p[i + 1] == ')'
+
+    def parse_alt(self):
+        branches = [self.parse_branch()]
+        while self.at_alt():
+            self.i += 1 if self.ere else 2
+            branches.append(self.parse_branch())
+        if len(branches) == 1:
+            return branches[0]
+        return RNode(T_ALT, branches)
+
+    def parse_branch(self):
+        items = []
+        start = True
+        after_anchor = False
+        while self.i < self.n and not self.at_alt() and not self.at_close():
+            node, anchor = self.parse_expr(start, after_anchor)
+            items.append(node)
+            start = False
+            after_anchor = anchor
+        if not items:
+            return RNode(T_EMPTY)
+        if len(items) == 1:
+            return items[0]
+        return RNode(T_CAT, items)
+
+    def parse_interval(self):
+        # self.i is after the opening brace
+        p = self.p
+        j = self.i
+        while j < self.n and p[j].isdigit():
+            j += 1
+        s1 = p[self.i:j]
+        comma = False
+        s2 = ''
+        if j < self.n and p[j] == ',':
+            comma = True
+            k = j + 1
+            while k < self.n and p[k].isdigit():
+                k += 1
+            s2 = p[j + 1:k]
+            j = k
+        if self.ere:
+            if j >= self.n or p[j] != '}':
+                raise RegexError('brace')
+            j += 1
+        else:
+            if j + 1 >= self.n or p[j] != '\\' or p[j + 1] != '}':
+                raise RegexError('brace')
+            j += 2
+        if not s1 and not comma:
+            raise RegexError('badbr')
+        mn = int(s1) if s1 else 0
+        if comma:
+            mx = int(s2) if s2 else INF
+        else:
+            mx = mn
+        if mn > RE_DUP_MAX or (mx != INF and mx > RE_DUP_MAX):
+            raise RegexError('size')
+        if mx < mn:
+            raise RegexError('badbr')
+        self.i = j
+        return mn, mx
+
+    def parse_bracket(self):
+        # self.i after '['
+        p = self.p
+        n = self.n
+        neg = False
+        if self.i < n and p[self.i] == '^':
+            neg = True
+            self.i += 1
+        chars = set()
+        first = True
+        while True:
+            if self.i >= n:
+                raise RegexError('ebrack')
+            c = p[self.i]
+            if c == ']' and not first:
+                self.i += 1
+                break
+            kind, val = self.parse_belem(first)
+            if kind in ('char', 'coll') and self.i + 1 < n and \
+                    p[self.i] == '-' and p[self.i + 1] != ']':
+                self.i += 1
+                kind2, val2 = self.parse_belem(True)
+                if kind2 not in ('char', 'coll'):
+                    raise RegexError('erange')
+                if ord(val) > ord(val2):
+                    raise RegexError('erange')
+                for o in range(ord(val), ord(val2) + 1):
+                    chars.add(chr(o))
+            elif kind == 'class':
+                chars |= val
+            else:
+                chars.add(val)
+            first = False
+        if self.icase:
+            extra = set()
+            for ch in chars:
+                extra.add(ch.lower())
+            chars |= extra
+        return RNode(T_SET, frozenset(chars), neg)
+
+    def parse_belem(self, accept_hyphen):
+        p = self.p
+        n = self.n
+        i = self.i
+        if p[i] == '[' and i + 1 < n and p[i + 1] in ':=.':
+            d = p[i + 1]
+            j = p.find(d + ']', i + 2)
+            if j < 0:
+                raise RegexError('ebrack')
+            name = p[i + 2:j]
+            self.i = j + 2
+            if d == ':':
+                if name not in CLASS_NAMES:
+                    raise RegexError('ectype')
+                if self.icase and name in ('upper', 'lower'):
+                    name = 'alpha'
+                return 'class', _cls_chars(name)
+            if len(name) != 1:
+                raise RegexError('ecollate')
+            if d == '=':
+                return 'equiv', name
+            return 'coll', name
+        c = p[i]
+        if c == '-' and not accept_hyphen:
+            if not (i + 1 < n and p[i + 1] == ']'):
+                raise RegexError('erange')
+        self.i = i + 1
+        return 'char', c
+
+    def parse_expr(self, caret_ok, after_anchor):
+        """Returns (node, is_anchor)."""
+        p = self.p
+        c = p[self.i]
+        node = None
+        start = caret_ok or after_anchor
+        if self.ere:
+            if c in '*+?{':
+                raise RegexError('badrpt')
+            if c == '^':
+                self.i += 1
+                return RNode(T_BOL), True
+            if c == '$':
+                self.i += 1
+                return RNode(T_EOL), True
+            if c == '(':
+                self.i += 1
+                self.ngroups += 1
+                idx = self.ngroups
+                self.depth += 1
+                inner = self.parse_alt()
+                if self.i >= self.n or p[self.i] != ')':
+                    raise RegexError('eparen')
+                self.i += 1
+                self.depth -= 1
+                self.completed.add(idx)
+                node = RNode(T_GROUP, inner, idx - 1)
+            elif c == '.':
+                self.i += 1
+                node = RNode(T_ANY)
+            elif c == '[':
+                self.i += 1
+                node = self.parse_bracket()
+            elif c == '\\':
+                if self.i + 1 >= self.n:
+                    raise RegexError('eescape')
+                d = p[self.i + 1]
+                self.i += 2
+                if '1' <= d <= '9':
+                    k = int(d)
+                    if k not in self.completed:
+                        raise RegexError('esubreg')
+                    self.hasbr = True
+                    node = RNode(T_BREF, k - 1)
+                else:
+                    node = RNode(T_CHAR, d)
+            else:
+                self.i += 1
+                node = RNode(T_CHAR, c)
+        else:
+            if c == '\\':
+                if self.i + 1 >= self.n:
+                    raise RegexError('eescape')
+                d = p[self.i + 1]
+                if d == '(':
+                    self.i += 2
+                    self.ngroups += 1
+                    idx = self.ngroups
+                    self.depth += 1
+                    inner = self.parse_alt()
+                    if not (self.i + 1 < self.n and p[self.i] == '\\' and
+                            p[self.i + 1] == ')'):
+                        raise RegexError('eparen')
+                    self.i += 2
+                    self.depth -= 1
+                    self.completed.add(idx)
+                    node = RNode(T_GROUP, inner, idx - 1)
+                elif d == ')':
+                    raise RegexError('eparen')
+                elif d == '{':
+                    if start:
+                        raise RegexError('badrpt')
+                    raise RegexError('badrpt')
+                elif d in '+?' and start:
+                    self.i += 2
+                    node = RNode(T_CHAR, d)
+                elif '1' <= d <= '9':
+                    self.i += 2
+                    k = int(d)
+                    if k not in self.completed:
+                        raise RegexError('esubreg')
+                    self.hasbr = True
+                    node = RNode(T_BREF, k - 1)
+                else:
+                    self.i += 2
+                    node = RNode(T_CHAR, d)
+            elif c == '*' and start:
+                self.i += 1
+                node = RNode(T_CHAR, '*')
+            elif c == '^' and caret_ok:
+                self.i += 1
+                return RNode(T_BOL), True
+            elif c == '$' and (self.i + 1 == self.n or
+                               p[self.i + 1:self.i + 3] in ('\\)', '\\|')):
+                self.i += 1
+                return RNode(T_EOL), True
+            elif c == '.':
+                self.i += 1
+                node = RNode(T_ANY)
+            elif c == '[':
+                self.i += 1
+                node = self.parse_bracket()
+            else:
+                self.i += 1
+                node = RNode(T_CHAR, c)
+        # duplication operators
+        while self.i < self.n:
+            c = p[self.i]
+            if self.ere:
+                if c == '*':
+                    self.i += 1
+                    node = RNode(T_REP, node, None, 0, INF)
+                elif c == '+':
+                    self.i += 1
+                    node = RNode(T_REP, node, None, 1, INF)
+                elif c == '?':
+                    self.i += 1
+                    node = RNode(T_REP, node, None, 0, 1)
+                elif c == '{':
+                    self.i += 1
+                    mn, mx = self.parse_interval()
+                    node = RNode(T_REP, node, None, mn, mx)
+                else:
+                    break
+            else:
+                if c == '*':
+                    self.i += 1
+                    node = RNode(T_REP, node, None, 0, INF)
+                elif c == '\\' and self.i + 1 < self.n and \
+                        p[self.i + 1] in '+?{':
+                    d = p[self.i + 1]
+                    self.i += 2
+                    if d == '+':
+                        node = RNode(T_REP, node, None, 1, INF)
+                    elif d == '?':
+                        node = RNode(T_REP, node, None, 0, 1)
+                    else:
+                        mn, mx = self.parse_interval()
+                        node = RNode(T_REP, node, None, mn, mx)
+                else:
+                    break
+        return node, False
+
+
+def _required(node, acc):
+    t = node.t
+    if t == T_CHAR:
+        acc.add(node.a)
+    elif t == T_GROUP:
+        _required(node.a, acc)
+    elif t == T_CAT:
+        for it in node.a:
+            _required(it, acc)
+    elif t == T_REP:
+        if node.mn >= 1:
+            _required(node.a, acc)
+
+
+def _combine(a, b):
+    if b is None:
+        return a
+    if a is None:
+        return b
+    return tuple(y if y is not None else x for x, y in zip(a, b))
+
+
+class Regex(object):
+    def __init__(self, pat, ere, icase):
+        if icase:
+            pat = pat.lower()
+        p = Parser(pat, ere, icase)
+        self.root = p.parse()
+        self.ngroups = p.ngroups
+        self.hasbr = p.hasbr
+        self.icase = icase
+        self.required = set()
+        _required(self.root, self.required)
+
+    def search(self, text, start=0, notbol=False):
+        s = text.lower() if self.icase else text
+        if self.required:
+            rest = s[start:] if start else s
+            for ch in self.required:
+                if ch not in rest:
+                    return None
+        m = _Matcher(s, notbol, self.hasbr, self.ngroups)
+        n = len(s)
+        init = (None,) * self.ngroups if self.hasbr else None
+        for st in range(start, n + 1):
+            res = m.m(self.root, st, init)
+            if res:
+                best_e = -1
+                best_c = None
+                for e, c in res:
+                    if e > best_e:
+                        best_e = e
+                        best_c = c
+                caps = best_c if best_c is not None else (None,) * self.ngroups
+                return st, best_e, caps
+        return None
+
+
+class _Matcher(object):
+    def __init__(self, s, notbol, hasbr, ng):
+        self.s = s
+        self.n = len(s)
+        self.notbol = notbol
+        self.hasbr = hasbr
+        self.ng = ng
+        self.memo = {}
+
+    def m(self, node, pos, caps):
+        t = node.t
+        s = self.s
+        if t == T_CHAR:
+            if pos < self.n and s[pos] == node.a:
+                return [(pos + 1, caps)]
+            return []
+        if t == T_ANY:
+            if pos < self.n:
+                return [(pos + 1, caps)]
+            return []
+        if t == T_SET:
+            if pos < self.n and ((s[pos] in node.a) != node.b):
+                return [(pos + 1, caps)]
+            return []
+        if t == T_BOL:
+            if pos == 0 and not self.notbol:
+                return [(pos, caps)]
+            return []
+        if t == T_EOL:
+            if pos == self.n:
+                return [(pos, caps)]
+            return []
+        if t == T_EMPTY:
+            return [(pos, caps)]
+        if t == T_BREF:
+            g = caps[node.a] if caps is not None else None
+            if g is None:
+                return []
+            sub = s[g[0]:g[1]]
+            if s.startswith(sub, pos):
+                return [(pos + len(sub), caps)]
+            return []
+        hasbr = self.hasbr
+        if not hasbr:
+            key = (id(node), pos)
+            r = self.memo.get(key)
+            if r is not None:
+                return r
+        if t == T_GROUP:
+            res = []
+            idx = node.b
+            for e, d in self.m(node.a, pos, caps):
+                lst = list(d) if d is not None else [None] * self.ng
+                lst[idx] = (pos, e)
+                res.append((e, tuple(lst)))
+            if hasbr:
+                res = _dedup(res, True)
+        elif t == T_CAT:
+            frontier = [(pos, caps)]
+            for item in node.a:
+                new = []
+                seen = set()
+                for p, c in frontier:
+                    sub = self.m(item, p, c if hasbr else None)
+                    for e, d in sub:
+                        nc = _combine(c, d)
+                        k = (e, nc) if hasbr else e
+                        if k not in seen:
+                            seen.add(k)
+                            new.append((e, nc))
+                frontier = new
+                if not frontier:
+                    break
+            res = frontier
+        elif t == T_ALT:
+            res = []
+            seen = set()
+            for br in node.a:
+                for e, d in self.m(br, pos, caps):
+                    k = (e, d) if hasbr else e
+                    if k not in seen:
+                        seen.add(k)
+                        res.append((e, d))
+        elif t == T_REP:
+            res = self.rep(node, pos, caps, 0)
+        else:
+            res = []
+        if not hasbr:
+            self.memo[key] = res
+        return res
+
+    def rep(self, node, pos, caps, k):
+        inner = node.a
+        mn = node.mn
+        mx = node.mx
+        hasbr = self.hasbr
+        it = inner.t
+        if it in (T_CHAR, T_ANY, T_SET):
+            s = self.s
+            n = self.n
+            lim = mx - k
+            j = pos
+            cnt = 0
+            if it == T_CHAR:
+                ch = inner.a
+                while j < n and cnt < lim and s[j] == ch:
+                    j += 1
+                    cnt += 1
+            elif it == T_ANY:
+                cnt = min(lim, n - pos)
+                j = pos + cnt
+            else:
+                st = inner.a
+                ng = inner.b
+                while j < n and cnt < lim and ((s[j] in st) != ng):
+                    j += 1
+                    cnt += 1
+            need = max(0, mn - k)
+            if cnt < need:
+                return []
+            return [(pos + c, caps) for c in range(cnt, need - 1, -1)]
+        if not hasbr:
+            kk = k if (k < mn or mx != INF) else mn
+            key = (id(node), pos, kk)
+            r = self.memo.get(key)
+            if r is not None:
+                return r
+        res = []
+        seen = set()
+        if k < mx:
+            for e, d in self.m(inner, pos, caps if hasbr else None):
+                if e == pos and k >= mn:
+                    continue
+                nc = _combine(caps, d) if hasbr else d
+                for e2, d2 in self.rep(node, e, nc if hasbr else None, k + 1):
+                    fc = _combine(nc, d2)
+                    kk2 = (e2, fc) if hasbr else e2
+                    if kk2 not in seen:
+                        seen.add(kk2)
+                        res.append((e2, fc))
+        if k >= mn:
+            kk2 = (pos, caps) if hasbr else pos
+            if kk2 not in seen:
+                seen.add(kk2)
+                res.append((pos, caps))
+        if not hasbr:
+            self.memo[key] = res
+        return res
+
+
+def _dedup(res, hasbr):
+    out = []
+    seen = set()
+    for e, d in res:
+        k = (e, d) if hasbr else e
+        if k not in seen:
+            seen.add(k)
+            out.append((e, d))
+    return out
+
