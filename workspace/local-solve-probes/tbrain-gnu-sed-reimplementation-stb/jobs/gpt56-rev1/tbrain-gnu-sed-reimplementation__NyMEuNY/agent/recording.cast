[87.134561, "o", "    with open(fn,'rb') as f:raw=f.read()\r\n\u001b[?2004l\r\u001b[?2004h>    except OSError as e:print('sed.py:',e,file=sys.stderr);status=2;continue\r\n\u001b[?2004l\r\u001b[?2004h>    ls=raw.splitlines(True);allfiles.append(ls)\r\n\u001b[?2004l\r\u001b[?2004h>   flat=[]\r\n\u001b[?2004l\r\u001b[?2004h>   for ls in allfiles:\r\n\u001b[?2004l\r\u001b[?2004h>    for j,x in enumerate(ls):flat.append([x[:-1] if x.endswith(b'\\n') else x,j==0,False])\r\n\u001b[?2004l\r\u001b[?2004h>   for j,x in enumerate(flat):x[2]=(j==len(flat)-1) or (sep and (j+1==len(flat) or flat[j+1][1]));records.append(tuple(x))\r\n\u001b[?2004l\r\u001b[?2004h>  E=Engine(cmds,quiet,sep,records);r=E.run();return r or status\r\n\u001b[?2004l\r\u001b[?2004h> if __name__=='__main__':raise SystemExit(main())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r\u001b[?2004hroot@7c7a5556c187:/app# chmod +x /app/pysed/sed.py\r\n\u001b[?2004l\r\u001b[?2004hroot@7c7a5556c187:/app# python3 -m py_compile /app/pysed/sed.py\r\n\u001b[?2004l\r"]
