[360.605729, "o", "\u001b[?2004h> p='/app/pysed/sed.py';s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> # Only uppercase address modifiers are recognized.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"self.s[self.i] in b'IiMm'\", \"self.s[self.i] in b'IM'\")\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"self.s[self.i] in b'Ii':ic=True\", \"self.s[self.i]==ord('I'):ic=True\")\r\n\u001b[?2004l\r\u001b[?2004h> # N may not pull from the next file with -s.\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(\"elif o=='N':\\n    z=self.nextrec()\", \"elif o=='N':\\n    if self.sep and self.recs and self.recs[0][1]:return 'end'\\n    z=self.nextrec()\")\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[360.6275, "o", "\u001b[?2004hroot@7c7a5556c187:/app# # Replace listed() cleanly.\r\n\u001b[?2004l\r\u001b[?2004hroot@7c7a5556c187:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/pysed/sed.py';s=open(p).read();a=s.index('def listed(');b=s.index('\\nclass Engine:',a)\r\n\u001b[?2004l\r\u001b[?2004h> new=r'''def listed(p,N):\r\n\u001b[?2004l\r\u001b[?2004h>  units=[]\r\n\u001b[?2004l\r\u001b[?2004h>  mp={7:b'\\\\a',8:b'\\\\b',9:b'\\\\t',10:b'\\\\n',11:b'\\\\v',12:b'\\\\f',13:b'\\\\r',92:b'\\\\\\\\'}\r\n\u001b[?2004l\r\u001b[?2004h>  for c in p:units.append(mp.get(c,bytes([c]) if 32<=c<127 else ('\\\\%03o'%c).encode()))\r\n\u001b[?2004l\r\u001b[?2004h>  width=max(0,N-1);lines=[];cur=b''\r\n\u001b[?2004l\r\u001b[?2004h>  for u in units:\r\n\u001b[?2004l\r\u001b[?2004h>   if len(cur)+len(u)>width:\r\n\u001b[?2004l\r\u001b[?2004h>    lines.append(cur+b'\\\\');cur=b''\r\n\u001b[?2004l\r\u001b[?2004h>   cur+=u\r\n\u001b[?2004l\r\u001b[?2004h>  lines.append(cur+b'$')\r\n\u001b[?2004l\r\u001b[?2004h>  return b'\\n'.join(lines)+b'\\n'\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:a]+new+s[b:];open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
