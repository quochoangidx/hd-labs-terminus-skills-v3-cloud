[410.526418, "i", "cat > /tmp/finaldiff.py <<'PY'\nimport subprocess\nG=['/usr/bin/sed'];P=['python3','/app/pysed/sed.py']\ndef t(s,inp=b'ab12 foo_bar\\nxx abab\\n',o=[]):\n a=subprocess.run(G+o+[s],input=inp,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=3)\n b=subprocess.run(P+o+[s],input=inp,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=3)\n if (a.stdout,a.returncode)!=(b.stdout,b.returncode):print('FAIL',o,repr(s),repr(inp),'G',a.returncode,repr(a.stdout),'P',b.returncode,repr(b.stdout),repr(b.stderr))\npatterns=[r'[[:digit:]]\\+',r'\\w\\+',r'\\W\\+',r'\\bfoo\\b',r'\\<foo',r'bar\\>',r'a\\|ab',r'ab\\|a',r'a\\+',r'a\\?',r'\\(ab\\)\\1',r'[=a=]',r'[^a]\\+',r'a\\{1,2\\}',r'\\x61',r'\\o141']\nfor p in patterns:t('s/'+p+r'/<&>/g')\nfor p in [r'[[:digit:]]+',r'\\w+',r'a|ab',r'ab|a',r'(ab)\\1',r'a{1,2}',r'[=a=]']:\n t('s/'+p+r'/<&>/g',o=['-E'])\nfor s in ['0~2p','2~0p','0~1p','1~3p','2,~4p','2,+0p','2,+3p','1!{p;d}','2!{h;d};$G;p',':a;2,3{p;b z};d;:z;p','s/a/A/;t x;d;:x;s/b/B/;t x;p',':x;s/xx/x/;tx;p']:\n t(s,b'a\\nb\\nc\\nd\\ne\\n')\n# Several e pieces and em"]
