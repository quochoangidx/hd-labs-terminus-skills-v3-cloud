[190.349741, "i", "address range starts active and tests end on first line.\nold=\"if not self.a1: z=True\\n  elif not self.a2: z=self.a1.hit(E)\\n  elif self.active:\"\nnew=\"if not self.a1: z=True\\n  elif not self.a2: z=self.a1.hit(E)\\n  elif self.a1.k=='zero' and not hasattr(self,'zero_started'):\\n   self.zero_started=True;z=True;self.active=True\\n   if self.a2.hit(E):self.active=False\\n  elif self.active:\"\ns=s.replace(old,new)\n# c range emits only on closing line (or EOF), while deleting every selected line.\ns=s.replace(\"# A range emits replacement only when entering/ending per sed semantics.\\n    self.wr(c.arg+b'\\\\n');return 'delete'\", \"if not c.a2 or not c.active or self.islast:self.wr(c.arg+b'\\\\n')\\n    return 'delete'\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pysed/sed.py && python3 /tmp/diff.py\n"]
