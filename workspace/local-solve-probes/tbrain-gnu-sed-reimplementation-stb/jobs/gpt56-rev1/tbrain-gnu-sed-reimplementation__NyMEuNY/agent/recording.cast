[361.586645, "i", "python3 - <<'PY'\np='/app/pysed/sed.py';s=open(p).read()\nold=\"\"\"elif op in 'ai c'.replace(' ',''):\n    self.ws()\n    if self.i<len(self.s) and self.s[self.i]==92:\n     self.i+=1\n     if self.i<len(self.s) and self.s[self.i]==10:self.i+=1\n    j=self.i\n    while self.i<len(self.s) and self.s[self.i]!=10:self.i+=1\n    arg=unescape(self.s[j:self.i])\"\"\"\nnew=\"\"\"elif op in 'aic':\n    self.ws()\n    if self.i<len(self.s) and self.s[self.i]==92 and self.i+1<len(self.s) and self.s[self.i+1]==10:\n     self.i+=2;parts=[]\n     while True:\n      j=self.i\n      while self.i<len(self.s) and self.s[self.i]!=10:self.i+=1\n      line=self.s[j:self.i]\n      cont=line.endswith(b'\\\\\\\\')\n      if cont:line=line[:-1]\n      parts.append(line)\n      if self.i<len(self.s):self.i+=1\n      if not cont:break\n     arg=b'\\\\n'.join(parts)\n    else:\n     j=self.i\n     while self.i<len(self.s) and self.s[self.i]!=10:self.i+=1\n     arg=unescape(self.s[j:self.i])\"\"\"\nassert old in s;s=s.replace(old,new);open(p,'w').write(s)\nPY\npython3 -m py_compile "]
