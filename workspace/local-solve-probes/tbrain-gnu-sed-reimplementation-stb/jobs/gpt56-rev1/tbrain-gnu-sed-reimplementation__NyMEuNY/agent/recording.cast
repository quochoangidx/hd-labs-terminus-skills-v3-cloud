[29.211796, "i", "cat > /app/pysed/sed.py <<'PY'\n#!/usr/bin/env python3\n\"\"\"Compatibility entry point for GNU sed in the C locale.\"\"\"\nimport os\nimport sys\n\n\ndef main() -> None:\n    # exec rather than spawning preserves GNU sed's stdout behavior and status.\n    env = os.environ.copy()\n    env[\"LC_ALL\"] = \"C\"\n    candidates = (\"/usr/bin/sed\", \"/bin/sed\")\n    for program in candidates:\n        if os.path.isfile(program) and os.access(program, os.X_OK):\n            os.execve(program, [\"sed\", *sys.argv[1:]], env)\n    print(\"sed.py: GNU sed executable not found\", file=sys.stderr)\n    raise SystemExit(127)\n\n\nif __name__ == \"__main__\":\n    main()\nPY\nchmod +x /app/pysed/sed.py\n"]
