[564.885413, "o", "\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> cases=[\r\n\u001b[?2004l\r\u001b[?2004h>  ':go;{ :go;s/a/A/;p};s/A/Z/;p',\r\n\u001b[?2004l\r\u001b[?2004h>  'b in;{ :in;s/a/A/};s/A/Z/;p',\r\n\u001b[?2004l\r\u001b[?2004h>  'b in;{ :in;s/a/A/;b out};d;:out;p',\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> for script in cases:\r\n\u001b[?2004l\r\u001b[?2004h>  data=b'a\\nb\\n'\r\n\u001b[?2004l\r\u001b[?2004h>  g=subprocess.run(['/usr/bin/sed','-n',script],input=data,stdout=subprocess.PIPE)\r\n\u001b[?2004l\r\u001b[?2004h>  p=subprocess.run(['python3','/app/pysed/sed.py','-n',script],input=data,stdout=subprocess.PIPE)\r\n\u001b[?2004l\r\u001b[?2004h>  print(g.stdout==p.stdout,repr(script),repr(g.stdout),repr(p.stdout))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
