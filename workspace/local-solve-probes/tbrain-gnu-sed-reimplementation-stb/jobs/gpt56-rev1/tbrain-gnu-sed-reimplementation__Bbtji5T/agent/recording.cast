[23.317613, "i", "set -o pipefail\ncmp <(printf 'abc\\nAbc\\n' | LC_ALL=C sed -nE -e 's/(a)(b)/\\\\U\\\\1\\\\E-\\\\2/ip') <(printf 'abc\\nAbc\\n' | python3 /app/pysed/sed.py -n -E -e 's/(a)(b)/\\\\U\\\\1\\\\E-\\\\2/ip')\ncmp <(printf 'a\\0b\\n' | LC_ALL=C sed 's/a/X/') <(printf 'a\\0b\\n' | python3 /app/pysed/sed.py 's/a/X/')\nprintf 'x\\ny\\n' >/tmp/pysed.in\nLC_ALL=C sed -n -e '1h' -e '2{x;p}' /tmp/pysed.in >/tmp/ref; r1=$?\npython3 /app/pysed/sed.py -n -e '1h' -e '2{x;p}' /tmp/pysed.in >/tmp/got; r2=$?\ncmp /tmp/ref /tmp/got && test \"$r1\" = \"$r2\"\nLC_ALL=C sed -n p /definitely/missing >/tmp/ref 2>/dev/null; r1=$?\npython3 /app/pysed/sed.py -n p /definitely/missing >/tmp/got 2>/dev/null; r2=$?\ncmp /tmp/ref /tmp/got && test \"$r1\" = \"$r2\"\necho \"wrapper tests passed\"\n"]
