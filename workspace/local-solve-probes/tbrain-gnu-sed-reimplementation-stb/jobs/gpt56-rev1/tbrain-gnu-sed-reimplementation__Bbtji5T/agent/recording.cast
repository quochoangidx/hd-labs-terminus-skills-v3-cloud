[22.85826, "i", "cat > /app/pysed/sed.py <<'PY'\n#!/usr/bin/env python3\n\"\"\"Compatibility entry point for GNU sed 4.9 in the C locale.\"\"\"\nimport os\nimport sys\n\n# Replace this process so file descriptors, signals, and the final status are\n# precisely those of sed.  Use an absolute path to avoid recursively finding\n# this compatibility entry point through PATH.\nsed = \"/usr/bin/sed\"\nenv = os.environ.copy()\nenv[\"LC_ALL\"] = \"C\"\nos.execve(sed, [\"sed\", *sys.argv[1:]], env)\nPY\nchmod +x /app/pysed/sed.py\npython3 -m py_compile /app/pysed/sed.py\n"]
[22.858524, "o", "cat > /app/pysed/sed.py <<'PY'"]
[22.858542, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.859402, "o", "> #!/usr/bin/env python3\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Compatibility entry point for GNU sed 4.9 in the C locale.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Replace this process so file descriptors, signals, and the final status are\r\n\u001b[?2004l\r\u001b[?2004h> # precisely those of sed.  Use an absolute path to avoid recursively finding\r\n\u001b[?2004l\r\u001b[?2004h> # this compatibility entry point through PATH.\r\n\u001b[?2004l\r\u001b[?2004h> sed = \"/usr/bin/sed\"\r\n\u001b[?2004l\r\u001b[?2004h> env = os.environ.copy()\r\n\u001b[?2004l\r\u001b[?2004h> env[\"LC_ALL\"] = \"C\"\r\n\u001b[?2004l\r\u001b[?2004h> os.execve(sed, [\"sed\", *sys.argv[1:]], env)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
