 187    if v:
 188     c.active=True;c.started=True
 189     if zero and self.amatch(c.a2,line,no,last,c,True):c.active=False
 190     if c.a2[0]=='plus':c.end=no+c.a2[1]
 191     elif c.a2[0]=='tilde':c.end=no+(c.a2[1]-no%c.a2[1])
 192     # Numeric addr2 is tested immediately; regex addr2 starts next line.
 193     if c.a2[0]=='num' and self.amatch(c.a2,line,no,last,c,True):c.active=False
 194    
 195   else:
 196    v=True
 197    if self.amatch(c.a2,line,no,last,c,True):c.active=False
 198   return (not v) if c.neg else v
