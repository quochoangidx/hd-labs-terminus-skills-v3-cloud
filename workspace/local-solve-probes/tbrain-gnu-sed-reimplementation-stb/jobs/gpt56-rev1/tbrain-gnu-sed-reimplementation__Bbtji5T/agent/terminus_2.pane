 169    if self.lastre is None: raise ValueError('no previous regexp')
 170    return self.lastre
 171   r=RX(p,self.ere,bool(mods&1),bool(mods&2));self.lastre=r;return r
 172  def amatch(self,a,line,no,last,c,second=False):
 173   if not a:return True
 174   k=a[0]
 175   if k=='num':return no>=a[1] if second else no==a[1]
 176   if k=='last':return last
 177   if k=='step':return no>=a[1] and (no-a[1])%a[2]==0
 178   if k=='re':return self.regex(a[1],a[2]).search(line) is not None
 179   if k=='plus':return no<=c.end
 180   if k=='tilde':return no<c.end
 181   return False
 182  def selected(self,c,line,no,last):
 183   if not c.a2:v=self.amatch(c.a1,line,no,last,c)
 184   elif not c.active:
 185    zero=(c.a1[0]=='num' and c.a1[1]==0 and c.a2[0]=='re' and not c.started)
