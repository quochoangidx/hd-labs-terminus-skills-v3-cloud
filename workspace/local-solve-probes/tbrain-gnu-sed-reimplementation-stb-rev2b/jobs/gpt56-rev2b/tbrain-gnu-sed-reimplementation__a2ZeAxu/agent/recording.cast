[255.492115, "o", "class RX:\r\n    def __init__(self,p,ext=False,flags=''):\r\n        self.src=p; self.py=(ere_to_py(p) if ext else bre_to_py(p)); self.fl=re.ASCII|(re.I if 'I' in flags or 'i' in flags else 0)|(re.M if 'M' in flags or 'm' in flags else 0)\r\n    def search(self,s,start=0):\r\n        # Determine leftmost start, then longest end. Lookahead pins the endpoint\r\n        # without changing ^/$ and boundary context as slicing would.\r\n        for a in range(start,len(s)+1):\r\n            for b in range(len(s),a-1,-1):\r\n                try: m=re.compile('(?:'+self.py+')(?=[\\\\s\\\\S]{'+str(len(s)-b)+'}\\\\Z)',self.fl).match(s,a)\r\n                except re.error as e: raise SedError(str(e))\r\n                if m and m.end()==b: return m\r\n        return None\r\n\r\n\u001b[?2004hroot@b800598ff273:/app# # Search apt caches and package metadata for a usable reference\r\n\u001b[?2004l\r\u001b[?2004hroot@b800598ff273:/app# find /var/cache/apt /var/lib/apt/lists -type f 2>/dev/null | head; apt-cache show sed 2>/dev/null | head\r\n\u001b[?2004l\r/var/cache/apt/archives/"]
