[218.589112, "i", "W': o+=r'[^A-Za-z0-9_]'; i+=2; continue\\n            if n=='s': o+=r'[\\\\t\\\\n\\\\v\\\\f\\\\r ]'; i+=2; continue\\n            if n=='S': o+=r'[^\\\\t\\\\n\\\\v\\\\f\\\\r ]'; i+=2; continue\")\n# This replacement occurs in both BRE and ERE translators due to identical text.\ns=s.replace(\"v,k=escval(p,i+1); o+=re.escape(v); i=k; continue\", \"v,k=escval(p,i+1); o+=v; i=k; continue\")\n# Replace replacement expansion implementation.\na=s.index('    def replacement(self,rep,m):')\nb=s.index('    def subst(self,arg):',a)\nmethod=r'''    def replacement(self,rep,m):\n        out=''; i=0; persistent=None; one=None\n        def apply(z):\n            nonlocal one\n            if not z: return z\n            if persistent=='low': z=z.lower()\n            elif persistent=='up': z=z.upper()\n            if one=='low': z=z[:1].lower()+z[1:]; one=None\n            elif one=='up': z=z[:1].upper()+z[1:]; one=None\n            return z\n        while i<len(rep):\n            c=rep[i]\n            if c=='&': z=m.group(0); i+=1\n            elif c=='\\\\' and i+1<len(r"]
