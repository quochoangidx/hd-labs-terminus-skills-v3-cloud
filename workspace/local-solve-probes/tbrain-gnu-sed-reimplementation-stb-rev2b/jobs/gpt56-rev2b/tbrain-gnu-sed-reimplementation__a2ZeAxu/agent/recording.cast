[164.352816, "i", "python3 - <<'PY'\np='/app/pysed/sed.py'\ns=open(p).read()\ns=s.replace(\"self.op,self.a1,self.a2,self.neg,self.arg=op,a1,a2,neg,arg; self.active=False\", \"self.op,self.a1,self.a2,self.neg,self.arg=op,a1,a2,neg,arg; self.active=(a1 is not None and a2 is not None and a1.kind=='num' and a1.val==0); self.range_first=False\")\ns=s.replace(\"elif op=='l':\\n                j=self.i\", \"elif op in 'qQ':\\n                while self.i<len(self.s) and self.s[self.i] in ' \\\\t': self.i+=1\\n                j=self.i\\n                while self.i<len(self.s) and self.s[self.i].isdigit(): self.i+=1\\n                arg=int(self.s[j:self.i] or '0')\\n            elif op=='l':\\n                j=self.i\")\ns=s.replace(\"hit=True\\n        if c.a1:\", \"hit=True; c.range_first=False\\n        if c.a1:\")\ns=s.replace(\"elif c.active:\\n                hit=True\", \"elif c.active:\\n                hit=True\")\ns=s.replace(\"hit=c.a1.hit(self)\\n                if hit:\\n                    c.active=True\", \"hit=c.a1.hit(self)\\n                if hit:\\n      "]
[164.352975, "i", "              c.range_first=True\\n                    c.active=True\")\n# For initially active 0,/re/, line one is selected and may close immediately.\ns=s.replace(\"if c.a2.kind=='plus':\\n                    if self.lineno>=c._end\", \"if c.a1.kind=='num' and c.a1.val==0 and self.lineno==1: c.range_first=True\\n                if c.a2.kind=='plus':\\n                    if self.lineno>=c._end\")\ns=s.replace(\"elif o=='c': self.ps=c.arg; self.emit(self.ps+'\\\\n'); deleted=True; break\", \"elif o=='c':\\n                self.ps=c.arg\\n                if not c.a2 or c.range_first: self.emit(self.ps+'\\\\n')\\n                deleted=True; break\")\ns=s.replace(\"self.queue=[]\\n    def emit\", \"self.queue=[]; self.exitcode=None\\n    def emit\")\ns=s.replace(\"if o=='Q': deleted=True\\n                quitall=True; break\", \"if o=='Q': deleted=True\\n                self.exitcode=c.arg\\n                quitall=True; break\")\n# reader now updates islast itself; this also handles n/N.\ns=s.replace(\"z=lines[idx]; idx+=1; return z\", \"z=lines[idx"]
[164.352981, "i", "]; idx+=1; ed.islast=(idx==len(lines)); return z\")\ns=s.replace(\"z=reader(); ed.lineno+=1\\n            ed.islast=(idx==len(lines) and (sep or si==len(sources)-1))\", \"z=reader(); ed.lineno+=1\")\ns=s.replace(\"ed.lineno=0; ed.hold=''\\n            for c in cmd: c.active=False\", \"ed.lineno=0\\n            for c in cmd:\\n                c.active=(c.a1 is not None and c.a2 is not None and c.a1.kind=='num' and c.a1.val==0)\")\n# Flatten sources for normal mode, preserving only readable content and global numbering/$.\nneedle=\"\"\"    else: sources=[('-',sys.stdin.buffer.read().decode('latin1').splitlines())]\n    stop=False\n\"\"\"\nrepl=\"\"\"    else: sources=[('-',sys.stdin.buffer.read().decode('latin1').splitlines())]\n    if not sep and len(sources)>1:\n        all_lines=[]\n        for _,ls in sources: all_lines.extend(ls)\n        sources=[('',all_lines)]\n    stop=False\n\"\"\"\ns=s.replace(needle,repl)\ns=s.replace(\"return status\\nif __name__\", \"return ed.exitcode if ed.exitcode is not None else status\\nif __name__\")\nopen(p,'w').write("]
[164.352999, "i", "s)\nPY\npython3 -m py_compile /app/pysed/sed.py\n# Core behavioral smoke tests\nset -e\nT=/app/pysed/sed.py\nprintf '1\\n2\\n3\\n4\\n' | python3 \"$T\" '2,3c X'\nprintf 'a\\nb\\nc\\n' | python3 \"$T\" -n '0,/a/p'\nprintf 'abc\\ndef\\n' | python3 \"$T\" -n 'N;s/\\n/:/;p'\nprintf 'abc123\\n' | python3 \"$T\" -E 's/([a-z]+)([0-9]+)/\\U\\1-\\L\\2/'\nprintf 'a\\nb\\nc\\n' | python3 \"$T\" -n '1h;2H;3{g;p}'\nprintf 'x\\n' | python3 \"$T\" 'q 7' >/dev/null || test $? = 7\n"]
