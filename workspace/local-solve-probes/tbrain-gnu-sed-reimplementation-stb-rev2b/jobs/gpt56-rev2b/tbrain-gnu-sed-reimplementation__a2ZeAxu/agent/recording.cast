[218.586032, "i", "nge_last=not c.active\n                    elif c.a2.kind=='tilde':\n                        c.active=(self.lineno%c.a2.val)!=0; c.range_last=not c.active\n                    elif c.a2.kind=='rx':\n                        pass  # regexp endpoint starts being tested on the following line\n                    elif c.a2.kind=='num' and c.a2.val<=self.lineno:\n                        c.active=False; c.range_last=True\n                    elif c.a2.hit(self): c.active=False; c.range_last=True\n\"\"\"\nif old not in s: print('range block not found')\nelse: s=s.replace(old,new)\ns=s.replace(\"if not c.a2 or c.range_first: self.emit(self.ps+'\\\\n')\", \"if not c.a2 or c.range_last: self.emit(self.ps+'\\\\n')\")\n# n reads a new input line and therefore starts a fresh substitution-test interval.\ns=s.replace(\"self.ps=z; self.lineno+=1\\n            elif o=='N':\", \"self.ps=z; self.lineno+=1; self.subbed=False\\n            elif o=='N':\")\n# GNU whitespace regexp extensions.\ns=s.replace(\"if n=='W': o+=r'[^A-Za-z0-9_]'; i+=2; continue\", \"if n=='"]
