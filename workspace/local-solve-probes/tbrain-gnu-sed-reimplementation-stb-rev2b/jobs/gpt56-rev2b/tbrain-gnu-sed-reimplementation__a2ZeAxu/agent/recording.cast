[84.241395, "i", "cat > /app/pysed/sed.py <<'PY'\r#!/usr/bin/env python3\r\"\"\"Small, pure Python implementation of the documented GNU sed 4.9 language.\"\"\"\rimport sys, re\r\rclass SedError(Exception): pass\r\rdef escval(s, i, maxdigits=None):\r    \"\"\"Decode GNU numeric/simple escape beginning after backslash.\"\"\"\r    if i >= len(s): return '\\\\', i\r    c=s[i]\r    simple={'n':'\\n','t':'\\t','r':'\\r','f':'\\f','v':'\\v','a':'\\a','b':'\\b'}\r    if c in simple: return simple[c],i+1\r    bases={'d':10,'o':8,'x':16}\r    if c in bases:\r        base=bases[c]; j=i+1; lim=3 if c!='x' else 2\r        good='0123456789abcdefABCDEF' if base==16 else ('01234567' if base==8 else '0123456789')\r        while j<len(s) and j<i+1+lim and s[j] in good: j+=1\r        if j>i+1: return chr(int(s[i+1:j],base)&255),j\r    return c,i+1\r\rdef decode_chars(s):\r    out=''; i=0\r    while i<len(s):\r        if s[i]=='\\\\': c,i=escval(s,i+1); out+=c\r        else: out+=s[i]; i+=1\r    return out\r\rdef bre_to_py(p):\r    \"\"\"Translate GNU BRE syntax and its commonly documented extensions"]
