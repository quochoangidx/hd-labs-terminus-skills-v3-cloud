[292.589888, "i", "python3 - <<'PY'\np='/app/pysed/sed.py'; s=open(p).read()\n# Preprocess numeric GNU escapes before parsing regex structure, including brackets.\ninsert='''\\ndef numeric_escapes(p):\n    out=''; i=0\n    while i<len(p):\n        if p[i]=='\\\\\\\\' and i+1<len(p) and p[i+1] in 'dox':\n            v,j=escval(p,i+1); out+=v; i=j\n        else: out+=p[i]; i+=1\n    return out\n'''\npos=s.index('\\ndef bre_to_py')\ns=s[:pos]+insert+s[pos:]\ns=s.replace(\"def bre_to_py(p):\\n    \\\"\\\"\\\"Translate\", \"def bre_to_py(p):\\n    p=numeric_escapes(p)\\n    \\\"\\\"\\\"Translate\")\ns=s.replace(\"def ere_to_py(p):\\n    o=''; i=0\", \"def ere_to_py(p):\\n    p=numeric_escapes(p)\\n    o=''; i=0\")\n# Cache endpoint regexes in each RX.\ns=s.replace(\"self.src=p; self.py=(ere_to_py(p) if ext else bre_to_py(p)); self.fl=\", \"self.src=p; self.py=(ere_to_py(p) if ext else bre_to_py(p)); self.cache={}; self.fl=\")\ns=s.replace(\"try: m=re.compile('(?:'+self.py+')(?=[\\\\\\\\s\\\\\\\\S]{'+str(len(s)-b)+'}\\\\\\\\Z)',self.fl).match(s,a)\\n                except re.error as e: raise SedErr"]
[292.589949, "i", "or(str(e))\", \"try:\\n                    rem=len(s)-b\\n                    if rem not in self.cache: self.cache[rem]=re.compile('(?:'+self.py+')(?=[\\\\\\\\s\\\\\\\\S]{'+str(rem)+'}\\\\\\\\Z)',self.fl)\\n                    m=self.cache[rem].match(s,a)\\n                except re.error as e: raise SedError(str(e))\")\n# Cache RX instances at editor level.\ns=s.replace(\"self.queue=[]; self.exitcode=None\", \"self.queue=[]; self.exitcode=None; self.rxcache={}\")\nold=\"\"\"    def rx(self,p,mods=''):\n        if p=='': p=self.lastpat\n        else: self.lastpat=p\n        return RX(p,self.ext,mods)\n\"\"\"\nnew=\"\"\"    def rx(self,p,mods=''):\n        if p=='': p=self.lastpat\n        else: self.lastpat=p\n        key=(p,mods)\n        if key not in self.rxcache: self.rxcache[key]=RX(p,self.ext,mods)\n        return self.rxcache[key]\n\"\"\"\nif old not in s: print('rx method not found')\nelse: s=s.replace(old,new)\n# Suppress an empty global match directly after a consumed non-empty match.\ns=s.replace(\"pos=0; count=0; out=''; changed=False\", \"pos=0; count"]
[292.589961, "i", "=0; out=''; changed=False; nonempty_end=-1\")\ns=s.replace(\"count+=1; do=(count>=nth if glob else count==nth)\", \"count+=1\\n            if glob and m.start()==m.end()==nonempty_end:\\n                if pos<len(self.ps): out+=self.ps[pos]; pos+=1; nonempty_end=-1; continue\\n                break\\n            do=(count>=nth if glob else count==nth)\")\ns=s.replace(\"out+=self.ps[pos:m.start()]+self.replacement(rep,m); changed=True; pos=m.end()\", \"out+=self.ps[pos:m.start()]+self.replacement(rep,m); changed=True; pos=m.end()\\n                if m.end()>m.start(): nonempty_end=m.end()\")\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pysed/sed.py\nT=/app/pysed/sed.py\nprintf 'ab\\n' | python3 \"$T\" 's/[ab]*/X/g'\nprintf 'ab\\n' | python3 \"$T\" 's/x*/Y/g'\nprintf 'A B\\n' | python3 \"$T\" 's/[\\d065-\\x42]/X/g'\nprintf 'ab\\n' | python3 \"$T\" -E 's/a|ab/X/'\n"]
