[84.244987, "i", "lf.fl).match(s,a)\r                except re.error as e: raise SedError(str(e))\r                if m and m.end()==b: return m\r        return None\r\rclass Addr:\r    def __init__(self,kind,val=None,mod=''): self.kind,self.val,self.mod=kind,val,mod\r    def hit(self,ed):\r        n=ed.lineno\r        if self.kind=='num': return n==self.val\r        if self.kind=='last': return ed.islast\r        if self.kind=='step': a,b=self.val; return n>=a and (n-a)%b==0\r        if self.kind=='rx': return ed.matchrx(self.val,self.mod) is not None\r        return False\r\rclass Cmd:\r    def __init__(self,op,a1=None,a2=None,neg=False,arg=None):\r        self.op,self.a1,self.a2,self.neg,self.arg=op,a1,a2,neg,arg; self.active=False\r\rclass Parser:\r    def __init__(self,s,ext=False): self.s=s; self.i=0; self.ext=ext; self.cmd=[]; self.labels={}; self.fix=[]\r    def skip(self):\r        while self.i<len(self.s) and self.s[self.i] in ' \\t;\\n': self.i+=1\r    def regex_delim(self,d):\r        out=''; bracket=False\r        while self.i<len(self.s):\r"]
