[234.584669, "o", "\r\n--- class RX: ---\r\n class RX:\r\n\r\n---     def selected(self,c): ---\r\n     def selected(self,c):\r\n        hit=True; c.range_first=False; c.range_last=False\r\n        if c.a1:\r\n            if not c.a2: hit=c.a1.hit(self)\r\n            elif c.active:\r\n                hit=True\r\n                if c.a1.kind=='num' and c.a1.val==0 and self.lineno==1: c.range_first=True\r\n                if c.a2.kind=='plus':\r\n                    if self.lineno>=c._end: c.active=False; c.range_last=True\r\n                elif c.a2.kind=='tilde':\r\n                    if self.lineno%c.a2.val==0: c.active=False; c.range_last=True\r\n                elif c.a2.hit(self): c.active=False; c.range_last=True\r\n            else:\r\n                hit=c.a1.hit(self)\r\n                if hit:\r\n                    c.range_first=True\r\n                    c.active=True\r\n                    if c.a2.kind=='plus': c._end=self.lineno+c.a2.val; c.active=c.a2.val!=0\r\n                    elif c.a2.kind=='tilde': c.active=(self.lineno%c.a2.val)!=0\r\n              "]
[234.584695, "o", "      elif c.a2.kind=='rx' and c.a1.kind!='num': pass\r\n                    elif c.a2.hit(self): c.active=False; c.range_last=True\r\n        return (not hit) if c.neg else hit\r\n\r\n---     def replacement(self,rep,m): ---\r\n     def replacement(self,rep,m):\r\n        out=''; i=0; persistent=None; one=None\r\n        def apply(z):\r\n            nonlocal one\r\n            if not z: return z\r\n            if persistent=='low': z=z.lower()\r\n            elif persistent=='up': z=z.upper()\r\n            if one=='low': z=z[:1].lower()+z[1:]; one=None\r\n            elif one=='up': z=z[:1].upper()+z[1:]; one=None\r\n            return z\r\n        while i<len(rep):\r\n            c=rep[i]\r\n            if c=='&': z=m.group(0); i+=1\r\n            elif c=='\\\\' and i+1<len(rep):\r\n                n=rep[i+1]; i+=2\r\n                if n.isdigit() and n!='0':\r\n                    try: z=m.group(int(n)) or ''\r\n                    except IndexError: z=''\r\n                elif n=='L': persistent='low'; z=''\r\n                elif n=='U': persistent='"]
[234.584703, "o", "up'; z=''\r\n                elif n=='E': persistent=None; z=''\r\n                elif n=='l': one='low'; z=''\r\n                elif n=='u': one='up'; z=''\r\n                elif n in 'ntrfvado x'.replace(' ',''):\r\n                    z,k=escval(rep,i-1); i=k\r\n                else: z=n\r\n            else: z=c; i+=1\r\n            out+=apply(z)\r\n        return out\r\n\r\n"]
