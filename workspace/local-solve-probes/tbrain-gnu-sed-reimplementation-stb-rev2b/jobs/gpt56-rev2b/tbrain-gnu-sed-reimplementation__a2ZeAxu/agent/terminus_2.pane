[?2004l[?2004h> # then invert bit 6. This shared decoder serves regex, replacement and y.
[?2004l[?2004h> old="""    if c in simple: return simple[c],i+1
[?2004l[?2004h>     bases={'d':10,'o':8,'x':16}
[?2004l[?2004h> """
[?2004l[?2004h> new="""    if c in simple: return simple[c],i+1
[?2004l[?2004h>     if c=='c' and i+1<len(s):
[?2004l[?2004h>         x=s[i+1]
[?2004l[?2004h>         if 'a'<=x<='z': x=x.upper()
[?2004l[?2004h>         return chr(ord(x)^64),i+2
[?2004l[?2004h>     bases={'d':10,'o':8,'x':16}
[?2004l[?2004h> """
[?2004l[?2004h> if old not in s: print('escape insertion point not found')
[?2004l[?2004h> else: s=s.replace(old,new)
