--- class RX: ---
 class RX:

---     def selected(self,c): ---
     def selected(self,c):
        hit=True; c.range_first=False; c.range_last=False
        if c.a1:
            if not c.a2: hit=c.a1.hit(self)
            elif c.active:
                hit=True
                if c.a1.kind=='num' and c.a1.val==0 and self.lineno==1: c.range_first=True
                if c.a2.kind=='plus':
                    if self.lineno>=c._end: c.active=False; c.range_last=True
                elif c.a2.kind=='tilde':
                    if self.lineno%c.a2.val==0: c.active=False; c.range_last=True
                elif c.a2.hit(self): c.active=False; c.range_last=True
            else:
                hit=c.a1.hit(self)
                if hit:
                    c.range_first=True
                    c.active=True
                    if c.a2.kind=='plus': c._end=self.lineno+c.a2.val; c.active=c.a2.val!=0
                    elif c.a2.kind=='tilde': c.active=(self.lineno%c.a2.val)!=0
                    elif c.a2.kind=='rx' and c.a1.kind!='num': pass
                    elif c.a2.hit(self): c.active=False; c.range_last=True
        return (not hit) if c.neg else hit

---     def replacement(self,rep,m): ---
     def replacement(self,rep,m):
        out=''; i=0; persistent=None; one=None
        def apply(z):
            nonlocal one
            if not z: return z
            if persistent=='low': z=z.lower()
            elif persistent=='up': z=z.upper()
            if one=='low': z=z[:1].lower()+z[1:]; one=None
            elif one=='up': z=z[:1].upper()+z[1:]; one=None
            return z
        while i<len(rep):
            c=rep[i]
            if c=='&': z=m.group(0); i+=1
            elif c=='\\' and i+1<len(rep):
                n=rep[i+1]; i+=2
                if n.isdigit() and n!='0':
                    try: z=m.group(int(n)) or ''
                    except IndexError: z=''
                elif n=='L': persistent='low'; z=''
                elif n=='U': persistent='up'; z=''
                elif n=='E': persistent=None; z=''
                elif n=='l': one='low'; z=''
                elif n=='u': one='up'; z=''
                elif n in 'ntrfvado x'.replace(' ',''):
                    z,k=escval(rep,i-1); i=k
                else: z=n
            else: z=c; i+=1
            out+=apply(z)
        return out

