 298 def replacement(rep,m):
 299     out=[]; i=0; mode=None; once=None
 300     def put(x):
 301         nonlocal once
 302         if once=='lower' and x: x=x[0].lower()+x[1:]; once=None
 303         elif once=='upper' and x: x=x[0].upper()+x[1:]; once=None
 304         if mode=='lower': x=x.lower()
 305         elif mode=='upper': x=x.upper()
 306         out.append(x)
 307     while i<len(rep):
 308         c=rep[i]
 309         if c=='&': put(m.group(0)); i+=1; continue
 310         if c=='\\' and i+1<len(rep):
 311             n=rep[i+1]; i+=2
 312             if n.isdigit() and n!='0':
 313                 try: put(m.group(int(n)) or '')
 314                 except IndexError: put('')
 315             elif n=='L': mode='lower'
 316             elif n=='U': mode='upper'
 317             elif n=='E': mode=None
 318             elif n=='l': once='lower'
 319             elif n=='u': once='upper'
 320             else:
 321                 v,j=escseq(rep,i-1)
 322                 if v is not None: put(v); i=j
 323                 else: put(n)
 324             continue
 325         put(c); i+=1
 326     return ''.join(out)
 327 
 328 def substitute(text,arg):
 329     rx,rep,flags,num=arg; matches=[]; pos=0
 330     while pos<=len(text):
 331         m=rx.search(text,pos)
 332         if not m: break
 333         matches.append(m)
 334         pos=m.end() if m.end()>m.start() else m.end()+1
 335     if not matches: return text,False
 336     chosen=[]
 337     if num is not None:
 338         if 1<=num<=len(matches):
 339             chosen=matches[num-1:] if 'g' in flags else [matches[num-1]]
 340     elif 'g' in flags: chosen=matches
 341     else: chosen=[matches[0]]
 342     if not chosen: return text,False
 343     out=[]; last=0
 344     for m in chosen:
 345         out.append(text[last:m.start()]); out.append(replacement(rep,m)); last=m.end()
 346     out.append(text[last:])
 347     return ''.join(out),True
 348 
 349 def listline(s,width):
 350     parts=[]
 351     for ch in s:
 352         o=ord(ch)
 353         mp={'\a':r'\a','\b':r'\b','\f':r'\f','\n':r'\n','\r':r'\r','\t':r'\t','\v':r'\v','\\':r'\\'}
 354         if ch in mp: parts.append(mp[ch])
 355         elif 32<=o<127: parts.append(ch)
 356         else: parts.append('\\%03o'%o)
 357     parts.append('$')
 358     if not width: return ''.join(parts)+'\n'
 359     out=''; col=0
 360     for x in parts:
 361         if col+len(x)>width-1:
 362             out+='\\\n'; col=0
 363         out+=x; col+=len(x)
 364     return out+'\n'
