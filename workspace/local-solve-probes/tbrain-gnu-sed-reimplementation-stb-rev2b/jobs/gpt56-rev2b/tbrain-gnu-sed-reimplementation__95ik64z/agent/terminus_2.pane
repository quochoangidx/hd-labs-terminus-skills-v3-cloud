 268 def selected(c,ctx):
 269     if c.a1 is None:
 270         yes=True
 271     elif c.a2 is None:
 272         yes=c.a1.match(ctx,c)
 273     else:
 274         just=False
 275         if c.active:
 276             yes=True
 277         elif c.a1.match(ctx,c):
 278             yes=True; just=True
 279         else:
 280             yes=False
 281         if yes:
 282             end=False
 283             if c.active:                         # range started earlier
 284                 if c.a2.kind=='plus': end=ctx.lineno>=c.range_end
 285                 elif c.a2.kind=='untilmod': end=(ctx.lineno%c.a2.val)==0
 286                 else: end=c.a2.match(ctx,c)
 287             elif just:
 288                 if c.a2.kind=='plus':
 289                     c.range_end=ctx.lineno+c.a2.val
 290                     end=c.a2.val==0
 291                 elif c.a2.kind=='untilmod': end=False
 292                 elif c.a2.kind=='num': end=ctx.lineno>=c.a2.val
 293                 else: end=False                  # regex tested from next line
 294             if end: c.active=False
 295             else: c.active=True
 296     return (not yes) if c.bang else yes
