[148.210824, "o", "            if c.active:                         # range started earlier\r\n\u001b[?2004l\r\u001b[?2004h>                 if c.a2.kind=='plus': end=ctx.lineno>=c.range_end\r\n\u001b[?2004l\r\u001b[?2004h>                 elif c.a2.kind=='untilmod': end=(ctx.lineno%c.a2.val)==0\r\n\u001b[?2004l\r\u001b[?2004h>                 else: end=c.a2.match(ctx,c)\r\n\u001b[?2004l\r\u001b[?2004h>             elif just:\r\n\u001b[?2004l\r\u001b[?2004h>                 if c.a2.kind=='plus':\r\n\u001b[?2004l\r\u001b[?2004h>                     c.range_end=ctx.lineno+c.a2.val\r\n\u001b[?2004l\r\u001b[?2004h>                     end=c.a2.val==0\r\n\u001b[?2004l\r\u001b[?2004h>                 elif c.a2.kind=='untilmod': end=False\r\n\u001b[?2004l\r"]
