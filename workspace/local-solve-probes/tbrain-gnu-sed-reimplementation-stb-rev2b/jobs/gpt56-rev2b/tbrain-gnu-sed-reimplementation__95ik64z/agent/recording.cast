[327.207797, "i", "python3 - <<'PY'\nL=open('/app/docs/sed.txt',encoding='utf8').read().splitlines()\nprint('COMMAND HEADINGS')\nfor i in range(427-1,1223-1):\n x=L[i]\n if x.startswith('‘') and x.endswith('’') and len(x)<35: print(i+1,x)\nprint('\\nANCHOR PASSAGES')\nfor i in range(1756-1,1965-1):\n x=L[i]\n if 'beginning' in x.lower() or 'end of' in x.lower() or 'caret' in x.lower() or 'dollar' in x.lower():\n  print(f'---{i+1}---'); print('\\n'.join(L[max(0,i-2):i+5]))\nPY\n"]
