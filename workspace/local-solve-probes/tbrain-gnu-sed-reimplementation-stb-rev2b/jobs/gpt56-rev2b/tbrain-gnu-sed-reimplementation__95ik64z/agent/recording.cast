[360.747406, "i", "elf.runlist(self.cmds,ctx)\n                if r=='restart': continue\n                while isinstance(r,tuple) and r[0]=='branch' and r[1]:\n                    cs,j=r[1]; r=self.runlist(cs,ctx,j+1)\n                    if r=='restart': break\n                if r=='restart': continue\n                break\n\"\"\"\nif old2 not in s: print('branch patch pattern not found')\nelse: s=s.replace(old2,new2)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pysed/sed.py\nprintf 'a^b a$b\\n' | python3 /app/pysed/sed.py 's/a^b/X/;s/a$b/Y/'\nprintf 'ab\\n' | python3 /app/pysed/sed.py 's/^a/X/;s/b$/Y/'\nprintf 'a\\nb\\n' | python3 /app/pysed/sed.py -n 'N;/^b/ p;/b$/p'\nprintf 'x\\n' | python3 /app/pysed/sed.py -n 'b in;:out;p;d;{ :in; b out }'\nprintf 'x\\n' | python3 /app/pysed/sed.py -n 'b a;:c;p;d;:a;b b;:b;b c'\n"]
