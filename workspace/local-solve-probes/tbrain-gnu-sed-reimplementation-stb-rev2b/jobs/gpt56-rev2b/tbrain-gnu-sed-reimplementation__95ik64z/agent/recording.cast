[148.207473, "o", "        for st in range(pos,len(text)+1):\r\n\u001b[?2004l\r\u001b[?2004h>             for en in range(len(text),st-1,-1):\r\n\u001b[?2004l\r\u001b[?2004h>                 m=self.end.match(text[:en],st)\r\n\u001b[?2004l\r\u001b[?2004h>                 if m is not None: return m\r\n\u001b[?2004l\r\u001b[?2004h>         return None\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> new='''    def search(self,text,pos=0):\r\n\u001b[?2004l\r\u001b[?2004h>         # POSIX leftmost-longest.  The suffix assertion constrains the end while\r\n\u001b[?2004l\r\u001b[?2004h>         # matching against the original string, so ^, $, and \\\\Z retain meaning.\r\n\u001b[?2004l\r\u001b[?2004h>         n=len(text)\r\n\u001b[?2004l\r\u001b[?2004h>         for st in range(pos,n+1):\r\n\u001b[?2004l\r\u001b[?2004h>             for en in range(n,st-1,-1):\r\n\u001b[?2004l\r\u001b[?2004h>                 tail=n-en\r\n\u001b[?2004l\r\u001b[?2004h>                 q=self._end_cache.get(tail)\r\n\u001b[?2004l\r\u001b[?2004h>                 if q is None:\r\n\u001b[?2004l\r\u001b[?2004h>                     q=re.compile('(?:'+regex_translate(self.src, bool(getattr(self,'extended',False)))+\r\n\u001b[?2004l\r\u001b[?2004h> "]
