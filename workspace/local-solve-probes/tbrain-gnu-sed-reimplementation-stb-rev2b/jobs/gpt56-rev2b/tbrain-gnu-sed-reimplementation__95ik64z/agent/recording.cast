[16.116989, "o", "# pysed\r\n\r\nA Python replacement for GNU sed 4.9, for the minimal images that ship\r\nwithout sed.\r\n\r\n- `pysed/sed.py` — the command (`python3 /app/pysed/sed.py ...`)\r\n- `docs/sed.txt` — the GNU sed manual\r\n"]
[16.121614, "o", "\r\n--- sed.py ---\r\n"]
[16.125829, "o", "\"\"\"pysed: a GNU sed 4.9 replacement in pure Python.\r\n\r\nUsage: python3 /app/pysed/sed.py [OPTION]... {script-only-if-no-other-script} [input-file]...\r\n\"\"\"\r\n\r\nimport sys\r\n\r\n\r\ndef main(argv):\r\n    sys.stderr.write(\"pysed: not implemented yet\\n\")\r\n    return 4\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main(sys.argv[1:]))\r\n\u001b[?2004hroot@475347c7083e:/app# "]
[16.625412, "i", "python3 - <<'PY'\np='/app/docs/sed.txt'\nlines=open(p,encoding='utf-8').read().splitlines()\nfor a,b in [(354,427),(427,720),(720,1223),(1223,1391),(1391,1670),(1670,2338)]:\n print(f'\\n===== {a}-{b} =====')\n print('\\n'.join(lines[a-1:b-1]))\nPY\n"]
