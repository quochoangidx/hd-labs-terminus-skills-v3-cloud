[294.951485, "i", "set -x\nprintf 'a\\nb\\n' | python3 /app/pysed/sed.py -n 'N;s/a.b/X/;p'\nprintf 'x foo! food _foo\\n' | python3 /app/pysed/sed.py 's/\\<foo\\>/X/g'\nprintf 'xxab\\n' | python3 /app/pysed/sed.py -E 's/(a|ab)/X/'\nprintf 'ab\\n' | python3 /app/pysed/sed.py -E 's/(ab|a)/X/'\nprintf 'a] - z\\n' | python3 /app/pysed/sed.py 's/[]-]/X/g'\nprintf 'AaA\\n' | python3 /app/pysed/sed.py 's/a/X/2Ip'\nprintf '1\\n2\\n3\\n' | python3 /app/pysed/sed.py '1a A;2i I;2c C'\nprintf 'a\\nb\\nc\\nd\\n' >/tmp/f1; printf 'e\\nf\\n' >/tmp/f2; python3 /app/pysed/sed.py -s -n '2,3p' /tmp/f1 /tmp/f2\nset +x\n"]
