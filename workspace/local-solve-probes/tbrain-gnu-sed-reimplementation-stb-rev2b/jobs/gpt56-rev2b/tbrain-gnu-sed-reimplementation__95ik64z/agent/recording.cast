[176.928799, "o", "\r\n‘a\\’\r\n‘TEXT’\r\n     Append TEXT after a line.\r\n\r\n‘a TEXT’\r\n     Append TEXT after a line (alternative syntax).\r\n\r\n‘b LABEL’\r\n     Branch unconditionally to LABEL.  The LABEL may be omitted, in\r\n     which case the next cycle is started.\r\n     Append TEXT after a line.\r\n\r\n‘a TEXT’\r\n     Append TEXT after a line (alternative syntax).\r\n\r\n‘b LABEL’\r\n     Branch unconditionally to LABEL.  The LABEL may be omitted, in\r\n     which case the next cycle is started.\r\n\r\n‘c\\’\r\n‘TEXT’\r\n"]
