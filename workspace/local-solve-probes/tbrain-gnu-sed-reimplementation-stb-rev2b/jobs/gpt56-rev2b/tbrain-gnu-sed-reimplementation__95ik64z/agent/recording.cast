[98.597491, "i", "cat > /app/pysed/sed.py <<'PY'\r#!/usr/bin/env python3\r\"\"\"Small, pure Python implementation of the documented GNU sed subset.\"\"\"\rimport sys, re\r\rclass SedError(Exception): pass\r\rdef escseq(s, i, regex=False):\r    \"\"\"Return (character or None, new index). None means preserve backslash.\"\"\"\r    if i >= len(s): return None, i\r    c=s[i]\r    simple={'a':'\\a','f':'\\f','n':'\\n','r':'\\r','t':'\\t','v':'\\v'}\r    if c in simple: return simple[c], i+1\r    bases={'d':10,'o':8,'x':16}\r    if c in bases:\r        base=bases[c]; lim=2 if c=='x' else 3; j=i+1\r        valid='0123456789abcdefABCDEF' if base==16 else ('01234567' if base==8 else '0123456789')\r        while j<len(s) and j<i+1+lim and s[j] in valid: j+=1\r        if j>i+1: return chr(int(s[i+1:j],base)&255),j\r    return None,i\r\rdef decode_text(s):\r    out=[]; i=0\r    while i<len(s):\r        if s[i]=='\\\\':\r            v,j=escseq(s,i+1)\r            if v is not None: out.append(v); i=j; continue\r            if i+1<len(s): out.append(s[i+1]); i+=2; continue\r        out.ap"]
[98.597772, "i", "pend(s[i]); i+=1\r    return ''.join(out)\r\rPOSIX_CLASSES={\r 'alnum':'A-Za-z0-9','alpha':'A-Za-z','blank':' \\\\t','cntrl':'\\\\x00-\\\\x1f\\\\x7f',\r 'digit':'0-9','graph':'!-~','lower':'a-z','print':' -~','punct':r'!-/:-@[-`{-~',\r 'space':'\\\\t\\\\n\\\\v\\\\f\\\\r ','upper':'A-Z','xdigit':'A-Fa-f0-9'\r}\r\rdef bracket(src,i):\r    # i points after '['; return translated class and index after ']'\r    neg=''\r    if i<len(src) and src[i]=='^': neg='^'; i+=1\r    out=[]\r    if i<len(src) and src[i]==']': out.append(r'\\]'); i+=1\r    while i<len(src):\r        if src[i]==']': return '['+neg+''.join(out)+']',i+1\r        if src.startswith('[:',i):\r            k=src.find(':]',i+2)\r            if k>=0 and src[i+2:k] in POSIX_CLASSES:\r                out.append(POSIX_CLASSES[src[i+2:k]]); i=k+2; continue\r        if src.startswith('[=',i):\r            k=src.find('=]',i+2)\r            if k>=0:\r                out.append(re.escape(src[i+2:k])); i=k+2; continue\r        if src.startswith('[.',i):\r            k=src.find('.]',i+2)\r            if k>=0"]
[98.597782, "i", ":\r                out.append(re.escape(src[i+2:k])); i=k+2; continue\r        c=src[i]\r        if c=='\\\\' and i+1<len(src):\r            v,j=escseq(src,i+1,True)\r            if v is not None: out.append(re.escape(v)); i=j; continue\r            n=src[i+1]\r            if n in 'dDsSwW': out.append('\\\\'+n); i+=2; continue\r            if n in ']-\\\\^': out.append('\\\\'+n); i+=2; continue\r            out.append(re.escape(n)); i+=2; continue\r        if c=='[': out.append(r'\\[')\r        elif c=='\\\\': out.append(r'\\\\')\r        else: out.append(c)\r        i+=1\r    return r'\\[',i\r\rdef regex_translate(src, extended=False):\r    out=[]; i=0\r    while i<len(src):\r        c=src[i]\r        if c=='[':\r            x,i=bracket(src,i+1); out.append(x); continue\r        if c=='\\\\':\r            if i+1>=len(src): out.append(r'\\\\'); break\r            n=src[i+1]\r            v,j=escseq(src,i+1,True)\r            if v is not None: out.append(re.escape(v)); i=j; continue\r            if n in '123456789': out.append('\\\\'+n); i+=2; continue\r    "]
[98.597785, "i", "        if n in 'bB': out.append('\\\\'+n); i+=2; continue\r            if n=='w': out.append('[A-Za-z0-9_]'); i+=2; continue\r            if n=='W': out.append('[^A-Za-z0-9_]'); i+=2; continue\r            if n=='s': out.append('[\\\\t\\\\n\\\\v\\\\f\\\\r ]'); i+=2; continue\r            if n=='S': out.append('[^\\\\t\\\\n\\\\v\\\\f\\\\r ]'); i+=2; continue\r            if n=='<': out.append(r'(?<![A-Za-z0-9_])(?=[A-Za-z0-9_])'); i+=2; continue\r            if n=='>': out.append(r'(?<=[A-Za-z0-9_])(?![A-Za-z0-9_])'); i+=2; continue\r            if n=='`': out.append(r'\\A'); i+=2; continue\r            if n==\"'\": out.append(r'\\Z'); i+=2; continue\r            if not extended and n in '()|+?': out.append(n); i+=2; continue\r            if not extended and n=='{': out.append('{'); i+=2; continue\r            out.append(re.escape(n)); i+=2; continue\r        if not extended and c in '()+?|{}': out.append('\\\\'+c)\r        else: out.append(c)\r        i+=1\r    return ''.join(out)\r\rclass RX:\r    def __init__(self,src,extended=False,mods=''):\r        "]
[98.59782, "i", "self.src=src; self.mods=mods\r        flags=re.ASCII\r        if 'I' in mods or 'i' in mods: flags|=re.I\r        if 'M' in mods or 'm' in mods: flags|=re.M\r        p=regex_translate(src,extended)\r        try:\r            self.re=re.compile(p,flags)\r            self.end=re.compile('(?:'+p+r')(?=\\Z)',flags)\r        except re.error as e: raise SedError(str(e))\r    def search(self,text,pos=0):\r        # POSIX leftmost-longest. Trying suffix ends also resolves alternation length.\r        for st in range(pos,len(text)+1):\r            for en in range(len(text),st-1,-1):\r                m=self.end.match(text[:en],st)\r                if m is not None: return m\r        return None\r\rclass Addr:\r    def __init__(self,kind,val=None): self.kind=kind; self.val=val\r    def match(self,ctx,cmd):\r        k=self.kind\r        if k=='num': return ctx.lineno==self.val\r        if k=='last': return ctx.islast\r        if k=='step':\r            first,step=self.val\r            return ctx.lineno>=first and (ctx.lineno-first)%step==0\r     "]
