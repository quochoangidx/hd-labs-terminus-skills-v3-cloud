[148.201818, "i", "python3 - <<'PY'\np='/app/pysed/sed.py'\ns=open(p).read()\ns=s.replace(\"        self.src=src; self.mods=mods\\n        flags=re.ASCII\", \"        self.src=src; self.mods=mods\\n        flags=re.ASCII\")\ns=s.replace(\"            self.end=re.compile('(?:'+p+r')(?=\\\\Z)',flags)\\n\", \"            self.end=re.compile('(?:'+p+r')(?=\\\\Z)',flags)\\n            self._end_cache={}\\n\")\nold='''    def search(self,text,pos=0):\n        # POSIX leftmost-longest. Trying suffix ends also resolves alternation length.\n        for st in range(pos,len(text)+1):\n            for en in range(len(text),st-1,-1):\n                m=self.end.match(text[:en],st)\n                if m is not None: return m\n        return None\n'''\nnew='''    def search(self,text,pos=0):\n        # POSIX leftmost-longest.  The suffix assertion constrains the end while\n        # matching against the original string, so ^, $, and \\\\Z retain meaning.\n        n=len(text)\n        for st in range(pos,n+1):\n            for en in range(n,st-1,-1):\n                tail=n-en\n   "]
