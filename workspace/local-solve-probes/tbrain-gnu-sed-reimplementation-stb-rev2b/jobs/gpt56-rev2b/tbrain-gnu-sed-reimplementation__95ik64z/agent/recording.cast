[327.235698, "o", "COMMAND HEADINGS\r\n435 ‘a\\’\r\n436 ‘TEXT’\r\n439 ‘a TEXT’\r\n442 ‘b LABEL’\r\n446 ‘c\\’\r\n447 ‘TEXT’\r\n450 ‘c TEXT’\r\n453 ‘d’\r\n456 ‘D’\r\n464 ‘e’\r\n469 ‘e COMMAND’\r\n474 ‘F’\r\n478 ‘g’\r\n482 ‘G’\r\n486 ‘h’\r\n490 ‘H’\r\n494 ‘i\\’\r\n495 ‘TEXT’\r\n498 ‘i TEXT’\r\n501 ‘l’\r\n504 ‘n’\r\n510 ‘N’\r\n515 ‘p’\r\n518 ‘P’\r\n521 ‘q[EXIT-CODE]’\r\n524 ‘Q[EXIT-CODE]’\r\n529 ‘r filename’\r\n532 ‘R filename’\r\n537 ‘s/REGEXP/REPLACEMENT/[FLAGS]’\r\n542 ‘t LABEL’\r\n548 ‘T LABEL’\r\n554 ‘v [VERSION]’\r\n559 ‘w filename’\r\n562 ‘W filename’\r\n566 ‘x’\r\n569 ‘y/src/dst/’\r\n"]
