[7.382393, "o", "/app:\r\ntotal 20\r\ndrwxr-xr-x 1 root root 4096 Sep 24 12:20 .\r\ndrwxr-xr-x 1 root root 4096 Sep 24 12:21 ..\r\n-rw-r--r-- 1 root root  211 Sep 24 12:20 README.md\r\ndrwxr-xr-x 2 root root 4096 Sep 24 12:20 docs\r\ndrwxr-xr-x 2 root root 4096 Sep 24 12:20 pyed\r\n\r\n/app/docs:\r\ntotal 48\r\ndrwxr-xr-x 2 root root  4096 Sep 24 12:20 .\r\ndrwxr-xr-x 1 root root  4096 Sep 24 12:20 ..\r\n-rw-r--r-- 1 root root 40837 Sep 24 12:20 ed.txt\r\n\r\n/app/pyed:\r\ntotal 12\r\ndrwxr-xr-x 2 root root 4096 Sep 24 12:20 .\r\ndrwxr-xr-x 1 root root 4096 Sep 24 12:20 ..\r\n-rw-r--r-- 1 root root  261 Sep 24 12:20 ed.py\r\n\u001b[?2004hroot@68ab857d1493:/app# "]
