[125.070108, "i", "cat > /app/pyed/ed.py <<'PY'\r#!/usr/bin/env python3\r\"\"\"A small, pure Python implementation of GNU ed's documented interface.\"\"\"\rimport sys, os, stat, ctypes\r\rclass EdError(Exception): pass\rclass QuitEd(Exception): pass\r\r# POSIX regex from libc gives leftmost-longest matching (unlike Python re).\r_libc = ctypes.CDLL(None)\r_libc.regcomp.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]\r_libc.regcomp.restype = ctypes.c_int\r_libc.regexec.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_size_t, ctypes.c_void_p, ctypes.c_int]\r_libc.regexec.restype = ctypes.c_int\r_libc.regfree.argtypes = [ctypes.c_void_p]\rclass RM(ctypes.Structure):\r    _fields_ = [('so', ctypes.c_int), ('eo', ctypes.c_int)]\r\rclass Regex:\r    def __init__(self, pat, extended=False, icase=False):\r        self.mem = ctypes.create_string_buffer(4096)\r        flags = (1 if extended else 0) | (2 if icase else 0)\r        if _libc.regcomp(self.mem, pat.encode('latin1'), flags):\r            raise EdError()\r    def __del__(self):\r        try: "]
