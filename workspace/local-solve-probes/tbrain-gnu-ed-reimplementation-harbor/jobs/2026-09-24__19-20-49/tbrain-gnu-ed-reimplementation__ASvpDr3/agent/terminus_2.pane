"""pyed: a GNU ed 1.19 replacement in pure Python.

Usage: python3 /app/pyed/ed.py [OPTIONS] [FILE]
"""

import sys


def main(argv):
    sys.stderr.write("pyed: not implemented yet\n")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
