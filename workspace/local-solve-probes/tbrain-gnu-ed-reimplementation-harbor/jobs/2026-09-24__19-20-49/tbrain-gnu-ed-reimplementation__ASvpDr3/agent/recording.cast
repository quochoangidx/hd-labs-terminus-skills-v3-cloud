[109.226511, "o", "   a,b=self.rng(addrs,self.cur+1); n=int(arg) if arg.strip().isdigit() else 22; self.prints(a,min(len(self.lines),a+n-1)); return\r\n\u001b[?2004l\r\u001b[?2004h>   raise EdError('Unknown command')\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>  def run(self):\r\n\u001b[?2004l\r\u001b[?2004h>   if self.quit_now: return 1\r\n\u001b[?2004l\r\u001b[?2004h>   while True:\r\n\u001b[?2004l\r\u001b[?2004h>    b=self.readline(True)\r\n\u001b[?2004l\r\u001b[?2004h>    if b is None:\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>      if self.modified and not self.warned: self.warned=True; self.out('?\\n'); self.bad=True; continue\r\n\u001b[?2004l\r\u001b[?2004h>      break\r\n\u001b[?2004l\r\u001b[?2004h>     except: break\r\n\u001b[?2004l\r\u001b[?2004h>    try: self.execute(self.text(b))\r\n\u001b[?2004l\r\u001b[?2004h>    except Quit: break\r\n\u001b[?2004l\r\u001b[?2004h>    except EdError as e:\r\n\u001b[?2004l\r\u001b[?2004h>     self.out('?\\n'); self.bad=True\r\n\u001b[?2004l\r\u001b[?2004h>     if not self.quiet: print(str(e),file=sys.stderr)\r\n\u001b[?2004l\r\u001b[?2004h>     if self.regstdin: break\r\n\u001b[?2004l\r\u001b[?2004h>   return 0 if (self.loose or not self.bad) else 1\r\n\u001b[?2004l\r"]
