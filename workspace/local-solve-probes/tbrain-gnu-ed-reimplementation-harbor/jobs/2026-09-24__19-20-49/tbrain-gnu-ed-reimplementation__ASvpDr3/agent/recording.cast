[207.694548, "i", "python3 - <<'PY'\np='/app/pyed/ed.py'\ns=open(p).read()\ns=s.replace(\"self.regstdin=stat.S_ISREG(os.fstat(0).st_mode); self.input=sys.stdin.buffer\", \"self.regstdin=stat.S_ISREG(os.fstat(0).st_mode); self.input=sys.stdin.buffer; self.in_global=False\")\ns=s.replace(\" def snapshot(self):\\n  self.undo=\", \" def snapshot(self):\\n  if self.in_global: return\\n  self.undo=\")\ns=s.replace(\"chosen=matches if g else ([matches[nth-1]] if nth and len(matches)>=nth else matches[:1])\", \"chosen=matches if g else (([matches[nth-1]] if len(matches)>=nth else []) if nth else matches[:1])\")\nold=\"\"\"  for obj in targets:\n   try: self.cur=next(i+1 for i,x in enumerate(self.lines) if x is obj)\n   except StopIteration: continue\n   if interactive:\n    self.prints(self.cur,self.cur)\n    x=self.readline(False)\n    if x is None: break\n    z=self.text(x)\n    if z=='': continue\n    if z=='&':\n     if lastcmd is None: raise EdError('No previous command')\n     z=lastcmd\n    else: lastcmd=z\n    self.execute_list(z)\n   else: self.execute_list(cmd)\n\""]
[207.695322, "i", "\"\"\nnew=\"\"\"  before=([*self.lines],self.cur,self.modified,dict(self.marks),[*self.cut])\n  oldundo=self.undo; self.in_global=True\n  try:\n   for obj in targets:\n    try: self.cur=next(i+1 for i,x in enumerate(self.lines) if x is obj)\n    except StopIteration: continue\n    if interactive:\n     self.prints(self.cur,self.cur)\n     x=self.readline(False)\n     if x is None: break\n     z=self.text(x)\n     if z=='': continue\n     if z=='&':\n      if lastcmd is None: raise EdError('No previous command')\n      z=lastcmd\n     else: lastcmd=z\n     self.execute_list(z)\n    else: self.execute_list(cmd)\n  finally:\n   self.in_global=False\n  if self.lines != before[0] or self.modified != before[2]: self.undo=before\n  else: self.undo=oldundo\n\"\"\"\nif old not in s: raise SystemExit('global block not found')\ns=s.replace(old,new)\ns=s.replace(\"  c=rest[0]; arg=rest[1:]\", \"  c=rest[0]; arg=rest[1:]\\n  if inglobal and c in 'gvGV': raise EdError('Cannot nest global commands')\")\noldf=\"\"\"   if f: self.checkfile(f); self.filename=f\n   elif "]
[207.696072, "i", "not self.filename: raise EdError('No current filename')\n   self.out(self.filename+'\\\\n'); return\n\"\"\"\nnewf=\"\"\"   if f: self.checkfile(f); self.filename=f\n   elif not self.filename: raise EdError('No current filename')\n   else: self.out(self.filename+'\\\\n')\n   return\n\"\"\"\nif oldf not in s: raise SystemExit('f block not found')\ns=s.replace(oldf,newf)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile /app/pyed/ed.py\n"]
