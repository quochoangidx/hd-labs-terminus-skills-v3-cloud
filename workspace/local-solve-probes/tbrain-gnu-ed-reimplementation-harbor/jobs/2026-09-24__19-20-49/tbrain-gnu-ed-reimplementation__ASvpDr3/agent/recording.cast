[270.093539, "i", "python3 - <<'PY'\np='/app/pyed/ed.py'\ns=open(p).read()\ninsert=r'''\nclass PosixRegex:\n def __init__(self, pattern, flags=0):\n  self.pattern=pattern; self.flags=flags; self.base=re.compile(pattern,flags)\n def _at(self,text,pos):\n  n=len(text)\n  for end in range(n,pos-1,-1):\n   try: rx=re.compile('(?:'+self.pattern+')(?=.{'+str(n-end)+'}\\\\Z)',self.flags)\n   except re.error: return self.base.match(text,pos)\n   m=rx.match(text,pos)\n   if m is not None: return m\n  return None\n def search(self,text,pos=0):\n  for i in range(pos,len(text)+1):\n   m=self._at(text,i)\n   if m is not None: return m\n  return None\n def finditer(self,text):\n  pos=0\n  while pos<=len(text):\n   m=self.search(text,pos)\n   if m is None: return\n   yield m\n   pos=m.end() if m.end()>m.start() else m.end()+1\n'''\ns=s.replace('class Line(str): pass\\n', 'class Line(str): pass\\n'+insert)\ns=s.replace(\"self.regstdin=stat.S_ISREG(os.fstat(0).st_mode); self.input=sys.stdin.buffer; self.in_global=False\", \"self.regstdin=stat.S_ISREG(os.fstat(0).st_mode); self.in"]
[270.093769, "i", "put=sys.stdin.buffer; self.in_global=False; self.inject=None\")\ns=s.replace(\" def readline(self, prompt=True):\\n  if prompt\", \" def readline(self, prompt=True):\\n  if self.inject is not None:\\n   return self.inject.pop(0) if self.inject else None\\n  if prompt\")\ns=s.replace(\"try: return re.compile(self.bre(p), re.I if icase else 0),p\", \"try: return PosixRegex(self.bre(p), re.I if icase else 0),p\")\n# Preserve marks on substitution: capture offsets, delete/insert, restore to first corresponding result line.\nold=\"self.snapshot(); self.cut=[new[-1]]; self.adjust_marks_delete(a,b); self.lines[a-1:b]=new; self.adjust_marks_insert(a-1,len(new)); self.cur=last; self.changed()\"\nnew=\"self.snapshot(); self.cut=[new[-1]]; kept={k:v-a for k,v in self.marks.items() if a<=v<=b}; self.adjust_marks_delete(a,b); self.lines[a-1:b]=new; self.adjust_marks_insert(a-1,len(new)); [self.marks.__setitem__(k,min(a+off,a+len(new)-1)) for k,off in kept.items()]; self.cur=last; self.changed()\"\nif old not in s: raise SystemExit('sub mark blo"]
[270.093775, "i", "ck missing')\ns=s.replace(old,new)\n# Preserve marks belonging to moved lines.\nold=\"\"\"   self.snapshot()\n   if c=='m':\n    self.adjust_marks_delete(a,b); del self.lines[a-1:b]\n    if dest>b: dest-=b-a+1\n   self.lines[dest:dest]=block; self.adjust_marks_insert(dest,len(block)); self.cur=dest+len(block); self.changed(); self.do_suffix(modes); return\n\"\"\"\nnew=\"\"\"   self.snapshot(); moved={k:v-a for k,v in self.marks.items() if c=='m' and a<=v<=b}\n   if c=='m':\n    self.adjust_marks_delete(a,b); del self.lines[a-1:b]\n    if dest>b: dest-=b-a+1\n   self.lines[dest:dest]=block; self.adjust_marks_insert(dest,len(block))\n   for k,off in moved.items(): self.marks[k]=dest+off+1\n   self.cur=dest+len(block); self.changed(); self.do_suffix(modes); return\n\"\"\"\nif old not in s: raise SystemExit('move block missing')\ns=s.replace(old,new)\n# Ensure global undo state is installed even if a later list command fails.\nold=\"\"\"  finally:\n   self.in_global=False\n  if self.lines != before[0] or self.modified != before[2]: self.undo=before\n"]
[270.093794, "i", "  else: self.undo=oldundo\n\"\"\"\nnew=\"\"\"  finally:\n   self.in_global=False\n   if self.lines != before[0] or self.modified != before[2]: self.undo=before\n   else: self.undo=oldundo\n\"\"\"\nif old not in s: raise SystemExit('global finally missing')\ns=s.replace(old,new)\n# Command-list execution with an isolated source for embedded input mode text.\nold=\"\"\" def execute_list(self,s):\n  for x in s.split('\\\\n'):\n   self.execute(x,inglobal=True)\n\"\"\"\nnew=\"\"\" def execute_list(self,s):\n  old=self.inject; self.inject=[x.encode('latin1') for x in s.split('\\\\n')]\n  try:\n   while self.inject:\n    x=self.text(self.inject.pop(0)); self.execute(x,inglobal=True)\n  finally: self.inject=old\n\"\"\"\nif old not in s: raise SystemExit('execute_list missing')\ns=s.replace(old,new)\n# Read logical commands continued by an escaped newline.\nold=\"\"\"   try: self.execute(self.text(b))\n   except Quit: break\n\"\"\"\nnew=\"\"\"   text=self.text(b)\n   while text.endswith('\\\\\\\\'):\n    more=self.readline(False)\n    if more is None: break\n    text=text[:-1]+'\\\\n'+s"]
