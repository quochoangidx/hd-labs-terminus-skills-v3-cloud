[417.859673, "i", "python3 - <<'PY'\np='/app/pyed/ed.py'\ns=open(p).read()\n# Combined p/n/l flags produce one rendering, with n prefix and l escaping.\nold=\"\"\" def prints(self,a,b,mode='p'):\n  if a<1 or b>len(self.lines) or a>b: raise EdError('Invalid address')\n  for i in range(a,b+1):\n   if mode=='n': self.out('%d\\\\t%s\\\\n'%(i,self.lines[i-1]))\n   elif mode=='l': self.out(self.plist(self.lines[i-1]))\n   else: self.out(self.lines[i-1]+'\\\\n')\n  self.cur=b\n\"\"\"\nnew=\"\"\" def prints(self,a,b,mode='p'):\n  if a<1 or b>len(self.lines) or a>b: raise EdError('Invalid address')\n  for i in range(a,b+1):\n   prefix=('%d\\\\t'%i) if 'n' in mode else ''\n   if 'l' in mode: self.out(prefix+self.plist(self.lines[i-1]))\n   else: self.out(prefix+self.lines[i-1]+'\\\\n')\n  self.cur=b\n\"\"\"\nif old not in s: raise SystemExit('prints block missing')\ns=s.replace(old,new)\ns=s.replace(\"\"\" def do_suffix(self,modes):\n  for m in modes: self.prints(self.cur,self.cur,m)\n\"\"\", \"\"\" def do_suffix(self,modes):\n  if modes: self.prints(self.cur,self.cur,''.join(modes))\n\"\"\")\nold"]
[417.862694, "i", "=\"\"\"  if c in 'pnl':\n   a,b=self.rng(addrs,self.cur); modes=self.suffix(arg,0); self.prints(a,b,c); self.do_suffix(modes); return\n\"\"\"\nnew=\"\"\"  if c in 'pnl':\n   a,b=self.rng(addrs,self.cur); modes=self.suffix(arg,0); self.prints(a,b,c+''.join(modes)); return\n\"\"\"\nif old not in s: raise SystemExit('print command block missing')\ns=s.replace(old,new)\n# File operands must be separated from command/suffix by whitespace.\nold=\"\"\" def file_suffix(self,arg):\n  i=0; modes=[]\n  while i<len(arg) and arg[i] in 'pln':\n   if arg[i] in modes: raise EdError('Invalid suffix')\n   modes.append(arg[i]); i+=1\n  if i and i<len(arg) and arg[i] not in ' \\\\t': raise EdError('Invalid suffix')\n  return modes,arg[i:].strip()\n\"\"\"\nnew=\"\"\" def file_suffix(self,arg):\n  i=0; modes=[]\n  while i<len(arg) and arg[i] in 'pln':\n   if arg[i] in modes: raise EdError('Invalid suffix')\n   modes.append(arg[i]); i+=1\n  if i<len(arg) and arg[i] not in ' \\\\t': raise EdError('Invalid filename syntax')\n  return modes,arg[i:].strip()\n\"\"\"\nif old not in s: rais"]
