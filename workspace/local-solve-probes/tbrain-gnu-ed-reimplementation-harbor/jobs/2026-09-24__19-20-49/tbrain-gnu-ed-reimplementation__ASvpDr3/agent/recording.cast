[417.862848, "i", "e SystemExit('file suffix block missing')\ns=s.replace(old,new)\n# f also requires whitespace before a filename.\ns=s.replace(\"\"\"  if c=='f':\n   self.noaddr(addrs); f=arg.strip()\n\"\"\", \"\"\"  if c=='f':\n   self.noaddr(addrs)\n   if arg and arg[0] not in ' \\\\t': raise EdError('Invalid filename syntax')\n   f=arg.strip()\n\"\"\")\n# Gather continued interactive G/V command lists.\nold=\"\"\"     z=self.text(x)\n     if z=='': continue\n     if z=='&':\n\"\"\"\nnew=\"\"\"     z=self.text(x)\n     while z.endswith('\\\\\\\\'):\n      y=self.readline(False)\n      if y is None: break\n      z=z[:-1]+'\\\\n'+self.text(y)\n     if z=='': continue\n     if z=='&':\n\"\"\"\nif old not in s: raise SystemExit('interactive global block missing')\ns=s.replace(old,new)\n# Preserve marks on the first joined line; later joined lines are deleted.\nold=\"\"\"   self.snapshot(); self.cut=self.lines[a-1:b]; z=Line(''.join(self.cut)); self.adjust_marks_delete(a,b); self.lines[a-1:b]=[z]; self.cur=a; self.changed(); self.do_suffix(modes); return\n\"\"\"\nnew=\"\"\"   self.snapshot(); sel"]
