[109.098634, "i", "lf.cut=self.undo; self.undo=now\r def changed(self): self.modified=True; self.warned=False\r\r def bre(self,p):\r  if self.ext: return p\r  out=''; i=0; incl=False\r  while i<len(p):\r   c=p[i]\r   if c=='[': incl=True; out+=c; i+=1; continue\r   if c==']' and incl: incl=False; out+=c; i+=1; continue\r   if c=='\\\\' and i+1<len(p):\r    d=p[i+1]; i+=2\r    if incl: out+='\\\\'+d if d in '\\\\' else d; continue\r    if d in '()|+?': out+=d\r    elif d=='{':\r     j=p.find('\\\\}',i)\r     if j>=0: out+='{'+p[i:j]+'}'; i=j+2\r     else: out+='\\\\{'\r    elif d=='<': out+=r'(?<!\\w)(?=\\w)'\r    elif d=='>': out+=r'(?<=\\w)(?!\\w)'\r    elif d in ('`',): out+='^'\r    elif d==\"'\": out+='$'\r    elif d in 'bBwW' or d.isdigit(): out+='\\\\'+d\r    else: out+=re.escape(d)\r    continue\r   if not incl and c in '()+?|{}': out+='\\\\'+c\r   else: out+=c\r   i+=1\r  return out\r def regex(self,p,icase=False):\r  if p=='':\r   if self.last_re is None: raise EdError('No previous pattern')\r   p=self.last_re\r  else: self.last_re=p\r  try: return re.compile(self.bre(p),"]
[109.098644, "i", " re.I if icase else 0),p\r  except re.error: raise EdError('Invalid pattern')\r def delim(self,s,pos,d):\r  out=''; esc=False\r  while pos<len(s):\r   c=s[pos]\r   if c==d and not esc: return out,pos+1\r   if c=='\\\\' and not esc: esc=True; out+=c\r   else: esc=False; out+=c\r   pos+=1\r  raise EdError('Unclosed delimiter')\r def searchaddr(self,s,pos,forward):\r  d=s[pos]; p,pos=self.delim(s,pos+1,d); ic=False\r  if pos<len(s) and s[pos]=='I': ic=True; pos+=1\r  rx,_=self.regex(p,ic)\r  n=len(self.lines)\r  if not n: raise EdError('No match')\r  seq=range(self.cur,n) if forward else range(self.cur-2,-1,-1)\r  seq=list(seq)+(list(range(0,self.cur)) if forward else list(range(n-1,self.cur-2,-1)))\r  for k in seq:\r   if rx.search(self.lines[k]): return k+1,pos\r  raise EdError('No match')\r def oneaddr(self,s,pos):\r  while pos<len(s) and s[pos] in ' \\t': pos+=1\r  if pos>=len(s): return None,pos\r  c=s[pos]; base=None\r  if c=='.': base=self.cur; pos+=1\r  elif c=='$': base=len(self.lines); pos+=1\r  elif c.isdigit():\r   j=pos\r   while j"]
[109.105547, "i", "<len(s) and s[j].isdigit(): j+=1\r   base=int(s[pos:j]); pos=j\r  elif c in '/?': base,pos=self.searchaddr(s,pos,c=='/')\r  elif c==\"'\" and pos+1<len(s) and s[pos+1].islower():\r   x=s[pos+1]; pos+=2\r   if x not in self.marks or self.marks[x]>len(self.lines): raise EdError('Invalid mark')\r   base=self.marks[x]\r  elif c in '+-': base=self.cur\r  else: return None,pos\r  while True:\r   save=pos\r   while pos<len(s) and s[pos] in ' \\t': pos+=1\r   sign=1\r   if pos<len(s) and s[pos] in '+-': sign=-1 if s[pos]=='-' else 1; pos+=1\r   elif pos<len(s) and s[pos].isdigit(): sign=1\r   else: pos=save; break\r   j=pos\r   while j<len(s) and s[j].isdigit(): j+=1\r   num=int(s[pos:j]) if j>pos else 1; base+=sign*num; pos=j\r  if base<0 or base>len(self.lines): raise EdError('Invalid address')\r  return base,pos\r def addresses(self,s):\r  vals=[]; pos=0; sep=None\r  a,pos=self.oneaddr(s,pos)\r  if a is not None: vals.append(a)\r  while True:\r   p=pos\r   while p<len(s) and s[p] in ' \\t': p+=1\r   if p>=len(s) or s[p] not in ',;': pos=p; break"]
