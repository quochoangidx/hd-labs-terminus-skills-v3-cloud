@@ -10,6 +15,15 @@
         if bank is None:
             bank = {"bank": rec["bank"], "line": line_of[rec["id"]], "vials_left": 0}
             banks[rec["bank"]] = bank
-        bank["vials_left"] += rec["vials"]
+            stocked[rec["bank"]] = []
