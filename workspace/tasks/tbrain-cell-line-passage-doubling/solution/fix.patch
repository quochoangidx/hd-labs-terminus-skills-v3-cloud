 def summarise(records, frozen, line_of):
+    thawed = {}
+    for rec in records:
+        if rec["kind"] == "thaw" and rec["vial"] is not None:
+            thawed[rec["vial"]] = thawed.get(rec["vial"], 0) + 1
     banks = {}
+    stocked = {}
     for rec in records:
