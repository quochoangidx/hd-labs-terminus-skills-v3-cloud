diff -ruN a/app/src/cellbank/growth.py b/app/src/cellbank/growth.py
--- a/app/src/cellbank/growth.py	2026-09-26 21:46:54
+++ b/app/src/cellbank/growth.py	2026-09-26 21:59:08
@@ -2,6 +2,24 @@
 
 import math
 
+VALID_VIABILITY = 70.0
 
-def doublings(culture):
-    return math.log2(culture["harvested"] / culture["seeded"])
+
+def viable(cells, viability):
+    """SOP 2.3: the viable count of a valid count (70.0 or more); no other count has one."""
+    if viability < VALID_VIABILITY:
+        return None
+    return cells * viability / 100
+
+
+def doublings(culture, seed_viability):
+    """SOP 3.1: log2 of the viable harvest over the viable seed.
+
+    The seed is counted at the viability of its source suspension (2.4). Where either
+    count is not valid, 3.1 has no rule for the figure, so today's calculation stays.
+    """
+    harvest = viable(culture["harvested"], culture["viability"])
+    seed = viable(culture["seeded"], seed_viability)
+    if harvest is None or seed is None:
+        return math.log2(culture["harvested"] / culture["seeded"])
+    return math.log2(harvest / seed)
