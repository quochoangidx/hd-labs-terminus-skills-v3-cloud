{
  "manifest_version": 3,
  "name": "Snorkel Sync",
  "version": "1.1.1",
  "description": "Lấy danh sách project trên Snorkel Experts, chọn project và đồng bộ assignments lên Google Sheet.",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://experts.snorkel-ai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snorkel Sync"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
